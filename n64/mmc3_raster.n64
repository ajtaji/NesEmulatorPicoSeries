; Keep mapper IRQ and memory DMA timestamps visible to the CPU. Batch
; rendering and audio synthesis until their next observable deadline.
Global NesMmc3ApuClock.i, NesMmc3FetchClock.i
Global NesMmc3ApuLimit.i=-1, NesMmc3FetchLimit.i=-1

ProcedureNaked.i NesMmc3FetchDeadline()
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_nesmmc3fetchdeadline
    nop
  EndASM
EndProcedure

ProcedureNaked WorkerAdvance(stamp.i)
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_workeradvance
    nop
  EndASM
EndProcedure

ProcedureNaked NesMmc3AdvanceCpuTime(stamp.i)
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_nesmmc3advancecputime
    nop
  EndASM
EndProcedure

; APU register accesses and PRG bank changes need current audio state.
; The CPU scheduler still services raster and mapper IRQ deadlines.
ProcedureNaked NesMmc3SyncApu(stamp.i)
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_nesmmc3syncapu
    nop
  EndASM
EndProcedure
