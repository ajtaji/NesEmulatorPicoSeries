; rspband_ids.pmi - the RSP band emitter's command numbers and code segment, shared by the CPU side (rspband.n64)
; and the RSP program (rspband.n64rsp). 0-3 are the queue's own; the library's mixer reserves 64-95.
#NES_RSP_SETUP = 128                   ; the bases, once (RspqArg 0-6)
#NES_RSP_BAND = 129                    ; one band: the record, its OAM snapshot, the band's index
#NES_RSP_SEG_A = 1                     ; the emitter's code segments: the band's inputs and set-up
#NES_RSP_SEG_B = 2                     ; the three layers and the band's end
#NES_RSP_WORDS = 4096                  ; the frame command area: doublewords (frames >= 900: at most 1,480; the title more)
