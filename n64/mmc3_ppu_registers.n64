; CPU $2000-$2007 ports after the CPU bus synchronizes the raster. The ports are part of the
; hot unit (unit/ppu.n64, design note section N, step N3); these are one-jump stubs.
ProcedureNaked PpuRegWrite(addr.i,value.i)
  ASM
    j u_ppuregwrite
    nop
  EndASM
EndProcedure

ProcedureNaked.i PpuRegRead(addr.i)
  ASM
    j u_ppuregread
    nop
  EndASM
EndProcedure
