; Mono NES samples are 16-bit. The ring and AI blocks both contain a whole
; number of 512-frame blocks, so one transfer never wraps the input ring.
ProcedureNaked HostCopyStereo(dst.i, src.i)
  ASM
    addiu a2, a1, 1024
nes_stereo_copy:
    cache 0x0d, 0(a0)
    lhu t0, 0(a1)
    lhu t1, 2(a1)
    lhu t2, 4(a1)
    lhu t3, 6(a1)
    sll a3, t0, 16
    or t0, t0, a3
    sll a3, t1, 16
    or t1, t1, a3
    sll a3, t2, 16
    or t2, t2, a3
    sll a3, t3, 16
    or t3, t3, a3
    sw t0, 0(a0)
    sw t1, 4(a0)
    sw t2, 8(a0)
    sw t3, 12(a0)
    addiu a1, a1, 8
    bne a1, a2, nes_stereo_copy
    addiu a0, a0, 16
    jr ra
    nop
  EndASM
EndProcedure
