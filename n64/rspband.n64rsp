; ======================================================================
;  rspband.n64rsp - THE RSP BAND EMITTER (design note, sections N.18 and N.20)
; ======================================================================
;  One RSP program in the queue's one-program form (rspq_program.n64rsp, put on the RSP once by LpmRspqProgram).
;  Its one module turns a band record of the PPU state machine (unit/ppu_cold.n64, the band log of nes.n64) into
;  the RDP command words that draw the band's NES tiles as textured rectangles - the SAME words, in the same
;  order, as the CPU twin n64/twin.n64 (NesTwinBand), which is the specification and the checking build's
;  reference. Read twin.n64's header for what the words are; this file says only how the RSP gets them.
;
;  COMMANDS (rspband_ids.pmi):
;    NES_RSP_SETUP (128), once: RspqArg 0-6 = the physical addresses of Nt (the 4 KB name and attribute tables),
;      NesChrMask (one byte a tile: bit r = row r has a pixel other than 0), Rgb64 (512 colours), the CI4 pairs
;      (NesChrPairBase), the TLUT blocks the words name (32 x 256 B), the TLUT blocks this program writes, the frame
;      command area (4,096 doublewords, then 16 bytes of status). All 8-byte aligned (the CPU checks).
;    NES_RSP_BAND (129), at every band record: RspqArg 0 the record (96 B), 1 its OAM snapshot (256 B), 2 the
;      band's index in the frame | its frame set << 8. Index 0 starts a frame: the words go from the area's start, and
;      the RDP's state is taken as unknown (every sync owed, no pair resident) - as the twin does. WITH RECORD 0 IT IS
;      THE HAND STEP (design note N.62; NesRspHand, segment 6): RspqArg 1 the set's area, 2 the set | 256 for the
;      frame's last - the set attached, its words not yet handed handed to the RDP (RspqRdpHand), and with 256 no
;      longer attached after. A band's end hands its words itself while its set is attached (NesRspBandE).
;    NES_RSP_SYNJOB (130), on the PRIORITY ring: a job of the APU synthesis, the program's second module
;      (rspsyn.n64rsp, segments 3, 5 and 4; design note N.52 / N.53). It uses only the queue's scratch and its own
;      state in RDRAM: nothing of this module's DMEM, so a band job after it finds its globals as they were.
;
;  WHAT IS KEPT BETWEEN BANDS (this module's DMEM globals, never the queue's scratch, which belongs to the command
;  running): the pair cache's 32 keys, the next slot, the syncs owed (pipe, tiles, TMEM), where the frame's next
;  words go and the words that did not fit. The program is never switched (one program), so they survive.
;
;  THE FORMS (N.20; each gives the twin's words exactly):
;  - The pair cache is looked up through a DIRECT-MAPPED TABLE, not a search: within a band a tile's pattern
;    address a (13 bits) gives a >> 5 = bank slot x 32 + pair, 0-255, an exact index. tab[a >> 5] = the TMEM slot
;    + 1 that holds key (bank number << 10 | (a & $3E0)), 0 none. Built at the band's start from the 32 keys (the 8
;    bank numbers are 8 vector lanes: a key's bank is compared with all 8 at once, nbtab), kept by every load.
;    The slots, the FIFO and the pins are the twin's; the pins are one 32-bit mask.
;  - The background: what is the same in every strip of a band (the visible tiles, the first one's x) is worked
;    out once a band; what is the same in every tile of a strip (the rectangle's line fields, fy, the row mask, the
;    palette shift's coarse-Y part) once a strip; the v walk once a strip (its length from fy and the horizontal
;    bits); the two name tables' rows by one strided DMA, their attribute rows by another.
;  - A flush copies each queued rectangle (16 bytes) with one vector load and two vector stores.
;  - The sprite selection keeps each line's count in a vector lane: the 8 or 16 rows of a sprite are decided
;    and counted at once (lines outside the band hold 8, so "below 8" alone decides).
;  - The TLUT: 16 vector stores of 0 and the 25 colours that are not 0.
;
;  THE SCRATCH, as a band's job lays it out (byte offsets from rspq_scratch; the assembly writes the numbers, it
;  cannot read a # constant - change both together):
;      0  the record (96)              96  the OAM snapshot (256)        352  the empty-row bytes, 8 banks x 64
;    864  the strip's rows of the name tables with bit 10 = 0 and 1 (2 x 32)  928 their attribute rows (2 x 8)
;    944  the status (16)
;   1024  the rectangle queue, 64 x 16; at the band's start the colour row (1024, 128) and the TLUT (1152, 256),
;         then the sprite selection's line counts (1024 + 2 x line, lines 0-287) - each used up before the next
;   2048  the output staging, two halves of 128    2304 the pair table (256)
;  Each sprite's drawn rows (64 x 2 bytes) are in nb_srows (DMEM globals): the scratch has no room left.
;
;  THE OUTPUT: word k of the frame at the area + 8k, each (w0, w1) as the RDP reads it. A full staging half goes
;  out by an unwaited DMA (the other half is filled meanwhile; before a half goes out every DMA before it has
;  landed, so the half filled next is free). What would pass the area's 4,096 doublewords is not written but
;  counted. At the band's end the rest, then the status: +0 the frame's words, +4 words that did not fit, +8 the
;  RDP clock ticks (DPC_CLOCK, 24 bits) the frame's bands took on the RSP (an emulator figure: no RSP clock is
;  known good on the console), +12 the bands done.
;
;  THE CODE, in IMEM: a band's job is a chain of procedures in code segments above the resident code
;  (#RSP_SEGMENT_BASE), run one after the other by RspqCommand's loop - each names the next in the job's scratch
;  (+1012 the segment, +1016 the procedure; 0 ends the job): NesRspBandA (segment 1: inputs, modes, backdrop, the pair
;  table, TLUT, sprite selection, the behind sprites' bitmap at 976 / 980), NesRspBandB (segment 2: the three layers,
;  the band's end), and since design note N.60 NesRspBandS (segment 6: a split line's segments - the record's +56 the
;  count, +60 the first entry), NesRspBandQ (segment 7: the front sprites under the priority rule) and NesRspBandE
;  (segment 6: the end after segment 7). A plain band runs A, B; a band a behind sprite meets A, B, Q, E; a split
;  line's record A, B, S, Q, E. What they call is resident in NesRspCommon. Scratch 960-1023 is the chain's and the
;  new steps' (each says what it uses).
;
;  REGISTERS in both: s0 first line, s1 end line, s2 PPUCTRL, s3 PPUMASK, s4 fine X, s5 t, s6 / s7 the staging's
;  write pointer and its half's end - carried from A to B in nb_bs (nb_enter / nb_leave), the caller's s0-s7 kept
;  in nb_sv, as lpm_mixer.n64rsp keeps them; sp is never touched; ra kept in nb_ra. The background layer uses
;  s0 and s2-s5 for its own (nb_bs holds the band's; they are loaded again after it). VECTOR REGISTERS: VCO is
;  kept 0 (no carry-setting operation is used); $v16 = the 8 bank numbers (byte x 256 a lane), loaded in A and
;  again in B. The subroutines' contracts:
;    nbw     (a0, a1) one doubleword out. CLOBBERS k0, k1, t8, t9, at, v0.
;    nbsend  the half being filled out (what fits under the area's end), the other half next. CLOBBERS nbw's.
;    nbsp / nbst (t9 = 1 << tile) / nbsl  the syncs owed (SYNC_PIPE / SYNC_TILE / SYNC_LOAD), as the twin's
;            NesTwinSync*: tail calls of nbw. CLOBBER nbw's, a0, a1.
;    nbtab   (a0 = key, < 0 none; a1 = value) every bank slot of the key's bank: its table entry = a1. CLOBBERS
;            t8, t9, at, $v9, $v10.
;    nbflush the rectangle queue out, the tiles it names owed, every pin cleared. CLOBBERS nbw's, a0, a1, t3, v1.
;    nbdesc  (a0 = 0 / 4) tiles 0-3 to that palette set. CLOBBERS nbflush's.
;    nbdi / nbdo  (k0 DMEM, k1 RDRAM, v0 the DMA's length word) a DMA in / out, waited until every DMA has
;            landed. CLOBBER at.
;    (segment B) nbroom (a1 = the rectangle's tile) v0 = its 16 bytes in the queue; nbpair / nbload (a0 = the
;            pair index) v0 = its slot, pinned; nbstep. CLOBBER nbflush's (nbload also t3).
;  So a caller keeps a2-a7, t0-t2, gp and s0-s7 across every one of them.
; ======================================================================
#RSP_SEGMENT_BASE = 2304                ; the resident code (the kernel and NesRspCommon) needs more than 1536
#LPM_RSPQ_RDP_HAND = 1                  ; the kernel's RspqRdpHand: the band job hands its own words (N.62)
#RSP_SEGMENT_RspqRdpHand = 6            ; in segment 6, with its callers (NesRspBandE, NesRspHand)
XIncludeFile "Mips/Lib/LibPureMetalN64/rspq_program.n64rsp"
XIncludeFile "rspband_ids.pmi"
#RSP_SEGMENT_NesRspBandA = 1            ; #NES_RSP_SEG_A
#RSP_SEGMENT_NesRspBandB = 2            ; #NES_RSP_SEG_B
#RSP_SEGMENT_NesRspBandS = 6            ; #NES_RSP_SEG_S (design note N.60)
#RSP_SEGMENT_NesRspBandQ = 7            ; #NES_RSP_SEG_Q
#RSP_SEGMENT_NesRspHand = 6             ; (the HAND step: a frame's words handed, N.62)
#RSP_SEGMENT_NesRspBandE = 6            ; (with NesRspBandS: the band's end after segment 7)

Global nb_nt.l, nb_mask.l, nb_rgb.l, nb_pair.l, nb_tlut.l, nb_tlutw.l, nb_out.l, nb_lim.l
Global Dim nb_keys.l[32]                ; the pair in each TMEM slot (-1 none)
Global nb_next.l, nb_pinm.l, nb_rects.l, nb_qtiles.l, nb_pipe.l, nb_tiles.l, nb_tmem.l, nb_descs.l
Global nb_over.l, nb_clk.l, nb_clk0.l, nb_odram.l, nb_idx.l, nb_h.l
Global nb_key.l, nb_rtile.l, nb_vnext.l, nb_jlo.l, nb_jn.l, nb_x0.l, nb_sat.l, nb_sx0.l, nb_sta.l, nb_sa.l, nb_slot.l
Global nb_ra.l, nb_rabg.l, nb_raspr.l, nb_rapair.l, nb_rafl.l, nb_raroom.l, nb_radesc.l
Global Dim nb_sv.l[8]
Global Dim nb_bs.l[8]                   ; the band's s0-s7 from NesRspBandA to NesRspBandB
Global Dim nb_srows.l[32]               ; each sprite's drawn rows (bit r: line y + 1 + r), a halfword a sprite
; THE HAND-OVER (N.62): the band's frame set (0 / 1, RspqArg 2 bit 8), each set's attached flag (bit = set), its
; words written and handed (bytes from the area's start)
Global nb_set.l, nb_att.l
Global Dim nb_wr.l[2]
Global Dim nb_hnd.l[2]

Procedure NesRspSetup()
  nb_nt = RspqArg(0) : nb_mask = RspqArg(1) : nb_rgb = RspqArg(2) : nb_pair = RspqArg(3)
  nb_tlut = RspqArg(4) : nb_tlutw = RspqArg(5) : nb_out = RspqArg(6)
  nb_lim = nb_out + $8000                ; the end of the 4,096 doublewords
  NesRspCommon()
EndProcedure

; NesRspBandA (code segment 1) - a band's first part: its inputs in, the modes, the backdrop, the pair table, the
; TLUT, and the sprite selection (NesTwinBand up to "the three layers"). Its registers s0-s7 go to nb_bs.
Procedure NesRspBandA()
  ASM
    sw ra, global_nb_ra(zero)
    lw t0, global_rspqarg(zero)              ; record 0: the HAND step (N.62), in segment 6
    bne t0, zero, nba_band
    addiu t0, zero, 6                        ; (delay slot)
    sw t0, global_rspq_scratch+1012(zero)
    addiu t0, zero, nesrsphand
    j nba_return
    sw t0, global_rspq_scratch+1016(zero)    ; (delay slot)
nba_band:
    jal nb_enter                             ; the caller's s0-s7 kept
    nop
    mfc0 t0, $12                             ; DPC_CLOCK at the start (the RSP time, an emulator figure)
    sw t0, global_nb_clk0(zero)
    ; ---- the record, the snapshot, the eight banks' empty-row bytes ----
    addiu k0, zero, global_rspq_scratch
    lw k1, global_rspqarg(zero)
    jal nbdi
    addiu v0, zero, 95
    addiu k0, zero, global_rspq_scratch+96
    lw k1, global_rspqarg+4(zero)
    jal nbdi
    addiu v0, zero, 255
    addu t0, zero, zero                      ; the bank slot, 0-7
nb_mk:
    lbu t1, global_rspq_scratch+48(t0)       ; its 1 KB bank number
    sll t1, t1, 6                            ; 64 tiles a bank, a byte each
    lw k1, global_nb_mask(zero)
    addu k1, k1, t1
    sll k0, t0, 6
    addiu k0, k0, global_rspq_scratch+352
    jal nbdi
    addiu v0, zero, 63
    addiu t0, t0, 1
    sltiu t1, t0, 8
    bne t1, zero, nb_mk
    nop
    ; ---- a frame's first band: the RDP's state unknown (the twin's idx = 0) ----
    lw t0, global_rspqarg+8(zero)            ; the band's index | its frame set << 8
    srl t1, t0, 8
    andi t1, t1, 1
    sw t1, global_nb_set(zero)
    andi t0, t0, 255
    sw t0, global_nb_idx(zero)
    bne t0, zero, nb_nf
    addiu t1, zero, -1                       ; (delay slot)
    lw t2, global_nb_set(zero)               ; a frame's first band: nothing of its set written or handed (attached
    sll t2, t2, 2                            ; it may be already: the CPU attaches a frame as early as it can)
    sw zero, global_nb_wr(t2)
    sw zero, global_nb_hnd(t2)
    sw zero, global_nb_over(zero)
    sw zero, global_nb_clk(zero)
    sw zero, global_nb_next(zero)
    sw zero, global_nb_pinm(zero)
    sw zero, global_nb_rects(zero)
    sw zero, global_nb_qtiles(zero)
    lw t2, global_nb_out(zero)
    sw t2, global_nb_odram(zero)             ; the frame's words from the area's start
    addiu t2, zero, 1
    sw t2, global_nb_pipe(zero)
    sw t2, global_nb_tmem(zero)
    addiu t2, zero, 255
    sw t2, global_nb_tiles(zero)
    addiu t2, zero, 124
nb_k0:
    sw t1, global_nb_keys(t2)                ; no pair in any slot
    bne t2, zero, nb_k0
    addiu t2, t2, -4                         ; (delay slot)
nb_nf:
    sw t1, global_nb_descs(zero)             ; tiles 0-3 unknown at every band
    ; ---- the record's fields ----
    lw s0, global_rspq_scratch+4(zero)       ; first
    lw s1, global_rspq_scratch+12(zero)      ; last (exclusive)
    lbu s2, global_rspq_scratch+31(zero)     ; ctrl
    lbu s3, global_rspq_scratch+30(zero)     ; mask
    lbu s4, global_rspq_scratch+29(zero)
    andi s4, s4, 7                           ; fx
    lw s5, global_rspq_scratch+24(zero)
    andi s5, s5, 0x7FFF                      ; t
    addiu s6, zero, global_rspq_scratch+2048 ; the staging's first half
    addiu s7, zero, global_rspq_scratch+2176
    ; ---- the vector constants: VCO 0, $v16 the bank numbers, $v20 lane 0 = 8 / lane 1 = 1, $v21 = 0 ----
    ctc2 zero, $0
    addiu t0, zero, global_rspq_scratch+48
    lpv $v16[0], 0(t0)                       ; bank slot b in lane b, x 256
    vxor $v21, $v21, $v21
    addiu t0, zero, 8
    mtc2 t0, $v20[0]
    addiu t0, zero, 1
    mtc2 t0, $v20[2]
    ; ---- the pair table: 256 bytes of 0, then every key's entries ----
    addiu t0, zero, global_rspq_scratch+2304
    addiu t1, zero, global_rspq_scratch+2560
nb_tz:
    sqv $v21[0], 0(t0)
    addiu t0, t0, 16
    bne t0, t1, nb_tz
    nop
    addu t0, zero, zero                      ; the slot
nb_tk:
    sll t1, t0, 2
    lw a0, global_nb_keys(t1)
    jal nbtab
    addiu a1, t0, 1                          ; (delay slot) slot + 1
    addiu t0, t0, 1
    sltiu t1, t0, 32
    bne t1, zero, nb_tk
    nop
    ; the 64 colours of the band's emphasis: Rgb64 + ((mask >> 5) & 7) x 128
    srl t0, s3, 5
    andi t0, t0, 7
    sll t0, t0, 7
    lw k1, global_nb_rgb(zero)
    addu k1, k1, t0
    addiu k0, zero, global_rspq_scratch+1024
    jal nbdi
    addiu v0, zero, 127
    ; ---- the modes, the backdrop ----
    jal nbsp
    nop
    lui a0, 0x2F00
    ori a0, a0, 0x8CF0                       ; SET_OTHER_MODES: one cycle, TLUT RGBA16, no dither ...
    jal nbw
    addiu a1, zero, 1                        ; ... alpha compare
    lui a0, 0x3900
    jal nbw
    addiu a1, zero, 128                      ; SET_BLEND_COLOR: the compare's threshold
    lui a0, 0x3CFF
    ori a0, a0, 0xFFFF
    lui a1, 0xFFFD
    jal nbw
    ori a1, a1, 0xF6FB                       ; SET_COMBINE: PRIM
    lbu a0, global_rspq_scratch+64(zero)     ; palette byte 0
    jal nbcol
    nop
    srl t0, v0, 11                           ; SET_PRIM_COLOR: the 5-bit fields widened to 8
    andi t0, t0, 31
    sll t1, t0, 3
    srl t0, t0, 2
    or t0, t1, t0
    sll a1, t0, 24
    srl t0, v0, 6
    andi t0, t0, 31
    sll t1, t0, 3
    srl t0, t0, 2
    or t0, t1, t0
    sll t0, t0, 16
    or a1, a1, t0
    srl t0, v0, 1
    andi t0, t0, 31
    sll t1, t0, 3
    srl t0, t0, 2
    or t0, t1, t0
    sll t0, t0, 8
    or a1, a1, t0
    ori a1, a1, 255
    jal nbw
    lui a0, 0x3A00
    lui a0, 0x3648                           ; FILL_RECTANGLE x 32 .. 288, the band's lines
    sll t0, s1, 2
    or a0, a0, t0
    lui a1, 0x0008
    sll t0, s0, 2
    jal nbw
    or a1, a1, t0
    addiu t0, zero, 1
    sw t0, global_nb_pipe(zero)
    ; ---- the TLUT: entry 16p + c is, for c < 4, the colour of palette byte 4p + c (c = 0: byte 0's, alpha 0);
    ; every other entry 0. So 16 stores of 0, byte 0's colour in the 8 entries c = 0, and 24 colours. ----
    addiu t0, zero, global_rspq_scratch+1152
    addiu t1, zero, global_rspq_scratch+1408
nb_tl0:
    sqv $v21[0], 0(t0)
    addiu t0, t0, 16
    bne t0, t1, nb_tl0
    nop
    lbu a0, global_rspq_scratch+64(zero)
    jal nbcol
    nop
    andi t3, v0, 0xFFFE                      ; byte 0's colour, alpha 0: transparent
    addu t0, zero, zero                      ; 4p
nb_tl:
    sll t1, t0, 3                            ; entry 16p's byte offset, 32p
    sh t3, global_rspq_scratch+1152(t1)
    addiu t2, zero, 1                        ; c
nb_tlc:
    addu a0, t0, t2
    lbu a0, global_rspq_scratch+64(a0)       ; palette byte 4p + c
    jal nbcol
    nop
    sll t8, t2, 1
    addu t8, t8, t1
    sh v0, global_rspq_scratch+1152(t8)
    addiu t2, t2, 1
    sltiu t8, t2, 4
    bne t8, zero, nb_tlc
    nop
    addiu t0, t0, 4
    sltiu t8, t0, 32
    bne t8, zero, nb_tl
    nop
    lw t0, global_nb_idx(zero)
    sll t0, t0, 8                            ; idx x 256
    lw k1, global_nb_tlutw(zero)
    addu k1, k1, t0
    addiu k0, zero, global_rspq_scratch+1152
    jal nbdo                                 ; the band's TLUT block out
    addiu v0, zero, 255
    jal nbsp
    nop
    lw a1, global_nb_tlut(zero)
    addu a1, a1, t0
    lui a0, 0x3D10
    jal nbw
    ori a0, a0, 127                          ; SET_TEXTURE_IMAGE: RGBA16, 128 entries
    jal nbst
    addiu t9, zero, 128                      ; (delay slot) SYNC_TILE owed for tile 7?
    lui a0, 0x3580
    ori a0, a0, 0x0100
    jal nbw
    lui a1, 0x0700                           ; SET_TILE 7: TMEM word 256
    jal nbsl
    nop
    lui a0, 0x3000
    lui a1, 0x071F
    jal nbw
    ori a1, a1, 0xC000                       ; LOAD_TLUT
    lw t1, global_nb_tiles(zero)
    ori t1, t1, 128
    sw t1, global_nb_tiles(zero)
    addiu t1, zero, 1
    sw t1, global_nb_tmem(zero)
    lui a0, 0x3CFF
    ori a0, a0, 0xFFFF
    lui a1, 0xFFFC
    jal nbw
    ori a1, a1, 0xF279                       ; SET_COMBINE: TEXEL0 (no primitive since the sync)
    ; ---- the sprites each line shows: the first eight in OAM order (NesTwinDrawn, kept per sprite as rows) ----
    sw zero, global_rspq_scratch+976(zero)   ; the behind sprites that meet the band (bit i: sprite i; 976 sprites
    sw zero, global_rspq_scratch+980(zero)   ; 0-31, 980 sprites 32-63): the priority rule's blockers (N.60)
    andi t0, s3, 16
    beq t0, zero, nba_done                   ; no sprites: the layers do not read the rows
    andi t0, s2, 32                          ; (delay slot)
    addiu t9, zero, 8
    beq t0, zero, nb_h8
    nop
    addiu t9, zero, 16
nb_h8:
    sw t9, global_nb_h(zero)                 ; h
    ; each line's count, a halfword for lines 0-287: 8 outside [first, end) - so "count below 8" alone decides
    ; a row, as the twin's in-band test and count do together - and 0 in the band
    vadd $v22, $v21, $v20[0]                 ; 8 in every lane
    addiu t0, zero, global_rspq_scratch+1024
    addiu t1, zero, global_rspq_scratch+1600
nb_cz:
    sqv $v22[0], 0(t0)
    addiu t0, t0, 16
    bne t0, t1, nb_cz
    nop
    sll t0, s0, 1
    addiu t0, t0, global_rspq_scratch+1024   ; the count of line first ...
    sll t1, s1, 1
    addiu t1, t1, global_rspq_scratch+1024   ; ... and of line end
    subu t2, t1, t0
    slti t2, t2, 16
    bne t2, zero, nb_cs                      ; fewer than 8 lines: one by one
    addiu t1, t1, -16                        ; (delay slot) the last run of 8 ends at the band's end
nb_cv:
    sqv $v21[0], 0(t0)                       ; runs of 8 lines, wherever they start (the store pair)
    srv $v21[0], 16(t0)
    addiu t0, t0, 16
    slt t2, t0, t1
    bne t2, zero, nb_cv
    nop
    sqv $v21[0], 0(t1)
    j nb_cd
    srv $v21[0], 16(t1)                      ; (delay slot)
nb_cs:
    addiu t1, t1, 16
nb_cs1:
    beq t0, t1, nb_cd
    nop
    sh zero, 0(t0)
    j nb_cs1
    addiu t0, t0, 2                          ; (delay slot)
nb_cd:
    ; per sprite in OAM order: y against the band (lo = first - h <= y <= end - 2), then its rows at once
    subu t3, s0, t9                          ; lo
    subu v1, s1, t3
    addiu v1, v1, -1                         ; y - lo below this: the sprite meets the band
    addu t2, zero, zero                      ; sprite i x 4
nb_si:
    lbu t1, global_rspq_scratch+96(t2)       ; its y
    subu t0, t1, t3
    sltu t0, t0, v1
    beq t0, zero, nb_sn                      ; not in the band: no rows
    addu a1, zero, zero                      ; (delay slot) the rows drawn
    sll t0, t1, 1
    addiu t0, t0, global_rspq_scratch+1026   ; the count of line y + 1
    lqv $v23[0], 0(t0)                       ; lines y + 1 .. y + 8 (the load pair)
    lrv $v23[0], 16(t0)
    vlt $v24, $v23, $v20[0]                  ; VCC: the rows whose line has fewer than 8
    cfc2 a1, $1
    vadd $v24, $v23, $v20[1]                 ; their counts + 1 ...
    vmrg $v23, $v24, $v23                    ; ... in those lanes only
    sqv $v23[0], 0(t0)
    srv $v23[0], 16(t0)
    andi a1, a1, 255                         ; rows 0-7
    addiu at, zero, 8
    beq t9, at, nb_sn
    nop
    lqv $v23[0], 16(t0)                      ; 8 x 16: lines y + 9 .. y + 16
    lrv $v23[0], 32(t0)
    vlt $v24, $v23, $v20[0]
    cfc2 a0, $1
    vadd $v24, $v23, $v20[1]
    vmrg $v23, $v24, $v23
    sqv $v23[0], 16(t0)
    srv $v23[0], 32(t0)
    andi a0, a0, 255
    sll a0, a0, 8
    or a1, a1, a0                            ; rows 8-15
nb_sn:
    srl t0, t2, 1
    sh a1, global_nb_srows(t0)
    beq a1, zero, nb_sn2                     ; it meets the band ...
    lbu t0, global_rspq_scratch+98(t2)       ; (delay slot) its attributes
    andi t0, t0, 32
    beq t0, zero, nb_sn2                     ; ... behind the background: a possible blocker
    srl t0, t2, 2                            ; (delay slot) i
    andi t1, t0, 31
    addiu at, zero, 1
    sllv at, at, t1
    srl t0, t0, 5
    sll t0, t0, 2                            ; the bitmap's word
    lw t1, global_rspq_scratch+976(t0)
    or t1, t1, at
    sw t1, global_rspq_scratch+976(t0)
nb_sn2:
    addiu t2, t2, 4
    sltiu t0, t2, 256
    bne t0, zero, nb_si
    nop
nba_done:
    addiu t0, zero, 2                        ; the band job's next step (RspqCommand): segment 2, NesRspBandB
    sw t0, global_rspq_scratch+1012(zero)
    addiu t0, zero, nesrspbandb
    sw t0, global_rspq_scratch+1016(zero)
    jal nb_leave
    nop
    lw ra, global_nb_ra(zero)
    j nba_return
    nop

    ; ==== nbcol: v0 = the RGBA5551 colour of palette byte a0 under the band's mask (the twin's NesTwinColour),
    ; from the colour row in the scratch. Leaf: CLOBBERS t9, a0 ====
nbcol:
    andi t9, s3, 1
    beq t9, zero, nbcol1
    andi a0, a0, 63                          ; (delay slot)
    andi a0, a0, 48                          ; greyscale
nbcol1:
    sll a0, a0, 1
    lhu v0, global_rspq_scratch+1024(a0)
    andi t9, v0, 31
    sll t9, t9, 1
    andi v0, v0, 0xFFC0
    or v0, v0, t9
    jr ra
    ori v0, v0, 1                            ; (delay slot)

nba_return:
  EndASM
EndProcedure

; NesRspBandB (code segment 2) - the three layers and the band's end: the staging's rest and the status out.
Procedure NesRspBandB()
  ASM
    sw ra, global_nb_ra(zero)
    jal nb_enter                             ; s0-s7 the band's, from NesRspBandA
    nop
    ctc2 zero, $0                            ; the vector state again (VCO 0, the bank numbers)
    addiu t0, zero, global_rspq_scratch+48
    lpv $v16[0], 0(t0)
    ; ---- the three layers ----
    andi t0, s3, 16
    beq t0, zero, nb_ph0
    nop
    jal nbspr
    addiu a0, zero, 1                        ; (delay slot) phase 0: the behind-background sprites
nb_ph0:
    lw t0, global_rspq_scratch+56(zero)      ; a split line's record (N.60): its segments next (segment 6), then
    beq t0, zero, nb_ph0b                    ; the front sprites and the end (segments 7, 6)
    addiu t0, zero, 6                        ; (#NES_RSP_SEG_S)
    sw t0, global_rspq_scratch+1012(zero)
    addiu t0, zero, nesrspbands
    j nbb_out
    sw t0, global_rspq_scratch+1016(zero)    ; (delay slot)
nb_ph0b:
    andi t0, s3, 8
    beq t0, zero, nb_ph1
    nop
    jal nbbg
    nop
nb_ph1:
    lw t0, global_rspq_scratch+976(zero)     ; a behind sprite meets the band: the front sprites under the
    lw t1, global_rspq_scratch+980(zero)     ; priority rule (segment 7), then the band's end (6)
    or t0, t0, t1
    beq t0, zero, nb_ph1b
    addiu t0, zero, 7                        ; (#NES_RSP_SEG_Q)
    sw t0, global_rspq_scratch+1012(zero)
    addiu t0, zero, nesrspbandq
    j nbb_out
    sw t0, global_rspq_scratch+1016(zero)    ; (delay slot)
nb_ph1b:
    andi t0, s3, 16
    beq t0, zero, nb_ph2
    nop
    jal nbspr
    addu a0, zero, zero                      ; (delay slot) phase 2: the front ones
nb_ph2:
    addiu t0, zero, 6                        ; the band's end: segment 6 (NesRspBandE: the status, then the hand)
    sw t0, global_rspq_scratch+1012(zero)
    addiu t0, zero, nesrspbande
    sw t0, global_rspq_scratch+1016(zero)
nbb_out:
    jal nb_leave
    nop
    lw ra, global_nb_ra(zero)
    j nbb_return
    nop

    ; ==== THE BACKGROUND (phase 1): strips of one tile row ====
    ; In the tile loop: a3 L1 (the strip's end), a4 x0 = 8j - fx, a5 the strip's row mask, a6 the tiles left, a7 p
    ; (coarse X | the name table's bit 10 << 5, + j: (p & 63) indexes the two rows at 864), gp the empty-row bytes
    ; of the band's pattern half, a2 that half's pair index base; s0 TEXTURE_RECTANGLE | L1 << 2, s2 L << 2,
    ; s3 fy << 5, s4 the palette shift's coarse-Y part, s5 xmin.
nbbg:
    sw ra, global_nb_rabg(zero)
    jal nbdesc
    addu a0, zero, zero                      ; (delay slot) tiles 0-3: the background's palettes
    ; the band's visible tiles: j = xmin / 8 .. (fx ? 32 : 31); the first has xs = xmin, tile 32 has xe = 256
    andi t0, s3, 2
    beq t0, zero, nbbg_x
    addiu t1, zero, 8                        ; (delay slot) xmin 8 when the left 8 pixels are masked ...
    addu t1, zero, zero                      ; ... else 0
nbbg_x:
    srl t0, t1, 3                            ; jlo
    sw t0, global_nb_jlo(zero)
    sll t2, t0, 3
    subu t2, t2, s4
    sw t2, global_nb_x0(zero)                ; the x0 of tile jlo
    sltu t2, zero, s4
    addiu t2, t2, 32
    subu t2, t2, t0
    sw t2, global_nb_jn(zero)                ; how many: jhi + 1 - jlo
    addu a3, s0, zero                        ; L = first
    lw t0, global_rspq_scratch+20(zero)
    sw t0, global_nb_vnext(zero)             ; v at the first line
    andi t0, s2, 16
    sll a2, t0, 3                            ; the pair index's half: (PPUCTRL & 16) << 3
    sll gp, t0, 4
    addiu gp, gp, global_rspq_scratch+352    ; that half's empty-row bytes
    addu s5, t1, zero                        ; xmin
nbbg_strip:
    slt t0, a3, s1
    beq t0, zero, nbbg_done
    lw t1, global_nb_vnext(zero)             ; (delay slot) v
    sll s2, a3, 2                            ; L << 2
    srl t0, t1, 12
    andi t0, t0, 7                           ; fy
    sll s3, t0, 5                            ; fy << 5
    ; the strip's length: min(8 - fy, the lines left) when v's horizontal bits are t's (the walk then adds
    ; $1000 a line, nbstep), else 1
    lw t8, global_nb_bs+20(zero)             ; t
    xor t9, t1, t8
    andi t9, t9, 0x041F
    addiu t2, zero, 1
    bne t9, zero, nbbg_n
    subu v1, s1, a3                          ; (delay slot) the lines left
    addiu t2, zero, 8
    subu t2, t2, t0
    slt t9, v1, t2
    beq t9, zero, nbbg_n
    nop
    addu t2, v1, zero
nbbg_n:
    addiu a5, zero, 1
    sllv a5, a5, t2
    addiu a5, a5, -1
    sllv a5, a5, t0                          ; the strip's rows of a tile: ((1 << n) - 1) << fy
    addu a3, a3, t2                          ; L1
    sll s0, a3, 2
    lui t9, 0x2400
    or s0, s0, t9                            ; TEXTURE_RECTANGLE | L1 << 2
    sll t9, t2, 12
    addu a4, t1, t9
    jal nbstep                               ; the next strip's v: one step from this strip's last line
    addiu a4, a4, -4096                      ; (delay slot) its v: v + (n - 1) x $1000
    sw a4, global_nb_vnext(zero)
    ; the strip's row of the name tables with bit 10 = 0 and = 1 (864, 896) by one DMA of two rows 1 KB apart,
    ; their attribute rows (928, 936) by another
    srl t0, t1, 11
    andi t0, t0, 1
    sll t0, t0, 11                           ; bit 11
    srl t2, t1, 5
    andi t2, t2, 31                          ; coarse Y
    sll v1, t2, 5
    lw k1, global_nb_nt(zero)
    addu k1, k1, t0
    addu k1, k1, v1
    addiu k0, zero, global_rspq_scratch+864
    lui v0, 0x3E00                           ; skip 992, 2 rows, 32 bytes
    jal nbdi
    ori v0, v0, 0x101F
    srl v1, t2, 2
    sll v1, v1, 3
    addiu v1, v1, 0x3C0                      ; $3C0 + (coarse Y >> 2) x 8
    lw k1, global_nb_nt(zero)
    addu k1, k1, t0
    addu k1, k1, v1
    addiu k0, zero, global_rspq_scratch+928
    lui v0, 0x3F80                           ; skip 1016, 2 rows, 8 bytes
    jal nbdi
    ori v0, v0, 0x1007
    andi t2, t2, 2
    sll s4, t2, 1                            ; the palette shift's coarse-Y part
    andi t8, t1, 31
    srl t9, t1, 5
    andi t9, t9, 32
    or t8, t8, t9                            ; coarse X | bit 10 << 5
    lw t9, global_nb_jlo(zero)
    addu a7, t8, t9                          ; p of the first visible tile
    lw a4, global_nb_x0(zero)
    lw a6, global_nb_jn(zero)
nbbg_tile:
    andi t3, a7, 63
    lbu t0, global_rspq_scratch+864(t3)      ; the tile
    addu t8, gp, t0
    lbu t8, 0(t8)                            ; its empty-row byte
    and t8, t8, a5
    bne t8, zero, nbbg_draw                  ; a row of it in the strip has a pixel
    addiu a7, a7, 1                          ; (delay slot)
nbbg_next:
    addiu a6, a6, -1
    bgtz a6, nbbg_tile
    addiu a4, a4, 8                          ; (delay slot) the next x0
    jal nbflush
    nop
    j nbbg_strip
    nop
nbbg_draw:
    srl t8, t3, 2
    lbu t1, global_rspq_scratch+928(t8)      ; its attribute byte
    andi t8, t3, 2
    or t8, t8, s4
    srlv t1, t1, t8
    andi t1, t1, 3                           ; pal
    slt t8, a4, s5
    beq t8, zero, nbd_xs
    addu t2, a4, zero                        ; (delay slot) xs = x0 ...
    addu t2, s5, zero                        ; ... or xmin (the first tile)
nbd_xs:
    addiu t9, a4, 8                          ; xe = x0 + 8 ...
    slti t8, t9, 257
    bne t8, zero, nbd_xe
    subu t8, t2, a4                          ; (delay slot) xs - x0
    addiu t9, zero, 256                      ; ... or 256 (tile 32)
nbd_xe:
    andi v1, t0, 1
    sll v1, v1, 3
    addu t8, t8, v1                          ; s = (tile & 1) x 8 + xs - x0
    srl a0, t0, 1
    addu a0, a0, a2                          ; the pair index: a >> 5
    sll t0, t8, 21                           ; s << 21
    sll t1, t1, 24
    addiu t2, t2, 32
    sll t2, t2, 14
    or t1, t1, t2
    or t1, t1, s2                            ; w1 = pal << 24 | (xs + 32) << 14 | L << 2
    addiu t9, t9, 32
    sll t2, t9, 14
    or t2, t2, s0                            ; w0 = TEXTURE_RECTANGLE | (xe + 32) << 14 | L1 << 2
    lbu v0, global_rspq_scratch+2304(a0)     ; the pair's slot + 1 (0: absent)
    beq v0, zero, nbd_miss
    addiu v0, v0, -1                         ; (delay slot)
    lw t8, global_nb_pinm(zero)              ; pinned
    addiu t9, zero, 1
    sllv t9, t9, v0
    or t8, t8, t9
    sw t8, global_nb_pinm(zero)
nbd_slot:
    sll v1, v0, 8
    or v1, v1, s3
    or t0, t0, v1                            ; w2 = (slot x 8 + fy) << 5 | s << 21
    jal nbroom
    srl a1, t1, 24                           ; (delay slot) the rectangle's tile: its palette
    sw t2, 0(v0)
    sw t1, 4(v0)
    sw t0, 8(v0)
    lui t8, 0x0400
    ori t8, t8, 0x0400                       ; w3: the steps +1, +1
    j nbbg_next
    sw t8, 12(v0)                            ; (delay slot)
nbd_miss:
    jal nbload                               ; loaded and pinned
    nop
    j nbd_slot
    nop
nbbg_done:
    lw s0, global_nb_bs+0(zero)              ; the band's registers again
    lw s2, global_nb_bs+8(zero)
    lw s3, global_nb_bs+12(zero)
    lw s4, global_nb_bs+16(zero)
    lw s5, global_nb_bs+20(zero)
    lw ra, global_nb_rabg(zero)
    jr ra
    nop

    ; ==== nbstep: a4 = the v of the next line from a4's (the twin's walk). Leaf: CLOBBERS t8, t9 ====
nbstep:
    andi t8, a4, 0x7000
    addiu t9, zero, 0x7000
    bne t8, t9, nbstep_h
    addiu t9, a4, 0x1000                     ; (delay slot) fine Y + 1
    andi t9, a4, 0x0FFF                      ; fine Y 7: fine Y 0, coarse Y + 1 ...
    srl t8, t9, 5
    andi t8, t8, 31
    xori t8, t8, 29
    bne t8, zero, nbstep_y1
    xori t8, t8, 29                          ; (delay slot) coarse Y again
    xori t9, t9, 0x0800                      ; ... row 29: the other name table, row 0
    addiu t8, zero, -1
nbstep_y1:
    addiu t8, t8, 1
    andi t8, t8, 31
    andi t9, t9, 0x7C1F
    sll t8, t8, 5
    or t9, t9, t8
nbstep_h:
    andi a4, t9, 0x7BE0
    lw t8, global_nb_bs+20(zero)             ; t
    andi t8, t8, 0x041F
    jr ra
    or a4, a4, t8                            ; (delay slot) the horizontal bits from t

    ; ==== nbroom: room for one rectangle in the queue (NesTwinTexRect's flush at 64); a1 = its tile, owed at the
    ; flush; v0 = its 16 bytes. CLOBBERS nbflush's ====
nbroom:
    lw v0, global_nb_rects(zero)
    sltiu v1, v0, 64
    bne v1, zero, nbroom1
    nop
    sw ra, global_nb_raroom(zero)
    sw a1, global_nb_rtile(zero)
    jal nbflush
    nop
    lw a1, global_nb_rtile(zero)
    lw ra, global_nb_raroom(zero)
    addu v0, zero, zero
nbroom1:
    addiu v1, v0, 1
    sw v1, global_nb_rects(zero)
    addiu t8, zero, 1
    sllv t8, t8, a1
    lw t9, global_nb_qtiles(zero)
    or t9, t9, t8
    sw t9, global_nb_qtiles(zero)
    sll v0, v0, 4
    jr ra
    addiu v0, v0, global_rspq_scratch+1024   ; (delay slot)

    ; ==== THE SPRITES (phases 0 and 2): a0 = 1 the behind-background ones, 0 the front ones; highest index first ====
nbspr:
    sw ra, global_nb_raspr(zero)
    addu a6, a0, zero
    lw a7, global_nb_h(zero)                 ; h
    addiu a2, zero, 252                      ; sprite 63 x 4
nbsp_i:
    srl v1, a2, 1
    lhu a5, global_nb_srows(v1)              ; the rows the selection drew (bit r: line y + 1 + r)
    beq a5, zero, nbsp_next                  ; none: nothing of it in this band
    nop
    lbu t3, global_rspq_scratch+98(a2)       ; at
    srl v1, t3, 5
    andi v1, v1, 1
    bne v1, a6, nbsp_next                    ; not this phase's
    nop
    sw t3, global_nb_sat(zero)
    lbu t0, global_rspq_scratch+96(a2)       ; y
    lbu t1, global_rspq_scratch+99(a2)       ; x0
    sw t1, global_nb_sx0(zero)
    addiu t2, t1, 8
    slti v1, t2, 257
    bne v1, zero, nbsp_xe
    nop
    addiu t2, zero, 256                      ; xe = min(x0 + 8, 256)
nbsp_xe:
    andi v1, s3, 4
    bne v1, zero, nbsp_xs                    ; the left 8 pixels shown
    slti v1, t1, 8                           ; (delay slot)
    beq v1, zero, nbsp_xs
    nop
    addiu t1, zero, 8                        ; xs = 8
nbsp_xs:
    slt v1, t1, t2
    beq v1, zero, nbsp_next                  ; nothing shows
    nop
    addu a3, zero, zero                      ; r
nbsp_r:
    sltu v1, a3, a7
    beq v1, zero, nbsp_next
    srlv v1, a5, a3                          ; (delay slot)
    andi v1, v1, 1
    bne v1, zero, nbsp_run
    nop
    j nbsp_r
    addiu a3, a3, 1                          ; (delay slot)
nbsp_run:
    addiu a4, a3, 1                          ; r1: the run of drawn rows in one 8-row half
nbsp_r1:
    sltu v1, a4, a7
    beq v1, zero, nbsp_r1x
    srlv v1, a5, a4                          ; (delay slot)
    andi v1, v1, 1
    beq v1, zero, nbsp_r1x
    srl v1, a4, 3                            ; (delay slot)
    srl t3, a3, 3
    bne v1, t3, nbsp_r1x
    nop
    j nbsp_r1
    addiu a4, a4, 1                          ; (delay slot)
nbsp_r1x:
    lw t3, global_nb_sat(zero)
    andi v1, t3, 128
    beq v1, zero, nbsp_nf
    addu gp, a3, zero                        ; (delay slot) rr = r
    subu gp, a7, a3
    addiu gp, gp, -1                         ; flipped: rr = h - 1 - r
nbsp_nf:
    lbu v1, global_rspq_scratch+97(a2)       ; tile
    addiu t3, zero, 8
    bne a7, t3, nbsp_16
    nop
    andi t3, s2, 8                           ; 8 x 8: ta = tile, a = (ctrl & 8) << 9 | ta << 4
    sll t3, t3, 9
    sll a0, v1, 4
    or a0, a0, t3
    j nbsp_ta
    addu a1, v1, zero                        ; (delay slot)
nbsp_16:
    srl t3, gp, 3                            ; 8 x 16: half = rr >> 3, ta = (tile & 254) + half
    andi a1, v1, 254
    addu a1, a1, t3
    andi t3, v1, 1
    sll t3, t3, 12
    sll a0, a1, 4
    or a0, a0, t3                            ; a = (tile & 1) << 12 | ta << 4
nbsp_ta:
    sw a1, global_nb_sta(zero)
    ; the empty test: rows lo .. hi of the tile (the run's rr & 7)
    lw t3, global_nb_sat(zero)
    andi t3, t3, 128
    addu v1, a3, zero                        ; lo = r
    beq t3, zero, nbsp_lohi
    addiu t8, a4, -1                         ; (delay slot) hi = r1 - 1
    subu v1, a7, a4                          ; flipped: lo = h - r1
    subu t8, a7, a3
    addiu t8, t8, -1                         ; hi = h - 1 - r
nbsp_lohi:
    andi v1, v1, 7
    andi t8, t8, 7
    subu t8, t8, v1
    addiu t8, t8, 1
    addiu t9, zero, 1
    sllv t9, t9, t8
    addiu t9, t9, -1
    sllv t9, t9, v1                          ; the rows
    srl v1, a0, 4                            ; the tile's empty-row byte: bank slot x 64 + tile = a >> 4
    lbu v1, global_rspq_scratch+352(v1)
    and v1, v1, t9
    beq v1, zero, nbsp_runx                  ; empty: not drawn
    nop
    sw a0, global_nb_sa(zero)
    jal nbdesc
    addiu a0, zero, 4                        ; (delay slot) tiles 0-3: the sprites' palettes
    lw a0, global_nb_sa(zero)
    jal nbpair
    srl a0, a0, 5                            ; (delay slot) the pair index: a >> 5
    sw v0, global_nb_slot(zero)
    lw a1, global_nb_sat(zero)
    jal nbroom
    andi a1, a1, 3                           ; (delay slot) the rectangle's tile: its palette
    addu t3, t0, a4
    addiu t3, t3, 1                          ; L1 = y + 1 + r1
    addiu v1, t2, 32
    sll v1, v1, 14
    lui a0, 0x2400
    or a0, a0, v1
    sll t3, t3, 2
    or a0, a0, t3
    sw a0, 0(v0)                             ; w0
    lw t3, global_nb_sat(zero)
    andi a0, t3, 3
    sll a0, a0, 24
    addiu v1, t1, 32
    sll v1, v1, 14
    or a0, a0, v1
    addu v1, t0, a3
    addiu v1, v1, 1                          ; L = y + 1 + r
    sll v1, v1, 2
    or a0, a0, v1
    sw a0, 4(v0)                             ; w1: palette at & 3
    lw a0, global_nb_sx0(zero)
    subu a0, t1, a0                          ; xs - x0
    lw a1, global_nb_sta(zero)
    andi a1, a1, 1
    sll a1, a1, 3                            ; (ta & 1) x 8
    andi v1, t3, 64
    beq v1, zero, nbsp_nh
    lui t9, 0x0400                           ; (delay slot) ds = +1
    subu a0, a1, a0
    addiu a0, a0, 7                          ; mirrored: s from the right
    j nbsp_s
    lui t9, 0xFC00                           ; (delay slot) ds = -1
nbsp_nh:
    addu a0, a1, a0
nbsp_s:
    sll a0, a0, 21
    lw a1, global_nb_slot(zero)
    sll a1, a1, 3
    andi v1, gp, 7
    addu a1, a1, v1
    sll a1, a1, 5                            ; t = slot x 8 + (rr & 7)
    or a0, a0, a1
    sw a0, 8(v0)                             ; w2
    andi v1, t3, 128
    beq v1, zero, nbsp_nv
    ori t9, t9, 0x0400                       ; (delay slot) dt = +1
    xori t9, t9, 0x0400
    ori t9, t9, 0xFC00                       ; flipped: dt = -1
nbsp_nv:
    sw t9, 12(v0)                            ; w3
nbsp_runx:
    j nbsp_r
    addu a3, a4, zero                        ; (delay slot) on from r1
nbsp_next:
    addiu a2, a2, -4
    bgez a2, nbsp_i
    nop
    jal nbflush
    nop
    lw ra, global_nb_raspr(zero)
    jr ra
    nop

nbb_return:
  EndASM
EndProcedure

; NesRspBandS (code segment 6, design note N.60) - A SPLIT LINE'S BACKGROUND: the record's segments, each a one-line
; strip of the spans [k0, k1) under its own v, fine X, PPUCTRL, PPUMASK, CHR banks and name-table bytes (the CPU's
; entry, rspband.n64: 80 bytes of rows in the strip's layout at scratch 864, then the parameters at 944: k0, k1, fine X,
; PPUCTRL, PPUMASK, 0, v, the 8 bank numbers at 952). Tile j = T(p - k0 + j) at x 8j - fine X, cut to [xlo, xhi):
; xlo = 8 k0 (8 when k0 = 0 and PPUMASK bit 1 is clear), xhi = 8 k1 - the twin's NesTwinBand, split records. A segment
; whose banks are not those in force takes them (the empty-row bytes, $v16, the pair table: nbs_banks); after the last
; the record's are put back for the front sprites. The rectangles are written after each segment. Then segment 7.
; SCRATCH used here: 960 the record's banks (8), 968 the segments left, 972 the next entry's address.
; REGISTERS in the strip: as nbbg's (segment 2), with s1 = xhi.
Procedure NesRspBandS()
  ASM
    sw ra, global_nb_ra(zero)
    jal nb_enter
    nop
    ctc2 zero, $0
    vxor $v21, $v21, $v21
    addiu t0, zero, global_rspq_scratch+48
    lpv $v16[0], 0(t0)
    lw t0, global_rspq_scratch+48(zero)      ; the record's banks kept
    sw t0, global_rspq_scratch+960(zero)
    lw t0, global_rspq_scratch+52(zero)
    sw t0, global_rspq_scratch+964(zero)
    lw t0, global_rspq_scratch+56(zero)
    sw t0, global_rspq_scratch+968(zero)     ; the segments
    lw t0, global_rspq_scratch+60(zero)
    sw t0, global_rspq_scratch+972(zero)     ; the first entry
    jal nbdesc
    addu a0, zero, zero                      ; (delay slot) tiles 0-3: the background's palettes
    sll s2, s0, 2                            ; L << 2 (the line, for every segment)
    addiu t0, s0, 1
    sll s0, t0, 2
    lui t9, 0x2400
    or s0, s0, t9                            ; TEXTURE_RECTANGLE | L1 << 2
nbs_seg:
    lw t0, global_rspq_scratch+968(zero)
    beq t0, zero, nbs_done
    addiu t0, t0, -1                         ; (delay slot)
    sw t0, global_rspq_scratch+968(zero)
    addiu k0, zero, global_rspq_scratch+864  ; the entry's 96 bytes
    lw k1, global_rspq_scratch+972(zero)
    jal nbdi
    addiu v0, zero, 95
    lw t0, global_rspq_scratch+972(zero)
    addiu t0, t0, 96
    sw t0, global_rspq_scratch+972(zero)
    lw t0, global_rspq_scratch+952(zero)     ; its banks those in force?
    lw t1, global_rspq_scratch+48(zero)
    bne t0, t1, nbs_bank
    lw t2, global_rspq_scratch+956(zero)     ; (delay slot)
    lw t1, global_rspq_scratch+52(zero)
    beq t2, t1, nbs_bank_ok
    nop
nbs_bank:
    sw t0, global_rspq_scratch+48(zero)
    jal nbs_banks
    sw t2, global_rspq_scratch+52(zero)      ; (delay slot)
nbs_bank_ok:
    lbu t0, global_rspq_scratch+944(zero)    ; k0
    lbu t1, global_rspq_scratch+948(zero)    ; PPUMASK
    sll s5, t0, 3                            ; xlo = 8 k0 ...
    bne t0, zero, nbs_xlo
    andi t1, t1, 2                           ; (delay slot)
    bne t1, zero, nbs_xlo
    nop
    addiu s5, zero, 8                        ; ... 8 for span 0 with the left column hidden
nbs_xlo:
    lbu t1, global_rspq_scratch+945(zero)
    sll s1, t1, 3                            ; xhi = 8 k1
    slt t1, s5, s1
    beq t1, zero, nbs_seg                    ; nothing of it visible
    lbu t2, global_rspq_scratch+946(zero)    ; (delay slot) fine X
    andi t2, t2, 7
    srl t3, s5, 3                            ; jlo
    sll a4, t3, 3
    subu a4, a4, t2                          ; x0 of tile jlo
    addu a6, s1, t2
    addiu a6, a6, -1
    srl a6, a6, 3                            ; jhi = (xhi + fine X - 1) >> 3
    subu a6, a6, t3
    addiu a6, a6, 1                          ; the tiles
    lhu t1, global_rspq_scratch+950(zero)    ; v
    srl t2, t1, 12
    andi t2, t2, 7                           ; fy
    sll s3, t2, 5
    addiu a5, zero, 1
    sllv a5, a5, t2                          ; the row mask: the one row
    srl t2, t1, 5
    andi t2, t2, 2
    sll s4, t2, 1                            ; the palette shift's coarse-Y part
    andi t8, t1, 31
    srl t9, t1, 5
    andi t9, t9, 32
    or t8, t8, t9                            ; p of v: coarse X | bit 10 << 5
    subu t8, t8, t0
    addu a7, t8, t3                          ; p of tile jlo: p - k0 + jlo
    lbu t1, global_rspq_scratch+947(zero)    ; PPUCTRL
    andi t1, t1, 16
    sll a2, t1, 3                            ; the pair index's half
    sll gp, t1, 4
    addiu gp, gp, global_rspq_scratch+352    ; that half's empty-row bytes
nbs_tile:
    andi t3, a7, 63
    lbu t0, global_rspq_scratch+864(t3)      ; the tile
    addu t8, gp, t0
    lbu t8, 0(t8)
    and t8, t8, a5
    bne t8, zero, nbs_draw
    addiu a7, a7, 1                          ; (delay slot)
nbs_next:
    addiu a6, a6, -1
    bgtz a6, nbs_tile
    addiu a4, a4, 8                          ; (delay slot)
    jal nbflush
    nop
    j nbs_seg
    nop
nbs_draw:
    srl t8, t3, 2
    lbu t1, global_rspq_scratch+928(t8)      ; its attribute byte
    andi t8, t3, 2
    or t8, t8, s4
    srlv t1, t1, t8
    andi t1, t1, 3                           ; pal
    slt t8, a4, s5
    beq t8, zero, nbs_xs
    addu t2, a4, zero                        ; (delay slot) xs = x0 ...
    addu t2, s5, zero                        ; ... or xlo
nbs_xs:
    addiu t9, a4, 8                          ; xe = x0 + 8 ...
    slt t8, s1, t9
    beq t8, zero, nbs_xe
    subu t8, t2, a4                          ; (delay slot) xs - x0
    addu t9, s1, zero                        ; ... or xhi
nbs_xe:
    andi v1, t0, 1
    sll v1, v1, 3
    addu t8, t8, v1                          ; s = (tile & 1) x 8 + xs - x0
    srl a0, t0, 1
    addu a0, a0, a2                          ; the pair index
    sll t0, t8, 21
    sll t1, t1, 24
    addiu t2, t2, 32
    sll t2, t2, 14
    or t1, t1, t2
    or t1, t1, s2                            ; w1
    addiu t9, t9, 32
    sll t2, t9, 14
    or t2, t2, s0                            ; w0
    lbu v0, global_rspq_scratch+2304(a0)
    beq v0, zero, nbs_miss
    addiu v0, v0, -1                         ; (delay slot)
    lw t8, global_nb_pinm(zero)
    addiu t9, zero, 1
    sllv t9, t9, v0
    or t8, t8, t9
    sw t8, global_nb_pinm(zero)
nbs_slot:
    sll v1, v0, 8
    or v1, v1, s3
    or t0, t0, v1                            ; w2
    jal nbs_room
    srl a1, t1, 24                           ; (delay slot)
    sw t2, 0(v0)
    sw t1, 4(v0)
    sw t0, 8(v0)
    lui t8, 0x0400
    ori t8, t8, 0x0400
    j nbs_next
    sw t8, 12(v0)                            ; (delay slot)
nbs_miss:
    jal nbload
    nop
    j nbs_slot
    nop
nbs_done:
    lw t0, global_rspq_scratch+960(zero)     ; the record's banks back for the front sprites
    lw t1, global_rspq_scratch+48(zero)
    bne t0, t1, nbs_rb
    lw t2, global_rspq_scratch+964(zero)     ; (delay slot)
    lw t1, global_rspq_scratch+52(zero)
    beq t2, t1, nbs_end
    nop
nbs_rb:
    sw t0, global_rspq_scratch+48(zero)
    jal nbs_banks
    sw t2, global_rspq_scratch+52(zero)      ; (delay slot)
nbs_end:
    lw s0, global_nb_bs+0(zero)              ; the band's registers again
    lw s1, global_nb_bs+4(zero)
    lw s2, global_nb_bs+8(zero)
    lw s3, global_nb_bs+12(zero)
    lw s4, global_nb_bs+16(zero)
    lw s5, global_nb_bs+20(zero)
    addiu t0, zero, 7                        ; next: segment 7 (#NES_RSP_SEG_Q), the front sprites
    sw t0, global_rspq_scratch+1012(zero)
    addiu t0, zero, nesrspbandq
    sw t0, global_rspq_scratch+1016(zero)
    jal nb_leave
    nop
    lw ra, global_nb_ra(zero)
    j nbs_return
    nop

    ; ==== nbs_banks: the banks at scratch 48 in force: their empty-row bytes (8 DMAs), $v16, the pair table from the
    ; 32 keys (as NesRspBandA does at a band's start). Nothing is queued (each segment ends with a flush).
    ; CLOBBERS t0, t1, a0, a1, k0, k1, v0, t8, t9, at, $v9, $v10 ====
nbs_banks:
    sw ra, global_nb_raroom(zero)
    addu t0, zero, zero
nbs_mk:
    lbu t1, global_rspq_scratch+48(t0)
    sll t1, t1, 6
    lw k1, global_nb_mask(zero)
    addu k1, k1, t1
    sll k0, t0, 6
    addiu k0, k0, global_rspq_scratch+352
    jal nbdi
    addiu v0, zero, 63
    addiu t0, t0, 1
    sltiu t1, t0, 8
    bne t1, zero, nbs_mk
    nop
    addiu t0, zero, global_rspq_scratch+48
    lpv $v16[0], 0(t0)
    addiu t0, zero, global_rspq_scratch+2304
    addiu t1, zero, global_rspq_scratch+2560
nbs_tz:
    sqv $v21[0], 0(t0)
    addiu t0, t0, 16
    bne t0, t1, nbs_tz
    nop
    addu t0, zero, zero
nbs_tk:
    sll t1, t0, 2
    lw a0, global_nb_keys(t1)
    jal nbtab
    addiu a1, t0, 1                          ; (delay slot)
    addiu t0, t0, 1
    sltiu t1, t0, 32
    bne t1, zero, nbs_tk
    nop
    lw ra, global_nb_raroom(zero)
    jr ra
    nop

    ; ==== nbs_room: nbroom (segment 2) here too ====
nbs_room:
    lw v0, global_nb_rects(zero)
    sltiu v1, v0, 64
    bne v1, zero, nbs_room1
    nop
    sw ra, global_nb_raroom(zero)
    sw a1, global_nb_rtile(zero)
    jal nbflush
    nop
    lw a1, global_nb_rtile(zero)
    lw ra, global_nb_raroom(zero)
    addu v0, zero, zero
nbs_room1:
    addiu v1, v0, 1
    sw v1, global_nb_rects(zero)
    addiu t8, zero, 1
    sllv t8, t8, a1
    lw t9, global_nb_qtiles(zero)
    or t9, t9, t8
    sw t9, global_nb_qtiles(zero)
    sll v0, v0, 4
    jr ra
    addiu v0, v0, global_rspq_scratch+1024   ; (delay slot)
nbs_return:
  EndASM
EndProcedure

; NesRspBandE (code segment 6, with NesRspBandS) - the band's end after segment 7: the staging's rest and the status
; out, as segment 2's (N.60).
Procedure NesRspBandE()
  ASM
    sw ra, global_nb_ra(zero)
    jal nb_enter
    nop
    jal nbsend                               ; the band's end, as segment 2's
    nop
nbe_e1:
    mfc0 at, $4
    andi at, at, 12
    bne at, zero, nbe_e1
    nop
    lw t0, global_nb_odram(zero)
    lw t1, global_nb_out(zero)
    subu t0, t0, t1
    srl t0, t0, 3
    sw t0, global_rspq_scratch+944(zero)
    lw t0, global_nb_over(zero)
    sw t0, global_rspq_scratch+948(zero)
    mfc0 t1, $12
    lw t2, global_nb_clk0(zero)
    subu t1, t1, t2
    lui t2, 0x00FF
    ori t2, t2, 0xFFFF
    and t1, t1, t2
    lw t2, global_nb_clk(zero)
    addu t2, t2, t1
    sw t2, global_nb_clk(zero)
    sw t2, global_rspq_scratch+952(zero)
    lw t0, global_nb_idx(zero)
    addiu t0, t0, 1
    sw t0, global_rspq_scratch+956(zero)
    lw k1, global_nb_lim(zero)
    addiu k0, zero, global_rspq_scratch+944
    jal nbdo
    addiu v0, zero, 15
    ; THE HAND (N.62): the set's words written so far; if its frame is attached, handed to the RDP now unless a
    ; START is pending (then the next band's end, or the frame's HAND step, hands them)
    lw t0, global_nb_odram(zero)
    lw t1, global_nb_out(zero)
    subu t0, t0, t1                          ; bytes written
    lw t2, global_nb_set(zero)
    sll t3, t2, 2
    sw t0, global_nb_wr(t3)
    lw t8, global_nb_att(zero)
    srlv t8, t8, t2
    andi t8, t8, 1
    beq t8, zero, nbe_out                    ; not attached: the HAND step hands them
    lw a0, global_nb_hnd(t3)                 ; (delay slot)
    beq a0, t0, nbe_out                      ; nothing new
    addu a1, t1, t0                          ; (delay slot) the end
    jal rspqrdphand
    addu a0, t1, a0                          ; (delay slot) the start
    beq a0, zero, nbe_out                    ; a START pending: later
    lw t2, global_nb_set(zero)               ; (delay slot)
    sll t2, t2, 2
    lw t0, global_nb_wr(t2)
    sw t0, global_nb_hnd(t2)                 ; handed
nbe_out:
    jal nb_leave
    nop
    lw ra, global_nb_ra(zero)
    j nbe_return
    nop

nbe_return:
  EndASM
EndProcedure

; NesRspHand (code segment 6, design note N.62) - THE HAND STEP: NES_RSP_BAND with record 0 (segment 1 sends it
; here). RspqArg 1 the set's area (physical), 2 the set (bit 0) | 256 for the frame's last. The set is marked attached
; (its frame's attach has been queued before this, behind the CPU's gate: the SYNC_FULL before it is through), every
; word of it written and not yet handed is handed (RspqRdpHand), and with 256 the set is no longer attached after. With a START pending it tries again, reading SP signal 1 meanwhile: set,
; it gives up its turn (rspqk_again: nothing it did is undone by running it again) and the priority ring runs first.
Procedure NesRspHand()
  ASM
    sw ra, global_nb_ra(zero)
    lw t2, global_rspqarg+8(zero)
    andi t2, t2, 1
    addiu t3, zero, 1
    sllv t3, t3, t2
    lw t8, global_nb_att(zero)
    or t8, t8, t3
    sw t8, global_nb_att(zero)               ; attached
nbh_try:
    lw t2, global_rspqarg+8(zero)
    andi t2, t2, 1
    sll t2, t2, 2
    lw a0, global_nb_hnd(t2)
    lw a1, global_nb_wr(t2)
    beq a0, a1, nbh_done                     ; everything handed
    lw t1, global_rspqarg+4(zero)            ; (delay slot) the area
    addu a1, t1, a1
    jal rspqrdphand
    addu a0, t1, a0                          ; (delay slot)
    bne a0, zero, nbh_handed
    nop
    mfc0 at, $4                              ; a START pending: SP signal 1?
    andi at, at, 0x100
    beq at, zero, nbh_try                    ; no: try again
    nop
    j rspqk_again                            ; yes: this step again after the priority ring
    nop
nbh_handed:
    lw t2, global_rspqarg+8(zero)
    andi t2, t2, 1
    sll t2, t2, 2
    lw t0, global_nb_wr(t2)
    sw t0, global_nb_hnd(t2)
nbh_done:
    lw t2, global_rspqarg+8(zero)
    andi t3, t2, 256
    beq t3, zero, nbh_out                    ; not the frame's last: it stays attached
    andi t2, t2, 1                           ; (delay slot)
    addiu t3, zero, 1
    sllv t3, t3, t2
    nor t3, t3, zero
    lw t8, global_nb_att(zero)
    and t8, t8, t3
    sw t8, global_nb_att(zero)               ; its frame detached: the set's next frame attaches it again
nbh_out:
    lw ra, global_nb_ra(zero)
    j nbh_return
    nop
nbh_return:
  EndASM
EndProcedure

; NesRspBandQ (code segment 7, design note N.60) - THE FRONT SPRITES UNDER THE PRIORITY RULE, then the band's end. Run
; for a band a behind sprite meets (segment 1's bitmap at scratch 976 / 980) and for every split line's record. A
; front sprite i is drawn only where no behind sprite k < i selected on the same line is opaque: its BLOCKERS are the
; behind sprites k < i that meet the band with |x_k - x_i| < 8 (scratch 984 / 988); a line of i on which a blocker
; is selected is drawn alone - the blockers' opaque pixels there (their pair rows, nbq_am) taken out of [xs, xe), each
; run of what is left one rectangle - and ends the run of i's other lines. With no blocker a sprite is drawn exactly as
; segment 2's nbspr draws it (the same code). The twin's NesTwinBand, phase 2.
; SCRATCH used here: 960 ra of nbq_am, 964 a blocker's tile, 984 / 988 the blockers, 992 the pixels left, 996 a
; blocker's attributes, 1000 its pair row (8 bytes), 968 the clip flag of the run being drawn.
Procedure NesRspBandQ()
  ASM
    sw ra, global_nb_ra(zero)
    jal nb_enter
    nop
    addiu t0, zero, global_rspq_scratch+48   ; $v16 the banks again (VCO is 0 still: segments 2 / 3 ran before)
    lpv $v16[0], 0(t0)
    andi t0, s3, 16
    beq t0, zero, nbq_end
    nop
    jal nbqspr
    nop
nbq_end:
    addiu t0, zero, 6                        ; next: the band's end (segment 6, NesRspBandE: this segment is full)
    sw t0, global_rspq_scratch+1012(zero)
    addiu t0, zero, nesrspbande
    sw t0, global_rspq_scratch+1016(zero)
    jal nb_leave
    nop
    lw ra, global_nb_ra(zero)
    j nbq_return
    nop

    ; ==== nbqspr: phase 2, highest index first (nbspr with the rule) ====
nbqspr:
    sw ra, global_nb_raspr(zero)
    lw a7, global_nb_h(zero)
    addiu a2, zero, 252
nbqs_i:
    srl v1, a2, 1
    lhu a5, global_nb_srows(v1)
    beq a5, zero, nbqs_next
    nop
    lbu t3, global_rspq_scratch+98(a2)
    andi v1, t3, 32
    bne v1, zero, nbqs_next                  ; behind: phase 0's
    nop
    sw t3, global_nb_sat(zero)
    lbu t0, global_rspq_scratch+96(a2)       ; y
    lbu t1, global_rspq_scratch+99(a2)       ; x0
    sw t1, global_nb_sx0(zero)
    addiu t2, t1, 8
    slti v1, t2, 257
    bne v1, zero, nbqs_xe
    nop
    addiu t2, zero, 256
nbqs_xe:
    andi v1, s3, 4
    bne v1, zero, nbqs_xs
    slti v1, t1, 8                           ; (delay slot)
    beq v1, zero, nbqs_xs
    nop
    addiu t1, zero, 8
nbqs_xs:
    slt v1, t1, t2
    beq v1, zero, nbqs_next
    nop
    ; the blockers: behind sprites k < i meeting the band, |x_k - x_i| < 8
    sw zero, global_rspq_scratch+984(zero)
    sw zero, global_rspq_scratch+988(zero)
    addu t3, zero, zero                      ; k
nbqb_l:
    srl v1, a2, 2
    slt at, t3, v1
    beq at, zero, nbqb_done
    srl at, t3, 5                            ; (delay slot)
    sll at, at, 2
    lw t8, global_rspq_scratch+976(at)
    andi t9, t3, 31
    srlv t8, t8, t9
    andi t8, t8, 1
    beq t8, zero, nbqb_n
    sll t8, t3, 2                            ; (delay slot)
    lbu t8, global_rspq_scratch+99(t8)       ; x_k
    lw v1, global_nb_sx0(zero)
    subu t8, t8, v1
    addiu t8, t8, 7
    sltiu t8, t8, 15
    beq t8, zero, nbqb_n
    addiu v1, zero, 1                        ; (delay slot)
    sllv v1, v1, t9
    lw t8, global_rspq_scratch+984(at)
    or t8, t8, v1
    sw t8, global_rspq_scratch+984(at)
nbqb_n:
    j nbqb_l
    addiu t3, t3, 1                          ; (delay slot)
nbqb_done:
    addu a3, zero, zero                      ; r
nbqs_r:
    sltu v1, a3, a7
    beq v1, zero, nbqs_next
    srlv v1, a5, a3                          ; (delay slot)
    andi v1, v1, 1
    bne v1, zero, nbqs_run
    nop
    j nbqs_r
    addiu a3, a3, 1                          ; (delay slot)
nbqs_run:
    addu a0, t0, a3
    jal nbq_blk                              ; a blocker selected on this line?
    addiu a0, a0, 1                          ; (delay slot) L = y + 1 + r
    sw v0, global_rspq_scratch+968(zero)     ; the clip flag
    bne v0, zero, nbqs_r1x                   ; yes: the line alone
    addiu a4, a3, 1                          ; (delay slot) r1
nbqs_r1:
    sltu v1, a4, a7
    beq v1, zero, nbqs_r1x
    srlv v1, a5, a4                          ; (delay slot)
    andi v1, v1, 1
    beq v1, zero, nbqs_r1x
    srl v1, a4, 3                            ; (delay slot)
    srl t3, a3, 3
    bne v1, t3, nbqs_r1x
    addu a0, t0, a4                          ; (delay slot)
    jal nbq_blk
    addiu a0, a0, 1                          ; (delay slot)
    bne v0, zero, nbqs_r1x                   ; a line with a blocker ends the run
    nop
    j nbqs_r1
    addiu a4, a4, 1                          ; (delay slot)
nbqs_r1x:
    lw t3, global_nb_sat(zero)
    andi v1, t3, 128
    beq v1, zero, nbqs_nf
    addu gp, a3, zero                        ; (delay slot)
    subu gp, a7, a3
    addiu gp, gp, -1
nbqs_nf:
    lbu v1, global_rspq_scratch+97(a2)
    addiu t3, zero, 8
    bne a7, t3, nbqs_16
    nop
    andi t3, s2, 8
    sll t3, t3, 9
    sll a0, v1, 4
    or a0, a0, t3
    j nbqs_ta
    addu a1, v1, zero                        ; (delay slot)
nbqs_16:
    srl t3, gp, 3
    andi a1, v1, 254
    addu a1, a1, t3
    andi t3, v1, 1
    sll t3, t3, 12
    sll a0, a1, 4
    or a0, a0, t3
nbqs_ta:
    sw a1, global_nb_sta(zero)
    lw t3, global_nb_sat(zero)
    andi t3, t3, 128
    addu v1, a3, zero
    beq t3, zero, nbqs_lohi
    addiu t8, a4, -1                         ; (delay slot)
    subu v1, a7, a4
    subu t8, a7, a3
    addiu t8, t8, -1
nbqs_lohi:
    andi v1, v1, 7
    andi t8, t8, 7
    subu t8, t8, v1
    addiu t8, t8, 1
    addiu t9, zero, 1
    sllv t9, t9, t8
    addiu t9, t9, -1
    sllv t9, t9, v1
    srl v1, a0, 4
    lbu v1, global_rspq_scratch+352(v1)
    and v1, v1, t9
    beq v1, zero, nbqs_runx                  ; empty: not drawn
    nop
    sw a0, global_nb_sa(zero)
    lw v1, global_rspq_scratch+968(zero)
    beq v1, zero, nbqs_desc
    nop
    addu a0, t0, a3                          ; the line alone: the pixels the blockers leave
    jal nbq_am
    addiu a0, a0, 1                          ; (delay slot)
    beq v1, zero, nbqs_runx                  ; none: nothing drawn
    nop
nbqs_desc:
    jal nbdesc
    addiu a0, zero, 4                        ; (delay slot)
    lw a0, global_nb_sa(zero)
    jal nbpair
    srl a0, a0, 5                            ; (delay slot)
    sw v0, global_nb_slot(zero)
    lw v1, global_rspq_scratch+968(zero)
    bne v1, zero, nbqs_pieces
    nop
    jal nbq_rect                             ; the run, one rectangle
    nop
nbqs_runx:
    j nbqs_r
    addu a3, a4, zero                        ; (delay slot)
nbqs_pieces:                                 ; each run of the pixels left, [x0 + c, x0 + c1)
    sw t1, global_rspq_scratch+996(zero)     ; xs, xe kept
    sw t2, global_rspq_scratch+964(zero)
    lw v1, global_rspq_scratch+992(zero)
    addu a6, zero, zero                      ; c
nbqs_pc:
    slti t3, a6, 8
    beq t3, zero, nbqs_pend
    srlv t3, v1, a6                          ; (delay slot)
    andi t3, t3, 1
    bne t3, zero, nbqs_pr
    nop
    j nbqs_pc
    addiu a6, a6, 1                          ; (delay slot)
nbqs_pr:
    addiu t9, a6, 1                          ; c1
nbqs_pr1:
    slti t3, t9, 8
    beq t3, zero, nbqs_pr2
    srlv t3, v1, t9                          ; (delay slot)
    andi t3, t3, 1
    beq t3, zero, nbqs_pr2
    nop
    j nbqs_pr1
    addiu t9, t9, 1                          ; (delay slot)
nbqs_pr2:
    lw t3, global_nb_sx0(zero)
    addu t1, t3, a6
    addu t2, t3, t9
    sw t9, global_rspq_scratch+1004(zero)
    jal nbq_rect
    nop
    lw a6, global_rspq_scratch+1004(zero)    ; on from c1
    j nbqs_pc
    lw v1, global_rspq_scratch+992(zero)     ; (delay slot)
nbqs_pend:
    lw t1, global_rspq_scratch+996(zero)     ; the sprite's xs, xe again
    lw t2, global_rspq_scratch+964(zero)
    j nbqs_r
    addu a3, a4, zero                        ; (delay slot)
nbqs_next:
    addiu a2, a2, -4
    bgez a2, nbqs_i
    nop
    jal nbflush
    nop
    lw ra, global_nb_raspr(zero)
    jr ra
    nop

    ; ==== nbq_rect: one rectangle of sprite a2 / 4: xs t1, xe t2, rows a3 .. a4 - 1, y t0, rr gp (nbspr's words).
    ; Keeps t0-t2, a2-a7, gp. ====
nbq_rect:
    sw ra, global_nb_rapair(zero)
    lw a1, global_nb_sat(zero)
    jal nbq_room
    andi a1, a1, 3                           ; (delay slot)
    addu t3, t0, a4
    addiu t3, t3, 1
    addiu v1, t2, 32
    sll v1, v1, 14
    lui a0, 0x2400
    or a0, a0, v1
    sll t3, t3, 2
    or a0, a0, t3
    sw a0, 0(v0)
    lw t3, global_nb_sat(zero)
    andi a0, t3, 3
    sll a0, a0, 24
    addiu v1, t1, 32
    sll v1, v1, 14
    or a0, a0, v1
    addu v1, t0, a3
    addiu v1, v1, 1
    sll v1, v1, 2
    or a0, a0, v1
    sw a0, 4(v0)
    lw a0, global_nb_sx0(zero)
    subu a0, t1, a0
    lw a1, global_nb_sta(zero)
    andi a1, a1, 1
    sll a1, a1, 3
    andi v1, t3, 64
    beq v1, zero, nbqr_nh
    lui t9, 0x0400                           ; (delay slot)
    subu a0, a1, a0
    addiu a0, a0, 7
    j nbqr_s
    lui t9, 0xFC00                           ; (delay slot)
nbqr_nh:
    addu a0, a1, a0
nbqr_s:
    sll a0, a0, 21
    lw a1, global_nb_slot(zero)
    sll a1, a1, 3
    andi v1, gp, 7
    addu a1, a1, v1
    sll a1, a1, 5
    or a0, a0, a1
    sw a0, 8(v0)
    andi v1, t3, 128
    beq v1, zero, nbqr_nv
    ori t9, t9, 0x0400                       ; (delay slot)
    xori t9, t9, 0x0400
    ori t9, t9, 0xFC00
nbqr_nv:
    sw t9, 12(v0)
    lw ra, global_nb_rapair(zero)
    jr ra
    nop

    ; ==== nbq_blk: v0 = 1 when a blocker (984 / 988) is selected on line a0. CLOBBERS t8, t9, at, k0, k1, v0 ====
nbq_blk:
    lw t8, global_rspq_scratch+984(zero)
    lw t9, global_rspq_scratch+988(zero)
    or t8, t8, t9
    beq t8, zero, nbqk_ret
    addu v0, zero, zero                      ; (delay slot)
    addu k0, zero, zero
nbqk_l:
    srl at, k0, 5
    sll at, at, 2
    lw k1, global_rspq_scratch+984(at)
    andi at, k0, 31
    srlv k1, k1, at
    andi k1, k1, 1
    beq k1, zero, nbqk_n
    sll at, k0, 2                            ; (delay slot)
    lbu at, global_rspq_scratch+96(at)       ; y_k
    subu at, a0, at
    addiu at, at, -1                         ; its row on the line
    sltiu k1, at, 16
    beq k1, zero, nbqk_n
    sll k1, k0, 1                            ; (delay slot)
    lhu k1, global_nb_srows(k1)
    srlv k1, k1, at
    andi k1, k1, 1
    bne k1, zero, nbqk_yes
    nop
nbqk_n:
    addiu k0, k0, 1
    slti at, k0, 64
    bne at, zero, nbqk_l
    nop
nbqk_ret:
    jr ra
    nop
nbqk_yes:
    jr ra
    addiu v0, zero, 1                        ; (delay slot)

    ; ==== nbq_am: v1 = the pixels of [xs, xe) (bit c: x0 + c; t1 xs, t2 xe) no blocker selected on line a0 covers
    ; with an opaque pixel (also at 992). Each such blocker's pair row by DMA (8 bytes to 1000). CLOBBERS a1, t3, t8,
    ; t9, at, k0, k1, v0, v1 ====
nbq_am:
    sw ra, global_rspq_scratch+960(zero)
    addu a1, a0, zero                        ; L
    lw t9, global_nb_sx0(zero)
    subu t8, t2, t9
    addiu v1, zero, 1
    sllv v1, v1, t8
    addiu v1, v1, -1                         ; columns below xe - x0 ...
    subu t8, t1, t9
    addiu at, zero, 1
    sllv at, at, t8
    addiu at, at, -1
    nor at, at, zero
    and v1, v1, at                           ; ... and from xs - x0 (xe - x0 <= 8: 8 bits)
    sw v1, global_rspq_scratch+992(zero)
    addu t3, zero, zero                      ; k
nbqa_l:
    srl at, t3, 5
    sll at, at, 2
    lw t8, global_rspq_scratch+984(at)
    andi t9, t3, 31
    srlv t8, t8, t9
    andi t8, t8, 1
    beq t8, zero, nbqa_n
    sll at, t3, 2                            ; (delay slot)
    lbu t8, global_rspq_scratch+96(at)
    subu t8, a1, t8
    addiu t8, t8, -1                         ; rk
    sltiu t9, t8, 16
    beq t9, zero, nbqa_n
    sll t9, t3, 1                            ; (delay slot)
    lhu t9, global_nb_srows(t9)
    srlv t9, t9, t8
    andi t9, t9, 1
    beq t9, zero, nbqa_n
    nop
    lbu v0, global_rspq_scratch+98(at)       ; its attributes
    sw v0, global_rspq_scratch+996(zero)
    andi t9, v0, 128
    beq t9, zero, nbqa_nf
    nop
    subu t8, a7, t8
    addiu t8, t8, -1                         ; flipped: h - 1 - rk
nbqa_nf:
    lbu t9, global_rspq_scratch+97(at)       ; its tile
    addiu v0, zero, 8
    bne a7, v0, nbqa_16
    nop
    andi v0, s2, 8                           ; 8 x 8: a = (PPUCTRL & 8) << 9 | tile << 4
    sll v0, v0, 9
    sll k0, t9, 4
    j nbqa_ta
    or k0, k0, v0                            ; (delay slot)
nbqa_16:
    andi v0, t9, 1                           ; 8 x 16: ta = (tile & 254) + (rk >> 3)
    sll v0, v0, 12
    andi t9, t9, 254
    srl k0, t8, 3
    addu t9, t9, k0
    sll k0, t9, 4
    or k0, k0, v0
nbqa_ta:
    sw t9, global_rspq_scratch+964(zero)     ; ta
    srl v0, k0, 10
    andi v0, v0, 7
    lbu v0, global_rspq_scratch+48(v0)       ; its bank number
    sll v0, v0, 10
    andi k0, k0, 0x3E0
    or k0, k0, v0                            ; the key
    sll k1, k0, 1
    lw v0, global_nb_pair(zero)
    addu k1, k1, v0
    andi t8, t8, 7
    sll t8, t8, 3
    addu k1, k1, t8                          ; the pair's row
    addiu k0, zero, global_rspq_scratch+1000
    jal nbdi
    addiu v0, zero, 7                        ; (delay slot)
    lw t8, global_rspq_scratch+964(zero)
    andi t8, t8, 1
    sll t8, t8, 2
    lw t8, global_rspq_scratch+1000(t8)      ; the tile's 8 texels, the first in the top nibble
    addu t9, zero, zero                      ; om
    addu v0, zero, zero                      ; c
nbqo_c:
    lw at, global_rspq_scratch+996(zero)
    andi at, at, 64
    beq at, zero, nbqo_u
    addu k0, v0, zero                        ; (delay slot) texel c ...
    addiu k0, zero, 7
    subu k0, k0, v0                          ; ... or 7 - c, mirrored
nbqo_u:
    sll k0, k0, 2
    addiu k1, zero, 28
    subu k0, k1, k0
    srlv k1, t8, k0
    andi k1, k1, 15
    beq k1, zero, nbqo_n
    sll at, t3, 2                            ; (delay slot)
    lbu at, global_rspq_scratch+99(at)
    addu at, at, v0                          ; its x
    sltiu k1, at, 256
    beq k1, zero, nbqo_n
    sltiu k1, at, 8                          ; (delay slot)
    beq k1, zero, nbqo_set
    andi k1, s3, 4                           ; (delay slot)
    beq k1, zero, nbqo_n                     ; left of x 8, hidden
    nop
nbqo_set:
    addiu k1, zero, 1
    sllv k1, k1, v0
    or t9, t9, k1
nbqo_n:
    addiu v0, v0, 1
    slti at, v0, 8
    bne at, zero, nbqo_c
    nop
    sll at, t3, 2                            ; into i's columns: dx = x_k - x_i
    lbu at, global_rspq_scratch+99(at)
    lw k0, global_nb_sx0(zero)
    subu at, at, k0
    bltz at, nbqo_neg
    nop
    j nbqo_sh
    sllv t9, t9, at                          ; (delay slot)
nbqo_neg:
    subu at, zero, at
    srlv t9, t9, at
nbqo_sh:
    nor t9, t9, zero                         ; (bits past 7 meet none of the 8 bits left)
    lw k0, global_rspq_scratch+992(zero)
    and k0, k0, t9
    sw k0, global_rspq_scratch+992(zero)
nbqa_n:
    addiu t3, t3, 1
    srl at, a2, 2
    slt at, t3, at
    bne at, zero, nbqa_l
    nop
    lw v1, global_rspq_scratch+992(zero)
    lw ra, global_rspq_scratch+960(zero)
    jr ra
    nop

    ; ==== nbq_room: nbroom (segment 2) here too ====
nbq_room:
    lw v0, global_nb_rects(zero)
    sltiu v1, v0, 64
    bne v1, zero, nbq_room1
    nop
    sw ra, global_nb_raroom(zero)
    sw a1, global_nb_rtile(zero)
    jal nbflush
    nop
    lw a1, global_nb_rtile(zero)
    lw ra, global_nb_raroom(zero)
    addu v0, zero, zero
nbq_room1:
    addiu v1, v0, 1
    sw v1, global_nb_rects(zero)
    addiu t8, zero, 1
    sllv t8, t8, a1
    lw t9, global_nb_qtiles(zero)
    or t9, t9, t8
    sw t9, global_nb_qtiles(zero)
    sll v0, v0, 4
    jr ra
    addiu v0, v0, global_rspq_scratch+1024   ; (delay slot)
nbq_return:
  EndASM
EndProcedure

; NesRspCommon (resident) - the subroutines both segments call. Never run as a procedure: NesRspSetup calls it once
; so that the compiler keeps it, and its first instruction jumps over the subroutines.
Procedure NesRspCommon()
  ASM
    j nbc_return
    nop
    ; ==== nb_enter / nb_leave: the caller's s0-s7 to nb_sv and the band's from nb_bs; the other way ====
nb_enter:
    sw s0, global_nb_sv+0(zero)
    sw s1, global_nb_sv+4(zero)
    sw s2, global_nb_sv+8(zero)
    sw s3, global_nb_sv+12(zero)
    sw s4, global_nb_sv+16(zero)
    sw s5, global_nb_sv+20(zero)
    sw s6, global_nb_sv+24(zero)
    sw s7, global_nb_sv+28(zero)
    lw s0, global_nb_bs+0(zero)
    lw s1, global_nb_bs+4(zero)
    lw s2, global_nb_bs+8(zero)
    lw s3, global_nb_bs+12(zero)
    lw s4, global_nb_bs+16(zero)
    lw s5, global_nb_bs+20(zero)
    lw s6, global_nb_bs+24(zero)
    lw s7, global_nb_bs+28(zero)
    jr ra
    nop
nb_leave:
    sw s0, global_nb_bs+0(zero)
    sw s1, global_nb_bs+4(zero)
    sw s2, global_nb_bs+8(zero)
    sw s3, global_nb_bs+12(zero)
    sw s4, global_nb_bs+16(zero)
    sw s5, global_nb_bs+20(zero)
    sw s6, global_nb_bs+24(zero)
    sw s7, global_nb_bs+28(zero)
    lw s0, global_nb_sv+0(zero)
    lw s1, global_nb_sv+4(zero)
    lw s2, global_nb_sv+8(zero)
    lw s3, global_nb_sv+12(zero)
    lw s4, global_nb_sv+16(zero)
    lw s5, global_nb_sv+20(zero)
    lw s6, global_nb_sv+24(zero)
    lw s7, global_nb_sv+28(zero)
    jr ra
    nop

    ; ==== nbw: one doubleword (a0, a1) to the frame's words (the twin's NesTwinCmdW) ====
nbw:
    sw a0, 0(s6)
    sw a1, 4(s6)
    addiu s6, s6, 8
    bne s6, s7, nbret
    nop
    ; ==== nbsend: the half being filled, [s7 - 128, s6), out by an unwaited DMA once every DMA before it has
    ; landed - only what fits below the area's end, the rest counted (4,096 doublewords) - then the other half ====
nbsend:
    mfc0 at, $4
    andi at, at, 12                          ; DMA busy or full
    bne at, zero, nbsend
    addiu k0, s7, -128                       ; (delay slot) the half's start
    subu v0, s6, k0                          ; its bytes
    lw k1, global_nb_odram(zero)
    lw t8, global_nb_lim(zero)
    subu t8, t8, k1                          ; the room left in the area
    slt t9, t8, v0
    beq t9, zero, nbsd1
    subu t9, v0, t8                          ; (delay slot) the bytes that do not fit
    srl t9, t9, 3
    lw at, global_nb_over(zero)
    addu at, at, t9
    sw at, global_nb_over(zero)
    addu v0, t8, zero                        ; only what fits
nbsd1:
    beq v0, zero, nbsd2
    addu t9, k1, v0                          ; (delay slot)
    sw t9, global_nb_odram(zero)
    mtc0 k0, $0                              ; SP_MEM_ADDR
    mtc0 k1, $1                              ; SP_DRAM_ADDR
    addiu v0, v0, -1
    mtc0 v0, $3                              ; SP_WR_LEN: out it goes, not waited for
nbsd2:
    addiu t9, zero, global_rspq_scratch+2304
    bne s7, t9, nbsd3
    addiu s6, zero, global_rspq_scratch+2176 ; (delay slot) the first went: the second next ...
    addiu s6, zero, global_rspq_scratch+2048 ; ... the second went: the first
nbsd3:
    jr ra
    addiu s7, s6, 128                        ; (delay slot)
nbret:
    jr ra
    nop

    ; ==== the syncs owed: tail calls of nbw ====
nbsp:
    lw t8, global_nb_pipe(zero)
    beq t8, zero, nbret
    nop
    sw zero, global_nb_pipe(zero)
    lui a0, 0x2700
    j nbw
    addu a1, zero, zero                      ; (delay slot) SYNC_PIPE
nbst:
    lw t8, global_nb_tiles(zero)
    and t8, t8, t9
    beq t8, zero, nbret
    nop
    sw zero, global_nb_tiles(zero)
    lui a0, 0x2800
    j nbw
    addu a1, zero, zero                      ; (delay slot) SYNC_TILE
nbsl:
    lw t8, global_nb_tmem(zero)
    beq t8, zero, nbret
    nop
    sw zero, global_nb_tmem(zero)
    lui a0, 0x2600
    j nbw
    addu a1, zero, zero                      ; (delay slot) SYNC_LOAD

    ; ==== nbtab: every bank slot holding key a0's bank (one vector compare of the 8 bank numbers) gets the table
    ; entry of the key's pair = a1. a0 < 0 (no key): nothing ====
nbtab:
    bltz a0, nbret
    srl t8, a0, 10                           ; (delay slot) the bank number
    sll t8, t8, 8                            ; as lpv put the 8 in the lanes: x 256
    mtc2 t8, $v9[0]
    veq $v10, $v16, $v9[0]                   ; VCC lane b: bank slot b holds it
    cfc2 t8, $1
    andi t8, t8, 255
    srl t9, a0, 5
    andi t9, t9, 31                          ; the pair
    addiu t9, t9, global_rspq_scratch+2304   ; bank slot 0's entry
nbtb_l:
    beq t8, zero, nbret
    andi at, t8, 1                           ; (delay slot)
    beq at, zero, nbtb_n
    srl t8, t8, 1                            ; (delay slot)
    sb a1, 0(t9)
nbtb_n:
    j nbtb_l
    addiu t9, t9, 32                         ; (delay slot) the next bank slot's

    ; ==== nbflush: the rectangles waiting for their pairs, written; the tiles they name owed; their slots free
    ; again (NesTwinFlush). A rectangle is one vector load and a store pair (the staging's 8-byte alignment is
    ; whatever the words before left), two nbw when it would cross the half's end ====
nbflush:
    lw t3, global_nb_rects(zero)
    beq t3, zero, nbfl_pins
    sll t3, t3, 4                            ; (delay slot)
    sw ra, global_nb_rafl(zero)
    addiu t3, t3, global_rspq_scratch+1024   ; the queue's end
    addiu v1, zero, global_rspq_scratch+1024
nbfl_r:
    subu t8, s7, s6
    slti t8, t8, 16
    bne t8, zero, nbfl_w                     ; fewer than 16 bytes left in the half
    lqv $v8[0], 0(v1)                        ; (delay slot)
    sqv $v8[0], 0(s6)
    srv $v8[0], 16(s6)
    addiu s6, s6, 16
    bne s6, s7, nbfl_n
    nop
    jal nbsend
    nop
nbfl_n:
    addiu v1, v1, 16
    bne v1, t3, nbfl_r
    nop
    lw t8, global_nb_tiles(zero)
    lw t9, global_nb_qtiles(zero)
    or t8, t8, t9
    sw t8, global_nb_tiles(zero)
    sw zero, global_nb_qtiles(zero)
    addiu a0, zero, 1
    sw a0, global_nb_pipe(zero)
    sw a0, global_nb_tmem(zero)
    sw zero, global_nb_rects(zero)
    lw ra, global_nb_rafl(zero)
nbfl_pins:
    jr ra
    sw zero, global_nb_pinm(zero)            ; (delay slot)
nbfl_w:
    lw a0, 0(v1)
    jal nbw
    lw a1, 4(v1)                             ; (delay slot)
    lw a0, 8(v1)
    jal nbw
    lw a1, 12(v1)                            ; (delay slot)
    j nbfl_n
    nop

    ; ==== nbpair: a0 = the pair index (bank slot x 32 + pair): v0 = the slot holding it (NesTwinPair), pinned;
    ; nbload when absent ====
nbpair:
    lbu v0, global_rspq_scratch+2304(a0)
    beq v0, zero, nbload
    addiu v0, v0, -1                         ; (delay slot)
    lw t8, global_nb_pinm(zero)
    addiu t9, zero, 1
    sllv t9, t9, v0
    or t8, t8, t9
    jr ra
    sw t8, global_nb_pinm(zero)              ; (delay slot)

    ; ==== nbload: a0 = the pair index: its key into the next slot no waiting rectangle names (NesTwinPair's
    ; miss: the rectangles first when every slot is pinned), the table kept, the load's words; v0 = the slot,
    ; pinned ====
nbload:
    sw ra, global_nb_rapair(zero)
    sw a0, global_nb_key(zero)
    lw t8, global_nb_pinm(zero)
    addiu t9, zero, -1
    bne t8, t9, nbld_f
    nop
    jal nbflush
    nop
nbld_f:
    lw t3, global_nb_next(zero)
    lw t8, global_nb_pinm(zero)
nbld_n:
    srlv t9, t8, t3
    andi t9, t9, 1
    beq t9, zero, nbld_free
    addiu t9, t3, 1                          ; (delay slot)
    j nbld_n
    andi t3, t9, 31                          ; (delay slot)
nbld_free:
    andi t9, t9, 31
    sw t9, global_nb_next(zero)              ; t3 = the slot
    sll t8, t3, 2
    lw a0, global_nb_keys(t8)                ; the key it held: out of the table
    jal nbtab
    addu a1, zero, zero                      ; (delay slot)
    lw a0, global_nb_key(zero)
    srl t8, a0, 5
    lbu t8, global_rspq_scratch+48(t8)
    sll t8, t8, 10
    andi a0, a0, 31
    sll a0, a0, 5
    or a0, a0, t8                            ; the key: bank number << 10 | pair << 5
    sll t8, t3, 2
    sw a0, global_nb_keys(t8)
    jal nbtab                                ; into the table
    addiu a1, t3, 1                          ; (delay slot)
    jal nbsp
    nop
    sll t8, t3, 2
    lw a1, global_nb_keys(t8)
    sll a1, a1, 1
    lw t8, global_nb_pair(zero)
    addu a1, a1, t8                          ; the pair: NesChrPairBase + key << 1
    lui a0, 0x3D10
    jal nbw
    ori a0, a0, 3                            ; (delay slot) SET_TEXTURE_IMAGE: 16-bit units
    jal nbst
    addiu t9, zero, 128                      ; (delay slot)
    sll a0, t3, 3
    lui t8, 0x3510
    or a0, a0, t8
    jal nbw
    lui a1, 0x0700                           ; (delay slot) SET_TILE 7 at the slot
    jal nbsl
    nop
    lui a0, 0x3300
    lui a1, 0x0701
    jal nbw
    ori a1, a1, 0xF800                       ; (delay slot) LOAD_BLOCK 32 units, a word a line
    lw t8, global_nb_tiles(zero)
    ori t8, t8, 128
    sw t8, global_nb_tiles(zero)
    addiu t8, zero, 1
    sw t8, global_nb_tmem(zero)
    lw t8, global_nb_pinm(zero)              ; pinned
    addiu t9, zero, 1
    sllv t9, t9, t3
    or t8, t8, t9
    sw t8, global_nb_pinm(zero)
    addu v0, t3, zero
    lw ra, global_nb_rapair(zero)
    jr ra
    nop

    ; ==== nbdesc: tiles 0-3 to the palettes from a0 (0 the background's, 4 the sprites') (NesTwinDescriptors) ====
nbdesc:
    lw t8, global_nb_descs(zero)
    beq t8, a0, nbret
    nop
    sw ra, global_nb_radesc(zero)
    jal nbflush
    sw a0, global_nb_descs(zero)             ; (delay slot)
    addu t3, zero, zero
nbds_t:
    addiu t9, zero, 1
    jal nbst
    sllv t9, t9, t3                          ; (delay slot) 1 << t
    lw v1, global_nb_descs(zero)
    addu v1, v1, t3
    sll v1, v1, 20
    sll a1, t3, 24
    or a1, a1, v1
    lui a0, 0x3540
    jal nbw
    ori a0, a0, 0x0200                       ; (delay slot) SET_TILE t: CI4, a line of 1, TMEM 0, palette base + t
    sll a1, t3, 24
    lui v1, 0x0003
    ori v1, v1, 0xC3FC
    or a1, a1, v1
    jal nbw
    lui a0, 0x3200                           ; (delay slot) SET_TILE_SIZE 16 x 256
    addiu t3, t3, 1
    sltiu v1, t3, 4
    bne v1, zero, nbds_t
    nop
    lw ra, global_nb_radesc(zero)
    jr ra
    nop

    ; ==== nbdi / nbdo: one DMA in / out, k0 DMEM, k1 RDRAM, v0 the length word (bytes - 1; rows and skip for a
    ; strided one); back once every DMA has landed ====
nbdi:
    mfc0 at, $5                              ; SP_DMA_FULL
    bne at, zero, nbdi
    nop
    mtc0 k0, $0
    mtc0 k1, $1
    j nbdw
    mtc0 v0, $2                              ; (delay slot) SP_RD_LEN: RDRAM to DMEM
nbdo:
    mfc0 at, $5
    bne at, zero, nbdo
    nop
    mtc0 k0, $0
    mtc0 k1, $1
    mtc0 v0, $3                              ; SP_WR_LEN: DMEM to RDRAM
nbdw:
    mfc0 at, $4
    andi at, at, 12                          ; DMA busy or full
    bne at, zero, nbdw
    nop
    jr ra
    nop
nbc_return:
  EndASM
EndProcedure


XIncludeFile "rspsyn.n64rsp"           ; N10: the APU synthesis, a module of this program (segments 3, 5, 4)

Procedure RspqCommand(id.l)
  Select id
    Case #NES_RSP_SETUP : NesRspSetup()
    Case #NES_RSP_BAND
      ; THE BAND JOB AS A CHAIN OF STEPS (N.60): each step is a procedure in a code segment, and names the next one in
      ; the job's scratch (+1012 the segment, +1016 the procedure's IMEM address; 0: the job is done). A plain band
      ; is A, B; a band with a behind sprite A, B, Q, E; a split line's record A, B, S, Q, E. Resident, in this one loop.
      ASM
        addiu t0, zero, nesrspbanda          ; NesRspBandA first ...
        sw t0, global_rspq_scratch+1016(zero)
        addiu a0, zero, 1                    ; ... in #NES_RSP_SEG_A
nbr_step:
        jal rspqsegment                      ; the step's segment into IMEM (it uses t0: the procedure read after)
        sw zero, global_rspq_scratch+1012(zero)   ; (delay slot) taken: a step that names none ends the job
        lw t0, global_rspq_scratch+1016(zero)
        jalr ra, t0
        nop
        lw a0, global_rspq_scratch+1012(zero)
        bne a0, zero, nbr_step
        nop
      EndASM
    Case #NES_RSP_SYNJOB                   ; a synthesis job (the priority ring): its events, its DMC levels, its samples
      If RspqSegment(#NES_RSP_SEG_SYNA) : NesRspSynEvents() : EndIf
      If RspqSegment(#NES_RSP_SEG_SYNC) : NesRspSynDmc() : EndIf
      If RspqSegment(#NES_RSP_SEG_SYNB) : NesRspSynSamples() : EndIf
  EndSelect
EndProcedure

LpmRspqKernel()
