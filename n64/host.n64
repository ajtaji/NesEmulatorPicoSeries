; N64 host for the NES core. Include after the guest state and lpm.n64.
#HOST_WIDTH = 320
#HOST_HEIGHT = 240
#HOST_NES_WIDTH = 256
#HOST_ROW_BYTES = #HOST_WIDTH * 2
#HOST_AUDIO_BYTES = #HOST_AUDIO_FRAMES * 4
#HOST_AUDIO_SLOTS = 3
CompilerIf #NES_AUDIO_RATE=20000
  #HOST_AUDIO_RESERVE=768
CompilerElse
  #HOST_AUDIO_RESERVE=3*#HOST_AUDIO_FRAMES
CompilerEndIf

Global HostPadPending.i, HostAudioReady.i
Global HostPendingVideo.i, HostCoalesced.i, HostPcmRead.i, HostAiSlot.i, HostAiBase.i
; Leave room to align each stereo block inside a 4 KiB page. No AI transfer
; ends on the 8 KiB boundary affected by the AI address carry erratum.
CompilerIf #NES_RSP_SYN
  ; N10 (design note N.52 4): the AI's blocks are the RSP synthesis's output ring - 8 blocks of 512 stereo words (the
  ; twin's 4,096-sample Pcm ring), block b at HostAiBase + b x 2,112. HostBegin places the base so that no block, and no
  ; half block (the oracle's last transfer), ends on an 8 KiB boundary. THE RING IS NOT A VARIABLE (design note N.53):
  ; with it below the stack the CPU trace builds ran into the stack by 7,392 bytes. It sits in the RDRAM between the
  ; library's framebuffers (from $80200000, three of 153,600 bytes: to $80270800) and the cartridge arena
  ; (#NES_CART_LOW in storage.n64, $80281000, written here as a number: that file comes later) - room the library's map leaves free; HostBegin checks both ends and refuses otherwise.
  #HOST_AI_RING = $FFFFFFFF80272000
  #HOST_AI_RING_BYTES = 8 * 2112 + 32
  Global Dim HostAiMemory.a(8)
CompilerElse
  Global Dim HostAiMemory.a((#HOST_AUDIO_SLOTS + 1) * 4096)
CompilerEndIf
CompilerIf #VERIFY_FRAME>0
  Global HostAiQueued.i, HostAiEmpty.i, HostAiUnderruns.i, HostAiReported.i, HostAiReadyOnEmpty.i, HostLastEmptyFrame.i
CompilerEndIf

CompilerIf #NES_MEASURE_QUEUE
  Global HostTelemetryEnabled.i
  Global HostAiStarvations.i, HostAiLastStarvation.i, HostAudioDropped.i
CompilerEndIf

XIncludeFile "stereo.n64"

CompilerIf #VERIFY_FRAME=0
  XIncludeFile "host_audio_queue.n64"
CompilerElse
Procedure HostQueueAudio(produced.i)
  Protected dst.i
  If HostAiBase = 0 : ProcedureReturn : EndIf
  ; Start after the original sample-pair reserve has accumulated.
  ; Keep the timing threshold independent of the DMA descriptor size.
  If HostAudioReady=0
    If produced-HostPcmRead < #HOST_AUDIO_RESERVE : ProcedureReturn : EndIf
    HostAudioReady=1
  EndIf
  CompilerIf #VERIFY_FRAME>0
    If HostAiQueued>=2
      If PeekL(#LPM_AI+$0C)&$40000000
        HostAiEmpty=0
      ElseIf HostAiEmpty=0
        HostAiUnderruns+=1 : HostAiEmpty=1 : HostLastEmptyFrame=WorkerFrames
        If produced-HostPcmRead>=#HOST_AUDIO_FRAMES : HostAiReadyOnEmpty+=1 : EndIf
      EndIf
    EndIf
  CompilerEndIf
  If produced < HostPcmRead : HostPcmRead = 0 : EndIf
  If produced - HostPcmRead > 4096 : HostPcmRead = (produced - 4096 + #HOST_AUDIO_FRAMES - 1) & ~(#HOST_AUDIO_FRAMES - 1) : EndIf
  While produced - HostPcmRead >= #HOST_AUDIO_FRAMES And LpmAiFull() = 0
    CompilerIf #NES_RSP_SYN
      ; the RSP's words are the block (rspsyn.n64): queued once it has rendered them, nothing copied
      If NesSynDone - HostPcmRead < #HOST_AUDIO_FRAMES : Break : EndIf
      dst = HostAiBase + ((HostPcmRead >> 9) & 7) * 2112
      CompilerIf #NES_SYN_CHECK
        NesSynCheckBlock(dst, HostPcmRead, #HOST_AUDIO_FRAMES)   ; every sample against the twin's
      CompilerEndIf
    CompilerElse
    dst = HostAiBase + HostAiSlot * 4096
    CompilerIf #NES_APU_SPLIT
      NesSynRenderTo(HostPcmRead + #HOST_AUDIO_FRAMES)   ; the block's samples (apusynth.n64, design note N.25)
    CompilerEndIf
    HostCopyStereo(dst, @Pcm[HostPcmRead & 4095])
    LpmCacheWritebackData(dst, #HOST_AUDIO_BYTES)
    CompilerEndIf
    LpmAiQueue(dst, #HOST_AUDIO_BYTES)
    HostPcmRead += #HOST_AUDIO_FRAMES
    HostAiSlot += 1
    If HostAiSlot = #HOST_AUDIO_SLOTS : HostAiSlot = 0 : EndIf
    CompilerIf #VERIFY_FRAME>0
      HostAiQueued+=1 : HostAiEmpty=0
    CompilerEndIf
  Wend
EndProcedure
CompilerEndIf

; ======================================================================================================================
; THE HOST'S PER-FRAME GLUE IN ASSEMBLY (design note N.69, 2026-11-27): HostAudioPoll, DisplayWaitLine, DisplayFrame,
; HostPad, HostHarvestPads, HostRequestPads and (with the replayed input off) HostInputPoll are hand-written VR4300
; assembly in the runtime-MMC3 builds (#NES_APU_SPLIT / #NES_RDP_SHOW, the cart that ships and its checking builds);
; each one's PLAIN TWIN, the compiled procedure it replaces, is kept in its header. Compiled on purpose, and why:
; HostAiReport (the oracle build's two printed lines: string formatting through the library), the oracle build's
; HostQueueAudio / HostDrainCapture (the checking build's AI queue and drain with their counters; the cart that ships
; uses host_audio_queue.n64's assembly), HostPresent and the RDP_SHOW = 0 forms (the --old-show reference build and the
; other mappers' builds: no check here executes them), HostInputPoll with the replayed input (the test fixture) and
; HostBegin (once, at power-on).
; THE CONVENTION (Help/VR4300.txt): arguments a0-a7, the result in a0, s0-s7 / fp / sp / gp kept; t-, a- and
; v-registers may change. The callers (the hot unit's u_ppubeginline and line 239, nes.n64's NesHostGuestFrame,
; unit/write.n64's $4016 strobe) call these unchanged.
; WHY ASSEMBLY, AND WHAT IT SAVES (the record cart's SMB3 replay before this change, cycles a guest frame): compiled,
; HostAudioPoll 920, DisplayWaitLine 1,309, HostPad 920 + its six library calls 879, HostHarvestPads 604, HostRequestPads
; 81, HostInputPoll 43 (an empty procedure's frame): every global's address rebuilt from gp, a frame per call.
; FEWER SYNTHESIS POLLS (the measured part, N.69): the RSP synthesis's job poll (NesSynJobPoll, an uncached status read
; each time, 2,668 cycles a frame) ran at every DisplayWaitLine - every 16 lines, 17 a frame - and at the two others.
; What it must do, and how often (20 kHz: 1.27 samples a line): (1) start a job once #NES_SYN_BATCH (256) samples wait -
; 201 lines' worth; polling every 64 lines starts it at most 81 samples (64 lines) later; (2) see a job's end before the
; AI needs its block - the AI is fed from HostPcmRead with #HOST_AUDIO_RESERVE (768) samples behind ApuProduced before
; the first block and two blocks held (1,024 samples, 806 lines) after it, so a 64-line delay in seeing an end and
; another in starting the job leave over 600 lines of the slack; (3) hurry the priority ring when a block waits - the
; same bound. So the job is polled at lines 64, 128 and 192 here, at line 239 (DisplayFrame) and at the frame's wrap
; (NesHostGuestFrame, via HostAudioPoll): five a frame, the longest gap 65 lines. NesApuCount and HostQueueAudio still
; run every 16 lines (ApuProduced stays as current for the show's sound reserve and the AI is fed as before).
; ======================================================================================================================

; (DisplayWaitLine and DisplayFrame come FIRST in this file's assembly on purpose - design note N.69, THE PLACEMENT: the
; compiler lays these naked procedures out in source order, and this order puts DisplayWaitLine, run 17 times a frame,
; on I-cache sets where the hot unit's lines are cold instead of on the per-line draw path ppu_draw_*.)
CompilerIf #NES_RDP_SHOW
; ---- DisplayWaitLine(line): every 16 lines (the hot unit's u_ppubeginline). At line 224 the pads' read started (before
; the guest's usual vblank strobe; not with the replayed input); the samples counted and the AI fed (as HostAudioPoll),
; the synthesis's job polled only at lines 64, 128 and 192 (the header above: five polls a frame with line 239 and the
; frame's wrap); then a check point of the show's hand-over (show.n64): NesShowPoll(1 + #NES_SHOW_CHECK) at line 0 -
; the frame before handed with a buffer waited for (unless the sound reserve runs low; the checking build never leaves a
; frame unshown for the sound) - else NesShowPoll(0). IN: a0 = line. OUT: nothing. KEEPS s0 (saved: the line).
; THE PLAIN TWIN (the compiled procedure; its HostAudioPoll() polled the job at every call):
;   CompilerIf #VERIFY_INPUT=0
;     If line=224 : HostRequestPads() : EndIf
;   CompilerEndIf
;   HostAudioPoll()
;   If line=0 : NesShowPoll(1+#NES_SHOW_CHECK) : Else : NesShowPoll(0) : EndIf
ProcedureNaked DisplayWaitLine(line.i)
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    sd s0, 8(sp)
    move s0, a0                     ; s0 = line
  EndASM
  CompilerIf #VERIFY_INPUT=0
    ASM
    addiu t0, zero, 224
    bne s0, t0, display_wait_audio
    nop
    jal hostrequestpads             ; line 224: the pads' read started
    nop
display_wait_audio:
    EndASM
  CompilerEndIf
  ASM
    jal nesapucount                 ; ApuProduced brought to the APU's time
    nop
  EndASM
  CompilerIf #NES_RSP_SYN
    ASM
    andi t0, s0, 63
    bnez t0, display_wait_queue     ; not a multiple of 64: no job poll
    sltiu t1, s0, 240               ; (delay slot) 1 below line 240
    beqz s0, display_wait_queue     ; line 0: the frame's wrap has just polled
    nop
    beqz t1, display_wait_queue     ; line 256: line 239 has just polled
    nop
    jal nessynjobpoll               ; lines 64, 128, 192: the RSP's job
    nop
display_wait_queue:
    EndASM
  CompilerEndIf
  ASM
    la t0, global_apuproduced
    jal hostqueueaudio              ; HostQueueAudio(ApuProduced)
    ld a0, 0(t0)
  EndASM
  CompilerIf #VERIFY_FRAME>0
    ASM
    jal hostaireport                ; the oracle build's counters (compiled)
    nop
    EndASM
  CompilerEndIf
  ASM
    sltiu a0, s0, 1                 ; 1 at line 0, else 0
  EndASM
  CompilerIf #NES_SHOW_CHECK
    ASM
    sll a0, a0, 1                   ; the checking build: 2 at line 0 (1 + #NES_SHOW_CHECK)
    EndASM
  CompilerEndIf
  ASM
    jal nesshowpoll                 ; the show's check point
    nop
    ld ra, 0(sp)
    ld s0, 8(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure

; ---- DisplayFrame: line 239 (the hot unit). The samples counted, the job polled, the AI fed (HostAudioPoll); the
; frame's picture is handed at line 240 by the show itself (NesShowFrameEnd). Then the pads: with the replayed input a
; read started when none is outstanding; else, when line 224 did not start one, HostRequestPads now; the mark cleared.
; IN / OUT: nothing. A frame of 16 bytes (ra).
; THE PLAIN TWIN (#NES_RDP_SHOW):
;   HostAudioPoll()
;   CompilerIf #VERIFY_INPUT
;     If HostPadPending=0 : HostPadPending=LpmPadReadAsync() : EndIf
;   CompilerElse
;     If HostPadRequested=0 : HostRequestPads() : EndIf
;     HostPadRequested=0
;   CompilerEndIf
ProcedureNaked DisplayFrame()
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    jal hostaudiopoll
    nop
  EndASM
  CompilerIf #VERIFY_INPUT
    ASM
    la t0, global_hostpadpending
    ld t1, 0(t0)
    bnez t1, display_frame_ret      ; a read outstanding
    nop
    jal lpmpadreadasync
    nop
    la t0, global_hostpadpending
    sd a0, 0(t0)                    ; HostPadPending = the ticket
    EndASM
  CompilerElse
    ASM
    la t0, global_hostpadrequested
    ld t1, 0(t0)
    bnez t1, display_frame_clear    ; line 224 started it
    nop
    jal hostrequestpads
    nop
display_frame_clear:
    la t0, global_hostpadrequested
    sd zero, 0(t0)
    EndASM
  CompilerEndIf
  ASM
display_frame_ret:
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure
CompilerEndIf

CompilerIf #VERIFY_FRAME>0
; ---- HostAiReport: the oracle build's AI counters printed every 60 frames and at the verify frame (compiled: string
; formatting through the library; the checking build only). Was the tail of the compiled HostAudioPoll.
Procedure HostAiReport()
  If WorkerFrames>HostAiReported And (WorkerFrames%60=0 Or WorkerFrames=#VERIFY_FRAME)
    HostAiReported=WorkerFrames
    LpmDebugPrint("NES AI QUEUED "+Str(HostAiQueued)+" UNDERRUNS "+Str(HostAiUnderruns)+" FRAME "+Str(WorkerFrames))
    LpmDebugPrint("NES AI READY ON EMPTY "+Str(HostAiReadyOnEmpty)+" LAST "+Str(HostLastEmptyFrame)+" COALESCED "+Str(HostCoalesced)+" FRAME "+Str(WorkerFrames))
  EndIf
EndProcedure
CompilerEndIf

CompilerIf #NES_APU_SPLIT
; ---- HostAudioPoll: the samples the guest's time has produced counted (NesApuCount), the RSP synthesis's job polled
; (NesSynJobPoll), the AI fed (HostQueueAudio(ApuProduced)); in the oracle build the counters' report (HostAiReport).
; From the frame's wrap (NesHostGuestFrame) and line 239 (DisplayFrame); DisplayWaitLine runs the same steps itself,
; with the job poll only every 64 lines. IN: nothing. OUT: nothing. A frame of 16 bytes (ra); changes what a
; compiled call may.
; THE PLAIN TWIN:
;   NesApuCount()                       ; the samples the guest's time has produced (apusplit.n64)
;   CompilerIf #NES_RSP_SYN
;     NesSynJobPoll()                   ; the RSP renders them at the guest's pace (rspsyn.n64)
;   CompilerEndIf
;   HostQueueAudio(ApuProduced)
;   CompilerIf #VERIFY_FRAME>0
;     If WorkerFrames>HostAiReported And (WorkerFrames%60=0 Or WorkerFrames=#VERIFY_FRAME)
;       HostAiReported=WorkerFrames
;       LpmDebugPrint("NES AI QUEUED ...") : LpmDebugPrint("NES AI READY ON EMPTY ...")
;     EndIf
;   CompilerEndIf
ProcedureNaked HostAudioPoll()
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    jal nesapucount                 ; ApuProduced brought to the APU's time
    nop
  EndASM
  CompilerIf #NES_RSP_SYN
    ASM
    jal nessynjobpoll               ; the RSP's job: its end seen, the next one sent
    nop
    EndASM
  CompilerEndIf
  ASM
    la t0, global_apuproduced
    jal hostqueueaudio              ; HostQueueAudio(ApuProduced): a rendered block to the AI
    ld a0, 0(t0)
  EndASM
  CompilerIf #VERIFY_FRAME>0
    ASM
    jal hostaireport                ; the oracle build's counters (compiled)
    nop
    EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure
CompilerElse
Procedure HostAudioPoll()
  CompilerIf #NES_APU_BLOCKED
    NesRenderBlock()
  CompilerEndIf
  HostQueueAudio(ApuProduced)
  CompilerIf #VERIFY_FRAME>0
    HostAiReport()
  CompilerEndIf
EndProcedure
CompilerEndIf

CompilerIf #VERIFY_FRAME>0
Procedure HostDrainCapture()
  CompilerIf #NES_AUDIO_RATE=20000
    Protected dst.i
  CompilerEndIf
  ; The guest has stopped. Submit complete blocks still in the software ring.
  HostAudioReady=1
  CompilerIf #NES_RSP_SYN
    NesSynFinish()                      ; every counted sample rendered by the RSP first (rspsyn.n64)
  CompilerEndIf
  While ApuProduced-HostPcmRead>=#HOST_AUDIO_FRAMES
    HostQueueAudio(ApuProduced)
  Wend
  CompilerIf #NES_AUDIO_RATE=20000
    ; The previous 20 kHz capture included every complete 256-pair block.
    ; A remaining half descriptor starts at a 512-pair-aligned ring address.
    If ApuProduced-HostPcmRead>=256
      While LpmAiFull() : Wend
      CompilerIf #NES_RSP_SYN
        dst=HostAiBase+((HostPcmRead>>9)&7)*2112+(HostPcmRead&511)*4   ; the RSP's words (rendered: NesSynFinish)
        CompilerIf #NES_SYN_CHECK
          NesSynCheckBlock(dst,HostPcmRead,256)
        CompilerEndIf
      CompilerElse
      dst=HostAiBase+HostAiSlot*4096
      CompilerIf #NES_APU_SPLIT
        NesSynRenderTo(HostPcmRead+256)
      CompilerEndIf
      HostCopyStereo(dst,@Pcm[HostPcmRead&4095])
      LpmCacheWritebackData(dst,1024)
      CompilerEndIf
      LpmAiQueue(dst,1024)
      HostPcmRead+=256
      HostAiSlot+=1
      If HostAiSlot=#HOST_AUDIO_SLOTS : HostAiSlot=0 : EndIf
      HostAiQueued+=1 : HostAiEmpty=0
    EndIf
  CompilerEndIf
  CompilerIf #NES_RSP_SYN
    LpmDebugPrint("NES SYN RSP jobs " + Str(NesSynJobs) + " rooms " + Str(NesSynRooms) + " samples " + Str(NesSynDone) + " clocks " + Str(NesSynClocks))
    CompilerIf #NES_SYN_CHECK
      LpmDebugPrint("NES SYN CHECK blocks " + Str(NesSynBlocks) + " samples " + Str(NesSynChecked) + " differing " + Str(Bool(WorkerError = 26)))
    CompilerEndIf
  CompilerEndIf
EndProcedure
CompilerEndIf

; ---- HostPad(port): the N64 pad's state as the NES pad's 8 bits (A 1, B 2, Z = select 4, START 8, up 16, down 32,
; left 64, right 128; the stick past 40 counts as the cross). The pad's state is read where the library keeps it, its
; hot block (#LPM_HOT_PAD_NOW / _X / _Y + port x 8: lpm_exceptions.n64 names these constants as the state itself,
; written by LpmPadTake) - what LpmPadButtons / LpmPadStickX / LpmPadStickY return; a port outside 0-3 answers 0 as
; they do. HOW: the N64's buttons A B Z START at bits 15-12 and the cross UP DOWN LEFT RIGHT at bits 11-8 map to the
; NES bits 0-3 and 4-7 in REVERSED order, so each is one shift right by an odd count and one mask (bit 15 >> 15 = bit
; 0, bit 14 >> 13 = bit 1, ... bit 8 >> 1 = bit 7); the stick's four tests are signed compares (slti) of the 64-bit
; values. IN: a0 = port. OUT: a0 = the keys. A leaf: changes t0-t3, t9.
; THE PLAIN TWIN:
;   Protected buttons.i = LpmPadButtons(port), keys.i
;   Protected x.i = LpmPadStickX(port), y.i = LpmPadStickY(port)
;   If buttons & #LPM_PAD_A : keys | 1 : EndIf
;   If buttons & #LPM_PAD_B : keys | 2 : EndIf
;   If buttons & #LPM_PAD_Z : keys | 4 : EndIf
;   If buttons & #LPM_PAD_START : keys | 8 : EndIf
;   If buttons & #LPM_PAD_UP Or y > 40 : keys | 16 : EndIf
;   If buttons & #LPM_PAD_DOWN Or y < -40 : keys | 32 : EndIf
;   If buttons & #LPM_PAD_LEFT Or x < -40 : keys | 64 : EndIf
;   If buttons & #LPM_PAD_RIGHT Or x > 40 : keys | 128 : EndIf
;   ProcedureReturn keys
CompilerIf #LPM_PAD_A <> $8000 Or #LPM_PAD_B <> $4000 Or #LPM_PAD_Z <> $2000 Or #LPM_PAD_START <> $1000 Or #LPM_PAD_UP <> $0800 Or #LPM_PAD_DOWN <> $0400 Or #LPM_PAD_LEFT <> $0200 Or #LPM_PAD_RIGHT <> $0100
  CompilerError "HostPad's shifts assume the library's button bits 15-8 (A B Z START UP DOWN LEFT RIGHT)"
CompilerEndIf
#HOST_PAD_NOW = #LPM_HOT_PAD_NOW - #LPM_HOT     ; the pads' buttons, from the hot block's base
#HOST_PAD_X = #LPM_HOT_PAD_X - #LPM_HOT         ; their sticks' x
#HOST_PAD_Y = #LPM_HOT_PAD_Y - #LPM_HOT         ; and y
ProcedureNaked.i HostPad(port.i)
  ASM
    sltiu t0, a0, 4
    beqz t0, host_pad_ret           ; not a port: 0 (as the library's readers)
    dsll t0, a0, 3                  ; (delay slot) port x 8
    la t9, #LPM_HOT
    daddu t9, t9, t0                ; the port's words in the hot block
    ld t1, #HOST_PAD_NOW(t9)        ; t1 = the buttons
    ld t2, #HOST_PAD_X(t9)          ; t2 = x
    ld t3, #HOST_PAD_Y(t9)          ; t3 = y
    dsrl a0, t1, 15
    andi a0, a0, 1                  ; A (bit 15) -> 1
    dsrl t0, t1, 13
    andi t0, t0, 2                  ; B (14) -> 2
    or a0, a0, t0
    dsrl t0, t1, 11
    andi t0, t0, 4                  ; Z (13) -> 4
    or a0, a0, t0
    dsrl t0, t1, 9
    andi t0, t0, 8                  ; START (12) -> 8
    or a0, a0, t0
    dsrl t0, t1, 7
    andi t0, t0, 16                 ; UP (11) -> 16
    or a0, a0, t0
    dsrl t0, t1, 5
    andi t0, t0, 32                 ; DOWN (10) -> 32
    or a0, a0, t0
    dsrl t0, t1, 3
    andi t0, t0, 64                 ; LEFT (9) -> 64
    or a0, a0, t0
    dsrl t0, t1, 1
    andi t0, t0, 128                ; RIGHT (8) -> 128
    or a0, a0, t0
    slti t0, t3, 41
    xori t0, t0, 1                  ; y > 40 ...
    sll t0, t0, 4
    or a0, a0, t0                   ; ... up
    slti t0, t3, -40                ; y < -40 ...
    sll t0, t0, 5
    or a0, a0, t0                   ; ... down
    slti t0, t2, -40                ; x < -40 ...
    sll t0, t0, 6
    or a0, a0, t0                   ; ... left
    slti t0, t2, 41
    xori t0, t0, 1                  ; x > 40 ...
    sll t0, t0, 7
    jr ra
    or a0, a0, t0                   ; (delay slot) ... right
host_pad_ret:
    jr ra
    move a0, zero
  EndASM
EndProcedure

CompilerIf #VERIFY_INPUT
  XIncludeFile "replay.pmi"
CompilerElse
  Global HostPadRequested.i

  ; ---- HostHarvestPads: when a pad read is outstanding and has arrived (LpmPadReadDone, which also takes it in), both
  ; NES pads from it. From HostRequestPads and the guest's $4016 strobe (unit/write.n64). IN / OUT: nothing. A frame
  ; of 16 bytes (ra); changes what a compiled call may.
  ; THE PLAIN TWIN:
  ;   If HostPadPending=0 : ProcedureReturn : EndIf
  ;   If LpmPadReadDone()=0 : ProcedureReturn : EndIf
  ;   HostPadPending=0
  ;   NesController=HostPad(0)
  ;   NesController2=HostPad(1)
  ProcedureNaked HostHarvestPads()
    ASM
    la t0, global_hostpadpending
    ld t0, 0(t0)
    beqz t0, host_harvest_ret       ; no read outstanding
    daddiu sp, sp, -16              ; (delay slot)
    sd ra, 0(sp)
    jal lpmpadreaddone              ; arrived? (taken in when it has)
    nop
    beqz a0, host_harvest_done      ; not yet
    nop
    la t0, global_hostpadpending
    sd zero, 0(t0)                  ; the read taken
    jal hostpad
    move a0, zero
    la t0, global_nescontroller
    sd a0, 0(t0)                    ; NesController = HostPad(0)
    jal hostpad
    addiu a0, zero, 1
    la t0, global_nescontroller2
    sd a0, 0(t0)                    ; NesController2 = HostPad(1)
host_harvest_done:
    ld ra, 0(sp)
host_harvest_ret:
    jr ra
    daddiu sp, sp, 16
    EndASM
  EndProcedure

  ; ---- HostRequestPads: the pads harvested, then a new read started when none is outstanding; HostPadRequested = 1 when
  ; one is (DisplayFrame starts one itself when line 224 did not). IN / OUT: nothing. A frame of 16 bytes (ra).
  ; THE PLAIN TWIN:
  ;   HostHarvestPads()
  ;   If HostPadPending=0 : HostPadPending=LpmPadReadAsync() : EndIf
  ;   HostPadRequested=Bool(HostPadPending)
  ProcedureNaked HostRequestPads()
    ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    jal hostharvestpads
    nop
    la t0, global_hostpadpending
    ld a0, 0(t0)
    bnez a0, host_request_mark      ; still outstanding: no new read
    nop
    jal lpmpadreadasync             ; the ticket (0: the joybus queue is full)
    nop
    la t0, global_hostpadpending
    sd a0, 0(t0)
host_request_mark:
    sltu a0, zero, a0               ; Bool(HostPadPending)
    la t0, global_hostpadrequested
    sd a0, 0(t0)
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 16
    EndASM
  EndProcedure
CompilerEndIf
CompilerIf #VERIFY_INPUT
Procedure HostInputPoll()
  If HostPadPending
    If LpmPadReadDone()=0 : ProcedureReturn : EndIf
    HostPadPending=0
  Else
    LpmPadRead()
  EndIf
  NesController = NesReplayPad(WorkerFrames)
  NesController2 = HostPad(1)
EndProcedure
CompilerElse
; ---- HostInputPoll without the replayed input: nothing (the pads are read at line 224 and harvested at the strobe).
; THE PLAIN TWIN: an empty procedure (its frame alone cost 43 cycles a frame).
ProcedureNaked HostInputPoll()
  ASM
    jr ra
    nop
  EndASM
EndProcedure
CompilerEndIf

CompilerIf #NES_RDP_SHOW=0
Procedure HostPresent(waitMode.i)
  Protected seen.i, fb.i
  If HostPendingVideo=0 : ProcedureReturn : EndIf
  seen=LpmIrqSeen(#LPM_WAKE_VI|#LPM_WAKE_AI)
  Repeat
    fb=LpmDisplayTryGet()
    If fb
      NesIndexedShow(fb) : HostPendingVideo=0 : ProcedureReturn
    EndIf
    ; Offer the completed picture again during vblank, before the next
    ; line zero reuses it. The VI and NES have different physical rates.
    If waitMode=0 : ProcedureReturn : EndIf
    If waitMode=1 And HostAudioReady And ApuProduced-HostPcmRead<#HOST_AUDIO_RESERVE
      HostPendingVideo=0 : HostCoalesced+=1 : ProcedureReturn
    EndIf
    seen=LpmIrqSleep(#LPM_WAKE_VI|#LPM_WAKE_AI,seen,#LPM_WAIT_TICK,0,0)
    HostQueueAudio(ApuProduced)
  ForEver
EndProcedure
CompilerEndIf

CompilerIf #NES_RDP_SHOW
  Declare NesShowPoll(wait.i)
CompilerEndIf
CompilerIf #NES_SHOW_CHECK And #NES_RDP_SHOW=0
  Declare NesShowHashRef()
CompilerEndIf
CompilerIf #NES_RDP_SHOW=0
Procedure DisplayWaitLine(line.i)
  CompilerIf #VERIFY_INPUT=0
    ; Start the transfer before the guest's usual vblank strobe.
    If line=224 : HostRequestPads() : EndIf
  CompilerEndIf
  HostAudioPoll()
  If line=0
    HostPresent(1)
    ; The previous RDP transfer must release the indexed pixels before reuse.
    While LpmRdpFramesDone()<NesIndexTicket : Wend
  EndIf
EndProcedure

Procedure DisplayFrame()
  HostAudioPoll()
  CompilerIf #VERIFY_FRAME>0
    CompilerIf #NES_SHOW_CHECK
      NesShowHashRef()                  ; the reference: the old renderer's picture of this frame (show.n64)
    CompilerEndIf
    HostPendingVideo=1
    ; A screenshot checkpoint must present its requested guest frame.
    If WorkerFrames+1=#VERIFY_FRAME : HostPresent(2) : Else : HostPresent(0) : EndIf
  CompilerElse
    HostPendingVideo=1
    HostPresent(0)
  CompilerEndIf
  CompilerIf #VERIFY_INPUT
    If HostPadPending=0 : HostPadPending=LpmPadReadAsync() : EndIf
  CompilerElse
    If HostPadRequested=0 : HostRequestPads() : EndIf
    HostPadRequested=0
  CompilerEndIf
EndProcedure
CompilerEndIf

Procedure.i HostBegin()
  LpmInterruptsInit()
  LpmJoybusInit()
  ; Three 153,600-byte buffers fit below the embedded cartridge at $80280000.
  ; Nearest pixel, no anti-alias and no resample: each NES pixel becomes exactly two output
  ; pixels across, with hard edges. Resample blended every pixel with its neighbour and
  ; smeared the picture sideways. At 16-bit the VI's NTSC bug applies only under 320 wide;
  ; at exactly 320 the library writes X_SCALE $201 for $200, which avoids it.
  If LpmDisplayInit(#HOST_WIDTH, #HOST_HEIGHT, 16, 3, #LPM_VI_NEAREST, #LPM_TV_AUTO) = 0
    ProcedureReturn 0
  EndIf
  CompilerIf #GAME_PAL
    LpmDisplayFpsLimit(5000)
  CompilerEndIf
  LpmRdpInit()
  CompilerIf #NES_RSP_CHECK Or #NES_RDP_SHOW
    LpmRspqInit()                       ; the RSP band emitter (rspband.n64rsp; show.n64, rspband.n64)
  CompilerEndIf
  LpmInterruptsOn()
  LpmPadScan()
  CompilerIf #VERIFY_INPUT
    HostInputPoll()
  CompilerElse
    LpmPadRead()
    NesController=HostPad(0)
    NesController2=HostPad(1)
  CompilerEndIf
  CompilerIf #NES_RSP_SYN
    ; the ring's base: 8-byte aligned, moved on 8 while a block's end (+2,048) or a half block's (+1,024) would fall
    ; on an 8 KiB boundary (each b excludes one base in 1,024: the first or the next two bases always do)
    Protected b.i, ok.i
    HostAiBase = #HOST_AI_RING
    If ((lpm_fb_addr[lpm_dsp_n - 1] + lpm_dsp_size) & $1FFFFFFF) > (#HOST_AI_RING & $1FFFFFFF) Or #HOST_AI_RING + #HOST_AI_RING_BYTES > $FFFFFFFF80281000
      LpmDebugPrint("NES AI RING REFUSED: the framebuffers or the cartridge arena overlap it") : ProcedureReturn 0
    EndIf
    Repeat
      ok = 1
      For b = 0 To 7
        If ((HostAiBase + b * 2112 + 2048) & 8191) = 0 Or ((HostAiBase + b * 2112 + 1024) & 8191) = 0 : ok = 0 : EndIf
      Next
      If ok = 0 : HostAiBase + 8 : EndIf
    Until ok
    LpmCacheWritebackInvalidateData(HostAiBase, 8 * 2112)   ; the RSP writes the ring by DMA; the CPU never caches it
  CompilerElse
  HostAiBase = ((@HostAiMemory[0] + 4095) & ~4095) + 64
  CompilerEndIf
  HostPcmRead = ApuProduced
  HostAiSlot = 0
  LpmAiInit(#NES_AUDIO_RATE)
  ProcedureReturn 1
EndProcedure
