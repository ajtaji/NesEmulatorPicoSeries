ProcedureNaked PpuUpdateDescriptor(addr.i)
  ; Each logical row contains both horizontal nametables twice.
  ASM
    la a1, global_nt
    andi t0, a0, 0xc00
    srl t1, a0, 4
    andi t1, t1, 0x38
    srl t2, a0, 2
    andi t2, t2, 7
    or t0, t0, t1
    or t0, t0, t2
    ori t0, t0, 0x3c0
    addu t0, a1, t0
    addu t1, a1, a0
    lbu a2, 0(t0)
    lbu t1, 0(t1)
    srl t2, a0, 4
    andi t2, t2, 4
    andi t3, a0, 2
    or t2, t2, t3
    srlv a2, a2, t2
    andi a2, a2, 3
    sll a2, a2, 6
    sll t1, t1, 8
    or a2, a2, t1
    andi t0, a0, 0x800
    sll t0, t0, 2
    andi t1, a0, 0x3e0
    sll t1, t1, 3
    srl t2, a0, 4
    andi t2, t2, 64
    andi a0, a0, 31
    sll a0, a0, 1
    or a0, a0, t0
    or a0, a0, t1
    or a0, a0, t2
    la a1, global_nesmaprows
    addu a1, a1, a0
    la t0, global_ppumirroring
    ld t0, 0(t0)
    addiu t1, zero, 1
    beq t0, t1, nes_desc_mirror
    addiu t2, zero, 8192
    addiu t2, zero, 64
nes_desc_mirror:
    xor a0, a0, t2
    la a3, global_nesmaprows
    addu a3, a3, a0
    sh a2, 0(a1)
    sh a2, 128(a1)
    sh a2, 0(a3)
    jr ra
    sh a2, 128(a3)
  EndASM
EndProcedure

ProcedureNaked PpuUpdateAttribute(addr.i)
  ; Update the attribute address as a tile too. Coarse Y values 30 and 31
  ; can make the PPU fetch directly from the attribute area.
  ASM
    addiu sp, sp, -16
    sd ra, 8(sp)
    jal ppuupdatedescriptor
    sd a0, 0(sp)
    ld a0, 0(sp)
    ld ra, 8(sp)
    addiu sp, sp, 16
    la a1, global_nt
    addu t0, a1, a0
    lbu a2, 0(t0)
    andi t0, a0, 0xc00
    andi t1, a0, 0x38
    sll t1, t1, 4
    andi t2, a0, 7
    sll t2, t2, 2
    or a0, t0, t1
    or a0, a0, t2
    addu a1, a1, a0
    andi t0, a0, 0x800
    sll t0, t0, 2
    andi t1, a0, 0x3e0
    sll t1, t1, 3
    srl t2, a0, 4
    andi t2, t2, 64
    andi a0, a0, 31
    sll a0, a0, 1
    or a0, a0, t0
    or a0, a0, t1
    or a0, a0, t2
    la a3, global_nesmaprows
    addu a4, a3, a0
    la t0, global_ppumirroring
    ld t0, 0(t0)
    addiu t1, zero, 1
    beq t0, t1, nes_attr_mirror
    addiu t2, zero, 8192
    addiu t2, zero, 64
nes_attr_mirror:
    xor a0, a0, t2
    addu a3, a3, a0
    addiu a5, zero, 4
    ; Each of the four attribute quadrants covers two rows and two columns.
nes_attr_row:
    andi a6, a2, 3
    srl a7, a2, 2
    andi a7, a7, 3
    sll a6, a6, 6
    sll a7, a7, 6
    lbu t0, 0(a1)
    lbu t1, 1(a1)
    lbu t2, 2(a1)
    lbu t3, 3(a1)
    sll t0, t0, 8
    sll t1, t1, 8
    sll t2, t2, 8
    sll t3, t3, 8
    or t0, t0, a6
    or t1, t1, a6
    or t2, t2, a7
    or t3, t3, a7
    sh t0, 0(a4)
    sh t1, 2(a4)
    sh t2, 4(a4)
    sh t3, 6(a4)
    sh t0, 128(a4)
    sh t1, 130(a4)
    sh t2, 132(a4)
    sh t3, 134(a4)
    sh t0, 0(a3)
    sh t1, 2(a3)
    sh t2, 4(a3)
    sh t3, 6(a3)
    sh t0, 128(a3)
    sh t1, 130(a3)
    sh t2, 132(a3)
    sh t3, 134(a3)
    addiu a1, a1, 32
    addiu a3, a3, 256
    addiu a4, a4, 256
    addiu a5, a5, -1
    andi t0, a5, 1
    bne t0, zero, nes_attr_row
    nop
    bne a5, zero, nes_attr_row
    srl a2, a2, 4
    jr ra
    nop
  EndASM
EndProcedure
