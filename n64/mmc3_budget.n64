ProcedureNaked.i MapperCpuBudget()
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_mappercpubudget
    nop
  EndASM
EndProcedure

ProcedureNaked.i NesMmc3MaskedBudget()
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_nesmmc3maskedbudget
    nop
  EndASM
EndProcedure
