; Decode the current mapped bytes when a CPU window begins. A ROM bank
; change takes effect through the same pointer as the next opcode fetch.
; NesRuntimeWaitPair(readPc, branchPc, atBranch): the rule of the read / branch pair at readPc / branchPc (0: not a
; wait pair). IN ASSEMBLY for MMC3 (design note N.73, the owner's order; it runs at the load's index and at every miss
; of the hashed rule cache, ~10 times a frame in the record cart's SMB3 replay): the pointer is NesMmc3Pointer(readPc) =
; NesMmc3Bias((readPc >> 13) & 3) + readPc; the other mappers' builds keep the compiled form below.
; IN: a0 readPc, a1 branchPc, a2 atBranch. OUT: a0 the rule. A leaf: changes t0-t3, t8, t9, v0, v1, a3.
; THE PLAIN TWIN:
;     Protected ptr.i, op.i, length.i=2, mode.i, branch.i, addr.i, rule.i
;     If readPc<$8000 Or branchPc>$FFFD Or ((readPc ! (branchPc+1))&#NES_PRG_PROBE_MASK)
;       ProcedureReturn 0
;     EndIf
;     ptr=NesRuntimePrgPointer(readPc)
;     op=PeekA(?NesRuntimeWaitOpcodes+PeekA(ptr))
;     If op=0 : ProcedureReturn 0 : EndIf
;     mode=op&7
;     If mode>=3 : length=3 : EndIf
;     If readPc+length<>branchPc : ProcedureReturn 0 : EndIf
;     branch=PeekA(ptr+length)
;     If (branch&31)<>16 Or PeekA(ptr+length+1)<>254-length : ProcedureReturn 0 : EndIf
;     addr=PeekA(ptr+1)
;     If length=3
;       addr=addr|(PeekA(ptr+2)<<8)
;       If addr>=$2000 And (mode=3 Or addr<=$FF00) : ProcedureReturn 0 : EndIf
;     EndIf
;     rule=addr|((op>>3)<<16)|(mode<<19)|((branch>>5)<<22)
;     If ((readPc ! (branchPc+2))&$FF00) : rule|$2000000 : EndIf
;     If atBranch : rule|$4000000 : EndIf
;     ProcedureReturn rule
; HOW: every compare signed 64-bit as compiled ($8000 / $FFFD / $FF01 by ori: beyond slti's reach); length = 2 + (mode
; >= 3); the bytes read in the twin's order.
CompilerIf #NES_UNIT
ProcedureNaked.i NesRuntimeWaitPair(readPc.i, branchPc.i, atBranch.i)
  ASM
    ori t1, zero, 0x8000
    slt t0, a0, t1
    bnez t0, nes_rwp_none            ; readPc < $8000
    ori t1, zero, 0xFFFD             ; (delay slot)
    slt t0, t1, a1
    bnez t0, nes_rwp_none            ; branchPc > $FFFD
    daddiu t1, a1, 1                 ; (delay slot)
    xor t1, a0, t1
    andi t1, t1, #NES_PRG_PROBE_MASK
    bnez t1, nes_rwp_none            ; the pair across a PRG window
    dsrl t0, a0, 13                  ; (delay slot)
    andi t0, t0, 3
    dsll t0, t0, 3
    la t1, global_nesmmc3bias
    daddu t1, t1, t0
    ld t1, 0(t1)
    daddu t8, t1, a0                 ; ptr = NesMmc3Pointer(readPc)
    lbu t0, 0(t8)
    la t1, nesruntimewaitopcodes
    daddu t1, t1, t0
    lbu t9, 0(t1)                    ; op = the read opcode's entry
    beqz t9, nes_rwp_none
    andi t2, t9, 7                   ; (delay slot) mode
    sltiu t3, t2, 3
    xori t3, t3, 1
    daddiu t3, t3, 2                 ; length: 3 for mode >= 3, else 2
    daddu t0, a0, t3
    bne t0, a1, nes_rwp_none         ; readPc + length <> branchPc
    daddu t0, t8, t3                 ; (delay slot) ptr + length
    lbu v0, 0(t0)                    ; branch
    andi t1, v0, 31
    addiu v1, zero, 16
    bne t1, v1, nes_rwp_none         ; not a branch opcode
    lbu t1, 1(t0)                    ; (delay slot) its offset byte
    addiu v1, zero, 254
    dsubu v1, v1, t3
    bne t1, v1, nes_rwp_none         ; not back to the read
    lbu a3, 1(t8)                    ; (delay slot) addr's low byte
    addiu t0, zero, 3
    bne t3, t0, nes_rwp_rule         ; a 2-byte read: a zero-page address
    nop
    lbu t1, 2(t8)
    dsll t1, t1, 8
    or a3, a3, t1                    ; addr
    sltiu t1, a3, 0x2000
    bnez t1, nes_rwp_rule            ; RAM
    nop
    beq t2, t0, nes_rwp_none         ; mode 3 beyond RAM: no
    ori v1, zero, 0xFF01             ; (delay slot)
    slt t1, a3, v1
    bnez t1, nes_rwp_none            ; addr <= $FF00 beyond RAM: no
    nop
nes_rwp_rule:
    dsrl t1, t9, 3
    dsll t1, t1, 16
    or a3, a3, t1                    ; | (op >> 3) << 16
    dsll t1, t2, 19
    or a3, a3, t1                    ; | mode << 19
    dsrl t1, v0, 5
    dsll t1, t1, 22
    or a3, a3, t1                    ; | (branch >> 5) << 22
    daddiu t1, a1, 2
    xor t1, a0, t1
    andi t1, t1, 0xFF00
    beqz t1, nes_rwp_page
    nop
    lui t1, 0x200
    or a3, a3, t1                    ; the branch crosses a page: | $2000000
nes_rwp_page:
    beqz a2, nes_rwp_out
    nop
    lui t1, 0x400
    or a3, a3, t1                    ; atBranch: | $4000000
nes_rwp_out:
    jr ra
    move a0, a3                      ; (delay slot) the rule
nes_rwp_none:
    jr ra
    move a0, zero                    ; (delay slot) 0
  EndASM
EndProcedure
CompilerElse
Procedure.i NesRuntimeWaitPair(readPc.i, branchPc.i, atBranch.i)
  Protected ptr.i, op.i, length.i=2, mode.i, branch.i, addr.i, rule.i
  If readPc<$8000 Or branchPc>$FFFD Or ((readPc ! (branchPc+1))&#NES_PRG_PROBE_MASK)
    ProcedureReturn 0
  EndIf
  ptr=NesRuntimePrgPointer(readPc)
  op=PeekA(?NesRuntimeWaitOpcodes+PeekA(ptr))
  If op=0 : ProcedureReturn 0 : EndIf
  mode=op&7
  If mode>=3 : length=3 : EndIf
  If readPc+length<>branchPc : ProcedureReturn 0 : EndIf
  branch=PeekA(ptr+length)
  If (branch&31)<>16 Or PeekA(ptr+length+1)<>254-length : ProcedureReturn 0 : EndIf
  addr=PeekA(ptr+1)
  If length=3
    addr=addr|(PeekA(ptr+2)<<8)
    If addr>=$2000 And (mode=3 Or addr<=$FF00) : ProcedureReturn 0 : EndIf
  EndIf
  rule=addr|((op>>3)<<16)|(mode<<19)|((branch>>5)<<22)
  If ((readPc ! (branchPc+2))&$FF00) : rule|$2000000 : EndIf
  If atBranch : rule|$4000000 : EndIf
  ProcedureReturn rule
EndProcedure
CompilerEndIf

; ---- NesRamWaitRule(pc): the RAM-wait rule of the instruction at guest pc (0: none) - the read / branch pair that
; makes a wait loop, decoded by NesRuntimeWaitPair. At a branch opcode (op & 31 = 16) the pair is the 2- or 3-byte
; read before it (the 2-byte form first); at a read opcode (its NesRuntimeWaitOpcodes entry nonzero, mode = the entry
; & 7: 3 and up are 3-byte forms) the pair is it and the branch after it.
; IN ASSEMBLY for MMC3 (design note N.69, 2026-11-27): from the load's index (NesRuntimeIndexMmc3Waits, 8,192 PCs a
; PRG bank: the 5,673 cycles a frame the record cart's profile gives this label are that load spread over the run),
; the hashed cache's miss (unit/cold.n64) and the reference build's ramwait.n64. The pointer is NesMmc3Pointer(pc) =
; NesMmc3Bias((pc >> 13) & 3) + pc (nes.n64's macro). NesRuntimeWaitPair (once a decode, at load and on a miss) stays
; compiled by order; the other mappers' builds keep the compiled form below (no check here builds them).
; THE CHECK: every rule of the image indexed at load feeds the core's wait batches, so the guest digest every frame
; (SMB3, MM4) and the oracles run it.
; IN: a0 = pc. OUT: a0 = the rule. A frame of 16 bytes on the branch path (ra, pc); changes what a compiled call may.
; THE PLAIN TWIN:
;   Protected ptr.i=NesRuntimePrgPointer(pc), op.i=PeekA(ptr), rule.i, mode.i
;   If (op&31)=16
;     rule=NesRuntimeWaitPair(pc-2,pc,1)
;     If rule : ProcedureReturn rule : EndIf
;     ProcedureReturn NesRuntimeWaitPair(pc-3,pc,1)
;   EndIf
;   mode=PeekA(?NesRuntimeWaitOpcodes+op)
;   If mode=0 : ProcedureReturn 0 : EndIf
;   ProcedureReturn NesRuntimeWaitPair(pc,pc+2+Bool((mode&7)>=3),0)
CompilerIf #NES_UNIT
ProcedureNaked.i NesRamWaitRule(pc.i)
  ASM
    dsrl t0, a0, 13
    andi t0, t0, 3
    dsll t0, t0, 3                  ; the bank slot's word: ((pc >> 13) & 3) x 8
    la t1, global_nesmmc3bias
    daddu t1, t1, t0
    ld t1, 0(t1)
    daddu t1, t1, a0                ; ptr = NesMmc3Bias(slot) + pc
    lbu t2, 0(t1)                   ; op = the opcode at pc
    andi t3, t2, 31
    addiu t0, zero, 16
    bne t3, t0, nes_rwr_read        ; not a branch
    nop
    daddiu sp, sp, -16              ; a branch: the read before it
    sd ra, 0(sp)
    sd a0, 8(sp)
    move a1, a0                     ; branchPc = pc
    daddiu a0, a0, -2               ; readPc = pc - 2 (a 2-byte read)
    jal nesruntimewaitpair
    addiu a2, zero, 1               ; (delay slot) atBranch = 1
    bnez a0, nes_rwr_pop            ; found
    ld a1, 8(sp)                    ; (delay slot) branchPc = pc
    daddiu a0, a1, -3               ; readPc = pc - 3 (a 3-byte read)
    jal nesruntimewaitpair
    addiu a2, zero, 1
nes_rwr_pop:
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 16
nes_rwr_read:
    la t0, nesruntimewaitopcodes
    daddu t0, t0, t2
    lbu t3, 0(t0)                   ; the opcode's entry
    beqz t3, nes_rwr_none           ; not a read of a wait: 0
    andi t3, t3, 7                  ; (delay slot) mode & 7
    sltiu t3, t3, 3
    xori t3, t3, 1                  ; Bool((mode & 7) >= 3): a 3-byte read
    daddiu a1, a0, 2
    daddu a1, a1, t3                ; branchPc = pc + 2 + that
    j nesruntimewaitpair            ; (a tail call: a0 = readPc = pc)
    move a2, zero                   ; (delay slot) atBranch = 0
nes_rwr_none:
    jr ra
    move a0, zero
  EndASM
EndProcedure
CompilerElse
Procedure.i NesRamWaitRule(pc.i)
  Protected ptr.i=NesRuntimePrgPointer(pc), op.i=PeekA(ptr), rule.i, mode.i
  If (op&31)=16
    rule=NesRuntimeWaitPair(pc-2,pc,1)
    If rule : ProcedureReturn rule : EndIf
    ProcedureReturn NesRuntimeWaitPair(pc-3,pc,1)
  EndIf
  mode=PeekA(?NesRuntimeWaitOpcodes+op)
  If mode=0 : ProcedureReturn 0 : EndIf
  ProcedureReturn NesRuntimeWaitPair(pc,pc+2+Bool((mode&7)>=3),0)
EndProcedure
CompilerEndIf


CompilerIf #GAME_MAPPER=0
Global Dim NesRuntimeNromRules.l[32768]
Declare.i NesRamWaitBatch(n.i, coalesce.i, rule.i)

Procedure NesRuntimeIndexNromWaits()
  Protected pc.i, rule.i
  For pc=$8000 To $FFFD
    rule=NesRamWaitRule(pc)
    If rule : NesRuntimeNromRules[pc-$8000]=rule : EndIf
  Next
EndProcedure

ProcedureNaked.i NesRamCpuWindow(n.i, coalesce.i=0)
  ASM
    blez a0, nes_runtime_nrom_plain
    nop
    la t0, global_pc
    ld t0, 0(t0)
    addiu t0, t0, -32768
    bltz t0, nes_runtime_nrom_plain
    sll t0, t0, 2
    la t1, global_nesruntimenromrules
    addu t1, t1, t0
    lw a2, 0(t1)
    beqz a2, nes_runtime_nrom_plain
    nop
    la t0, global_nesidleenabled
    ld t0, 0(t0)
    beqz t0, nes_runtime_nrom_plain
    nop
    la t0, global_nesstall
    ld t0, 0(t0)
    bnez t0, nes_runtime_nrom_plain
    nop
    la t0, global_stopped
    ld t0, 0(t0)
    bnez t0, nes_runtime_nrom_plain
    nop
    j nesramwaitbatch
    nop
nes_runtime_nrom_plain:
    j cpurun
    nop
  EndASM
EndProcedure
CompilerEndIf

CompilerIf #NES_UNIT
; Cache both positive and negative decodes. The full tag includes the
; physical bank and guest PC, so bank switches need no invalidation.
Global Dim NesMmc3WaitCache.q(1024)
Global NesMmc3WaitIndex.i, NesMmc3WaitRules.i
Declare.i NesMmc3RamWaitBatch(n.i, coalesce.i, rule.i)

; Word 0 of each bank's rule block is never a rule (slots start at 1). It holds the bank's PAGE BITS: bit p set
; when the bank's 256-byte page p has a nonzero index byte (a rule or the 255 mark), so the look-up in the hot
; unit (u_nesramwaitrule, unit/window.n64) reads the index byte only for a PC in such a page (design note N.47a).
Procedure NesRuntimeIndexMmc3Waits()
  Protected bank.i, pc.i, rule.i, slot.i, index.i, rules.i, base.i, limit.i, saved.i, pages.i
  ; Place the immutable index after the cart image, inside the same arena.
  ; Large images leave the existing bounded on-demand cache available.
  base=(CartChr+MapChrBytes+7)&~7
  limit=#NES_CART_LOW_END
  If CartPrg>=#NES_CART_HIGH : limit=#NES_CART_HIGH_END : EndIf
  rules=base+MapPrgBytes
  If rules+(MapPrgBytes>>3)>limit : ProcedureReturn : EndIf
  saved=NesMmc3Bias(0)
  For bank=0 To (MapPrgBytes>>13)-1
    NesMmc3Bias(0)=CartPrg+(bank<<13)-$8000
    index=base+(bank<<13)-$8000
    slot=1
    pages=0
    For pc=$8000 To $9FFF
      rule=NesRamWaitRule(pc)
      If rule=0
        PokeA(index+pc,0)
      ElseIf slot<255
        PokeA(index+pc,slot)
        PokeL(rules+(bank<<10)+slot*4,rule)
        slot+1
        pages=pages|(1<<((pc>>8)&31))
      Else
        PokeA(index+pc,255)
        pages=pages|(1<<((pc>>8)&31))
      EndIf
    Next
    PokeL(rules+(bank<<10),pages)
  Next
  NesMmc3Bias(0)=saved
  NesMmc3WaitIndex=base : NesMmc3WaitRules=rules
EndProcedure

ProcedureNaked.i NesRamCpuWindow(n.i, coalesce.i=0)
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_nesramcpuwindow
    nop
  EndASM
EndProcedure
CompilerEndIf
