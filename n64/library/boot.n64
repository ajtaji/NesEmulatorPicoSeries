; Run the child IPL3 from RSP DMEM, outside either program's RDRAM range.
ProcedureNaked NesLibBootStage(entry.i)
  ASM
    sll t3,a0,0
    lui t0,$A450
nes_lib_wait_ai:
    lw t1,12(t0)
    lui t2,$4000
    and t1,t1,t2
    bnez t1,nes_lib_wait_ai
    nop
    sw zero,8(t0)
    lui t0,$A480
nes_lib_wait_si:
    lw t1,24(t0)
    andi t1,t1,3
    bnez t1,nes_lib_wait_si
    nop
    lui t0,$A460
nes_lib_wait_pi:
    lw t1,16(t0)
    andi t1,t1,3
    bnez t1,nes_lib_wait_pi
    nop
    lui t0,$3400
    mtc0 t0,$12
    nop
    nop
    nop
    lui t0,$A430
    ori t1,zero,$0555
    sw t1,12(t0)
    lui t0,$A404
    ori t1,zero,2
    sw t1,16(t0)
nes_lib_wait_sp:
    lw t1,16(t0)
    andi t1,t1,13
    xori t1,t1,1
    bnez t1,nes_lib_wait_sp
    nop
    lui a4,$A400
    ori a4,a4,$0400
    lui a5,$A400
    ori a5,a5,$1000
nes_lib_copy:
    lw t1,0(t3)
    sw t1,0(a4)
    addiu t3,t3,4
    addiu a4,a4,4
    bne a4,a5,nes_lib_copy
    nop
    sync
    lui a4,$A400
    ori a4,a4,$0400
    lui t0,$A000
    lw s3,$0304(t0)
    lw s4,$0300(t0)
    lw s5,$030C(t0)
    lw s7,$0314(t0)
    jr a4
    nop
  EndASM
EndProcedure


Procedure NesLibBoot(entry.i)
  LpmRdpSyncFullWait()
  LpmViOff()
  NesLibBootStage(entry)
EndProcedure
