; Every write drives the bus. RAM, unmapped addresses and mapper selector
; writes with unchanged mode bits can return without advancing the devices.
ProcedureNaked NesWrite(addr.i, value.i)
  ; The body is in the hot unit (n64/unit/, inside cpu6502.n64's procedure) so that it
  ; cannot share I-cache sets with the core; outside callers enter it here.
  ASM
    j u_neswrite
    nop
  EndASM
EndProcedure
