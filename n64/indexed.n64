CompilerIf #NES_RDP_SHOW
; N5 (design note N.22): the RSP band emitter's picture is shown (show.n64); the old renderer draws only the
; fallback lines, into their slots, and show.n64's NesFbPublish publishes them. No frame-sized CI8 image, no blit.
XIncludeFile "ppu_palette.n64"
CompilerIf #NES_UNIT
  Global NesReusedIndexRow.i            ; (NesReuseLine's, mappedrows.n64; that routine is not called in N5)
CompilerEndIf
ProcedureNaked PpuRgbLineRaw()          ; (declared by ppu.n64; nothing calls it in N5)
  ASM
    jr ra
    nop
  EndASM
EndProcedure
CompilerElse
; The guest PPU writes one indexed frame in CPU cache. Keep the effective
; RGBA5551 palette at each scanline where it changes. The RDP expands CI8
; strips into the VI back buffer after the last visible scanline.
Global Dim NesIndexBlock.i(1024)
Global NesDisplayBlock.i, NesLayoutChanged.i, NesIndexTicket.i
Global NesIndexBackdrop.i               ; the last published line's substitute backdrop index (0: none; N.79 item 2)
Global NesLineV.i                       ; v at the line's dot 0 (ppu_begin_row, the builds without the RDP show; N.79 item 2)
Global Dim NesIndexPalette.i(1920)
Global Dim NesPaletteChange.a(240)
XIncludeFile "ppu_palette.n64"

CompilerIf #NES_UNIT
  Global NesReusedIndexRow.i
CompilerEndIf
ProcedureNaked PpuRgbLineRaw()
  CompilerIf #NES_UNIT
    ASM
      ; Retained pixels were already published to RDRAM on the prior frame.
      ; Palette capture still runs for every completed scanline.
      la t0, global_nesreusedindexrow
      ld t1, 0(t0)
      bnez t1, nes_index_row_written
      sd zero, 0(t0)
    EndASM
  CompilerEndIf
  ASM
    ; A completed row is immutable until the next guest frame. Write it
    ; back while resident, including the final line of an unaligned row.
    la t0, global_neslinerow
    lw a2, 4(t0)
    andi t1, a2, 15
    subu a2, a2, t1
    cache 0x19, 0(a2)
    cache 0x19, 16(a2)
    cache 0x19, 32(a2)
    cache 0x19, 48(a2)
    cache 0x19, 64(a2)
    cache 0x19, 80(a2)
    cache 0x19, 96(a2)
    cache 0x19, 112(a2)
    cache 0x19, 128(a2)
    cache 0x19, 144(a2)
    cache 0x19, 160(a2)
    cache 0x19, 176(a2)
    cache 0x19, 192(a2)
    cache 0x19, 208(a2)
    cache 0x19, 224(a2)
    cache 0x19, 240(a2)
    beq t1, zero, nes_index_row_written
    nop
    cache 0x19, 256(a2)
nes_index_row_written:
    la t0, global_ppuline
    ld a0, 0(t0)
    la t0, global_rgbpairsdirty
    ld t1, 0(t0)
    ; THE BACKDROP AT v (N.79 item 2). With rendering off (PPUMASK bits 3-4 clear) the line's pixels are all the
    ; backdrop, and the PPU shows palette byte 0 - unless v addresses the palette ($3F00-$3FFF): then the byte at
    ; v & $1F, $10 / $14 / $18 / $1C reading $00 / $04 / $08 / $0C. The old renderer's rows carry index 0 on such a
    ; line (whatever is drawn, every index of colour 0 is the backdrop), so the LINE'S PALETTE carries the rule: its
    ; entries 0, 4, 8, 12, 16 (every index that shows the backdrop) take the colour of the byte at v - the colour
    ; table's entry for a colour 1-3, entry 20 / 24 / 28 for bytes $04 / $08 / $0C (PpuColours keeps the mirrors'
    ; colours there; entry 16 is byte 0's). A line whose substitute differs from the line before's is captured
    ; (the palette change flag), as a palette write would make it. v is the line's at its dot 0 (NesLineV, stored by
    ; ppu_begin_row) - the v the RSP show's band record takes too, so a move of v inside a line shows on that line
    ; the same way in both renderers (to the line; the PPU itself changes colour at the dot). a5 = the substitute
    ; index (0: none), a6 / a7 scratch (both free here).
    la a5, global_ppumask
    ld a5, 0(a5)
    andi a5, a5, 24
    bnez a5, nes_index_bd_none      ; rendering on: byte 0 is the backdrop
    nop
    la a5, global_neslinev
    ld a5, 0(a5)                    ; v at the line's dot 0
    andi a6, a5, 0x3F00
    xori a6, a6, 0x3F00
    bnez a6, nes_index_bd_none      ; v outside the palette
    andi a5, a5, 31                 ; the index v addresses
    andi a6, a5, 3
    bnez a6, nes_index_bd_have      ; a colour 1-3: its own entry
    nop
    b nes_index_bd_have
    ori a5, a5, 0x10                ; $00 -> 16 (byte 0's colour), $04 / $08 / $0C and the mirrors -> 20 / 24 / 28
nes_index_bd_none:
    move a5, zero
nes_index_bd_have:
    la a6, global_nesindexbackdrop
    ld a7, 0(a6)
    sd a5, 0(a6)
    xor a7, a7, a5
    sltu a7, zero, a7               ; the substitute changed from the line before: capture this line's palette
    or t1, t1, a7
    sltiu a1, a0, 1
    or t1, t1, a1
    la t2, global_nespalettechange
    addu t2, t2, a0
    lbu a3, 0(t2)
    xor a3, a3, t1
    beq a3, zero, nes_index_layout_same
    sb t1, 0(t2)
    la a3, global_neslayoutchanged
    addiu a4, zero, 1
    sd a4, 0(a3)
nes_index_layout_same:
    beq t1, zero, nes_index_row_done
    nop
    sd zero, 0(t0)
    la t0, global_rgbpal
    la t1, global_nesindexpalette
    sll a0, a0, 6
    addu t1, t1, a0
    or a3, t1, zero
    addiu t2, t0, 64
nes_index_palette_copy:
    ld a1, 0(t0)
    ld a2, 8(t0)
    sd a1, 0(t1)
    sd a2, 8(t1)
    addiu t0, t0, 16
    bne t0, t2, nes_index_palette_copy
    addiu t1, t1, 16
    beqz a5, nes_index_bd_same      ; the backdrop at v (above): the line's entries 0, 4, 8, 12, 16 take its colour
    sll a6, a5, 1
    la a7, global_rgbpal
    addu a6, a6, a7
    lhu a6, 0(a6)
    sh a6, 0(a3)
    sh a6, 8(a3)
    sh a6, 16(a3)
    sh a6, 24(a3)
    sh a6, 32(a3)
nes_index_bd_same:
    andi t1, a3, 15
    subu a3, a3, t1
    cache 0x19, 0(a3)
    cache 0x19, 16(a3)
    cache 0x19, 32(a3)
    cache 0x19, 48(a3)
    beq t1, zero, nes_index_row_done
    nop
    cache 0x19, 64(a3)
nes_index_row_done:
    jr ra
    nop
  EndASM
EndProcedure
Procedure NesIndexCommands()
  Protected y.i, h.i
  ; A CI8 strip fits eight 256-pixel rows in the 2 KiB below the TLUT.
  LpmRdpTmemReset()
  LpmRdpModeCopy(0)
  While y<240
    If NesPaletteChange(y) : LpmRdpLoadPalette(@NesIndexPalette(y*8),0,32) : EndIf
    h=1
    While h<8 And y+h<240
      If NesPaletteChange(y+h) : Break : EndIf
      h=h+1
    Wend
    LpmRdpLoadTexture(NesIndexedPixels()+y*256,256,h,#LPM_TEX_CI8)
    LpmRdpTextureRect(32,y,288,y+h,0,0,1024,1024)
    y=y+h
  Wend
EndProcedure
; Until rendering has ever been enabled, every pixel has backdrop index zero.
; Preserve the captured scanline colors, including palette-only raster effects.
Procedure NesShowInitialBlank(fb.i)
  Protected y.i, firstRow.i, color.i=PeekU(@NesIndexPalette(0)), nextColor.i
  LpmRdpAttach(fb)
  For y=1 To 239
    If NesPaletteChange(y)
      nextColor=PeekU(@NesIndexPalette(y*8))
      If nextColor<>color
        LpmRdpModeFill(color)
        LpmRdpFillRect(32,firstRow,288,y)
        firstRow=y : color=nextColor
      EndIf
    EndIf
  Next
  LpmRdpModeFill(color)
  LpmRdpFillRect(32,firstRow,288,240)
  LpmRdpDetachShow(fb) : NesIndexTicket=lpm_rdp_frames_sent
EndProcedure

Procedure NesIndexedShow(fb.i)
  Protected i.i, count.i
  If NesBlankUntouched : NesShowInitialBlank(fb) : ProcedureReturn : EndIf
  LpmRdpAttach(fb)
  ; Pixel and palette data change in place. Only changing the scanlines
  ; that start a palette requires a different RDP command list.
  If NesLayoutChanged Or NesDisplayBlock=0
    NesLayoutChanged=0 : NesDisplayBlock=0
    For i=0 To 239 : count=count+NesPaletteChange(i) : Next
    If count<20
      If LpmRdpBlockBegin(@NesIndexBlock(0),8192)
        NesIndexCommands()
        NesDisplayBlock=LpmRdpBlockEnd()
      EndIf
    EndIf
  EndIf
  If NesDisplayBlock : LpmRdpBlockRun(NesDisplayBlock) : Else : NesIndexCommands() : EndIf
  LpmRdpDetachShow(fb) : NesIndexTicket=lpm_rdp_frames_sent
EndProcedure
CompilerEndIf
