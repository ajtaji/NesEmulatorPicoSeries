; Advance the guest raster in timestamped spans. Visible row rendering
; and prerender scroll latches keep separate dot 256/257 and 280 edges.
ProcedureNaked PpuAdvanceReference(cycles.i)
  ASM
    la t0, global_ppuwarmup
    ld t1, 0(t0)
    blez t1, nes_raster_asm_save
    nop
    dsubu t1, t1, a0
    bgez t1, nes_raster_asm_warmup
    nop
    move t1, zero
nes_raster_asm_warmup:
    sd t1, 0(t0)
nes_raster_asm_save:
    daddiu sp, sp, -64
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    sd s4, 40(sp)
    sd s5, 48(sp)
    la t0, global_cartpal
    ld t0, 0(t0)
    bnez t0, nes_raster_asm_fraction
    dsll s0, a0, 1
    b nes_raster_asm_start
    daddu s0, s0, a0
nes_raster_asm_fraction:
    jal pputakedots
    nop
    move s0, a0
nes_raster_asm_start:
    la s4, global_ppuline
    ld s1, 0(s4)
    ld s2, global_ppudot-global_ppuline(s4)
nes_raster_asm_next:
    blez s0, nes_raster_asm_commit
    sltiu t0, s1, 240
    beqz t0, nes_raster_asm_blank
    daddu s3, s2, s0

    sltiu t0, s2, 256
    beqz t0, nes_raster_asm_hblank
    nop
    bnez s2, nes_raster_asm_draw
    nop
    jal ppubeginline
    nop
    jal ppuspritesreference
    nop
nes_raster_asm_draw:
    sltiu t0, s3, 256
    beqz t0, nes_raster_asm_draw_call
    addiu a0, zero, 256
    move a0, s3
nes_raster_asm_draw_call:
    jal nesreuseline
    nop
    sltiu t0, s3, 256
    bnez t0, nes_raster_asm_current_dot
    nop
    ld t0, global_ppumask-global_ppuline(s4)
    andi t0, t0, 24
    beqz t0, nes_raster_asm_row_publish
    nop
    jal ppuincy
    nop
nes_raster_asm_row_publish:
    jal ppurgblineraw
    nop
    addiu t0, zero, 239
    bne s1, t0, nes_raster_asm_hblank
    nop
    jal displayframe
    nop
nes_raster_asm_hblank:
    sltiu t0, s2, 257
    beqz t0, nes_raster_asm_end_row
    sltiu t0, s3, 257
    bnez t0, nes_raster_asm_end_row
    ld t0, global_ppumask-global_ppuline(s4)
    andi t0, t0, 24
    beqz t0, nes_raster_asm_end_row
    nop
    ld t0, global_ppuv-global_ppuline(s4)
    ld t1, global_pput-global_ppuline(s4)
    andi t0, t0, 0x7BE0
    andi t1, t1, 0x041F
    or t0, t0, t1
    sd t0, global_ppuv-global_ppuline(s4)
nes_raster_asm_end_row:
    sltiu t0, s3, 341
    bnez t0, nes_raster_asm_current_dot
    nop
    daddiu s0, s3, -341
    b nes_raster_asm_next_line
    nop
nes_raster_asm_current_dot:
    b nes_raster_asm_save_dot
    move s2, s3

nes_raster_asm_blank:
    ld t0, global_ppupreline-global_ppuline(s4)
    addiu s3, zero, 341
    addiu s5, zero, 341
    bne s1, t0, nes_raster_asm_vblank
    ld t1, global_ppuodd-global_ppuline(s4)
    beqz t1, nes_raster_asm_pre_edges
    ld t1, global_ppumask-global_ppuline(s4)
    andi t1, t1, 24
    beqz t1, nes_raster_asm_pre_edges
    nop
    addiu s3, zero, 340
    move s5, s3
nes_raster_asm_pre_edges:
    beqz s2, nes_raster_asm_dot_one
    sltiu t0, s2, 257
    bnez t0, nes_raster_asm_dot_x
    sltiu t0, s2, 280
    beqz t0, nes_raster_asm_blank_step
    nop
    b nes_raster_asm_blank_step
    addiu s5, zero, 280
nes_raster_asm_dot_x:
    b nes_raster_asm_blank_step
    addiu s5, zero, 257
nes_raster_asm_vblank:
    addiu t0, zero, 241
    bne s1, t0, nes_raster_asm_blank_step
    nop
    bnez s2, nes_raster_asm_blank_step
    nop
nes_raster_asm_dot_one:
    addiu s5, zero, 1
nes_raster_asm_blank_step:
    subu t0, s5, s2
    sltu t1, s0, t0
    beqz t1, nes_raster_asm_blank_edge
    nop
    b nes_raster_asm_save_dot
    addu s2, s2, s0
nes_raster_asm_blank_edge:
    move s2, s5
    dsubu s0, s0, t0
    sd s2, global_ppudot-global_ppuline(s4)
    addiu t0, zero, 1
    bne s5, t0, nes_raster_asm_blank_scroll
    addiu t0, zero, 241
    ld t1, global_ppustatus-global_ppuline(s4)
    bne s1, t0, nes_raster_asm_pre_clear
    ld t0, global_ppuctrl-global_ppuline(s4)
    ori t1, t1, 128
    sd t1, global_ppustatus-global_ppuline(s4)
    andi t0, t0, 128
    beqz t0, nes_raster_asm_next
    nop
    la t0, global_workernmi
    ld t1, 0(t0)
    daddiu t1, t1, 1
    b nes_raster_asm_next
    sd t1, 0(t0)
nes_raster_asm_pre_clear:
    andi t1, t1, 31
    b nes_raster_asm_next
    sd t1, global_ppustatus-global_ppuline(s4)

nes_raster_asm_blank_scroll:
    beq s5, s3, nes_raster_asm_next_line
    ld t0, global_ppumask-global_ppuline(s4)
    andi t0, t0, 24
    beqz t0, nes_raster_asm_next
    addiu t2, zero, 257
    ld t0, global_ppuv-global_ppuline(s4)
    ld t1, global_pput-global_ppuline(s4)
    beq s5, t2, nes_raster_asm_blank_latch
    nop
    move t2, t0
    move t0, t1
    move t1, t2
nes_raster_asm_blank_latch:
    andi t0, t0, 0x7BE0
    andi t1, t1, 0x041F
    or t0, t0, t1
    b nes_raster_asm_next
    sd t0, global_ppuv-global_ppuline(s4)

nes_raster_asm_next_line:
    move s2, zero
    sd zero, global_ppudot-global_ppuline(s4)
    ld t0, global_ppulinecount-global_ppuline(s4)
    addiu s1, s1, 1
    bne s1, t0, nes_raster_asm_store_line
    nop
    move s1, zero
    ld t0, global_ppuodd-global_ppuline(s4)
    ld t1, global_ppuoddtoggle-global_ppuline(s4)
    xor t0, t0, t1
    sd t0, global_ppuodd-global_ppuline(s4)
    la t0, global_workerframes
    ld t1, 0(t0)
    daddiu t1, t1, 1
    sd t1, 0(t0)
nes_raster_asm_store_line:
    b nes_raster_asm_next
    sd s1, 0(s4)
nes_raster_asm_save_dot:
    sd s2, global_ppudot-global_ppuline(s4)
nes_raster_asm_commit:
    addiu t0, zero, 341
    multu s1, t0
    mflo t0
    daddu t0, t0, s2
    la t1, global_workerdot
    sd t0, 0(t1)
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    jr ra
    daddiu sp, sp, 64
  EndASM
EndProcedure

ProcedureNaked PpuBeginLine()
  ASM
    la t0, global_ppuline
    ld a0, 0(t0)
    andi t1, a0, 15
    bnez t1, nes_raster_asm_row_pointer
    nop
    daddiu sp, sp, -16
    sd ra, 0(sp)
    jal displaywaitline
    sd a0, 8(sp)
    ld ra, 0(sp)
    ld a0, 8(sp)
    daddiu sp, sp, 16
nes_raster_asm_row_pointer:
    la t0, global_linepixels
    addiu t0, t0, 15
    srl t0, t0, 4
    sll t0, t0, 4
    sll a0, a0, 8
    addu t0, t0, a0
    la t1, global_neslinerow
    jr ra
    sd t0, 0(t1)
  EndASM
EndProcedure

ProcedureNaked PpuIncY()
  ASM
    la t0, global_ppuv
    ld t1, 0(t0)
    andi t2, t1, 0x7000
    xori t2, t2, 0x7000
    beqz t2, nes_raster_asm_coarse_y
    addiu t3, t1, 4096
    jr ra
    sd t3, 0(t0)
nes_raster_asm_coarse_y:
    andi t1, t1, 0x0FFF
    srl t2, t1, 5
    andi t2, t2, 31
    addiu t3, zero, 29
    bne t2, t3, nes_raster_asm_next_y
    addiu t2, t2, 1
    xori t1, t1, 0x0800
    move t2, zero
nes_raster_asm_next_y:
    andi t2, t2, 31
    andi t1, t1, 0x7C1F
    sll t2, t2, 5
    or t1, t1, t2
    jr ra
    sd t1, 0(t0)
  EndASM
EndProcedure
