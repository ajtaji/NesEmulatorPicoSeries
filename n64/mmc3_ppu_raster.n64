; The runtime MMC3 cartridge's raster: the PPU state machine is part of the hot unit
; (unit/ppu.n64, design note section N, step N3). These procedures are one-jump stubs for
; callers outside the unit.
ProcedureNaked PpuAdvanceReference(cycles.i)
  ASM
    j u_ppuadvance
    nop
  EndASM
EndProcedure

ProcedureNaked PpuBeginLine()
  ASM
    j u_ppubeginline
    nop
  EndASM
EndProcedure

ProcedureNaked PpuIncY()
  ASM
    j u_ppuincy
    nop
  EndASM
EndProcedure
