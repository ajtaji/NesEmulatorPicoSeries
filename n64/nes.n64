; Nintendo 64 cartridge entry. The shared guest core runs synchronously on the VR4300.
#CPU_TIMING=1
#NES_SPLIT=0
#PPU_PROFILE=0
#NES_VIDEO_BACKEND=2
#NES_AUDIO_BACKEND=2
XIncludeFile "game.pmi"
; Keep the native MMC3 measurement and release builds at the same code
; addresses. Compile the queue counters into both and gate log output.
CompilerIf #NES_HW_TELEMETRY Or (#NES_RUNTIME_ROM And #GAME_MAPPER=4 And #VERIFY_FRAME=0)
  #NES_MEASURE_QUEUE=1
CompilerElse
  #NES_MEASURE_QUEUE=0
CompilerEndIf
XIncludeFile "Mips/Lib/LibPureMetalN64/lpm.n64"
ASM
  .cartfile "game.bin"
EndASM

Procedure.i NesHostUs()
  ProcedureReturn (LpmCpuCount() & $FFFFFFFF)*8/375
EndProcedure
Procedure.i NesDiv(a.i,b.i)
  ProcedureReturn a/b
EndProcedure
Procedure GuestClear(p.i,n.i)
  Protected i.i
  For i=0 To n-1 : PokeA(p+i,0) : Next
EndProcedure
Procedure UsbSerialTask()
EndProcedure
Procedure SafetyPet()
EndProcedure
Procedure FrameFence()
EndProcedure

CompilerIf #GAME_MAPPER=1
  Declare.i NesReaderActive()
CompilerEndIf
CompilerIf #GAME_SAVE_BYTES>0
  Declare NesSaveChanged(offset.i)
CompilerEndIf
Declare.i NesCurrentPoll(acc.i)
Global NesDeliveredFrame.i, NesLoopRule.i, NesLoopCost.i
XIncludeFile "poll.pmi"
Global NesStatusHorizon.i = -1, NesCpuHorizon.i = -1
CompilerIf #NES_DMC_RASTER_DEADLINE
  Global NesPpuLimit.i=-1
CompilerEndIf
Global NesExtraBoard.i, NesA12Board.i
CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
  Global NesMmc3Line.i, NesMmc3Dot.i, NesMmc3Odd.i, NesMmc3RenderLimit.i=-1
  Global Dim NesMmc3ChrBias.i(8)
  Global Dim NesMmc3PatternBias.i(8)
  Global Dim NesMmc3ChrTags.i(2)
  ; NesUnitData: the hot unit's own state (design note, section N.4), one window reached from one
  ; base register at these byte offsets. U_SPLIT is a 240-bit map of the split (fallback) lines;
  ; U_BANDS holds the frame's band records, 32 bytes each (unit/ppu.n64 describes both).
  #NES_U_BANDOPEN = 0
  #NES_U_BANDFIRST = 8
  #NES_U_BANDV = 16
  #NES_U_BANDCOUNT = 24
  #NES_U_S0ROW = 32
  #NES_U_S0X = 40
  #NES_U_DRAWST = 48
  #NES_U_BANDLOST = 56
  #NES_U_SPLIT = 64
  #NES_U_BANDMAX = 32
  #NES_U_REC_FIRST = 128
  #NES_U_REC_END = 136
  #NES_U_REC_V = 144
  #NES_U_REC_STATE = 152
  ; NesUnitData is not a declared array: its #NES_UNIT_BYTES are a window into NesUnitSpace, chosen
  ; at load (NesUnitPlace) so that its D-cache sets (8 KB, 16-byte lines, 512 sets) are clear of
  ; guest RAM's and of the host stack's working top. Where the compiler places arrays is not the
  ; program's to choose; which bytes of these 9 KB it uses is. NesUnitBase holds the address.
  #NES_UNIT_BYTES = 1168
  Global Dim NesUnitSpace.a(8192+#NES_UNIT_BYTES+16)
  Global Dim NesUnitSets.a(512)
  Global NesUnitBase.i
  CompilerIf #NES_PPU_CHECK
    Global Dim NesPpuCheck.i(16)
  CompilerEndIf
  Macro NesMmc3ChrPointer(address)
    (NesMmc3ChrBias((address)>>10)+(address))
  EndMacro
  Macro NesMmc3PatternPointer(address)
    (NesMmc3PatternBias((address)>>10)+(address))
  EndMacro
CompilerEndIf
XIncludeFile "../anvil/state.pmi"
CompilerIf #NES_CHAIN_WINDOWS
  Global NesChainLimit.i=-1
CompilerEndIf
CompilerIf #GAME_MAPPER=1
  Global Dim NesMmc1Bias.i(2)
  Macro NesMmc1Pointer(addr)
    (NesMmc1Bias(((addr)>>14)&1)+(addr))
  EndMacro
CompilerElseIf #GAME_MAPPER=4
  Global Dim NesMmc3Bias.i(4)
  Macro NesMmc3Pointer(addr)
    (NesMmc3Bias(((addr)>>13)&3)+(addr))
  EndMacro
CompilerEndIf
CompilerIf #NES_RUNTIME_ROM
  CompilerIf #GAME_MAPPER=4
    #NES_PRG_PROBE_MASK=$6000
  CompilerElse
    #NES_PRG_PROBE_MASK=$4000
  CompilerEndIf
  CompilerIf #GAME_MAPPER=1
    Macro NesRuntimePrgPointer(address)
      NesMmc1Pointer(address)
    EndMacro
  CompilerElseIf #GAME_MAPPER=4
    Macro NesRuntimePrgPointer(address)
      NesMmc3Pointer(address)
    EndMacro
  CompilerElse
    Macro NesRuntimePrgPointer(address)
      (PrgBias+(address))
    EndMacro
  CompilerEndIf
CompilerEndIf
XIncludeFile "../anvil/cpu2a03.pmi"
XIncludeFile "../anvil/mapper_state.pmi"
CompilerIf #NES_BANKED_WAITS
  Macro NesPollOffset(addr)
    (MapPrgSlots(((addr)-$8000)>>13)*8192+((addr)&8191))
  EndMacro
CompilerElse
  Macro NesPollOffset(addr)
    (PrgBase-CartPrg+(addr)-$8000)
  EndMacro
CompilerEndIf
XIncludeFile "../anvil/bridge.pmi"
XIncludeFile "ppu.n64"
XIncludeFile "../anvil/mappers.pmi"
XIncludeFile "../anvil/mapper_extra.pmi"
XIncludeFile "../anvil/mapper_extra_bus.pmi"
XIncludeFile "../anvil/mapper5.pmi"
XIncludeFile "../anvil/mapper5_video.pmi"
XIncludeFile "../anvil/apu.pmi"
XIncludeFile "../anvil/mapper5_audio.pmi"
XIncludeFile "../anvil/mapper69_audio.pmi"
XIncludeFile "../anvil/mapper9_video.pmi"
XIncludeFile "../anvil/mapper_adapters.pmi"
XIncludeFile "../anvil/worker.pmi"
CompilerIf #NES_CPU_TRACE
  XIncludeFile "cputrace.n64"
CompilerEndIf
XIncludeFile "../anvil/mapper_konami_namco.pmi"
XIncludeFile "../anvil/lookup_tables.pmi"
XIncludeFile "region.pmi"
XIncludeFile "host.n64"
XIncludeFile "storage.n64"
CompilerIf #NES_RUNTIME_ROM
  XIncludeFile "library/runtime.n64"
CompilerEndIf
CompilerIf #NES_HAS_RAM_WAITS
  XIncludeFile "ramwait.pmi"
  XIncludeFile "ramwait.n64"
CompilerEndIf

CompilerIf #NES_BG_EXPANDED
XIncludeFile "descriptors.n64"
CompilerElse
Procedure PpuUpdateDescriptor(addr.i)
EndProcedure
Procedure PpuUpdateAttribute(addr.i)
EndProcedure
CompilerEndIf
Procedure CartPpuWriteNotice(addr.i,value.i)
EndProcedure
Procedure CartSelect(number.i)
EndProcedure

CompilerIf #GAME_MAPPER=1
Procedure.i NesReaderActive()
  ProcedureReturn DmcBytes>0
EndProcedure
CompilerEndIf
Procedure.i NesCurrentPoll(acc.i)
  If WorkerFrames<>NesDeliveredFrame : ProcedureReturn 0 : EndIf
  If acc<>((PpuStatus&$E0)|(PpuBus&31)) Or WorkerNmi<>NesSeenNmi Or WorkerDmcCycles<>NesSeenDmc
    ProcedureReturn 0
  EndIf
  If FI=0 And (WorkerIrq|MapIrq)<>0 : ProcedureReturn 0 : EndIf
  CompilerIf #NES_RUNTIME_ROM
    ProcedureReturn NesRuntimePoll(PC,acc)
  CompilerElse
    ProcedureReturn NesPollRule(NesPollOffset(PC),acc)
  CompilerEndIf
EndProcedure

CompilerIf #GAME_SAVE_BYTES>0
XIncludeFile "save_backing.pmi"
XIncludeFile "save.n64"
CompilerEndIf

CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
ProcedureNaked.i NesStackPointer()
  ; The host stack pointer here, at load, a few frames above the run loop's calls.
  ASM
    jr ra
    move a0, sp
  EndASM
EndProcedure

; Place NesUnitData (design note, section N.4): mark the D-cache sets of guest RAM (M, 2 KB) and of
; the stack's working top (512 bytes either side of the stack pointer at load), then take the first
; set from which #NES_UNIT_BYTES / 16 sets in a row (the cache wraps at 512) are free, and the
; address in NesUnitSpace (8 KB + the window) whose set that is. Fails loudly (WorkerError 22, the
; load refused) if there is no such run.
Procedure NesUnitPlace()
  Protected i.i, a.i, start.i, run.i, space.i, sets.i=#NES_UNIT_BYTES/16
  For i=0 To 511 : NesUnitSets(i)=0 : Next
  For a=@M(0) To @M(0)+2047 Step 16 : NesUnitSets((a>>4)&511)=1 : Next
  a=(NesStackPointer()-512)&~15
  For i=0 To 1023 Step 16 : NesUnitSets(((a+i)>>4)&511)=1 : Next
  For start=0 To 511
    run=0
    While run<sets
      If NesUnitSets((start+run)&511) : Break : EndIf
      run=run+1
    Wend
    If run=sets
      space=(@NesUnitSpace(0)+15)&~15
      NesUnitBase=space+(((start<<4)-space)&8191)
      ProcedureReturn
    EndIf
  Next
  WorkerError=22
EndProcedure
CompilerEndIf

Procedure.i LoadGame()
  Protected i.i, bank.i
  CompilerIf #NES_RUNTIME_ROM
    If NesRuntimeLoad()=0 : ProcedureReturn 0 : EndIf
    NesExtraBoard=ExtraManaged(CartMapper) : NesA12Board=ExtraA12(CartMapper)
    If CartChrRam : GuestClear(CartChr,MapChrBytes) : EndIf
    PrgBase=CartPrg : PrgBias=PrgBase-$8000 : WorkerPrgBase=PrgBase
  CompilerElse
    If NesStorageLoad()=0 : ProcedureReturn 0 : EndIf
    CartMapper=#GAME_MAPPER : CartSubmapper=#GAME_SUB
    CartPrgBanks=#GAME_VIEWS/32768 : CartChrBanks=#GAME_CHR/8192
    NesExtraBoard=ExtraManaged(CartMapper) : NesA12Board=ExtraA12(CartMapper)
    CartConflicts=#GAME_CONFLICT : CartChrRam=#GAME_CHR_RAM
    MapBattery=#GAME_BATTERY : MapFourScreen=#GAME_FOUR_SCREEN
    MapRamBytes=#GAME_RAM : MapChrRam=CartChrRam
    MapPrgBytes=#GAME_PRG : MapChrBytes=#GAME_CHR
    PpuMirroring=#GAME_MIRROR : ChrWritable=CartChrRam
    If CartChrRam : For i=0 To MapChrBytes-1 : PokeA(CartChr+i,0) : Next : EndIf
    PrgBase=CartPrg : PrgBias=PrgBase-$8000 : WorkerPrgBase=PrgBase
  CompilerEndIf
  For i=0 To 255
    PixelSpread(i)=(i&3)|(((i>>2)&3)<<8)|(((i>>4)&3)<<16)|(((i>>6)&3)<<24)
  Next
  For bank=0 To CartChrBanks-1
    NesChrWindow=CartChr+bank*8192 : Pattern=@Decoded(bank*8192)
    For i=0 To 8191 : If (i&8)=0 : PpuDecode(i) : EndIf : Next
  Next
  NesChrWindow=CartChr : Pattern=@Decoded(0)
  NesChrPairsInit()
  CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
    NesUnitPlace()
  CompilerEndIf
  CompilerIf #NES_BG_EXPANDED
    NameDescDirty=0
  CompilerEndIf
  NesTiming(#GAME_PAL)
  If CartMapper<>0 And CartMapper<>2 And CartMapper<>66 : MapperInit() : EndIf
  If WorkerError : ProcedureReturn 0 : EndIf
  CompilerIf #GAME_SAVE_BYTES>0
    CompilerIf #NES_RUNTIME_ROM
      If MapBattery : NesSaveLoad() : EndIf
    CompilerElse
      NesSaveLoad()
    CompilerEndIf
    XIncludeFile "save_restore.pmi"
  CompilerEndIf
  For i=0 To 31 : LengthTable(i)=PeekA(?LengthData+i) : Next

  For i=0 To 30 : PulseMix(i)=PeekU(?PulseData+i*2) : Next
  For i=0 To 202 : TndMix(i)=PeekU(?TndData+i*2) : Next
  For i=0 To 511 : Rgb64(i)=PeekU(?RgbData+i*2) : Next
  PpuColours()
  ProcedureReturn 1
EndProcedure

CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
ProcedureNaked.i NesMmc3IrqPending()
  ASM
    la t0, global_mapirq
    jr ra
    ld a0, 0(t0)
  EndASM
EndProcedure
CompilerEndIf

Procedure.i NesHostGuestFrame(lastFrame.i,start.i)
  Protected elapsed.i
  NesDeliveredFrame=lastFrame : HostInputPoll() : HostAudioPoll()
  CompilerIf #GAME_SAVE_BYTES>0
    If NesSavePending : NesSaveFlush() : EndIf
  CompilerEndIf
  CompilerIf #NES_RUNTIME_ROM
    CompilerIf #GAME_SAVE_BYTES>0
      If NesSavePending=0 : NesRuntimeCheckExit() : EndIf
    CompilerElse
      NesRuntimeCheckExit()
    CompilerEndIf
  CompilerEndIf
  If lastFrame=1 Or lastFrame=60 Or lastFrame=120 Or (#VERIFY_FRAME>0 And (lastFrame%60=0 Or lastFrame=#VERIFY_FRAME))
    elapsed=(LpmCpuCount()-start) & $FFFFFFFF
    LpmDebugPrint("NES FRAME "+Str(lastFrame)+" CPU "+Str(CpuCycles)+" PCM "+Str(ApuProduced)+" PC "+Str(PC)+" COUNT "+Str(elapsed))
  EndIf
  CompilerIf #NES_MEASURE_QUEUE
    If HostTelemetryEnabled And (lastFrame%60)=0
      elapsed=(LpmCpuCount()-start) & $FFFFFFFF
      LpmDebugPrint("NES LIVE "+Str(lastFrame)+" COUNT "+Str(elapsed)+" AI STARVATIONS "+Str(HostAiStarvations)+" LAST "+Str(HostAiLastStarvation)+" PCM DROPPED "+Str(HostAudioDropped))
    EndIf
  CompilerEndIf
  CompilerIf #VERIFY_FRAME>0
    If lastFrame=#VERIFY_FRAME : HostDrainCapture() : LpmDebugPrint("NES CHECKPOINT "+Str(lastFrame)) : ProcedureReturn 1 : EndIf
  CompilerEndIf
  ProcedureReturn 0
EndProcedure

CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
  XIncludeFile "mmc3_run.n64"
CompilerEndIf

Procedure RunGame()
  Protected stalls.i, lastFrame.i, start.i
  If HostBegin()=0 : LpmDebugPrint("NES display init failed") : ProcedureReturn : EndIf
  LpmDmaInit()
  CompilerIf #NES_MEASURE_QUEUE
    ASM
      la t0, global_hosttelemetryenabled
      ori t1, zero, #NES_HW_TELEMETRY
      sd t1, 0(t0)
    EndASM
  CompilerEndIf
  If LoadGame()=0 : LpmDebugPrint("NES cartridge could not fit or load") : ProcedureReturn : EndIf
  CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=0
    NesRuntimeIndexNromWaits()
  CompilerElseIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
    NesRuntimeIndexMmc3Waits()
  CompilerEndIf
  CpuReset()
  LpmDebugPrint("NES RESET "+Str(PC)+" MAPPER "+Str(CartMapper))
  start=LpmCpuCount()
  CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
    If NesRunMapper4(start) : ProcedureReturn : EndIf
  CompilerElse
    While Stopped=0 And WorkerError=0
      CompilerIf #NES_CHAIN_WINDOWS
        NesChainLimit=NesCpuHorizon
      CompilerEndIf
      CompilerIf #NES_HAS_RAM_WAITS
        NesRamCpuWindow(128,1)
      CompilerElse
        CompilerIf #NES_PREDICTABLE_IRQ
          CpuRun(128)
        CompilerElse
          CpuRun(MapperCpuBudget())
        CompilerEndIf
      CompilerEndIf
      CompilerIf #NES_CHAIN_WINDOWS
        NesChainLimit=-1
      CompilerEndIf
      If CpuCycles>NesStatusHorizon And CpuCycles>NesCpuHorizon
        NesAdvanceCpuTime(CpuCycles)
        CompilerIf #NES_PREDICTABLE_IRQ
          NesSetCpuHorizon(CpuCycles)
        CompilerEndIf
      EndIf
      stalls=WorkerDmcCycles-NesSeenDmc
      While stalls>0
        NesSeenDmc=WorkerDmcCycles : CpuCycles=CpuCycles+stalls
        NesAdvanceCpuTime(CpuCycles) : stalls=WorkerDmcCycles-NesSeenDmc
      Wend
      If WorkerNmi<>NesSeenNmi
        NesSeenNmi=WorkerNmi : CpuInterrupt($FFFA)
      ElseIf (WorkerIrq|MapIrq)<>0 And FI=0
        CpuInterrupt($FFFE)
      EndIf
      If WorkerFrames<>lastFrame
        lastFrame=WorkerFrames
        If NesHostGuestFrame(lastFrame,start) : ProcedureReturn : EndIf
      EndIf
    Wend
  CompilerEndIf
  LpmDebugPrint("NES STOP "+Str(BadOpcode)+" PC "+Str(PC)+" WORKER "+Str(WorkerError))
EndProcedure
RunGame()
Repeat : ForEver
