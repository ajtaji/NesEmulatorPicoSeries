; modules/mmc1_cold.n64 - the MMC1 (mapper 1) module's COLD part, assembled in the cold slot (unit/cold_slot.n64): its
; entry table (the layout every module's cold part opens with, modules/mmc3_cold.n64) and its power-on.
;
; nes_cold_init - WHAT: MMC1's own power-on, run by LoadGame (NesModuleInit) right after the shared core's MapperInit.
; HOW: MapperInit (anvil/mappers.pi4, compiled, every mapper's) has already set every field MMC1 reads to its power-on
; value - MapShift = $10, MapControl = $0C, MapChr0 = MapChr1 = MapPrgReg = 0, MapLastWrite = -10, MapRamEnable = 1,
; MapRamProtect = 0, the slots unmapped, MapRam / MapCiram cleared, the header's mirroring, ExtraMapperInit - and then
; published MMC3's banks (its MapperUpdate is MMC3's in the unit build); mmc1_update (modules/mmc1.n64) republishes
; every PRG slot, CHR slot and the mirroring from MMC1's registers, so the state the guest starts from is MMC1's,
; exactly the compiled MMC1's (MapperInit, then its own MapperUpdate). In / out: nothing; clobbers what mmc1_update may.
; THE PLAIN TWIN: MapperUpdate()   ; (MMC1's, mmc1.n64), after MapperInit()
  ASM
nes_cold_init:                      ; +0
    b mmc1_cold_init
    nop
nes_cold_reserved:                  ; +8
    jr ra
    nop
nes_cold_maptable:                  ; +16: no register handler table (MMC1 decodes its port in mmc1_e_write)
    .word 0, 0, 0, 0, 0, 0, 0, 0
nes_cold_moddata:                   ; +48: no module data (256 zero bytes, copied into NesUnitData at load all the same)
    .space 256
mmc1_cold_init:
    j mmc1_update                   ; every mapping from the power-on registers (modules/mmc1.n64), a tail jump
    nop
  EndASM
