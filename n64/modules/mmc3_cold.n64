; modules/mmc3_cold.n64 - the MMC3 (mapper 4) module's COLD part: what of the MMC3 runs once at load or (almost) never,
; assembled in the cold slot (unit/cold_slot.n64), the hot unit's cold end (the mapper-modules design note, section 2).
;
; WHAT: the cold slot's entry table (its first 48 bytes; every module's cold part opens with one in this layout):
;   +0  nes_cold_init      the module's power-on, run by LoadGame (NesModuleInit) right after the shared core's
;                          MapperInit (compiled, unchanged: every mapper's state power-on, then MMC3's MapperUpdate,
;                          mapper_mmc3_update.n64); may clobber what a compiled call may. MMC3: nothing more (returns).
;   +8  nes_cold_reserved  (no entry yet: returns)
;   +16 nes_cold_maptable  the register write's 8-word handler table (data): NesUnitPlace copies it into NesUnitData at
;                          load (unitplace.n64), where mmc3_e_write's dispatch reads it (C7, design note N.49).
;   +48 nes_cold_moddata   256 bytes of the module's data, copied into NesUnitData + #NES_U_MODDATA at load
;                          (unitplace.n64): MMC3's sprite-form table, which the A12 walk reads there.
; then the A12 walk's cold paths and its sprite-form table (mmc3_a12_cold.n64, unit/a12_cold.n64 as it was), and the
; register paths SMB3 never runs (moved unchanged from unit/cold.n64: select, mirroring, RAM protect).
;
; THE CONTRACT (as the hot part's, modules/mmc3.n64): entered only through the table; any transfer inside the two
; slots; out of them only j / jal (build.py, check_mapper_slot, decodes every word of both parts).
; THE PLAIN TWIN of each piece is beside it (the moved pieces' in their text); the table is the C7 table unchanged.
  ASM
nes_cold_init:
    jr ra                           ; nothing more: LoadGame's MapperInit (the shared core's) is MMC3's power-on
    nop
nes_cold_reserved:
    jr ra
    nop
nes_cold_maptable:                  ; $8000 select, $8001 data, $A000 mirroring, $A001 protect, $C000 latch,
                                    ; $C001 reload, $E000 disable / acknowledge, $E001 enable
    .word mmc3_write_select, mmc3_write_data, mmc3_write_mirror, mmc3_write_protect
    .word mmc3_write_latch, mmc3_write_reload, mmc3_write_ack, mmc3_write_enable
nes_cold_moddata:                   ; +48: the module's data, 256 bytes, copied into NesUnitData+#NES_U_MODDATA at load
mmc3_form_data:                     ; (data, not code: build.py's slot check skips it, to mmc3_form_data_end)
a12_sprite_form:
    ; a12_sprite_form (moved here from mmc3_a12_cold.n64 unchanged; the walk reads the copy in NesUnitData, whose
    ; D-cache sets NesUnitPlace chooses): one byte per S = MapSpriteBits (bit j = slot j fetches at $1000):
    ; bits 0-2 j0 = the lowest set bit; bits 3-5 k = the highest set bit of S & $7F (0 when none);
    ; bits 6-7 runs - 1 = the maximal runs of set bits less one. Byte 0 (S = 0) is not read.
    ; Written by:  for S: j0 = ctz(S); k = msb(S & 127); runs = rises of S read from bit 0 up.
    .word 0x00000908, 0x12501110, 0x1B585958, 0x1A581918, 0x24606160, 0x62A06160, 0x23606160, 0x22602120
    .word 0x2D686968, 0x6AA86968, 0x6BA8A9A8, 0x6AA86968, 0x2C686968, 0x6AA86968, 0x2B686968, 0x2A682928
    .word 0x36707170, 0x72B07170, 0x73B0B1B0, 0x72B07170, 0x74B0B1B0, 0xB2F0B1B0, 0x73B0B1B0, 0x72B07170
    .word 0x35707170, 0x72B07170, 0x73B0B1B0, 0x72B07170, 0x34707170, 0x72B07170, 0x33707170, 0x32703130
    .word 0x07404948, 0x52905150, 0x5B989998, 0x5A985958, 0x64A0A1A0, 0xA2E0A1A0, 0x63A0A1A0, 0x62A06160
    .word 0x6DA8A9A8, 0xAAE8A9A8, 0xABE8E9E8, 0xAAE8A9A8, 0x6CA8A9A8, 0xAAE8A9A8, 0x6BA8A9A8, 0x6AA86968
    .word 0x36707170, 0x72B07170, 0x73B0B1B0, 0x72B07170, 0x74B0B1B0, 0xB2F0B1B0, 0x73B0B1B0, 0x72B07170
    .word 0x35707170, 0x72B07170, 0x73B0B1B0, 0x72B07170, 0x34707170, 0x72B07170, 0x33707170, 0x32703130
mmc3_form_data_end:
  EndASM
  XIncludeFile "mmc3_a12_cold.n64"

; ---- the MMC3 register paths that SMB3 never runs (C4, design note N.46b: 0 cycles a guest frame in the record
; replay's profile), moved with u_mapperwrite's dispatch from mmc3_registers.n64 unchanged; reached through its
; table (the cold slot's nes_cold_maptable). In: a0 address, a1 value. Each leaves by a tail jump or jr ra to u_mapperwrite's caller. ----
  ASM
mmc3_write_select:                  ; $8000: the bank select; a change of the PRG / CHR mode bits remaps
    la t0, global_mapselect
    ld t1, 0(t0)
    sd a1, 0(t0)
    xor t1, t1, a1
    andi t1, t1, 0xC0
    beqz t1, mmc3_write_done        ; only the register index changed
    nop
    j mapperupdate
    nop
mmc3_write_mirror:                  ; $A000: vertical (0) or horizontal (1), not with four-screen VRAM
    la t0, global_mapfourscreen
    ld t1, 0(t0)
    bnez t1, mmc3_write_done
    andi a0, a1, 1
    j mappermirror
    xori a0, a0, 1
mmc3_write_protect:                 ; $A001: bit 7 enables the work RAM, bit 6 protects it
    la t0, global_mapramenable
    srl t1, a1, 7
    srl t2, a1, 6
    andi t1, t1, 1
    andi t2, t2, 1
    sd t1, 0(t0)
    jr ra
    sd t2, global_mapramprotect-global_mapramenable(t0)
  EndASM
