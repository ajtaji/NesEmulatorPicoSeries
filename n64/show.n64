; show.n64 - N5: THE RSP BAND EMITTER'S PICTURE IS THE SHOWN ONE (design note, section N.22).
;
; The PPU state machine (unit/ppu.n64) cuts the picture into bands and writes a record for each at its close
; (unit/ppu_cold.n64, ppu_cut_close). Here, at every close: the band's inputs are made safe for the RSP's DMA (the
; name tables COPIED into a band-input slot - the guest may write them before the job runs, and a dirty cache line
; can reach RDRAM by any eviction - the record and its OAM snapshot written back) and the band's job queued for the
; RSP program rspband.n64rsp (unchanged from the checking build: one NES_RSP_SETUP naming this band's slot and this
; frame's areas, one NES_RSP_BAND, one fence). THE RSP HANDS THE FRAME'S WORDS TO THE RDP ITSELF (design note N.62):
; each band job at its end once the frame is attached; the CPU only attaches a frame (its buffer and
; the HAND step, once the SYNC_FULL before is through - LpmRdpSyncFullDone - and a buffer is free) and detaches it (the
; HAND step for the rest, the fallback lines, the black borders and crop (NesShowBorders), the SYNC_FULL that shows
; it), at its check points: a band's close, line
; 240 (NesShowFrameEnd), every 16 visible lines (DisplayWaitLine, host.n64), the frame's wrap (NesHostGuestFrame).
; Nothing waits for the RDP at line 240: a frame set is reused only once the frame that used it last is drawn, looked
; at - and slept for if need be - at the set's first write (NesShowAcquire).
;
; WHAT IS KEPT PER FRAME, IN TWO SETS (the show's frame parity, NesShowCur): the RSP's frame area (4,096 doublewords
; and its status), its TLUT blocks (32 x 256), its fallback lines' table. The fallback rows (CI8, 256 bytes, in LinePixels,
; each with a 64-byte palette) are a ring of 240 shared by the frames, a row reused once its frame is drawn. The RDP draws frame N while frame N+1 is emulated; frame N+2 takes N's set only once N is drawn
; (NesShowFrameEnd's guard).
;   set 0's area: #NES_CART_LOW_END (+0 the words, +$8000 the status); both TLUT sets at +$8100 (the 64 KB to the
;   library's crash display is free in its map); the program's copy at $80276400 (N.62: after the AI ring, below the
;   cartridge arena). Set 1's area, the four band-input
;   slots, the fallback palettes: below the stack (NesShowArea1, NesShowNtSpace, NesFbPalSpace).
;
; THE FALLBACK LINES (the lines no record draws; design note N.60 made split lines records of their own - rspband.n64,
; NesSegFirst / NesSegDraw / NesSegPublish - and the sprite-priority quirk the bands' own): a split line when the
; frame's records or segment entries are used up (NesFbCatchUp), and the lines of a band that cannot be recorded
; (decided at the line's start, ppu_live_sprites / ppu_live_empty in the cold part). The old renderer's own assembly draws each into
; a slot (NesFbSlot), NesFbPublish writes the row and the line's palette back at its dot 256, and the frame's list
; (NesShowFallback) copies the slots into the picture after the last band, as the old blit drew each line.
;
; THE CHECKING BUILD (#NES_SHOW_CHECK, --show-check): every frame is finished at its end, the RDP waited for, and
; the shown picture's KEPT pixels hashed (NesShowHashFb: the NES columns #NES_CROP_X .. 255 - #NES_CROP_X, lines
; #NES_CROP_Y .. 239 - #NES_CROP_Y), printed "NES PIC frame hash fallback-lines", and everything else of the buffer
; checked black (NesShowBorderAsm: a frame with any other colour there printed "NES PIC BORDER frame value"). With
; --old-show the same hash is taken of the old renderer's picture (NesShowHashRef: the CI8 rows and the per-line
; palettes, the pixel the old blit writes) at line 239: the reference.
XIncludeFile "rspband_ids.pmi"

; THE PICTURE ON THE SCREEN (2026-11-26). The buffer is 320 x 240 and the NES picture's 256 columns sit at x 32-287.
; EVERYTHING ELSE IS BLACK ON EVERY PICTURE SHOWN: the borders x 0-31 and 288-319 and the crop below are filled black
; by NesShowBorders, in the picture's own list AFTER the RSP's words and before the SYNC_FULL that shows it - so no
; buffer of the three ever goes on screen with anything there but black (LpmDisplayInit makes all three black first;
; the only other picture is NesShowStopped's red screen). THE CROP: a CRT's overscan hid the picture's outer columns
; (the NES's own left-column mask is 8 wide); #NES_CROP_X columns each side and #NES_CROP_Y lines top and bottom are
; drawn black. A multiple of 4 (the checking hash reads 8 bytes at a time), 0 .. 64; 0 .. 112.
#NES_CROP_X = 8
#NES_CROP_Y = 0
CompilerIf #NES_CROP_X < 0 Or #NES_CROP_X > 64 Or (#NES_CROP_X & 3) <> 0 Or #NES_CROP_Y < 0 Or #NES_CROP_Y > 112
  CompilerError "show.n64: #NES_CROP_X must be 0 .. 64 and a multiple of 4, #NES_CROP_Y 0 .. 112"
CompilerEndIf

CompilerIf #NES_RDP_SHOW
ASM
  .rspfile "rspband.n64rsp"
EndASM

#NES_SHOW_WORDS = 4096                  ; a frame area's doublewords (the program's limit; the status after them)
#NES_SHOW_TLUT_AT = $8100               ; the two TLUT sets, 8 KB each, from #NES_CART_LOW_END
#NES_SHOW_PROG = $FFFFFFFF80276400     ; the program's copy (its file + 128 bytes; N.62): after the AI ring's end
#NES_SHOW_PROG_END = $FFFFFFFF80281000 ; ($80272000 + 16,928, host.n64) and below the cartridge arena (storage.n64)
#NES_FB_ROWS = 240                      ; the fallback rows' ring: a frame needs at most one a line

Global Dim NesShowArea1Space.a(#NES_SHOW_WORDS*8+16+16)
; the RSP's name-table image L (rspband.n64, N.66: on Nt's D-cache sets), the split lines' segment pool 0 in the 4 KB
; after it, the write log's ring 8 KB after L, pool 1 after the ring (each pool written only uncached)
Global Dim NesShowNtSpace.a(2*8192+8192)
Global Dim NesFbPalSpace.u(#NES_FB_ROWS*32+8)  ; a row's palette, 64 bytes
Global Dim NesFbLine.i(2*#NES_FB_ROWS)   ; each set's fallback lines, in order
Global Dim NesShowOamKeep.a(256+8)

Global NesShowSetupP.i                 ; the frame set the RSP program's areas were last set up for
Global NesShowProg.i, NesShowCur.i, NesShowBusy.i, NesShowNtBase.i
Global Dim NesShowArea.i(2)             ; KSEG1: the frame areas
Global Dim NesShowTlut.i(2)             ; KSEG1: the TLUT sets
Global Dim NesShowBands.i(2)            ; band jobs queued (the RSP's band index of the next)
Global Dim NesShowFence.i(2)            ; the fence after the last of them
Global Dim NesShowEnded.i(2)            ; the frame's line 240 has passed
Global Dim NesShowDone.i(2)             ; handed (or not shown, counted)
Global Dim NesShowFb.i(2)               ; the buffer it is drawn into, once attached
Global Dim NesShowShown.i(2)            ; the buffer it was shown in (0: not shown)
Global Dim NesShowTicket.i(2)           ; lpm_rdp_frames_sent after its SYNC_FULL
Global Dim NesShowFrameNo.i(2)          ; WorkerFrames at its line 240
Global Dim NesShowAtt.i(2)              ; attached: its buffer's attach and the RSP's HAND step queued (N.62)
Global Dim NesShowFree.i(2)             ; the set taken by the current frame: the frame before that used it is drawn
Global NesShowNoFbVi.i                  ; the VI count at the last look that found no buffer free
Global NesShowFreeCur.i                 ; NesShowFree of the current set, for the unit's assembly (NesSegFirst)
; the frame that used each set last (saved when the set is taken again), until the set's first write: its ticket, what
; its record and check need (N.62: its set is reused only once it is drawn - waited for there, not at line 240)
Global Dim NesShowPrevTicket.i(2)
Global Dim NesShowPrevShown.i(2)
Global Dim NesShowPrevFrameNo.i(2)
Global Dim NesShowPrevFbN.i(2)
Global Dim NesShowPrevBands.i(2)
Global Dim NesFbCountP.i(2)
Global Dim NesFbOverP.i(2)
Global Dim NesFbFirstP.i(2)              ; its first row in the ring
Global Dim NesShowRecFence.i(#NES_U_BANDMAX)   ; each record's last job
; the current frame's fallback slots, as the unit's assembly reads them (NesFbSlot, NesFbPublish)
Global NesFbFirst.i, NesFbGuard.i, NesFbHead.i
Global NesFbN.i, NesFbOver.i, NesFbRowBase.i, NesFbPalBase.i, NesFbLineBase.i, NesFbRows.i, NesFbPals.i
; statistics (NesShowReport): [0] frames shown [1] not shown (words or slots over) [2] shown over (after a drain)
; [3] waits for a record or slot [4] drains [5] fallback lines [6] most in a frame [7] split lines [8] lost bands
; [9] band-close ticks (Count) [10] bands [11] most ticks a band [12] RSP clocks [13] most a frame [14] coalesced
Global Dim NesShowStat.i(16)
CompilerIf #NES_SHOW_CHECK
  Global NesShowHash.i
  Global NesShowBorder.i, NesShowBorderBad.i   ; the pixels outside the kept columns ORed; frames with any not black
  Global Dim NesShowChr.i(3)            ; a CHR-RAM row write's pair word and empty-row byte: start, ticks, writes
CompilerEndIf
CompilerIf #NES_CONSOLE_RECORD
  ; THE CONSOLE RECORD'S WORK SPLIT (console_record.n64, version 3): Count ticks and counts since the power-on, each
  ; part where it runs - 0 band closes (NesShowBand), 1 fallback lines (NesFbCatchUp and the unit's timed calls
  ; below), 2 the fallback list (NesShowFallback), 3 the hand-over (NesShowPoll, NesShowFrameEnd, NesShowDrain), 4
  ; the APU timing (u_apuadvance, unit/apu.n64), 5 / 6 its calls / of them the segment path (a frame-sequencer step
  ; or a $4017 reset inside the interval), 7 DMC bytes fetched (u_apudmcfetch), 8 PPU bus writes, 9 the sound's
  ; synthesis (apusynth.n64, nes_syn_timed); 10-12 the timed advance's own scratch. Read by NesRecFrame once a frame
  ; (the differences are the frame's parts).
  Global Dim NesRecT.i(16)
  Declare NesRecPicture(frame.i, fb.i, fbl.i)   ; the record's picture hashes (console_record.n64)
CompilerEndIf

; ---- the unit's assembly ways in (cold paths) ----

; NesFbSlot - the current line becomes a fallback line: the next row of the ring (#NES_FB_ROWS rows of 256 bytes,
; LinePixels, each with a 64-byte palette). IN: nothing (PpuLine, NesUnitBase). OUT: U_LIVE = the row (KSEG0,
; 256-aligned) and NesLineRow = it (the old renderer draws there), the line in the set's line table, NesFbN + 1.
; The frame's rows follow the frame before's in the ring (NesFbFirst); that frame's rows are free once the RDP has
; drawn it. NesFbGuard = its row count while that is not known: when this frame's next row would reach them, the
; frame before is finished and waited for first (NesFbWaitCall - in practice never: a frame needs 240 - its
; predecessor's rows for that). So no fallback line is ever left undrawn. CLOBBERS t0-t3, v0 only.
ProcedureNaked NesFbSlot()
  ASM
    la t0, global_nesfbn
    ld t1, 0(t0)                     ; n, this frame's rows so far
    la t2, global_nesfbguard
    ld t2, 0(t2)
    beqz t2, nes_fb_slot_free
    addiu t3, zero, #NES_FB_ROWS
    subu t3, t3, t2
    sltu t3, t1, t3
    bnez t3, nes_fb_slot_free        ; n < rows - the frame before's: row n is free
    nop
    daddiu sp, sp, -16
    sd ra, 0(sp)
    jal nesfbwaitcall                ; the frame before drawn (every register kept), then NesFbGuard = 0
    nop
    ld ra, 0(sp)
    daddiu sp, sp, 16
    la t0, global_nesfbn
    ld t1, 0(t0)
nes_fb_slot_free:
    daddiu t2, t1, 1
    sd t2, 0(t0)                     ; NesFbN + 1
    la t0, global_nesfblinebase
    ld t0, 0(t0)
    dsll t2, t1, 3
    daddu t0, t0, t2
    la t3, global_ppuline
    ld t3, 0(t3)
    sd t3, 0(t0)                     ; the row's line
    la t0, global_nesfbfirst
    ld t0, 0(t0)
    daddu t1, t1, t0                 ; the ring's row: (first + n) mod #NES_FB_ROWS
    sltiu t2, t1, #NES_FB_ROWS
    bnez t2, nes_fb_slot_row
    nop
    daddiu t1, t1, -#NES_FB_ROWS
nes_fb_slot_row:
    la t0, global_nesfbrowbase
    ld t0, 0(t0)
    dsll t2, t1, 8
    daddu t0, t0, t2                 ; the row
    la t3, global_neslinerow
    sd t0, 0(t3)
    la t3, global_nesunitbase
    ld t3, 0(t3)
    jr ra
    sd t0, #NES_U_LIVE(t3)
  EndASM
EndProcedure
; NesFbPublish - a fallback line's dot 256 (unit/ppu.n64, ppu_adv_publish): its slot's row (256 bytes, drawn
; through the cache) written back, and RgbPal - the palette the old blit used for the line, captured by the old
; publish at this same moment - copied into the slot's palette (64 bytes) and written back. CLOBBERS a0, t0-t3.
ProcedureNaked NesFbPublish()
  ASM
    la t0, global_nesunitbase
    ld t0, 0(t0)
    ld a0, #NES_U_LIVE(t0)           ; the row
    cache 0x19, 0(a0)                ; Hit_Writeback_D, its 16 lines
    cache 0x19, 16(a0)
    cache 0x19, 32(a0)
    cache 0x19, 48(a0)
    cache 0x19, 64(a0)
    cache 0x19, 80(a0)
    cache 0x19, 96(a0)
    cache 0x19, 112(a0)
    cache 0x19, 128(a0)
    cache 0x19, 144(a0)
    cache 0x19, 160(a0)
    cache 0x19, 176(a0)
    cache 0x19, 192(a0)
    cache 0x19, 208(a0)
    cache 0x19, 224(a0)
    cache 0x19, 240(a0)
    la t1, global_nesfbrowbase
    ld t1, 0(t1)
    dsubu t2, a0, t1
    dsrl t2, t2, 2                   ; slot x 64
    la t3, global_nesfbpalbase
    ld t3, 0(t3)
    daddu t3, t3, t2                 ; the slot's palette (16-byte aligned)
    la t0, global_rgbpal
    ld t1, 0(t0)
    ld t2, 8(t0)
    sd t1, 0(t3)
    sd t2, 8(t3)
    ld t1, 16(t0)
    ld t2, 24(t0)
    sd t1, 16(t3)
    sd t2, 24(t3)
    ld t1, 32(t0)
    ld t2, 40(t0)
    sd t1, 32(t3)
    sd t2, 40(t3)
    ld t1, 48(t0)
    ld t2, 56(t0)
    sd t1, 48(t3)
    sd t2, 56(t3)
    cache 0x19, 0(t3)
    cache 0x19, 16(t3)
    cache 0x19, 32(t3)
    jr ra
    cache 0x19, 48(t3)
  EndASM
EndProcedure

; NesLiveDraw / NesLivePublish - the unit's calls on a line it does not leave to the bands (U_LIVE not 0): a split
; line drawn by a record of its own (U_LIVE = 1, design note N.60: rspband.n64's NesSegDraw / NesSegPublishCall) or a
; fallback line of the old path (U_LIVE = its slot: NesRenderTo / NesFbPublish). Each clobbers no more than the old
; path's routine does (a0 = the end dot for the draw).
ProcedureNaked NesLiveDraw()
  ASM
    la t0, global_nesunitbase
    ld t0, 0(t0)
    ld t0, #NES_U_LIVE(t0)
    addiu t1, zero, 1
    bne t0, t1, nes_live_draw_old
    nop
    j nessegdraw
    nop
nes_live_draw_old:
    j nesrenderto
    nop
  EndASM
EndProcedure
ProcedureNaked NesLivePublish()
  ASM
    la t0, global_nesunitbase
    ld t0, 0(t0)
    ld t0, #NES_U_LIVE(t0)
    addiu t1, zero, 1
    bne t0, t1, nes_live_publish_old
    nop
    j nessegpublishcall
    nop
nes_live_publish_old:
    j nesfbpublish
    nop
  EndASM
EndProcedure

CompilerIf #NES_CONSOLE_RECORD
; THE CONSOLE RECORD'S TIMED CALLS (console_record.n64, the work split's part 1). In the record build only, the unit
; calls these instead of the three renderer routines it runs on a fallback line - the line's spans (NesRenderTo, at
; ppu_adv_draw), its publish (NesFbPublish, ppu_adv_publish) and its sprite row (NesMmc3DrawSprites, ppu_live_on):
; the same jal, another target, so the unit's size and layout do not change. Each one: the return address and Count
; at entry kept in a 16-byte frame, the routine called with every argument register as the unit set it (only t0 and
; the stack are touched before the call), then Count again and the difference (the 32-bit Count's wrap taken by the
; zero-extension: a call never lasts 2^32 ticks) added to NesRecT(1). After the call only t0-t2 are used: each routine
; clobbers at least those itself (NesFbPublish: a0, t0-t3; the others are compiled-convention callers), so the unit
; sees no register it did not already lose.
ProcedureNaked NesRecRenderTo()          ; a0 = the end dot, as NesRenderTo
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    mfc0 t0, $9                      ; Count at entry
    sd t0, 8(sp)
    jal neslivedraw
    nop
    j nes_rec_fb_tail
    nop
  EndASM
EndProcedure
ProcedureNaked NesRecFbPublish()         ; as NesFbPublish
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    mfc0 t0, $9
    sd t0, 8(sp)
    jal neslivepublish
    nop
    j nes_rec_fb_tail
    nop
  EndASM
EndProcedure
ProcedureNaked NesRecDrawSprites()       ; a0 = line, a1 = count, a2 = PPUMASK, as NesMmc3DrawSprites
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    mfc0 t0, $9
    sd t0, 8(sp)
    jal nesmmc3drawsprites
    nop
nes_rec_fb_tail:                     ; the three wrappers' common end: the call's ticks into NesRecT(1)
    mfc0 t1, $9                      ; Count after the call
    ld t0, 8(sp)
    subu t1, t1, t0                  ; ticks (low 32 bits) ...
    dsll32 t1, t1, 0
    dsrl32 t1, t1, 0                 ; ... zero-extended
    la t0, global_nesrect
    ld t2, 8(t0)                     ; NesRecT(1), the fallback lines' ticks
    daddu t2, t2, t1
    sd t2, 8(t0)
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure
; A part's ticks since t (a LpmCpuCount reading) into NesRecT(k). Assembly (the record's instrument, called at every
; timed part); THE PLAIN TWIN:  NesRecT(k) + ((LpmCpuCount() - t) & $FFFFFFFF). CLOBBERS t0-t2 only.
ProcedureNaked NesRecAdd(k.i, t.i)
  ASM
    mfc0 t1, $9
    nop
    dsubu t1, t1, a1
    dsll32 t1, t1, 0
    dsrl32 t1, t1, 0                 ; (Count - t) & $FFFFFFFF
    la t0, global_nesrect
    dsll t2, a0, 3
    daddu t0, t0, t2
    ld t2, 0(t0)
    daddu t2, t2, t1
    jr ra
    sd t2, 0(t0)                     ; (delay slot) NesRecT(k)
  EndASM
EndProcedure
CompilerEndIf

; NesShowRecWriteback(rec) - the band record's 96 bytes and its OAM snapshot's 256 to RDRAM (Hit_Writeback_D: a
; dirty line written, every line stays valid) - as rspband.n64's NesBandWriteback without the name tables.
; CLOBBERS t0, t1.
ProcedureNaked NesShowRecWriteback(rec.i)
  ASM
    sll a0, a0, 0
    cache 0x19, 0(a0)
    cache 0x19, 16(a0)
    cache 0x19, 32(a0)
    cache 0x19, 48(a0)
    cache 0x19, 64(a0)
    cache 0x19, 80(a0)
    ld t0, #NES_B_OAM(a0)            ; the snapshot: NesOamBase + index x 256
    dsll t0, t0, 8
    la t1, global_nesoambase
    ld t1, 0(t1)
    daddu t0, t0, t1
    daddiu t1, t0, 256
nes_show_rec_oam:
    cache 0x19, 0(t0)
    daddiu t0, t0, 16
    bne t0, t1, nes_show_rec_oam
    nop
    jr ra
    nop
  EndASM
EndProcedure

; The cold part's ways into compiled code: each keeps every register its caller may hold (a0-a7, t0-t3, t8, t9, v0,
; v1, hi / lo), as rspband.n64's NesRspBandCall does. NesShowBandCall: t2 = the record (ppu_cut_close).
ProcedureNaked NesShowBandCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nesshowband
    move a0, t2
    j nes_show_restore
    nop
  EndASM
EndProcedure

; NesFbCatchUpCall: a split line's first cut (ppu_cut_split).
ProcedureNaked NesFbCatchUpCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nesfbcatchup
    nop
    j nes_show_restore
    nop
  EndASM
EndProcedure

; NesFbWaitCall: the fallback rows' ring has reached the frame before's rows (NesFbSlot).
ProcedureNaked NesFbWaitCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nesfbwait
    nop
    j nes_show_restore
    nop
  EndASM
EndProcedure

; THE DRAIN CALL'S CHAIN PINNED (design note N.73): the layout places NesShowDrainCall at the head of a chain the
; compiler builds from the call graph - NesChrPairAt, the display's interrupt and LpmDisplayTryGet, MapCopy, MapperChr,
; MapperUpdate, MapperMirror - whose place moved with the code before it; on one build MapperChr landed on the unit's
; APU sets (apu_advance_body, apu_publish_frame: +118 K I-misses, +1.7 K cycles a frame). NesShowDrainPin pads to the
; next address that is 2644 modulo 16384, the chain's place in the record run before (MapperChr on rel. sets 155-162,
; met by no unit line). It runs on into NesShowDrainCall; nothing enters it.
ProcedureNaked NesShowDrainPin()
  ASM
    .alignabs 16384, 2644
  EndASM
EndProcedure
; NesShowDrainCall: a CHR-RAM row write while the show is busy (chrpairs.n64, NesChrPairAt). Then the common tail
; that puts every register back.
ProcedureNaked NesShowDrainCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nesshowdrain
    nop
nes_show_restore:
    ld t0, 136(sp)
    mthi t0
    ld t0, 144(sp)
    mtlo t0
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld a3, 32(sp)
    ld a4, 40(sp)
    ld a5, 48(sp)
    ld a6, 56(sp)
    ld a7, 64(sp)
    ld t0, 72(sp)
    ld t1, 80(sp)
    ld t2, 88(sp)
    ld t3, 96(sp)
    ld t8, 104(sp)
    ld t9, 112(sp)
    ld v0, 120(sp)
    ld v1, 128(sp)
    jr ra
    daddiu sp, sp, 176
  EndASM
EndProcedure

Declare NesShowSet(p.i)
Procedure.i NesShowInit()
  Protected need.i, space.i, a1.i
  If (@Nt(0) & 7) Or (@Rgb64(0) & 7) Or (NesChrMaskBase & 7)
    LpmDebugPrint("NES SHOW REFUSED: an input not 8-byte aligned for the RSP's DMA") : ProcedureReturn 0
  EndIf
  need = LpmCartFileLen(1) + 128
  If need > #NES_SHOW_PROG_END - #NES_SHOW_PROG
    LpmDebugPrint("NES SHOW REFUSED: the RSP program's file is " + Str(need - 128) + " bytes") : ProcedureReturn 0
  EndIf
  a1 = (@NesShowArea1Space(0) + 15) & ~15
  NesShowArea(0) = (#NES_CART_LOW_END & $1FFFFFFF) | $A0000000
  NesShowArea(1) = (a1 & $1FFFFFFF) | $A0000000
  NesShowTlut(0) = ((#NES_CART_LOW_END + #NES_SHOW_TLUT_AT) & $1FFFFFFF) | $A0000000
  NesShowTlut(1) = NesShowTlut(0) + #NES_U_BANDMAX * 256
  NesShowNtBase = @NesShowNtSpace(0) + (((@Nt(0) & ~15) - @NesShowNtSpace(0)) & 8191)   ; KSEG0, Nt's sets
  NesFbRows = (@LinePixels(0) + 255) & ~255
  NesFbPals = (@NesFbPalSpace(0) + 15) & ~15
  ; no stale cached line of what the RSP and the RDP read uncached may land on it later
  LpmCacheWritebackInvalidateData(#NES_CART_LOW_END, #NES_SHOW_TLUT_AT + 2 * #NES_U_BANDMAX * 256)
  LpmCacheWritebackInvalidateData(a1, #NES_SHOW_WORDS * 8 + 16)
  LpmCacheWritebackInvalidateData(@NesShowNtSpace(0), 2 * 8192 + 8192)
  NesNtInit(NesShowNtBase)              ; the RSP's name-table image and the write log's ring (rspband.n64, N.66)
  LpmCacheWritebackData(@Rgb64(0), 1024)
  space = #NES_SHOW_PROG
  NesShowProg = LpmRspqProgram(LpmCartFile(1), space)
  If NesShowProg = 0 : LpmDebugPrint("NES SHOW REFUSED: LpmRspqProgram") : ProcedureReturn 0 : EndIf
  NesShowDone(1) = 1                    ; no frame before the first
  NesShowEnded(1) = 0
  NesShowSetupP = -1 : NesShowNoFbVi = -1
  NesSegInit(NesShowNtBase)
  NesShowSet(0)
  CompilerIf #NES_SHOW_CHECK
    NesShowChr(1) = 0 : NesShowChr(2) = 0 ; (the load's own row writes are not the guest's)
  CompilerEndIf
  CompilerIf #VERIFY_FRAME > 0
    LpmDebugPrint("NES SHOW: the RSP program " + Str(need - 128) + " bytes; set 1's area $" + Hex(a1 & $FFFFFFFF))
  CompilerEndIf
  ProcedureReturn 1
EndProcedure

Declare NesShowAcquire()
Declare NesShowPollE(wait.i, early.i)
; NesShowBand(rec) - THE BAND'S CLOSE: its inputs made safe for the RSP's DMA and its job queued. Documented VR4300
; assembly (the owner's order: the emulator's glue in assembly; design note N.66, which also removed its 4 KB copy).
; WHAT, in order (the plain twin, the compiled procedure it replaces less the copy):
;   p = NesShowCur : If NesShowProg = 0 : ProcedureReturn : EndIf
;   If NesShowFreeCur = 0 : NesShowAcquire() : EndIf        ; the set's first write: its last frame drawn (N.62)
;   t0 = Count : idx = (rec - NesBandBase) / 96
;   f = NesShowRecFence(idx) : If f And LpmRspqFenceDone(f) = 0 : LpmRspqWait(f) : NesShowStat(3) + 1 : EndIf
;   reads = PPUMASK bit 3 of the record And it is not a split line's (+56 = 0)   ; the job reads the image (N.66)
;   NesNtLogBand(rec, reads) : NesShowRecWriteback(rec)
;   t = (Count - t0) & $FFFFFFFF : NesShowStat(9) + t : NesShowStat(10) + 1 : NesShowStat(11) = max
;   If NesShowSetupP <> p : NesShowSetupCmd(p) : EndIf
;   b = NesShowBands(p)
;   LpmRspqCmd(NesShowProg, #NES_RSP_BAND, rec & $1FFFFFFF, (NesOamBase + oam index x 256) & $1FFFFFFF, b | p << 8)
;   f = LpmRspqFence() : NesShowRecFence(idx) = f : NesShowFence(p) = f : If reads : NesNtLogQueued(f) : EndIf
;   NesShowBands(p) = b + 1 : NesShowBusy = 1 : LpmRspqFlush()
;   (the console record: NesRecAdd(0, t0))
;   If NesShowAtt(p) = 0 : NesShowPollE(0, 1) : EndIf       ; attached as early as it can be (N.62)
; HOW: the values that live across the calls in s0-s5 (kept on the stack: s0 rec, s1 p, s2 Count at the start,
; s3 idx x 8, s4 reads, s5 b); everything else is loaded where used. The library's command goes through its
; naked LpmRspqCmdCall (a0-a4); the other calls are compiled procedures (they keep s0-s7). idx = (x x 683) >> 16
; for x = rec - NesBandBase = 96 idx: exact for idx < 2048 (683 / 65536 = 1 / 96 + 1 / 196,608). The record is
; 16-byte aligned (its 6 lines). CLOBBERS what a compiled call may (the caller, NesShowBandCall, keeps the rest).
ProcedureNaked NesShowBand(rec.i)
  ASM
    la t0, global_nesshowprog
    ld t0, 0(t0)
    bnez t0, nsb_on
    nop
    jr ra                            ; the show is off (refused at its start)
    nop
nsb_on:
    daddiu sp, sp, -64
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    sd s4, 40(sp)
    sd s5, 48(sp)
    move s0, a0                      ; the record
    la t0, global_nesshowcur
    ld s1, 0(t0)                     ; p: the frame set
    la t0, global_nesshowfreecur
    ld t0, 0(t0)
    bnez t0, nsb_free
    nop
    jal nesshowacquire               ; the set's first write: the frame that used it last is drawn (N.62)
    nop
nsb_free:
    mfc0 s2, $9                      ; Count: the close's own ticks from here (and the record's band closes)
    nop
    la t0, global_nesbandbase
    ld t0, 0(t0)
    dsubu t0, s0, t0                 ; 96 x idx
    addiu t1, zero, 683
    multu t0, t1
    mflo t0
    srl t0, t0, 16                   ; idx
    dsll s3, t0, 3                   ; idx x 8: its element of the .i arrays
    la t0, global_nesshowrecfence
    daddu t0, t0, s3
    ld a0, 0(t0)                     ; the record's job of a frame ago
    beqz a0, nsb_rec_free
    nop
    jal lpmrspqfencedone
    nop
    bnez v0, nsb_rec_free            ; it has read the record
    nop
    la t0, global_nesshowrecfence
    daddu t0, t0, s3
    jal lpmrspqwait                  ; not yet: wait (correctness; a frame of margin, counted)
    ld a0, 0(t0)                     ; (delay slot)
    la t0, global_nesshowstat
    ld t1, 24(t0)
    daddiu t1, t1, 1
    sd t1, 24(t0)                    ; NesShowStat(3): waits
nsb_rec_free:
    ld t0, 24(s0)                    ; +24: PPUCTRL | PPUMASK << 8 | ...
    lw t1, 56(s0)                    ; +56: a split line's segment count (0 for a band)
    andi t0, t0, 0x800               ; PPUMASK bit 3: the background layer, the only reader of the name tables
    sltu s4, zero, t0
    beqz t1, nsb_reads
    nop
    move s4, zero                    ; a split line's record carries its own name-table bytes
nsb_reads:
    move a0, s0
    jal nesntlogband                 ; the record's +32 / +36: the log's span and the map (rspband.n64)
    move a1, s4                      ; (delay slot)
    jal nesshowrecwriteback          ; the record and its OAM snapshot to RDRAM (clobbers t0, t1)
    move a0, s0                      ; (delay slot)
    mfc0 t0, $9
    nop
    subu t0, t0, s2
    dsll32 t0, t0, 0
    dsrl32 t0, t0, 0                 ; the close's ticks, & $FFFFFFFF
    la t1, global_nesshowstat
    ld t2, 72(t1)
    daddu t2, t2, t0
    sd t2, 72(t1)                    ; (9) band-close ticks
    ld t2, 80(t1)
    daddiu t2, t2, 1
    sd t2, 80(t1)                    ; (10) bands
    ld t2, 88(t1)
    sltu t3, t2, t0
    beqz t3, nsb_setup
    nop
    sd t0, 88(t1)                    ; (11) the most
nsb_setup:
    la t0, global_nesshowsetupp
    ld t0, 0(t0)
    beq t0, s1, nsb_cmd              ; the program has this set's areas
    nop
    jal nesshowsetupcmd
    move a0, s1                      ; (delay slot)
nsb_cmd:
    la t0, global_nesshowbands
    dsll t1, s1, 3
    daddu t0, t0, t1
    ld s5, 0(t0)                     ; b: the band's index in its frame
    lui t2, 0x1FFF
    ori t2, t2, 0xFFFF               ; physical addresses
    ld t1, 40(s0)                    ; +40: the OAM snapshot's index
    dsll t1, t1, 8
    la t0, global_nesoambase
    ld t0, 0(t0)
    daddu t1, t1, t0
    and a3, t1, t2                   ; b: the snapshot
    and a2, s0, t2                   ; a: the record
    dsll t1, s1, 8
    or a4, s5, t1                    ; c: b | p << 8
    la t0, global_nesshowprog
    ld a0, 0(t0)
    jal lpmrspqcmdcall               ; NES_RSP_BAND
    addiu a1, zero, #NES_RSP_BAND    ; (delay slot)
    jal lpmrspqfence
    nop
    la t0, global_nesshowrecfence
    daddu t0, t0, s3
    sd v0, 0(t0)                     ; NesShowRecFence(idx)
    la t0, global_nesshowfence
    dsll t1, s1, 3
    daddu t0, t0, t1
    sd v0, 0(t0)                     ; NesShowFence(p)
    beqz s4, nsb_bands
    nop
    jal nesntlogqueued               ; a reading job: the log's room again (rspband.n64)
    move a0, v0                      ; (delay slot)
nsb_bands:
    la t0, global_nesshowbands
    dsll t1, s1, 3
    daddu t0, t0, t1
    daddiu t1, s5, 1
    sd t1, 0(t0)                     ; NesShowBands(p) = b + 1
    la t0, global_nesshowbusy
    addiu t1, zero, 1
    sd t1, 0(t0)
    jal lpmrspqflush
    nop
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
    ASM
      dsll32 a1, s2, 0
      dsrl32 a1, a1, 0               ; the start's Count, as LpmCpuCount gives it
      jal nesrecadd                  ; NesRecAdd(0, t0): the record's band closes
      move a0, zero                  ; (delay slot)
    EndASM
  CompilerEndIf
  ASM
    la t0, global_nesshowatt
    dsll t1, s1, 3
    daddu t0, t0, t1
    ld t0, 0(t0)
    bnez t0, nsb_out                 ; attached already
    nop
    move a0, zero
    jal nesshowpolle                 ; NesShowPollE(0, 1): attached as early as it can be (a hand-over's part)
    addiu a1, zero, 1                ; (delay slot)
nsb_out:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    jr ra
    daddiu sp, sp, 64
  EndASM
EndProcedure

; ---- a split line's first cut (through NesFbCatchUpCall): before the write is applied ----
; The old renderer, at the line's dot 0, drew the line's sprite row and then its spans as they were consumed; the
; inputs are unchanged since (every change cuts first, and this is the line's first cut), so the same calls now, with
; PpuDot and PpuV as at dot 0, draw the same pixels: the sprite row, then spans [0, dot). OAM written since the line
; began (OamCacheDirty: such a write changes the sprites from the next line on) is set aside for the band's snapshot,
; which is OAM as at this line's start. PpuDot, PpuV and PpuStatus (the renderer writes v and bit 6) are put back.
; HOW (design note N.73: in assembly, the owner's order - cold is not an exemption): s0 dot, s1 v, s2 status, s3
; SprCount, s4 OamCacheDirty, s5 the record's tr (saved). NesFbSlot clobbers t0-t3 / v0 only; the old renderer's
; NesMmc3DrawSprites / PpuClearSprites / NesRenderTo are called as the compiled body called them (s-registers kept).
; REACHED BY: a split line when the frame's 32 records or its segment pool's 32 entries are used up - no cart of the
; proof set does that ("ON THE OLD PATH 0" in every --show-check run); a test cart with more than 32 split lines in
; a frame (a $2001 / $2006 write on each of 33+ lines) under --show-check would.
; THE PLAIN TWIN:
;   Protected dot.i = PpuDot, v.i = PpuV, st.i = PpuStatus, n.i = SprCount, snap.i, i.i, dirty.i = OamCacheDirty, tr.i
;   CompilerIf #NES_CONSOLE_RECORD : tr = LpmCpuCount() : CompilerEndIf
;   NesFbSlot()
;   If PeekI(NesUnitBase + #NES_U_LIVE) = 0 : ProcedureReturn : EndIf
;   NesShowStat(7) + 1
;   If dirty
;     snap = NesOamBase + PeekI(NesUnitBase + #NES_U_BANDOAM) * 256
;     For i = 0 To 255 Step 8
;       PokeQ(@NesShowOamKeep(0) + i, PeekQ(@Oam(0) + i)) : PokeQ(@Oam(0) + i, PeekQ(snap + i))
;     Next
;   EndIf
;   PpuDot = 0 : PpuV = PeekI(NesUnitBase + #NES_U_LINEV)
;   If n : NesMmc3DrawSprites(PpuLine, n, PpuMask) : Else : PpuClearSprites() : EndIf
;   If dirty
;     For i = 0 To 255 Step 8 : PokeQ(@Oam(0) + i, PeekQ(@NesShowOamKeep(0) + i)) : Next
;   EndIf
;   NesRenderTo(dot)
;   PpuDot = dot : PpuV = v : PpuStatus = st
;   CompilerIf #NES_CONSOLE_RECORD : NesRecAdd(1, tr) : CompilerEndIf
ProcedureNaked NesFbCatchUp()
  ASM
    daddiu sp, sp, -64
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    sd s4, 40(sp)
    sd s5, 48(sp)
    la t0, global_ppudot
    ld s0, 0(t0)                     ; dot
    la t0, global_ppuv
    ld s1, 0(t0)                     ; v
    la t0, global_ppustatus
    ld s2, 0(t0)                     ; st
    la t0, global_sprcount
    ld s3, 0(t0)                     ; n
    la t0, global_oamcachedirty
    ld s4, 0(t0)                     ; dirty
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    mfc0 s5, $9
    nop
    dsll32 s5, s5, 0
    dsrl32 s5, s5, 0                 ; tr
  EndASM
  CompilerEndIf
  ASM
    jal nesfbslot                    ; the line's row (U_LIVE), or none
    nop
    la t9, global_nesunitbase
    ld t9, 0(t9)
    ld t0, #NES_U_LIVE(t9)
    beqz t0, nsfc_out                ; no row: the old path is not taken either
    nop
    la t0, global_nesshowstat
    ld t1, 56(t0)
    daddiu t1, t1, 1
    sd t1, 56(t0)                    ; (7) split lines on the old path
    beqz s4, nsfc_draw
    nop
    ld t0, #NES_U_BANDOAM(t9)
    dsll t0, t0, 8
    la t1, global_nesoambase
    ld t1, 0(t1)
    daddu t0, t0, t1                 ; snap: the band's OAM snapshot (OAM at the line's start)
    la t1, global_oam
    la t2, global_nesshowoamkeep
    daddiu t3, t1, 256
nsfc_keep:
    ld t8, 0(t1)
    sd t8, 0(t2)                     ; OAM now, set aside
    ld t8, 0(t0)
    sd t8, 0(t1)                     ; OAM as at the line's start
    daddiu t1, t1, 8
    daddiu t2, t2, 8
    bne t1, t3, nsfc_keep
    daddiu t0, t0, 8                 ; (delay slot)
nsfc_draw:
    la t0, global_ppudot
    sd zero, 0(t0)                   ; PpuDot = 0
    ld t1, #NES_U_LINEV(t9)
    la t0, global_ppuv
    sd t1, 0(t0)                     ; PpuV = v at the line's dot 0
    beqz s3, nsfc_clear
    nop
    la t0, global_ppuline
    ld a0, 0(t0)
    move a1, s3
    la t0, global_ppumask
    jal nesmmc3drawsprites           ; the line's sprite row
    ld a2, 0(t0)                     ; (delay slot)
    b nsfc_back
    nop
nsfc_clear:
    jal ppuclearsprites
    nop
nsfc_back:
    beqz s4, nsfc_spans
    nop
    la t1, global_oam
    la t2, global_nesshowoamkeep
    daddiu t3, t1, 256
nsfc_put:
    ld t8, 0(t2)
    sd t8, 0(t1)                     ; OAM put back
    daddiu t1, t1, 8
    bne t1, t3, nsfc_put
    daddiu t2, t2, 8                 ; (delay slot)
nsfc_spans:
    jal nesrenderto                  ; spans [0, dot)
    move a0, s0                      ; (delay slot)
    la t0, global_ppudot
    sd s0, 0(t0)
    la t0, global_ppuv
    sd s1, 0(t0)
    la t0, global_ppustatus
    sd s2, 0(t0)
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    addiu a0, zero, 1
    jal nesrecadd                    ; NesRecAdd(1, tr): the fallback lines
    move a1, s5                      ; (delay slot)
  EndASM
  CompilerEndIf
  ASM
nsfc_out:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    jr ra
    daddiu sp, sp, 64
  EndASM
EndProcedure

CompilerIf #NES_CONSOLE_RECORD
  Global NesRecWait.i, NesRecWaitFrom.i, NesRecWaitSyn.i ; the console record (console_record.n64): Count ticks slept here for a buffer
  Global NesRecKept.i                   ; 1 once the record's header read back from the flash cart (read from the dump)
CompilerEndIf
Declare NesShowCheckPrev(p.i)

; ======================================================================================================================
; THE SHOW'S PER-FRAME GLUE IN ASSEMBLY (the owner's order: everything the emulator runs in assembly; design note
; N.71). The check points and the hand-over - NesShowPoll, NesShowPollE, NesShowAdvance, NesShowAttach, NesShowGetFb,
; NesShowDetach, NesShowBorders, NesShowRdpAdopt, NesShowFrameEnd, NesShowSet, NesShowAcquire, NesShowSleepDrawn,
; NesShowCheckPrev (the record's / no check's form), NesShowSetupCmd - and NesShowFallback are hand-written VR4300
; assembly, each a ProcedureNaked of the same name and arguments, its PLAIN TWIN (the compiled procedure it replaces) in
; its header. Their callers (the hot unit's line 240, NesShowBand, host.n64's DisplayWaitLine, nes.n64's frame wrap, the
; compiled cold paths below) call them unchanged.
; THE CONVENTION (Help/VR4300.txt): arguments a0-a7, the ninth at 0(sp), the result in a0; s0-s7 / fp / sp / gp kept;
; t-, a- and v-registers may change. Every library call here is to a callable form the library has (a procedure, or
; LpmRspqCmdCall / LpmRdpFillRectCall for the inline LpmRspqCmd / LpmRdpFillRect, LpmRspqCmd7Slow for the 7-argument
; command). THE LIBRARY'S INLINE RDP MACROS THAT HAVE NO CALLABLE FORM (LpmRdpCmd, LpmRdpCmdK_, LpmRdpModeFill and its
; LpmRdpOtherModes and LpmRdpSyncPipe) are written out below exactly as each expands - its slots' stores, LpmRdpRoom_'s
; test and LpmRdpKick, the words at lpm_rdp_ptr, the cached-mode words - each with the macro and its lpm_rdp.n64 lines
; named (the coordinator's ruling: the library is not changed). Library globals are read where the procedure the twin
; called only returns one (LpmRdpFramesDone: lpm_rdp_frames_done).
; Values the twin computes modulo #NES_FB_ROWS (240) are a first row below 240 plus a count of at most 240 (one row a
; line): one subtraction of 240 is the remainder.
; ======================================================================================================================
#NES_SHOW_WAKE_VIAI = #LPM_WAKE_VI | #LPM_WAKE_AI                    ; NesShowGetFb's sleep
#NES_SHOW_WAKE_DRAWN = #LPM_WAKE_DP | #LPM_WAKE_VI | #LPM_WAKE_AI    ; NesShowSleepDrawn's
#NES_SHOW_BL_X1 = 32 + #NES_CROP_X        ; the left border's end (NesShowBorders)
#NES_SHOW_BR_X0 = 288 - #NES_CROP_X       ; the right border's start
#NES_SHOW_CY1 = 240 - #NES_CROP_Y         ; the bottom crop's start
#NES_SHOW_FB_LINE_BYTES = #NES_FB_ROWS * 8   ; a set's part of NesFbLine
CompilerIf #LPM_WAIT_TICK <> 468750
  CompilerError "show.n64: the assembly writes #LPM_WAIT_TICK as lui 7 / ori $270E (468,750)"
CompilerEndIf
CompilerIf #NES_SHOW_WORDS * 8 <> $8000
  CompilerError "show.n64: NesShowAcquire's assembly reaches the frame area's status at +$8000 (ori 0x8000)"
CompilerEndIf
CompilerIf #LPM_RDP_FILL <> $300000
  CompilerError "show.n64: NesShowRdpModeFill writes #LPM_RDP_FILL as lui $30"
CompilerEndIf
Declare NesShowFrameEndCheck(p.i)

; THE PIN (design note N.70's form; N.71): NesShowPin pads with zero words to the next address that is 11456 = 2048 +
; 294 x 32 modulo 16384, so THE RUN below - the per-frame show glue, NesShowPoll .. NesShowSetupCmd - starts on the I-set
; 294 lines after the pinned `cpurun`'s (2048 modulo 16 KB, cpu6502.n64's CpuRunPin) in every build that has it. The
; set chosen from the last record run before this code (the console record cart's SMB3 replay): the unit's heat by I-set (its hottest
; instruction on each line, hot span and cold part, summed by set) against the run's own lines weighted by how often
; each runs (its first 6 lines - NesShowPoll, NesShowPollE, NesShowAdvance's fast path - about 22 times a frame, the
; rest once or twice), the start minimising the sum of the smaller of the two: rel. sets 294-299 for the head (unit
; heat 228, 114, 74, 7, 8, 6), the run's 136 lines (shipped; the record's a few more) clear of the host run (rel. 22-35)
; and the job poll (54-66). THE RUN IS ONE LAYOUT UNIT: the compiler moves a ProcedureNaked whose last instruction
; falls through together with the one after it (EmitCore_Mips.pbi, "a naked procedure and the one after it move
; together"; a procedure ENDS when its last instruction is jr / j / b, or a nop after one), so every procedure of the
; run ends in a delay slot that is not a nop, and the last, NesShowSetupCmd, ends in jr ra; nop. NesShowPin runs on
; (no jr / j / b), so it is kept with NesShowPoll and the pad lands right before that label; nothing enters it.
; Anything written between it and NesShowPoll, or a run procedure ending in a nop, breaks the pin.
ProcedureNaked NesShowPin()
  ASM
    .alignabs 16384, 11456
  EndASM
EndProcedure

; ---- NesShowPoll(wait): a 16-line check point (host.n64's DisplayWaitLine), the frame's wrap (nes.n64). A tail call.
; THE PLAIN TWIN:
;   NesShowPollE(wait, 0)
ProcedureNaked NesShowPoll(wait.i)
  ASM
    j nesshowpolle
    move a1, zero                    ; (delay slot) early = 0
  EndASM
EndProcedure

; ---- NesShowPollE(wait, early): a check point, through NesShowAdvance when the show is on. The record build counts
; its ticks as the hand-over's (NesRecT(3)), less the sleep for a buffer (the record's own column) and an AI block
; synthesised meanwhile (its own part).
; THE PLAIN TWIN:
;   CompilerIf #NES_CONSOLE_RECORD
;     Protected tr.i = LpmCpuCount(), w0.i = NesRecWait, s0.i = NesRecT(9)
;     If NesShowProg : NesShowAdvance(wait, early) : EndIf
;     NesRecAdd(3, tr) : NesRecT(3) - (NesRecWait - w0) - (NesRecT(9) - s0)
;   CompilerElse
;     If NesShowProg : NesShowAdvance(wait, early) : EndIf
;   CompilerEndIf
ProcedureNaked NesShowPollE(wait.i, early.i)
  CompilerIf #NES_CONSOLE_RECORD = 0
  ASM
    la t0, global_nesshowprog
    ld t0, 0(t0)
    beqz t0, nspe_off                ; the show refused at its start: nothing
    nop
    j nesshowadvance                 ; (a tail call: a0, a1 as given)
    nop
nspe_off:
    jr ra
    move a1, zero                    ; (delay slot: nothing to do; not a nop - THE RUN, above)
  EndASM
  CompilerElse
  ASM
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s5, 8(sp)
    sd s6, 16(sp)
    sd s7, 24(sp)
    jal nes_show_rec_from            ; s5 Count, s6 NesRecWait, s7 NesRecT(9) (a0, a1 kept)
    nop
    la t0, global_nesshowprog
    ld t0, 0(t0)
    beqz t0, nspe_rec
    nop
    jal nesshowadvance
    nop
nspe_rec:
    jal nes_show_rec_to3             ; NesRecT(3): the ticks less the sleep and the synthesis
    nop
    ld ra, 0(sp)
    ld s5, 8(sp)
    ld s6, 16(sp)
    ld s7, 24(sp)
    jr ra
    daddiu sp, sp, 32
  EndASM
  CompilerEndIf
EndProcedure

; ---- NesShowAdvance(wait, early): the frame before attached (wait as NesShowAttach) and detached; with early = 1 (a
; band's close, line 240) the current frame attached early if it can be (never waited for). The common case - the
; frame before handed, and no early attach to try - returns in 9 instructions, no frame.
; THE PLAIN TWIN:
;   Protected q.i = NesShowCur ! 1, p.i = NesShowCur
;   If NesShowDone(q) And (early = 0 Or NesShowAtt(p) Or NesShowDone(p)) : ProcedureReturn : EndIf
;   If wait = 0 And lpm_rdp_frames_done < lpm_rdp_sf_handed : ProcedureReturn : EndIf
;   If NesShowDone(q) = 0
;     If NesShowAtt(q) = 0
;       If NesShowAttach(q, wait) = 0 : ProcedureReturn : EndIf
;     EndIf
;     If NesShowDone(q) = 0 : NesShowDetach(q) : EndIf
;   EndIf
;   If early And NesShowAtt(p) = 0 And NesShowDone(p) = 0 : NesShowAttach(p, 0) : EndIf
; HOW: Done(q) read once at the entry for the first two tests (nothing changes it between them). KEEPS s0-s3 (saved).
ProcedureNaked NesShowAdvance(wait.i, early.i)
  ASM
    la t0, global_nesshowcur
    ld t0, 0(t0)
    dsll t1, t0, 3                   ; p x 8
    xori t2, t1, 8                   ; q x 8
    la t3, global_nesshowdone
    daddu t8, t3, t2
    ld t8, 0(t8)                     ; Done(q)
    beqz t8, nsa_gate
    nop
    beqz a1, nsa_ret                 ; the frame before handed and no early attach: nothing (the most)
    nop
    la t9, global_nesshowatt
    daddu t9, t9, t1
    ld t9, 0(t9)
    bnez t9, nsa_ret                 ; the current frame attached already
    daddu t9, t3, t1                 ; (delay slot)
    ld t9, 0(t9)
    bnez t9, nsa_ret                 ; or handed (not shown)
    nop
nsa_gate:
    bnez a0, nsa_work
    nop
    la t9, global_lpm_rdp_frames_done
    ld t9, 0(t9)
    la v0, global_lpm_rdp_sf_handed
    ld v0, 0(v0)
    slt t9, t9, v0
    beqz t9, nsa_work                ; the gate open
    nop
nsa_ret:
    jr ra                            ; wait 0 and the gate shut: nothing yet
    nop
nsa_work:
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    move s0, a0                      ; wait
    move s1, a1                      ; early
    move s2, t0                      ; p
    xori s3, t0, 1                   ; q
    bnez t8, nsa_early               ; the frame before handed: only the early attach
    nop
    la t0, global_nesshowatt
    dsll t1, s3, 3
    daddu t0, t0, t1
    ld t0, 0(t0)
    bnez t0, nsa_detach              ; attached already
    nop
    move a0, s3
    jal nesshowattach                ; NesShowAttach(q, wait)
    move a1, s0                      ; (delay slot)
    beqz a0, nsa_out                 ; not now
    nop
nsa_detach:
    la t0, global_nesshowdone
    dsll t1, s3, 3
    daddu t0, t0, t1
    ld t0, 0(t0)
    bnez t0, nsa_early               ; not shown (the sound reserve), counted: handed
    nop
    jal nesshowdetach                ; NesShowDetach(q)
    move a0, s3                      ; (delay slot)
nsa_early:
    beqz s1, nsa_out
    nop
    la t0, global_nesshowatt
    dsll t1, s2, 3
    daddu t0, t0, t1
    ld t0, 0(t0)
    bnez t0, nsa_out
    nop
    la t0, global_nesshowdone
    daddu t0, t0, t1
    ld t0, 0(t0)
    bnez t0, nsa_out
    nop
    move a0, s2
    jal nesshowattach                ; NesShowAttach(p, 0): early, never waited for
    move a1, zero                    ; (delay slot)
nsa_out:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; ---- NesShowAttach(s, wait): frame s attached if it can be. wait: 0 not at all; 1 a buffer slept for as HostPresent(1)
; did (not shown - done, counted - when the sound reserve runs low); 2 until it is attached. OUT a0: 1 attached (or not
; shown), 0 not now.
; THE PLAIN TWIN:
;   Protected fb.i
;   If wait = 0 And NesShowFb(s) = 0 And LpmDisplayFrames() = NesShowNoFbVi : ProcedureReturn 0 : EndIf
;   If LpmRdpSyncFullDone() = 0
;     If wait < 2 : ProcedureReturn 0 : EndIf
;     LpmRdpSyncFullWait()
;   EndIf
;   fb = NesShowFb(s)
;   If fb = 0
;     fb = NesShowGetFb(wait)
;     If fb = 0 : NesShowNoFbVi = LpmDisplayFrames() : EndIf
;     If fb = 0
;       If wait = 1 : HostCoalesced + 1 : NesShowStat(14) + 1 : NesShowDone(s) = 1 : NesShowTicket(s) = 0 : ProcedureReturn 1 : EndIf
;       ProcedureReturn 0
;     EndIf
;     NesShowFb(s) = fb
;   EndIf
;   LpmRdpForget() : LpmRdpAttach(fb) : LpmRspqRdpFlush(NesShowProg)
;   LpmRspqCmd(NesShowProg, #NES_RSP_BAND, 0, NesShowArea(s) & $1FFFFFFF, s)   ; the HAND step: attached, words so far
;   NesShowAtt(s) = 1
;   ProcedureReturn 1
; HOW: s0 s, s1 wait, s2 fb, s3 s x 8 (saved). LpmDisplayFrames only counts (no state), so whether the compiled And
; calls it when wait or fb is not 0 changes nothing. The command through the naked LpmRspqCmdCall (the macro's steps).
ProcedureNaked.i NesShowAttach(s.i, wait.i)
  ASM
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    move s0, a0                      ; s
    move s1, a1                      ; wait
    dsll s3, a0, 3                   ; s x 8
    la t0, global_nesshowfb
    daddu t0, t0, s3
    ld s2, 0(t0)                     ; fb = NesShowFb(s)
    bnez s1, nsat_gate
    nop
    bnez s2, nsat_gate
    nop
    jal lpmdisplayframes
    nop
    la t0, global_nesshownofbvi
    ld t0, 0(t0)
    beq a0, t0, nsat_no              ; none was free at this VI's count: none is now (only the VI frees one)
    nop
nsat_gate:
    jal lpmrdpsyncfulldone           ; the SYNC_FULL before through (the library's gate, not waited for)
    nop
    bnez a0, nsat_fb
    nop
    slti t0, s1, 2
    bnez t0, nsat_no                 ; wait < 2: not now
    nop
    jal lpmrdpsyncfullwait
    nop
nsat_fb:
    bnez s2, nsat_attach
    nop
    jal nesshowgetfb                 ; a buffer (wait as given)
    move a0, s1                      ; (delay slot)
    move s2, a0
    bnez s2, nsat_keep
    nop
    jal lpmdisplayframes
    nop
    la t0, global_nesshownofbvi
    sd a0, 0(t0)                     ; NesShowNoFbVi: none free at this VI's count
    addiu t0, zero, 1
    bne s1, t0, nsat_no              ; wait 0 / 2: not now
    nop
    la t0, global_hostcoalesced      ; wait 1, the sound reserve low: not shown (as HostPresent(1) coalesced)
    ld t1, 0(t0)
    daddiu t1, t1, 1
    sd t1, 0(t0)
    la t0, global_nesshowstat
    ld t1, 112(t0)
    daddiu t1, t1, 1
    sd t1, 112(t0)                   ; (14) coalesced
    la t0, global_nesshowdone
    daddu t0, t0, s3
    addiu t1, zero, 1
    sd t1, 0(t0)
    la t0, global_nesshowticket
    daddu t0, t0, s3
    sd zero, 0(t0)
    b nsat_out
    addiu a0, zero, 1                ; (delay slot) 1
nsat_keep:
    la t0, global_nesshowfb
    daddu t0, t0, s3
    sd s2, 0(t0)                     ; NesShowFb(s) = fb
nsat_attach:
    jal lpmrdpforget                 ; (the RSP's words left the RDP's modes: the library's own sent again)
    nop
    jal lpmrdpattach                 ; (nothing drawn here: the borders are drawn at the detach)
    move a0, s2                      ; (delay slot)
    la t0, global_nesshowprog
    jal lpmrspqrdpflush              ; the attach through the queue (its gate passes: decided above)
    ld a0, 0(t0)                     ; (delay slot)
    la t0, global_nesshowarea
    daddu t0, t0, s3
    ld a3, 0(t0)
    lui t1, 0x1FFF
    ori t1, t1, 0xFFFF
    and a3, a3, t1                   ; b: the frame area, physical
    move a2, zero                    ; a: record 0 (the HAND step)
    move a4, s0                      ; c: s
    la t0, global_nesshowprog
    ld a0, 0(t0)
    jal lpmrspqcmdcall
    addiu a1, zero, #NES_RSP_BAND    ; (delay slot)
    la t0, global_nesshowatt
    daddu t0, t0, s3
    addiu t1, zero, 1
    sd t1, 0(t0)                     ; NesShowAtt(s) = 1
    b nsat_out
    addiu a0, zero, 1                ; (delay slot) 1
nsat_no:
    move a0, zero
nsat_out:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; ---- NesShowGetFb(wait): a buffer to draw into. wait 0: only one free now; 1 as HostPresent(1) did - sleep on the VI /
; AI interrupts until one frees, unless the sound reserve runs low (then 0: the frame is not shown); 2 until one frees.
; OUT a0: the buffer or 0. The record build counts the sleep (NesRecWait), less a block synthesised meanwhile.
; THE PLAIN TWIN:
;   Protected fb.i, seen.i
;   fb = LpmDisplayTryGet()
;   If fb Or wait = 0 : ProcedureReturn fb : EndIf
;   CompilerIf #NES_CONSOLE_RECORD : NesRecWaitFrom = LpmCpuCount() : NesRecWaitSyn = NesRecT(9) : CompilerEndIf
;   seen = LpmIrqSeen(#LPM_WAKE_VI | #LPM_WAKE_AI)
;   Repeat
;     fb = LpmDisplayTryGet()
;     CompilerIf #NES_CONSOLE_RECORD
;       If fb Or (wait = 1 And HostAudioReady And ApuProduced - HostPcmRead < #HOST_AUDIO_RESERVE)
;         NesRecWait + ((LpmCpuCount() - NesRecWaitFrom) & $FFFFFFFF) - (NesRecT(9) - NesRecWaitSyn)
;       EndIf
;     CompilerEndIf
;     If fb : ProcedureReturn fb : EndIf
;     If wait = 1 And HostAudioReady And ApuProduced - HostPcmRead < #HOST_AUDIO_RESERVE : ProcedureReturn 0 : EndIf
;     seen = LpmIrqSleep(#LPM_WAKE_VI | #LPM_WAKE_AI, seen, #LPM_WAIT_TICK, 0, 0)
;     HostQueueAudio(ApuProduced)
;   ForEver
; HOW: s0 wait, s1 seen, s2 fb, s3 "the reserve low" (computed once a turn: the twin's two tests read the same
; values - nothing between them writes HostAudioReady, ApuProduced or HostPcmRead).
ProcedureNaked.i NesShowGetFb(wait.i)
  ASM
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    move s0, a0                      ; wait
    jal lpmdisplaytryget
    nop
    bnez a0, ngf_out                 ; one is free
    nop
    beqz s0, ngf_out                 ; wait 0: none (a0 = 0)
    nop
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    mfc0 t1, $9
    nop
    dsll32 t1, t1, 0
    dsrl32 t1, t1, 0                 ; Count, as LpmCpuCount gives it
    la t0, global_nesrecwaitfrom
    sd t1, 0(t0)
    la t0, global_nesrect
    ld t1, 72(t0)
    la t0, global_nesrecwaitsyn
    sd t1, 0(t0)                     ; NesRecT(9) now
  EndASM
  CompilerEndIf
  ASM
    jal lpmirqseen
    addiu a0, zero, #NES_SHOW_WAKE_VIAI   ; (delay slot)
    move s1, a0                      ; seen
ngf_try:
    jal lpmdisplaytryget
    nop
    move s2, a0                      ; fb
    move s3, zero                    ; the reserve low: wait 1 only
    addiu t0, zero, 1
    bne s0, t0, ngf_low
    nop
    la t0, global_hostaudioready
    ld t0, 0(t0)
    beqz t0, ngf_low
    nop
    la t0, global_apuproduced
    ld t0, 0(t0)
    la t1, global_hostpcmread
    ld t1, 0(t1)
    dsubu t0, t0, t1
    slti s3, t0, #HOST_AUDIO_RESERVE
ngf_low:
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    or t0, s2, s3
    beqz t0, ngf_rec_no
    nop
    mfc0 t1, $9
    nop
    la t0, global_nesrecwaitfrom
    ld t2, 0(t0)
    dsubu t1, t1, t2
    dsll32 t1, t1, 0
    dsrl32 t1, t1, 0                 ; the ticks slept
    la t0, global_nesrect
    ld t2, 72(t0)
    la t0, global_nesrecwaitsyn
    ld t3, 0(t0)
    dsubu t2, t2, t3                 ; less a block synthesised while waiting (work, not sleep)
    la t0, global_nesrecwait
    ld t3, 0(t0)
    daddu t3, t3, t1
    dsubu t3, t3, t2
    sd t3, 0(t0)
ngf_rec_no:
  EndASM
  CompilerEndIf
  ASM
    bnez s2, ngf_fb
    nop
    bnez s3, ngf_fb                  ; the sound reserve low: 0
    nop
    addiu a0, zero, #NES_SHOW_WAKE_VIAI
    move a1, s1
    lui a2, 0x7
    ori a2, a2, 0x270E               ; #LPM_WAIT_TICK (468,750; the guard above)
    move a3, zero
    jal lpmirqsleep
    move a4, zero                    ; (delay slot)
    move s1, a0                      ; seen
    la t0, global_apuproduced
    jal hostqueueaudio               ; HostQueueAudio(ApuProduced): the sound fed meanwhile
    ld a0, 0(t0)                     ; (delay slot)
    b ngf_try
    nop
ngf_fb:
    move a0, s2
ngf_out:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; ---- NesShowDetach(s): frame s (ended, attached) detached - the rest of its words, its old-path lines, the borders,
; the SYNC_FULL that shows it.
; THE PLAIN TWIN:
;   Protected fb.i = NesShowFb(s)
;   LpmRspqCmd(NesShowProg, #NES_RSP_BAND, 0, NesShowArea(s) & $1FFFFFFF, s | 256)   ; the HAND step: the rest, and
;   NesShowFallback(s)                                                                ; the set no longer attached
;   NesShowBorders()
;   LpmRspqRdpDetachShow(NesShowProg, fb)
;   NesShowTicket(s) = lpm_rdp_frames_sent
;   NesShowShown(s) = fb : NesShowFb(s) = 0 : NesShowDone(s) = 1 : NesShowStat(0) + 1
; HOW: s0 s, s1 s x 8, s2 fb (saved).
ProcedureNaked NesShowDetach(s.i)
  ASM
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    move s0, a0
    dsll s1, a0, 3
    la t0, global_nesshowfb
    daddu t0, t0, s1
    ld s2, 0(t0)                     ; fb
    la t0, global_nesshowarea
    daddu t0, t0, s1
    ld a3, 0(t0)
    lui t1, 0x1FFF
    ori t1, t1, 0xFFFF
    and a3, a3, t1                   ; b: the frame area, physical
    move a2, zero                    ; a: record 0 (the HAND step)
    ori a4, s0, 256                  ; c: s | 256 (the rest; the set no longer attached)
    la t0, global_nesshowprog
    ld a0, 0(t0)
    jal lpmrspqcmdcall
    addiu a1, zero, #NES_RSP_BAND    ; (delay slot)
    jal nesshowfallback              ; its old-path lines
    move a0, s0                      ; (delay slot)
    jal nesshowborders               ; black borders and crop
    nop
    la t0, global_nesshowprog
    ld a0, 0(t0)
    jal lpmrspqrdpdetachshow         ; the SYNC_FULL that shows it
    move a1, s2                      ; (delay slot)
    la t0, global_lpm_rdp_frames_sent
    ld t1, 0(t0)
    la t0, global_nesshowticket
    daddu t0, t0, s1
    sd t1, 0(t0)                     ; NesShowTicket(s) = lpm_rdp_frames_sent
    la t0, global_nesshowshown
    daddu t0, t0, s1
    sd s2, 0(t0)                     ; NesShowShown(s) = fb
    la t0, global_nesshowfb
    daddu t0, t0, s1
    sd zero, 0(t0)
    la t0, global_nesshowdone
    daddu t0, t0, s1
    addiu t1, zero, 1
    sd t1, 0(t0)
    la t0, global_nesshowstat
    ld t1, 0(t0)
    daddiu t1, t1, 1
    sd t1, 0(t0)                     ; (0) frames shown
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    jr ra
    daddiu sp, sp, 32
  EndASM
EndProcedure

; ---- NesShowBorders(): the picture's borders and crop, black, after everything else of it: x 0 .. 32 + #NES_CROP_X
; and 288 - #NES_CROP_X .. 320 on every line, and #NES_CROP_Y lines top and bottom. In fill mode, sent as such
; (NesShowRdpAdopt first).
; THE PLAIN TWIN:
;   NesShowRdpAdopt()
;   LpmRdpModeFill(LpmRgb16(0, 0, 0))
;   LpmRdpFillRect(0, 0, 32 + #NES_CROP_X, 240) : LpmRdpFillRect(288 - #NES_CROP_X, 0, 320, 240)
;   CompilerIf #NES_CROP_Y > 0
;     LpmRdpFillRect(32 + #NES_CROP_X, 0, 288 - #NES_CROP_X, #NES_CROP_Y)
;     LpmRdpFillRect(32 + #NES_CROP_X, 240 - #NES_CROP_Y, 288 - #NES_CROP_X, 240)
;   CompilerEndIf
; HOW: LpmRgb16(0, 0, 0) is 1 (lpm_display.n64: ((r & 248) << 8) | ((g & 248) << 3) | ((b & 248) >> 2) | 1). The
; rectangles through the library's LpmRdpFillRectCall (its comment: the same words and state as the inline macro).
ProcedureNaked NesShowBorders()
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    jal nesshowrdpadopt
    nop
    jal nesshowrdpmodefill
    addiu a0, zero, 1                ; (delay slot) LpmRgb16(0, 0, 0)
    move a0, zero
    move a1, zero
    addiu a2, zero, #NES_SHOW_BL_X1
    jal lpmrdpfillrectcall
    addiu a3, zero, 240              ; (delay slot)
    addiu a0, zero, #NES_SHOW_BR_X0
    move a1, zero
    addiu a2, zero, 320
    jal lpmrdpfillrectcall
    addiu a3, zero, 240              ; (delay slot)
  EndASM
  CompilerIf #NES_CROP_Y > 0
  ASM
    addiu a0, zero, #NES_SHOW_BL_X1
    move a1, zero
    addiu a2, zero, #NES_SHOW_BR_X0
    jal lpmrdpfillrectcall
    addiu a3, zero, #NES_CROP_Y      ; (delay slot)
    addiu a0, zero, #NES_SHOW_BL_X1
    addiu a1, zero, #NES_SHOW_CY1
    addiu a2, zero, #NES_SHOW_BR_X0
    jal lpmrdpfillrectcall
    addiu a3, zero, 240              ; (delay slot)
  EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure

; ---- NesShowRdpAdopt(): after the RSP's words the RDP holds THEIR modes, not the ones the library believes it set:
; the syncs the program owes, the library's own mode words as it believes them sent again (the twin's restore), its
; state cache forgotten - so the library's next mode call sends what it means. (WHY: the blue side bands of cart 5,
; design note N.64: LpmRdpForget does not clear the other-modes cache.)
; THE PLAIN TWIN:
;   LpmRdpCmd($27000000, 0) : LpmRdpCmd($28000000, 0) : LpmRdpCmd($26000000, 0)
;   If lpm_rdp_cycle <> -1 : LpmRdpCmd($2F000000 | lpm_rdp_om_hi, lpm_rdp_om_lo) : EndIf
;   LpmRdpForget() : LpmRdpTmemReset()
ProcedureNaked NesShowRdpAdopt()
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    lui a0, 0x2700                   ; SYNC_PIPE
    jal nesshowrdpcmd
    move a1, zero                    ; (delay slot)
    lui a0, 0x2800                   ; SYNC_TILE
    jal nesshowrdpcmd
    move a1, zero
    lui a0, 0x2600                   ; SYNC_LOAD
    jal nesshowrdpcmd
    move a1, zero
    la t0, global_lpm_rdp_cycle
    ld t0, 0(t0)
    daddiu t0, t0, 1
    beqz t0, nsra_forget             ; no cycle type set (-1): no mode words to restore
    nop
    la t0, global_lpm_rdp_om_hi
    ld a0, 0(t0)
    lui t1, 0x2F00
    or a0, a0, t1                    ; SET_OTHER_MODES | hi
    la t0, global_lpm_rdp_om_lo
    jal nesshowrdpcmd
    ld a1, 0(t0)                     ; (delay slot) lo
nsra_forget:
    jal lpmrdpforget
    nop
    ld ra, 0(sp)
    j lpmrdptmemreset                ; (a tail call)
    daddiu sp, sp, 16                ; (delay slot)
  EndASM
EndProcedure

; ---- NesShowRdpCmd(w0, w1): THE LIBRARY'S MACRO LpmRdpCmd(w0_, w1_) WRITTEN OUT (lpm_rdp.n64, Macro LpmRdpRoom_ lines
; 1065-1067 and Macro LpmRdpCmd lines 1094-1107): the slots lpm_rdp_a0 / lpm_rdp_a1 = the two words; THE ROOM, If
; lpm_rdp_ptr + 8 > lpm_rdp_end - #LPM_RDP_ROOM : LpmRdpKick() (a signed 64-bit compare, as compiled); the words at
; lpm_rdp_ptr (sw through its 32-bit sign-extended form, sll x, x, 0), lpm_rdp_ptr + 8. ENTERED AT nes_show_rdp_cmdk it
; is LpmRdpCmdK_(w0_) (lines 1112-1124: a0 = the word, a1 = 0; the same room and words, no slot). The macro's block
; reads the words back from the slots; here they are the registers that were stored there (the same values).
; CLOBBERS what a compiled call may (LpmRdpKick on a full list).
ProcedureNaked NesShowRdpCmd(w0.i, w1.i)
  ASM
    la t9, global_lpm_rdp_a0
    sd a0, 0(t9)                     ; lpm_rdp_a0 = w0
    sd a1, global_lpm_rdp_a1-global_lpm_rdp_a0(t9)   ; lpm_rdp_a1 = w1
nes_show_rdp_cmdk:
    la t9, global_lpm_rdp_ptr
    ld t8, 0(t9)
    la t1, global_lpm_rdp_end
    ld t1, 0(t1)
    daddiu t8, t8, 8
    daddiu t1, t1, -#LPM_RDP_ROOM
    slt t0, t1, t8                   ; ptr + 8 > end - room: the list handed over first
    beqz t0, nes_show_rdp_cmd_w
    nop
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    jal lpmrdpkick
    nop
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    daddiu sp, sp, 32
nes_show_rdp_cmd_w:
    la t9, global_lpm_rdp_ptr
    ld t8, 0(t9)                     ; where it goes (64-bit, as the program holds it)
    sll t0, t8, 0                    ; a 32-bit sign-extended address to store through
    sw a0, 0(t0)
    sw a1, 4(t0)
    daddiu t8, t8, 8
    jr ra
    sd t8, 0(t9)                     ; (delay slot) lpm_rdp_ptr + 8
  EndASM
EndProcedure

; ---- NesShowRdpModeFill(colour): THE LIBRARY'S MACRO LpmRdpModeFill(colour_) WRITTEN OUT (lpm_rdp.n64 lines
; 2075-2084), with what it expands to: lpm_rdp_mc = colour; LpmRdpOtherModes(#LPM_RDP_FILL, 0) (lines 1621-1705: the
; slots, then the FROZEN BLOCK inside a mode batch, else BLOCK 1, and when it says send, LpmRdpKick when it says so and
; BLOCK 2 - each block's instructions copied from the library as they stand); LpmRdpSyncPipe() (lines 1138-1140: If
; lpm_rdp_pipe : LpmRdpCmdK_($27000000) : lpm_rdp_pipe = 0); then LpmRdpCmd($37000000, the colour twice at 16 bits, else
; its low 32 bits) by lpm_rdp_bytes. CLOBBERS what a compiled call may.
ProcedureNaked NesShowRdpModeFill(colour.i)
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    la t9, global_lpm_rdp_mc
    sd a0, 0(t9)                     ; lpm_rdp_mc = colour
    la t9, global_lpm_rdp_a0         ; LpmRdpOtherModes(#LPM_RDP_FILL, 0): lpm_rdp_a0 = h_, lpm_rdp_a1 = l_
    lui t0, 0x30
    sd t0, 0(t9)
    sd zero, global_lpm_rdp_a1-global_lpm_rdp_a0(t9)
    ld t0, global_lpm_rdp_mx_fz-global_lpm_rdp_a0(t9)
    beqz t0, nsmf_block1             ; If lpm_rdp_mx_fz
    nop
; -- LpmRdpOtherModes's FROZEN BLOCK (lpm_rdp.n64 lines 1625-1641) --
    la t9, global_lpm_rdp_a0
    ld v0, 0(t9)                             ; hi
    ld v1, global_lpm_rdp_a1-global_lpm_rdp_a0(t9)   ; lo
    dsrl t0, v0, 21
    andi t0, t0, 1
    daddiu t0, t0, -1                        ; all ones: not copy / fill
    ld t1, global_lpm_rdp_zflags-global_lpm_rdp_a0(t9)
    and t1, t1, t0
    or v1, v1, t1                            ; lo with the depth flags, as block 1
    sd v0, global_lpm_rdp_om_hi-global_lpm_rdp_a0(t9)   ; the modes set now: these (sent at the batch's end)
    sd v1, global_lpm_rdp_om_lo-global_lpm_rdp_a0(t9)
    lui t0, 0x30
    and t0, t0, v0
    sd t0, global_lpm_rdp_cycle-global_lpm_rdp_a0(t9)   ; the cycle type: hi & $300000
    ld t0, global_lpm_rdp_mx_fz-global_lpm_rdp_a0(t9)
    ori t0, t0, 2
    sd t0, global_lpm_rdp_mx_fz-global_lpm_rdp_a0(t9)   ; the batch: modes recorded
    b nsmf_pipe
    nop
nsmf_block1:
; -- LpmRdpOtherModes's BLOCK 1 (lpm_rdp.n64 lines 1645-1672) --
    la t9, global_lpm_rdp_a0
    ld v0, 0(t9)                             ; hi
    ld v1, global_lpm_rdp_a1-global_lpm_rdp_a0(t9)   ; lo
    dsrl t0, v0, 21
    andi t0, t0, 1
    daddiu t0, t0, -1                        ; all ones: not copy / fill
    ld t1, global_lpm_rdp_zflags-global_lpm_rdp_a0(t9)
    and t1, t1, t0
    or v1, v1, t1                            ; lo with the depth flags
    sd v1, global_lpm_rdp_a1-global_lpm_rdp_a0(t9)
    ld t0, global_lpm_rdp_cycle-global_lpm_rdp_a0(t9)
    daddiu t0, t0, 1
    sltu t0, zero, t0                        ; 1: a cycle type is set (not -1)
    ld t1, global_lpm_rdp_om_hi-global_lpm_rdp_a0(t9)
    xor t1, t1, v0
    ld t8, global_lpm_rdp_om_lo-global_lpm_rdp_a0(t9)
    xor t8, t8, v1
    or t1, t1, t8
    sltiu t1, t1, 1                          ; 1: both words as set now
    and t0, t0, t1
    xori t0, t0, 1                           ; 1: to send
    sd t0, global_lpm_rdp_a2-global_lpm_rdp_a0(t9)   ; slot 2: send
    ld t8, global_lpm_rdp_ptr-global_lpm_rdp_a0(t9)
    ld t1, global_lpm_rdp_end-global_lpm_rdp_a0(t9)
    daddiu t8, t8, 272                       ; ptr + 16 + #LPM_RDP_ROOM (256)
    slt t1, t1, t8
    and t1, t1, t0
    sd t1, global_lpm_rdp_a3-global_lpm_rdp_a0(t9)   ; slot 3: hand the list over first
    la t9, global_lpm_rdp_a0
    ld t0, global_lpm_rdp_a2-global_lpm_rdp_a0(t9)
    beqz t0, nsmf_pipe               ; If lpm_rdp_a2 (to send)
    nop
    ld t0, global_lpm_rdp_a3-global_lpm_rdp_a0(t9)
    beqz t0, nsmf_block2             ; If lpm_rdp_a3 : LpmRdpKick() : EndIf
    nop
    jal lpmrdpkick
    nop
nsmf_block2:
; -- LpmRdpOtherModes's BLOCK 2 (lpm_rdp.n64 lines 1677-1701) --
    la t9, global_lpm_rdp_a0
    ld t8, global_lpm_rdp_ptr-global_lpm_rdp_a0(t9)   ; the pointer as the program holds it (64-bit)
    sll a0, t8, 0                          ; and as a 32-bit sign-extended address, to store through
    ld t0, global_lpm_rdp_pipe-global_lpm_rdp_a0(t9)
    lui t1, 0x2700
    sw t1, 0(a0)
    sw zero, 4(a0)                         ; SYNC_PIPE, kept only when owed:
    sltu t0, zero, t0
    dsll t0, t0, 3
    daddu t8, t8, t0                       ;   + 8 when lpm_rdp_pipe, else written over
    daddu a0, a0, t0
    sd zero, global_lpm_rdp_pipe-global_lpm_rdp_a0(t9)
    ld v0, 0(t9)                           ; hi
    ld v1, global_lpm_rdp_a1-global_lpm_rdp_a0(t9)   ; lo (with the depth flags)
    lui t0, 0x2F00
    or t0, t0, v0
    sw t0, 0(a0)                           ; SET_OTHER_MODES | hi
    sw v1, 4(a0)
    daddiu t8, t8, 8
    sd t8, global_lpm_rdp_ptr-global_lpm_rdp_a0(t9)
    sd v0, global_lpm_rdp_om_hi-global_lpm_rdp_a0(t9)
    sd v1, global_lpm_rdp_om_lo-global_lpm_rdp_a0(t9)
    lui t0, 0x30
    and t0, t0, v0
    sd t0, global_lpm_rdp_cycle-global_lpm_rdp_a0(t9)   ; the cycle type: hi & $300000
nsmf_pipe:
    la t9, global_lpm_rdp_pipe       ; LpmRdpSyncPipe(): If lpm_rdp_pipe
    ld t0, 0(t9)
    beqz t0, nsmf_colour
    nop
    lui a0, 0x2700
    jal nes_show_rdp_cmdk            ; LpmRdpCmdK_($27000000)
    move a1, zero                    ; (delay slot)
    la t9, global_lpm_rdp_pipe
    sd zero, 0(t9)                   ; lpm_rdp_pipe = 0
nsmf_colour:
    la t9, global_lpm_rdp_bytes
    ld t0, 0(t9)
    la t9, global_lpm_rdp_mc
    ld a1, 0(t9)
    addiu t1, zero, 2
    bne t0, t1, nsmf_c32
    nop
    andi a1, a1, 0xFFFF
    dsll t0, a1, 16
    b nsmf_cmd
    or a1, a1, t0                    ; (delay slot) ((mc & $FFFF) << 16) | (mc & $FFFF)
nsmf_c32:
    dsll32 a1, a1, 0
    dsrl32 a1, a1, 0                 ; mc & $FFFFFFFF
nsmf_cmd:
    jal nesshowrdpcmd                ; LpmRdpCmd($37000000, ...): SET_FILL_COLOR
    lui a0, 0x3700                   ; (delay slot)
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure

; ---- NesShowFrameEnd(): line 240, after the frame's last close (the hot unit, ppu.n64). The frame's fallback rows
; kept for its list; the frame before DETACHED before its set's state is taken by the next frame (a buffer slept for if
; none was free yet: the pacing); this frame attached and detached at once if it can be. NOTHING waits for the RDP
; here: the next frame waits, if at all, at its set's first write (NesShowAcquire).
; THE PLAIN TWIN:
;   Protected p.i = NesShowCur, q.i = NesShowCur ! 1            (the record: tr, w0, s0 as NesShowPollE)
;   NesFbCountP(p) = NesFbN : NesFbOverP(p) = NesFbOver : NesFbFirstP(p) = NesFbFirst : NesShowEnded(p) = 1
;   NesFbHead = (NesFbFirst + NesFbN) % #NES_FB_ROWS
;   NesShowStat(5) + NesFbN
;   If NesFbN > NesShowStat(6) : NesShowStat(6) = NesFbN : EndIf
;   NesShowStat(8) + PeekI(NesUnitBase + #NES_U_BANDLOST)
;   NesShowFrameNo(p) = WorkerFrames
;   NesShowAdvance(2, 1)
;   If NesShowAtt(p) And NesShowDone(p) = 0 : NesShowDetach(p) : EndIf
;   (the checking builds' parts: NesShowFrameEndCheck(p), compiled - below)
;   NesShowSet(q)
;   NesFbGuard = NesFbCountP(p)
;   (the record: NesRecAdd(3, tr) : NesRecT(3) - (NesRecWait - w0) - (NesRecT(9) - s0))
; HOW: s0 p, s1 p x 8 (saved); the record's s5-s7.
ProcedureNaked NesShowFrameEnd()
  ASM
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s5, 24(sp)
    sd s6, 32(sp)
    sd s7, 40(sp)
    la t0, global_nesshowcur
    ld s0, 0(t0)                     ; p
    dsll s1, s0, 3                   ; p x 8
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    jal nes_show_rec_from
    nop
  EndASM
  CompilerEndIf
  ASM
    la t0, global_nesfbn
    ld t1, 0(t0)                     ; NesFbN
    la t0, global_nesfbcountp
    daddu t0, t0, s1
    sd t1, 0(t0)
    la t0, global_nesfbover
    ld t2, 0(t0)
    la t0, global_nesfboverp
    daddu t0, t0, s1
    sd t2, 0(t0)
    la t0, global_nesfbfirst
    ld t2, 0(t0)                     ; NesFbFirst
    la t0, global_nesfbfirstp
    daddu t0, t0, s1
    sd t2, 0(t0)
    la t0, global_nesshowended
    daddu t0, t0, s1
    addiu t3, zero, 1
    sd t3, 0(t0)
    daddu t2, t2, t1                 ; first + n ...
    sltiu t3, t2, #NES_FB_ROWS
    bnez t3, nsfe_head
    nop
    daddiu t2, t2, -#NES_FB_ROWS     ; ... modulo the ring (below 480: one subtraction)
nsfe_head:
    la t0, global_nesfbhead
    sd t2, 0(t0)
    la t0, global_nesshowstat
    ld t2, 40(t0)
    daddu t2, t2, t1
    sd t2, 40(t0)                    ; (5) fallback lines
    ld t2, 48(t0)
    slt t3, t2, t1
    beqz t3, nsfe_lost
    nop
    sd t1, 48(t0)                    ; (6) the most a frame
nsfe_lost:
    la t1, global_nesunitbase
    ld t1, 0(t1)
    ld t1, #NES_U_BANDLOST(t1)
    ld t2, 64(t0)
    daddu t2, t2, t1
    sd t2, 64(t0)                    ; (8) lost bands
    la t0, global_workerframes
    ld t1, 0(t0)
    la t0, global_nesshowframeno
    daddu t0, t0, s1
    sd t1, 0(t0)                     ; NesShowFrameNo(p) = WorkerFrames
    addiu a0, zero, 2
    jal nesshowadvance               ; NesShowAdvance(2, 1)
    addiu a1, zero, 1                ; (delay slot)
    la t0, global_nesshowatt
    daddu t0, t0, s1
    ld t0, 0(t0)
    beqz t0, nsfe_check
    nop
    la t0, global_nesshowdone
    daddu t0, t0, s1
    ld t0, 0(t0)
    bnez t0, nsfe_check
    nop
    jal nesshowdetach                ; this frame attached: detached at once
    move a0, s0                      ; (delay slot)
nsfe_check:
  EndASM
  CompilerIf #VERIFY_FRAME > 0
  ASM
    jal nesshowframeendcheck         ; the checking builds' parts (compiled: string formatting, the checkpoint frame)
    move a0, s0                      ; (delay slot)
  EndASM
  CompilerEndIf
  ASM
    jal nesshowset                   ; NesShowSet(q)
    xori a0, s0, 1                   ; (delay slot)
    la t0, global_nesfbcountp
    daddu t0, t0, s1
    ld t1, 0(t0)
    la t0, global_nesfbguard
    sd t1, 0(t0)                     ; NesFbGuard = NesFbCountP(p): this frame's rows, until it is drawn
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    jal nes_show_rec_to3
    nop
  EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s5, 24(sp)
    ld s6, 32(sp)
    ld s7, 40(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; ---- NesShowSet(p): the current frame takes set p (its state cleared; the last user's kept), then its split lines'
; segment pool (rspband.n64's NesSegFrame, a tail call).
; THE PLAIN TWIN:
;   NesShowPrevTicket(p) = NesShowTicket(p) : NesShowPrevShown(p) = NesShowShown(p)
;   NesShowPrevFrameNo(p) = NesShowFrameNo(p) : NesShowPrevFbN(p) = NesFbCountP(p) : NesShowPrevBands(p) = NesShowBands(p)
;   NesShowFree(p) = 0 : NesShowFreeCur = 0 : NesShowAtt(p) = 0 : NesShowTicket(p) = 0
;   NesShowCur = p
;   NesShowDone(p) = 0 : NesShowEnded(p) = 0 : NesShowBands(p) = 0 : NesShowFb(p) = 0 : NesShowShown(p) = 0
;   NesFbN = 0 : NesFbOver = 0
;   NesFbFirst = NesFbHead
;   NesFbRowBase = NesFbRows : NesFbPalBase = NesFbPals
;   NesFbLineBase = @NesFbLine(p * #NES_FB_ROWS)
;   NesSegFrame(p)
; (Each element read before it is cleared; no two of these names share storage, so the order of the rest is free.)
ProcedureNaked NesShowSet(p.i)
  ASM
    dsll t0, a0, 3                   ; p x 8
    la t1, global_nesshowticket
    daddu t1, t1, t0
    ld t2, 0(t1)
    la t3, global_nesshowprevticket
    daddu t3, t3, t0
    sd t2, 0(t3)                     ; NesShowPrevTicket(p) = NesShowTicket(p)
    sd zero, 0(t1)                   ; NesShowTicket(p) = 0
    la t1, global_nesshowshown
    daddu t1, t1, t0
    ld t2, 0(t1)
    la t3, global_nesshowprevshown
    daddu t3, t3, t0
    sd t2, 0(t3)                     ; NesShowPrevShown(p) = NesShowShown(p)
    sd zero, 0(t1)                   ; NesShowShown(p) = 0
    la t1, global_nesshowframeno
    daddu t1, t1, t0
    ld t2, 0(t1)
    la t3, global_nesshowprevframeno
    daddu t3, t3, t0
    sd t2, 0(t3)                     ; NesShowPrevFrameNo(p) = NesShowFrameNo(p)
    la t1, global_nesfbcountp
    daddu t1, t1, t0
    ld t2, 0(t1)
    la t3, global_nesshowprevfbn
    daddu t3, t3, t0
    sd t2, 0(t3)                     ; NesShowPrevFbN(p) = NesFbCountP(p)
    la t1, global_nesshowbands
    daddu t1, t1, t0
    ld t2, 0(t1)
    la t3, global_nesshowprevbands
    daddu t3, t3, t0
    sd t2, 0(t3)                     ; NesShowPrevBands(p) = NesShowBands(p)
    sd zero, 0(t1)                   ; NesShowBands(p) = 0
    la t1, global_nesshowfree
    daddu t1, t1, t0
    sd zero, 0(t1)
    la t1, global_nesshowatt
    daddu t1, t1, t0
    sd zero, 0(t1)
    la t1, global_nesshowdone
    daddu t1, t1, t0
    sd zero, 0(t1)
    la t1, global_nesshowended
    daddu t1, t1, t0
    sd zero, 0(t1)
    la t1, global_nesshowfb
    daddu t1, t1, t0
    sd zero, 0(t1)
    la t1, global_nesshowfreecur
    sd zero, 0(t1)
    la t1, global_nesshowcur
    sd a0, 0(t1)                     ; NesShowCur = p
    la t1, global_nesfbn
    sd zero, 0(t1)
    la t1, global_nesfbover
    sd zero, 0(t1)
    la t1, global_nesfbhead
    ld t2, 0(t1)
    la t1, global_nesfbfirst
    sd t2, 0(t1)                     ; NesFbFirst = NesFbHead
    la t1, global_nesfbrows
    ld t2, 0(t1)
    la t1, global_nesfbrowbase
    sd t2, 0(t1)
    la t1, global_nesfbpals
    ld t2, 0(t1)
    la t1, global_nesfbpalbase
    sd t2, 0(t1)
    addiu t1, zero, #NES_SHOW_FB_LINE_BYTES
    dmultu a0, t1
    mflo t1                          ; p x #NES_FB_ROWS x 8
    la t2, global_nesfbline
    daddu t2, t2, t1
    la t1, global_nesfblinebase
    j nessegframe                    ; NesSegFrame(p) (a0 = p)
    sd t2, 0(t1)                     ; (delay slot) NesFbLineBase = @NesFbLine(p * #NES_FB_ROWS)
  EndASM
EndProcedure

; ---- NesShowAcquire(): THE SET TAKEN AT ITS FIRST WRITE (N.62; the frame's first band close, or its first split
; line's segment pool): the frame that used it last must be drawn - in practice long since. Its status read once now
; (its RSP clocks, words that did not fit), its picture checked.
; THE PLAIN TWIN:
;   Protected p.i = NesShowCur, st.i, tr.i, w0.i, s0.i
;   If NesShowFreeCur : ProcedureReturn : EndIf
;   (the record: tr, w0, s0 as NesShowPollE)
;   If NesShowPrevTicket(p) And LpmRdpFramesDone() < NesShowPrevTicket(p)
;     NesShowStat(3) + 1
;     NesShowSleepDrawn(NesShowPrevTicket(p))
;   EndIf
;   If NesShowPrevBands(p)
;     st = NesShowArea(p) + #NES_SHOW_WORDS * 8
;     NesShowStat(12) + (PeekL(st + 8) & $FFFFFFFF)
;     If (PeekL(st + 8) & $FFFFFFFF) > NesShowStat(13) : NesShowStat(13) = PeekL(st + 8) & $FFFFFFFF : EndIf
;     If PeekL(st + 4) : NesShowStat(2) + 1 : EndIf
;   EndIf
;   NesShowCheckPrev(p)
;   NesShowPrevBands(p) = 0
;   NesShowFree(p) = 1 : NesShowFreeCur = 1
;   (the record: NesRecAdd(3, tr) : NesRecT(3) - (NesRecWait - w0) - (NesRecT(9) - s0))
; HOW: the status word +8 read ONCE (uncached; the twin reads it up to three times: the frame is drawn - its SYNC_FULL
; came after every job of it - so the RSP no longer writes it). The area's KSEG1 address is held as a positive number
; (the compiled `| $A0000000`): sign-extended (sll x, x, 0) to read through. s0 p, s1 p x 8; the record's s5-s7.
ProcedureNaked NesShowAcquire()
  ASM
    la t0, global_nesshowfreecur
    ld t0, 0(t0)
    beqz t0, nsq_take
    nop
    jr ra                            ; the set taken already this frame
    nop
nsq_take:
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s5, 24(sp)
    sd s6, 32(sp)
    sd s7, 40(sp)
    la t0, global_nesshowcur
    ld s0, 0(t0)                     ; p
    dsll s1, s0, 3
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    jal nes_show_rec_from
    nop
  EndASM
  CompilerEndIf
  ASM
    la t0, global_nesshowprevticket
    daddu t0, t0, s1
    ld a0, 0(t0)                     ; the ticket of the frame that used set p last
    beqz a0, nsq_status
    nop
    la t1, global_lpm_rdp_frames_done
    ld t1, 0(t1)
    slt t1, t1, a0
    beqz t1, nsq_status              ; drawn
    nop
    la t0, global_nesshowstat
    ld t1, 24(t0)
    daddiu t1, t1, 1
    sd t1, 24(t0)                    ; (3) waits
    jal nesshowsleepdrawn            ; (a0 = the ticket)
    nop
nsq_status:
    la t0, global_nesshowprevbands
    daddu t0, t0, s1
    ld t0, 0(t0)
    beqz t0, nsq_check
    nop
    la t0, global_nesshowarea
    daddu t0, t0, s1
    ld t0, 0(t0)
    ori t1, zero, 0x8000             ; #NES_SHOW_WORDS x 8 (the guard above): the status after the words
    daddu t0, t0, t1
    sll t0, t0, 0                    ; KSEG1, sign-extended
    lwu t1, 8(t0)                    ; its RSP clocks
    lw t2, 4(t0)                     ; words that did not fit
    la t3, global_nesshowstat
    ld t8, 96(t3)
    daddu t8, t8, t1
    sd t8, 96(t3)                    ; (12) RSP clocks
    ld t8, 104(t3)
    slt t9, t8, t1
    beqz t9, nsq_fit
    nop
    sd t1, 104(t3)                   ; (13) the most a frame
nsq_fit:
    beqz t2, nsq_check
    nop
    ld t8, 16(t3)
    daddiu t8, t8, 1
    sd t8, 16(t3)                    ; (2) shown as far as they went, counted
nsq_check:
    jal nesshowcheckprev             ; its picture (the record's hashes; the checking build's hash)
    move a0, s0                      ; (delay slot)
    la t0, global_nesshowprevbands
    daddu t0, t0, s1
    sd zero, 0(t0)
    addiu t1, zero, 1
    la t0, global_nesshowfree
    daddu t0, t0, s1
    sd t1, 0(t0)                     ; NesShowFree(p) = 1
    la t0, global_nesshowfreecur
    sd t1, 0(t0)                     ; NesShowFreeCur = 1
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    jal nes_show_rec_to3
    nop
  EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s5, 24(sp)
    ld s6, 32(sp)
    ld s7, 40(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; ---- NesShowSleepDrawn(t): sleep (not spin) until the RDP has finished picture ticket t: the DP, VI and AI interrupts
; wake it, the sound is fed meanwhile. (The console record counts it as slept, as the sleep for a buffer.)
; THE PLAIN TWIN:
;   Protected seen.i
;   If LpmRdpFramesDone() >= t : ProcedureReturn : EndIf
;   CompilerIf #NES_CONSOLE_RECORD : NesRecWaitFrom = LpmCpuCount() : NesRecWaitSyn = NesRecT(9) : CompilerEndIf
;   seen = LpmIrqSeen(#LPM_WAKE_DP | #LPM_WAKE_VI | #LPM_WAKE_AI)
;   While LpmRdpFramesDone() < t
;     seen = LpmIrqSleep(#LPM_WAKE_DP | #LPM_WAKE_VI | #LPM_WAKE_AI, seen, #LPM_WAIT_TICK, 0, 0)
;     HostQueueAudio(ApuProduced)
;   Wend
;   CompilerIf #NES_CONSOLE_RECORD
;     NesRecWait + ((LpmCpuCount() - NesRecWaitFrom) & $FFFFFFFF) - (NesRecT(9) - NesRecWaitSyn)
;   CompilerEndIf
; HOW: s0 t, s1 seen (saved).
ProcedureNaked NesShowSleepDrawn(t.i)
  ASM
    la t0, global_lpm_rdp_frames_done
    ld t0, 0(t0)
    slt t0, t0, a0
    bnez t0, nssd_sleep
    nop
    jr ra                            ; drawn already
    nop
nssd_sleep:
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    move s0, a0
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    mfc0 t1, $9
    nop
    dsll32 t1, t1, 0
    dsrl32 t1, t1, 0
    la t0, global_nesrecwaitfrom
    sd t1, 0(t0)
    la t0, global_nesrect
    ld t1, 72(t0)
    la t0, global_nesrecwaitsyn
    sd t1, 0(t0)
  EndASM
  CompilerEndIf
  ASM
    jal lpmirqseen
    addiu a0, zero, #NES_SHOW_WAKE_DRAWN   ; (delay slot)
    move s1, a0
nssd_loop:
    la t0, global_lpm_rdp_frames_done
    ld t0, 0(t0)
    slt t0, t0, s0
    beqz t0, nssd_done
    nop
    addiu a0, zero, #NES_SHOW_WAKE_DRAWN
    move a1, s1
    lui a2, 0x7
    ori a2, a2, 0x270E               ; #LPM_WAIT_TICK
    move a3, zero
    jal lpmirqsleep
    move a4, zero                    ; (delay slot)
    move s1, a0
    la t0, global_apuproduced
    jal hostqueueaudio
    ld a0, 0(t0)                     ; (delay slot)
    b nssd_loop
    nop
nssd_done:
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    mfc0 t1, $9
    nop
    la t0, global_nesrecwaitfrom
    ld t2, 0(t0)
    dsubu t1, t1, t2
    dsll32 t1, t1, 0
    dsrl32 t1, t1, 0
    la t0, global_nesrect
    ld t2, 72(t0)
    la t0, global_nesrecwaitsyn
    ld t3, 0(t0)
    dsubu t2, t2, t3
    la t0, global_nesrecwait
    ld t3, 0(t0)
    daddu t3, t3, t1
    dsubu t3, t3, t2
    sd t3, 0(t0)
  EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    jr ra
    daddiu sp, sp, 32
  EndASM
EndProcedure

CompilerIf #NES_SHOW_CHECK = 0
; ---- NesShowCheckPrev(p) (the record's and the builds without the check): the record's picture hashes
; (console_record.n64's NesRecPicture: its own ticks out of the hand-over's), while no button has been seen; then the
; set's last frame forgotten.
; THE PLAIN TWIN:
;   CompilerIf #NES_CONSOLE_RECORD
;     NesRecPicture(NesShowPrevFrameNo(p), NesShowPrevShown(p), NesShowPrevFbN(p))
;   CompilerEndIf
;   NesShowPrevShown(p) = 0
ProcedureNaked NesShowCheckPrev(p.i)
  ASM
    dsll t3, a0, 3                   ; p x 8
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    sd s0, 8(sp)
    move s0, t3
    la t0, global_nesshowprevframeno
    daddu t0, t0, s0
    ld a0, 0(t0)
    la t0, global_nesshowprevshown
    daddu t0, t0, s0
    ld a1, 0(t0)
    la t0, global_nesshowprevfbn
    daddu t0, t0, s0
    jal nesrecpicture
    ld a2, 0(t0)                     ; (delay slot)
    move t3, s0
    ld ra, 0(sp)
    ld s0, 8(sp)
    daddiu sp, sp, 16
  EndASM
  CompilerEndIf
  ASM
    la t0, global_nesshowprevshown
    daddu t0, t0, t3
    jr ra
    sd zero, 0(t0)                   ; (delay slot) NesShowPrevShown(p) = 0
  EndASM
EndProcedure
CompilerEndIf

CompilerIf #NES_CONSOLE_RECORD
; ---- the record's hand-over part, shared by the procedures above (record build only). Entered by jal at its labels:
; nes_show_rec_from - OUT s5 = Count (as LpmCpuCount gives it), s6 = NesRecWait, s7 = NesRecT(9); CLOBBERS t0 (the
;   caller has saved s5-s7; a0, a1 kept).
; nes_show_rec_to3 - IN s5-s7: NesRecAdd(3, s5) : NesRecT(3) - (NesRecWait - s6) - (NesRecT(9) - s7); CLOBBERS t0-t3, t8.
ProcedureNaked NesShowRecPart()
  ASM
nes_show_rec_from:
    mfc0 s5, $9
    nop
    dsll32 s5, s5, 0
    dsrl32 s5, s5, 0
    la t0, global_nesrecwait
    ld s6, 0(t0)
    la t0, global_nesrect
    jr ra
    ld s7, 72(t0)                    ; (delay slot) NesRecT(9)
nes_show_rec_to3:
    mfc0 t1, $9
    nop
    dsubu t1, t1, s5
    dsll32 t1, t1, 0
    dsrl32 t1, t1, 0                 ; the ticks since
    la t0, global_nesrecwait
    ld t2, 0(t0)
    dsubu t2, t2, s6                 ; slept for a buffer meanwhile (the record's own column)
    la t0, global_nesrect
    ld t3, 72(t0)
    dsubu t3, t3, s7                 ; synthesised meanwhile (its own part)
    ld t8, 24(t0)
    daddu t8, t8, t1
    dsubu t8, t8, t2
    dsubu t8, t8, t3
    jr ra
    sd t8, 24(t0)                    ; (delay slot) NesRecT(3)
  EndASM
EndProcedure
CompilerEndIf
; ---- NesShowSetupCmd(p): NES_RSP_SETUP names the RSP's name-table image and the frame set's areas: sent when the set
; is not the one the program has (once a frame). The library's 7-argument command through its callable form,
; LpmRspqCmd7Slow (nine arguments: the ninth, g, at 0(sp) - the convention's).
; THE PLAIN TWIN:
;   NesShowSetupP = p
;   LpmRspqCmd7(NesShowProg, #NES_RSP_SETUP, NesNtImage & $1FFFFFFF, NesChrMaskBase & $1FFFFFFF, @Rgb64(0) & $1FFFFFFF, NesChrPairBase & $1FFFFFFF, NesShowTlut(p) & $1FFFFFFF, NesShowTlut(p) & $1FFFFFFF, NesShowArea(p) & $1FFFFFFF)
ProcedureNaked NesShowSetupCmd(p.i)
  ASM
    daddiu sp, sp, -16
    sd ra, 8(sp)
    la t0, global_nesshowsetupp
    sd a0, 0(t0)                     ; NesShowSetupP = p
    lui t9, 0x1FFF
    ori t9, t9, 0xFFFF               ; physical addresses
    dsll t0, a0, 3
    la t1, global_nesshowarea
    daddu t1, t1, t0
    ld t1, 0(t1)
    and t1, t1, t9
    sd t1, 0(sp)                     ; g: the frame area (the ninth argument)
    la t1, global_nesshowtlut
    daddu t1, t1, t0
    ld a6, 0(t1)
    and a6, a6, t9                   ; e: the TLUT set
    move a7, a6                      ; f: the same
    la t0, global_nesntimage
    ld a2, 0(t0)
    and a2, a2, t9                   ; a: the name-table image
    la t0, global_neschrmaskbase
    ld a3, 0(t0)
    and a3, a3, t9                   ; b: the CHR masks
    la a4, global_rgb64
    and a4, a4, t9                   ; c: the colours
    la t0, global_neschrpairbase
    ld a5, 0(t0)
    and a5, a5, t9                   ; d: the pairs
    la t0, global_nesshowprog
    ld a0, 0(t0)
    jal lpmrspqcmd7slow
    addiu a1, zero, #NES_RSP_SETUP   ; (delay slot)
    ld ra, 8(sp)
    daddiu sp, sp, 16
    jr ra                            ; (THE RUN's last instruction is this delay slot's nop: the layout unit ends here)
    nop
  EndASM
EndProcedure

; ---- (the end of the pinned run) ----

; The checking builds' parts of the frame end (#VERIFY_FRAME > 0; NesShowFrameEnd calls it after its detach, before
; the set is taken): compiled on purpose - string formatting through the library, and the checkpoint frame's finish -
; the checking build, not the emulator. Its body is the compiled NesShowFrameEnd's, unchanged.
CompilerIf #VERIFY_FRAME > 0
Procedure NesShowFrameEndCheck(p.i)
  Protected q.i = p ! 1
  CompilerIf #NES_SHOW_CHECK
    If WorkerFrames = 300                 ; one frame's bands by line and inputs, for the record
      Protected k.i, s.s = "NES SHOW BANDS 300"
      For k = 0 To PeekI(NesUnitBase + #NES_U_BANDCOUNT) - 1
        s = s + " " + Str(PeekI(NesBandBase + k * #NES_BAND_BYTES)) + "-" + Str(PeekI(NesBandBase + k * #NES_BAND_BYTES + 8)) + ":" + Hex(PeekI(NesBandBase + k * #NES_BAND_BYTES + 24))
      Next
      LpmDebugPrint(s + " LOST " + Str(PeekI(NesUnitBase + #NES_U_BANDLOST)))
    EndIf
  CompilerEndIf
  If WorkerFrames + 1 = #VERIFY_FRAME   ; a screenshot checkpoint shows its frame: both frames finished, drawn,
    If NesShowDone(p) = 0               ; checked in order
      If NesShowAtt(p) = 0 : NesShowAttach(p, 2) : EndIf
      If NesShowDone(p) = 0 : NesShowDetach(p) : EndIf
    EndIf
    NesShowSleepDrawn(NesShowTicket(p))
    CompilerIf #NES_SHOW_CHECK
      LpmRdpFinish()
      NesShowPrevShown(q) = NesShowShown(q) : NesShowPrevFrameNo(q) = NesShowFrameNo(q) : NesShowPrevFbN(q) = NesFbCountP(q)
      If NesShowEnded(q) : NesShowCheckPrev(q) : EndIf
      NesShowShown(q) = 0
      NesShowPrevShown(p) = NesShowShown(p) : NesShowPrevFrameNo(p) = NesShowFrameNo(p) : NesShowPrevFbN(p) = NesFbCountP(p)
      NesShowCheckPrev(p)
      NesShowShown(p) = 0
    CompilerEndIf
  EndIf
EndProcedure
CompilerEndIf

; The unit's way in (NesSegFirst, a split line's first cut): every register kept.
ProcedureNaked NesShowAcquireCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nesshowacquire
    nop
    j nes_show_restore
    nop
  EndASM
EndProcedure

; ---- NesShowFallback(p): the frame's fallback lines, after its last band (cold: only a frame with such lines does
; more than the first test). The syncs and modes as NesShowRdpAdopt, then the old blit's calls in copy mode - A RUN OF
; LINES AT A TIME (design note N.27, fix 3): lines y, y + 1, ... in consecutive ring rows (no wrap between them) whose
; palettes are the same, at most 8 (8 rows x 256 bytes of CI8 = the 2 KB of TMEM a colour-indexed texture may take
; beside its palette), are one palette load, one 256 x k texture load and one k-line rectangle: the same texels through
; the same TLUT into the same pixels as k single lines.
; THE PLAIN TWIN:
;   Protected i.i, y.i, r.i, k.i, n.i = NesFbCountP(p), tr.i, run.i
;   If n = 0 : ProcedureReturn : EndIf
;   (the record: tr = LpmCpuCount())
;   NesShowRdpAdopt() : LpmRdpModeCopy(0)
;   i = 0
;   While i < n
;     y = NesFbLine(p * #NES_FB_ROWS + i) : r = (NesFbFirstP(p) + i) % #NES_FB_ROWS
;     k = 1 : run = 1
;     While run
;       run = 0
;       If k < 8 And i + k < n And r + k < #NES_FB_ROWS
;         If NesFbLine(p * #NES_FB_ROWS + i + k) = y + k
;           If NesFbPalSame(NesFbPals + r * 64, NesFbPals + (r + k) * 64) : k + 1 : run = 1 : EndIf
;         EndIf
;       EndIf
;     Wend
;     LpmRdpLoadPalette(NesFbPals + r * 64, 0, 32)
;     LpmRdpLoadTexture(NesFbRows + r * 256, 256, k, #LPM_TEX_CI8)
;     LpmRdpTextureRect(32, y, 288, y + k, 0, 0, 1024, 1024)
;     i + k
;   Wend
;   (the record: NesRecAdd(2, tr))
; with NesFbPalSame(a, b) = 1 when the two 64-byte palettes' 8 doublewords are equal (folded in here).
; HOW: s0 n, s1 i, s2 the set's line table, s3 NesFbFirstP(p), s4 y, s5 r, s6 k, s7 tr (saved).
ProcedureNaked NesShowFallback(p.i)
  ASM
    dsll t0, a0, 3
    la t1, global_nesfbcountp
    daddu t1, t1, t0
    ld t1, 0(t1)                     ; n
    bnez t1, nsfb_lines
    nop
    jr ra                            ; no fallback line (the usual frame)
    nop
nsfb_lines:
    daddiu sp, sp, -80
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    sd s4, 40(sp)
    sd s5, 48(sp)
    sd s6, 56(sp)
    sd s7, 64(sp)
    move s0, t1                      ; n
    la t1, global_nesfbfirstp
    daddu t1, t1, t0
    ld s3, 0(t1)                     ; the frame's first ring row
    addiu t1, zero, #NES_SHOW_FB_LINE_BYTES
    dmultu a0, t1
    mflo t1
    la s2, global_nesfbline
    daddu s2, s2, t1                 ; @NesFbLine(p * #NES_FB_ROWS)
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    mfc0 s7, $9
    nop
    dsll32 s7, s7, 0
    dsrl32 s7, s7, 0                 ; tr
  EndASM
  CompilerEndIf
  ASM
    jal nesshowrdpadopt
    nop
    jal lpmrdpmodecopy
    move a0, zero                    ; (delay slot) LpmRdpModeCopy(0)
    move s1, zero                    ; i
nsfb_line:
    dsll t0, s1, 3
    daddu t0, s2, t0
    ld s4, 0(t0)                     ; y
    daddu s5, s3, s1
    sltiu t0, s5, #NES_FB_ROWS
    bnez t0, nsfb_r
    nop
    daddiu s5, s5, -#NES_FB_ROWS     ; r = (first + i) mod the ring
nsfb_r:
    addiu s6, zero, 1                ; k
nsfb_run:
    slti t0, s6, 8
    beqz t0, nsfb_draw               ; k < 8
    daddu t1, s1, s6                 ; (delay slot) i + k
    slt t0, t1, s0
    beqz t0, nsfb_draw               ; i + k < n
    daddu t2, s5, s6                 ; (delay slot) r + k
    slti t0, t2, #NES_FB_ROWS
    beqz t0, nsfb_draw               ; r + k < the ring's rows
    dsll t1, t1, 3                   ; (delay slot)
    daddu t1, s2, t1
    ld t1, 0(t1)
    daddu t3, s4, s6
    bne t1, t3, nsfb_draw            ; row i + k is not line y + k
    nop
    la t0, global_nesfbpals
    ld t0, 0(t0)
    dsll t1, s5, 6
    daddu t1, t0, t1                 ; row r's palette
    dsll t3, t2, 6
    daddu t3, t0, t3                 ; row r + k's
    daddiu t8, t1, 64
nsfb_pal:
    ld t0, 0(t1)
    ld t9, 0(t3)
    bne t0, t9, nsfb_draw            ; not the same palette
    daddiu t1, t1, 8                 ; (delay slot)
    bne t1, t8, nsfb_pal
    daddiu t3, t3, 8                 ; (delay slot)
    b nsfb_run
    daddiu s6, s6, 1                 ; (delay slot) k + 1
nsfb_draw:
    la t0, global_nesfbpals
    ld t0, 0(t0)
    dsll a0, s5, 6
    daddu a0, t0, a0
    move a1, zero
    jal lpmrdploadpalette            ; LpmRdpLoadPalette(NesFbPals + r * 64, 0, 32)
    addiu a2, zero, 32               ; (delay slot)
    la t0, global_nesfbrows
    ld t0, 0(t0)
    dsll a0, s5, 8
    daddu a0, t0, a0
    addiu a1, zero, 256
    move a2, s6
    jal lpmrdploadtexture            ; LpmRdpLoadTexture(NesFbRows + r * 256, 256, k, #LPM_TEX_CI8)
    addiu a3, zero, #LPM_TEX_CI8     ; (delay slot)
    addiu a0, zero, 32
    move a1, s4
    addiu a2, zero, 288
    daddu a3, s4, s6
    move a4, zero
    move a5, zero
    addiu a6, zero, 1024
    jal lpmrdptexturerect            ; LpmRdpTextureRect(32, y, 288, y + k, 0, 0, 1024, 1024)
    addiu a7, zero, 1024             ; (delay slot)
    daddu s1, s1, s6                 ; i + k
    slt t0, s1, s0
    bnez t0, nsfb_line
    nop
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    addiu a0, zero, 2
    jal nesrecadd                    ; NesRecAdd(2, tr): the fallback list
    move a1, s7                      ; (delay slot)
  EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    ld s6, 56(sp)
    ld s7, 64(sp)
    jr ra
    daddiu sp, sp, 80
  EndASM
EndProcedure

CompilerIf #NES_SHOW_CHECK
; The shown picture's hash: IN a0 the first kept pixel (KSEG0, invalidated), a1 the kept bytes of a row (a multiple
; of 8), a2 the kept rows (1 or more), a3 the bytes from a row's last kept pixel to the next row's first. Each row's
; kept pixels a doubleword (4 pixels) at a time, rotate-xor-add as the video digest, into NesShowHash. CLOBBERS a0-a4,
; t0-t3.
ProcedureNaked NesShowHashFbAsm(at.i, rowbytes.i, rows.i, skip.i)
  ASM
    sll a0, a0, 0
    la t0, global_nesshowhash
    ld t3, 0(t0)
nes_show_hash_row:
    daddu a4, a0, a1                 ; the row's end of kept pixels
nes_show_hash_px:
    ld t1, 0(a0)
    daddiu a0, a0, 8
    xor t3, t3, t1
    dsll t2, t3, 7
    dsrl32 t3, t3, 25
    or t3, t3, t2                    ; rotated left 7
    bne a0, a4, nes_show_hash_px
    daddu t3, t3, t1                 ; (delay slot) + the doubleword
    daddu a0, a0, a3                 ; the next row's first kept pixel
    addiu a2, a2, -1
    bnez a2, nes_show_hash_row
    nop
    jr ra
    sd t3, 0(t0)
  EndASM
EndProcedure

; Every pixel of the buffer outside the NES columns kept, ORed: IN a0 the buffer (KSEG0, invalidated, 320 x 240 x 2),
; a1 the bytes of a row before the first kept column, a2 the byte offset of the first column after the last kept one.
; For each of the 240 rows the doublewords [0, a1) and [a2, 640) ORed into NesShowBorder (all zero but the alpha bit
; = black). CLOBBERS a0-a4, t0, t1, t3.
ProcedureNaked NesShowBorderAsm(fb.i, left.i, right.i)
  ASM
    sll a0, a0, 0
    daddu t3, zero, zero
    addiu a3, zero, 240
nes_show_bd_row:
    daddu a4, a0, a1                 ; the left part's end
    daddu t0, a0, zero
nes_show_bd_l:
    ld t1, 0(t0)
    daddiu t0, t0, 8
    bne t0, a4, nes_show_bd_l
    or t3, t3, t1                    ; (delay slot)
    daddu t0, a0, a2                 ; the right part's start
    daddiu a4, a0, 640               ; the row's end
nes_show_bd_r:
    ld t1, 0(t0)
    daddiu t0, t0, 8
    bne t0, a4, nes_show_bd_r
    or t3, t3, t1                    ; (delay slot)
    daddiu a0, a0, 640
    addiu a3, a3, -1
    bnez a3, nes_show_bd_row
    nop
    la t0, global_nesshowborder
    jr ra
    sd t3, 0(t0)
  EndASM
EndProcedure

Procedure NesShowHashFb(fb.i)
  Protected r.i, x.i, v.i
  NesShowHashFbAsm(fb + #NES_CROP_Y * 640 + (32 + #NES_CROP_X) * 2, (256 - 2 * #NES_CROP_X) * 2, 240 - 2 * #NES_CROP_Y, 640 - (256 - 2 * #NES_CROP_X) * 2)
  NesShowBorderAsm(fb, (32 + #NES_CROP_X) * 2, (288 - #NES_CROP_X) * 2)
  CompilerIf #NES_CROP_Y > 0               ; the cropped lines' middles
    For r = 0 To 239
      If r < #NES_CROP_Y Or r >= 240 - #NES_CROP_Y
        For x = (32 + #NES_CROP_X) * 2 To (288 - #NES_CROP_X) * 2 - 8 Step 8 : NesShowBorder = NesShowBorder | PeekI(fb + r * 640 + x) : Next
      EndIf
    Next
  CompilerEndIf
  v = NesShowBorder
  NesShowBorder = (v & $FFFE) | ((v >> 16) & $FFFE) | ((v >> 32) & $FFFE) | ((v >> 48) & $FFFE)   ; colour bits only
EndProcedure

; The picture of set p's last frame hashed (drawn: NesShowAcquire, or the run's end; its buffer is on screen or
; waiting for its field, or free - no frame draws into it before the next frame is attached) and printed as "NES PIC
; frame hash fallback-lines" - or NOT SHOWN.
Procedure NesShowCheckPrev(p.i)
  Protected fb.i = NesShowPrevShown(p)
  If NesShowPrevFrameNo(p) = 0 And fb = 0 : ProcedureReturn : EndIf   ; (no frame before the first)
  If fb
    fb = (fb & $1FFFFFFF) | $80000000
    LpmCacheInvalidateData(fb, #HOST_WIDTH * #HOST_HEIGHT * 2)
    NesShowHash = $351B5058
    NesShowHashFb(fb)
    LpmDebugPrint("NES PIC " + Str(NesShowPrevFrameNo(p)) + " " + Hex(NesShowHash) + " " + Str(NesShowPrevFbN(p)))
    If NesShowBorder
      NesShowBorderBad + 1
      LpmDebugPrint("NES PIC BORDER " + Str(NesShowPrevFrameNo(p)) + " " + Hex(NesShowBorder))
    EndIf
  Else
    LpmDebugPrint("NES PIC " + Str(NesShowPrevFrameNo(p)) + " NOT SHOWN " + Str(NesShowPrevFbN(p)))
  EndIf
  NesShowPrevShown(p) = 0 : NesShowPrevFrameNo(p) = 0
EndProcedure
CompilerEndIf

; ---- NesFbWait(): the ring's next row is the frame before's, which may not be drawn yet: finished, its SYNC_FULL
; slept for. Assembly (N.73). REACHED BY: a frame needing more fallback rows than the ring leaves (240 less the frame
; before's) - never in the proof set (0 fallback lines); a test cart drawing 121+ fallback lines in each of two
; frames under --show-check would.
; THE PLAIN TWIN:
;   Protected q.i = NesShowCur ! 1
;   NesShowAdvance(2, 0)
;   NesShowSleepDrawn(NesShowTicket(q))
;   NesFbGuard = 0 : NesShowStat(3) + 1
ProcedureNaked NesFbWait()
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    sd s0, 8(sp)
    la t0, global_nesshowcur
    ld s0, 0(t0)
    xori s0, s0, 1                   ; q
    addiu a0, zero, 2
    jal nesshowadvance               ; NesShowAdvance(2, 0)
    move a1, zero                    ; (delay slot)
    la t0, global_nesshowticket
    dsll t1, s0, 3
    daddu t0, t0, t1
    jal nesshowsleepdrawn            ; its picture drawn
    ld a0, 0(t0)                     ; (delay slot)
    la t0, global_nesfbguard
    sd zero, 0(t0)
    la t0, global_nesshowstat
    ld t1, 24(t0)
    daddiu t1, t1, 1
    sd t1, 24(t0)                    ; (3) waits
    ld ra, 0(sp)
    ld s0, 8(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure

; ---- NesShowDrain(): a CHR-RAM row write while band jobs or handed words may still read the pairs (NesChrPairAt).
; Every job run, the frame before handed whole, the current frame's bands so far handed, the RDP finished (nothing
; shown); the current frame's next band then starts the RSP's state again. Assembly (N.73). REACHED BY: a CHR-RAM cart
; writing pattern rows while the frame's bands are queued - none of the proof set (SMB3 / MM4 / the two test carts:
; "DRAINS 0"); a CHR-RAM game (or test cart) under --show-check / --rsp-check would.
; THE PLAIN TWIN:
;   Protected p.i = NesShowCur                       (the record: tr, w0, s0 as NesShowPollE)
;   LpmRspqSync()
;   NesShowAdvance(2, 0)
;   If NesShowBands(p)
;     If NesShowAtt(p) = 0
;       NesShowAttach(p, 2)
;       LpmRspqCmd(NesShowProg, #NES_RSP_BAND, 0, NesShowArea(p) & $1FFFFFFF, p | 256)
;     Else
;       LpmRspqCmd(NesShowProg, #NES_RSP_BAND, 0, NesShowArea(p) & $1FFFFFFF, p | 256)
;     EndIf
;     LpmRspqSync()
;     NesShowBands(p) = 0 : NesShowAtt(p) = 0
;   EndIf
;   LpmRdpFinish()
;   NesShowBusy = 0 : NesShowStat(4) + 1
;   (the record: NesRecAdd(3, tr) : NesRecT(3) - (NesRecWait - w0) - (NesRecT(9) - s0))
; HOW: s0 p, s1 p x 8; the record's s5-s7 (saved). The two branches' commands are the same: written once.
ProcedureNaked NesShowDrain()
  ASM
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s5, 24(sp)
    sd s6, 32(sp)
    sd s7, 40(sp)
    la t0, global_nesshowcur
    ld s0, 0(t0)
    dsll s1, s0, 3
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    jal nes_show_rec_from
    nop
  EndASM
  CompilerEndIf
  ASM
    jal lpmrspqsync                  ; every job run
    nop
    addiu a0, zero, 2
    jal nesshowadvance               ; the frame before attached and detached
    move a1, zero                    ; (delay slot)
    la t0, global_nesshowbands
    daddu t0, t0, s1
    ld t0, 0(t0)
    beqz t0, nsdr_finish             ; no band of this frame yet
    nop
    la t0, global_nesshowatt
    daddu t0, t0, s1
    ld t0, 0(t0)
    bnez t0, nsdr_hand
    nop
    move a0, s0
    jal nesshowattach                ; NesShowAttach(p, 2)
    addiu a1, zero, 2                ; (delay slot)
nsdr_hand:
    la t0, global_nesshowarea
    daddu t0, t0, s1
    ld a3, 0(t0)
    lui t1, 0x1FFF
    ori t1, t1, 0xFFFF
    and a3, a3, t1                   ; b: the frame area, physical
    move a2, zero                    ; a: record 0 (the HAND step)
    ori a4, s0, 256                  ; c: p | 256 (the rest; the attachment ends)
    la t0, global_nesshowprog
    ld a0, 0(t0)
    jal lpmrspqcmdcall
    addiu a1, zero, #NES_RSP_BAND    ; (delay slot)
    jal lpmrspqsync
    nop
    la t0, global_nesshowbands
    daddu t0, t0, s1
    sd zero, 0(t0)                   ; the next band restarts the RSP's state
    la t0, global_nesshowatt
    daddu t0, t0, s1
    sd zero, 0(t0)                   ; attached again (the same buffer)
nsdr_finish:
    jal lpmrdpfinish
    nop
    la t0, global_nesshowbusy
    sd zero, 0(t0)
    la t0, global_nesshowstat
    ld t1, 32(t0)
    daddiu t1, t1, 1
    sd t1, 32(t0)                    ; (4) drains
  EndASM
  CompilerIf #NES_CONSOLE_RECORD
  ASM
    jal nes_show_rec_to3
    nop
  EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s5, 24(sp)
    ld s6, 32(sp)
    ld s7, 40(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; ---- NesShowStopped(): the emulator has stopped (RunGame's NES STOP): every job run, then one picture, the whole
; screen red, shown. Assembly (N.73). REACHED BY: a worker error (a stop) - never in a passing run; a cart that stops
; the core (an unsupported opcode, KIL) under --show-check would show it (one red frame, hashed).
; THE PLAIN TWIN:
;   Protected fb.i
;   If NesShowProg = 0 : ProcedureReturn : EndIf
;   LpmRspqSync()
;   NesShowAdvance(2, 0)
;   LpmRdpFinish()
;   fb = NesShowGetFb(2)
;   LpmRdpAttach(fb)
;   NesShowRdpAdopt()
;   LpmRdpModeFill(LpmRgb16(31, 0, 0)) : LpmRdpFillRect(0, 0, 320, 240)
;   LpmRspqRdpDetachShow(NesShowProg, fb)
; HOW: LpmRgb16(31, 0, 0) = (31 & 248) << 8 | 1 = $1801 (lpm_display.n64's formula); the mode through
; NesShowRdpModeFill (the macro written out), the rectangle through LpmRdpFillRectCall. s0 fb (saved).
ProcedureNaked NesShowStopped()
  ASM
    la t0, global_nesshowprog
    ld t0, 0(t0)
    bnez t0, nsst_on
    nop
    jr ra                            ; the show was refused at its start
    nop
nsst_on:
    daddiu sp, sp, -16
    sd ra, 0(sp)
    sd s0, 8(sp)
    jal lpmrspqsync
    nop
    addiu a0, zero, 2
    jal nesshowadvance               ; NesShowAdvance(2, 0)
    move a1, zero                    ; (delay slot)
    jal lpmrdpfinish
    nop
    jal nesshowgetfb                 ; a buffer, waited for
    addiu a0, zero, 2                ; (delay slot)
    move s0, a0
    jal lpmrdpattach
    move a0, s0                      ; (delay slot)
    jal nesshowrdpadopt
    nop
    jal nesshowrdpmodefill
    addiu a0, zero, 0x1801           ; (delay slot) LpmRgb16(31, 0, 0)
    move a0, zero
    move a1, zero
    addiu a2, zero, 320
    jal lpmrdpfillrectcall
    addiu a3, zero, 240              ; (delay slot)
    la t0, global_nesshowprog
    ld a0, 0(t0)
    jal lpmrspqrdpdetachshow         ; shown
    move a1, s0                      ; (delay slot)
    ld ra, 0(sp)
    ld s0, 8(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure

CompilerIf #VERIFY_FRAME > 0
Procedure NesShowReport()
  Protected k.i, s.s = "NES SHOW"
  For k = 0 To 14 : s = s + " " + Str(NesShowStat(k)) : Next
  LpmDebugPrint(s)
  LpmDebugPrint("NES SHOW FRAMES SHOWN " + Str(NesShowStat(0)) + " NOT SHOWN " + Str(NesShowStat(1)) + " COALESCED " + Str(NesShowStat(14)) + " FALLBACK LINES " + Str(NesShowStat(5)) + " MOST A FRAME " + Str(NesShowStat(6)) + " SPLIT " + Str(NesShowStat(7)) + " LOST BANDS " + Str(NesShowStat(8)))
  LpmDebugPrint("NES SHOW BAND CLOSE TICKS " + Str(NesShowStat(9)) + " BANDS " + Str(NesShowStat(10)) + " MOST " + Str(NesShowStat(11)) + " WAITS " + Str(NesShowStat(3)) + " DRAINS " + Str(NesShowStat(4)) + " RSP CLOCKS " + Str(NesShowStat(12)) + " MOST A FRAME " + Str(NesShowStat(13)))
  NesSegReport()
  NesNtReport()
  CompilerIf #NES_SHOW_CHECK
    LpmDebugPrint("NES SHOW CHR ROW WRITES " + Str(NesShowChr(2)) + " TICKS " + Str(NesShowChr(1)))
    LpmDebugPrint("NES SHOW BORDER FRAMES NOT BLACK " + Str(NesShowBorderBad) + " CROP " + Str(#NES_CROP_X) + " " + Str(#NES_CROP_Y))
  CompilerEndIf
EndProcedure
CompilerEndIf

CompilerElseIf #NES_SHOW_CHECK
; ---- the reference (--old-show --show-check): the old renderer's picture of the frame, hashed as NesShowHashFb ----
Global NesShowHash.i
; Each line's pixel x is its palette's entry (CI8 index & 31) - the palette of the last line up to it whose
; NesPaletteChange is set (line 0's always is) - as the old blit's copy-mode TLUT writes it. Only the KEPT pixels are
; hashed, in NesShowHashFb's order: the columns NesShowRefX .. + NesShowRefSpan of the lines NesShowRefY0 ..
; NesShowRefY1 - 1 (every line's palette still followed). CLOBBERS a0-a7, t0-t3, t8, v0, v1.
Global NesShowRefX.i = #NES_CROP_X, NesShowRefSpan.i = 256 - 2 * #NES_CROP_X
Global NesShowRefY0.i = #NES_CROP_Y, NesShowRefY1.i = 240 - #NES_CROP_Y
ProcedureNaked NesShowHashRefAsm()
  ASM
    la t0, global_nesshowrefx
    ld v0, 0(t0)                     ; the first kept column
    la t0, global_nesshowrefspan
    ld v1, 0(t0)                     ; the kept columns (a multiple of 4)
    la t0, global_nesshowrefy0
    ld a7, 0(t0)                     ; the first kept line
    la t0, global_nesshowrefy1
    ld t8, 0(t0)                     ; one past the last
    la a0, global_linepixels
    daddiu a0, a0, 15
    dsrl a0, a0, 4
    dsll a0, a0, 4                   ; row 0 (NesIndexedPixels)
    la a6, global_nesindexpalette
    move a3, a6                      ; line 0's palette
    la a4, global_nespalettechange
    move a5, zero                    ; the line
    la t0, global_nesshowhash
    ld t3, 0(t0)
nes_ref_row:
    daddu t0, a4, a5
    lbu t0, 0(t0)
    beqz t0, nes_ref_keep
    sll t1, a5, 6
    daddu a3, a6, t1                 ; this line's palette (64 bytes a line)
nes_ref_keep:
    sltu t0, a5, a7
    bnez t0, nes_ref_next            ; above the kept lines
    sltu t0, a5, t8                  ; (delay slot)
    beqz t0, nes_ref_next            ; below them
    daddu a2, a0, v0                 ; (delay slot) the first kept pixel
    daddu a1, a2, v1                 ; one past the last
nes_ref_quad:
    lbu t2, 0(a2)
    andi t2, t2, 31
    sll t2, t2, 1
    daddu t2, a3, t2
    lhu t1, 0(t2)
    lbu t2, 1(a2)
    andi t2, t2, 31
    sll t2, t2, 1
    daddu t2, a3, t2
    lhu t2, 0(t2)
    dsll t1, t1, 16
    or t1, t1, t2
    lbu t2, 2(a2)
    andi t2, t2, 31
    sll t2, t2, 1
    daddu t2, a3, t2
    lhu t2, 0(t2)
    dsll t1, t1, 16
    or t1, t1, t2
    lbu t2, 3(a2)
    andi t2, t2, 31
    sll t2, t2, 1
    daddu t2, a3, t2
    lhu t2, 0(t2)
    dsll t1, t1, 16
    or t1, t1, t2                    ; 4 pixels as the picture holds them (the first in the high halfword)
    daddiu a2, a2, 4
    xor t3, t3, t1
    dsll t2, t3, 7
    dsrl32 t3, t3, 25
    or t3, t3, t2
    bne a2, a1, nes_ref_quad
    daddu t3, t3, t1
nes_ref_next:
    daddiu a0, a0, 256               ; the next line's row
    addiu a5, a5, 1
    sltiu t0, a5, 240
    bnez t0, nes_ref_row
    nop
    la t0, global_nesshowhash
    jr ra
    sd t3, 0(t0)
  EndASM
EndProcedure
Procedure NesShowHashRef()              ; at line 239's publish (host.n64, DisplayFrame)
  NesShowHash = $351B5058
  NesShowHashRefAsm()
  LpmDebugPrint("NES PIC " + Str(WorkerFrames) + " " + Hex(NesShowHash) + " 0")
EndProcedure
CompilerEndIf
