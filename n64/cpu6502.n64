; ============================================================================
; cpu6502.n64 - the NES 2A03 (6502) CPU core, VR4300 assembly, for the runtime
; MMC3 cartridge configuration.
;
; WHAT IT IS
;   CpuRun(n) runs whole guest instructions for a window of n CPU cycles and
;   returns the cycles it ran, exactly as the compiled interpreter it replaces
;   (anvil/cpu2a03.pi4 as staged by stage_cpu.py, stage_poll.py and
;   stage_thread.py: the compiled handlers plus their string-spliced fast
;   paths). It is ONE core: every documented opcode, every addressing mode,
;   the bus slow paths, the poll / idle batching shapes, the IRQ-unmask end of
;   window and the illegal-opcode stop are all here. Device code (the PPU, APU,
;   mapper and controller registers) is reached through NesRead / NesWrite and
;   the scheduler's own procedures, never re-implemented.
;
; WHY ASSEMBLY (measured, diagnosis note section L)
;   The procedure it replaces was 45,688 bytes: 27,984 compiled (the complete
;   interpreter, kept because the fast paths fell back to it), 14,120 of
;   spliced assembly and 3,584 of tables inside the code. In the slow section
;   a guest instruction cost ~33 VR4300 instructions and ~68 cycles in it,
;   most of them I-cache misses over that spread-out code and ~180 cycles of
;   window entry / exit. This core keeps the guest state in registers, shares
;   one block of straight-line code per addressing mode, and is a few KB.
;   (Measured size and cycles: the note, section L, after the proof.)
;
; HOW
;   Dispatch: the guest PC is checked against a cached FETCH REGION (s2 guest
;   base, s3 host bias, s4 extent = how far an opcode may sit so that its two
;   operand bytes are inside too). Inside it the opcode byte is loaded from
;   host memory and the handler entered at c65_slots + opcode * 16: every
;   handler owns a fixed 16-byte slot (the whole handler when it fits four
;   instructions, else its start and a branch to c65_op_xx_rest), so the
;   dispatch is one computed jump with no table load in the D-cache. Outside it the region is rebuilt (c65_rebase) or
;   the instruction's bytes are copied one by one into a small buffer
;   (c65_fetch_slow) and the handler reads its operands from there.
;   Handlers: a handler sets the access phase, calls the shared block of its
;   addressing mode with jal (the block ends in jr ra, or tail-branches into
;   the shared read / write routine that returns with the same ra), does its
;   operation and branches to c65_next, charging its cycles in the delay slot.
;   Memory: internal RAM and the stack ($0000-$1FFF), PRG ROM through the MMC3
;   bank-bias table, enabled work RAM and the open-bus ranges are handled
;   inline. Every other address is a CALL-OUT (c65_out / c65_in): PC, Left,
;   the access phase and the open bus - what device code reads during a
;   window - are published with the caller-saved FN, FC and NesInstructions,
;   the device procedure is called with the compiled calling convention
;   (Help/VR4300.txt: a0-a7 in, a0 out, s0-s7 and fp kept), and those are
;   reloaded: a device may end the window (CpuEndWindow: Left and Budget).
;   A, X, Y and FZ stay in callee-saved registers. A write at $6000-$FFFF may
;   switch a PRG bank or the work-RAM enable, so it drops the fetch region.
;   The window's end publishes the whole state (c65_publish).
;   The core has no stack frame: its saves live in the port globals C65Save*,
;   C65Link, C65Ea, C65Value, C65Count and C65Fetch (the host stack's D-cache
;   lines are shared with every compiled call the devices make).
;   The MMC3 run-window loop (c65_run_mapper4, NesRunMapper4's body) lives in
;   this unit too, beside the core it calls every window.
;
; REGISTERS during a window (the convention the device code already met at
; the old core's flush):
;   a1 PC         a2 Left (cycles still to run)   a3 global_nesmmc3bias
;   s5 A  s6 X  s7 Y   fp FZ   t8 FN   t9 FC        t3 NesInstructions
;   v0 AccessPhase   v1 open bus (the last byte on the guest data bus)
;   s0 c65_slots   s1 global_m (RAM)   s2 s3 s4 the fetch region
;   t0 the host address of the opcode byte (operands at 1(t0) and 2(t0))
;   t1 t2 a0 a4-a7 scratch; t2 holds an effective address between a mode block and
;   the read / write routine.  ra: the link to a mode block.
;   FV, FD, FI, S stay in their globals (as in the old core's fast paths).
;
; FLAGS are lazy, as in the old core: N is bit 7 of FN, Z is "FZ & 255 = 0",
; C is bit 8 of FC, V is bit 7 of FV. Status bytes are built only by PHP, BRK
; and the interrupt entry.
;
; WHAT IT REPRODUCES, and deliberately so (the old core's behaviour is the
; specification; see the note for the findings):
;   - the access phase each opcode publishes and its moves around RMW
;     accesses (read at phase-2, the two writes at phase-1 and phase);
;   - DEC abs ($CE): 6 cycles, phase 5, as INC abs (the reference's 3 / 2 was
;     a defect of the shared generator, fixed there and here together);
;   - the read-modify-write double write (unchanged value, then the result);
;   - the page-cross cycle of indexed reads charged BEFORE the read, so a
;     device sees the same time stamp;
;   - the BNE -6 / BEQ -7 / BEQ -4 polling shapes and the BNE -3 DEX / DEY
;     countdown, which read their pattern through the bank mapped at PC
;     (NesMmc3Bias), only when every pattern byte lies in PC's 8 KB slot,
;     and the JMP-to-self idle batching;
;   - the $2002 poll batching after LDA abs / BIT abs when the read ended
;     the window.
; WHAT IT DOES NOT DO: execute code fetched from device space or disabled
; work RAM. The old core would read such bytes through the bus; no supported
; game does it. Here it stops the CPU loudly: Stopped = 1 and BadOpcode =
; $10000 | the address.
;
; CHECKED BY: the instruction-by-instruction digest (cputrace.n64, the trace
; build) against the reference core over the SMB3 and Mega Man 4 oracle
; routes; then the 61 checkpoints, final picture, full PCM and video digest
; of the shipped build (the note, section L).
; ============================================================================

; The core's save area: the caller's callee-saved registers over a window, a link and an
; address over a call-out, two counts, the slow fetch's bytes. Globals, not the stack: the
; host stack's D-cache lines are shared with every compiled call the devices make.
Global C65SaveS0.i, C65SaveS1.i, C65SaveS2.i, C65SaveS3.i, C65SaveS4.i, C65SaveS5.i
Global C65SaveS6.i, C65SaveS7.i, C65SaveFp.i, C65SaveRa.i
Global C65Link.i, C65Ea.i, C65Value.i, C65Count.i, C65Fetch.i

; THE HOT UNIT'S PIN (diagnosis note N.70). The VR4300's I-cache is 16 KB, direct-mapped, 32-byte lines: an
; instruction's set is its address bits 5-13. The unit's hot span fills almost every set, so where any OTHER hot code
; can sit without evicting it depends on the unit's address modulo 16 KB - and before this pin every compile moved it
; (the compiler orders procedures by its call graph; a change anywhere before the unit moved `cpurun` by hundreds of
; bytes, and the record, shipped and trace builds each had their own alias). `.alignabs 16384, 2048` pads with zero
; words to the next address that is 2048 modulo 16384, so `cpurun` is $xxxx0800 / $xxxx4800 / ... in EVERY build: the
; unit's sets are fixed (cpurun's line on set 64), and per-frame glue can be put on the unit's coldest sets with its
; own `.alignabs` (host.n64, rspsyn.n64, show.n64).
; HOW: the pad is this naked procedure's whole body. It ends in no jr / j / b, so the compiler lays it out as one unit
; with the procedure written after it (EmitCore_Mips.pbi's layout rule for a ProcedureNaked that runs on), and the pad
; therefore lands immediately before `cpurun`'s label. Nothing ever calls or enters CpuRunPin (its label is the pad's
; first byte); the pad is never executed. Its cost is RDRAM only: 0 to 16,380 bytes, by build (the note gives each).
; 2048 was chosen above the shipped / oracle / checking builds' natural cpurun on the tree before the pin ($254-$6B4
; mod 16 KB); the glue pins (host.n64, rspsyn.n64) that lie before the unit in some builds add their own pads to it.
ProcedureNaked CpuRunPin()
  ASM
    .alignabs 16384, 2048
  EndASM
EndProcedure

ProcedureNaked.i CpuRun(n.i)
  ASM
    ; --- window entry: If n <= 0 Or Stopped : ProcedureReturn 0 ------------
    blez a0, c65_zero
    nop
    la t0, global_pc
    ld t1, global_stopped-global_pc(t0)
    bnez t1, c65_zero
    ; If NesStall : CpuCycles = CpuCycles + NesStall : NesStall = 0
    ld t1, global_nesstall-global_pc(t0)
    ld t2, global_cpucycles-global_pc(t0)
    daddu t2, t2, t1
    sd t2, global_cpucycles-global_pc(t0)
    sd zero, global_nesstall-global_pc(t0)
    ; NesRunStart = CpuCycles : CpuInWindow = 1 : Budget = n : Left = n
    la t0, global_cpucycles
    sd t2, global_nesrunstart-global_cpucycles(t0)
    daddiu t1, zero, 1
    sd t1, global_cpuinwindow-global_cpucycles(t0)
    sd a0, global_budget-global_cpucycles(t0)
    sd a0, global_left-global_cpucycles(t0)
    la a3, global_nesmmc3bias
    ; frame: 0-32 s0-s4, 40 the caller's ra, 48 a link saved over a call-out,
    ; 56 an effective address, 64 a value, 72 a count, 80 the fetch buffer
    sd s0, global_c65saves0-global_nesmmc3bias(a3)
    sd s1, global_c65saves1-global_nesmmc3bias(a3)
    sd s2, global_c65saves2-global_nesmmc3bias(a3)
    sd s3, global_c65saves3-global_nesmmc3bias(a3)
    sd s4, global_c65saves4-global_nesmmc3bias(a3)
    sd s5, global_c65saves5-global_nesmmc3bias(a3)
    sd s6, global_c65saves6-global_nesmmc3bias(a3)
    sd s7, global_c65saves7-global_nesmmc3bias(a3)
    sd fp, global_c65savefp-global_nesmmc3bias(a3)
    sd ra, global_c65savera-global_nesmmc3bias(a3)
    la s0, c65_slots
    la s1, global_m
    jal c65_reload           ; the guest state from its globals (a2 = Left = n)
    or s4, zero, zero        ; no fetch region yet: the first fetch builds it
    b c65_rebase
    nop
c65_zero:
    jr ra
    or a0, zero, zero

    ; --- the MMC3 run-window loop (NesRunMapper4), moved here from mmc3_run.n64 unchanged:
    ; budget, the CPU window, the device catch-up, interrupts, the frame hand-over. It is the
    ; core's caller every window; in one unit their hot lines cannot share I-cache sets.
c65_run_mapper4:
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    move s1, a0
    la s0, global_cpucycles
c65_rw_window:
    ld t0, global_stopped-global_cpucycles(s0)
    ld t1, global_workererror-global_cpucycles(s0)
    or t0, t0, t1
    bnez t0, c65_rw_stop
    nop
    jal u_mappercpubudget
    nop
    jal u_nesramcpuwindow
    move a1, zero

    ld a0, 0(s0)
    ld t0, global_nesstatushorizon-global_cpucycles(s0)
    slt t0, t0, a0
    beqz t0, c65_rw_stalls
    ld t0, global_nescpuhorizon-global_cpucycles(s0)
    slt t0, t0, a0
    beqz t0, c65_rw_stalls
    nop
    jal u_nesmmc3advancecputime
    nop
c65_rw_stalls:
    ld t0, global_workerdmccycles-global_cpucycles(s0)
    ld t1, global_nesseendmc-global_cpucycles(s0)
    dsubu t1, t0, t1
    blez t1, c65_rw_interrupts
    ld a0, 0(s0)
    sd t0, global_nesseendmc-global_cpucycles(s0)
    daddu a0, a0, t1
    jal u_nesmmc3advancecputime
    sd a0, 0(s0)
    b c65_rw_stalls
    nop
c65_rw_interrupts:
    ld t0, global_workernmi-global_cpucycles(s0)
    ld t1, global_nesseennmi-global_cpucycles(s0)
    beq t0, t1, c65_rw_irq
    ori a0, zero, 0xFFFA
    sd t0, global_nesseennmi-global_cpucycles(s0)
    b c65_rw_interrupt
    nop
c65_rw_irq:
    ld t0, global_workerirq-global_cpucycles(s0)
    ld t1, global_mapirq-global_cpucycles(s0)
    or t0, t0, t1
    beqz t0, c65_rw_frames
    ld t0, global_fi-global_cpucycles(s0)
    bnez t0, c65_rw_frames
    ori a0, zero, 0xFFFE
c65_rw_interrupt:
    jal cpuinterrupt
    nop
c65_rw_frames:
    ld a0, global_workerframes-global_cpucycles(s0)
    ld t0, global_nesdeliveredframe-global_cpucycles(s0)
    beq a0, t0, c65_rw_window
    nop
    jal neshostguestframe
    move a1, s1
    beqz a0, c65_rw_window
    nop
    b c65_rw_exit            ; (c65_rw_stop / c65_rw_exit: the run's end, once a run - in the cold part, C4)
    nop

    ; --- the end of every instruction --------------------------------------
c65_next:
  EndASM
  CompilerIf #NES_CPU_TRACE
    ASM
      or a4, s5, zero        ; the digest reads A X Y FZ in a4-a7
      or a5, s6, zero
      or a6, s7, zero
      jal nescputracestep    ; checking build only: fold the state into the digest
      or a7, fp, zero
    EndASM
  CompilerEndIf
  ASM
    blez a2, c65_wend        ; the window is spent: its end, in place where nothing is observable (N.46)
    subu t1, a1, s2          ; PC inside the fetch region, with its operands?
c65_go:
    sltu t1, t1, s4
    beqz t1, c65_rebase
    addu t0, a1, s3          ; host address of the opcode
    lbu a0, 0(t0)
c65_dispatch:
    sll t1, a0, 4            ; the handler's slot: c65_slots + opcode * 16 (no table load)
    addu t1, t1, s0
    or v1, a0, zero          ; the opcode is now on the data bus
    jr t1
    daddiu t3, t3, 1         ; NesInstructions + 1

    ; --- the 256 handler slots: 16 bytes each, dispatch = c65_slots + opcode * 16 -------
    ; A handler that fits four instructions lives whole in its slot; a longer one keeps its
    ; first instructions there and branches to its rest (c65_op_xx_rest) below.
    .align 32
c65_slots:
c65_op_00:  ; $00 BRK imp cycles 7
    addiu a1, a1, 2          ; the pushed address skips the padding byte
    andi a1, a1, 0xFFFF
    b c65_op_00_rest
    ld t2, global_s-global_nesmmc3bias(a3)
c65_op_01:  ; $01 ORA inx cycles 6 phase 5
    jal c65_m_indx
    addiu v0, zero, 5
    b c65_ora
    daddiu a2, a2, -6
c65_op_02:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_03:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_04:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_05:  ; $05 ORA zpg cycles 3
    jal c65_m_zp
    nop
    b c65_ora
    daddiu a2, a2, -3
c65_op_06:  ; $06 ASL zpg cycles 5
    jal c65_m_zp
    nop
    b c65_op_06_rest
    sll t9, v1, 1
c65_op_07:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_08:  ; $08 PHP imp cycles 3
    jal c65_status
    nop
    b c65_op_08_rest
    ori t0, t0, 0x10
c65_op_09:  ; $09 ORA imm cycles 2
    lbu v1, 1(t0)
    addiu a1, a1, 2
    b c65_ora
    daddiu a2, a2, -2
c65_op_0a:  ; $0A ASL acc cycles 2
    sll t9, s5, 1
    andi s5, t9, 0xFF
    b c65_op_0a_rest
    addiu a1, a1, 1
c65_op_0b:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_0c:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_0d:  ; $0D ORA abs cycles 4 phase 3
    jal c65_m_abs
    addiu v0, zero, 3
    b c65_ora
    daddiu a2, a2, -4
c65_op_0e:  ; $0E ASL abs cycles 6 phase 5
    jal c65_e_abs
    addiu v0, zero, 3        ; the read at phase - 2
    b c65_op_0e_rest
    nop
c65_op_0f:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_10:  ; $10 BPL rel cycles 2
    andi t1, t8, 0x80
    b c65_op_10_rest
    nop
    nop
c65_op_11:  ; $11 ORA iny cycles 5 phase 4
    jal c65_m_indy
    addiu v0, zero, 4
    b c65_ora
    daddiu a2, a2, -5
c65_op_12:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_13:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_14:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_15:  ; $15 ORA zpx cycles 4
    jal c65_m_zpx
    nop
    b c65_ora
    daddiu a2, a2, -4
c65_op_16:  ; $16 ASL zpx cycles 6
    jal c65_m_zpx
    nop
    b c65_op_16_rest
    sll t9, v1, 1
c65_op_17:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_18:  ; $18 CLC imp cycles 2
    or t9, zero, zero
    addiu a1, a1, 1
    b c65_next
    daddiu a2, a2, -2
c65_op_19:  ; $19 ORA aby cycles 4 phase 3
    jal c65_m_absy
    addiu v0, zero, 3
    b c65_ora
    daddiu a2, a2, -4
c65_op_1a:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_1b:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_1c:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_1d:  ; $1D ORA abx cycles 4 phase 3
    jal c65_m_absx
    addiu v0, zero, 3
    b c65_ora
    daddiu a2, a2, -4
c65_op_1e:  ; $1E ASL abx cycles 7 phase 6
    jal c65_e_absx
    addiu v0, zero, 4
    b c65_op_1e_rest
    nop
c65_op_1f:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_20:  ; $20 JSR abs cycles 6 phase 5
    lbu t1, 1(t0)            ; target low byte
    lbu v1, 2(t0)            ; target high byte (last on the bus)
    b c65_op_20_rest
    addiu a0, a1, 2          ; the pushed address: the high operand byte's
c65_op_21:  ; $21 AND inx cycles 6 phase 5
    jal c65_m_indx
    addiu v0, zero, 5
    b c65_and
    daddiu a2, a2, -6
c65_op_22:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_23:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_24:  ; $24 BIT zpg cycles 3
    jal c65_m_zp
    nop
    b c65_op_24_rest
    or t8, v1, zero
c65_op_25:  ; $25 AND zpg cycles 3
    jal c65_m_zp
    nop
    b c65_and
    daddiu a2, a2, -3
c65_op_26:  ; $26 ROL zpg cycles 5
    jal c65_m_zp
    nop
    b c65_op_26_rest
    srl t2, t9, 8
c65_op_27:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_28:  ; $28 PLP imp cycles 4
    ld t2, global_s-global_nesmmc3bias(a3)
    addiu t2, t2, 1
    b c65_op_28_rest
    andi t2, t2, 0xFF
c65_op_29:  ; $29 AND imm cycles 2
    lbu v1, 1(t0)
    addiu a1, a1, 2
    b c65_and
    daddiu a2, a2, -2
c65_op_2a:  ; $2A ROL acc cycles 2
    srl t1, t9, 8
    andi t1, t1, 1
    b c65_op_2a_rest
    sll t9, s5, 1
c65_op_2b:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_2c:  ; $2C BIT abs cycles 4 phase 3
    jal c65_m_abs
    addiu v0, zero, 3
    b c65_op_2c_rest
    or t8, v1, zero          ; N = bit 7
c65_op_2d:  ; $2D AND abs cycles 4 phase 3
    jal c65_m_abs
    addiu v0, zero, 3
    b c65_and
    daddiu a2, a2, -4
c65_op_2e:  ; $2E ROL abs cycles 6 phase 5
    jal c65_e_abs
    addiu v0, zero, 3
    b c65_op_2e_rest
    nop
c65_op_2f:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_30:  ; $30 BMI rel cycles 2
    andi t1, t8, 0x80
    b c65_op_30_rest
    nop
    nop
c65_op_31:  ; $31 AND iny cycles 5 phase 4
    jal c65_m_indy
    addiu v0, zero, 4
    b c65_and
    daddiu a2, a2, -5
c65_op_32:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_33:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_34:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_35:  ; $35 AND zpx cycles 4
    jal c65_m_zpx
    nop
    b c65_and
    daddiu a2, a2, -4
c65_op_36:  ; $36 ROL zpx cycles 6
    jal c65_m_zpx
    nop
    b c65_op_36_rest
    srl t2, t9, 8
c65_op_37:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_38:  ; $38 SEC imp cycles 2
    ori t9, zero, 0x100
    addiu a1, a1, 1
    b c65_next
    daddiu a2, a2, -2
c65_op_39:  ; $39 AND aby cycles 4 phase 3
    jal c65_m_absy
    addiu v0, zero, 3
    b c65_and
    daddiu a2, a2, -4
c65_op_3a:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_3b:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_3c:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_3d:  ; $3D AND abx cycles 4 phase 3
    jal c65_m_absx
    addiu v0, zero, 3
    b c65_and
    daddiu a2, a2, -4
c65_op_3e:  ; $3E ROL abx cycles 7 phase 6
    jal c65_e_absx
    addiu v0, zero, 4
    b c65_op_3e_rest
    nop
c65_op_3f:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_40:  ; $40 RTI imp cycles 6
    ld t2, global_s-global_nesmmc3bias(a3)
    addiu t2, t2, 1
    b c65_op_40_rest
    andi t2, t2, 0xFF
c65_op_41:  ; $41 EOR inx cycles 6 phase 5
    jal c65_m_indx
