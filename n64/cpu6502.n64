    b c65_cmp
    daddiu a2, a2, -4
c65_op_de:  ; $DE DEC abx cycles 7 phase 6
    jal c65_e_absx
    addiu v0, zero, 4
    b c65_op_de_rest
    nop
c65_op_df:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_e0:  ; $E0 CPX imm cycles 2
    lbu v1, 1(t0)
    addiu a1, a1, 2
    b c65_cpx
    daddiu a2, a2, -2
c65_op_e1:  ; $E1 SBC inx cycles 6 phase 5
    jal c65_m_indx
    addiu v0, zero, 5
    b c65_sbc
    daddiu a2, a2, -6
c65_op_e2:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_e3:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_e4:  ; $E4 CPX zpg cycles 3
    jal c65_m_zp
    nop
    b c65_cpx
    daddiu a2, a2, -3
c65_op_e5:  ; $E5 SBC zpg cycles 3
    jal c65_m_zp
    nop
    b c65_sbc
    daddiu a2, a2, -3
c65_op_e6:  ; $E6 INC zpg cycles 5
    jal c65_m_zp
    nop
    b c65_op_e6_rest
    addiu t2, v1, 1
c65_op_e7:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_e8:  ; $E8 INX imp cycles 2
    addiu s6, s6, 1
    andi s6, s6, 0xFF
    b c65_op_e8_rest
    daddiu a2, a2, -2
c65_op_e9:  ; $E9 SBC imm cycles 2
    lbu v1, 1(t0)
    addiu a1, a1, 2
    b c65_sbc
    daddiu a2, a2, -2
c65_op_ea:  ; $EA NOP imp cycles 2
    addiu a1, a1, 1
    b c65_next
    daddiu a2, a2, -2
    nop
c65_op_eb:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_ec:  ; $EC CPX abs cycles 4 phase 3
    jal c65_m_abs
    addiu v0, zero, 3
    b c65_cpx
    daddiu a2, a2, -4
c65_op_ed:  ; $ED SBC abs cycles 4 phase 3
    jal c65_m_abs
    addiu v0, zero, 3
    b c65_sbc
    daddiu a2, a2, -4
c65_op_ee:  ; $EE INC abs cycles 6 phase 5
    jal c65_e_abs
    addiu v0, zero, 3
    b c65_op_ee_rest
    nop
c65_op_ef:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_f0:  ; $F0 BEQ rel cycles 2
    andi t1, fp, 0xFF
    b c65_op_f0_rest
    nop
    nop
c65_op_f1:  ; $F1 SBC iny cycles 5 phase 4
    jal c65_m_indy
    addiu v0, zero, 4
    b c65_sbc
    daddiu a2, a2, -5
c65_op_f2:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_f3:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_f4:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_f5:  ; $F5 SBC zpx cycles 4
    jal c65_m_zpx
    nop
    b c65_sbc
    daddiu a2, a2, -4
c65_op_f6:  ; $F6 INC zpx cycles 6
    jal c65_m_zpx
    nop
    b c65_op_f6_rest
    addiu t2, v1, 1
c65_op_f7:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_f8:  ; $F8 SED imp cycles 2
    daddiu t1, zero, 1
    sd t1, global_fd-global_nesmmc3bias(a3)
    b c65_op_f8_rest
    addiu a1, a1, 1
c65_op_f9:  ; $F9 SBC aby cycles 4 phase 3
    jal c65_m_absy
    addiu v0, zero, 3
    b c65_sbc
    daddiu a2, a2, -4
c65_op_fa:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_fb:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_fc:  ; illegal
    b c65_illegal
    nop
    nop
    nop
c65_op_fd:  ; $FD SBC abx cycles 4 phase 3
    jal c65_m_absx
    addiu v0, zero, 3
    b c65_sbc
    daddiu a2, a2, -4
c65_op_fe:  ; $FE INC abx cycles 7 phase 6
    jal c65_e_absx
    addiu v0, zero, 4
    b c65_op_fe_rest
    nop
c65_op_ff:  ; illegal
    b c65_illegal
    nop
    nop
    nop
    ; --- the rest of the longer handlers --------------------------------------------
c65_op_f0_rest:
    bnez t1, c65_br_not
    nop
    jal c65_br_taken
    nop
    addiu t0, zero, -7
    beq t2, t0, c65_beq_shape7
    addiu t0, zero, -4
    beq t2, t0, c65_beq_shape4
    nop
    b c65_next
    daddiu a2, a2, -2
c65_op_d0_rest:
    beqz t1, c65_br_not
    nop
    jal c65_br_taken
    nop
    addiu t0, zero, -6
    beq t2, t0, c65_bne_shape
    addiu t0, zero, -3
    beq t2, t0, c65_bne_shape3
    nop
    b c65_next
    daddiu a2, a2, -2
c65_op_85_rest:
    sb s5, 0(t1)
    or v1, s5, zero
    b c65_next
    daddiu a2, a2, -3
c65_op_a5_rest:
    lbu s5, 0(t1)
    daddiu a2, a2, -3
    or v1, s5, zero
    or fp, s5, zero
    b c65_next
    or t8, s5, zero
c65_op_ad_rest:
    or fp, v1, zero
    or t8, v1, zero
    beqz a2, c65_poll        ; Left = 0 only when the read was a device read that ended the window
    or a0, v1, zero
    b c65_next
    daddiu a2, a2, -4
c65_op_20_rest:
    andi a0, a0, 0xFFFF
    ld t2, global_s-global_nesmmc3bias(a3)
    addu t0, s1, t2
    srl a1, a0, 8
    sb a1, 0x100(t0)         ; push PCH
    addiu t2, t2, -1
    andi t2, t2, 0xFF
    addu t0, s1, t2
    sb a0, 0x100(t0)         ; push PCL
    addiu t2, t2, -1
    andi t2, t2, 0xFF
    sd t2, global_s-global_nesmmc3bias(a3)
    sll a1, v1, 8
    or a1, a1, t1
    addiu v0, zero, 5
    b c65_next
    daddiu a2, a2, -6
c65_op_4a_rest:
    or fp, s5, zero
    or t8, s5, zero
    b c65_next
    daddiu a2, a2, -2
c65_op_60_rest:
    addu t1, s1, t2
    lbu a0, 0x100(t1)        ; pull PCL
    addiu t2, t2, 1
    andi t2, t2, 0xFF
    addu t1, s1, t2
    lbu t1, 0x100(t1)        ; pull PCH
    sd t2, global_s-global_nesmmc3bias(a3)
    sll t1, t1, 8
    or a1, a0, t1
    addiu a1, a1, 1
    andi a1, a1, 0xFFFF
    b c65_next
    daddiu a2, a2, -6
c65_op_10_rest:
    bnez t1, c65_br_not
    nop
    b c65_br_take
    nop
c65_op_ca_rest:
    b c65_nzx
    addiu a1, a1, 1
c65_op_90_rest:
    bnez t1, c65_br_not
    nop
    b c65_br_take
    nop
c65_op_0a_rest:
    or fp, s5, zero
    or t8, s5, zero
    b c65_next
    daddiu a2, a2, -2
c65_op_c8_rest:
    b c65_nzy
    addiu a1, a1, 1
c65_op_88_rest:
    b c65_nzy
    addiu a1, a1, 1
c65_op_e8_rest:
    b c65_nzx
    addiu a1, a1, 1
c65_op_b0_rest:
    beqz t1, c65_br_not
    nop
    b c65_br_take
    nop
c65_op_68_rest:
    sd t2, global_s-global_nesmmc3bias(a3)
    addu t1, s1, t2
    lbu s5, 0x100(t1)
    addiu a1, a1, 1
    daddiu a2, a2, -4
    or fp, s5, zero
    b c65_next
    or t8, s5, zero
c65_op_26_rest:
    andi t2, t2, 1
    sll t9, v1, 1
    or t9, t9, t2
    b c65_rmw_zp
    addiu a0, zero, 5
c65_op_48_rest:
    addiu t2, t2, -1
    andi t2, t2, 0xFF
    sd t2, global_s-global_nesmmc3bias(a3)
    addiu a1, a1, 1
    b c65_next
    daddiu a2, a2, -3
c65_op_4c_rest:
    sll t2, v1, 8
    or t2, t2, t1            ; Ea
    beq t2, a1, c65_jmp_self ; a jump to itself: the idle batching
    nop
    or a1, t2, zero
    b c65_next
    daddiu a2, a2, -3
c65_op_86_rest:
    sb s6, 0(t1)
    or v1, s6, zero
    b c65_next
    daddiu a2, a2, -3
c65_op_95_rest:
    or v1, s5, zero
    b c65_next
    daddiu a2, a2, -4
c65_op_30_rest:
    beqz t1, c65_br_not
    nop
    b c65_br_take
    nop
c65_op_2a_rest:
    or t9, t9, t1
    andi s5, t9, 0xFF
    daddiu a2, a2, -2
    b c65_nza
    addiu a1, a1, 1
c65_op_06_rest:
    b c65_rmw_zp
    addiu a0, zero, 5
c65_op_08_rest:
    sd t0, global_tmp-global_nesmmc3bias(a3)
    ld t2, global_s-global_nesmmc3bias(a3)
    addu t1, s1, t2
    sb t0, 0x100(t1)
    addiu t2, t2, -1
    andi t2, t2, 0xFF
    sd t2, global_s-global_nesmmc3bias(a3)
    addiu a1, a1, 1
    b c65_next
    daddiu a2, a2, -3
c65_op_24_rest:
    sll t1, v1, 1
    sd t1, global_fv-global_nesmmc3bias(a3)
    and fp, s5, v1
    b c65_next
    daddiu a2, a2, -3
c65_op_28_rest:
    sd t2, global_s-global_nesmmc3bias(a3)
    addu t1, s1, t2
    lbu t0, 0x100(t1)
    jal c65_setstatus
    sd t0, global_tmp-global_nesmmc3bias(a3)
    addiu a1, a1, 1
    b c65_irq_check
    addiu a0, zero, 4
c65_op_2e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    srl t1, t9, 8
    andi t1, t1, 1
    sll t9, v1, 1
    or t9, t9, t1
    b c65_rmw_write
    addiu t0, zero, 6
c65_op_40_rest:
    addu t1, s1, t2
    lbu t0, 0x100(t1)        ; P
    jal c65_setstatus        ; (t2 survives)
    sd t0, global_tmp-global_nesmmc3bias(a3)
    addiu t2, t2, 1
    andi t2, t2, 0xFF
    addu t1, s1, t2
    lbu a1, 0x100(t1)        ; PCL
    sd a1, global_lo-global_nesmmc3bias(a3)
    addiu t2, t2, 1
    andi t2, t2, 0xFF
    addu t1, s1, t2
    lbu t0, 0x100(t1)        ; PCH
    sd t0, global_hi-global_nesmmc3bias(a3)
    sd t2, global_s-global_nesmmc3bias(a3)
    sll t0, t0, 8
    or a1, a1, t0
    b c65_irq_check
    addiu a0, zero, 6
c65_op_46_rest:
    srl t2, v1, 1
    b c65_store_zp
    addiu a0, zero, 5
c65_op_4e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    sll t9, v1, 8
    srl fp, v1, 1
    b c65_rmw_write_res
    addiu t0, zero, 6
c65_op_50_rest:
    bnez t1, c65_br_not
    nop
    b c65_br_take
    nop
c65_op_66_rest:
    andi t2, t2, 0x80
    srl t0, v1, 1
    or t2, t2, t0
    sll t9, v1, 8
    b c65_store_zp
    addiu a0, zero, 5
c65_op_6c_rest:
    jal c65_rd_ea            ; the target's low byte
    nop
    sd v1, global_c65count-global_nesmmc3bias(a3)
    andi t0, t2, 0xFF00      ; the high byte wraps inside the pointer's page
    addiu t1, t2, 1
    andi t1, t1, 0xFF
    jal c65_rd_ea
    or t2, t0, t1
    ld t0, global_c65count-global_nesmmc3bias(a3)
    sll t1, v1, 8
    or a1, t0, t1
    b c65_next
    daddiu a2, a2, -5
c65_op_6e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    srl fp, t9, 1
    andi fp, fp, 0x80
    srl t1, v1, 1
    or fp, fp, t1
    sll t9, v1, 8
    b c65_rmw_write_res
    addiu t0, zero, 6
c65_op_70_rest:
    beqz t1, c65_br_not
    nop
    b c65_br_take
    nop
c65_op_78_rest:
    b c65_next
    daddiu a2, a2, -2
c65_op_7e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    srl fp, t9, 1
    andi fp, fp, 0x80
    srl t1, v1, 1
    or fp, fp, t1
    sll t9, v1, 8
    b c65_rmw_write_res
    addiu t0, zero, 7
c65_op_84_rest:
    sb s7, 0(t1)
    or v1, s7, zero
    b c65_next
    daddiu a2, a2, -3
c65_op_94_rest:
    or v1, s7, zero
    b c65_next
    daddiu a2, a2, -4
c65_op_c6_rest:
    b c65_incdec_zp
    addiu a0, zero, 5
c65_op_ce_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    addiu fp, v1, -1
    andi fp, fp, 0xFF
    b c65_rmw_write_res
    addiu t0, zero, 6
c65_op_d6_rest:
    b c65_incdec_zp
    addiu a0, zero, 6
c65_op_de_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    addiu fp, v1, -1
    andi fp, fp, 0xFF
    b c65_rmw_write_res
    addiu t0, zero, 7
c65_op_e6_rest:
    b c65_incdec_zp
    addiu a0, zero, 5
c65_op_ee_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    addiu fp, v1, 1
    andi fp, fp, 0xFF
    b c65_rmw_write_res
    addiu t0, zero, 6
c65_op_f6_rest:
    b c65_incdec_zp
    addiu a0, zero, 6
c65_op_fe_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    addiu fp, v1, 1
    andi fp, fp, 0xFF
    b c65_rmw_write_res
    addiu t0, zero, 7


    ; --- shared tails: the operation on v1, cycles already charged ----------
c65_lda:
    or s5, v1, zero
c65_nza:                     ; N and Z from A
    or fp, s5, zero
    b c65_next
    or t8, s5, zero
c65_ldx:
    or s6, v1, zero
c65_nzx:
    or fp, s6, zero
    b c65_next
    or t8, s6, zero
c65_ldy:
    or s7, v1, zero
c65_nzy:
    or fp, s7, zero
    b c65_next
    or t8, s7, zero
c65_ora:
    or s5, s5, v1
    or fp, s5, zero
    b c65_next
    or t8, s5, zero
c65_and:
    and s5, s5, v1
    or fp, s5, zero
    b c65_next
    or t8, s5, zero
c65_eor:
    xor s5, s5, v1
    or fp, s5, zero
    b c65_next
    or t8, s5, zero
c65_cmp:                     ; Res = A - value: N, Z from Res, C = NOT borrow
    subu fp, s5, v1
    or t8, fp, zero
    b c65_next
    nor t9, fp, zero
c65_cpx:
    subu fp, s6, v1
    or t8, fp, zero
    b c65_next
    nor t9, fp, zero
c65_cpy:
    subu fp, s7, v1
    or t8, fp, zero
    b c65_next
    nor t9, fp, zero
c65_adc:                     ; Res = A + value + C; V = ~(A^value) & (A^Res)
    srl t1, t9, 8
    andi t1, t1, 1
    addu t0, s5, v1
    addu t0, t0, t1
    xor t1, s5, v1
    nor t1, t1, zero
    xor t2, s5, t0
    and t1, t1, t2
    sd t1, global_fv-global_nesmmc3bias(a3)
    or t9, t0, zero          ; C = bit 8 of the sum
    andi s5, t0, 0xFF
    or fp, s5, zero
    b c65_next
    or t8, s5, zero
c65_sbc:                     ; Res = A - value - !C; V = (A^value) & (A^Res); C = ~Res
    srl t1, t9, 8
    andi t1, t1, 1
    xori t1, t1, 1
    subu t0, s5, v1
    subu t0, t0, t1
    xor t1, s5, v1
    xor t2, s5, t0
    and t1, t1, t2
    sd t1, global_fv-global_nesmmc3bias(a3)
    nor t9, t0, zero
    or fp, t0, zero          ; N and Z from the unmasked Res, as the reference
    or t8, t0, zero
    b c65_next
    andi s5, t0, 0xFF
c65_rmw_zp:                  ; t9 = shifted value (C in bit 8), t1 = host address, a0 = cycles
    andi t2, t9, 0xFF
c65_store_zp:                ; t2 = result byte
    sb t2, 0(t1)             ; the unchanged-value write is invisible in RAM
    or v1, t2, zero
    or fp, t2, zero
    or t8, t2, zero
    b c65_next
    dsubu a2, a2, a0
c65_incdec_zp:               ; t2 = value +/- 1, t1 = host address, a0 = cycles
    b c65_store_zp
    andi t2, t2, 0xFF

    ; --- branches ------------------------------------------------------------
c65_br_not:                  ; not taken: no operand read (as the reference)
    addiu a1, a1, 2
    b c65_next
    daddiu a2, a2, -2
c65_br_take:
    jal c65_br_taken
    nop
    b c65_next
    daddiu a2, a2, -2
c65_br_taken:                ; leaf: t2 = offset, t1 = Base, a1 = new PC; the
    lb t2, 1(t0)             ; page-cross and taken cycles are charged here
    addiu t1, a1, 2
    andi t1, t1, 0xFFFF      ; Base: the next instruction's address
    andi v1, t2, 0xFF        ; the offset byte was the last on the bus
    addu a1, t1, t2
    andi a1, a1, 0xFFFF
    xor t0, a1, t1
    srl t0, t0, 8
    sltu t0, zero, t0
    dsubu a2, a2, t0         ; + 1 when the target is on another page
    jr ra
    daddiu a2, a2, -1        ; + 1 taken

    ; --- addressing modes: read (v1 = value; t2 = effective address) --------
c65_m_zp:                    ; t1 = host address of the zero-page byte
    lbu t2, 1(t0)
    addiu a1, a1, 2
    addu t1, t2, s1
    jr ra
    lbu v1, 0(t1)
c65_m_zpx:
    lbu t2, 1(t0)
    addiu a1, a1, 2
    addu t2, t2, s6
    andi t2, t2, 0xFF
    addu t1, t2, s1
    jr ra
    lbu v1, 0(t1)
c65_m_abs:
    lbu t1, 1(t0)
    lbu v1, 2(t0)            ; the high operand byte is on the bus
    addiu a1, a1, 3
    sll t2, v1, 8
    b c65_rd_ea
    or t2, t2, t1
c65_m_absx:
    lbu t1, 1(t0)
    lbu v1, 2(t0)
    addiu a1, a1, 3
    sll t2, v1, 8
    or t1, t2, t1            ; Base
    addu t2, t1, s6
    andi t2, t2, 0xFFFF
    xor t1, t1, t2
    srl t1, t1, 8
    sltu t1, zero, t1
    b c65_rd_ea
    dsubu a2, a2, t1         ; the page cross is charged before the read
c65_m_absy:
    lbu t1, 1(t0)
    lbu v1, 2(t0)
    addiu a1, a1, 3
    sll t2, v1, 8
    or t1, t2, t1
    addu t2, t1, s7
    andi t2, t2, 0xFFFF
    xor t1, t1, t2
    srl t1, t1, 8
    sltu t1, zero, t1
    b c65_rd_ea
    dsubu a2, a2, t1
c65_m_indy:                  ; (zp),Y
    lbu t1, 1(t0)
    addu t2, t1, s1
    lbu t2, 0(t2)            ; pointer low byte
    addiu t1, t1, 1
    andi t1, t1, 0xFF
    addu t1, t1, s1
    lbu v1, 0(t1)            ; pointer high byte, on the bus
    addiu a1, a1, 2
    sll t1, v1, 8
    or t1, t1, t2            ; Base
    addu t2, t1, s7
    andi t2, t2, 0xFFFF
    xor t1, t1, t2
    srl t1, t1, 8
    sltu t1, zero, t1
    b c65_rd_ea
    dsubu a2, a2, t1

    ; --- the read of guest address t2 (16 bits) into v1 ---------------------
c65_rd_ea:
    andi t1, t2, 0x8000
    bnez t1, c65_rd_prg
    sltiu t1, t2, 0x2000
    beqz t1, c65_rd_dev
    andi t1, t2, 0x7FF
    addu t1, t1, s1          ; internal RAM, mirrored every 2 KB
    jr ra
    lbu v1, 0(t1)
c65_rd_prg:                  ; PRG ROM: the MMC3 bias of its 8 KB slot
    andi t1, t2, 0x6000
    srl t1, t1, 10
    addu t1, t1, a3
    ld t1, 0(t1)
    addu t1, t1, t2
    jr ra
    lbu v1, 0(t1)
c65_rd_dev:                  ; $2000-$7FFF
    sltiu t1, t2, 0x4000
    bnez t1, c65_rd_call     ; PPU registers
    addiu t1, t2, -0x4015
    sltiu t1, t1, 3
    bnez t1, c65_rd_call     ; $4015-$4017
    sltiu t1, t2, 0x6000
    bnez t1, c65_rd_open     ; nothing answers: open bus
    nop
    ld t1, global_mapramenable-global_nesmmc3bias(a3)
    beqz t1, c65_rd_open
    andi t1, t2, 0x1FFF
    la t0, global_mapram     ; enabled work RAM
    addu t0, t0, t1
    jr ra
    lbu v1, 0(t0)
c65_rd_open:
    jr ra
    andi v1, v1, 0xFF
c65_rd_call:                 ; a device: the call-out to u_nesreaddev
    sd ra, global_c65link-global_nesmmc3bias(a3)
    sd t2, global_c65ea-global_nesmmc3bias(a3)
    jal c65_out
    sd t2, global_ea-global_nesmmc3bias(a3)
    jal u_nesreaddev         ; the device read, in the unit (unit/write.n64, N7)
    or a0, t2, zero
    jal c65_in
    nop
    ld t2, global_c65ea-global_nesmmc3bias(a3)
    ld ra, global_c65link-global_nesmmc3bias(a3)
    jr ra
    or v1, a0, zero          ; the value (NesRead left it on the bus too)

    ; --- addressing modes: effective address only (RMW and stores) ----------
c65_s_zpx:                   ; t1 = host address
    lbu t2, 1(t0)
    addiu a1, a1, 2
    addu t2, t2, s6
    andi t2, t2, 0xFF
    jr ra
    addu t1, t2, s1
c65_e_abs:
    lbu t1, 1(t0)
    lbu v1, 2(t0)
    addiu a1, a1, 3
    sll t2, v1, 8
    jr ra
    or t2, t2, t1
c65_e_absx:                  ; no page-cross cycle for RMW
    lbu t1, 1(t0)
    lbu v1, 2(t0)
    addiu a1, a1, 3
    sll t2, v1, 8
    or t2, t2, t1
    addu t2, t2, s6
    jr ra
    andi t2, t2, 0xFFFF
    ; stores: a0 = the value; tail into the write routine
c65_s_abs:
    addiu v0, zero, 3
    lbu t1, 1(t0)
    lbu v1, 2(t0)
    addiu a1, a1, 3
    sll t2, v1, 8
    b c65_wr_ea
    or t2, t2, t1
c65_s_absx:
    addiu v0, zero, 4
    lbu t1, 1(t0)
    lbu v1, 2(t0)
    addiu a1, a1, 3
    sll t2, v1, 8
    or t2, t2, t1
    addu t2, t2, s6
    b c65_wr_ea
    andi t2, t2, 0xFFFF
c65_s_absy:
    addiu v0, zero, 4
    lbu t1, 1(t0)
    lbu v1, 2(t0)
    addiu a1, a1, 3
    sll t2, v1, 8
    or t2, t2, t1
    addu t2, t2, s7
    b c65_wr_ea
    andi t2, t2, 0xFFFF
c65_s_indy:
    addiu v0, zero, 5
    lbu t1, 1(t0)
    addu t2, t1, s1
    lbu t2, 0(t2)
    addiu t1, t1, 1
    andi t1, t1, 0xFF
    addu t1, t1, s1
    lbu v1, 0(t1)
    addiu a1, a1, 2
    sll t1, v1, 8
    or t2, t2, t1
    addu t2, t2, s7
    b c65_wr_ea
    andi t2, t2, 0xFFFF

    ; --- the write of a0 to guest address t2 ---------------------------------
c65_wr_ea:
    sltiu t1, t2, 0x2000
    beqz t1, c65_wr_call
    andi t1, t2, 0x7FF
    addu t1, t1, s1          ; internal RAM
    sb a0, 0(t1)
    jr ra
    or v1, a0, zero          ; the written byte is on the bus
c65_wr_call:                 ; everything else: the call-out to NesWrite
    sd ra, global_c65link-global_nesmmc3bias(a3)
    sd t2, global_c65ea-global_nesmmc3bias(a3)
    sd a0, global_c65value-global_nesmmc3bias(a3)
    jal c65_out
    sd t2, global_ea-global_nesmmc3bias(a3)
    or a0, t2, zero
    jal u_neswrite
    ld a1, global_c65value-global_nesmmc3bias(a3)
    jal c65_in
    nop
    ld t2, global_c65ea-global_nesmmc3bias(a3)
    sltiu t1, t2, 0x6000     ; a write at $6000-$FFFF may change what is mapped (MMC3 banks,
    bnez t1, c65_wr_kept     ; work RAM enable): rebuild the fetch region
    nop
    or s4, zero, zero
c65_wr_kept:
    ld a0, global_c65value-global_nesmmc3bias(a3)
    ld ra, global_c65link-global_nesmmc3bias(a3)
    jr ra
    nop

    ; --- publish and reload the guest state around a call-out ---------------
c65_out:                     ; leaf, before a call-out: the globals the device code reads (PC,
    andi a1, a1, 0xFFFF      ; Left, the phase, the open bus) and the caller-saved guest state
    sd a1, global_pc-global_nesmmc3bias(a3)
    sd v1, global_nesopenbus-global_nesmmc3bias(a3)
    sd a2, global_left-global_nesmmc3bias(a3)
    sd t8, global_fn-global_nesmmc3bias(a3)
    sd t9, global_fc-global_nesmmc3bias(a3)
    sd t3, global_nesinstructions-global_nesmmc3bias(a3)
    jr ra
    sd v0, global_accessphase-global_nesmmc3bias(a3)
c65_in:                      ; leaf, after a call-out (a0 and t2 are left alone); A X Y FZ live
    la a3, global_nesmmc3bias  ; in s5 s6 s7 fp, which the callee kept
    ld a1, global_pc-global_nesmmc3bias(a3)
    ld v1, global_nesopenbus-global_nesmmc3bias(a3)
    ld a2, global_left-global_nesmmc3bias(a3)
    ld t8, global_fn-global_nesmmc3bias(a3)
    ld t9, global_fc-global_nesmmc3bias(a3)
    ld t3, global_nesinstructions-global_nesmmc3bias(a3)
    jr ra
    ld v0, global_accessphase-global_nesmmc3bias(a3)
c65_publish:                 ; leaf; the whole guest state, at the window's end
    andi a1, a1, 0xFFFF
    sd a1, global_pc-global_nesmmc3bias(a3)
    sd v1, global_nesopenbus-global_nesmmc3bias(a3)
    sd a2, global_left-global_nesmmc3bias(a3)
    sd s5, global_a-global_nesmmc3bias(a3)
    sd s6, global_x-global_nesmmc3bias(a3)
    sd s7, global_y-global_nesmmc3bias(a3)
    sd fp, global_fz-global_nesmmc3bias(a3)
    sd t8, global_fn-global_nesmmc3bias(a3)
    sd t9, global_fc-global_nesmmc3bias(a3)
    sd t3, global_nesinstructions-global_nesmmc3bias(a3)
    jr ra
    sd v0, global_accessphase-global_nesmmc3bias(a3)
c65_reload:                  ; leaf; a0 and t2 are left alone
    la a3, global_nesmmc3bias
    ld a1, global_pc-global_nesmmc3bias(a3)
    ld v1, global_nesopenbus-global_nesmmc3bias(a3)
    ld a2, global_left-global_nesmmc3bias(a3)
    ld s5, global_a-global_nesmmc3bias(a3)
    ld s6, global_x-global_nesmmc3bias(a3)
    ld s7, global_y-global_nesmmc3bias(a3)
    ld fp, global_fz-global_nesmmc3bias(a3)
    ld t8, global_fn-global_nesmmc3bias(a3)
    ld t9, global_fc-global_nesmmc3bias(a3)
    ld t3, global_nesinstructions-global_nesmmc3bias(a3)
    jr ra
    ld v0, global_accessphase-global_nesmmc3bias(a3)

    ; --- the end of the window: c65_wend below; c65_end (a stop's end, once a run) is in the cold part (C4) --
c65_restore:                 ; a3 = global_nesmmc3bias: the caller's registers back, and return
    ld s0, global_c65saves0-global_nesmmc3bias(a3)
    ld s1, global_c65saves1-global_nesmmc3bias(a3)
    ld s2, global_c65saves2-global_nesmmc3bias(a3)
    ld s3, global_c65saves3-global_nesmmc3bias(a3)
    ld s4, global_c65saves4-global_nesmmc3bias(a3)
    ld s5, global_c65saves5-global_nesmmc3bias(a3)
    ld s6, global_c65saves6-global_nesmmc3bias(a3)
    ld s7, global_c65saves7-global_nesmmc3bias(a3)
    ld fp, global_c65savefp-global_nesmmc3bias(a3)
    ld ra, global_c65savera-global_nesmmc3bias(a3)
    jr ra
    nop

    ; --- the window's end in place (design note N.46, step C3) ------------------
    ; WHAT: every window whose budget is spent (or that a device access closed) ends here. The run loop's work at
    ; a window's end - the catch-up, the DMC stalls, the interrupts, the frame hand-over, the next budget and the
    ; RAM-wait decision - is done here with the run loop's own procedures; where nothing the guest can observe
    ; happens at this end, the next window opens as CpuRun opens it and the core goes on without leaving.
    ; WHY: the core's exit and re-entry (publish and return, the run loop's tests, ten saves, the reload, the
    ; fetch region rebuilt) were ~285 of a core window's ~410 cycles, ~200 times a guest frame (N.46).
    ; WHY THE WINDOWS STILL END WHERE THEY DID: NMI and IRQs are taken at window ends, so the window grid is
    ; where the guest's interrupts are accepted; each window ends at the same guest cycle as before, only its
    ; end is cheaper. Only the run loop's caller-free state is touched here: everything is published first,
    ; CpuCycles and CpuInWindow are what c65_end leaves, so every procedure called sees what the run loop's sees.
    ; LEAVES (c65_leave, the run loop then repeats the catch-up at the same cycle - a no-op - and does the rest):
    ; an NMI to take, an IRQ with I clear, a guest frame to hand over, a stop, a RAM-wait rule at PC (the run
    ; loop batches it). Only the MMC3 run loop (c65_run_mapper4, through u_nesramcpuwindow / the waits'
    ; fall-backs) enters CpuRun in this configuration; cpu6502.n64 is built for no other.
    ; THE PLAIN TWIN (what the assembly computes):
    ;   CpuCycles=NesRunStart+Budget-Left : CpuInWindow=0          ; as c65_end, the state published
    ;   If CpuCycles>NesStatusHorizon And CpuCycles>NesCpuHorizon : NesMmc3AdvanceCpuTime(CpuCycles) : EndIf
    ;   While WorkerDmcCycles>NesSeenDmc                             ; the DMC stalls, as the run loop applies them
    ;     stalls=WorkerDmcCycles-NesSeenDmc : NesSeenDmc=WorkerDmcCycles
    ;     CpuCycles+stalls : NesMmc3AdvanceCpuTime(CpuCycles)
    ;   Wend
    ;   If WorkerNmi<>NesSeenNmi Or ((WorkerIrq|MapIrq) And FI=0) Or WorkerFrames<>NesDeliveredFrame Or
    ;      Stopped Or WorkerError : leave : EndIf
    ;   n=MapperCpuBudget() : If NesRamWaitRule(PC) : leave : EndIf ; (u_nesramwaitrule: the window's own look-up)
    ;   CpuCycles+NesStall : NesStall=0 : NesRunStart=CpuCycles : Budget=n : Left=n : CpuInWindow=1 : go on
c65_wend:
    jal c65_publish          ; the whole guest state, as c65_end publishes it
    nop
    la t0, global_cpucycles
    ld t1, global_nesrunstart-global_cpucycles(t0)
    ld t2, global_budget-global_cpucycles(t0)
    daddu t1, t1, t2
    dsubu a0, t1, a2         ; now = NesRunStart + Budget - Left
    sd a0, 0(t0)
    sd zero, global_cpuinwindow-global_cpucycles(t0)
    ld t1, global_nesstatushorizon-global_cpucycles(t0)
    slt t1, t1, a0
    beqz t1, c65_wend_stalls ; a horizon still ahead: no catch-up (as the run loop)
    ld t1, global_nescpuhorizon-global_cpucycles(t0)
    slt t1, t1, a0
    beqz t1, c65_wend_stalls
    nop
    jal u_nesmmc3advancecputime  ; the catch-up a window's end makes
    nop
c65_wend_stalls:
    la t0, global_cpucycles
    ld t1, global_workerdmccycles-global_cpucycles(t0)
    ld t2, global_nesseendmc-global_cpucycles(t0)
    dsubu t2, t1, t2
    blez t2, c65_wend_pending
    ld a0, 0(t0)
    sd t1, global_nesseendmc-global_cpucycles(t0)
    daddu a0, a0, t2         ; the stall's cycles
    jal u_nesmmc3advancecputime
    sd a0, 0(t0)
    b c65_wend_stalls
    nop
c65_wend_pending:
    ld t1, global_workernmi-global_cpucycles(t0)
    ld t2, global_nesseennmi-global_cpucycles(t0)
    bne t1, t2, c65_leave    ; an NMI to take
    ld t1, global_workerirq-global_cpucycles(t0)
    ld t2, global_mapirq-global_cpucycles(t0)
    or t1, t1, t2
    beqz t1, c65_wend_frame
    ld t2, global_fi-global_cpucycles(t0)
    beqz t2, c65_leave       ; an IRQ with I clear
    nop
c65_wend_frame:
    ld t1, global_workerframes-global_cpucycles(t0)
    ld t2, global_nesdeliveredframe-global_cpucycles(t0)
    bne t1, t2, c65_leave    ; a guest frame for the host
    ld t1, global_stopped-global_cpucycles(t0)
    ld t2, global_workererror-global_cpucycles(t0)
    or t1, t1, t2
    bnez t1, c65_leave
    nop
    jal u_mappercpubudget    ; a0 = the next window's budget
    nop
    jal u_nesramwaitrule     ; a2 = the RAM-wait rule at PC (keeps a0)
    move a1, zero
    bnez a2, c65_leave       ; a wait loop: the run loop batches it
    nop
    la t0, global_cpucycles  ; the next window, as CpuRun(n) opens it
    ld t1, 0(t0)
    ld t2, global_nesstall-global_cpucycles(t0)
    daddu t1, t1, t2
    sd t1, 0(t0)
    sd zero, global_nesstall-global_cpucycles(t0)
    sd t1, global_nesrunstart-global_cpucycles(t0)
    daddiu t2, zero, 1
    sd t2, global_cpuinwindow-global_cpucycles(t0)
    sd a0, global_budget-global_cpucycles(t0)
    jal c65_in               ; the core's caller-saved registers (a2 = Left = n); A X Y FZ stayed in s5-s7, fp
    sd a0, global_left-global_cpucycles(t0)
    b c65_go                 ; the fetch region is still PC's: nothing has remapped it
    subu t1, a1, s2
c65_leave:                   ; the rest of this end is the run loop's: return to it as c65_end does
    la a3, global_nesmmc3bias
    la t0, global_cpucycles
    ld t1, global_nesrunstart-global_cpucycles(t0)
    ld a0, 0(t0)
    b c65_restore
    dsubu a0, a0, t1         ; CpuCycles - NesRunStart (read by no caller in this configuration)

    ; --- the fetch region and the slow fetch ----------------------------------
c65_rebase:                  ; a1 = PC
    andi a1, a1, 0xFFFF
    andi t1, a1, 0x8000
    bnez t1, c65_rebase_prg
    sltiu t1, a1, 0x2000
    bnez t1, c65_rebase_ram
    sltiu t1, a1, 0x6000
    bnez t1, c65_fetch_slow
    nop
    ld t1, global_mapramenable-global_nesmmc3bias(a3)
    beqz t1, c65_fetch_slow
    ori s2, zero, 0x6000     ; enabled work RAM: one 8 KB region
    la t1, global_mapram
    subu s3, t1, s2
    b c65_refetch
    ori s4, zero, 0x1FFD
c65_rebase_ram:              ; one 2 KB mirror of internal RAM
    andi s2, a1, 0xF800
    subu s3, s1, s2
    b c65_refetch
    ori s4, zero, 0x7FD
c65_rebase_prg:              ; one 8 KB PRG slot through its MMC3 bias
    andi s2, a1, 0xE000
    andi t1, a1, 0x6000
    srl t1, t1, 10
    addu t1, t1, a3
    ld s3, 0(t1)
    ori s4, zero, 0x1FFD
c65_refetch:
    subu t1, a1, s2
    sltu t1, t1, s4
    beqz t1, c65_fetch_slow  ; the instruction runs over the region's end
    addu t0, a1, s3
    b c65_dispatch
    lbu a0, 0(t0)
  EndASM
  ; --- the rest of the hot unit (design note, section N): the window code, the time advance
  ; and the bus write, placed here, after the core's hot part and before its cold part, so that
  ; all of it lies in one span under 16 KB and no two of its hot lines share an I-cache set.
  XIncludeFile "../n64/unit/window.n64"
  XIncludeFile "../n64/unit/advance.n64"
  XIncludeFile "../n64/unit/write.n64"
  XIncludeFile "../n64/unit/ppu.n64"
  XIncludeFile "../n64/unit/apu.n64"
  XIncludeFile "../n64/unit/slot.n64"     ; the mapper slot, the hot span's last bytes (mapper modules)
  ASM
    ; --- the core's cold part: the slow fetch, the status byte, the illegal stop, the shapes
c65_fetch_slow:              ; copy the instruction's bytes into the buffer
    jal c65_peek
    or t2, a1, zero
    la t0, global_c65fetch
    sb t1, 0(t0)
    or a0, t1, zero
    la t0, c65_lengths
    addu t0, t0, a0
    lbu t0, 0(t0)
    sd t0, global_c65count-global_nesmmc3bias(a3)
    sltiu t1, t0, 2
    bnez t1, c65_fetch_buffered
    addiu t2, a1, 1
    jal c65_peek
    andi t2, t2, 0xFFFF
    la t0, global_c65fetch
    sb t1, 1(t0)
    ld t0, global_c65count-global_nesmmc3bias(a3)
    sltiu t1, t0, 3
    bnez t1, c65_fetch_buffered
    addiu t2, a1, 2
    jal c65_peek
    andi t2, t2, 0xFFFF
    la t0, global_c65fetch
    sb t1, 2(t0)
c65_fetch_buffered:
    la t0, global_c65fetch
    b c65_dispatch
    lbu a0, 0(t0)
c65_peek:                    ; leaf: t1 = the byte at guest address t2 (no side effect)
    andi t1, t2, 0x8000
    bnez t1, c65_peek_prg
    sltiu t1, t2, 0x2000
    bnez t1, c65_peek_ram
    sltiu t1, t2, 0x6000
    bnez t1, c65_bad_fetch
    nop
    ld t1, global_mapramenable-global_nesmmc3bias(a3)
    beqz t1, c65_bad_fetch
    andi t1, t2, 0x1FFF
    la t0, global_mapram
    addu t0, t0, t1
    jr ra
    lbu t1, 0(t0)
c65_peek_ram:
    andi t1, t2, 0x7FF
    addu t1, t1, s1
    jr ra
    lbu t1, 0(t1)
c65_peek_prg:
    andi t1, t2, 0x6000
    srl t1, t1, 10
    addu t1, t1, a3
    ld t1, 0(t1)
    addu t1, t1, t2
    jr ra
    lbu t1, 0(t1)

    ; --- C6 (design note N.48): the cold part's ORDER is chosen by measured heat. A cold byte at cold position p
    ; shares its I-cache set with the hot span's byte at p - (16384 - span) (the record cart: p - 72), so the cold
    ; part lies over the hot span's first ~8 KB: the dispatch, the opcode slot grid (many of its lines are opcodes
    ; a game never runs) and the rests / modes / call-outs after it. The units that run every frame (the poll, the
    ; APU timing's cold half, the status byte, the APU write and its log, the coalescing, the DMC bound, the PPU's
    ; cold half) are placed over the slot grid's coldest lines, the units at 0 cycles over the hot lines. Every
    ; unit ends in an unconditional transfer and is entered only by a branch or jal, so the order changes no
    ; path and no instruction; the cold part's size is unchanged, so nothing after the unit moves. c65_fetch_slow
    ; stays first (the hot span's measure) and a12_cold.n64 last (its table and c65_lengths keep their addresses).

    ; --- moved here from the hot span by measured heat (N7, design note N.40: measured at 0 cycles a guest
    ; frame in SMB3, frames 0-3600); each is entered by a branch and leaves by one -----------------------
c65_op_00_rest:
    srl t0, a1, 8
    addu t1, s1, t2
    sb t0, 0x100(t1)
    addiu t2, t2, -1
    andi t2, t2, 0xFF
    addu t1, s1, t2
    sb a1, 0x100(t1)
    addiu t2, t2, -1
    jal c65_status           ; t0 = P (t2 survives)
    andi t2, t2, 0xFF
    ori t0, t0, 0x10         ; B set in the pushed copy
    sd t0, global_tmp-global_nesmmc3bias(a3)
    addu t1, s1, t2
    sb t0, 0x100(t1)
    addiu t2, t2, -1
    andi t2, t2, 0xFF
    sd t2, global_s-global_nesmmc3bias(a3)
    daddiu t1, zero, 1
    sd t1, global_fi-global_nesmmc3bias(a3)
    ld t1, 24(a3)            ; the vector at $FFFE in the top 8 KB slot
    ori t2, zero, 0xFFFE
    addu t1, t1, t2
    lbu t0, 0(t1)
    lbu v1, 1(t1)
    sll t1, v1, 8
    or a1, t0, t1
    b c65_next
    daddiu a2, a2, -7
c65_m_indx:                  ; (zp,X)
    lbu t1, 1(t0)
    addu t1, t1, s6
    andi t1, t1, 0xFF
    addu t2, t1, s1
    lbu t2, 0(t2)
    addiu t1, t1, 1
    andi t1, t1, 0xFF
    addu t1, t1, s1
    lbu v1, 0(t1)
    addiu a1, a1, 2
    sll t1, v1, 8
    b c65_rd_ea
    or t2, t2, t1
c65_s_indx:
    addiu v0, zero, 5
    lbu t1, 1(t0)
    addu t1, t1, s6
    andi t1, t1, 0xFF
    addu t2, t1, s1
    lbu t2, 0(t2)
    addiu t1, t1, 1
    andi t1, t1, 0xFF
    addu t1, t1, s1
    lbu v1, 0(t1)
    addiu a1, a1, 2
    sll t1, v1, 8
    b c65_wr_ea
    or t2, t2, t1

    ; --- moved out of the hot span by measured heat (C4, design note N.46b: 0 cycles a guest frame) ----------
    ; c65_end: the window's end by a stop (an illegal opcode, code fetched from device space) - since C3 every other
    ; end is c65_wend's. It publishes the state, sets CpuCycles = NesRunStart + Budget - Left and CpuInWindow = 0,
    ; and returns CpuCycles - NesRunStart to the run loop through c65_restore (a3 = global_nesmmc3bias, as the
    ; core keeps it). Unchanged but for the branch to c65_restore, which it used to fall into.
c65_end:
  EndASM
  CompilerIf #NES_CPU_TRACE
    ASM
      or a4, s5, zero        ; the digest reads A X Y FZ in a4-a7
      or a5, s6, zero
      or a6, s7, zero
      jal nescputracestep    ; a window can end without passing c65_next
      or a7, fp, zero
    EndASM
  CompilerEndIf
  ASM
    jal c65_publish
    nop
    ; CpuCycles = NesRunStart + Budget - Left : CpuInWindow = 0
    la t0, global_cpucycles
    ld t1, global_nesrunstart-global_cpucycles(t0)
    ld t2, global_budget-global_cpucycles(t0)
    daddu t2, t1, t2
    dsubu t2, t2, a2
    sd t2, 0(t0)
    sd zero, global_cpuinwindow-global_cpucycles(t0)
    b c65_restore
    dsubu a0, t2, t1         ; ProcedureReturn CpuCycles - NesRunStart
    ; c65_rw_stop / c65_rw_exit: the run loop's end (NesRunMapper4's return; s0, s1 and ra from its frame).
c65_rw_stop:
    move a0, zero
c65_rw_exit:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    jr ra
    daddiu sp, sp, 32
c65_bad_fetch:               ; code fetched from device space: stop loudly
    lui t1, 1
    or t1, t1, t2
    sd t1, global_badopcode-global_nesmmc3bias(a3)
    daddiu t1, zero, 1
    sd t1, global_stopped-global_nesmmc3bias(a3)
    b c65_end
    nop

    ; --- the batching shapes (cold). Each is the reference's PureMetal condition, evaluated on the live
    ; registers; the call-outs are the same procedures. The poll first (it runs every frame), the others below.
c65_poll:                    ; LDA / BIT abs whose device read ended the window
    addiu t1, a1, -0x7FFF    ; If Left=0 And PC>=$8003 And NesStatusHorizon>CpuCycles+8
    addiu t1, t1, -4
    bltz t1, c65_poll_done
    nop
    la t0, global_cpucycles
    ld t0, 0(t0)
    la t1, global_nesstatushorizon
    ld t1, 0(t1)
    daddiu t0, t0, 8
    slt t0, t0, t1
    beqz t0, c65_poll_done
    nop
    jal c65_out
    nop
    jal nescurrentpoll       ; NesLoopRule = NesCurrentPoll(acc in a0)
    nop
    jal c65_in
    nop
    la t1, global_neslooprule
    sd a0, 0(t1)
c65_poll_rule:
    beqz a0, c65_poll_done
    andi t0, a0, 0xFF        ; NesLoopCost = rule & 255
    la t1, global_nesloopcost
    sd t0, 0(t1)
    la t1, global_nesstatushorizon
    ld t1, 0(t1)
    la t2, global_cpucycles
    ld t2, 0(t2)
    dsubu t1, t1, t2
    daddiu t1, t1, -4
    ddiv t1, t0        ; NesIdleExtra = (NesStatusHorizon-CpuCycles-4)/NesLoopCost
    mflo t1
    nop
    nop
    la t2, global_nesidleextra
    sd t1, 0(t2)
    blez t1, c65_poll_done
    nop
    dmult t1, t0
    mflo t2
    dsubu a2, a2, t2         ; Left = Left - NesIdleExtra*NesLoopCost
    srl t2, a0, 8
    andi t2, t2, 0xFF
    dmult t1, t2
    mflo t2
    daddu t3, t3, t2         ; NesInstructions + NesIdleExtra*((rule>>8)&255)
    lui t1, 0x200
    and t1, a0, t1
    beqz t1, c65_poll_done
    srl t1, a0, 16           ; If rule&$2000000 : FC = ~(((rule>>16)&511)-256)
    andi t1, t1, 511
    addiu t1, t1, -256
    nor t9, t1, zero
c65_poll_done:
    b c65_next
    daddiu a2, a2, -4

    ; the handler rests and addressing modes that run 0 cycles a guest frame in SMB3 (the C2 record replay's profile), out of
    ; the hot span by measured heat for C3 (design note N.46); each is entered by a branch or jal and leaves
    ; by one, so the move changes no path
c65_op_0e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    sll t9, v1, 1
    b c65_rmw_write
    addiu t0, zero, 6
c65_op_1e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    sll t9, v1, 1
    b c65_rmw_write
    addiu t0, zero, 7
c65_op_2c_rest:
    sll t1, v1, 1            ; V = bit 6
    sd t1, global_fv-global_nesmmc3bias(a3)
    and fp, s5, v1           ; Z from A AND value
    beqz a2, c65_poll
    or a0, v1, zero
    b c65_next
    daddiu a2, a2, -4
c65_op_36_rest:
    andi t2, t2, 1
    sll t9, v1, 1
    or t9, t9, t2
    b c65_rmw_zp
    addiu a0, zero, 6
c65_op_3e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    srl t1, t9, 8
    andi t1, t1, 1
    sll t9, v1, 1
    or t9, t9, t1
    b c65_rmw_write
    addiu t0, zero, 7
c65_op_5e_rest:
    jal c65_rd_ea
    nop
    addiu v0, v0, 2
    sll t9, v1, 8
    srl fp, v1, 1
    b c65_rmw_write_res
    addiu t0, zero, 7
c65_op_6a_rest:
    srl s5, s5, 1
    or s5, s5, t0
    daddiu a2, a2, -2
    b c65_nza
    addiu a1, a1, 1
c65_op_76_rest:
    andi t2, t2, 0x80
    srl t0, v1, 1
    or t2, t2, t0
    sll t9, v1, 8
    b c65_store_zp
    addiu a0, zero, 6
c65_m_zpy:
    lbu t2, 1(t0)
    addiu a1, a1, 2
    addu t2, t2, s7
    andi t2, t2, 0xFF
    addu t1, t2, s1
    jr ra
    lbu v1, 0(t1)
c65_s_zpy:
    lbu t2, 1(t0)
    addiu a1, a1, 2
    addu t2, t2, s7
    andi t2, t2, 0xFF
    jr ra
    addu t1, t2, s1
    ; --- four handler rests moved out of the hot span to make room for the mapper slot's save mark (mapper-modules
    ; design note, section 8c): 0 cycles a guest frame in the step-1 measuring run (ASL / LSR zp,X, STX zp,Y, SED);
    ; each is entered by its slot's branch and leaves by a branch, so the move changes no path ---
c65_op_16_rest:
    b c65_rmw_zp
    addiu a0, zero, 6
c65_op_56_rest:
    srl t2, v1, 1
    b c65_store_zp
    addiu a0, zero, 6
c65_op_96_rest:
    or v1, s6, zero
    b c65_next
    daddiu a2, a2, -4
c65_op_f8_rest:
    b c65_next
    daddiu a2, a2, -2
c65_illegal:                 ; an undocumented opcode stops the CPU
    daddiu t3, t3, -1        ; it does not count as executed
    jal c65_rd_ea            ; BadOpcode = NesRead(PC)
    or t2, a1, zero
    sd v1, global_badopcode-global_nesmmc3bias(a3)
    daddiu t1, zero, 1
    sd t1, global_stopped-global_nesmmc3bias(a3)
    b c65_end
    nop
  EndASM
  XIncludeFile "../n64/unit/apu_cold.n64"
  ASM
    ; --- read-modify-write of a device-reachable address -----------------------
c65_rmw_write:               ; t9 = shifted value (C in bit 8), v1 = the value read,
    andi fp, t9, 0xFF        ; t2 = ea, v0 = phase, t0 = cycles
c65_rmw_write_res:           ; fp here = the result byte (Z from it)
    or t8, fp, zero          ; N and Z from the result, before the writes
    sd t0, global_c65count-global_nesmmc3bias(a3)
    addiu v0, v0, -1
    jal c65_wr_ea            ; the unchanged value first, at phase - 1
    or a0, v1, zero
    addiu v0, v0, 1
    jal c65_wr_ea            ; then the result, at phase
    or a0, fp, zero
    ld t0, global_c65count-global_nesmmc3bias(a3)
    b c65_next
    dsubu a2, a2, t0

    ; --- status byte ------------------------------------------------------------
c65_status:                  ; leaf: t0 = NV1BDIZC with B clear (t1 scratch)
    andi t0, t8, 0x80
    ld t1, global_fv-global_nesmmc3bias(a3)
    andi t1, t1, 0x80
    srl t1, t1, 1
    or t0, t0, t1
    ld t1, global_fd-global_nesmmc3bias(a3)
    sll t1, t1, 3
    or t0, t0, t1
    ld t1, global_fi-global_nesmmc3bias(a3)
    sll t1, t1, 2
    or t0, t0, t1
    srl t1, t9, 8
    andi t1, t1, 1
    or t0, t0, t1
    andi t1, fp, 0xFF
    sltiu t1, t1, 1
    sll t1, t1, 1
    or t0, t0, t1
    jr ra
    ori t0, t0, 0x20
c65_setstatus:               ; leaf: the flags from P in t0 (t1 scratch)
    or t8, t0, zero
    sll t1, t0, 1
    sd t1, global_fv-global_nesmmc3bias(a3)
    andi t9, t0, 1
    sll t9, t9, 8
    andi fp, t0, 2
    xori fp, fp, 2
    srl t1, t0, 3
    andi t1, t1, 1
    sd t1, global_fd-global_nesmmc3bias(a3)
    srl t1, t0, 2
    andi t1, t1, 1
    jr ra
    sd t1, global_fi-global_nesmmc3bias(a3)
c65_irq_check:               ; after PLP / RTI / CLI: a pending mapper IRQ with I clear
    ld t1, global_fi-global_nesmmc3bias(a3)   ; ends the window (CpuEndWindow); a0 = cycles
    bnez t1, c65_irq_none
    nop
    ld t1, global_mapirq-global_nesmmc3bias(a3)
    beqz t1, c65_irq_none
    nop
    ld t1, global_budget-global_nesmmc3bias(a3)
    dsubu t1, t1, a2
    sd t1, global_budget-global_nesmmc3bias(a3)
    or a2, zero, zero
c65_irq_none:
    b c65_next
    dsubu a2, a2, a0
  EndASM
  XIncludeFile "../n64/unit/cold.n64"
  ; the PPU's cold half; the PPU state machine's checking build (empty in every other build) after it
  XIncludeFile "../n64/unit/ppu_cold.n64"
  XIncludeFile "../n64/unit/ppu_check.n64"
  ASM
    ; --- the batching shapes, continued (0-500 cycles a guest frame) ---
c65_bne_shape:               ; BNE -6: the LDA $2002 / INX / BNE wait (t1 = Base)
    la t0, global_nesidleenabled
    ld t0, 0(t0)
    beqz t0, c65_shape_done
    nop
    blez s6, c65_shape_done  ; X > 0
    slti t0, a2, 13
    bnez t0, c65_shape_done  ; Left > 12
    andi t0, a1, 0x8000
    beqz t0, c65_shape_done  ; PC >= $8000
    ori t0, zero, 0xFFFB
    sltu t0, a1, t0
    beqz t0, c65_shape_done  ; PC <= $FFFA
    andi t0, a1, 0x1FFF
    sltiu t0, t0, 0x1FFB
    beqz t0, c65_shape_done  ; (PC & $1FFF) <= $1FFA: every pattern byte in PC's 8 KB slot
    nop
    jal c65_shape_now        ; t0 = now, true when now < PpuStatusDeadline
    sd t1, global_c65count-global_nesmmc3bias(a3)
    beqz a0, c65_shape_done
    nop
    jal c65_shape_ptr        ; t0 = NesPollPtr, PC through its mapped bank
    nop
    lbu t2, 0(t0)
    xori t2, t2, 0xAD
    bnez t2, c65_shape_done
    lbu t2, 1(t0)
    xori t2, t2, 0x02
    bnez t2, c65_shape_done
    lbu t2, 2(t0)
    xori t2, t2, 0x20
    bnez t2, c65_shape_done
    lbu t2, 3(t0)
    xori t2, t2, 0xE8
    bnez t2, c65_shape_done
    lbu t2, 4(t0)
    xori t2, t2, 0xD0
    bnez t2, c65_shape_done
    lbu t2, 5(t0)
    xori t2, t2, 0xFA
    bnez t2, c65_shape_done
    addiu a0, zero, 9
    jal c65_shape_count      ; t0 = NesPollCount (clamped to the deadline), t1 = cycles
    nop
    addiu a0, zero, 255      ; If NesPollCount > 255-X : NesPollCount = 255-X
    subu a0, a0, s6
    slt t2, a0, t0
    beqz t2, c65_bne_count
    nop
    or t0, a0, zero
c65_bne_count:
    la t2, global_nespollcount
    sd t0, 0(t2)
    blez t0, c65_shape_done
    addiu a0, zero, 3
    jal c65_shape_charge     ; Left, NesInstructions, NesIdleBatched (a0 = per poll)
    nop
    jal c65_shape_status     ; A = NesPollStatusDone()
    nop
    or s5, a0, zero
    la t0, global_nespollcount
    ld t0, 0(t0)
    daddu s6, s6, t0         ; X = X + NesPollCount : FN = X : FZ = X
    or t8, s6, zero
    or fp, s6, zero
    b c65_shape_done
    addiu v1, zero, 0xFA     ; NesOpenBus = $FA

c65_bne_shape3:              ; BNE -3: a DEX / BNE or DEY / BNE countdown onto itself (t1 = Base)
    ; The reference's fourth shortcut (rp2040/generate_cpu.py, the countdown superinstruction):
    ; a timing delay that only decrements X or Y. Its further passes are run at once: each is
    ; 5 cycles (6 when the branch crosses a page) and 2 instructions, the counter falls by one,
    ; nothing touches the bus. The taken branch just run still owes its final two cycles
    ; (Left - 3), and the batch stops one pass short of zero, so the ordinary dispatch runs the
    ; DEX / BNE that ends the loop. Tmp and Ea, the reference's scratch globals, are not stored:
    ; every instruction that reads them writes them first.
    la t0, global_nesidleenabled
    ld t0, 0(t0)
    beqz t0, c65_shape_done
    slti t0, a2, 9
    bnez t0, c65_shape_done  ; Left > 8
    andi t0, a1, 0x8000
    beqz t0, c65_shape_done  ; PC >= $8000
    ori t0, zero, 0xFFFE
    sltu t0, a1, t0
    beqz t0, c65_shape_done  ; PC <= $FFFD
    andi t0, a1, 0x1FFF
    sltiu t0, t0, 0x1FFE
    beqz t0, c65_shape_done  ; (PC & $1FFF) <= $1FFD: the three bytes in PC's 8 KB slot
    nop
    sd t1, global_c65count-global_nesmmc3bias(a3)
    jal c65_shape_ptr
    nop
    lbu t2, 1(t0)
    xori t2, t2, 0xD0
    bnez t2, c65_shape_done  ; PeekA(NesPollPtr+1) = $D0 (BNE)
    lbu t2, 2(t0)
    xori t2, t2, 0xFD
    bnez t2, c65_shape_done  ; PeekA(NesPollPtr+2) = $FD (-3)
    lbu t2, 0(t0)            ; t2 = Tmp: the decrement
    or a6, t2, zero          ; kept in a6 (c65_shape_charge uses t2)
    xori a0, t2, 0xCA
    beqz a0, c65_cnt_go      ; $CA DEX: the counter is X
    or a4, s6, zero
    xori a0, t2, 0x88
    bnez a0, c65_shape_done  ; neither DEX nor $88 DEY: no batch
    or a4, s7, zero          ; DEY: the counter is Y
c65_cnt_go:
    ld t1, global_c65count-global_nesmmc3bias(a3)            ; NesPollCycles = 5, 6 across a page
    xor t1, t1, a1
    srl t1, t1, 8
    sltu t1, zero, t1
    addiu t1, t1, 5
    la t0, global_nespollcycles
    sd t1, 0(t0)
    daddiu t0, a2, -3        ; NesPollCount = NesDiv(Left-3, NesPollCycles)
    ddiv t0, t1
    mflo t0
    addiu a0, a4, -1
    andi a0, a0, 0xFF        ; at most (counter - 1) & 255 passes: stop one short of zero
    slt a5, a0, t0
    beqz a5, c65_cnt_count
    nop
    or t0, a0, zero
c65_cnt_count:
    la a0, global_nespollcount
    sd t0, 0(a0)
    blez t0, c65_shape_done
    addiu a0, zero, 2
    jal c65_shape_charge     ; Left, NesInstructions, NesIdleBatched (2 a pass); t0 kept
    nop
    dsubu a4, a4, t0
    andi a4, a4, 0xFF        ; counter = (counter - NesPollCount) & 255
    xori a6, a6, 0xCA
    bnez a6, c65_cnt_y
    or t8, a4, zero          ; FN = counter
    b c65_cnt_done
    or s6, a4, zero          ; X = counter
c65_cnt_y:
    or s7, a4, zero          ; Y = counter
c65_cnt_done:
    or fp, a4, zero          ; FZ = counter
    b c65_shape_done
    addiu v1, zero, 0xFD     ; NesOpenBus = $FD

c65_beq_shape7:              ; BEQ -7: the LDA $2002 / AND #$40 / BEQ wait
    la t0, global_nesidleenabled
    ld t0, 0(t0)
    beqz t0, c65_shape_done
    nop
    bnez s5, c65_shape_done  ; A = 0
    nop
    la t0, global_ppustatusbits
    ld t0, 0(t0)
    andi t0, t0, 0x40
    bnez t0, c65_shape_done  ; (PpuStatusBits & $40) = 0
    slti t0, a2, 13
    bnez t0, c65_shape_done  ; Left > 12
    andi t0, a1, 0x8000
    beqz t0, c65_shape_done
    ori t0, zero, 0xFFFA
    sltu t0, a1, t0
    beqz t0, c65_shape_done  ; PC <= $FFF9
    andi t0, a1, 0x1FFF
    sltiu t0, t0, 0x1FFA
    beqz t0, c65_shape_done  ; (PC & $1FFF) <= $1FF9: every pattern byte in PC's 8 KB slot
    nop
    jal c65_shape_now
    sd t1, global_c65count-global_nesmmc3bias(a3)
    beqz a0, c65_shape_done
    nop
    jal c65_shape_ptr
    nop
    lbu t2, 0(t0)
    xori t2, t2, 0xAD
    bnez t2, c65_shape_done
    lbu t2, 1(t0)
    xori t2, t2, 0x02
    bnez t2, c65_shape_done
    lbu t2, 2(t0)
    xori t2, t2, 0x20
    bnez t2, c65_shape_done
    lbu t2, 3(t0)
    xori t2, t2, 0x29
    bnez t2, c65_shape_done
    lbu t2, 4(t0)
    xori t2, t2, 0x40
    bnez t2, c65_shape_done
    lbu t2, 5(t0)
    xori t2, t2, 0xF0
    bnez t2, c65_shape_done
    lbu t2, 6(t0)
    xori t2, t2, 0xF9
    bnez t2, c65_shape_done
    addiu a0, zero, 9
    jal c65_shape_count
    nop
    la t2, global_nespollcount
    sd t0, 0(t2)
    blez t0, c65_shape_done
    addiu a0, zero, 3
    jal c65_shape_charge
    nop
    jal c65_shape_status     ; NesPollStatusDone(), its value dropped
    nop
    or t8, zero, zero        ; FN = 0 : FZ = 0
    or fp, zero, zero
    b c65_shape_done
    addiu v1, zero, 0xF9

c65_beq_shape4:              ; BEQ -4: the LDA zp / BEQ wait on a RAM byte
    la t0, global_nesidleenabled
    ld t0, 0(t0)
    beqz t0, c65_shape_done
    nop
    bnez s5, c65_shape_done  ; A = 0
    slti t0, a2, 10
    bnez t0, c65_shape_done  ; Left > 9
    andi t0, a1, 0x8000
    beqz t0, c65_shape_done
    ori t0, zero, 0xFFFD
    sltu t0, a1, t0
    beqz t0, c65_shape_done  ; PC <= $FFFC
    andi t0, a1, 0x1FFF
    sltiu t0, t0, 0x1FFD
    beqz t0, c65_shape_done  ; (PC & $1FFF) <= $1FFC: every pattern byte in PC's 8 KB slot
    nop
    sd t1, global_c65count-global_nesmmc3bias(a3)
    jal c65_shape_ptr
    nop
    lbu t2, 0(t0)
    xori t2, t2, 0xA5
    bnez t2, c65_shape_done
    lbu t2, 2(t0)
    xori t2, t2, 0xF0
    bnez t2, c65_shape_done
    lbu t2, 3(t0)
    xori t2, t2, 0xFC
    bnez t2, c65_shape_done
    lbu t2, 1(t0)
    addu t2, t2, s1
    lbu t2, 0(t2)
    bnez t2, c65_shape_done  ; M(PeekA(NesPollPtr+1)) = 0
    nop
    ld t1, global_c65count-global_nesmmc3bias(a3)            ; NesPollCycles = 6, 7 across a page
    xor t1, t1, a1
    srl t1, t1, 8
    sltu t1, zero, t1
    addiu t1, t1, 6
    la t0, global_nespollcycles
    sd t1, 0(t0)
    daddiu t0, a2, -3        ; NesPollCount = NesDiv(Left-3, NesPollCycles)
    ddiv t0, t1
    mflo t0
    la t2, global_nespollcount
    sd t0, 0(t2)
    addiu a0, zero, 2        ; applied even when the count is 0, as the reference
    jal c65_shape_charge
    nop
    or t8, zero, zero
    or fp, zero, zero
    addiu v1, zero, 0xFC
c65_shape_done:
    b c65_next
    daddiu a2, a2, -2

c65_shape_now:               ; leaf: t0 = NesRunStart+Budget-Left; a0 = (t0 < PpuStatusDeadline)
    la t0, global_nesrunstart
    ld t0, 0(t0)
    ld t2, global_budget-global_nesmmc3bias(a3)
    daddu t0, t0, t2
    dsubu t0, t0, a2
    sd t0, global_c65value-global_nesmmc3bias(a3)
    la t2, global_ppustatusdeadline
    ld t2, 0(t2)
    jr ra
    slt a0, t0, t2
c65_shape_ptr:               ; leaf: t0 = NesPollPtr = NesMmc3Bias(PC >> 13 & 3) + PC (stored):
    srl t0, a1, 13           ; the host address of PC through the bank mapped at its 8 KB slot
    andi t0, t0, 3           ; (PrgBias is the linear start of PRG, not the banked view); the
    sll t0, t0, 3            ; callers keep every pattern byte inside that slot
    daddu t0, t0, a3         ; a3 = &NesMmc3Bias(0), 8-byte entries
    ld t0, 0(t0)
    daddu t0, t0, a1
    la t2, global_nespollptr
    jr ra
    sd t0, 0(t2)
c65_shape_count:             ; leaf: a0 = 9; t1 = NesPollCycles (+1 across a page);
    ld t1, global_c65count-global_nesmmc3bias(a3)            ; t0 = min(NesDiv(Left-3, c), NesDiv(Deadline-now+4, c))
    xor t1, t1, a1
    srl t1, t1, 8
    sltu t1, zero, t1
    addu t1, t1, a0
    la t0, global_nespollcycles
    sd t1, 0(t0)
    daddiu t0, a2, -3
    ddiv t0, t1
    mflo t0
    la t2, global_ppustatusdeadline
    ld t2, 0(t2)
    ld a0, global_c65value-global_nesmmc3bias(a3)
    dsubu t2, t2, a0
    daddiu t2, t2, 4
    ddiv t2, t1
    mflo t2
    sd t2, global_tmp-global_nesmmc3bias(a3)
    slt a0, t2, t0
    beqz a0, c65_shape_count_done
    nop
    or t0, t2, zero
c65_shape_count_done:
    jr ra
    nop
c65_shape_charge:            ; leaf: t0 = count, t1 = cycles a poll, a0 = instructions a poll
    dmult t0, t1
    mflo t2
    dsubu a2, a2, t2         ; CpuTick(NesPollCount*NesPollCycles)
    nop
    dmult t0, a0
    mflo t2
    daddu t3, t3, t2         ; NesInstructions + count*a0
    la t1, global_nesidlebatched
    ld a0, 0(t1)
    daddu a0, a0, t2
    jr ra
    sd a0, 0(t1)
c65_shape_status:            ; a0 = NesPollStatusDone(), the state published and reloaded
    sd ra, global_c65link-global_nesmmc3bias(a3)
    or t2, a1, zero          ; Ea = PC, as the reference's taken branch left it
    jal c65_out
    sd t2, global_ea-global_nesmmc3bias(a3)
    jal nespollstatusdone
    nop
    jal c65_in
    nop
    ld ra, global_c65link-global_nesmmc3bias(a3)
    jr ra
    nop

c65_jmp_self:                ; JMP to itself; t2 = a1 = Ea
    la t0, global_nesidleenabled
    ld t0, 0(t0)
    beqz t0, c65_jmp_go
    slti t1, a2, 4
    bnez t1, c65_jmp_go      ; Left > 3
    nop
    la t0, global_nesstall
    ld t0, 0(t0)
    bnez t0, c65_jmp_go      ; NesStall = 0
    sltiu t1, t2, 0x1FFE
    bnez t1, c65_jmp_idle    ; Ea < $1FFE Or Ea >= $8000
    andi t1, t2, 0x8000
    beqz t1, c65_jmp_go
    nop
c65_jmp_idle:
    daddiu t0, a2, -1
    daddiu t1, zero, 3
    ddiv t0, t1        ; NesIdleExtra = NesDiv(Left-1, 3)
    mflo t0
    la t1, global_nesidleextra
    sd t0, 0(t1)
    dsll t1, t0, 1
    daddu t1, t1, t0
    dsubu a2, a2, t1         ; Left - NesIdleExtra*3
    daddu t3, t3, t0         ; NesInstructions + NesIdleExtra
    la t1, global_nesidlebatched
    ld a0, 0(t1)
    daddu a0, a0, t0
    sd a0, 0(t1)
c65_jmp_go:
    or a1, t2, zero
    b c65_next
    daddiu a2, a2, -3
  EndASM
  XIncludeFile "../n64/unit/a12_cold.n64"
  ASM

    ; --- data (read through the D-cache only) -------------------------------------
    .align 2
c65_lengths:                 ; bytes an instruction occupies, by opcode (the slow fetch)
    .word 0x01020101, 0x01020201, 0x01020101, 0x01030301, 0x02020101, 0x01020201, 0x01030101, 0x01030301
    .word 0x03020101, 0x02020201, 0x01020101, 0x03030301, 0x02020101, 0x01020201, 0x01030101, 0x01030301
    .word 0x01020101, 0x01020201, 0x01020101, 0x03030301, 0x02020101, 0x01020201, 0x01030101, 0x01030301
    .word 0x01020101, 0x01020201, 0x01020101, 0x03030301, 0x02020101, 0x01020201, 0x01030101, 0x01030301
    .word 0x01020101, 0x02020201, 0x01010101, 0x03030301, 0x02020101, 0x02020201, 0x01030101, 0x01030101
    .word 0x02020201, 0x02020201, 0x01020101, 0x03030301, 0x02020101, 0x02020201, 0x01030101, 0x03030301
    .word 0x02020101, 0x02020201, 0x01020101, 0x03030301, 0x02020101, 0x01020201, 0x01030101, 0x01030301
    .word 0x02020101, 0x02020201, 0x01020101, 0x03030301, 0x02020101, 0x01020201, 0x01030101, 0x01030301
  EndASM
EndProcedure
