; Advance within the visible 256 dots. An eight-dot fetch begins exactly when
; its first dot is consumed, including when the CPU splits a span with MMIO.
ProcedureNaked NesRenderToRef(endDot.i)
  ASM
    addiu sp, sp, -32
    sd ra, 24(sp)
    sd s0, 16(sp)
    sd s1, 8(sp)
    sd s2, 0(sp)
    or s0, a0, zero
    la s1, global_ppudot
    ld s2, 0(s1)
    addiu s2, s2, 7
    srl s2, s2, 3
    sll s2, s2, 3
    sltu t0, s2, s0
    beq t0, zero, nes_render_to_done
    nop
nes_render_to_span:
    jal ppurender8reference
    sd s2, 0(s1)
    addiu s2, s2, 8
    sltu t0, s2, s0
    bne t0, zero, nes_render_to_span
    nop
nes_render_to_done:
    sd s0, 0(s1)
    ld s2, 0(sp)
    ld s1, 8(sp)
    ld s0, 16(sp)
    ld ra, 24(sp)
    jr ra
    addiu sp, sp, 32
  EndASM
EndProcedure

CompilerIf #NES_BG_EXPANDED Or #NES_MMC1_ROWS
  XIncludeFile "tiles.n64"
CompilerElse
CompilerIf #GAME_MAPPER=5 Or #GAME_MAPPER=9
ProcedureNaked NesRenderTo(endDot.i)
  ASM
    j nesrendertoref
    nop
  EndASM
EndProcedure
CompilerElse
ProcedureNaked NesRenderTo(endDot.i)
  ; No guest event runs during this interval. Keep the scroll address and
  ; pattern-row base in registers and write back the final dot and address.
  ASM
    la t0, global_ppudot
    ld t1, 0(t0)
    addiu t1, t1, 7
    andi t1, t1, 0xFFF8
    sltu t2, t1, a0
    beq t2, zero, nes_batch_empty
    addiu t2, t1, 8
    sltu t2, t2, a0
    beq t2, zero, nes_batch_one
    nop
    la t2, global_ppumask
    ld t2, 0(t2)
    andi t3, t2, 8
    beq t3, zero, nes_batch_ref
    nop

    addiu sp, sp, -80
    sd ra, 72(sp)
    sd s0, 64(sp)
    sd s1, 56(sp)
    sd s2, 48(sp)
    sd s3, 40(sp)
    sd s4, 32(sp)
    sd s5, 24(sp)
    sd s6, 16(sp)
    sd s7, 8(sp)
    or s0, a0, zero
    or s2, t1, zero
    sd s2, 0(sp)
    or s4, t2, zero
    la s1, global_neslinerow
    lw s1, 4(s1)
    la s6, global_nt
    la s7, NesBgPixelSpread
    la t0, global_ppuv
    ld s3, 0(t0)
    la t0, global_ppuctrl
    ld t0, 0(t0)
    andi t0, t0, 16
    sll t0, t0, 8
    srl t1, s3, 11
    andi t1, t1, 14
    or t0, t0, t1
  EndASM
  CompilerIf #NES_UNIT
    ASM
      or s5, t0, zero
    EndASM
  CompilerElse
    ASM
      la t1, global_pattern
      lw t1, 4(t1)
      daddu s5, t1, t0
    EndASM
  CompilerEndIf
  ASM
    or a4, s5, zero
    or t9, s7, zero
  EndASM
  CompilerIf #NES_UNIT
    ASM
      addiu a7, s6, -0x4000
      addiu s6, zero, -1
    EndASM
  CompilerElse
    ASM
      or a7, s6, zero
    EndASM
  CompilerEndIf
  ASM
    la t0, global_ppupixels
    ld t1, 0(t0)
    addiu t2, s0, 7
    andi t2, t2, 0xFFF8
    subu t2, t2, s2
    daddu t1, t1, t2
    sd t1, 0(t0)
  EndASM
  CompilerIf #NES_UNIT
    ASM
      subu t0, s0, s2
      sltiu t0, t0, 25
      bnez t0, nes_batch_prime
      nop
      j nesmmc3rendersegments
      nop
nes_batch_prime:
    EndASM
  CompilerEndIf
  ASM
    ; Prime a lookahead tile only when the scroll crosses tile boundaries.
    la t0, global_ppufinex
    ld t1, 0(t0)
    beq t1, zero, nes_batch_span
    sll t1, t1, 11
    or s4, s4, t1
  EndASM
  CompilerIf #NES_UNIT
    ASM
      jal nesmmc3batchtile
      or t0, s3, zero
    EndASM
  CompilerElse
    ASM
      jal nespackedbgtile
      or t0, s3, zero
    EndASM
  CompilerEndIf
  ASM
    or a6, a5, zero
nes_batch_span:
    andi t1, s3, 31
    addiu t2, zero, 31
    addiu a0, s3, 1
    bne t1, t2, nes_batch_step
    or t0, s3, zero
    andi a0, s3, 0x7FE0
    xori a0, a0, 0x400
nes_batch_step:
    srl a3, s4, 8
    beq a3, zero, nes_batch_fetch
    or s3, a0, zero
    or t0, s3, zero
nes_batch_fetch:
  EndASM
  CompilerIf #NES_UNIT
    ASM
      jal nesmmc3batchtile
      nop
    EndASM
  CompilerElse
    ASM
      jal nespackedbgtile
      nop
    EndASM
  CompilerEndIf
  ASM
    beq a3, zero, nes_batch_store
    subu t0, zero, a3
    dsllv a1, a6, a3
    dsrlv a2, a5, t0
    or a6, a5, zero
    or a5, a1, a2
nes_batch_store:
    bne s2, zero, nes_batch_bg_ready
    andi t0, s4, 2
    bne t0, zero, nes_batch_bg_ready
    nop
    or a5, zero, zero
nes_batch_bg_ready:
    daddu t0, s1, s2
  EndASM
  CompilerIf #NES_UNIT
    ASM
      ; A span at the first half of a cache line can allocate that line
      ; without fetching pixels from the previous frame if both spans draw.
      andi t1, s2, 8
      bnez t1, nes_batch_store_pixels
      addiu t2, s2, 8
      sltu t1, t2, s0
      beqz t1, nes_batch_store_pixels
      nop
      cache 0x0d, 0(t0)
nes_batch_store_pixels:
    EndASM
  CompilerEndIf
  ASM
    sd a5, 0(t0)
    addiu s2, s2, 8
    sltu t0, s2, s0
    bne t0, zero, nes_batch_span
    nop
nes_batch_background_done:
    la t0, global_ppuv
    sd s3, 0(t0)

    ; Background generation and sprite compositing have no guest-visible
    ; observer between them. Visit covered spans in their original order.
    la s5, global_spritespan
    ld t0, 0(s5)
    ld t1, 8(s5)
    ld t2, 16(s5)
    ld t3, 24(s5)
    or t0, t0, t1
    or t2, t2, t3
    or t0, t0, t2
    beq t0, zero, nes_batch_done
    ld s2, 0(sp)
    la s3, global_woff
nes_batch_overlay:
    srl t0, s2, 3
    andi t1, s2, 63
    bne t1, zero, nes_batch_overlay_span
    addu t0, s5, t0
    ld t1, 0(t0)
    beq t1, zero, nes_batch_overlay_step
    addiu t2, zero, 64
nes_batch_overlay_span:
    lbu t1, 0(t0)
    beq t1, zero, nes_batch_overlay_step
    addiu t2, zero, 8
    or a0, s2, zero
    addu a1, s1, s2
    jal nes_overlay_at
    sd s2, 0(s3)
    addiu t2, zero, 8
nes_batch_overlay_step:
    addu s2, s2, t2
    sltu t0, s2, s0
    bne t0, zero, nes_batch_overlay
    nop
nes_batch_done:
    la t0, global_ppudot
    sd s0, 0(t0)
    ld s7, 8(sp)
    ld s6, 16(sp)
    ld s5, 24(sp)
    ld s4, 32(sp)
    ld s3, 40(sp)
    ld s2, 48(sp)
    ld s1, 56(sp)
    ld s0, 64(sp)
    ld ra, 72(sp)
    jr ra
    addiu sp, sp, 80
nes_batch_empty:
    jr ra
    sd a0, 0(t0)
nes_batch_one:
    addiu sp, sp, -16
    sd ra, 8(sp)
    sd a0, 0(sp)
    jal ppurender8reference
    sd t1, 0(t0)
    ld a0, 0(sp)
    ld ra, 8(sp)
    la t0, global_ppudot
    sd a0, 0(t0)
    jr ra
    addiu sp, sp, 16
nes_batch_ref:
    j nesblankrenderto
    nop

  EndASM
EndProcedure
CompilerEndIf
CompilerEndIf

CompilerIf #NES_UNIT
ProcedureNaked NesMmc3RenderSegments()
  ASM
    addiu sp, sp, -16
    sd fp, 8(sp)
    la fp, nesmmc3batchtile
    ; Fine X uses one tile of lookahead across segment boundaries. s3
    ; advances as the fetch cursor and is corrected to the output cursor
    ; once all requested spans are consumed.
    la t0, global_ppufinex
    lw a3, 4(t0)
    sll a3, a3, 3
    beqz a3, nes_segment_limit
    subu a1, zero, a3
    jalr ra, fp
    or t0, s3, zero
    or a6, a5, zero
    addiu s3, s3, 1
    andi t0, s3, 31
    bnez t0, nes_segment_limit
    nop
    addiu s3, s3, -32
    xori s3, s3, 0x400
nes_segment_limit:
    andi t0, s3, 31
    addiu t1, zero, 32
    subu t0, t1, t0
    sll t0, t0, 3
    addu t0, s2, t0
    sltu t1, t0, s0
    beqz t1, nes_segment_limit_ready
    or s7, s0, zero
    or s7, t0, zero
nes_segment_limit_ready:
    ; Convert the fetch endpoint to the last complete 16-byte block.
    addiu t0, s7, 7
    andi a2, t0, 0xfff0
nes_segment_dispatch:
    sltu t0, s2, s7
    beqz t0, nes_segment_edge
    andi t0, s2, 8
    bnez t0, nes_segment_single
    sltu t1, s2, a2
    beqz t1, nes_segment_single
    andi t0, s4, 2
    bnez s2, nes_segment_pairs
    nop
    beqz t0, nes_segment_single
    nop
nes_segment_pairs:
    bnez a3, nes_segment_pairs_fine
    nop
nes_segment_pairs_aligned:
    addu a0, s1, s2
    jalr ra, fp
    or t0, s3, zero
    cache 0x0d, 0(a0)
    sd a5, 0(a0)
    addiu s3, s3, 1
    jalr ra, fp
    or t0, s3, zero
    sd a5, 8(a0)
    addiu s2, s2, 16
    sltu t0, s2, a2
    bnez t0, nes_segment_pairs_aligned
    addiu s3, s3, 1
    b nes_segment_dispatch
    nop
nes_segment_pairs_fine:
    addu a0, s1, s2
    jalr ra, fp
    or t0, s3, zero
    dsllv t0, a6, a3
    dsrlv t1, a5, a1
    or t0, t0, t1
    or a6, a5, zero
    cache 0x0d, 0(a0)
    sd t0, 0(a0)
    addiu s3, s3, 1
    jalr ra, fp
    or t0, s3, zero
    dsllv t0, a6, a3
    dsrlv t1, a5, a1
    or t0, t0, t1
    or a6, a5, zero
    sd t0, 8(a0)
    addiu s2, s2, 16
    sltu t0, s2, a2
    bnez t0, nes_segment_pairs_fine
    addiu s3, s3, 1
    b nes_segment_dispatch
    nop
nes_segment_single:
    jalr ra, fp
    or t0, s3, zero
    beqz a3, nes_segment_single_clip
    addiu s3, s3, 1
    dsllv t0, a6, a3
    dsrlv t1, a5, a1
    or a6, a5, zero
    or a5, t0, t1
nes_segment_single_clip:
    bnez s2, nes_segment_single_store
    andi t0, s4, 2
    bnez t0, nes_segment_single_store
    nop
    or a5, zero, zero
nes_segment_single_store:
    addu t0, s1, s2
    sd a5, 0(t0)
    b nes_segment_dispatch
    addiu s2, s2, 8
nes_segment_edge:
    andi t0, s3, 31
    bnez t0, nes_segment_edge_done
    nop
    ; Carry out of coarse X wraps to column zero in the horizontal neighbor.
    addiu s3, s3, -32
    xori s3, s3, 0x400
nes_segment_edge_done:
    sltu t0, s2, s0
    bnez t0, nes_segment_limit
    nop
    beqz a3, nes_segment_writeback
    andi t0, s3, 31
    bnez t0, nes_segment_unprime
    nop
    xori s3, s3, 0x400
    b nes_segment_writeback
    ori s3, s3, 31
nes_segment_unprime:
    addiu s3, s3, -1
nes_segment_writeback:
    ld fp, 8(sp)
    j nes_batch_background_done
    addiu sp, sp, 16
  EndASM
EndProcedure
CompilerEndIf
