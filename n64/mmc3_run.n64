; Keep the run-window scheduler in VR4300 code. Display, input, and
; persistence run at the same guest frame handoff as the shared path.
CompilerIf #NES_CPU_ASM
; The loop lives in cpu6502.n64, beside the CPU core it calls every window, so the two
; cannot share instruction-cache sets.
ProcedureNaked.i NesRunMapper4(start.i)
  ASM
    j c65_run_mapper4
    nop
  EndASM
EndProcedure
CompilerElse
; The reference (compiled 6502) build: the hot unit's other parts live in this holder, which is
; never called; their u_ entry labels are reached from the stubs and from each other.
ProcedureNaked NesHotHolder()
  XIncludeFile "../n64/unit/window.n64"
  XIncludeFile "../n64/unit/advance.n64"
  XIncludeFile "../n64/unit/write.n64"
  XIncludeFile "../n64/unit/ppu.n64"
  XIncludeFile "../n64/unit/ppu_cold.n64"
  XIncludeFile "../n64/unit/ppu_check.n64"
  XIncludeFile "../n64/unit/apu.n64"
  XIncludeFile "../n64/unit/slot.n64"
  XIncludeFile "../n64/unit/apu_cold.n64"
  XIncludeFile "../n64/unit/cold.n64"
  XIncludeFile "../n64/unit/cold_slot.n64"
EndProcedure
ProcedureNaked.i NesRunMapper4(start.i)
  ASM
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    move s1, a0
    la s0, global_cpucycles
nes_mmc3_run_window:
    ld t0, global_stopped-global_cpucycles(s0)
    ld t1, global_workererror-global_cpucycles(s0)
    or t0, t0, t1
    bnez t0, nes_mmc3_run_stop
    nop
    jal u_mappercpubudget
    nop
    jal u_nmicap             ; the window ends where the NMI is due (unit/window.n64, design note N.77)
    nop
    jal u_nesramcpuwindow
    move a1, zero

    ld a0, 0(s0)
    ld t0, global_nesstatushorizon-global_cpucycles(s0)
    slt t0, t0, a0
    beqz t0, nes_mmc3_run_stalls
    ld t0, global_nescpuhorizon-global_cpucycles(s0)
    slt t0, t0, a0
    beqz t0, nes_mmc3_run_stalls
    nop
    jal u_nesmmc3advancecputime
    nop
nes_mmc3_run_stalls:
    ld t0, global_workerdmccycles-global_cpucycles(s0)
    ld t1, global_nesseendmc-global_cpucycles(s0)
    dsubu t1, t0, t1
    blez t1, nes_mmc3_run_interrupts
    ld a0, 0(s0)
    sd t0, global_nesseendmc-global_cpucycles(s0)
    daddu a0, a0, t1
    jal u_nesmmc3advancecputime
    sd a0, 0(s0)
    b nes_mmc3_run_stalls
    nop
nes_mmc3_run_interrupts:
    ld t0, global_workernmi-global_cpucycles(s0)
    ld t1, global_nesseennmi-global_cpucycles(s0)
    beq t0, t1, nes_mmc3_run_irq
    ori a0, zero, 0xFFFA
    ld t2, 0(s0)             ; an NMI edge counted: taken at the first boundary >= NesNmiDue (R5, design note N.77)
    la t3, global_nesnmidue
    ld t1, 0(t3)
    slt t1, t2, t1
    bnez t1, nes_mmc3_run_irq ; not yet: the window to it (u_nmicap) runs first
    daddiu t1, zero, -1
    dsrl t1, t1, 1
    sd t1, 0(t3)             ; taken: none due until the next frame's prediction
    sd t1, global_nesnmicapat-global_cpucycles(s0)   ; (the cap's quick test: never near)
    sd t0, global_nesseennmi-global_cpucycles(s0)
    b nes_mmc3_run_interrupt
    nop
nes_mmc3_run_irq:
    ld t0, global_workerirq-global_cpucycles(s0)
    ld t1, global_mapirq-global_cpucycles(s0)
    or t0, t0, t1
    beqz t0, nes_mmc3_run_frames
    ld t0, global_fi-global_cpucycles(s0)
    bnez t0, nes_mmc3_run_frames
    ori a0, zero, 0xFFFE
nes_mmc3_run_interrupt:
    jal cpuinterrupt
    nop
nes_mmc3_run_frames:
    ld a0, global_workerframes-global_cpucycles(s0)
    ld t0, global_nesdeliveredframe-global_cpucycles(s0)
    beq a0, t0, nes_mmc3_run_window
    nop
    jal neshostguestframe
    move a1, s1
    beqz a0, nes_mmc3_run_window
    nop
    b nes_mmc3_run_exit
    nop
nes_mmc3_run_stop:
    move a0, zero
nes_mmc3_run_exit:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    jr ra
    daddiu sp, sp, 32
  EndASM
EndProcedure
CompilerEndIf
