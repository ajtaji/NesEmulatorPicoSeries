; Compute the raster limit in the calling CPU scheduler.
  If PpuLine<241
    dots=(241-PpuLine)*341-PpuDot+1
  ElseIf PpuLine=241 And PpuDot=0
    ProcedureReturn
  Else
    ; A rendered odd NTSC prerender line may be one dot shorter.
    dots=(PpuPreLine+1-PpuLine)*341-PpuDot-1
  EndIf
  ; Match the host service interval on visible lines. IRQ, reset and
  ; frame deadlines still shorten the window, and MMIO closes it early.
  CompilerIf #NES_CHAIN_WINDOWS And #NES_AUDIO_RATE=20000
    If PpuLine<240
      event=(64-((PpuLine+32)&63))*341-PpuDot
      If event<dots : dots=event : EndIf
    EndIf
  CompilerElse
    If dots>2728 : dots=2728 : EndIf
  CompilerEndIf
  CompilerIf #GAME_PAL
    cycles=(dots-1)>>2
  CompilerElse
    cycles=(dots-1)/3
  CompilerEndIf
