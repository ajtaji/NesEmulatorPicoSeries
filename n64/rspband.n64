; rspband.n64 - THE CPU SIDE OF THE RSP BAND EMITTER (step N4.3; design note, section N.18).
;
; THE WRITE-BACK AT A BAND'S CLOSE. The RSP reads RDRAM by its own DMA and never the CPU's D-cache (F-MEM-04), and
; the name and attribute tables (Nt, 4 KB), the band record and the band's OAM snapshot are written through the
; cache. So at every band's close, before the band's job is queued, the cold part writes back (Hit_Writeback_D,
; op $19) every line of Nt, the record's 6 lines and the snapshot's 16 lines: 278 cache operations. A line not in
; the cache or not dirty is left as it is; a dirty one is written to RDRAM and stays valid, so the guest's next
; access to it still hits. Nt is written back whole rather than the band's rows: the rows a band reads follow from
; its v walk, which the CPU does not do (the RSP does), and computing them here would cost more than the 256
; operations (measured: section N.18).
; IN: t2 = the record (the band cut's register, unit/ppu_cold.n64, ppu_cut_close). CLOBBERS t3, t8, t9, v1 only;
; keeps t2 and every register the cut's callers hold.
; #NES_WB_MEASURE (the measuring build): the Count register before and after, summed in NesWbStat: [0] all ticks,
; [1] bands, [2] the largest, [3] the Nt part's ticks. A Count tick is 2 CPU cycles.
; the split lines' segment entries (below, design note N.60)
#NES_SEG_BYTES = 96
CompilerIf #NES_RDP_SHOW
  #NES_SEG_POOL = 42                    ; the show's: a 4 KB gap between two band-input slots (show.n64)
CompilerElse
  #NES_SEG_POOL = 64                    ; the checking builds' (6 KB; ppu_cold.n64's line 0 says 6144)
CompilerEndIf

CompilerIf #NES_WB_MEASURE Or #NES_RSP_CHECK

CompilerIf #NES_WB_MEASURE
  Global Dim NesWbStat.i(4)
CompilerEndIf

ProcedureNaked NesBandWriteback()
  CompilerIf #NES_WB_MEASURE
    ASM
      mfc0 v1, $9                    ; Count at the start
      nop
    EndASM
  CompilerEndIf
  ASM
    la t3, global_nt
    daddiu t8, t3, 4096              ; the end (exclusive)
    daddiu t9, zero, -16
    and t3, t3, t9                   ; the first line (Nt need not start on one)
nes_bwb_nt:
    cache 0x19, 0(t3)                ; Hit_Writeback_D: Nt, line by line
    daddiu t3, t3, 16
    sltu t9, t3, t8
    bne t9, zero, nes_bwb_nt
    nop
  EndASM
  CompilerIf #NES_WB_MEASURE
    ASM
      mfc0 t9, $9                    ; Count after Nt
      nop
      subu t9, t9, v1
      la t3, global_neswbstat
      ld t8, 24(t3)
      daddu t8, t8, t9
      sd t8, 24(t3)
    EndASM
  CompilerEndIf
  ASM
    cache 0x19, 0(t2)                ; the record's 96 bytes
    cache 0x19, 16(t2)
    cache 0x19, 32(t2)
    cache 0x19, 48(t2)
    cache 0x19, 64(t2)
    cache 0x19, 80(t2)
    ld t3, #NES_B_OAM(t2)            ; the band's OAM snapshot: NesOamBase + index x 256
    dsll t3, t3, 8
    la t8, global_nesoambase
    ld t8, 0(t8)
    daddu t3, t3, t8
    daddiu t8, t3, 256
nes_bwb_oam:
    cache 0x19, 0(t3)
    daddiu t3, t3, 16
    bne t3, t8, nes_bwb_oam
    nop
  EndASM
  CompilerIf #NES_WB_MEASURE
    ASM
      mfc0 t9, $9                    ; Count at the end
      nop
      subu t9, t9, v1                ; this band's ticks
      la t3, global_neswbstat
      ld t8, 0(t3)
      daddu t8, t8, t9
      sd t8, 0(t3)
      ld t8, 8(t3)
      daddiu t8, t8, 1
      sd t8, 8(t3)
      ld t8, 16(t3)
      sltu v1, t8, t9
      beq v1, zero, nes_bwb_end
      nop
      sd t9, 16(t3)
nes_bwb_end:
    EndASM
  CompilerEndIf
  ASM
    jr ra
    nop
  EndASM
EndProcedure

CompilerIf #NES_RSP_CHECK
; ---- THE CHECKING BUILD (--rsp-check, with the twin): the RSP program (rspband.n64rsp) on the same bands ----
; At every band record the cut writes back the band's inputs (above) and NesRspBandCall queues the band's job; at
; line 240 NesRspFrame waits for the queue and compares the frame's every command word and every band's TLUT block
; with the twin's; the first difference stops the run (NesRspHalt, read at the frame's end in nes.n64) with the
; band's record printed. The twin's second picture (NesTwinFrame) is then drawn from the RSP's words.
XIncludeFile "rspband_ids.pmi"
ASM
  .rspfile "rspband.n64rsp"
EndASM
; WHERE: the 64 KB between the cartridge arena's end and the library's crash display (#NES_CART_LOW_END,
; storage.n64; the library's map: "$80200000 - $803BFFFF free for your fixed buffers"): the frame command area
; (4,096 doublewords + 16 bytes of status) at +0, the RSP's TLUT blocks (32 x 256) at +$8100, the program's copy
; (its file + 128 bytes, at most 20 KB) at +$B000. The RAM below the stack has no room for them beside the twin.
#NES_RSP_AREA = #NES_CART_LOW_END
#NES_RSP_TLUT_AT = $8100
#NES_RSP_PROG_AT = $B000
Global NesRspProg.i, NesRspTlut.i, NesRspFirst.s          ; (NesRspOut: twin.n64)
Global Dim NesRspStat.i(8)                          ; frames, words, TLUT blocks compared, differences, RSP clocks, bands

Procedure NesRspInit()
  Protected space.i, need.i
  NesTwinBases()
  If (@Nt(0) & 7) Or (@Rgb64(0) & 7) Or (NesChrMaskBase & 7)
    LpmDebugPrint("NES RSP CHECK REFUSED: an input not 8-byte aligned for the RSP's DMA") : NesRspHalt = 1 : ProcedureReturn
  EndIf
  need = LpmCartFileLen(1) + 128
  space = #NES_RSP_AREA + #NES_RSP_PROG_AT
  If need > $10000 - #NES_RSP_PROG_AT
    LpmDebugPrint("NES RSP CHECK REFUSED: the program's file is " + Str(need - 128) + " bytes") : NesRspHalt = 1 : ProcedureReturn
  EndIf
  NesRspOut = (#NES_RSP_AREA & $1FFFFFFF) | $A0000000
  NesRspTlut = ((#NES_RSP_AREA + #NES_RSP_TLUT_AT) & $1FFFFFFF) | $A0000000
  LpmCacheWritebackInvalidateData(#NES_RSP_AREA, #NES_RSP_PROG_AT)   ; no stale line of it may land later
  LpmCacheWritebackData(@Rgb64(0), 1024)
  NesRspProg = LpmRspqProgram(LpmCartFile(1), space)
  If NesRspProg = 0
    LpmDebugPrint("NES RSP CHECK REFUSED: LpmRspqProgram") : NesRspHalt = 1 : ProcedureReturn
  EndIf
  LpmRspqCmd7(NesRspProg, #NES_RSP_SETUP, @Nt(0) & $1FFFFFFF, NesChrMaskBase & $1FFFFFFF, @Rgb64(0) & $1FFFFFFF, NesChrPairBase & $1FFFFFFF, NesTwinTlut & $1FFFFFFF, NesRspTlut & $1FFFFFFF, NesRspOut & $1FFFFFFF)
  LpmRspqSync()
  LpmDebugPrint("NES RSP PROGRAM " + Str(need - 128) + " bytes, on")
EndProcedure

Procedure NesRspBand(rec.i)
  Protected idx.i, oam.i
  If NesRspProg = 0 : ProcedureReturn : EndIf
  idx = (rec - NesBandBase) / #NES_BAND_BYTES
  oam = NesOamBase + PeekI(rec + #NES_B_OAM) * 256
  LpmRspqCmd(NesRspProg, #NES_RSP_BAND, rec & $1FFFFFFF, oam & $1FFFFFFF, idx)
  LpmRspqFlush()
EndProcedure

; The cold part's way in (unit/ppu_cold.n64, ppu_cut_close), after the write-back: t2 = the record. Keeps every
; register the cut's callers may hold, as NesTwinBandCall does.
ProcedureNaked NesRspBandCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nesrspband
    move a0, t2
    ld t0, 136(sp)
    mthi t0
    ld t0, 144(sp)
    mtlo t0
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld a3, 32(sp)
    ld a4, 40(sp)
    ld a5, 48(sp)
    ld a6, 56(sp)
    ld a7, 64(sp)
    ld t0, 72(sp)
    ld t1, 80(sp)
    ld t2, 88(sp)
    ld t3, 96(sp)
    ld t8, 104(sp)
    ld t9, 112(sp)
    ld v0, 120(sp)
    ld v1, 128(sp)
    jr ra
    daddiu sp, sp, 176
  EndASM
EndProcedure

Procedure NesRspStop(f.i, i.i, b.i, what.s)
  Protected k.i, s.s
  NesRspStat(3) + 1
  If NesRspFirst = ""
    NesRspFirst = "frame " + Str(f) + " " + what
    s = "NES RSP RECORD band " + Str(b)
    If b >= 0 And b < #NES_U_BANDMAX
      For k = 0 To 11 : s = s + " " + Hex(PeekQ(NesBandBase + b * #NES_BAND_BYTES + k * 8)) : Next
    EndIf
    LpmDebugPrint("NES RSP FIRST DIFFERENCE " + NesRspFirst)
    LpmDebugPrint(s)
  EndIf
  NesRspHalt = 1
EndProcedure

; At line 240, before the twin's picture: every word and every TLUT block of the frame, RSP against twin.
Procedure NesRspFrame()
  Protected n.i, i.i, b.i, k.i, w.i, x.i, bands.i, st.i, f.i
  If NesRspProg = 0 Or NesRspHalt : ProcedureReturn : EndIf
  bands = PeekI(NesUnitBase + #NES_U_BANDCOUNT)
  If bands = 0 : ProcedureReturn : EndIf
  f = WorkerFrames
  LpmRspqSync()
  st = NesRspOut + #NES_RSP_WORDS * 8
  n = PeekL(st) & $FFFFFFFF
  If PeekL(st + 12) <> bands : NesRspStop(f, 0, bands - 1, "bands done " + Str(PeekL(st + 12)) + " of " + Str(bands)) : ProcedureReturn : EndIf
  If n > #NES_RSP_WORDS : n = #NES_RSP_WORDS : EndIf
  For i = 0 To n - 1
    If i < NesTwinN
      w = PeekQ(NesRspOut + i * 8)
      x = NesTwinCmd(i)
      If w <> x
        ; the band that wrote word i: the record whose words began at or before it is not known here; the frame's
        ; records are all printed by number - the first band whose TLUT image is named before word i
        b = 0
        For k = 0 To i
          If ((NesTwinCmd(k) >> 56) & $3F) = $3D And (NesTwinCmd(k) & $FFFFFFFF) >= (NesTwinTlut & $1FFFFFFF) And (NesTwinCmd(k) & $FFFFFFFF) < (NesTwinTlut & $1FFFFFFF) + #NES_U_BANDMAX * 256 And ((NesTwinCmd(k) >> 32) & $FFF) = 127
            b = ((NesTwinCmd(k) & $FFFFFFFF) - (NesTwinTlut & $1FFFFFFF)) / 256
          EndIf
        Next
        NesRspStop(f, i, b, "word " + Str(i) + " of " + Str(NesTwinN) + ": twin $" + Hex((x >> 32) & $FFFFFFFF) + " " + Hex(x & $FFFFFFFF) + " RSP $" + Hex((w >> 32) & $FFFFFFFF) + " " + Hex(w & $FFFFFFFF))
        ProcedureReturn
      EndIf
    EndIf
  Next
  If PeekL(st + 4) Or NesTwinOver
    w = PeekQ(NesRspOut + NesTwinN * 8) : x = PeekQ(NesRspOut + NesTwinN * 8 + 8)
    NesRspStop(f, 0, -1, "words that did not fit: RSP " + Str(PeekL(st + 4)) + " twin " + Str(NesTwinOver) + "; twin's words " + Str(NesTwinN) + ", the RSP's next $" + Hex((w >> 32) & $FFFFFFFF) + " " + Hex(w & $FFFFFFFF) + " $" + Hex((x >> 32) & $FFFFFFFF) + " " + Hex(x & $FFFFFFFF))
    ProcedureReturn
  EndIf
  If n <> NesTwinN : NesRspStop(f, n, bands - 1, "words: twin " + Str(NesTwinN) + " RSP " + Str(n)) : ProcedureReturn : EndIf
  For b = 0 To bands - 1
    For k = 0 To 255 Step 8
      If PeekQ(NesRspTlut + b * 256 + k) <> PeekQ(NesTwinTlut + b * 256 + k)
        NesRspStop(f, 0, b, "TLUT block of band " + Str(b) + " byte " + Str(k)) : ProcedureReturn
      EndIf
    Next
  Next
  NesRspStat(0) + 1 : NesRspStat(1) + n : NesRspStat(2) + bands : NesRspStat(4) + (PeekL(st + 8) & $FFFFFFFF)
  If (PeekL(st + 8) & $FFFFFFFF) > NesRspStat(5) : NesRspStat(5) = PeekL(st + 8) & $FFFFFFFF : EndIf
EndProcedure

Procedure NesRspReport()
  LpmDebugPrint("NES RSP FRAMES " + Str(NesRspStat(0)) + " WORDS " + Str(NesRspStat(1)) + " TLUT BLOCKS " + Str(NesRspStat(2)) + " DIFFERENCES " + Str(NesRspStat(3)) + " RSP CLOCKS " + Str(NesRspStat(4)) + " MAX A FRAME " + Str(NesRspStat(5)))
  LpmDebugPrint("NES RSP FIRST DIFFERENCE " + NesRspFirst)
EndProcedure
CompilerEndIf

CompilerIf #NES_WB_MEASURE
Procedure NesWbReport()
  LpmDebugPrint("NES WB TICKS " + Str(NesWbStat(0)) + " BANDS " + Str(NesWbStat(1)) + " MAX " + Str(NesWbStat(2)) + " NT " + Str(NesWbStat(3)))
EndProcedure
CompilerEndIf

CompilerEndIf

; ======================================================================
; SPLIT LINES AS BAND RECORDS WITH SEGMENTS (design note, section N.60, item 1). The shipped build (#NES_RDP_SHOW) and
; the checking builds that run the twin (#NES_TWIN_CHECK). A SPLIT LINE is one on which a picture input changes at dots
; 1-255. The old renderer draws its background in 8-dot spans, each with the inputs in force when its first dot is
; reached, so the line is a run of SEGMENTS of spans, each drawn under one state; its sprites are those of dot 0 and
; its colours those of dot 256. Here the state machine's own moments write that down for the RSP (rspband.n64rsp,
; NesRspBandS) and the twin (twin.n64), instead of the old renderer drawing the line:
;   NesSegFirst    at the line's first cut (unit/ppu_cold.n64, ppu_cut_split), before the write is applied: segment 0
;                  (spans 0 .. ceil(dot / 8), v at dot 0, the state now) and the sprite state of dot 0 kept - when a
;                  record (the frame's 32) and 32 entries of the segment pool are free; else the old path (counted).
;   (every later cut on the line closes the open segment: ppu_cut_split)
;   NesSegDraw     at every draw on the line (unit/ppu.n64, ppu_adv_draw): the spans consumed; the first draw after a
;                  cut opens a segment - v, fine X, PPUCTRL, PPUMASK, the 8 CHR bank numbers and the 80 name-table bytes
;                  its tiles can read (the strip's DMA layout of rspband.n64rsp: the rows of the tables with bit 10 = 0
;                  and 1 at v's coarse Y and bit 11, then their attribute rows) - copied from Nt now.
;   NesSegPublish  at dot 256 (ppu_adv_publish): the line's record (the band log's: first L, end L + 1, segment 0's
;                  PPUCTRL / fine X / banks / OAM snapshot, PPUMASK bits 0, 5-7 now with bits 1, 2, 4 of segment 0 and
;                  bit 3 when a segment draws, the palette now; +56 the segment count, +60 the first entry's physical
;                  address) and its job as a band's.
; A SEGMENT ENTRY, 96 bytes, written UNCACHED (the RSP DMAs it; no cache line taken, nothing to write back):
;   +0 the row of the table with bit 10 = 0 (32 bytes)   +32 bit 10 = 1   +64 / +72 their attribute rows (8 each)
;   +80 k0  +81 k1 (spans [k0, k1))  +82 fine X  +83 PPUCTRL  +84 PPUMASK  +85 0  +86 v (16 bits)  +88 the 8 bank numbers
; A segment with PPUMASK bit 3 clear draws no tile and stores nothing. THE POOL: a frame set's (the show's two
; sets by NesShowCur: 42 entries each, in the gaps between the band-input slots; the checking builds one set of 64,
; NesSegCheckSpace, which they wait on at every line 240). A line has at most 32 segments that store (one span each at least), so 32 free
; entries at the first cut make the line's segments certain.
; ======================================================================
CompilerIf #NES_TWIN_CHECK Or #NES_RDP_SHOW
Global NesSegOn.i                       ; 1 while the current line is a split line drawn by a record
Global NesSegOpen.i                     ; 0 no segment open, 1 one open (NesSegCur), 2 one open that draws nothing
Global NesSegCur.i, NesSegNext.i, NesSegEnd.i, NesSegFirstE.i, NesSegCount.i   ; KSEG1 entries
Global NesSeg0St.i, NesSeg0Banks.i, NesSeg0Oam.i, NesSeg0V.i   ; segment 0's sprite state; v at dot 0
Global Dim NesSegBaseP.i(2)             ; each frame set's pool (KSEG1)
Global Dim NesSegStat.i(8)              ; [0] split lines by record [1] segments stored [2] split lines on the old path
                                        ; [3] most segments in a line [4] of [2]: no record free
CompilerIf #NES_RDP_SHOW
  Declare NesShowBand(rec.i)
CompilerElse
  Global Dim NesSegCheckSpace.a(#NES_SEG_POOL*#NES_SEG_BYTES+16)   ; the checking builds' one pool
CompilerEndIf

Procedure NesSegInit(nt.i)               ; nt: the show's band-input slots (NesShowNtBase; 0 in the checking builds)
  CompilerIf #NES_RDP_SHOW
    ; THE SHOW'S POOLS: the 4 KB gaps after band-input slots 0 and 1 (NesShowNtSpace keeps its slots 8 KB apart, on
    ; Nt's D-cache sets; the gaps are written here only uncached, so no cache line of them is ever taken). NesShowInit
    ; has invalidated the whole space.
    NesSegBaseP(0) = ((nt + 4096) & $1FFFFFFF) | $A0000000
    NesSegBaseP(1) = ((nt + 4096 + 8192) & $1FFFFFFF) | $A0000000
  CompilerElse
    Protected a.i = (@NesSegCheckSpace(0) + 15) & ~15
    LpmCacheWritebackInvalidateData(a, #NES_SEG_POOL * #NES_SEG_BYTES)   ; no stale line may land on it later
    NesSegBaseP(0) = (a & $1FFFFFFF) | $A0000000
    NesSegBaseP(1) = NesSegBaseP(0)
  CompilerEndIf
  NesSegFrame(0)
EndProcedure

Procedure NesSegFrame(p.i)              ; a frame starts on set p's pool (show: NesShowSet; the checking builds: line 0)
  NesSegNext = NesSegBaseP(p) : NesSegEnd = NesSegBaseP(p) + #NES_SEG_POOL * #NES_SEG_BYTES
  NesSegOn = 0 : NesSegOpen = 0
EndProcedure

; nes_seg_store - a segment opens: a0 = k0, a1 = k1, a2 = v (the state: PpuFineX, PpuCtrl, PpuMask, MapChrSlots, Nt).
; With PPUMASK bit 3 clear nothing is stored (NesSegOpen = 2); else the next pool entry is written uncached and is the
; open one (NesSegOpen = 1, NesSegCur, NesSegCount + 1). CLOBBERS t0-t2, t8, t9, v1. A leaf.
ProcedureNaked NesSegStoreAsm()
  ASM
nes_seg_store:
    la t8, global_ppumask
    ld t8, 0(t8)
    andi t9, t8, 8
    bnez t9, nes_seg_store_bg
    addiu t9, zero, 2
    la t0, global_nessegopen
    jr ra
    sd t9, 0(t0)                     ; open, nothing to draw
nes_seg_store_bg:
    la t9, global_nessegnext
    lw t0, 4(t9)                     ; the entry (KSEG1, sign-extended)
    daddiu t1, t0, #NES_SEG_BYTES
    sd t1, 0(t9)
    la t9, global_nessegcur
    sd t0, 0(t9)
    la t9, global_nessegcount
    ld t1, 0(t9)
    daddiu t1, t1, 1
    sd t1, 0(t9)
    addiu t1, zero, 1
    la t9, global_nessegopen
    sd t1, 0(t9)
    ; the 80 name-table bytes: rows at Nt + (v & $800) + (v & $3E0) (+$400), attributes at + $3C0 + ((v >> 4) & $38)
    la t1, global_nt
    andi t9, a2, 0x800
    daddu t1, t1, t9                 ; the table pair's base
    andi t9, a2, 0x3E0
    daddu t2, t1, t9                 ; the row of the table with bit 10 = 0
    ld t9, 0(t2)
    sd t9, 0(t0)
    ld t9, 8(t2)
    sd t9, 8(t0)
    ld t9, 16(t2)
    sd t9, 16(t0)
    ld t9, 24(t2)
    sd t9, 24(t0)
    ld t9, 1024(t2)                  ; bit 10 = 1
    sd t9, 32(t0)
    ld t9, 1032(t2)
    sd t9, 40(t0)
    ld t9, 1040(t2)
    sd t9, 48(t0)
    ld t9, 1048(t2)
    sd t9, 56(t0)
    srl t9, a2, 4
    andi t9, t9, 0x38
    daddu t2, t1, t9
    ld t9, 0x3C0(t2)                 ; the attribute rows
    sd t9, 64(t0)
    ld t9, 0x7C0(t2)
    sd t9, 72(t0)
    ; the parameters: k0, k1, fine X, PPUCTRL, PPUMASK, 0, v (16 bits)
    move v1, a0
    dsll v1, v1, 8
    or v1, v1, a1
    la t9, global_ppufinex
    ld t9, 0(t9)
    dsll v1, v1, 8
    or v1, v1, t9
    la t9, global_ppuctrl
    ld t9, 0(t9)
    andi t9, t9, 255
    dsll v1, v1, 8
    or v1, v1, t9
    dsll v1, v1, 8
    or v1, v1, t8                    ; PPUMASK
    dsll v1, v1, 24                  ; a 0 byte, then v
    andi t9, a2, 0xFFFF
    or v1, v1, t9
    sd v1, 80(t0)
    la t1, global_mapchrslots        ; the eight 1 KB CHR banks, a byte each
    move v1, zero
    addiu t2, zero, 8
nes_seg_store_bank:
    ld t9, 0(t1)
    andi t9, t9, 255
    dsll v1, v1, 8
    or v1, v1, t9
    addiu t2, t2, -1
    bnez t2, nes_seg_store_bank
    daddiu t1, t1, 8
    jr ra
    sd v1, 88(t0)
  EndASM
EndProcedure

; NesSegFirst - the line's first cut (ppu_cut_split): IN v0 = NesUnitData. OUT v1 = 1 the line is a split record (segment
; 0 stored, NesSegOn = 1; the show: U_LIVE = 1), 0 not (the old path). Keeps every register but t8, t9, v1.
ProcedureNaked NesSegFirst()
  ASM
    daddiu sp, sp, -96
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd t0, 40(sp)
    sd t1, 48(sp)
    sd t2, 56(sp)
    sd t3, 64(sp)
    move a3, v0
    ld t0, #NES_U_BANDCOUNT(a3)
    sltiu t0, t0, 31                 ; (#NES_U_BANDMAX - 1) the band closing now may take a record, the line takes the next
    beqz t0, nes_seg_first_rec
    ld t0, #NES_U_BANDOAM(a3)
    sltiu t1, t0, #NES_U_BANDMAX
    beqz t1, nes_seg_first_no        ; (a band with no snapshot is the old path's already)
    nop
    la t1, global_nessegnext
    lw t1, 4(t1)                     ; (both as KSEG1, sign-extended: compiled code and nes_seg_store write them)
    la t2, global_nessegend
    lw t2, 4(t2)
    daddiu t1, t1, 3072                  ; 32 entries
    sltu t1, t2, t1
    bnez t1, nes_seg_first_no        ; fewer than 32 entries free
    nop
    la t1, global_nesseg0oam
    sd t0, 0(t1)
    la t1, global_nessegnext
    lw t1, 4(t1)
    la t2, global_nessegfirste
    sd t1, 0(t2)
    la t2, global_nessegcount
    sd zero, 0(t2)
    addiu t1, zero, 1
    la t2, global_nessegon
    sd t1, 0(t2)
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      sd t1, #NES_U_LIVE(a3)         ; the line is drawn by its record: 1 (the old path's slots are addresses)
    EndASM
  CompilerEndIf
  ASM
    ; segment 0's sprite state: PPUCTRL | PPUMASK << 8 | fine X << 16, the banks (packed as an entry's +88)
    la t1, global_ppuctrl
    ld t0, 0(t1)
    andi t0, t0, 255
    la t1, global_ppumask
    ld t2, 0(t1)
    andi t2, t2, 255
    dsll t2, t2, 8
    or t0, t0, t2
    la t1, global_ppufinex
    ld t2, 0(t1)
    dsll t2, t2, 16
    or t0, t0, t2
    la t1, global_nesseg0st
    sd t0, 0(t1)
    la t1, global_mapchrslots
    move t0, zero
    addiu t2, zero, 8
nes_seg_first_bank:
    ld t3, 0(t1)
    andi t3, t3, 255
    dsll t0, t0, 8
    or t0, t0, t3
    addiu t2, t2, -1
    bnez t2, nes_seg_first_bank
    daddiu t1, t1, 8
    la t1, global_nesseg0banks
    sd t0, 0(t1)
    ; segment 0: spans [0, k1), k1 = ceil(dot / 8); v at dot 0 = v now less k1 coarse-X steps when rendering is on
    la t1, global_ppudot
    ld a1, 0(t1)
    addiu a1, a1, 7
    srl a1, a1, 3                    ; k1
    la t1, global_ppuv
    ld a2, 0(t1)
    la t1, global_ppumask
    ld t0, 0(t1)
    andi t0, t0, 24
    beqz t0, nes_seg_first_v
    andi t0, a2, 31                  ; (delay slot) coarse X ...
    srl t1, a2, 5
    andi t1, t1, 32
    or t0, t0, t1                    ; ... with bit 10 as its bit 5: a 6-bit counter
    subu t0, t0, a1
    andi t0, t0, 63
    andi t1, t0, 32
    sll t1, t1, 5
    andi t0, t0, 31
    andi a2, a2, 0x7BE0
    or a2, a2, t0
    or a2, a2, t1
nes_seg_first_v:
    la t1, global_nesseg0v
    sd a2, 0(t1)
    jal nes_seg_store
    move a0, zero                    ; (delay slot) k0 = 0
    la t1, global_nessegopen
    sd zero, 0(t1)                   ; the write that cut follows: segment 0 is closed
    b nes_seg_first_end
    addiu v1, zero, 1
nes_seg_first_rec:
    la t1, global_nessegstat
    ld t2, 32(t1)
    daddiu t2, t2, 1
    sd t2, 32(t1)                    ; [4] of them: no record free
nes_seg_first_no:
    la t1, global_nessegstat
    ld t2, 16(t1)
    daddiu t2, t2, 1
    sd t2, 16(t1)                    ; [2] a split line on the old path
    move v1, zero
nes_seg_first_end:
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld a3, 32(sp)
    ld t0, 40(sp)
    ld t1, 48(sp)
    ld t2, 56(sp)
    ld t3, 64(sp)
    jr ra
    daddiu sp, sp, 96
  EndASM
EndProcedure

; NesSegDraw - a draw on a split line drawn by its record (ppu_adv_draw): a0 = the end dot. The spans
; [ceil(PpuDot / 8), ceil(a0 / 8)) are consumed: with no segment open the first of them opens one (v = PpuV now),
; and the open one's end moves on. Keeps every register but t8, t9, v1 (a0 included).
ProcedureNaked NesSegDraw()
  ASM
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd t0, 32(sp)
    sd t1, 40(sp)
    addiu a1, a0, 7
    srl a1, a1, 3                    ; k1
    la t8, global_ppudot
    ld a0, 0(t8)
    addiu a0, a0, 7
    srl a0, a0, 3                    ; k0
    sltu t8, a0, a1
    beqz t8, nes_seg_draw_end        ; no span consumed
    nop
    la t8, global_nessegopen
    ld t9, 0(t8)
    bnez t9, nes_seg_draw_open
    nop
    la t8, global_ppuv
    ld a2, 0(t8)
    jal nes_seg_store                ; a segment opens
    nop
    b nes_seg_draw_end
    nop
nes_seg_draw_open:
    addiu t8, zero, 1
    bne t9, t8, nes_seg_draw_end     ; open, drawing nothing
    nop
    la t8, global_nessegcur
    lw t8, 4(t8)
    sb a1, 81(t8)                    ; the open segment's end span (uncached)
nes_seg_draw_end:
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld t0, 32(sp)
    ld t1, 40(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; NesSegPublish - dot 256 of a split line drawn by its record: the record written and its job queued as a band's.
Procedure NesSegPublish()
  Protected rec.i, n.i, st.i, m.i, idx.i
  n = PeekI(NesUnitBase + #NES_U_BANDCOUNT)
  idx = n
  rec = NesBandBase + n * #NES_BAND_BYTES
  PokeI(NesUnitBase + #NES_U_BANDCOUNT, n + 1)
  st = NesSeg0St
  m = (PpuMask & $E1) | ((st >> 8) & $16)
  If NesSegCount : m = m | 8 : EndIf
  PokeQ(rec + #NES_B_FIRST, PpuLine) : PokeQ(rec + #NES_B_END, PpuLine + 1)
  PokeQ(rec + #NES_B_V, NesSeg0V)
  PokeQ(rec + #NES_B_STATE, (st & 255) | (m << 8) | (((st >> 16) & 7) << 16) | ((PpuT & $7FFF) << 32))
  PokeQ(rec + #NES_B_MIRROR, MapMirrorMode)
  PokeQ(rec + #NES_B_OAM, NesSeg0Oam)
  PokeQ(rec + #NES_B_BANKS, NesSeg0Banks)                ; (big-endian: slot 0's number in the first byte)
  PokeL(rec + #NES_B_BANKS + 8, NesSegCount) : PokeL(rec + #NES_B_BANKS + 12, NesSegFirstE & $1FFFFFFF)
  For n = 0 To 24 Step 8 : PokeQ(rec + #NES_B_PAL + n, PeekQ(@Pal(0) + n)) : Next
  NesSegStat(0) + 1 : NesSegStat(1) + NesSegCount
  If NesSegCount > NesSegStat(3) : NesSegStat(3) = NesSegCount : EndIf
  NesSegOn = 0 : NesSegOpen = 0
  CompilerIf #NES_TWIN_CHECK
    NesTwinBand(rec)
  CompilerEndIf
  CompilerIf #NES_RSP_CHECK
    LpmCacheWritebackData(rec, #NES_BAND_BYTES)
    LpmCacheWritebackData(NesOamBase + NesSeg0Oam * 256, 256)
    NesRspBand(rec)
  CompilerEndIf
  CompilerIf #NES_RDP_SHOW
    NesShowBand(rec)
  CompilerEndIf
EndProcedure

Procedure NesSegReport()
  LpmDebugPrint("NES SEG SPLIT LINES BY RECORD " + Str(NesSegStat(0)) + " SEGMENTS " + Str(NesSegStat(1)) + " MOST A LINE " + Str(NesSegStat(3)) + " ON THE OLD PATH " + Str(NesSegStat(2)) + " (NO RECORD " + Str(NesSegStat(4)) + ")")
EndProcedure

; The unit's way in at dot 256 (every register its callers may hold kept, as NesShowBandCall).
ProcedureNaked NesSegPublishCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nessegpublish
    nop
    ld t0, 136(sp)
    mthi t0
    ld t0, 144(sp)
    mtlo t0
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld a3, 32(sp)
    ld a4, 40(sp)
    ld a5, 48(sp)
    ld a6, 56(sp)
    ld a7, 64(sp)
    ld t0, 72(sp)
    ld t1, 80(sp)
    ld t2, 88(sp)
    ld t3, 96(sp)
    ld t8, 104(sp)
    ld t9, 112(sp)
    ld v0, 120(sp)
    ld v1, 128(sp)
    jr ra
    daddiu sp, sp, 176
  EndASM
EndProcedure
CompilerEndIf
