; rspband.n64 - THE CPU SIDE OF THE RSP BAND EMITTER (step N4.3; design note, section N.18).
;
; THE WRITE-BACK AT A BAND'S CLOSE. The RSP reads RDRAM by its own DMA and never the CPU's D-cache (F-MEM-04), and
; the name and attribute tables (Nt, 4 KB), the band record and the band's OAM snapshot are written through the
; cache. So at every band's close, before the band's job is queued, the cold part writes back (Hit_Writeback_D,
; op $19) every line of Nt, the record's 6 lines and the snapshot's 16 lines: 278 cache operations. A line not in
; the cache or not dirty is left as it is; a dirty one is written to RDRAM and stays valid, so the guest's next
; access to it still hits. Nt is written back whole rather than the band's rows: the rows a band reads follow from
; its v walk, which the CPU does not do (the RSP does), and computing them here would cost more than the 256
; operations (measured: section N.18). SINCE N.66 the RSP reads its own image of the name tables, kept by the write
; log (below), so Nt is written back here only in the measuring build (--wb-measure); --rsp-check writes back the
; record and the snapshot.
; IN: t2 = the record (the band cut's register, unit/ppu_cold.n64, ppu_cut_close). CLOBBERS t3, t8, t9, v1 only;
; keeps t2 and every register the cut's callers hold.
; #NES_WB_MEASURE (the measuring build): the Count register before and after, summed in NesWbStat: [0] all ticks,
; [1] bands, [2] the largest, [3] the Nt part's ticks. A Count tick is 2 CPU cycles.
; the split lines' segment entries (below, design note N.60)
#NES_SEG_BYTES = 96
CompilerIf #NES_RDP_SHOW
  #NES_SEG_POOL = 42                    ; the show's: a 4 KB gap between two band-input slots (show.n64)
CompilerElse
  #NES_SEG_POOL = 64                    ; the checking builds' (6 KB; ppu_cold.n64's line 0 says 6144)
CompilerEndIf

; ======================================================================
; THE NAME-TABLE WRITE LOG (design note, section N.66). The shipped build (#NES_RDP_SHOW) and --rsp-check.
; The RSP's band job reads the name and attribute tables (only its background layer: two rows and two attribute
; rows a strip) when it RUNS, so it needs an image that is Nt as at the band's close and stays so until it has run.
; Copying Nt (4 KB) into a band-input slot at every close did that for ~13,700 Count ticks a band. Instead the RSP
; keeps ITS OWN image L (4 KB, the four logical tables as Nt lays them out) and brings it up to date itself:
;   - the hot unit's CIRAM write (unit/write.n64, u_ppuwrite) stores one entry - CIRAM offset << 8 | value - into a
;     4 KB ring, uncached (NesNtLog: [0] the room, [1] the last entry's byte offset, [2] the ring, KSEG1);
;   - at a band's close that reads the image (NesNtLogBand) the record gets the ring's span of entries not yet
;     applied (+32: from | to << 16, the entries after `from` up to `to`) and the band's map (+36: logical table
;     t's CIRAM slot, MapNtSlots(t), in bits 2t and 2t + 1); the job (rspband.n64rsp, NesRspBandA) applies each
;     entry to every table the map gives its slot, then reads L as it read the slot.
; WHY CIRAM WRITES: Nt is alias(CIRAM, MapNtSlots) at every moment (every Nt write is u_ppuwrite's, and MapperMirror
; rebuilds all of Nt from CIRAM after cutting the band). A CIRAM write does not depend on the map, so L stays
; alias(CIRAM, M) under a fixed M whatever the map did in between; only a job whose map differs from the last
; reading job's needs L rebuilt. THE RESYNC (L copied from Nt, every pending entry skipped): the first reading band,
; a map change, or an entry the ring had no room for (the room below 0: a world entry's thousands of writes while
; rendering is off and no job reads L). Before it, the last job that read L must have run (its fence; counted).
; THE ROOM: 1,023 entries less those not yet applied by a reading job known done (NesNtLogQueued, after the job's
; fence: the newest of the last two whose fence has passed) - so an entry is never stored over one a queued job
; has still to apply. L is at NesNtImage (KSEG0, on Nt's D-cache sets: the resync's copy displaces only Nt lines),
; the ring at NesNtImage + 8192 (the RSP program finds it there: nb_nt + 8192).
; ======================================================================
CompilerIf #NES_RDP_SHOW Or #NES_RSP_CHECK
#NES_NT_CAP = 1023                      ; the ring's entries that may be pending (1,024 slots of 4 bytes, one kept)
Global Dim NesNtLog.i(3)                ; [0] room [1] the last entry's offset [2] the ring (KSEG1) - u_ppuwrite's
Global NesNtImage.i                     ; L (KSEG0)
Global NesNtLast.i                      ; the last reading job's `to`: the next one's `from`
Global NesNtMap.i                       ; the last reading job's map
Global NesNtSync.i                      ; 1: the next reading band resyncs (the first)
Global NesNtPd.i                        ; the ring offset applied by a job known done
Global Dim NesNtF.i(2)                  ; the last two reading jobs' fences ([0] the newest; 0 none) ...
Global Dim NesNtP.i(2)                  ; ... and their `to`
; [0] reading jobs [1] entries given them [2] resyncs [3] of them for an entry not stored [4] for a map change
; [5] waits for the last reading job before a resync [6] the most entries one job applied
Global Dim NesNtStat.i(8)

Procedure NesNtInit(image.i)            ; image: KSEG0, 16-byte aligned, 8 KB + 4 KB (L, then the ring at +8192)
  NesNtImage = image
  NesNtLog(0) = #NES_NT_CAP : NesNtLog(1) = 0 : NesNtLog(2) = ((image + 8192) & $1FFFFFFF) | $A0000000
  NesNtLast = 0 : NesNtMap = -1 : NesNtSync = 1 : NesNtPd = 0 : NesNtF(0) = 0 : NesNtF(1) = 0
  LpmCacheWritebackInvalidateData(image, 8192 + 4096)   ; no stale line of L or the ring may land on them later
EndProcedure

; NesNtCopy(dst) - the 4 KB name and attribute image Nt into L (dst, KSEG0, 16-byte aligned, on the same D-cache
; sets as Nt). A line at a time: its 16 bytes read (cached hits), L's line created in the cache without a fill
; (Create_Dirty_Exclusive_D), written, and written back and invalidated (Hit_Writeback_Invalidate_D) - one block
; write to RDRAM a line where uncached stores make two bus writes and stall on each (measured: 13,247 Count ticks a
; copy with uncached stores). The line created takes the set of the Nt line just read (a dirty one is written back
; first), so the copy displaces only Nt, never guest RAM or the stack. L is in RDRAM and not in the cache when the
; loop ends. (The band-input slots' copy of N5, moved here from show.n64 unchanged; now run only at a resync.)
; CLOBBERS a0, t0-t3.
ProcedureNaked NesNtCopy(dst.i)
  ASM
    sll a0, a0, 0                    ; the address, sign-extended as the VR4300's 32-bit addressing wants
    la t0, global_nt
    daddiu t1, t0, 4096
nes_nt_copy:
    ld t2, 0(t0)                     ; 16 bytes of Nt (cached: a hit)
    ld t3, 8(t0)
    daddiu t0, t0, 16
    cache 0x0D, 0(a0)                ; Create_Dirty_Exclusive_D: L's line, not read from RDRAM
    sd t2, 0(a0)
    sd t3, 8(a0)
    cache 0x15, 0(a0)                ; Hit_Writeback_Invalidate_D: to RDRAM in one block write, out of the cache
    bne t0, t1, nes_nt_copy
    daddiu a0, a0, 16
    jr ra
    nop
  EndASM
EndProcedure

; NesNtLogBand(rec, reads) - a band's close, before its job is queued: the record's +32 / +36 (above). reads = 0
; (the background off, or a split line's record): from = to = 0, the job applies nothing. Else the map M, the
; resync when it is due, the span. Calls compiled procedures (LpmRspqFenceDone, LpmRspqWait): keeps s0-s2 itself;
; CLOBBERS what a compiled call may. THE PLAIN TWIN:
;   If reads = 0 : PokeL(rec + 32, 0) : PokeL(rec + 36, 0) : ProcedureReturn : EndIf
;   m = MapNtSlots(0) & 3 | (MapNtSlots(1) & 3) << 2 | (MapNtSlots(2) & 3) << 4 | (MapNtSlots(3) & 3) << 6
;   If NesNtLog(0) < 0 Or m <> NesNtMap Or NesNtSync
;     If NesNtF(0) And LpmRspqFenceDone(NesNtF(0)) = 0 : LpmRspqWait(NesNtF(0)) : NesNtStat(5) + 1 : EndIf
;     NesNtCopy(NesNtImage) : NesNtLast = NesNtLog(1) : NesNtPd = NesNtLog(1) : NesNtF(0) = 0 : NesNtF(1) = 0
;     NesNtSync = 0 : NesNtStat(2) + 1 (and (3) / (4) by the cause)
;   EndIf
;   PokeL(rec + 32, NesNtLast | NesNtLog(1) << 16) : PokeL(rec + 36, m) : NesNtLast = NesNtLog(1) : NesNtMap = m
ProcedureNaked NesNtLogBand(rec.i, reads.i)
  ASM
    bnez a1, nntb_reads
    nop
    sw zero, 32(a0)                  ; a band that does not read the image: nothing to apply
    jr ra
    sw zero, 36(a0)                  ; (delay slot)
nntb_reads:
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    move s0, a0                      ; the record
    la t0, global_mapntslots         ; the map: MapNtSlots(t) & 3 in bits 2t, 2t + 1
    ld t1, 0(t0)
    andi s1, t1, 3
    ld t1, 8(t0)
    andi t1, t1, 3
    sll t1, t1, 2
    or s1, s1, t1
    ld t1, 16(t0)
    andi t1, t1, 3
    sll t1, t1, 4
    or s1, s1, t1
    ld t1, 24(t0)
    andi t1, t1, 3
    sll t1, t1, 6
    or s1, s1, t1
    la t0, global_nesntlog
    ld t1, 0(t0)
    bltz t1, nntb_resync             ; an entry was not stored: the ring cannot bring L up to date
    addiu s2, zero, 3                ; (delay slot) the cause's statistic
    la t0, global_nesntmap
    ld t1, 0(t0)
    bne t1, s1, nntb_resync          ; another map: L's aliases are not Nt's
    addiu s2, zero, 4                ; (delay slot)
    la t0, global_nesntsync
    ld t1, 0(t0)
    beqz t1, nntb_fields             ; the first reading band resyncs; every other takes the span
    move s2, zero                    ; (delay slot)
nntb_resync:
    la t0, global_nesntf
    ld a0, 0(t0)                     ; the newest job that read L
    beqz a0, nntb_copy
    nop
    jal lpmrspqfencedone
    nop
    bnez v0, nntb_copy               ; it has run
    nop
    la t0, global_nesntf
    jal lpmrspqwait                  ; it has not: L is not ours to write until it has (counted)
    ld a0, 0(t0)                     ; (delay slot)
    la t0, global_nesntstat
    ld t1, 40(t0)
    daddiu t1, t1, 1
    sd t1, 40(t0)
nntb_copy:
    la t0, global_nesntimage
    jal nesntcopy
    ld a0, 0(t0)                     ; (delay slot)
    la t0, global_nesntlog
    ld t1, 8(t0)                     ; every entry up to the last one stored is in the copy
    la t0, global_nesntlast
    sd t1, 0(t0)
    la t0, global_nesntpd
    sd t1, 0(t0)
    la t0, global_nesntf
    sd zero, 0(t0)
    sd zero, 8(t0)
    la t0, global_nesntsync
    sd zero, 0(t0)
    la t0, global_nesntstat
    ld t1, 16(t0)
    daddiu t1, t1, 1
    sd t1, 16(t0)                    ; resyncs
    beqz s2, nntb_fields
    dsll s2, s2, 3                   ; (delay slot) the cause's slot
    daddu t0, t0, s2
    ld t1, 0(t0)
    daddiu t1, t1, 1
    sd t1, 0(t0)
nntb_fields:
    la t0, global_nesntlog
    ld t1, 8(t0)                     ; to: the last entry stored
    la t0, global_nesntlast
    ld t2, 0(t0)                     ; from: the last reading job's to
    sd t1, 0(t0)
    sll t3, t1, 16
    or t3, t3, t2
    sw t3, 32(s0)                    ; +32: from | to << 16
    sw s1, 36(s0)                    ; +36: the map
    la t0, global_nesntmap
    sd s1, 0(t0)
    dsubu t3, t1, t2
    andi t3, t3, 4095
    dsrl t3, t3, 2                   ; the entries given this job
    la t0, global_nesntstat
    ld t1, 0(t0)
    daddiu t1, t1, 1
    sd t1, 0(t0)
    ld t1, 8(t0)
    daddu t1, t1, t3
    sd t1, 8(t0)
    ld t1, 48(t0)
    sltu t2, t1, t3
    beqz t2, nntb_out
    nop
    sd t3, 48(t0)
nntb_out:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    jr ra
    daddiu sp, sp, 32
  EndASM
EndProcedure

; NesNtLogQueued(f) - after a reading band's job and its fence f are queued: the offset applied by a job known done
; (the newest of the last two reading jobs whose fence has passed), the two kept, and the room the hot append may
; use until the next reading band: #NES_NT_CAP less the entries after that offset. THE PLAIN TWIN:
;   If NesNtF(0) And LpmRspqFenceDone(NesNtF(0)) : NesNtPd = NesNtP(0)
;   ElseIf NesNtF(1) And LpmRspqFenceDone(NesNtF(1)) : NesNtPd = NesNtP(1) : EndIf
;   NesNtF(1) = NesNtF(0) : NesNtP(1) = NesNtP(0) : NesNtF(0) = f : NesNtP(0) = NesNtLast
;   NesNtLog(0) = #NES_NT_CAP - ((NesNtLog(1) - NesNtPd) & 4095) >> 2
ProcedureNaked NesNtLogQueued(f.i)
  ASM
    daddiu sp, sp, -16
    sd ra, 0(sp)
    sd s0, 8(sp)
    move s0, a0
    la t0, global_nesntf
    ld a0, 0(t0)
    beqz a0, nntq_shift              ; none: every job that read L before has run (a resync waited for it)
    nop
    jal lpmrspqfencedone
    nop
    beqz v0, nntq_older
    nop
    la t0, global_nesntp
    b nntq_pd
    ld t1, 0(t0)                     ; (delay slot) the newest's to
nntq_older:
    la t0, global_nesntf
    ld a0, 8(t0)
    beqz a0, nntq_shift
    nop
    jal lpmrspqfencedone
    nop
    beqz v0, nntq_shift              ; neither yet: the offset known applied stays
    nop
    la t0, global_nesntp
    ld t1, 8(t0)
nntq_pd:
    la t0, global_nesntpd
    sd t1, 0(t0)
nntq_shift:
    la t0, global_nesntf
    ld t1, 0(t0)
    sd t1, 8(t0)
    sd s0, 0(t0)
    la t0, global_nesntp
    ld t1, 0(t0)
    sd t1, 8(t0)
    la t2, global_nesntlast
    ld t1, 0(t2)
    sd t1, 0(t0)
    la t0, global_nesntlog
    ld t1, 8(t0)                     ; the last entry stored
    la t2, global_nesntpd
    ld t2, 0(t2)
    dsubu t1, t1, t2
    andi t1, t1, 4095
    dsrl t1, t1, 2                   ; entries not known applied
    addiu t2, zero, #NES_NT_CAP
    dsubu t2, t2, t1
    sd t2, 0(t0)                     ; the room
    ld ra, 0(sp)
    ld s0, 8(sp)
    jr ra
    daddiu sp, sp, 16
  EndASM
EndProcedure

Procedure NesNtReport()
  LpmDebugPrint("NES NTLOG JOBS " + Str(NesNtStat(0)) + " ENTRIES " + Str(NesNtStat(1)) + " MOST A JOB " + Str(NesNtStat(6)) + " RESYNCS " + Str(NesNtStat(2)) + " DROPPED " + Str(NesNtStat(3)) + " MAP " + Str(NesNtStat(4)) + " WAITS " + Str(NesNtStat(5)))
EndProcedure
CompilerEndIf

CompilerIf #NES_WB_MEASURE Or #NES_RSP_CHECK

CompilerIf #NES_WB_MEASURE
  Global Dim NesWbStat.i(4)
CompilerEndIf

ProcedureNaked NesBandWriteback()
  CompilerIf #NES_WB_MEASURE
    ASM
      mfc0 v1, $9                    ; Count at the start
      nop
    EndASM
  CompilerEndIf
  ; (--rsp-check: the RSP reads its own image of the name tables, kept by the write log - section N.66 - so Nt is
  ; written back only in the measuring build, which measures that)
  CompilerIf #NES_WB_MEASURE
  ASM
    la t3, global_nt
    daddiu t8, t3, 4096              ; the end (exclusive)
    daddiu t9, zero, -16
    and t3, t3, t9                   ; the first line (Nt need not start on one)
nes_bwb_nt:
    cache 0x19, 0(t3)                ; Hit_Writeback_D: Nt, line by line
    daddiu t3, t3, 16
    sltu t9, t3, t8
    bne t9, zero, nes_bwb_nt
    nop
  EndASM
  CompilerEndIf
  CompilerIf #NES_WB_MEASURE
    ASM
      mfc0 t9, $9                    ; Count after Nt
      nop
      subu t9, t9, v1
      la t3, global_neswbstat
      ld t8, 24(t3)
      daddu t8, t8, t9
      sd t8, 24(t3)
    EndASM
  CompilerEndIf
  ASM
    cache 0x19, 0(t2)                ; the record's 96 bytes
    cache 0x19, 16(t2)
    cache 0x19, 32(t2)
    cache 0x19, 48(t2)
    cache 0x19, 64(t2)
    cache 0x19, 80(t2)
    ld t3, #NES_B_OAM(t2)            ; the band's OAM snapshot: NesOamBase + index x 256
    dsll t3, t3, 8
    la t8, global_nesoambase
    ld t8, 0(t8)
    daddu t3, t3, t8
    daddiu t8, t3, 256
nes_bwb_oam:
    cache 0x19, 0(t3)
    daddiu t3, t3, 16
    bne t3, t8, nes_bwb_oam
    nop
  EndASM
  CompilerIf #NES_WB_MEASURE
    ASM
      mfc0 t9, $9                    ; Count at the end
      nop
      subu t9, t9, v1                ; this band's ticks
      la t3, global_neswbstat
      ld t8, 0(t3)
      daddu t8, t8, t9
      sd t8, 0(t3)
      ld t8, 8(t3)
      daddiu t8, t8, 1
      sd t8, 8(t3)
      ld t8, 16(t3)
      sltu v1, t8, t9
      beq v1, zero, nes_bwb_end
      nop
      sd t9, 16(t3)
nes_bwb_end:
    EndASM
  CompilerEndIf
  ASM
    jr ra
    nop
  EndASM
EndProcedure

CompilerIf #NES_RSP_CHECK
; ---- THE CHECKING BUILD (--rsp-check, with the twin): the RSP program (rspband.n64rsp) on the same bands ----
; At every band record the cut writes back the band's inputs (above) and NesRspBandCall queues the band's job; at
; line 240 NesRspFrame waits for the queue and compares the frame's every command word and every band's TLUT block
; with the twin's; the first difference stops the run (NesRspHalt, read at the frame's end in nes.n64) with the
; band's record printed. The twin's second picture (NesTwinFrame) is then drawn from the RSP's words.
XIncludeFile "rspband_ids.pmi"
ASM
  .rspfile "rspband.n64rsp"
EndASM
; WHERE: the 64 KB between the cartridge arena's end and the library's crash display (#NES_CART_LOW_END,
; storage.n64; the library's map: "$80200000 - $803BFFFF free for your fixed buffers"): the frame command area
; (4,096 doublewords + 16 bytes of status) at +0, the RSP's TLUT blocks (32 x 256) at +$8100, the program's copy
; (its file + 128 bytes, at most 20 KB) at +$B000. The RAM below the stack has no room for them beside the twin.
#NES_RSP_AREA = #NES_CART_LOW_END
#NES_RSP_TLUT_AT = $8100
#NES_RSP_PROG_AT = $B000
Global NesRspProg.i, NesRspTlut.i, NesRspFirst.s          ; (NesRspOut: twin.n64)
Global Dim NesRspNtSpace.a(8192+8192+4096+16)        ; the RSP's name-table image and the log's ring (N.66)
Global Dim NesRspStat.i(8)                          ; frames, words, TLUT blocks compared, differences, RSP clocks, bands

Procedure NesRspInit()
  Protected space.i, need.i
  NesTwinBases()
  If (@Nt(0) & 7) Or (@Rgb64(0) & 7) Or (NesChrMaskBase & 7)
    LpmDebugPrint("NES RSP CHECK REFUSED: an input not 8-byte aligned for the RSP's DMA") : NesRspHalt = 1 : ProcedureReturn
  EndIf
  need = LpmCartFileLen(1) + 128
  space = #NES_RSP_AREA + #NES_RSP_PROG_AT
  If need > $10000 - #NES_RSP_PROG_AT
    LpmDebugPrint("NES RSP CHECK REFUSED: the program's file is " + Str(need - 128) + " bytes") : NesRspHalt = 1 : ProcedureReturn
  EndIf
  NesRspOut = (#NES_RSP_AREA & $1FFFFFFF) | $A0000000
  NesRspTlut = ((#NES_RSP_AREA + #NES_RSP_TLUT_AT) & $1FFFFFFF) | $A0000000
  LpmCacheWritebackInvalidateData(#NES_RSP_AREA, #NES_RSP_PROG_AT)   ; no stale line of it may land later
  LpmCacheWritebackData(@Rgb64(0), 1024)
  NesRspProg = LpmRspqProgram(LpmCartFile(1), space)
  If NesRspProg = 0
    LpmDebugPrint("NES RSP CHECK REFUSED: LpmRspqProgram") : NesRspHalt = 1 : ProcedureReturn
  EndIf
  ; the RSP's image of the name tables, kept by the write log (N.66): on Nt's D-cache sets, the ring 8 KB after it
  NesNtInit(@NesRspNtSpace(0) + (((@Nt(0) & ~15) - @NesRspNtSpace(0)) & 8191))
  LpmRspqCmd7(NesRspProg, #NES_RSP_SETUP, NesNtImage & $1FFFFFFF, NesChrMaskBase & $1FFFFFFF, @Rgb64(0) & $1FFFFFFF, NesChrPairBase & $1FFFFFFF, NesTwinTlut & $1FFFFFFF, NesRspTlut & $1FFFFFFF, NesRspOut & $1FFFFFFF)
  LpmRspqSync()
  LpmDebugPrint("NES RSP PROGRAM " + Str(need - 128) + " bytes, on")
EndProcedure

Procedure NesRspBand(rec.i)
  Protected idx.i, oam.i, reads.i, f.i
  If NesRspProg = 0 : ProcedureReturn : EndIf
  idx = (rec - NesBandBase) / #NES_BAND_BYTES
  oam = NesOamBase + PeekI(rec + #NES_B_OAM) * 256
  ; the job reads the image only in its background layer, and a split line's record not at all (N.66)
  reads = Bool((PeekI(rec + #NES_B_STATE) >> 8) & 8 And PeekL(rec + #NES_B_BANKS + 8) = 0)
  NesNtLogBand(rec, reads)
  LpmCacheWritebackData(rec + 32, 16)   ; the record's +32 / +36, written after the cut's write-back
  LpmRspqCmd(NesRspProg, #NES_RSP_BAND, rec & $1FFFFFFF, oam & $1FFFFFFF, idx)
  f = LpmRspqFence()
  If reads : NesNtLogQueued(f) : EndIf
  LpmRspqFlush()
EndProcedure

; The cold part's way in (unit/ppu_cold.n64, ppu_cut_close), after the write-back: t2 = the record. Keeps every
; register the cut's callers may hold, as NesTwinBandCall does.
ProcedureNaked NesRspBandCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    jal nesrspband
    move a0, t2
    ld t0, 136(sp)
    mthi t0
    ld t0, 144(sp)
    mtlo t0
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld a3, 32(sp)
    ld a4, 40(sp)
    ld a5, 48(sp)
    ld a6, 56(sp)
    ld a7, 64(sp)
    ld t0, 72(sp)
    ld t1, 80(sp)
    ld t2, 88(sp)
    ld t3, 96(sp)
    ld t8, 104(sp)
    ld t9, 112(sp)
    ld v0, 120(sp)
    ld v1, 128(sp)
    jr ra
    daddiu sp, sp, 176
  EndASM
EndProcedure

Procedure NesRspStop(f.i, i.i, b.i, what.s)
  Protected k.i, s.s
  NesRspStat(3) + 1
  If NesRspFirst = ""
    NesRspFirst = "frame " + Str(f) + " " + what
    s = "NES RSP RECORD band " + Str(b)
    If b >= 0 And b < #NES_U_BANDMAX
      For k = 0 To 11 : s = s + " " + Hex(PeekQ(NesBandBase + b * #NES_BAND_BYTES + k * 8)) : Next
    EndIf
    LpmDebugPrint("NES RSP FIRST DIFFERENCE " + NesRspFirst)
    LpmDebugPrint(s)
  EndIf
  NesRspHalt = 1
EndProcedure

; At line 240, before the twin's picture: every word and every TLUT block of the frame, RSP against twin.
Procedure NesRspFrame()
  Protected n.i, i.i, b.i, k.i, w.i, x.i, bands.i, st.i, f.i
  If NesRspProg = 0 Or NesRspHalt : ProcedureReturn : EndIf
  bands = PeekI(NesUnitBase + #NES_U_BANDCOUNT)
  If bands = 0 : ProcedureReturn : EndIf
  f = WorkerFrames
  LpmRspqSync()
  st = NesRspOut + #NES_RSP_WORDS * 8
  n = PeekL(st) & $FFFFFFFF
  If PeekL(st + 12) <> bands : NesRspStop(f, 0, bands - 1, "bands done " + Str(PeekL(st + 12)) + " of " + Str(bands)) : ProcedureReturn : EndIf
  If n > #NES_RSP_WORDS : n = #NES_RSP_WORDS : EndIf
  For i = 0 To n - 1
    If i < NesTwinN
      w = PeekQ(NesRspOut + i * 8)
      x = NesTwinCmd(i)
      If w <> x
        ; the band that wrote word i: the record whose words began at or before it is not known here; the frame's
        ; records are all printed by number - the first band whose TLUT image is named before word i
        b = 0
        For k = 0 To i
          If ((NesTwinCmd(k) >> 56) & $3F) = $3D And (NesTwinCmd(k) & $FFFFFFFF) >= (NesTwinTlut & $1FFFFFFF) And (NesTwinCmd(k) & $FFFFFFFF) < (NesTwinTlut & $1FFFFFFF) + #NES_U_BANDMAX * 256 And ((NesTwinCmd(k) >> 32) & $FFF) = 127
            b = ((NesTwinCmd(k) & $FFFFFFFF) - (NesTwinTlut & $1FFFFFFF)) / 256
          EndIf
        Next
        NesRspStop(f, i, b, "word " + Str(i) + " of " + Str(NesTwinN) + ": twin $" + Hex((x >> 32) & $FFFFFFFF) + " " + Hex(x & $FFFFFFFF) + " RSP $" + Hex((w >> 32) & $FFFFFFFF) + " " + Hex(w & $FFFFFFFF))
        ProcedureReturn
      EndIf
    EndIf
  Next
  If PeekL(st + 4) Or NesTwinOver
    w = PeekQ(NesRspOut + NesTwinN * 8) : x = PeekQ(NesRspOut + NesTwinN * 8 + 8)
    NesRspStop(f, 0, -1, "words that did not fit: RSP " + Str(PeekL(st + 4)) + " twin " + Str(NesTwinOver) + "; twin's words " + Str(NesTwinN) + ", the RSP's next $" + Hex((w >> 32) & $FFFFFFFF) + " " + Hex(w & $FFFFFFFF) + " $" + Hex((x >> 32) & $FFFFFFFF) + " " + Hex(x & $FFFFFFFF))
    ProcedureReturn
  EndIf
  If n <> NesTwinN : NesRspStop(f, n, bands - 1, "words: twin " + Str(NesTwinN) + " RSP " + Str(n)) : ProcedureReturn : EndIf
  For b = 0 To bands - 1
    For k = 0 To 255 Step 8
      If PeekQ(NesRspTlut + b * 256 + k) <> PeekQ(NesTwinTlut + b * 256 + k)
        NesRspStop(f, 0, b, "TLUT block of band " + Str(b) + " byte " + Str(k)) : ProcedureReturn
      EndIf
    Next
  Next
  NesRspStat(0) + 1 : NesRspStat(1) + n : NesRspStat(2) + bands : NesRspStat(4) + (PeekL(st + 8) & $FFFFFFFF)
  If (PeekL(st + 8) & $FFFFFFFF) > NesRspStat(5) : NesRspStat(5) = PeekL(st + 8) & $FFFFFFFF : EndIf
EndProcedure

Procedure NesRspReport()
  LpmDebugPrint("NES RSP FRAMES " + Str(NesRspStat(0)) + " WORDS " + Str(NesRspStat(1)) + " TLUT BLOCKS " + Str(NesRspStat(2)) + " DIFFERENCES " + Str(NesRspStat(3)) + " RSP CLOCKS " + Str(NesRspStat(4)) + " MAX A FRAME " + Str(NesRspStat(5)))
  LpmDebugPrint("NES RSP FIRST DIFFERENCE " + NesRspFirst)
  NesNtReport()
EndProcedure
CompilerEndIf

CompilerIf #NES_WB_MEASURE
Procedure NesWbReport()
  LpmDebugPrint("NES WB TICKS " + Str(NesWbStat(0)) + " BANDS " + Str(NesWbStat(1)) + " MAX " + Str(NesWbStat(2)) + " NT " + Str(NesWbStat(3)))
EndProcedure
CompilerEndIf

CompilerEndIf

; ======================================================================
; SPLIT LINES AS BAND RECORDS WITH SEGMENTS (design note, section N.60, item 1). The shipped build (#NES_RDP_SHOW) and
; the checking builds that run the twin (#NES_TWIN_CHECK). A SPLIT LINE is one on which a picture input changes at dots
; 1-255. The old renderer draws its background in 8-dot spans, each with the inputs in force when its first dot is
; reached, so the line is a run of SEGMENTS of spans, each drawn under one state; its sprites are those of dot 0 and
; its colours those of dot 256. Here the state machine's own moments write that down for the RSP (rspband.n64rsp,
; NesRspBandS) and the twin (twin.n64), instead of the old renderer drawing the line:
;   NesSegFirst    at the line's first cut (unit/ppu_cold.n64, ppu_cut_split), before the write is applied: segment 0
;                  (spans 0 .. ceil(dot / 8), v at dot 0, the state now) and the sprite state of dot 0 kept - when a
;                  record (the frame's 32) and 32 entries of the segment pool are free; else the old path (counted).
;   (every later cut on the line closes the open segment: ppu_cut_split)
;   NesSegDraw     at every draw on the line (unit/ppu.n64, ppu_adv_draw): the spans consumed; the first draw after a
;                  cut opens a segment - v, fine X, PPUCTRL, PPUMASK, the 8 CHR bank numbers and the 80 name-table bytes
;                  its tiles can read (the strip's DMA layout of rspband.n64rsp: the rows of the tables with bit 10 = 0
;                  and 1 at v's coarse Y and bit 11, then their attribute rows) - copied from Nt now.
;   NesSegPublish  at dot 256 (ppu_adv_publish): the line's record (the band log's: first L, end L + 1, segment 0's
;                  PPUCTRL / fine X / banks / OAM snapshot, PPUMASK bits 0, 5-7 now with bits 1, 2, 4 of segment 0 and
;                  bit 3 when a segment draws, the palette now; +56 the segment count, +60 the first entry's physical
;                  address) and its job as a band's.
; A SEGMENT ENTRY, 96 bytes, written UNCACHED (the RSP DMAs it; no cache line taken, nothing to write back):
;   +0 the row of the table with bit 10 = 0 (32 bytes)   +32 bit 10 = 1   +64 / +72 their attribute rows (8 each)
;   +80 k0  +81 k1 (spans [k0, k1))  +82 fine X  +83 PPUCTRL  +84 PPUMASK  +85 0  +86 v (16 bits)  +88 the 8 bank numbers
; A segment with PPUMASK bit 3 clear draws no tile and stores nothing. THE POOL: a frame set's (the show's two
; sets by NesShowCur: 42 entries each, in the gaps between the band-input slots; the checking builds one set of 64,
; NesSegCheckSpace, which they wait on at every line 240). A line has at most 32 segments that store (one span each at least), so 32 free
; entries at the first cut make the line's segments certain.
; ======================================================================
CompilerIf #NES_TWIN_CHECK Or #NES_RDP_SHOW
Global NesSegOn.i                       ; 1 while the current line is a split line drawn by a record
Global NesSegOpen.i                     ; 0 no segment open, 1 one open (NesSegCur), 2 one open that draws nothing
Global NesSegCur.i, NesSegNext.i, NesSegEnd.i, NesSegFirstE.i, NesSegCount.i   ; KSEG1 entries
Global NesSeg0St.i, NesSeg0Banks.i, NesSeg0Oam.i, NesSeg0V.i   ; segment 0's sprite state; v at dot 0
Global Dim NesSegBaseP.i(2)             ; each frame set's pool (KSEG1)
Global Dim NesSegStat.i(8)              ; [0] split lines by record [1] segments stored [2] split lines on the old path
                                        ; [3] most segments in a line [4] of [2]: no record free
CompilerIf #NES_RDP_SHOW
  Declare NesShowBand(rec.i)
CompilerElse
  Global Dim NesSegCheckSpace.a(#NES_SEG_POOL*#NES_SEG_BYTES+16)   ; the checking builds' one pool
CompilerEndIf

Procedure NesSegInit(nt.i)               ; nt: the show's band-input slots (NesShowNtBase; 0 in the checking builds)
  CompilerIf #NES_RDP_SHOW
    ; THE SHOW'S POOLS: the 4 KB gaps after band-input slots 0 and 1 (NesShowNtSpace keeps its slots 8 KB apart, on
    ; Nt's D-cache sets; the gaps are written here only uncached, so no cache line of them is ever taken). NesShowInit
    ; has invalidated the whole space.
    NesSegBaseP(0) = ((nt + 4096) & $1FFFFFFF) | $A0000000
    NesSegBaseP(1) = ((nt + 4096 + 8192) & $1FFFFFFF) | $A0000000
  CompilerElse
    Protected a.i = (@NesSegCheckSpace(0) + 15) & ~15
    LpmCacheWritebackInvalidateData(a, #NES_SEG_POOL * #NES_SEG_BYTES)   ; no stale line may land on it later
    NesSegBaseP(0) = (a & $1FFFFFFF) | $A0000000
    NesSegBaseP(1) = NesSegBaseP(0)
  CompilerEndIf
  NesSegFrame(0)
EndProcedure

; NesSegFrame(p) - a frame starts on set p's pool (show: NesShowSet's tail call; the checking builds: line 0).
; Assembly (design note N.71). THE PLAIN TWIN:
;   NesSegNext = NesSegBaseP(p) : NesSegEnd = NesSegBaseP(p) + #NES_SEG_POOL * #NES_SEG_BYTES
;   NesSegOn = 0 : NesSegOpen = 0
; CLOBBERS t0-t2.
#NES_SEG_POOL_BYTES = #NES_SEG_POOL * #NES_SEG_BYTES
; THE SPLIT LINES' RUN PINNED (design note N.73): NesSegFrame, NesSegStoreAsm, NesSegFirst and NesSegDraw are one
; layout unit (each falls through or ends in a delay slot that is not a nop); NesSegDraw runs at every span of a split
; line. Unpinned, the run's place moved with every change of the code before it: on one build it landed on the
; unit's per-dot sets (ppu_adv_save, u_ppuadvance, ppu_adv_start: +137 K I-misses over the run, +2 K cycles a frame).
; NesSegPin pads with zero words to the next address that is 11892 modulo 16384 - the place the run had in the record
; run before (NesSegDraw on rel. sets 338-343 from cpurun's, where it met no unit line), so it holds in every show
; build. It runs on into NesSegFrame (no jr / j / b); nothing enters it. Anything written between them breaks the pin.
CompilerIf #NES_RDP_SHOW
ProcedureNaked NesSegPin()
  ASM
    .alignabs 16384, 11892
  EndASM
EndProcedure
CompilerEndIf
ProcedureNaked NesSegFrame(p.i)
  ASM
    dsll t0, a0, 3
    la t1, global_nessegbasep
    daddu t1, t1, t0
    ld t2, 0(t1)                     ; set p's pool (KSEG1)
    la t1, global_nessegnext
    sd t2, 0(t1)
    daddiu t2, t2, #NES_SEG_POOL_BYTES
    la t1, global_nessegend
    sd t2, 0(t1)
    la t1, global_nessegon
    sd zero, 0(t1)
    la t1, global_nessegopen
    jr ra
    sd zero, 0(t1)                   ; (delay slot)
  EndASM
EndProcedure

; nes_seg_store - a segment opens: a0 = k0, a1 = k1, a2 = v (the state: PpuFineX, PpuCtrl, PpuMask, MapChrSlots, Nt).
; With PPUMASK bit 3 clear nothing is stored (NesSegOpen = 2); else the next pool entry is written uncached and is the
; open one (NesSegOpen = 1, NesSegCur, NesSegCount + 1). CLOBBERS t0-t2, t8, t9, v1. A leaf.
ProcedureNaked NesSegStoreAsm()
  ASM
nes_seg_store:
    la t8, global_ppumask
    ld t8, 0(t8)
    andi t9, t8, 8
    bnez t9, nes_seg_store_bg
    addiu t9, zero, 2
    la t0, global_nessegopen
    jr ra
    sd t9, 0(t0)                     ; open, nothing to draw
nes_seg_store_bg:
    la t9, global_nessegnext
    lw t0, 4(t9)                     ; the entry (KSEG1, sign-extended)
    daddiu t1, t0, #NES_SEG_BYTES
    sd t1, 0(t9)
    la t9, global_nessegcur
    sd t0, 0(t9)
    la t9, global_nessegcount
    ld t1, 0(t9)
    daddiu t1, t1, 1
    sd t1, 0(t9)
    addiu t1, zero, 1
    la t9, global_nessegopen
    sd t1, 0(t9)
    ; the 80 name-table bytes: rows at Nt + (v & $800) + (v & $3E0) (+$400), attributes at + $3C0 + ((v >> 4) & $38)
    la t1, global_nt
    andi t9, a2, 0x800
    daddu t1, t1, t9                 ; the table pair's base
    andi t9, a2, 0x3E0
    daddu t2, t1, t9                 ; the row of the table with bit 10 = 0
    ld t9, 0(t2)
    sd t9, 0(t0)
    ld t9, 8(t2)
    sd t9, 8(t0)
    ld t9, 16(t2)
    sd t9, 16(t0)
    ld t9, 24(t2)
    sd t9, 24(t0)
    ld t9, 1024(t2)                  ; bit 10 = 1
    sd t9, 32(t0)
    ld t9, 1032(t2)
    sd t9, 40(t0)
    ld t9, 1040(t2)
    sd t9, 48(t0)
    ld t9, 1048(t2)
    sd t9, 56(t0)
    srl t9, a2, 4
    andi t9, t9, 0x38
    daddu t2, t1, t9
    ld t9, 0x3C0(t2)                 ; the attribute rows
    sd t9, 64(t0)
    ld t9, 0x7C0(t2)
    sd t9, 72(t0)
    ; the parameters: k0, k1, fine X, PPUCTRL, PPUMASK, 0, v (16 bits)
    move v1, a0
    dsll v1, v1, 8
    or v1, v1, a1
    la t9, global_ppufinex
    ld t9, 0(t9)
    dsll v1, v1, 8
    or v1, v1, t9
    la t9, global_ppuctrl
    ld t9, 0(t9)
    andi t9, t9, 255
    dsll v1, v1, 8
    or v1, v1, t9
    dsll v1, v1, 8
    or v1, v1, t8                    ; PPUMASK
    dsll v1, v1, 24                  ; a 0 byte, then v
    andi t9, a2, 0xFFFF
    or v1, v1, t9
    sd v1, 80(t0)
    la t1, global_mapchrslots        ; the eight 1 KB CHR banks, a byte each
    move v1, zero
    addiu t2, zero, 8
nes_seg_store_bank:
    ld t9, 0(t1)
    andi t9, t9, 255
    dsll v1, v1, 8
    or v1, v1, t9
    addiu t2, t2, -1
    bnez t2, nes_seg_store_bank
    daddiu t1, t1, 8
    jr ra
    sd v1, 88(t0)
  EndASM
EndProcedure

; NesSegFirst - the line's first cut (ppu_cut_split): IN v0 = NesUnitData. OUT v1 = 1 the line is a split record (segment
; 0 stored, NesSegOn = 1; the show: U_LIVE = 1), 0 not (the old path). Keeps every register but t8, t9, v1.
ProcedureNaked NesSegFirst()
  ASM
    daddiu sp, sp, -96
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd t0, 40(sp)
    sd t1, 48(sp)
    sd t2, 56(sp)
    sd t3, 64(sp)
    move a3, v0
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      la t0, global_nesshowfreecur   ; the frame's set taken before its segment pool is written (show.n64, N.62)
      ld t0, 0(t0)
      bnez t0, nes_seg_first_free
      nop
      jal nesshowacquirecall         ; (every register kept)
      nop
nes_seg_first_free:
    EndASM
  CompilerEndIf
  ASM
    ld t0, #NES_U_BANDCOUNT(a3)
    sltiu t0, t0, 31                 ; (#NES_U_BANDMAX - 1) the band closing now may take a record, the line takes the next
    beqz t0, nes_seg_first_rec
    ld t0, #NES_U_BANDOAM(a3)
    sltiu t1, t0, #NES_U_OAMSNAPMAX   ; (the two snapshot sets' indices, N.78)
    beqz t1, nes_seg_first_no        ; (a band with no snapshot is the old path's already)
    nop
    la t1, global_nessegnext
    lw t1, 4(t1)                     ; (both as KSEG1, sign-extended: compiled code and nes_seg_store write them)
    la t2, global_nessegend
    lw t2, 4(t2)
    daddiu t1, t1, 3072                  ; 32 entries
    sltu t1, t2, t1
    bnez t1, nes_seg_first_no        ; fewer than 32 entries free
    nop
    la t1, global_nesseg0oam
    sd t0, 0(t1)
    la t1, global_nessegnext
    lw t1, 4(t1)
    la t2, global_nessegfirste
    sd t1, 0(t2)
    la t2, global_nessegcount
    sd zero, 0(t2)
    addiu t1, zero, 1
    la t2, global_nessegon
    sd t1, 0(t2)
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      sd t1, #NES_U_LIVE(a3)         ; the line is drawn by its record: 1 (the old path's slots are addresses)
    EndASM
  CompilerEndIf
  ASM
    ; segment 0's sprite state: PPUCTRL | PPUMASK << 8 | fine X << 16, the banks (packed as an entry's +88)
    la t1, global_ppuctrl
    ld t0, 0(t1)
    andi t0, t0, 255
    la t1, global_ppumask
    ld t2, 0(t1)
    andi t2, t2, 255
    dsll t2, t2, 8
    or t0, t0, t2
    la t1, global_ppufinex
    ld t2, 0(t1)
    dsll t2, t2, 16
    or t0, t0, t2
    la t1, global_nesseg0st
    sd t0, 0(t1)
    la t1, global_mapchrslots
    move t0, zero
    addiu t2, zero, 8
nes_seg_first_bank:
    ld t3, 0(t1)
    andi t3, t3, 255
    dsll t0, t0, 8
    or t0, t0, t3
    addiu t2, t2, -1
    bnez t2, nes_seg_first_bank
    daddiu t1, t1, 8
    la t1, global_nesseg0banks
    sd t0, 0(t1)
    ; segment 0: spans [0, k1), k1 = ceil(dot / 8); v at dot 0 = v now less k1 coarse-X steps when rendering is on
    la t1, global_ppudot
    ld a1, 0(t1)
    addiu a1, a1, 7
    srl a1, a1, 3                    ; k1
    la t1, global_ppuv
    ld a2, 0(t1)
    la t1, global_ppumask
    ld t0, 0(t1)
    andi t0, t0, 24
    beqz t0, nes_seg_first_v
    andi t0, a2, 31                  ; (delay slot) coarse X ...
    srl t1, a2, 5
    andi t1, t1, 32
    or t0, t0, t1                    ; ... with bit 10 as its bit 5: a 6-bit counter
    subu t0, t0, a1
    andi t0, t0, 63
    andi t1, t0, 32
    sll t1, t1, 5
    andi t0, t0, 31
    andi a2, a2, 0x7BE0
    or a2, a2, t0
    or a2, a2, t1
nes_seg_first_v:
    la t1, global_nesseg0v
    sd a2, 0(t1)
    jal nes_seg_store
    move a0, zero                    ; (delay slot) k0 = 0
    la t1, global_nessegopen
    sd zero, 0(t1)                   ; the write that cut follows: segment 0 is closed
    b nes_seg_first_end
    addiu v1, zero, 1
nes_seg_first_rec:
    la t1, global_nessegstat
    ld t2, 32(t1)
    daddiu t2, t2, 1
    sd t2, 32(t1)                    ; [4] of them: no record free
nes_seg_first_no:
    la t1, global_nessegstat
    ld t2, 16(t1)
    daddiu t2, t2, 1
    sd t2, 16(t1)                    ; [2] a split line on the old path
    move v1, zero
nes_seg_first_end:
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld a3, 32(sp)
    ld t0, 40(sp)
    ld t1, 48(sp)
    ld t2, 56(sp)
    ld t3, 64(sp)
    jr ra
    daddiu sp, sp, 96
  EndASM
EndProcedure

; NesSegDraw - a draw on a split line drawn by its record (ppu_adv_draw): a0 = the end dot. The spans
; [ceil(PpuDot / 8), ceil(a0 / 8)) are consumed: with no segment open the first of them opens one (v = PpuV now),
; and the open one's end moves on. Keeps every register but t8, t9, v1 (a0 included).
ProcedureNaked NesSegDraw()
  ASM
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd t0, 32(sp)
    sd t1, 40(sp)
    addiu a1, a0, 7
    srl a1, a1, 3                    ; k1
    la t8, global_ppudot
    ld a0, 0(t8)
    addiu a0, a0, 7
    srl a0, a0, 3                    ; k0
    sltu t8, a0, a1
    beqz t8, nes_seg_draw_end        ; no span consumed
    nop
    la t8, global_nessegopen
    ld t9, 0(t8)
    bnez t9, nes_seg_draw_open
    nop
    la t8, global_ppuv
    ld a2, 0(t8)
    jal nes_seg_store                ; a segment opens
    nop
    b nes_seg_draw_end
    nop
nes_seg_draw_open:
    addiu t8, zero, 1
    bne t9, t8, nes_seg_draw_end     ; open, drawing nothing
    nop
    la t8, global_nessegcur
    lw t8, 4(t8)
    sb a1, 81(t8)                    ; the open segment's end span (uncached)
nes_seg_draw_end:
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld t0, 32(sp)
    ld t1, 40(sp)
    jr ra
    daddiu sp, sp, 48
  EndASM
EndProcedure

; NesSegPublish - dot 256 of a split line drawn by its record: the record written and its job queued as a band's.
; Documented VR4300 assembly (the owner's order: the emulator's glue in assembly; design note N.71), folded into the
; unit's way in, NesSegPublishCall (below): no compiled frame between the unit and NesShowBand.
; THE PLAIN TWIN (the compiled procedure it replaces):
;   Protected rec.i, n.i, st.i, m.i, idx.i
;   n = PeekI(NesUnitBase + #NES_U_BANDCOUNT)
;   idx = n
;   rec = NesBandBase + n * #NES_BAND_BYTES
;   PokeI(NesUnitBase + #NES_U_BANDCOUNT, n + 1)
;   st = NesSeg0St
;   m = (PpuMask & $E1) | ((st >> 8) & $16)
;   If NesSegCount : m = m | 8 : EndIf
;   PokeQ(rec + #NES_B_FIRST, PpuLine) : PokeQ(rec + #NES_B_END, PpuLine + 1)
;   PokeQ(rec + #NES_B_V, NesSeg0V)
;   PokeQ(rec + #NES_B_STATE, (st & 255) | (m << 8) | (((st >> 16) & 7) << 16) | ((PpuT & $7FFF) << 32))
;   PokeQ(rec + #NES_B_MIRROR, MapMirrorMode)
;   PokeQ(rec + #NES_B_OAM, NesSeg0Oam)
;   PokeQ(rec + #NES_B_BANKS, NesSeg0Banks)                ; (big-endian: slot 0's number in the first byte)
;   PokeL(rec + #NES_B_BANKS + 8, NesSegCount) : PokeL(rec + #NES_B_BANKS + 12, NesSegFirstE & $1FFFFFFF)
;   For n = 0 To 24 Step 8 : PokeQ(rec + #NES_B_PAL + n, PeekQ(@Pal(0) + n)) : Next
;   If (m & $18) = 0 And (NesSeg0V & $3F00) = $3F00                      ; N.79 item 2: the rendering-off backdrop
;     i = NesSeg0V & 31 : If (i & $13) = $10 : i = i & $0F : EndIf : PokeA(rec + #NES_B_PAL, Pal(i))
;   EndIf
;   NesSegStat(0) + 1 : NesSegStat(1) + NesSegCount
;   If NesSegCount > NesSegStat(3) : NesSegStat(3) = NesSegCount : EndIf
;   NesSegOn = 0 : NesSegOpen = 0
;   CompilerIf #NES_TWIN_CHECK : NesTwinBand(rec) : CompilerEndIf
;   CompilerIf #NES_RSP_CHECK
;     LpmCacheWritebackData(rec, #NES_BAND_BYTES) : LpmCacheWritebackData(NesOamBase + NesSeg0Oam * 256, 256)
;     NesRspBand(rec)
;   CompilerEndIf
;   CompilerIf #NES_RDP_SHOW : NesShowBand(rec) : CompilerEndIf
; HOW: rec = NesBandBase + (n << 6) + (n << 5) (96 n); the shifts of st are logical (dsrl): the masks keep only bits
; the arithmetic shift gives the same. Pal is 32 bytes, 8-byte aligned (the compiled PeekQ reads it with ld too). rec
; lives in s0 (saved at 152(sp), in the call's own frame) for the checking builds' calls after the stores.

Procedure NesSegReport()
  LpmDebugPrint("NES SEG SPLIT LINES BY RECORD " + Str(NesSegStat(0)) + " SEGMENTS " + Str(NesSegStat(1)) + " MOST A LINE " + Str(NesSegStat(3)) + " ON THE OLD PATH " + Str(NesSegStat(2)) + " (NO RECORD " + Str(NesSegStat(4)) + ")")
EndProcedure

; The unit's way in at dot 256 (ppu_adv_publish, through NesLivePublish): every register its callers may hold kept, as
; NesShowBandCall; then NesSegPublish's body (above) in place.
ProcedureNaked NesSegPublishCall()
  ASM
    daddiu sp, sp, -176
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    sd a2, 24(sp)
    sd a3, 32(sp)
    sd a4, 40(sp)
    sd a5, 48(sp)
    sd a6, 56(sp)
    sd a7, 64(sp)
    sd t0, 72(sp)
    sd t1, 80(sp)
    sd t2, 88(sp)
    sd t3, 96(sp)
    sd t8, 104(sp)
    sd t9, 112(sp)
    sd v0, 120(sp)
    sd v1, 128(sp)
    mfhi t0
    sd t0, 136(sp)
    mflo t0
    sd t0, 144(sp)
    sd s0, 152(sp)
    la t9, global_nesunitbase
    ld t9, 0(t9)
    ld t0, #NES_U_BANDCOUNT(t9)      ; n: the frame's next record
    daddiu t1, t0, 1
    sd t1, #NES_U_BANDCOUNT(t9)      ; taken
    dsll t1, t0, 6
    dsll t2, t0, 5
    daddu t1, t1, t2                 ; n x 96
    la t2, global_nesbandbase
    ld t2, 0(t2)
    daddu s0, t2, t1                 ; rec
    la t0, global_nesseg0st
    ld t1, 0(t0)                     ; st: segment 0's sprite state
    la t0, global_ppumask
    ld t2, 0(t0)
    andi t2, t2, 0xE1                ; PPUMASK bits 0, 5-7 now
    dsrl t3, t1, 8
    andi t3, t3, 0x16                ; bits 1, 2, 4 of segment 0
    or t2, t2, t3                    ; m
    la t0, global_nessegcount
    ld t8, 0(t0)                     ; NesSegCount
    beqz t8, nsp_m
    nop
    ori t2, t2, 8                    ; bit 3 when a segment draws
nsp_m:
    la t0, global_ppuline
    ld t0, 0(t0)
    sd t0, #NES_B_FIRST(s0)          ; first L
    daddiu t0, t0, 1
    sd t0, #NES_B_END(s0)            ; end L + 1
    la t0, global_nesseg0v
    ld t0, 0(t0)
    sd t0, #NES_B_V(s0)              ; v at dot 0
    andi t0, t1, 255                 ; st & 255 (PPUCTRL)
    dsll t2, t2, 8
    or t0, t0, t2                    ; | m << 8
    dsrl t3, t1, 16
    andi t3, t3, 7
    dsll t3, t3, 16
    or t0, t0, t3                    ; | ((st >> 16) & 7) << 16 (fine X)
    la t3, global_pput
    ld t3, 0(t3)
    andi t3, t3, 0x7FFF
    dsll32 t3, t3, 0
    or t0, t0, t3                    ; | (PpuT & $7FFF) << 32
    sd t0, #NES_B_STATE(s0)
    la t0, global_mapmirrormode
    ld t0, 0(t0)
    sd t0, #NES_B_MIRROR(s0)
    la t0, global_nesseg0oam
    ld t0, 0(t0)
    sd t0, #NES_B_OAM(s0)            ; segment 0's OAM snapshot
    la t0, global_nesseg0banks
    ld t0, 0(t0)
    sd t0, #NES_B_BANKS(s0)          ; its 8 bank numbers
    sw t8, #NES_B_BANKS+8(s0)        ; the segment count
    la t0, global_nessegfirste
    ld t0, 0(t0)
    lui t1, 0x1FFF
    ori t1, t1, 0xFFFF
    and t0, t0, t1
    sw t0, #NES_B_BANKS+12(s0)       ; the first entry, physical
    la t0, global_pal
    ld t1, 0(t0)
    ld t2, 8(t0)
    sd t1, #NES_B_PAL(s0)
    sd t2, #NES_B_PAL+8(s0)
    ld t1, 16(t0)
    ld t2, 24(t0)
    sd t1, #NES_B_PAL+16(s0)
    sd t2, #NES_B_PAL+24(s0)         ; the palette now
    ld t1, #NES_B_STATE(s0)          ; the backdrop of a rendering-off line (N.79 item 2, as ppu_cut_close): the
    andi t1, t1, 0x1800              ; byte at mirror(v & $1F) when v (at the line's dot 0) addresses the palette
    bnez t1, nsp_pal_done            ; PPUMASK bits 3-4 set: byte 0
    ld t1, #NES_B_V(s0)
    andi t2, t1, 0x3F00
    xori t2, t2, 0x3F00
    bnez t2, nsp_pal_done            ; v outside $3F00-$3FFF: byte 0
    andi t1, t1, 31
    andi t2, t1, 0x13
    xori t2, t2, 0x10
    bnez t2, nsp_pal_byte            ; not $10 / $14 / $18 / $1C
    nop
    andi t1, t1, 0x0F                ; a mirror of $00 / $04 / $08 / $0C
nsp_pal_byte:
    daddu t1, t0, t1
    lbu t1, 0(t1)
    sb t1, #NES_B_PAL(s0)
nsp_pal_done:
    la t0, global_nessegstat
    ld t1, 0(t0)
    daddiu t1, t1, 1
    sd t1, 0(t0)                     ; (0) split lines by record
    ld t1, 8(t0)
    daddu t1, t1, t8
    sd t1, 8(t0)                     ; (1) segments
    ld t1, 24(t0)
    slt t2, t1, t8
    beqz t2, nsp_stat
    nop
    sd t8, 24(t0)                    ; (3) the most a line
nsp_stat:
    la t0, global_nessegon
    sd zero, 0(t0)
    la t0, global_nessegopen
    sd zero, 0(t0)
  EndASM
  CompilerIf #NES_TWIN_CHECK
  ASM
    jal nestwinband                  ; the emitter twin's band (the checking builds)
    move a0, s0                      ; (delay slot)
  EndASM
  CompilerEndIf
  CompilerIf #NES_RSP_CHECK
  ASM
    move a0, s0
    jal lpmcachewritebackdata        ; the record ...
    addiu a1, zero, #NES_BAND_BYTES  ; (delay slot)
    la t0, global_nesseg0oam
    ld a0, 0(t0)
    dsll a0, a0, 8
    la t0, global_nesoambase
    ld t0, 0(t0)
    daddu a0, a0, t0
    jal lpmcachewritebackdata        ; ... and its OAM snapshot to RDRAM
    addiu a1, zero, 256              ; (delay slot)
    jal nesrspband                   ; the RSP check's band
    move a0, s0                      ; (delay slot)
  EndASM
  CompilerEndIf
  CompilerIf #NES_RDP_SHOW
  ASM
    jal nesshowband                  ; its job queued as a band's (show.n64)
    move a0, s0                      ; (delay slot)
  EndASM
  CompilerEndIf
  ASM
    ld s0, 152(sp)
    ld t0, 136(sp)
    mthi t0
    ld t0, 144(sp)
    mtlo t0
    ld ra, 0(sp)
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld a2, 24(sp)
    ld a3, 32(sp)
    ld a4, 40(sp)
    ld a5, 48(sp)
    ld a6, 56(sp)
    ld a7, 64(sp)
    ld t0, 72(sp)
    ld t1, 80(sp)
    ld t2, 88(sp)
    ld t3, 96(sp)
    ld t8, 104(sp)
    ld t9, 112(sp)
    ld v0, 120(sp)
    ld v1, 128(sp)
    jr ra
    daddiu sp, sp, 176
  EndASM
EndProcedure
CompilerEndIf
