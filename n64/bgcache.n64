; Cache eight indexed pixels for each pattern row and background palette.
; MMC1 uses physical CHR rows. Boards with fetch observers use the ordinary fetch.
CompilerIf #NES_BG_EXPANDED Or #NES_MMC1_ROWS
Global Dim NesMapRows.u(8192)
Global Dim NesBgRows.i(16384)
ProcedureNaked NesExpandBg(dest.i,bits.i)
  ASM
    la t0, global_nesbgrows
    andi t1, a0, 15
    sll t1, t1, 2
    srl t2, a0, 4
    sll t2, t2, 8
    addu t0, t0, t1
    addu t0, t0, t2
    la t2, NesBgPixelSpread
    andi t1, a1, 255
    sll t1, t1, 2
    srl t3, a1, 8
    sll t3, t3, 2
    addu t1, t1, t2
    addu t3, t3, t2
    lw t1, 0(t1)
    lwu t3, 0(t3)
    dsll32 t1, t1, 0
    or t1, t1, t3
    sd t1, 0(t0)
    beq t1, zero, nes_bg_expand_empty
    nop
    la t2, NesBgPalMask
    ld t3, 0(t2)
    or t3, t3, t1
    sd t3, 64(t0)
    ld t3, 8(t2)
    or t3, t3, t1
    sd t3, 128(t0)
    ld t3, 16(t2)
    or t3, t3, t1
    jr ra
    sd t3, 192(t0)
nes_bg_expand_empty:
    sd zero, 64(t0)
    sd zero, 128(t0)
    jr ra
    sd zero, 192(t0)
  EndASM
EndProcedure
DataSection
NesBgPalMask:
  Data.q $0404040404040404,$0808080808080808,$0C0C0C0C0C0C0C0C
EndDataSection

ProcedureNaked NesWriteExpandedNt(addr.i, value.i)
  ; The fixed-mirroring boards maintain a descriptor for every tile.
  ; Tile writes replace its index. Attribute writes update all four quads.
  ASM
    la t0, global_ppumirroring
    ld t0, 0(t0)
    la a2, global_nt
    addiu t1, zero, 1
    beq t0, t1, nes_nt_vertical
    nop
    andi a0, a0, 0xbff
    xori a3, a0, 0x400
    b nes_nt_address
    addiu a4, zero, 64
nes_nt_vertical:
    andi a0, a0, 0x7ff
    xori a3, a0, 0x800
    addiu a4, zero, 8192
nes_nt_address:
    addu t0, a2, a0
    lbu t1, 0(t0)
    beq t1, a1, nes_nt_done
    addu a3, a2, a3
    sb a1, 0(t0)
    sb a1, 0(a3)
    andi t0, a0, 0x3ff
    sltiu t0, t0, 0x3c0
    beq t0, zero, nes_nt_attribute
    sll a1, a1, 8
    andi t0, a0, 0x800
    sll t0, t0, 2
    andi t1, a0, 0x3e0
    sll t1, t1, 3
    srl t2, a0, 4
    andi t2, t2, 64
    andi a0, a0, 31
    sll a0, a0, 1
    or a0, a0, t0
    or a0, a0, t1
    or a0, a0, t2
    la t0, global_nesmaprows
    addu t1, t0, a0
    xor a0, a0, a4
    addu t2, t0, a0
    lhu t0, 0(t1)
    andi t0, t0, 0xc0
    or a1, a1, t0
    sh a1, 0(t1)
    sh a1, 128(t1)
    sh a1, 0(t2)
    jr ra
    sh a1, 128(t2)
nes_nt_attribute:
    la t0, global_namedescdirty
    ld t1, 0(t0)
    beq t1, zero, nes_nt_update_attr
    nop
nes_nt_done:
    jr ra
    nop
nes_nt_update_attr:
    j ppuupdateattribute
    nop
  EndASM
EndProcedure
CompilerEndIf
