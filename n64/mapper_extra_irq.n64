; CPU timer IRQs used by FFE, Sunsoft 5B, NES-EVENT and RAMBO-1.
ProcedureNaked ExtraCpuTicks(cycles.i)
  CompilerIf #GAME_MAPPER=64 Or #GAME_MAPPER=158
    ASM
      blez a0, nes_extra_tick_done
      nop
      daddiu sp, sp, -32
      sd ra, 0(sp)
      sd s0, 8(sp)
      sd s1, 16(sp)
      move s0, a0
      la s1, global_extrapending
nes_rambo_tick_cycle:
      ld t0, 0(s1)
      blez t0, nes_rambo_tick_divide
      nop
      daddiu t0, t0, -1
      bnez t0, nes_rambo_tick_divide
      sd t0, 0(s1)
      ld t1, global_mapirqassertions-global_extrapending(s1)
      addiu t0, zero, 1
      sd t0, global_mapirq-global_extrapending(s1)
      daddiu t1, t1, 1
      sd t1, global_mapirqassertions-global_extrapending(s1)
nes_rambo_tick_divide:
      ld t0, global_extrairqmode-global_extrapending(s1)
      ld t1, global_extraflags-global_extrapending(s1)
      or t0, t0, t1
      beqz t0, nes_rambo_tick_next
      nop
      ld t0, global_extrairqdivider-global_extrapending(s1)
      addiu t0, t0, 1
      andi t0, t0, 3
      bnez t0, nes_rambo_tick_next
      sd t0, global_extrairqdivider-global_extrapending(s1)
      jal extraramboclock
      addiu a0, zero, 1
      sd zero, global_extraflags-global_extrapending(s1)
nes_rambo_tick_next:
      daddiu s0, s0, -1
      bnez s0, nes_rambo_tick_cycle
      nop
      ld ra, 0(sp)
      ld s0, 8(sp)
      ld s1, 16(sp)
      daddiu sp, sp, 32
    EndASM
  CompilerElse
    ASM
      la t0, global_extrairqrun
      ld t1, 0(t0)
      beqz t1, nes_extra_tick_done
      ld t1, global_extrairqcount-global_extrairqrun(t0)
    EndASM
    CompilerIf #GAME_MAPPER=6
      ASM
        lui t2, 1
        dsubu t2, t2, t1
        daddu t1, t1, a0
        andi t1, t1, 65535
        slt t2, a0, t2
        bnez t2, nes_extra_tick_done
        sd t1, global_extrairqcount-global_extrairqrun(t0)
        sd zero, 0(t0)
      EndASM
    CompilerElseIf #GAME_MAPPER=69
      ASM
        daddiu t2, t1, 1
        dsubu t1, t1, a0
        andi t1, t1, 65535
        slt t2, a0, t2
        bnez t2, nes_extra_tick_done
        sd t1, global_extrairqcount-global_extrairqrun(t0)
        ld t2, global_mapirqenable-global_extrairqrun(t0)
        beqz t2, nes_extra_tick_done
        nop
      EndASM
    CompilerElse
      ASM
        daddu t1, t1, a0
        lui t2, 0x2000
        slt t2, t1, t2
        bnez t2, nes_extra_tick_done
        sd t1, global_extrairqcount-global_extrairqrun(t0)
        sd zero, 0(t0)
      EndASM
    CompilerEndIf
    ASM
      ld t1, global_mapirqassertions-global_extrairqrun(t0)
      addiu t2, zero, 1
      sd t2, global_mapirq-global_extrairqrun(t0)
      daddiu t1, t1, 1
      sd t1, global_mapirqassertions-global_extrairqrun(t0)
    EndASM
  CompilerEndIf
  ASM
nes_extra_tick_done:
    jr ra
    nop
  EndASM
EndProcedure

ProcedureNaked.i ExtraBudget()
  CompilerIf #GAME_MAPPER=64 Or #GAME_MAPPER=158
    ASM
      la t0, global_extrapending
      ld a0, 0(t0)
      bgtz a0, nes_extra_budget_done
      ld t1, global_extrairqmode-global_extrapending(t0)
      ld t2, global_extraflags-global_extrapending(t0)
      or t1, t1, t2
      beqz t1, nes_extra_budget_done
      addiu a0, zero, 128
      ld t1, global_extrairqdivider-global_extrapending(t0)
      addiu a0, zero, 4
      jr ra
      dsubu a0, a0, t1
    EndASM
  CompilerElse
    ASM
      la t0, global_extrairqrun
      ld t1, 0(t0)
      beqz t1, nes_extra_budget_done
      addiu a0, zero, 128
      ld t1, global_extrairqcount-global_extrairqrun(t0)
    EndASM
    CompilerIf #GAME_MAPPER=6
      ASM
        lui t0, 1
        dsubu a0, t0, t1
      EndASM
    CompilerElseIf #GAME_MAPPER=69
      ASM
        daddiu a0, t1, 1
      EndASM
    CompilerElse
      ASM
        lui t0, 0x2000
        dsubu a0, t0, t1
      EndASM
    CompilerEndIf
    ASM
      bgtz a0, nes_extra_budget_max
      slti t0, a0, 129
      jr ra
      addiu a0, zero, 1
nes_extra_budget_max:
      bnez t0, nes_extra_budget_done
      nop
      addiu a0, zero, 128
    EndASM
  CompilerEndIf
  ASM
nes_extra_budget_done:
    jr ra
    nop
  EndASM
EndProcedure
