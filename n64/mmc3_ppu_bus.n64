; The mapper-4 PPU bus has wired CIRAM and direct ROM pattern biases.
ProcedureNaked.i PpuRead(addr.i)
  ASM
    andi a0, a0, 0x3FFF
    sltiu t0, a0, 0x3F00
    beqz t0, nes_mmc3_ppu_palette_read
    nop
    daddiu sp, sp, -16
    sd ra, 0(sp)
    sd a0, 8(sp)
    la t0, global_mapdots
    jal mappera12
    ld a1, 0(t0)
    ld ra, 0(sp)
    ld a0, 8(sp)
    daddiu sp, sp, 16
    sltiu t0, a0, 0x2000
    beqz t0, nes_mmc3_ppu_ciram_read
    srl t0, a0, 10
    sll t0, t0, 3
    la t1, global_nesmmc3chrbias
    daddu t0, t0, t1
    ld t0, 0(t0)
    daddu a0, a0, t0
    jr ra
    lbu a0, 0(a0)
nes_mmc3_ppu_ciram_read:
    andi t0, t0, 3
    sll t0, t0, 3
    la t1, global_mapntslots
    daddu t0, t0, t1
    ld t0, 0(t0)
    sll t0, t0, 10
    andi a0, a0, 1023
    la t1, global_mapciram
    daddu t0, t0, t1
    daddu t0, t0, a0
    jr ra
    lbu a0, 0(t0)
nes_mmc3_ppu_palette_read:
    andi t0, a0, 0x13
    addiu t1, zero, 0x10
    bne t0, t1, nes_mmc3_ppu_palette_index
    andi a0, a0, 31
    addiu a0, a0, -16
nes_mmc3_ppu_palette_index:
    la t0, global_pal
    daddu t0, t0, a0
    jr ra
    lbu a0, 0(t0)
  EndASM
EndProcedure

ProcedureNaked PpuWrite(addr.i,value.i)
  ; The body is in the hot unit (n64/unit/write.n64, u_ppuwrite; design note N.40); outside callers enter it here.
  ASM
    j u_ppuwrite
    nop
  EndASM
EndProcedure
