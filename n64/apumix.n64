; Render one stable APU span block. Oscillator tick preserves s0-s7.
ProcedureNaked NesMixBlock(spans.i, dmc.i, count.i, volume.i, duty.i)
  ASM
    daddiu sp, sp, -128
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    sd s4, 40(sp)
    sd s5, 48(sp)
    sd s6, 56(sp)
    sd s7, 64(sp)
    sd fp, 120(sp)
    la fp, global_apuseq
    sll s0, a0, 0
    sll s1, a1, 0
    or s2, a2, zero
    srl t2, a3, 16
    sd t2, 112(sp)
    or s4, a4, zero
    sd s2, 72(sp)
    ; Cache the nonlinear pulse mix for the four combinations of the two
    ; duty bits. The pulse amplitudes stay fixed throughout this span.
    la t0, global_pulsemix
    andi t1, a3, 255
    srl t2, a3, 8
    andi t2, t2, 255
    sll t1, t1, 1
    sll t2, t2, 1
    addu t3, t1, t2
    addu t3, t0, t3
    lhu s3, 0(t3)
    addu t2, t0, t2
    lhu t2, 0(t2)
    dsll s3, s3, 16
    or s3, s3, t2
    addu t1, t0, t1
    lhu t1, 0(t1)
    dsll s3, s3, 16
    or s3, s3, t1
    lhu t0, 0(t0)
    dsll s3, s3, 16
    or s3, s3, t0
  EndASM
  ; Sample range and capture statistics are only used by verification.
  CompilerIf #VERIFY_FRAME>0
    ASM
    la t0, global_apuminimum
    ld t0, 0(t0)
    sd t0, 80(sp)
    la t0, global_apumaximum
    ld t0, 0(t0)
    sd t0, 88(sp)
    sd zero, 96(sp)
    EndASM
  CompilerEndIf
  ASM
    la t0, global_apulastx
    ld t0, 0(t0)
    sd t0, 104(sp)
    la t0, global_apulasty
    ld s5, 0(t0)
    la s6, global_pcm
    la t0, global_apuproduced
    ld s7, 0(t0)
nes_mix_next:
    lhu a0, 0(s0)
    jal nesoscillatortick
    daddiu s0, s0, 2

    lw t0, 4(fp)
    lw t1, 12(fp)
    srlv t0, s4, t0
    srlv t1, s4, t1
    andi t0, t0, 1
    andi t1, t1, 256
    srl t1, t1, 7
    or t0, t0, t1
    sll t0, t0, 4
    dsrlv t0, s3, t0
    andi t0, t0, 65535

    lw t1, global_noiseshift-global_apuseq+4(fp)
    andi t1, t1, 1
    addiu t1, t1, -1
    ld a1, 112(sp)
    and t1, t1, a1
    sll t1, t1, 1
    lbu t3, 0(s1)
    addu t1, t1, t3
    srl t3, s4, 16
    bnez t3, nes_mix_triangle_mean
    sll t1, t1, 1
    lw t2, global_tridac-global_apuseq+4(fp)
    sll a1, t2, 1
    addu t2, t2, a1
    sll t2, t2, 1
    addu t2, t2, t1
    daddiu t3, fp, global_tndmix-global_apuseq
nes_mix_tnd_load:
    addu t3, t3, t2
    lhu t2, 0(t3)
    addu v0, t0, t2

  EndASM
  CompilerIf #NES_AUDIO_RATE=20000
    ASM
    ; Q16 pole (65400/65536)^(48000/20000) rounds to 65210.
    ori t1, zero, 65210
    EndASM
  CompilerElse
    ASM
    ori t1, zero, 65400
    EndASM
  CompilerEndIf
  ASM
    ; The signed 16-bit filter state times either pole fits signed 32 bits.
    mult s5, t1
    ld t0, 104(sp)
    dsubu t0, v0, t0
    mflo t2
    bgez t2, nes_mix_dc_positive
    nop
    ori t1, zero, 65535
    daddu t2, t2, t1
nes_mix_dc_positive:
    dsra t2, t2, 16
    daddu t0, t0, t2
    addiu t1, zero, 32767
    slt t2, t1, t0
    beq t2, zero, nes_mix_check_min
    sd v0, 104(sp)
    or t0, t1, zero
nes_mix_check_min:
    addiu t1, zero, -32768
    slt t2, t0, t1
    beq t2, zero, nes_mix_store
    nop
    or t0, t1, zero
nes_mix_store:
    daddu s5, t0, zero
    andi t2, s7, 4095
    sll t2, t2, 1
    addu t2, s6, t2
    sh t0, 0(t2)
    daddiu s7, s7, 1
  EndASM
  CompilerIf #VERIFY_FRAME>0
    ASM
    ld t2, 80(sp)
    slt t3, t0, t2
    beq t3, zero, nes_mix_check_max
    nop
    sd t0, 80(sp)
nes_mix_check_max:
    ld t2, 88(sp)
    slt t3, t2, t0
    beq t3, zero, nes_mix_check_nonzero
    nop
    sd t0, 88(sp)
nes_mix_check_nonzero:
    ld t2, 96(sp)
    sltu t3, zero, t0
    daddu t2, t2, t3
    sd t2, 96(sp)
    EndASM
  CompilerEndIf
  ASM
    daddiu s2, s2, -1
    bgtz s2, nes_mix_next
    daddiu s1, s1, 1
    la t0, global_apuoutput
    sd s5, 0(t0)
    la t0, global_apulasty
    sd s5, 0(t0)
    la t0, global_apulastx
    ld t1, 104(sp)
    sd t1, 0(t0)
    la t0, global_apuproduced
    sd s7, 0(t0)
  EndASM
  CompilerIf #VERIFY_FRAME>0
    ASM
    la t0, global_apuminimum
    ld t1, 80(sp)
    sd t1, 0(t0)
    la t0, global_apumaximum
    ld t1, 88(sp)
    sd t1, 0(t0)
    la t0, global_apunonzero
    ld t1, 0(t0)
    ld t2, 96(sp)
    daddu t1, t1, t2
    sd t1, 0(t0)
    la t0, global_apucapture
    ld t1, 0(t0)
    ld t2, 72(sp)
    daddu t1, t1, t2
    sltiu t2, t1, 4097
    bnez t2, nes_mix_capture
    nop
    addiu t1, zero, 4096
nes_mix_capture:
    sd t1, 0(t0)
    EndASM
  CompilerEndIf
  ASM
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    ld s6, 56(sp)
    ld s7, 64(sp)
    ld fp, 120(sp)
    jr ra
    daddiu sp, sp, 128
nes_mix_triangle_mean:
    la t3, NesTndTriMeanData
    b nes_mix_tnd_load
    or t2, t1, zero
  EndASM
EndProcedure
