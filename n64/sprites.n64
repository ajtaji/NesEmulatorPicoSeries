ProcedureNaked PpuBuildSpriteCache()
  ; Keep eight OAM indices and an overflow marker per visible scanline.
  ASM
    la a0, global_cachedcount
    la a1, global_cachedsprite
    la a2, global_oam
    la t0, global_ppuctrl
    ld a3, 0(t0)
    andi a3, a3, 32
    srl a3, a3, 2
    addiu a3, a3, 8
    or t0, a0, zero
    addiu t1, a0, 256
nes_sprite_cache_clear:
    sd zero, 0(t0)
    sd zero, 8(t0)
    sd zero, 16(t0)
    sd zero, 24(t0)
    addiu t0, t0, 32
    bne t0, t1, nes_sprite_cache_clear
    nop
    or a5, zero, zero
    addiu t8, zero, 9
nes_sprite_cache_next:
    lbu t0, 0(a2)
    addiu t0, t0, 1
    sltiu t1, t0, 240
    beq t1, zero, nes_sprite_cache_advance
    addu t2, t0, a3
    sltiu t1, t2, 241
    bne t1, zero, nes_sprite_cache_range
    nop
    addiu t2, zero, 240
nes_sprite_cache_range:
    sll t1, t0, 3
    daddu t1, a1, t1
    daddu t0, a0, t0
    daddu t2, a0, t2
nes_sprite_cache_row:
    lbu t3, 0(t0)
    sltiu v0, t3, 8
    bne v0, zero, nes_sprite_cache_append
    daddu v0, t1, t3
    b nes_sprite_cache_step
    sb t8, 0(t0)
nes_sprite_cache_append:
    sb a5, 0(v0)
    addiu t3, t3, 1
    sb t3, 0(t0)
nes_sprite_cache_step:
    addiu t0, t0, 1
    bne t0, t2, nes_sprite_cache_row
    addiu t1, t1, 8
nes_sprite_cache_advance:
    addiu a5, a5, 1
    sltiu t0, a5, 64
    bne t0, zero, nes_sprite_cache_next
    addiu a2, a2, 4
    la t0, global_oamcachedirty
    jr ra
    sd zero, 0(t0)
  EndASM
EndProcedure

ProcedureNaked NesDrawSpriteRow(bits.i, x.i, flags.i, spanFlags.i, clip.i, attr.i)
  ASM
    beq a0, zero, nes_emit_sprite_done
    andi a5, a5, 64
    beq a5, zero, nes_emit_sprite_setup
    andi t0, a0, 0x3333
    ; Reverse the eight two-bit pixels for horizontal flip.
    srl t1, a0, 2
    andi t1, t1, 0x3333
    sll t0, t0, 2
    or a0, t0, t1
    andi t0, a0, 0x0F0F
    srl t1, a0, 4
    andi t1, t1, 0x0F0F
    sll t0, t0, 4
    or a0, t0, t1
    srl t1, a0, 8
    sll a0, a0, 8
    andi a0, a0, 0xFFFF
    or a0, a0, t1
nes_emit_sprite_setup:
    la t0, global_spriteline
    daddu t0, t0, a1
    la t1, global_spritespan
    addiu t2, a1, 8
    sltiu t3, t2, 257
    bne t3, zero, nes_emit_sprite_pixel
    nop
    addiu t2, zero, 256
nes_emit_sprite_pixel:
    andi a6, a0, 3
    beq a6, zero, nes_emit_sprite_next
    srl a0, a0, 2
    sltu a7, a1, a4
    bne a7, zero, nes_emit_sprite_next
    or a6, a6, a2
    sb a6, 0(t0)
    srl a7, a1, 3
    daddu a7, a7, t1
    lbu a6, 0(a7)
    or a6, a6, a3
    sb a6, 0(a7)
nes_emit_sprite_next:
    addiu a1, a1, 1
    bne a1, t2, nes_emit_sprite_pixel
    addiu t0, t0, 1
nes_emit_sprite_done:
    jr ra
    nop
  EndASM
EndProcedure

ProcedureNaked NesOamRamDma(page.i)
  ; A whole RAM page to OAM address zero. The scanline cache depends only
  ; on the Y byte of each OAM entry. Keep it if those bytes still match.
  ASM
    andi a0, a0, 7
    sll a0, a0, 8
    la t0, global_m
    daddu t0, t0, a0
    la t1, global_oam
    addiu t2, t0, 256
    addiu t3, zero, 255
    dsll t3, t3, 24
    dsll32 a3, t3, 0
    or a3, a3, t3
    or a4, zero, zero
nes_oam_dma_word:
    ld a0, 0(t0)
    ld a1, 0(t1)
    xor a2, a1, a0
    or a4, a4, a2
    sd a0, 0(t1)
    addiu t0, t0, 8
    bne t0, t2, nes_oam_dma_word
    addiu t1, t1, 8
    and a4, a4, a3
    beq a4, zero, nes_oam_dma_done
    addiu a4, zero, 1
    la t0, global_oamcachedirty
    sd a4, 0(t0)
nes_oam_dma_done:
    jr ra
    nop
  EndASM
EndProcedure

ProcedureNaked PpuSpritesReference()
  ; Materialize the eight selected sprites for the current visible scanline.
  ASM
    la t0, global_oamcachedirty
    ld t1, 0(t0)
    bne t1, zero, nes_sprite_eval_rebuild
    nop
nes_sprite_eval_cached:
    la t0, global_ppuline
    ld a0, 0(t0)
    la t0, global_cachedcount
    addu t0, t0, a0
    lbu a1, 0(t0)
    la t0, global_sprcount
    bne a1, zero, nes_sprite_eval_count
    sd a1, 0(t0)
    j ppuclearsprites
    nop

nes_sprite_eval_rebuild:
    addiu sp, sp, -16
    sd ra, 8(sp)
    jal ppubuildspritecache
    nop
    ld ra, 8(sp)
    b nes_sprite_eval_cached
    addiu sp, sp, 16

nes_sprite_eval_count:
    la t1, global_ppumask
    ld a2, 0(t1)
    sltiu t1, a1, 9
    bne t1, zero, nes_sprite_eval_enter
    andi t1, a2, 24
    addiu a1, zero, 8
    beq t1, zero, nes_sprite_eval_enter
    sd a1, 0(t0)
    la t1, global_ppustatus
    ld t2, 0(t1)
    ori t2, t2, 32
    sd t2, 0(t1)

nes_sprite_eval_enter:
  EndASM
  CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
    ASM
      j nesmmc3drawsprites
      nop
    EndASM
  CompilerElse
  ASM
    addiu sp, sp, -56
    sd ra, 48(sp)
    sd s0, 40(sp)
    sd s1, 32(sp)
    sd s2, 24(sp)
    sd s3, 16(sp)
    sd s4, 8(sp)
    sd s5, 0(sp)
    or s0, a1, zero
    or s1, a2, zero
    sll t0, a0, 3
    la t1, global_cachedsprite
    addu a1, t1, t0
    la t1, global_ppuctrl
    ld a2, 0(t1)
    andi a3, a2, 32
    srl a3, a3, 2
    addiu a3, a3, 8
    andi a2, a2, 8
    sll a2, a2, 9
    la a4, global_oam
    la s2, global_sprindex
    la s3, global_sprx
    la s4, global_sprattr
    la s5, global_sprrow
    addu a5, a1, s0
    or a6, zero, zero
nes_sprite_eval_roster:
    lbu t0, 0(a1)
    sll t1, t0, 2
    addu t1, t1, a4
    lbu t2, 0(t1)
    lbu t3, 1(t1)
    lbu t8, 2(t1)
    lbu t9, 3(t1)
    subu t2, a0, t2
    addiu t2, t2, -1
    andi v0, t8, 128
    beq v0, zero, nes_sprite_eval_height
    addiu v0, a3, -1
    subu t2, v0, t2
nes_sprite_eval_height:
    addiu v0, zero, 16
    bne a3, v0, nes_sprite_eval_address
    or v1, a2, zero
    andi v1, t3, 1
    sll v1, v1, 12
    andi t3, t3, 254
    srl v0, t2, 3
    addu t3, t3, v0
    andi t2, t2, 7
nes_sprite_eval_address:
    sll t3, t3, 4
    sll t2, t2, 1
    addu t3, t3, v1
    addu t2, t2, t3
    addu v0, s2, a6
    sd t0, 0(v0)
    addu v0, s3, a6
    sd t9, 0(v0)
    addu v0, s4, a6
    sd t8, 0(v0)
    addu v0, s5, a6
    sd t2, 0(v0)
    addiu a1, a1, 1
    bne a1, a5, nes_sprite_eval_roster
    addiu a6, a6, 8

  EndASM
  CompilerIf #GAME_MAPPER=9
    ASM
      jal neslatchspriterows
      or a0, s0, zero
    EndASM
  CompilerEndIf
  ASM
    jal ppuclearsprites
    nop
    andi t0, s1, 16
    beq t0, zero, nes_sprite_eval_done
    andi t1, s1, 4
    sltiu s1, t1, 1
    sll s1, s1, 3
    sll s0, s0, 3
nes_sprite_eval_draw:
    addiu s0, s0, -8
    addu t0, s4, s0
    ld a5, 0(t0)
    addu t0, s2, s0
    ld t1, 0(t0)
    andi a2, a5, 3
    sll a2, a2, 2
    andi t0, a5, 32
    sll t0, t0, 1
    or a2, a2, t0
    ori a2, a2, 16
    bne t1, zero, nes_sprite_eval_draw_args
    addiu a3, zero, 1
    ori a2, a2, 128
    bne s0, zero, nes_sprite_eval_draw_args
    nop
    addiu a3, zero, 3
nes_sprite_eval_draw_args:
  EndASM
  CompilerIf #GAME_MAPPER=9
    ASM
      la t0, global_extraspritebits
      addu t0, t0, s0
      ld a0, 0(t0)
    EndASM
  CompilerElse
    ASM
      addu t0, s5, s0
      ld t1, 0(t0)
    EndASM
    CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
      ASM
        andi t0, t1, 0x1c00
        srl t0, t0, 7
        la t2, global_nesmmc3patternbias
        addu t0, t0, t2
        lw t0, 4(t0)
      EndASM
    CompilerElse
      ASM
        la t0, global_pattern
        lw t0, 4(t0)
      EndASM
    CompilerEndIf
    ASM
      addu t0, t0, t1
      lhu a0, 0(t0)
    EndASM
  CompilerEndIf
  ASM
    addu t0, s3, s0
    ld a1, 0(t0)
    jal nesdrawspriterow
    or a4, s1, zero
    bne s0, zero, nes_sprite_eval_draw
    nop
nes_sprite_eval_done:
    ld s5, 0(sp)
    ld s4, 8(sp)
    ld s3, 16(sp)
    ld s2, 24(sp)
    ld s1, 32(sp)
    ld s0, 40(sp)
    ld ra, 48(sp)
    jr ra
    addiu sp, sp, 56
  EndASM
  CompilerEndIf
EndProcedure

CompilerIf #NES_RUNTIME_ROM And #GAME_MAPPER=4
ProcedureNaked NesMmc3DrawSprites(line.i, count.i, mask.i)
  ; Roster order is priority order. Draw back to front and keep the first
  ; sprite's index and X for the guest status deadline.
  ASM
    sll t0, a0, 3
    la t1, global_cachedsprite
    addu t1, t1, t0
    lbu t0, 0(t1)
    la t2, global_sprindex
    sd t0, 0(t2)
    la a4, global_oam
    sll t0, t0, 2
    addu t0, t0, a4
    lbu t0, 3(t0)
    la t2, global_sprx
    sd t0, 0(t2)
    andi t0, a2, 16
    bnez t0, nes_mmc3_sprite_draw_setup
    nop
    j ppuclearsprites
    nop

nes_mmc3_sprite_draw_setup:
    addiu sp, sp, -64
    sd ra, 56(sp)
    sd s6, 48(sp)
    sd s5, 40(sp)
    sd s4, 32(sp)
    sd s3, 24(sp)
    sd s2, 16(sp)
    sd s1, 8(sp)
    sd s0, 0(sp)
    addu s0, t1, a1
    or s1, t1, zero
    addiu s2, a0, -1
    la t0, global_ppuctrl
    ld s3, 0(t0)
    or s4, a4, zero
    andi t0, a2, 4
    sltiu s5, t0, 1
    sll s5, s5, 3
    la s6, global_nesmmc3patternbias
    jal ppuclearsprites
    nop

nes_mmc3_sprite_draw:
    addiu s0, s0, -1
    lbu v0, 0(s0)
    sll t0, v0, 2
    addu t0, t0, s4
    lwu t3, 0(t0)
    andi t1, s3, 32
    srl t1, t1, 2
    addiu t1, t1, 7
    srl t2, t3, 24
    subu t2, s2, t2
    srl a5, t3, 8
    andi a5, a5, 255
    srl t8, t3, 16
    andi t8, t8, 255
    andi t0, a5, 128
    beqz t0, nes_mmc3_sprite_draw_vflip
    andi a1, t3, 255
    subu t2, t1, t2
nes_mmc3_sprite_draw_vflip:
    andi t3, s3, 8
    sltiu t0, t1, 8
    bnez t0, nes_mmc3_sprite_draw_row
    sll t3, t3, 9
    andi t3, t8, 1
    sll t3, t3, 12
    andi t8, t8, 254
    srl t0, t2, 3
    addu t8, t8, t0
    andi t2, t2, 7
nes_mmc3_sprite_draw_row:
    sll t8, t8, 4
    sll t2, t2, 1
    addu t8, t8, t3
    addu t2, t2, t8
    andi t0, t2, 0x1c00
    srl t0, t0, 7
    addu t0, t0, s6
    lw t0, 4(t0)
    addu t0, t0, t2
    lhu a0, 0(t0)
    andi a2, a5, 3
    sll a2, a2, 2
    andi t0, a5, 32
    sll t0, t0, 1
    or a2, a2, t0
    ori a2, a2, 16
    bnez v0, nes_mmc3_sprite_emit
    addiu a3, zero, 1
    ori a2, a2, 128
    addiu a3, zero, 3
nes_mmc3_sprite_emit:
    jal nesdrawspriterow
    or a4, s5, zero
    bne s0, s1, nes_mmc3_sprite_draw
    nop
    ld s0, 0(sp)
    ld s1, 8(sp)
    ld s2, 16(sp)
    ld s3, 24(sp)
    ld s4, 32(sp)
    ld s5, 40(sp)
    ld s6, 48(sp)
    ld ra, 56(sp)
    jr ra
    addiu sp, sp, 64
  EndASM
EndProcedure
CompilerEndIf
