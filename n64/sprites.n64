ProcedureNaked PpuBuildSpriteCache()
  ; Keep eight OAM indices and an overflow marker per visible scanline.
  ASM
    la a0, global_cachedcount
    la a1, global_cachedsprite
    la a2, global_oam
    la t0, global_ppuctrl
    ld a3, 0(t0)
    andi a3, a3, 32
    srl a3, a3, 2
    addiu a3, a3, 8
    or t0, a0, zero
    addiu t1, a0, 256
nes_sprite_cache_clear:
    sd zero, 0(t0)
    sd zero, 8(t0)
    sd zero, 16(t0)
    sd zero, 24(t0)
    addiu t0, t0, 32
    bne t0, t1, nes_sprite_cache_clear
    nop
    or a5, zero, zero
    addiu t8, zero, 9
nes_sprite_cache_next:
    lbu t0, 0(a2)
    addiu t0, t0, 1
    sltiu t1, t0, 240
    beq t1, zero, nes_sprite_cache_advance
    addu t2, t0, a3
    sltiu t1, t2, 241
    bne t1, zero, nes_sprite_cache_range
    nop
    addiu t2, zero, 240
nes_sprite_cache_range:
    sll t1, t0, 3
    daddu t1, a1, t1
    daddu t0, a0, t0
    daddu t2, a0, t2
nes_sprite_cache_row:
    lbu t3, 0(t0)
    sltiu v0, t3, 8
    bne v0, zero, nes_sprite_cache_append
    daddu v0, t1, t3
    b nes_sprite_cache_step
    sb t8, 0(t0)
nes_sprite_cache_append:
    sb a5, 0(v0)
    addiu t3, t3, 1
    sb t3, 0(t0)
nes_sprite_cache_step:
    addiu t0, t0, 1
    bne t0, t2, nes_sprite_cache_row
    addiu t1, t1, 8
nes_sprite_cache_advance:
    addiu a5, a5, 1
    sltiu t0, a5, 64
    bne t0, zero, nes_sprite_cache_next
    addiu a2, a2, 4
    la t0, global_oamcachedirty
    jr ra
    sd zero, 0(t0)
  EndASM
EndProcedure

ProcedureNaked NesDrawSpriteRow(bits.i, x.i, flags.i, spanFlags.i, clip.i, attr.i)
  ASM
    beq a0, zero, nes_emit_sprite_done
    andi a5, a5, 64
    beq a5, zero, nes_emit_sprite_setup
    andi t0, a0, 0x3333
    ; Reverse the eight two-bit pixels for horizontal flip.
    srl t1, a0, 2
    andi t1, t1, 0x3333
    sll t0, t0, 2
    or a0, t0, t1
    andi t0, a0, 0x0F0F
    srl t1, a0, 4
    andi t1, t1, 0x0F0F
    sll t0, t0, 4
    or a0, t0, t1
    srl t1, a0, 8
    sll a0, a0, 8
    andi a0, a0, 0xFFFF
    or a0, a0, t1
nes_emit_sprite_setup:
    la t0, global_spriteline
    daddu t0, t0, a1
    la t1, global_spritespan
    addiu t2, a1, 8
    sltiu t3, t2, 257
    bne t3, zero, nes_emit_sprite_pixel
    nop
    addiu t2, zero, 256
nes_emit_sprite_pixel:
    andi a6, a0, 3
    beq a6, zero, nes_emit_sprite_next
    srl a0, a0, 2
    sltu a7, a1, a4
    bne a7, zero, nes_emit_sprite_next
    or a6, a6, a2
    sb a6, 0(t0)
    srl a7, a1, 3
    daddu a7, a7, t1
    lbu a6, 0(a7)
    or a6, a6, a3
    sb a6, 0(a7)
nes_emit_sprite_next:
    addiu a1, a1, 1
    bne a1, t2, nes_emit_sprite_pixel
    addiu t0, t0, 1
nes_emit_sprite_done:
    jr ra
    nop
  EndASM
EndProcedure

ProcedureNaked NesOamRamDma(page.i)
  ; A whole RAM page to OAM address zero. The scanline cache depends only
  ; on the Y byte of each OAM entry. Keep it if those bytes still match.
  ASM
    andi a0, a0, 7
    sll a0, a0, 8
    la t0, global_m
    daddu t0, t0, a0
    la t1, global_oam
    addiu t2, t0, 256
    addiu t3, zero, 255
    dsll t3, t3, 24
    dsll32 a3, t3, 0
    or a3, a3, t3
    or a4, zero, zero
nes_oam_dma_word:
    ld a0, 0(t0)
    ld a1, 0(t1)
    xor a2, a1, a0
    or a4, a4, a2
    sd a0, 0(t1)
    addiu t0, t0, 8
    bne t0, t2, nes_oam_dma_word
    addiu t1, t1, 8
    and a4, a4, a3
    beq a4, zero, nes_oam_dma_done
    addiu a4, zero, 1
    la t0, global_oamcachedirty
    sd a4, 0(t0)
nes_oam_dma_done:
    jr ra
    nop
  EndASM
EndProcedure
