; Convert Anvil's RGB565 table to the RGBA5551 used by the RDP TLUT.
ProcedureNaked PpuColours()
  ASM
    la t0, global_ppumask
    ld t0, 0(t0)
    la a0, global_pal
    la a1, global_rgbpal
    la a2, global_rgb64
    srl t1, t0, 5
    sll t1, t1, 7
    daddu a2, a2, t1
    andi t0, t0, 1
    beqz t0, nes_ppu_colour_backdrop
    addiu a3, zero, 63
    addiu a3, zero, 48
nes_ppu_colour_backdrop:
    lbu a4, 0(a0)
    move a5, zero
    move a6, zero
    addiu a7, zero, 32
nes_ppu_colour_entry:
    andi t0, a5, 3
    beqz t0, nes_ppu_colour_alias
    daddu t1, a0, a5
    lbu t0, 0(t1)
    b nes_ppu_colour_lookup
    nop
nes_ppu_colour_alias:
    ; Entries 4 / 8 / 12 / 16 alias byte 0: a rendered pixel of colour 0 is the backdrop, whatever its sub-palette.
    ; Entries 20 / 24 / 28 (sprite colour 0: never drawn) are the MIRRORS' bytes $04 / $08 / $0C, as the palette
    ; RAM reads at $3F14 / $18 / $1C: the old renderer shows a rendering-off line whose v addresses $3F04 / $08 /
    ; $0C (or their mirrors) through them (N.79 item 2, nes_span_off in ppu.n64).
    sltiu t0, a5, 17
    bnez t0, nes_ppu_colour_zero
    nop
    lbu t0, -16(t1)                 ; Pal(entry - 16)
    b nes_ppu_colour_lookup
    nop
nes_ppu_colour_zero:
    move t0, a4
nes_ppu_colour_lookup:
    and t0, t0, a3
    sll t0, t0, 1
    daddu t0, a2, t0
    lhu t0, 0(t0)
    lhu t2, 0(a1)
    andi t1, t0, 31
    andi t0, t0, 0xFFC0
    sll t1, t1, 1
    or t0, t0, t1
    ori t0, t0, 1
    xor t2, t2, t0
    or a6, a6, t2
    sh t0, 0(a1)
    addiu a5, a5, 1
    bne a5, a7, nes_ppu_colour_entry
    addiu a1, a1, 2
    beqz a6, nes_ppu_colour_done
    nop
    la t0, global_rgbpairsdirty
    addiu t1, zero, 1
    sd t1, 0(t0)
nes_ppu_colour_done:
    jr ra
    nop
  EndASM
EndProcedure

ProcedureNaked NesWritePalette(index.i,value.i)
  ASM
    la t0, global_pal
    daddu t0, t0, a0
    lbu t1, 0(t0)
    beq t1, a1, nes_ppu_palette_done
    andi t1, a0, 3
    sb a1, 0(t0)
    beqz a0, nes_ppu_palette_lookup
    nop
    bnez t1, nes_ppu_palette_lookup ; a colour 1-3: its own entry
    nop
    sltiu t1, a0, 16
    beqz t1, nes_ppu_palette_done   ; (the write handler folds $10 / $14 / $18 / $1C to $00 / $04 / $08 / $0C)
    nop
    addiu a0, a0, 16                ; byte $04 / $08 / $0C: entry 20 / 24 / 28, the mirror's colour (PpuColours)
nes_ppu_palette_lookup:
    la t0, global_ppumask
    ld t0, 0(t0)
    andi t1, t0, 1
    beqz t1, nes_ppu_palette_normal
    srl t0, t0, 5
    andi a1, a1, 48
nes_ppu_palette_normal:
    sll t0, t0, 6
    addu t0, t0, a1
    sll t0, t0, 1
    la t1, global_rgb64
    daddu t0, t0, t1
    lhu t0, 0(t0)
    andi t1, t0, 31
    andi t0, t0, 0xFFC0
    sll t1, t1, 1
    or t0, t0, t1
    ori t0, t0, 1
    la t1, global_rgbpal
    sll t2, a0, 1
    daddu t1, t1, t2
    lhu t2, 0(t1)
    beq t0, t2, nes_ppu_palette_done
    nop
    bnez a0, nes_ppu_palette_dirty
    sh t0, 0(t1)
    sh t0, 8(t1)                    ; byte 0's aliases: entries 4, 8, 12, 16 (20 / 24 / 28 are the mirrors' own)
    sh t0, 16(t1)
    sh t0, 24(t1)
    sh t0, 32(t1)
nes_ppu_palette_dirty:
    la t0, global_rgbpairsdirty
    addiu t1, zero, 1
    sd t1, 0(t0)
nes_ppu_palette_done:
    jr ra
    nop
  EndASM
EndProcedure
