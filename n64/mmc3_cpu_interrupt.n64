; IRQ and NMI enter between CPU run windows. The MMC3 vector read is
; ordinary PRG ROM in the uppermost bank and leaves the high byte on the bus.
ProcedureNaked.i CpuInterrupt(vector.i)
  ASM
    la t0, global_pc
    ld t1, global_stopped-global_pc(t0)
    bnez t1, nes_mmc3_interrupt_ignored
    ori t1, zero, 0xFFFA
    beq a0, t1, nes_mmc3_interrupt_push
    ori t1, zero, 0xFFFE
    bne a0, t1, nes_mmc3_interrupt_ignored
    ld t1, global_fi-global_pc(t0)
    bnez t1, nes_mmc3_interrupt_ignored
    nop
nes_mmc3_interrupt_push:
    ld t1, global_s-global_pc(t0)
    la t2, global_m
    ld t3, 0(t0)
    addu a1, t2, t1
    dsrl a2, t3, 8
    sb a2, 256(a1)
    addiu t1, t1, -1
    andi t1, t1, 0xFF
    addu a1, t2, t1
    sb t3, 256(a1)
    addiu t1, t1, -1
    andi t1, t1, 0xFF
    addu t2, t2, t1

    ld a1, global_fn-global_pc(t0)
    ld a2, global_fv-global_pc(t0)
    ld a3, global_fd-global_pc(t0)
    ld t3, global_fi-global_pc(t0)
    andi a1, a1, 0x80
    andi a2, a2, 0x80
    dsll a3, a3, 3
    srl a2, a2, 1
    dsll t3, t3, 2
    or a1, a1, a2
    or a3, a3, t3
    ld t3, global_fc-global_pc(t0)
    ld a2, global_fz-global_pc(t0)
    dsrl t3, t3, 8
    andi t3, t3, 1
    andi a2, a2, 0xFF
    sltiu a2, a2, 1
    sll a2, a2, 1
    or a1, a1, a3
    or a2, a2, t3
    or a1, a1, a2
    ori a1, a1, 0x20
    sb a1, 256(t2)
    sd a1, global_tmp-global_pc(t0)
    addiu t1, t1, -1
    andi t1, t1, 0xFF
    sd t1, global_s-global_pc(t0)
    daddiu t1, zero, 1
    sd t1, global_fi-global_pc(t0)

    la t2, global_nesmmc3bias
    ld t2, 24(t2)
    addu t2, t2, a0
    lbu t1, 0(t2)
    lbu t2, 1(t2)
    ld t3, global_cpucycles-global_pc(t0)
    sd t2, global_nesopenbus-global_pc(t0)
    sll t2, t2, 8
    or t1, t1, t2
    sd t1, 0(t0)
    daddiu t3, t3, 7
    sd t3, global_cpucycles-global_pc(t0)
    ld t1, global_left-global_pc(t0)
    daddiu t1, t1, -7
    daddiu a0, zero, 1
    jr ra
    sd t1, global_left-global_pc(t0)
nes_mmc3_interrupt_ignored:
    jr ra
    move a0, zero
  EndASM
EndProcedure
