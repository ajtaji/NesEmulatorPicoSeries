; unit/advance.n64 - the time advance: CPU time, the worker catch-up, the A12 deadline, the APU sync, the IRQ counter
; Part of the hot unit: included inside cpu6502.n64's procedure (the shipped build) or a
; holder procedure in mmc3_run.n64 (the reference build), never on its own. Entry labels
; are u_<procedure>; the procedure of the same name is a one-jump stub for outside callers.
; Moved unchanged from the file named above each part (design note, section N, step N1).

; ---- nesmmc3advancecputime, from mmc3_raster.n64 ----
  ASM
u_nesmmc3advancecputime:
    la a1, global_nesmmc3apuclock
    ld t0, global_nesmmc3renderlimit-global_nesmmc3apuclock(a1)
    bltz t0, mmc3_cpu_render_limit
    nop
mmc3_cpu_render_ready:
    slt t1, t0, a0
    bnez t1, mmc3_cpu_full_sync
    ld t0, global_workerclock-global_nesmmc3apuclock(a1)
    slt t1, a0, t0
    bnez t1, mmc3_cpu_full_sync
    daddiu t1, zero, -1
    sd t1, global_nesstatushorizon-global_nesmmc3apuclock(a1)
    sd t1, global_nescpuhorizon-global_nesmmc3apuclock(a1)
    ld t0, global_nesmmc3apulimit-global_nesmmc3apuclock(a1)
    bltz t0, mmc3_cpu_apu_limit
    nop
mmc3_cpu_apu_ready:
    slt t1, a0, t0
    beqz t1, mmc3_cpu_slow
    addiu a2, zero, 1

    ; With IRQs disabled, leave the fetch clock to the next bus sync.
    ld t0, global_mapirqenable-global_nesmmc3apuclock(a1)
    beqz t0, mmc3_cpu_done
    ld t0, global_nesmmc3fetchlimit-global_nesmmc3apuclock(a1)
    bltz t0, mmc3_cpu_slow
    move a2, zero
    slt t1, a0, t0
    beqz t1, mmc3_cpu_slow
    nop
mmc3_cpu_done:
    jr ra
    sd a0, global_workerclock-global_nesmmc3apuclock(a1)
mmc3_cpu_full_sync:
    j u_workeradvance
    nop

mmc3_cpu_render_limit:
    ld t1, global_ppuline-global_nesmmc3apuclock(a1)
    ld t2, global_ppudot-global_nesmmc3apuclock(a1)
    ; CPU-visible bus operations synchronize separately. Otherwise flush
    ; at line 224 for controller service, 240, vblank, or frame handoff.
    sltiu t0, t1, 224
    bnez t0, mmc3_cpu_render_visible
    addiu t0, zero, 224
    sltiu t0, t1, 240
    bnez t0, mmc3_cpu_render_visible
    addiu t0, zero, 240
    beq t1, t0, mmc3_cpu_render_vblank
    addiu t0, zero, 241
    bne t1, t0, mmc3_cpu_render_frame
    nop
    beqz t2, mmc3_cpu_render_vblank
    nop
mmc3_cpu_render_frame:
    addiu t0, zero, 262
    b mmc3_cpu_render_distance
    addiu t2, t2, 2
mmc3_cpu_render_visible:
    addiu t2, t2, 1
mmc3_cpu_render_vblank:
mmc3_cpu_render_distance:
    subu t0, t0, t1
    addiu t3, zero, 341
    multu t0, t3
    lui t3, 0x5555
    ori t3, t3, 0x5556
    ld t1, global_ppuclock-global_nesmmc3apuclock(a1)
    mflo t0
    subu t0, t0, t2
    ; Signed divide by three, rounding toward zero at the odd-frame edge.
    mult t0, t3
    sra t2, t0, 31
    mfhi t0
    subu t0, t0, t2
    daddu t0, t1, t0
    b mmc3_cpu_render_ready
    sd t0, global_nesmmc3renderlimit-global_nesmmc3apuclock(a1)

mmc3_cpu_apu_limit:
    ld t1, global_dmcbytes-global_nesmmc3apuclock(a1)
    bgtz t1, mmc3_cpu_apu_dmc       ; a sample plays: its next fetch (apu_cold.n64, design note N.26d)
    ld t1, global_apuinhibit-global_nesmmc3apuclock(a1)
    ld t2, global_apufive-global_nesmmc3apuclock(a1)
    or t1, t1, t2
    bnez t1, mmc3_cpu_apu_never
    ld t1, global_apuresetdelay-global_nesmmc3apuclock(a1)
    bgtz t1, mmc3_cpu_apu_at_stamp
    ld t0, 0(a1)
    ld t1, global_apustep4-global_nesmmc3apuclock(a1)
    ld t2, global_apuframeclock-global_nesmmc3apuclock(a1)
    daddu t0, t0, t1
    dsubu t0, t0, t2
    b mmc3_cpu_apu_ready
    sd t0, global_nesmmc3apulimit-global_nesmmc3apuclock(a1)
mmc3_cpu_apu_never:
    daddiu t0, zero, -1
    dsrl t0, t0, 1
    b mmc3_cpu_apu_ready
    sd t0, global_nesmmc3apulimit-global_nesmmc3apuclock(a1)
mmc3_cpu_apu_at_stamp:
    move t0, a0
    b mmc3_cpu_apu_ready
    sd t0, global_nesmmc3apulimit-global_nesmmc3apuclock(a1)

mmc3_cpu_slow:
    ; Only a call to an observable device or deadline calculation needs
    ; a frame. a2 records whether the APU has reached its deadline.
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    move s0, a0
    beqz a2, mmc3_cpu_fetch_limit
    move s1, a1
    ld t0, 0(s1)
    dsubu a0, s0, t0
    blez a0, mmc3_cpu_apu_synced
    nop
    jal u_apuadvance              ; the APU timing (unit/apu.n64, design note N.25)
    nop
    sd s0, 0(s1)
mmc3_cpu_apu_synced:
    daddiu t1, zero, -1
    sd t1, global_nesmmc3apulimit-global_nesmmc3apuclock(s1)
    ld t0, global_mapirqenable-global_nesmmc3apuclock(s1)
    beqz t0, mmc3_cpu_slow_done
    nop
mmc3_cpu_fetch_limit:
    ld a0, global_nesmmc3fetchlimit-global_nesmmc3apuclock(s1)
    bgez a0, mmc3_cpu_fetch_ready
    nop
    jal u_nesmmc3fetchdeadline
    nop
    sd a0, global_nesmmc3fetchlimit-global_nesmmc3apuclock(s1)
mmc3_cpu_fetch_ready:
    slt t0, s0, a0
    bnez t0, mmc3_cpu_slow_done
    ld t0, global_nesmmc3fetchclock-global_nesmmc3apuclock(s1)
    dsubu a0, s0, t0
    blez a0, mmc3_cpu_fetch_synced
    nop
    jal u_mapperpputicks
    nop
    sd s0, global_nesmmc3fetchclock-global_nesmmc3apuclock(s1)
mmc3_cpu_fetch_synced:
    daddiu t1, zero, -1
    sd t1, global_nesmmc3fetchlimit-global_nesmmc3apuclock(s1)
mmc3_cpu_slow_done:
    sd s0, global_workerclock-global_nesmmc3apuclock(s1)
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    jr ra
    daddiu sp, sp, 32
  EndASM

; ---- workeradvance, from mmc3_raster.n64 ----
  ASM
u_workeradvance:
    la a1, global_nesmmc3apuclock
    ld t0, global_workerclock-global_nesmmc3apuclock(a1)
    slt t0, a0, t0
    bnez t0, mmc3_worker_backwards
    nop
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    move s0, a0
    move s1, a1

    ; This synchronization revokes the existing proofs before any callback.
    daddiu t1, zero, -1
    sd t1, global_nesstatushorizon-global_nesmmc3apuclock(s1)
    sd t1, global_nescpuhorizon-global_nesmmc3apuclock(s1)
    ld t0, 0(s1)
    dsubu a0, s0, t0
    blez a0, mmc3_worker_fetch
    nop
    jal u_apuadvance              ; the APU timing (unit/apu.n64, design note N.25)
    nop
    sd s0, 0(s1)
mmc3_worker_fetch:
    ld t0, global_nesmmc3fetchclock-global_nesmmc3apuclock(s1)
    dsubu a0, s0, t0
    blez a0, mmc3_worker_render
    nop
    jal u_mapperpputicks
    nop
    sd s0, global_nesmmc3fetchclock-global_nesmmc3apuclock(s1)
mmc3_worker_render:
    ; A following bus access may change the next APU or mapper deadline.
    daddiu t1, zero, -1
    sd t1, global_nesmmc3apulimit-global_nesmmc3apuclock(s1)
    sd t1, global_nesmmc3fetchlimit-global_nesmmc3apuclock(s1)
    sd s0, global_workerclock-global_nesmmc3apuclock(s1)
    ld t0, global_ppuclock-global_nesmmc3apuclock(s1)
    dsubu a0, s0, t0
    blez a0, mmc3_worker_done
    nop
    jal u_ppuadvance              ; the PPU state machine (unit/ppu.n64), no compiled wrapper
    sd s0, global_nespputo-global_nesmmc3apuclock(s1)   ; (delay slot) NesPpuTo: the advance's stamp (the NMI edge, N.77)
    sd s0, global_ppuclock-global_nesmmc3apuclock(s1)
    ld t0, global_workerframes-global_nesmmc3apuclock(s1)
    ld t1, global_nesnmidueframe-global_nesmmc3apuclock(s1)
    daddiu t0, t0, 1
    bne t0, t1, mmc3_worker_nmidue ; a frame not yet predicted: NesNmiDue once a frame (unit/ppu_cold.n64, N.77)
    nop
mmc3_worker_nmidue_back:
    daddiu t1, zero, -1
    sd t1, global_nesmmc3renderlimit-global_nesmmc3apuclock(s1)
mmc3_worker_done:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    jr ra
    daddiu sp, sp, 32
    ; (mmc3_worker_backwards, the "backwards" stop, WorkerError 20: in unit/cold.n64 since the mapper slot's step 1)
  EndASM


; ---- nesmmc3syncapu, from mmc3_raster.n64 ----
  ASM
u_nesmmc3syncapu:
    daddiu sp, sp, -32
    sd ra, 0(sp)
    jal u_nesmmc3advancecputime
    sd a0, 8(sp)
    la t0, global_nesmmc3apuclock
    ld t1, 8(sp)
    ld t2, 0(t0)
    dsubu a0, t1, t2
    blez a0, mmc3_register_apu_synced
    nop
    jal u_apuadvance              ; the APU timing (unit/apu.n64, design note N.25)
    nop
    la t0, global_nesmmc3apuclock
    ld t1, 8(sp)
    sd t1, 0(t0)
mmc3_register_apu_synced:
    ; An APU register write can move the next DMA or IRQ deadline.
    daddiu t1, zero, -1
    sd t1, global_nesmmc3apulimit-global_nesmmc3apuclock(t0)
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 32
  EndASM

