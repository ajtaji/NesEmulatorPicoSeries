; unit/window.n64 - the window code: the MMC3 wait look-up, the CPU budget, the sign / charge / commit waits
; Part of the hot unit: included inside cpu6502.n64's procedure (the shipped build) or a
; holder procedure in mmc3_run.n64 (the reference build), never on its own. Entry labels
; are u_<procedure>; the procedure of the same name is a one-jump stub for outside callers.
; Moved unchanged from the file named above each part (design note, section N, step N1).

; ---- nesramcpuwindow, from library/wait.n64 ----
  ; C3 (design note N.46): the look-up is the leaf u_nesramwaitrule, shared by this window's start and by the
  ; core's in-place window end (cpu6502.n64, c65_wend), so both decide a window's RAM-wait batch by one rule.
  ;   NesRamCpuWindow(n, coalesce): rule = NesRamWaitRule-of-the-window(n) : If rule : batch : Else : CpuRun(n)
  ASM
u_nesramcpuwindow:           ; a0 = n, a1 = coalesce (0 from the MMC3 run loop)
    move a5, ra
    jal u_nesramwaitrule     ; a2 = the rule, 0: none (keeps a0, a1, a5)
    nop
    beqz a2, nes_mmc3_wait_scalar
    move ra, a5
    j nesmmc3ramwaitbatch
    nop
nes_mmc3_wait_scalar:
    j cpurun
    nop

  ; u_nesramwaitrule - a leaf: a2 = the RAM-wait rule of a window of a0 cycles starting at PC (0: none, the core
  ; runs it): none for a0 <= 0, Stopped, NesStall, the idle batching off or PC below $8000; else the immutable
  ; index (a byte a PRG address: 0 none, 255 the hashed cache, else a slot of the bank's rules). Keeps a0, a1,
  ; a5; clobbers t0-t3, a3.
  ; C5 (design note N.47a): the index byte is read only when PC's 256-byte page holds a nonzero one. Word 0 of the
  ; bank's rule block (never a rule: slots start at 1) has bit p set when page p of the bank does (written by
  ; NesRuntimeIndexMmc3Waits, library/wait.n64). A page with the bit clear has only 0 bytes, so the result is the
  ; same; the byte's D-miss, ~44 cycles at most window ends, and the guest code line its fill evicted, are gone.
  ; THE PLAIN TWIN of the indexed part:
  ;   block = NesMmc3WaitRules + bank * 1024
  ;   If PeekL(block) >> ((PC >> 8) & 31) & 1 = 0 : rule = 0 : ProcedureReturn : EndIf
  ;   slot = PeekA(NesMmc3WaitIndex + bank * 8192 + (PC & 8191))
  ;   If slot = 0 : rule = 0 : ElseIf slot = 255 : (the hashed cache) : Else : rule = PeekL(block + slot * 4) : EndIf
u_nesramwaitrule:
    blez a0, nes_mmc3_wait_none
    nop
    la t2, global_pc
    ld t1, global_stopped-global_pc(t2)
    ld t0, global_nesstall-global_pc(t2)
    or t1, t1, t0
    bnez t1, nes_mmc3_wait_none
    ld t1, global_nesidleenabled-global_pc(t2)
    beqz t1, nes_mmc3_wait_none
    ld t0, 0(t2)
    andi t1, t0, 0x8000
    beqz t1, nes_mmc3_wait_none
    andi t1, t0, 0x6000
    srl t1, t1, 10
    daddiu t1, t1, global_mapprgslots-global_pc
    addu t1, t1, t2
    lw t1, 4(t1)                ; t1 = PC's bank (kept for the hashed cache, with t0 = PC)
    daddiu t2, t2, global_nesmmc3waitindex-global_pc
    ld t3, 0(t2)                ; the index (0: not built, the hashed cache answers)
    ld a3, global_nesmmc3waitrules-global_nesmmc3waitindex(t2)
    beqz t3, nes_mmc3_wait_cache_lookup
    sll a2, t1, 10
    daddu a3, a3, a2            ; a3 = the bank's rule block; its word 0 = the page bits
    lw t2, 0(a3)
    srl a2, t0, 8
    srlv t2, t2, a2             ; bit (PC >> 8) & 31 (srlv takes the shift's low five bits)
    andi t2, t2, 1
    beqz t2, nes_mmc3_wait_none ; no rule in PC's page: no index byte read
    sll a2, t1, 13
    daddu t3, t3, a2
    andi a2, t0, 8191
    daddu t3, t3, a2
    lbu a2, 0(t3)
    beqz a2, nes_mmc3_wait_none
    addiu t3, zero, 255
    beq a2, t3, nes_mmc3_wait_cache_lookup  ; the hashed cache (cold part, unit/cold.n64: 0 cycles in SMB3)
    sll a2, a2, 2
    daddu a3, a3, a2
    jr ra
    lw a2, 0(a3)
nes_mmc3_wait_none:
    jr ra
    move a2, zero
  EndASM


; ---- u_nmicap: the window's budget capped where the NMI is due (design note N.77) ----
  ; WHAT: a0 = Min(a0, NesNmiDue - (CpuCycles + NesStall)), at least 1: the window (which opens after the stall) ends
  ; at the first instruction boundary at or after NesNmiDue, where the NMI is taken (the edge detected by the end of
  ; that instruction's penultimate cycle, R5). WHY HERE: every module's budget goes through it (the run loop and the
  ; in-place window end), so no module carries the NMI rule. A leaf; clobbers t0, t1, a7 (both callers reload the core's registers after the budget: c65_in);
  ; keeps a1-a6. NesNmiDue is read at its offset from CpuCycles (both nes.n64 globals).
  ; THE PLAIN TWIN: d = NesNmiDue - CpuCycles - NesStall : If d < n : n = d : If n < 1 : n = 1 : EndIf : EndIf
  ASM
u_nmicap:
    la t0, global_cpucycles
    ld t1, 0(t0)
    ld a7, global_nesstall-global_cpucycles(t0)
    ld t0, global_nesnmidue-global_cpucycles(t0)
    daddu t1, t1, a7                ; the window's start
    dsubu t0, t0, t1                ; the cycles to the due (the largest cycle: never below a0)
    slt t1, t0, a0
    beqz t1, nmicap_done
    nop
    blez t0, nmicap_one
    nop
    jr ra
    move a0, t0
nmicap_one:
    jr ra
    addiu a0, zero, 1
nmicap_done:
    jr ra
    nop
  EndASM

; ---- nesmmc3maskedbudget, from mmc3_budget.n64 ----
  ; An asserted IRQ stays masked until CLI/PLP/RTI. Stop at DMC DMA,
  ; NMI, or the frame boundary even while the IRQ is masked.
  ASM
u_nesmmc3maskedbudget:
    la a1, global_dmcbytes
    ld t0, 0(a1)
    blez t0, mmc3_masked_raster
    addiu a0, zero, 128
    ld t0, global_dmcempty-global_dmcbytes(a1)
    bnez t0, mmc3_masked_one
    nop
    la t0, global_apureg
    lbu t0, 16(t0)
    la t1, global_dmctable
    andi t0, t0, 15
    sll t0, t0, 1
    daddu t1, t1, t0
    lhu t1, 0(t1)
    ld t0, global_dmcbits-global_dmcbytes(a1)
    addiu t0, t0, -1
    mult t0, t1
    mflo t0
    ld t1, global_dmctimer-global_dmcbytes(a1)
    addu t0, t0, t1
    ; The distance is from NesMmc3ApuClock, which may lag WorkerClock while a sample plays
    ; (the DMC deadline, advance.n64 / design note N.26d); the old program measured it from
    ; the APU synced at WorkerClock, so the lag comes off.
    ld t1, global_workerclock-global_dmcbytes(a1)
    ld t2, global_nesmmc3apuclock-global_dmcbytes(a1)
    dsubu t1, t1, t2
    subu t0, t0, t1
    slt t1, t0, a0
    beqz t1, mmc3_masked_raster
    nop
    move a0, t0
mmc3_masked_raster:
    la t0, global_nesmmc3line
    ld t1, 0(t0)
    ld t2, global_nesmmc3dot-global_nesmmc3line(t0)
    addiu t0, zero, 241
    subu t0, t0, t1
    bltz t0, mmc3_masked_frame
    addiu t3, zero, 341
    mult t0, t3
    mflo t0
    subu t0, t0, t2
    addiu t0, t0, 1
    blez t0, mmc3_masked_frame      ; (unit/cold.n64 since the mapper slot's step 1: 0 cycles a guest frame; the
    nop                             ;  distance in frames to come, then back to mmc3_masked_distance)
mmc3_masked_distance:
    addiu t0, t0, 2
    slti t1, t0, 384
    beqz t1, mmc3_masked_limit
    nop
    slti t1, t0, 3
    bnez t1, mmc3_masked_one
    addiu t1, zero, 171
    multu t0, t1
    mflo t0
    srl t0, t0, 9
    slt t1, t0, a0
    beqz t1, mmc3_masked_limit
    nop
    move a0, t0
mmc3_masked_limit:
    blez a0, mmc3_masked_one
    nop
    jr ra
    nop
mmc3_masked_one:
    jr ra
    addiu a0, zero, 1
  EndASM

; ---- nesmmc3signwait, from mmc3_wait.n64 ----
  ASM
u_nesmmc3signwait:
    la a1, global_pc
    ld t0, 0(a1)
    srl a3, a2, 22
    andi a3, a3, 1
    srl t9, a2, 25
    andi t9, t9, 1
    addiu t9, t9, 3
    move a4, a0
    move a5, zero
    move a6, zero
    srl t1, a2, 26
    andi t1, t1, 1
    beqz t1, mmc3_sign_read
    nop
    ld t1, global_fn-global_pc(a1)
    srl t1, t1, 7
    andi t1, t1, 1
    bne t1, a3, mmc3_sign_scalar
    subu a4, a4, t9
    move a5, t9
    addiu a6, zero, 1
    blez a4, mmc3_sign_branch_entry
    addiu t0, t0, -2
mmc3_sign_read:
    andi t1, a2, 255
    la t2, global_m
    daddu t1, t1, t2
    lbu a7, 0(t1)
    srl t1, a7, 7
    bne t1, a3, mmc3_sign_scalar
    addiu a4, a4, -1
    addiu t1, zero, 3
    bne t9, t1, mmc3_sign_div_seven
    addiu t2, zero, 43
    multu a4, t2
    mflo t2
    b mmc3_sign_charge
    srl t2, t2, 8
    ; (mmc3_sign_div_seven, the seven-cycle charge's divide: 0 cycles a guest frame, in unit/cold.n64 since the
    ; mapper slot's step 1, design note "mapper modules" section 8; it branches back to mmc3_sign_charge)
mmc3_sign_charge:
    addiu t1, t9, 3
    multu t1, t2
    sd a7, global_a-global_pc(a1)
    sd a7, global_fn-global_pc(a1)
    sd a7, global_fz-global_pc(a1)
    mflo t1
    subu a4, a4, t1
    addu a5, a5, t1
    addiu a5, a5, 3
    sll t2, t2, 1
    addu a6, a6, t2
    addiu a6, a6, 1
    sltiu t1, a4, 3
    beqz t1, mmc3_sign_branch_end
    nop
    b mmc3_sign_commit
    addiu t0, t0, 2
mmc3_sign_branch_end:
    addu a5, a5, t9
    addiu a6, a6, 1
mmc3_sign_branch_entry:
    addiu a7, zero, 252
mmc3_sign_commit:
    sd t0, 0(a1)
    addiu t1, zero, 128
    beq a0, t1, mmc3_sign_coalesce  ; a full window: skip whole periods of like ones first (cold, N.46)
    sd a7, global_nesopenbus-global_pc(a1)
mmc3_sign_window:
    ld t0, global_cpucycles-global_pc(a1)
    sd t0, global_nesrunstart-global_pc(a1)
    daddu t0, t0, a5
    sd t0, global_cpucycles-global_pc(a1)
    sd a0, global_budget-global_pc(a1)
    dsubu t0, a0, a5
    sd t0, global_left-global_pc(a1)
    sd zero, global_cpuinwindow-global_pc(a1)
    ld t0, global_nesinstructions-global_pc(a1)
    ld t1, global_nesidlebatched-global_pc(a1)
    daddu t0, t0, a6
    daddu t1, t1, a6
    sd t0, global_nesinstructions-global_pc(a1)
    sd t1, global_nesidlebatched-global_pc(a1)
    jr ra
    move a0, a5
mmc3_sign_scalar:
    j cpurun
    nop
  EndASM
