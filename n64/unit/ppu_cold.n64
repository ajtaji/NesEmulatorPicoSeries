; unit/ppu_cold.n64 - the PPU state machine's rarely run paths, in the hot unit's cold part
; (design note, section N.3: the cold tail). Included after c65_fetch_slow in cpu6502.n64 (the
; shipped build) or in the reference build's holder. Every block is entered by a branch from
; unit/ppu.n64 and branches back to it; registers as described there. Moved here because each
; line runs well under 500 cycles a frame: the warm-up and PAL dot rate, the frame's band-log
; reset, sprite 0's row (only on lines that hold sprite 0), the sprite-0 span test (only until
; the flag rises), the band record (a few times a frame) and the $2007 read.
  ASM
ppu_adv_warmup:                     ; t0 = &PpuWarmup, t1 = its value (> 0), a0 = cycles
    dsubu t1, t1, a0
    bgez t1, ppu_adv_warm_store
    nop
    move t1, zero
ppu_adv_warm_store:
    b ppu_adv_save
    sd t1, 0(t0)
ppu_adv_fraction:                   ; PAL: pputakedots keeps the fractional dot clock
    jal pputakedots
    nop
    b ppu_adv_start
    move s0, a0
ppu_line_frame:                     ; line 0 opens a frame: clear its band log and split map
    daddiu t2, s6, #NES_U_SPLIT     ; (t1 = 1 is kept for the band open)
    sd zero, #NES_U_BANDCOUNT(s6)
    sd zero, #NES_U_BANDLOST(s6)
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      la t9, global_nesshowcur      ; the frame's OAM snapshots: the set of its frame parity (NesShowCur x 32; nes.n64,
      ld t9, 0(t9)                  ; NesOamSpace), so the frame before's queued jobs still find theirs (N.78)
      dsll t9, t9, 5
      sd t9, #NES_U_OAMSNAPS(s6)
    EndASM
  CompilerElse
    ASM
      sd zero, #NES_U_OAMSNAPS(s6)
    EndASM
  CompilerEndIf
  ASM
    sd zero, 0(t2)
    sd zero, 8(t2)
    sd zero, 16(t2)
    sd zero, 24(t2)
  EndASM
  CompilerIf #NES_TWIN_CHECK And #NES_RDP_SHOW=0
    ASM
      la t0, global_nessegbasep     ; N.60: the checking builds' segment pool from its start (they wait at line 240)
      ld t2, 0(t0)
      la t0, global_nessegnext
      sd t2, 0(t0)
      daddiu t2, t2, 6144                  ; #NES_SEG_POOL x #NES_SEG_BYTES
      la t0, global_nessegend
      sd t2, 0(t0)
    EndASM
  CompilerEndIf
  ASM
    b ppu_line_band_open
    nop

ppu_band_oam:
    ; A band opens: the OAM its lines' sprites are drawn from. The frame's last snapshot when OAM
    ; still equals it, else a new one (at most #NES_U_BANDMAX a frame; with none free the band
    ; gets index #NES_U_BANDMAX and its close counts it lost). In: s6 = NesUnitData. Out:
    ; U_BANDOAM. Clobbers t0-t3, t8, t9, v0, v1. OAM is 8-byte aligned (NesUnitPlace refuses
    ; a build where it is not).
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      ; N5: a band that will not be recorded (32 records used, or - below - no snapshot free) is drawn line by line
      ; by the old renderer (U_LIVEBAND: every line of it a fallback line); the close clears it.
      ld t0, #NES_U_BANDCOUNT(s6)
      sltiu t0, t0, #NES_U_BANDMAX
      xori t0, t0, 1
      sd t0, #NES_U_LIVEBAND(s6)
    EndASM
  CompilerEndIf
  ASM
    ld t0, #NES_U_OAMSNAPS(s6)
    la t1, global_nesoambase
    ld t1, 0(t1)                    ; t1 = the snapshots
    la t2, global_oam
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      la t9, global_nesshowcur      ; the set's first index (N.78): at it, none yet this frame
      ld t9, 0(t9)
      dsll t9, t9, 5
      beq t0, t9, ppu_oam_new
      dsll v0, t0, 8
    EndASM
  CompilerElse
    ASM
      beqz t0, ppu_oam_new          ; none yet this frame
      dsll v0, t0, 8
    EndASM
  CompilerEndIf
  ASM
    daddu v0, v0, t1
    daddiu v0, v0, -256             ; v0 = the last snapshot
    move v1, t2
    daddiu t8, t2, 256
ppu_oam_cmp:
    ld t3, 0(v1)
    ld t9, 0(v0)
    bne t3, t9, ppu_oam_new         ; OAM differs from it
    daddiu v1, v1, 8
    bne v1, t8, ppu_oam_cmp
    daddiu v0, v0, 8
    daddiu t0, t0, -1               ; the same: the band names the last snapshot
    jr ra
    sd t0, #NES_U_BANDOAM(s6)
ppu_oam_new:
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      la t3, global_nesshowcur      ; the set's #NES_U_BANDMAX snapshots (N.78)
      ld t3, 0(t3)
      dsll t3, t3, 5
      dsubu t3, t0, t3
      sltiu t3, t3, #NES_U_BANDMAX
    EndASM
  CompilerElse
    ASM
      sltiu t3, t0, #NES_U_BANDMAX
    EndASM
  CompilerEndIf
  ASM
    beqz t3, ppu_oam_none
    dsll v0, t0, 8
    daddu v0, v0, t1                ; the next free snapshot
    move v1, t2
    daddiu t8, t2, 256
ppu_oam_copy:
    ld t3, 0(v1)
    daddiu v1, v1, 8
    sd t3, 0(v0)
    bne v1, t8, ppu_oam_copy
    daddiu v0, v0, 8
    sd t0, #NES_U_BANDOAM(s6)
    daddiu t0, t0, 1
    jr ra
    sd t0, #NES_U_OAMSNAPS(s6)
ppu_oam_none:
    addiu t3, zero, #NES_U_OAMSNAPMAX   ; past both sets: no snapshot (the close counts the band lost)
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      addiu t0, zero, 1
      sd t0, #NES_U_LIVEBAND(s6)    ; N5: no snapshot: the band is drawn by the old renderer
    EndASM
  CompilerEndIf
  ASM
    jr ra
    sd t3, #NES_U_BANDOAM(s6)

ppu_line_oam:
    ; OAM was written since the last line began (OamCacheDirty). This line's sprites are the first
    ; drawn from the new OAM, so the band ends before it and the next one opens here - unless the
    ; band opened at this line, whose snapshot is already this OAM. Then the per-line lists are
    ; rebuilt, as the hot path did. Registers as at ppu_line_eval (u_ppuadvance's).
    ld t0, #NES_U_BANDFIRST(s6)
    beq t0, s1, ppu_line_oam_lists
    move v0, s6
    jal ppu_cut_close               ; the band ends before this line
    move t3, s1
    addiu t1, zero, 1
    sd t1, #NES_U_BANDOPEN(s6)      ; this line opens the next
    sd s1, #NES_U_BANDFIRST(s6)
    ld t0, global_ppuv-global_ppuline(s4)
    jal ppu_band_oam
    sd t0, #NES_U_BANDV(s6)
  EndASM
  CompilerIf #NES_PPU_CHECK
    ASM
      jal ppu_check_band
      move a0, zero                 ; a0 = 0: a band opens here
    EndASM
  CompilerEndIf
  ASM
ppu_line_oam_lists:
    jal ppubuildspritecache
    nop
    b ppu_line_cached
    nop
ppu_s0_row:
    ; Sprite 0's row on this line, as the renderer fetches it (NesMmc3DrawSprites).
    la t0, global_ppuctrl
    ld t0, 0(t0)
    andi t1, t0, 32
    srl t1, t1, 2
    addiu t1, t1, 7                 ; t1 = height - 1 (7 or 15, PPUCTRL bit 5)
    srl t2, t9, 24                  ; Y
    addiu t3, s1, -1
    subu t2, t3, t2                 ; t2 = the row in the sprite: line - 1 - Y
    srl v0, t9, 8
    andi v0, v0, 255                ; v0 = attributes
    srl v1, t9, 16
    andi v1, v1, 255                ; v1 = tile
    andi t3, v0, 128
    beqz t3, ppu_s0_flipped
    nop
    subu t2, t1, t2                 ; vertical flip
ppu_s0_flipped:
    andi t3, t0, 8
    sltiu t8, t1, 8
    bnez t8, ppu_s0_address         ; 8x8: the sprite table is PPUCTRL bit 3
    sll t3, t3, 9                   ; t3 = $1000 or 0 (both ways)
    andi t3, v1, 1                  ; 8x16: tile bit 0 selects the table
    sll t3, t3, 12
    andi v1, v1, 254
    srl t8, t2, 3
    addu v1, v1, t8                 ; rows 8-15 come from the next tile
    andi t2, t2, 7
ppu_s0_address:
    sll v1, v1, 4
    sll t2, t2, 1
    addu v1, v1, t3
    addu t2, t2, v1                 ; t2 = the row's PPU pattern address
    andi t8, t2, 0x1c00
    srl t8, t8, 7                   ; its 1 KB bank's entry in the MMC3 pattern bias table
    la t3, global_nesmmc3patternbias
    addu t8, t8, t3
    lw t8, 4(t8)
    addu t8, t8, t2
    lhu t8, 0(t8)                   ; the decoded row: pixel j in bits 2j+1:2j
    andi t3, v0, 64
    beqz t3, ppu_s0_opacity
    andi t0, t8, 0x3333
    srl t1, t8, 2                   ; horizontal flip: reverse the eight 2-bit pixels
    andi t1, t1, 0x3333             ; (swap pairs, then nibbles, then bytes)
    sll t0, t0, 2
    or t8, t0, t1
    andi t0, t8, 0x0F0F
    srl t1, t8, 4
    andi t1, t1, 0x0F0F
    sll t0, t0, 4
    or t8, t0, t1
    srl t1, t8, 8
    sll t8, t8, 8
    andi t8, t8, 0xFFFF
    or t8, t8, t1
ppu_s0_opacity:
    srl t0, t8, 1
    or t8, t8, t0
    andi t8, t8, 0x5555             ; bit 2j: pixel j opaque
    andi t0, t9, 255                ; t0 = X
    andi t1, a2, 4
    bnez t1, ppu_s0_right           ; the left column shows sprites
    sltiu t1, t0, 8
    beqz t1, ppu_s0_right
    addiu t1, zero, 8
    subu t1, t1, t0                 ; the 8 - X pixels left of x = 8 are clipped
    sll t1, t1, 1
    daddiu t2, zero, -1
    sllv t2, t2, t1
    and t8, t8, t2
ppu_s0_right:
    sltiu t1, t0, 248
    bnez t1, ppu_s0_store
    addiu t1, zero, 255
    subu t1, t1, t0                 ; only pixels left of x = 255 can raise the flag
    sll t1, t1, 1
    addiu t2, zero, 1
    sllv t2, t2, t1
    addiu t2, t2, -1
    and t8, t8, t2
ppu_s0_store:
    sd t8, #NES_U_S0ROW(s6)
    sd t0, #NES_U_S0X(s6)
    b ppu_line_sprites
    nop
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
ppu_live_empty:
      ; N5: a line with no sprite in a band that cannot be recorded - a fallback slot, the sprite row cleared.
      jal nesfbslot                 ; U_LIVE and NesLineRow (or no slot free: none) - clobbers t0-t3, v0
      nop
      ld t0, #NES_U_LIVE(s6)
      beqz t0, ppu_adv_draw
      nop
      jal ppuclearsprites
      nop
      b ppu_adv_draw
      nop
ppu_live_sprites:
      ; N5 / N.60: a line with sprites (a1 their count 1-8, a2 PPUMASK, s1 the line; a1 / a2 kept for the draw) is a
      ; fallback line of the old path only when its band cannot be recorded. (The sprite-priority quirk is the
      ; band's own since N.60: the RSP's phase 2 draws it, rspband.n64rsp NesRspBandQ.)
      ld t0, #NES_U_LIVEBAND(s6)
      bnez t0, ppu_live_on
      nop
      b ppu_adv_draw
      nop
ppu_live_on:
      jal nesfbslot                 ; a fallback slot (or none free: the frame is not shown, show.n64)
      nop
      ld t0, #NES_U_LIVE(s6)
      beqz t0, ppu_adv_draw
      nop
    EndASM
    CompilerIf #NES_CONSOLE_RECORD
      ASM
        jal nesrecdrawsprites       ; the same call, timed for the console record (show.n64)
        move a0, s1
      EndASM
    CompilerElse
      ASM
        jal nesmmc3drawsprites      ; the old renderer's sprite row of the line (a0 line, a1 count, a2 mask)
        move a0, s1
      EndASM
    CompilerEndIf
    ASM
      b ppu_adv_draw
      nop
    EndASM
  CompilerEndIf
  ASM
ppu_hit_first:
    srl a3, t8, 3
    sll a3, a3, 3                   ; a3 = the first span holding sprite 0
ppu_hit_span:
    sltu t0, a3, a5
    bnez t0, ppu_hit_next           ; consumed in an earlier interval
    sltu t0, a3, s5
    beqz t0, ppu_draw_v             ; not consumed yet
    nop
    jal ppu_span_hit
    nop
    bnez v0, ppu_hit_found
    nop
ppu_hit_next:
    daddiu a3, a3, 8
    daddiu t0, t8, 8
    sltu t0, a3, t0                 ; the next span still holds sprite pixels (X mod 8 > 0)
    beqz t0, ppu_draw_v
    sltiu t0, a3, 256
    bnez t0, ppu_hit_span
    nop
    b ppu_draw_v
    nop
ppu_hit_found:
    ori a7, zero, 64
    b ppu_draw_v
    nop
ppu_span_hit:                       ; v0 = 1 if sprite 0 meets the background in span a3
    ; In: a3 the span's first dot, a5 the interval's first span, s7 v at a5, t8 X, t9 U_S0ROW,
    ; a6 PPUMASK. Clobbers a0-a2, t0-t3, v0, v1; keeps a3-a7, t8, t9.
    move a2, ra
    subu a0, a3, a5
    srl a0, a0, 3
    jal ppu_add6                    ; v0 = v of span a3: its first tile
    move v0, s7
    move a1, v0
    jal ppu_tile_opacity            ; v0 = the first tile's row opacity
    move a0, a1
    la t0, global_ppufinex
    ld t2, 0(t0)
    beqz t2, ppu_span_bg            ; no fine X: the span is the one tile
    move a1, v0
    move v0, a0                     ; fine X: the span also shows the next tile's left pixels
    jal ppu_add6
    addiu a0, zero, 1
    move a0, v0
    jal ppu_tile_opacity
    nop
    dsll v0, v0, 16
    or a1, a1, v0
    sll t2, t2, 1
    dsrlv a1, a1, t2                ; span pixel p = tile pixel p + fine X of the pair
ppu_span_bg:
    andi a1, a1, 0x5555
    bnez a3, ppu_span_sprite
    andi t0, a6, 2
    bnez t0, ppu_span_sprite
    nop
    move a1, zero                   ; span 0 with the left background column hidden
ppu_span_sprite:
    subu t0, t8, a3                 ; X - span
    bltz t0, ppu_span_left
    sll t0, t0, 1
    b ppu_span_test
    sllv t1, t9, t0                 ; sprite pixel j at span pixel X - span + j
ppu_span_left:
    subu t0, zero, t0
    srlv t1, t9, t0
ppu_span_test:
    and v0, a1, t1
    andi v0, v0, 0xFFFF
    jr a2
    sltu v0, zero, v0

ppu_tile_opacity:                   ; leaf: a0 = v; v0 = bit 2i set if the tile's pixel i is opaque
    andi t0, a0, 0xFFF              ; clobbers t0 t1 t3 v1
    la t1, global_nt
    daddu t0, t0, t1
    lbu t0, 0(t0)                   ; the name-table byte: the tile number
    la t1, global_ppuctrl
    ld t1, 0(t1)
    andi t1, t1, 16
    sll t1, t1, 8                   ; the background's pattern table
    srl t3, a0, 11
    andi t3, t3, 14                 ; fine Y * 2 (two bytes a decoded row)
    or t1, t1, t3
    sll t0, t0, 4
    addu t0, t0, t1                 ; the row's PPU pattern address
    andi t3, t0, 0x1c00
    srl t3, t3, 7
    la v1, global_nesmmc3patternbias
    addu t3, t3, v1
    lw t3, 4(t3)                    ; its MMC3 bank
    addu t0, t0, t3
    lhu v0, 0(t0)                   ; the decoded row (pixel i in bits 2i+1:2i)
    srl t0, v0, 1
    or v0, v0, t0
    jr ra
    andi v0, v0, 0x5555
ppu_cut_split:
    srl t8, t3, 3
    daddu t8, t8, v0
    lbu t9, #NES_U_SPLIT(t8)
    andi t2, t3, 7
    addiu v1, zero, 1
    sllv v1, v1, t2
    or t9, t9, v1
    sb t9, #NES_U_SPLIT(t8)         ; U_SPLIT bit (line): a split line
  EndASM
  CompilerIf #NES_TWIN_CHECK Or #NES_RDP_SHOW
    ASM
      ; N.60: a split line is drawn by a record of its own with segments (rspband.n64). A later cut on such a line
      ; closes its open segment (the band before it is closed already: ppu_cut_close returns at once).
      la t8, global_nessegon
      ld t9, 0(t8)
      beqz t9, ppu_cut_split_first
      nop
      la t8, global_nessegopen
      b ppu_cut_close
      sd zero, 0(t8)
ppu_cut_split_first:
    EndASM
  CompilerEndIf
  CompilerIf #NES_RDP_SHOW
    ASM
      ld t8, #NES_U_LIVE(v0)
      bnez t8, ppu_cut_close        ; a fallback line of the old path already (its band could not be recorded)
      nop
    EndASM
  CompilerEndIf
  CompilerIf #NES_TWIN_CHECK Or #NES_RDP_SHOW
    ASM
      ; the line's first cut, before the write is applied: segment 0 and the line's sprite state (NesSegFirst keeps
      ; every register but t8, t9, v1). v1 = 0: no record or segment entries free - the old path below.
      daddiu sp, sp, -16
      sd ra, 0(sp)
      jal nessegfirst
      nop
      ld ra, 0(sp)
      bnez v1, ppu_cut_close
      daddiu sp, sp, 16
    EndASM
  CompilerEndIf
  CompilerIf #NES_RDP_SHOW
    ASM
      ; THE OLD PATH (N5): the old renderer draws the line's sprite row and its spans [0, dot) into a fallback slot
      ; (show.n64, NesFbCatchUp); the line's later draws go on into that slot. Every register is kept.
      daddiu sp, sp, -16
      sd ra, 0(sp)
      jal nesfbcatchupcall
      nop
      ld ra, 0(sp)
      daddiu sp, sp, 16
    EndASM
  CompilerEndIf
  ASM
ppu_cut_close:
    ; The open band ends before line t3: its record (the band log, nes.n64). Every input is read
    ; at the close, BEFORE the change that cut it is applied, so it is the value the band's lines
    ; were drawn with. In: v0 = NesUnitData, t3 = the line the band ends before. Clobbers t2, t3,
    ; t8, t9, v0, v1 only (u_ppucut's callers keep a0-a7, t0, t1). Palette and OAM 8-byte aligned.
    ld t8, #NES_U_BANDOPEN(v0)
    beqz t8, ppu_cut_done
    ld t9, #NES_U_BANDFIRST(v0)
    sd zero, #NES_U_BANDOPEN(v0)
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      sd zero, #NES_U_LIVEBAND(v0)  ; N5: the band ends; the next one decides again at its open
    EndASM
  CompilerEndIf
  ASM
    sltu t8, t9, t3
    beqz t8, ppu_cut_done           ; no complete line in it: no record
    ld t8, #NES_U_BANDOAM(v0)
    sltiu t2, t8, #NES_U_OAMSNAPMAX  ; (the two sets' indices, N.78)
    beqz t2, ppu_cut_lost           ; no OAM snapshot was free when it opened
    ld t8, #NES_U_BANDCOUNT(v0)
    sltiu t2, t8, #NES_U_BANDMAX
    beqz t2, ppu_cut_lost
    dsll t2, t8, 5
    dsll v1, t8, 6
    daddu t2, t2, v1                ; count x 96
    la v1, global_nesbandbase
    ld v1, 0(v1)
    daddu t2, t2, v1                ; t2 = the record
    daddiu t8, t8, 1
    sd t8, #NES_U_BANDCOUNT(v0)
    sd t9, #NES_B_FIRST(t2)
    sd t3, #NES_B_END(t2)
    ld t9, #NES_U_BANDV(v0)
    sd t9, #NES_B_V(t2)
    ld t9, #NES_U_BANDOAM(v0)
    sd t9, #NES_B_OAM(t2)
    la v1, global_ppuctrl
    ld t9, 0(v1)
    la v1, global_ppumask
    ld t8, 0(v1)
    dsll t8, t8, 8
    or t9, t9, t8
    la v1, global_ppufinex
    ld t8, 0(v1)
    dsll t8, t8, 16
    or t9, t9, t8
    la v1, global_pput
    ld t8, 0(v1)
    dsll32 t8, t8, 0
    or t9, t9, t8
    sd t9, #NES_B_STATE(t2)
    la v1, global_mapmirrormode
    ld t9, 0(v1)
    sd t9, #NES_B_MIRROR(t2)
    la v1, global_mapchrslots       ; the eight 1 KB CHR banks (64-bit each), a byte each
    ld t9, 0(v1)
    sb t9, #NES_B_BANKS(t2)
    ld t9, 8(v1)
    sb t9, #NES_B_BANKS+1(t2)
    ld t9, 16(v1)
    sb t9, #NES_B_BANKS+2(t2)
    ld t9, 24(v1)
    sb t9, #NES_B_BANKS+3(t2)
    ld t9, 32(v1)
    sb t9, #NES_B_BANKS+4(t2)
    ld t9, 40(v1)
    sb t9, #NES_B_BANKS+5(t2)
    ld t9, 48(v1)
    sb t9, #NES_B_BANKS+6(t2)
    ld t9, 56(v1)
    sb t9, #NES_B_BANKS+7(t2)
    sd zero, #NES_B_BANKS+8(t2)
    la v1, global_pal               ; the 32 palette bytes
    ld t9, 0(v1)
    sd t9, #NES_B_PAL(t2)
    ld t9, 8(v1)
    sd t9, #NES_B_PAL+8(t2)
    ld t9, 16(v1)
    sd t9, #NES_B_PAL+16(t2)
    ld t9, 24(v1)
  EndASM
  CompilerIf #NES_PPU_CHECK Or #NES_TWIN_CHECK Or #NES_WB_MEASURE Or #NES_RDP_SHOW
    ASM
      sd t9, #NES_B_PAL+24(t2)
      daddiu sp, sp, -16
      sd ra, 0(sp)
    EndASM
    CompilerIf #NES_RDP_SHOW
      ASM
        jal nesshowbandcall         ; N5: the band's inputs copied / written back, its RSP job queued (show.n64)
        nop
      EndASM
    CompilerEndIf
    CompilerIf #NES_WB_MEASURE
      ASM
        jal nesbandwriteback        ; Nt, the record and its OAM snapshot to RDRAM (rspband.n64)
        nop
      EndASM
    CompilerEndIf
    CompilerIf #NES_PPU_CHECK
      ASM
        jal ppu_check_record        ; the record against the band's inputs (unit/ppu_check.n64)
        nop
      EndASM
    CompilerEndIf
    CompilerIf #NES_TWIN_CHECK
      ASM
        jal nestwinbandcall         ; the CPU twin of the emitter, t2 = the record (twin.n64)
        nop
      EndASM
    CompilerEndIf
    CompilerIf #NES_RSP_CHECK
      ASM
        jal nesbandwriteback        ; Nt, the record and its OAM snapshot to RDRAM (rspband.n64)
        nop
        jal nesrspbandcall          ; the band's job for the RSP program (rspband.n64)
        nop
      EndASM
    CompilerEndIf
    ASM
      ld ra, 0(sp)
      jr ra
      daddiu sp, sp, 16
    EndASM
  CompilerElse
    ASM
      jr ra
      sd t9, #NES_B_PAL+24(t2)
    EndASM
  CompilerEndIf
  ASM
ppu_cut_lost:
    ld t8, #NES_U_BANDLOST(v0)
    daddiu t8, t8, 1
    jr ra
    sd t8, #NES_U_BANDLOST(v0)
nes_ppu_read_data:
    ld a0, global_ppuv-global_ppubus(a2)
    daddiu sp, sp, -32
    sd ra, 0(sp)
    jal u_ppucut                    ; the read moves v: the band ends first
    sd a2, 16(sp)
    andi a0, a0, 0x3FFF
    sltiu t0, a0, 0x3F00
    beqz t0, nes_ppu_read_palette
    sd a0, 24(sp)
    ld t0, global_ppubuffer-global_ppubus(a2)
    jal ppuread
    sd t0, 8(sp)
    b nes_ppu_read_buffer
    nop
nes_ppu_read_palette:
    jal ppuread
    nop
    ld a2, 16(sp)
    ld t0, 0(a2)
    andi t0, t0, 0xC0
    or t1, a0, t0
    ld t0, global_ppumask-global_ppubus(a2)
    andi t0, t0, 1
    beqz t0, nes_ppu_read_palette_mirror
    nop
    andi t1, t1, 0xF0
nes_ppu_read_palette_mirror:
    ld a0, 24(sp)
    addiu a0, a0, -4096
    jal ppuread
    sd t1, 8(sp)
nes_ppu_read_buffer:
    ld a2, 16(sp)
    sd a0, global_ppubuffer-global_ppubus(a2)
    ld a0, 8(sp)
    ld ra, 0(sp)
    sd a0, 0(a2)
    daddiu sp, sp, 32
    b nes_ppu_port_increment
    nop

; ---- THE NMI'S TIMING (design note N.77) ----------------------------------------------------------------------------
; The rules are the probe cart's (the bench's carts/nmiprobe.s, its header R1-R5, from the documented 2C02 / 2A03
; timing): the vblank flag is set at line 241 dot 1 (R2); NMI = flag AND PPUCTRL bit 7, enabling it during vblank
; makes the edge at once (R3); a $2002 read one dot before the set reads 0 and makes no flag or NMI that frame, a read
; on the set dot or one after reads 1 and makes no NMI (R4); the edge is detected in the first cycle whose read point
; + 1 dot is at or after it, and the NMI follows an instruction whose PENULTIMATE cycle is at or after the detection,
; i.e. the first instruction boundary >= the detection cycle + 2 (R5). Before this the NMI was taken at the first
; window end after the PPU had passed the set (up to a window, 128 cycles, late; right after the access when a
; $2002 read or the enabling write ended the window: one instruction early) - measured by the probe on this unit, its
; compiled core and the old MMC1 scheduler alike (N.77's table).
; CHECKED BY: the probe cart (every test's expected value derived by hand in its source) on the unit, its compiled
; core and the reference scheduler; the guest digests (an NMI at another instruction changes them).

; ppu_adv_vblank_set: line 241 dot 1 reached in u_ppuadvance (t1 = PpuStatus, t0 = PpuCtrl, s4 = @PpuLine, s0 = the
; dots still to advance past the set, NesPpuTo = the stamp the advance ends at; t2, t3 free). Back to ppu_adv_next.
; WHAT: unless a $2002 read one dot before suppressed it (NesVblSuppress, cleared here: used once), the flag is set
; and, with NMI on, the edge counted (WorkerNmi + 1) with NesNmiAt, the cycle it is detected in.
; HOW: the set dot S is reached with s0 dots of the advance left, so the stamp's read point is S + s0 and cycle c's is
; S + s0 - 3 (stamp - c) (NTSC: 3 dots a cycle). Detected in the first c with S + s0 - 3 (stamp - c) + 1 >= S, i.e.
; stamp - c <= (s0 + 1) / 3: NesNmiAt = stamp - floor((s0 + 1) / 3). The divide: x / 3 = (x * $AAAAAAAB) >> 33 for
; x < 2^32 (Hacker's Delight 10-3; s0 is below one frame's dots). PAL (3.2 dots a cycle, pputakedots' fraction): not
; derived here - NesNmiAt = 0, so the NMI is taken at the window's end as before.
; THE PLAIN TWIN:
;   If NesVblSuppress : NesVblSuppress = 0 : Else
;     PpuStatus = PpuStatus | 128
;     If PpuCtrl & 128 : WorkerNmi + 1 : If CartPal : NesNmiAt = 0 : Else : NesNmiAt = stamp - (s0 + 1) / 3 : EndIf
;       NesNmiDue = NesNmiAt + 2 : NesNmiCapAt = NesNmiDue - 514 : EndIf
;   EndIf
ppu_adv_vblank_set:
    la t2, global_nesvblsuppress
    ld t3, 0(t2)
    bnez t3, ppu_vbl_suppressed     ; a read one dot before: no flag, no NMI this frame
    ori t1, t1, 128                 ; (delay slot) the flag
    sd t1, global_ppustatus-global_ppuline(s4)
    andi t0, t0, 128
    beqz t0, ppu_vbl_done           ; NMI off: the flag only
    nop
    la t0, global_workernmi
    ld t1, 0(t0)
    daddiu t1, t1, 1
    sd t1, 0(t0)                    ; one more NMI edge
    la t0, global_cartpal
    ld t0, 0(t0)
    bnez t0, ppu_vbl_at             ; PAL: NesNmiAt = 0
    move t1, zero                   ; (delay slot)
    daddiu t1, s0, 1                ; s0 + 1
    lui t2, 0xAAAA
    ori t2, t2, 0xAAAB              ; the magic number (multu reads its low 32 bits)
    multu t1, t2
    mfhi t1
    srl t1, t1, 1                   ; (s0 + 1) / 3
    la t0, global_nespputo
    ld t0, 0(t0)                    ; the stamp (NesPpuTo, set by u_workeradvance)
    dsubu t1, t0, t1                ; the cycle the edge is detected in
ppu_vbl_at:
    la t0, global_nesnmiat
    sd t1, 0(t0)
    daddiu t1, t1, 2
    la t0, global_nesnmidue
    sd t1, 0(t0)                    ; NesNmiDue = NesNmiAt + 2 (R5): set here, the frame's prediction is not redone
    daddiu t1, t1, -514
    la t0, global_nesnmicapat
    sd t1, 0(t0)                    ; and the window cap's quick test
ppu_vbl_done:
    j ppu_adv_next
    nop
ppu_vbl_suppressed:
    j ppu_adv_next
    sd zero, 0(t2)                  ; (delay slot) NesVblSuppress used

; ppu_ctrl_nmi_changed: a PPUCTRL write changed bit 7 (a1 = the value, a2 = @PpuBus, ra = the port's caller). The PPU
; was synced to the write (u_workeradvance before PpuRegWrite), so PpuClock is the write's cycle. Enabled while the
; flag is set (R3): the edge now, NesNmiAt = the write's cycle (the STA's last; the next instruction runs first, R5).
; Then NesNmiDue from the new PPUCTRL (u_nmidue, a tail call: it returns to the port's caller).
; THE PLAIN TWIN: If value & 128 And PpuStatus & 128 : WorkerNmi + 1 : NesNmiAt = PpuClock : EndIf : NesNmiDueSet()
ppu_ctrl_nmi_changed:
    andi t1, a1, 128
    beqz t1, ppu_ctrl_nmi_due       ; disabled: only the due changes
    ld t1, global_ppustatus-global_ppubus(a2)
    andi t1, t1, 128
    beqz t1, ppu_ctrl_nmi_due       ; enabled outside vblank: the edge comes at the set
    nop
    ld t0, global_workernmi-global_ppubus(a2)
    daddiu t0, t0, 1
    sd t0, global_workernmi-global_ppubus(a2)   ; the edge now
    la t0, global_ppuclock
    ld t0, 0(t0)
    la t1, global_nesnmiat
    sd t0, 0(t1)                    ; detected in the write's cycle
ppu_ctrl_nmi_due:
    j u_nmidue
    nop

; ppu_read_status_vbl: a $2002 read on line 241, the PPU at the read (t0 = PpuStatus, a2 = @PpuBus, ra = the caller;
; a3 free). R4 by the dot: 0 (one before the set) reads 0 and suppresses this frame's flag and NMI (NesVblSuppress,
; used by ppu_adv_vblank_set); 1 or 2 (on the set, one after) reads 1 and the frame's NMI is not taken
; (NesSeenNmi = WorkerNmi: the edge is at most a cycle old here and is taken two cycles after its detection at the
; earliest, so it cannot have been taken yet); 3 or later is a normal read. Then NesNmiDue again; back to the read.
; THE PLAIN TWIN:
;   If PpuDot = 0 : NesVblSuppress = 1 : NesNmiDueSet()
;   ElseIf PpuDot < 3 : NesSeenNmi = WorkerNmi : NesNmiDueSet() : EndIf
ppu_read_status_vbl:
    la t1, global_ppudot
    ld t1, 0(t1)
    sltiu t2, t1, 3
    beqz t2, ppu_read_status_go     ; dot 3 or later: a normal read
    addiu t2, zero, 1               ; (delay slot)
    bnez t1, ppu_read_status_on
    nop
    la t3, global_nesvblsuppress
    b ppu_read_status_due
    sd t2, 0(t3)                    ; (delay slot) dot 0: suppressed
ppu_read_status_on:
    la t2, global_workernmi
    ld t2, 0(t2)
    la t3, global_nesseennmi
    sd t2, 0(t3)                    ; dot 1-2: this frame's NMI is not taken
ppu_read_status_due:
    move a3, ra
    jal u_nmidue                    ; (clobbers t0-t3)
    nop
    move ra, a3
    la a2, global_ppubus
    ld t0, global_ppustatus-global_ppubus(a2)
ppu_read_status_go:
    j ppu_read_status_back
    ld a0, 0(a2)                    ; (delay slot) PpuBus

; mmc3_worker_nmidue: u_workeradvance after the first PPU advance of a frame (s1 = @NesMmc3ApuClock, its frame saved
; ra): NesNmiDue predicted, and the frame marked (NesNmiDueFrame = WorkerFrames + 1). Back to u_workeradvance.
mmc3_worker_nmidue:
    jal u_nmidue
    nop
    ld t0, global_workerframes-global_nesmmc3apuclock(s1)
    daddiu t0, t0, 1
    j mmc3_worker_nmidue_back
    sd t0, global_nesnmidueframe-global_nesmmc3apuclock(s1)

; u_nmidue: NesNmiDue, the first instruction boundary the next NMI may be taken at, from the state. A leaf; clobbers
; t0-t3. Called after a frame's first PPU advance (u_workeradvance, mmc3_worker_nmidue), a PPUCTRL bit 7 change and
; a suppressing $2002 read (the set itself and the NMI taken store the due directly). WHY ONCE A FRAME: the prediction
; is the same from any later point of the frame; measured, calling it after every advance cost ~18 K cycles a frame.
; WHAT: an edge counted and not taken: NesNmiAt + 2 (R5). Else, while NMI is on, NTSC, not suppressed and the set
; (line 241 dot 1) still ahead in this frame: the predicted detection cycle + 2. Else never (the largest cycle); the
; next frame's set is a frame away, and the PPU is caught up at line 224 and 240 (the render limit) before it.
; HOW: the PPU stands at (PpuLine, PpuDot) at PpuClock; the set is dots = (241 - line) x 341 + 1 - dot ahead; the
; detection is the first cycle c with 3 (c - PpuClock) + 1 >= dots, c = PpuClock + ceil((dots - 1) / 3) =
; PpuClock + (x + 2) / 3 with x = (241 - line) x 341 - dot >= 0; the divide by the magic multiply (as above).
; THE PLAIN TWIN (NesNmiDueSet):
;   If WorkerNmi <> NesSeenNmi : NesNmiDue = NesNmiAt + 2
;   ElseIf PpuCtrl & 128 And NesVblSuppress = 0 And CartPal = 0 And (PpuLine < 241 Or (PpuLine = 241 And PpuDot = 0))
;     NesNmiDue = PpuClock + ((241 - PpuLine) * 341 - PpuDot + 2) / 3 + 2
;   Else : NesNmiDue = $7FFFFFFFFFFFFFFF : EndIf
u_nmidue:
    la t0, global_workernmi
    ld t1, 0(t0)
    la t0, global_nesseennmi
    ld t2, 0(t0)
    beq t1, t2, nmidue_ahead
    nop
    la t0, global_nesnmiat
    ld t1, 0(t0)
    b nmidue_store
    daddiu t1, t1, 2                ; (delay slot) the edge counted: NesNmiAt + 2
nmidue_ahead:
    la t0, global_ppuctrl
    ld t1, 0(t0)
    andi t1, t1, 128
    beqz t1, nmidue_never           ; NMI off
    nop
    la t0, global_nesvblsuppress
    ld t1, 0(t0)
    bnez t1, nmidue_never           ; this frame's set suppressed
    nop
    la t0, global_cartpal
    ld t1, 0(t0)
    bnez t1, nmidue_never           ; PAL: not predicted
    nop
    la t0, global_ppuline
    ld t1, 0(t0)                    ; line
    ld t2, global_ppudot-global_ppuline(t0)   ; dot
    addiu t3, zero, 241
    slt t0, t3, t1
    bnez t0, nmidue_never           ; past line 241
    nop
    bne t1, t3, nmidue_dist
    nop
    bnez t2, nmidue_never           ; line 241 at dot 1 or later: the set is behind
    nop
nmidue_dist:
    subu t1, t3, t1                 ; 241 - line
    addiu t3, zero, 341
    multu t1, t3
    mflo t1
    subu t1, t1, t2                 ; x = (241 - line) x 341 - dot
    addiu t1, t1, 2
    lui t3, 0xAAAA                  ; (two instructions after mflo before the next multu: the HI / LO rule)
    ori t3, t3, 0xAAAB
    multu t1, t3
    mfhi t1
    srl t1, t1, 1                   ; ceil(x / 3)
    la t0, global_ppuclock
    ld t0, 0(t0)
    daddu t1, t1, t0                ; the predicted detection cycle
    b nmidue_store
    daddiu t1, t1, 2                ; (delay slot) + 2
nmidue_never:
    daddiu t1, zero, -1
    dsrl t1, t1, 1                  ; the largest cycle
nmidue_store:
    la t0, global_nesnmidue
    sd t1, 0(t0)
    daddiu t1, t1, -514             ; NesNmiCapAt: the window cap's quick test (unit/window.n64)
    la t0, global_nesnmicapat
    jr ra
    sd t1, 0(t0)
  EndASM
