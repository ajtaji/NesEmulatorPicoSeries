; unit/write.n64 - the CPU bus write (NesWrite) of the runtime MMC3 cartridge
; Part of the hot unit: included inside cpu6502.n64's procedure (the shipped build) or a
; holder procedure in mmc3_run.n64 (the reference build), never on its own. Entry labels
; are u_<procedure>; the procedure of the same name is a one-jump stub for outside callers.
; Moved unchanged from the file named above each part (design note, section N, step N1).
; N7 (design note N.40 / N.41): NesWriteRegister's paths in place in u_neswrite, u_ppuwrite, u_mappera12,
; u_nesreaddev. QResult / QSent / QComplete, which the compiled NesWriteRegister also wrote, are
; not written: QResult is set by WorkerCommand before NesRpc reads it, QSent is returned by NesPost to callers
; that drop it, QComplete is read by nothing (searched in the staged text, N.40 (2)).

; ---- neswrite, from mmc3_cpu_write.n64 ----
  ASM
u_neswrite:
    andi a0, a0, 0xFFFF
    andi a1, a1, 0xFF
    la t0, global_nesopenbus
    sltiu t1, a0, 0x2000
    bnez t1, nes_mmc3_bus_write_ram
    sd a1, 0(t0)
    sltiu t1, a0, 0x6000
    bnez t1, nes_mmc3_bus_write_io
    andi t1, a0, 0x8000

    ld t2, global_mapmanaged-global_nesopenbus(t0)
    beqz t2, nes_mmc3_bus_write_done
    move a2, zero
    ; Work RAM writes still use MapperWrite for protection and save tracking.
    beqz t1, nes_mmc3_bus_write_workram
    andi t1, a0, 0xE001
    ori t2, zero, 0x8000
    bne t1, t2, nes_mmc3_bus_write_timed
    ld t1, global_mapselect-global_nesopenbus(t0)
    xor t1, t1, a1
    andi t1, t1, 0xC0
    bnez t1, nes_mmc3_bus_write_timed
    nop
    jr ra
    sd a1, global_mapselect-global_nesopenbus(t0)
nes_mmc3_bus_write_workram:
    j u_mapperwrite                 ; work RAM: protection and the save tracking (below, C4)
    nop
nes_mmc3_bus_write_ram:
    la t0, global_m
    andi a0, a0, 0x7FF
    addu t0, t0, a0
    jr ra
    sb a1, 0(t0)

nes_mmc3_bus_write_io:
    addiu t1, a0, -0x4016
    beqz t1, nes_mmc3_bus_write_pad
    sltiu t1, a0, 0x4018
    beqz t1, nes_mmc3_bus_write_done
    nop
nes_mmc3_bus_write_timed:
    la t0, global_cpucycles
    ld t1, global_cpuinwindow-global_cpucycles(t0)
    beqz t1, nes_mmc3_bus_write_stamp
    ld a2, 0(t0)
    ld t1, global_nesrunstart-global_cpucycles(t0)
    ld t2, global_budget-global_cpucycles(t0)
    ld a2, global_left-global_cpucycles(t0)
    daddu t1, t1, t2
    dsubu a2, t1, a2
    sd a2, 0(t0)
nes_mmc3_bus_write_stamp:
    ld t1, global_accessphase-global_cpucycles(t0)
    daddu a2, a2, t1
    daddiu sp, sp, -32
    sd ra, 0(sp)
    andi t1, a0, 0x8000
    bnez t1, nes_mmc3_bus_write_mapper
    addiu t1, a0, -0x4014
    beqz t1, nes_mmc3_bus_write_dma
    sd a0, 8(sp)                    ; (the DMA path does not read 8(sp))
    sltiu t1, a0, 0x4000
    beqz t1, nes_mmc3_bus_write_apu
    sd a1, 16(sp)
  EndASM
  CompilerIf #NES_RDP_SHOW
    ASM
      ; ---- THE $2007 BURST (design note N.43) ----
      ; WHAT: a $2007 name-table write while nothing the guest can observe or be interrupted by can change before
      ; the next synced access is applied at once, WITHOUT the sync (u_workeradvance) and WITHOUT ending the CPU
      ; window; the next access that syncs brings the APU, the A12 walk and the PPU to its own time.
      ; WHY: in a world entry a game uploads 2,000-3,000 name-table bytes with rendering off; the sync and the
      ; window's end and re-entry were ~17 of the ~20 us each write cost (N.41), and those frames are where the
      ; console's sound broke. HOW IT STAYS EXACT: condition C, below, item by item. Under C (1) no interrupt
      ; source can change state and no DMC stall exists, so where the window ends is invisible to the guest (a
      ; window end stalls, polls interrupts and hands frames to the host; the first two are void, the third is
      ; host-only); (2) the deferred PPU / APU advance over [WorkerClock, the write] reads neither v nor the name
      ; tables with rendering off, so the write and the advance commute; (3) the write's own A12 is low before and
      ; after it with MapA12 low, so u_mappera12 and the notice are no-ops. The guest digest (cputrace.n64, N.42)
      ; proves it; the window digest, which folds where windows end, differs by design.
      ; C: in a CPU window; register 7; PPUMASK & $18 = 0 (rendering off); PPUCTRL & $80 = 0 (NMI off);
      ; WorkerNmi = NesSeenNmi (no NMI pending: it is taken at a window end); MapIrq = 0, WorkerIrq = 0 (no IRQ
      ; asserted); DmcBytes = 0 (no fetch, stall or DMC IRQ); MapA12 = 0; ApuInhibit | ApuFive <> 0 (no frame IRQ
      ; can be raised); v & $3000 = $2000 (a name table: A12 low) and (v + increment) & $1000 = 0 (A12 still low
      ; after it). Anything else takes the synced path below. In: a0 the address, a1 the value, t0 =
      ; @CpuCycles, the frame (ra, a0, a1) on the stack. Clobbers t1-t3, t8 before the decision.
      ; THE PLAIN TWIN (what the assembly computes):
      ;   If CpuInWindow And WorkerNmi=NesSeenNmi And addr&7=7 And MapIrq=0 And WorkerIrq=0 And DmcBytes=0 And
      ;      MapA12=0 And PpuMask&$18=0 And PpuCtrl&$80=0 And (ApuInhibit Or ApuFive) And PpuV&$3000=$2000 And
      ;      (PpuV+inc)&$1000=0                          ; inc = 32 when PpuCtrl&4, else 1
      ;     PpuRegWrite(7,value) : ProcedureReturn      ; no WorkerAdvance, no MapperRegNotice, no CpuEndWindow
      ;   EndIf
      ld t1, global_cpuinwindow-global_cpucycles(t0)
      ld t2, global_workernmi-global_cpucycles(t0)
      ld t3, global_nesseennmi-global_cpucycles(t0)
      beqz t1, nes_mmc3_ppu_synced    ; outside a CPU window
      xor t2, t2, t3
      bnez t2, nes_mmc3_ppu_synced    ; an NMI edge not yet taken
      andi t1, a0, 7
      xori t1, t1, 7
      bnez t1, nes_mmc3_ppu_synced    ; not $2007
      nop
      la t3, global_mapirq
      ld t1, 0(t3)                    ; MapIrq
      ld t2, global_workerirq-global_mapirq(t3)
      or t1, t1, t2
      ld t2, global_dmcbytes-global_mapirq(t3)
      or t1, t1, t2
      ld t2, global_mapa12-global_mapirq(t3)
      or t1, t1, t2
      ld t2, global_ppumask-global_mapirq(t3)
      andi t2, t2, 24
      or t1, t1, t2
      ld t2, global_ppuctrl-global_mapirq(t3)
      andi t8, t2, 128
      or t1, t1, t8
      bnez t1, nes_mmc3_ppu_synced    ; an IRQ, a sample, A12 high, rendering or NMI on
      andi t2, t2, 4                  ; PPUCTRL bit 2: the increment is 32
      la t3, global_nesmmc3apuclock
      ld t1, global_apuinhibit-global_nesmmc3apuclock(t3)
      ld t8, global_apufive-global_nesmmc3apuclock(t3)
      or t1, t1, t8
      beqz t1, nes_mmc3_ppu_synced    ; the four-step sequence can raise the frame IRQ
      nop
      la t3, global_ppuv
      ld t8, 0(t3)                    ; v
      andi t1, t8, 0x3000
      xori t1, t1, 0x2000
      bnez t1, nes_mmc3_ppu_synced    ; not a name table ($0000-$1FFF CHR, $3000-$3FFF palette / mirror)
      sll t1, t2, 3                   ; 32 or 0
      srl t2, t2, 2                   ; 1 or 0
      subu t1, t1, t2
      addiu t1, t1, 1                 ; the increment: 32 or 1
      addu t1, t8, t1
      andi t1, t1, 0x1000
      bnez t1, nes_mmc3_ppu_synced    ; the increment takes v to $3000: A12 would rise
      nop
      jal u_ppuregwrite               ; PpuRegWrite(7, value): PpuBus, u_ppucut (returns: rendering off), u_ppuwrite, v
      ld a1, 16(sp)
      ld ra, 0(sp)                    ; no sync, no notice (a no-op under C), no close
      jr ra
      daddiu sp, sp, 32
nes_mmc3_ppu_synced:
      ld a0, 8(sp)
    EndASM
  CompilerEndIf
  ASM
    ; ---- a PPU register, $2000-$3FFF: the staged NesWriteRegister's PPU path, in place (N.40 (2)) ----
    jal u_workeradvance             ; WorkerAdvance(stamp): the APU, the A12 walk and the PPU to the write
    move a0, a2
    ld a0, 8(sp)
    jal u_ppuregwrite               ; PpuRegWrite(addr & 7, value) (u_ppuregwrite masks the address)
    ld a1, 16(sp)
    ; MapperRegNotice(addr & 7): after $2006 / $2007 the PPU's address bus shows v, so A12 may move
    ld a0, 8(sp)
    andi a0, a0, 6
    xori a0, a0, 6                  ; 0: register 6 or 7
    la t0, global_ppuv
    bnez a0, nes_mmc3_bus_write_close
    nop
    ld a0, 0(t0)
    ld a1, global_mapdots-global_ppuv(t0)
    jal u_mappera12                 ; MapperA12(v & $3FFF, MapDots)
    andi a0, a0, 0x3FFF
    b nes_mmc3_bus_write_close
    nop
nes_mmc3_bus_write_apu:
    ; ---- $4000-$4013, $4015, $4017: the staged NesWriteRegister's APU path ----
    jal u_nesmmc3syncapu            ; NesMmc3SyncApu(stamp): the APU (and a pending DMC fetch) to the write
    move a0, a2
    ld a0, 8(sp)
    jal u_apuwrite                  ; ApuWrite(addr, value): its timing half (unit/cold.n64)
    ld a1, 16(sp)
    b nes_mmc3_bus_write_close
    nop

nes_mmc3_bus_write_mapper:
    sd a0, 8(sp)
    sd a1, 16(sp)
    andi t0, a0, 0xE001
    ; PRG-RAM protection and unchanged bank values have no raster effect.
    ori t1, zero, 0xA001
    beq t0, t1, nes_mmc3_mapper_only_clock
    ori t1, zero, 0x8001
    bne t0, t1, nes_mmc3_mapper_full_sync
    nop
    la t0, global_mapselect
    ld t0, 0(t0)
    andi t0, t0, 7
    la t1, global_mapregs
    sll t2, t0, 3
    daddu t1, t1, t2
    ld t1, 0(t1)
    beq a1, t1, nes_mmc3_mapper_only_clock
    sltiu t0, t0, 6
    bnez t0, nes_mmc3_mapper_full_sync
    nop
    ; Service any pending DMC read before replacing its PRG mapping.
    la t0, global_dmcbytes
    ld t0, 0(t0)
    blez t0, nes_mmc3_mapper_only_clock
    nop
    jal u_nesmmc3syncapu
    move a0, a2
    b nes_mmc3_mapper_synced
    nop
nes_mmc3_mapper_only_clock:
    jal u_nesmmc3advancecputime
    move a0, a2
    b nes_mmc3_mapper_synced
    nop
nes_mmc3_mapper_full_sync:
    jal u_workeradvance
    move a0, a2
nes_mmc3_mapper_synced:
    ; Read the current stamp again after device advancement, as before.
    la t0, global_cpucycles
    ld a2, 0(t0)
    ld t1, global_accessphase-global_cpucycles(t0)
    ld a0, 8(sp)
    ld a1, 16(sp)
    jal u_mapperwrite               ; MapperWrite(addr, value, stamp), in the unit (below, C4)
    daddu a2, a2, t1
    b nes_mmc3_bus_write_close
    nop

nes_mmc3_bus_write_dma:
    move a3, a2
    move a2, a1
    addiu a0, zero, 3
    jal nespost
    move a1, zero
    ; DMA starts on the next CPU cycle. An odd start takes one extra cycle.
    la t0, global_cpucycles
    ld t1, 0(t0)
    ld t2, global_accessphase-global_cpucycles(t0)
    ld t3, global_cpuinwindow-global_cpucycles(t0)
    daddu t1, t1, t2
    daddiu t1, t1, 1
    andi t1, t1, 1
    beqz t3, nes_mmc3_bus_write_stall
    daddiu t1, t1, 513
    ld t2, global_left-global_cpucycles(t0)
    dsubu t2, t2, t1
    b nes_mmc3_bus_write_subtract
    ld t1, global_budget-global_cpucycles(t0)

nes_mmc3_bus_write_close:
    la t0, global_cpucycles
    ld t1, global_cpuinwindow-global_cpucycles(t0)
    beqz t1, nes_mmc3_bus_write_close_done
    ld t2, global_left-global_cpucycles(t0)
    ld t1, global_budget-global_cpucycles(t0)
nes_mmc3_bus_write_subtract:
    dsubu t1, t1, t2
    sd t1, global_budget-global_cpucycles(t0)
nes_mmc3_bus_write_close_done:
    sd zero, global_left-global_cpucycles(t0)
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 32

nes_mmc3_bus_write_pad:
  EndASM
  CompilerIf #VERIFY_INPUT=0
    ASM
      daddiu sp, sp, -16
      sd ra, 0(sp)
      jal hostharvestpads
      sd a1, 8(sp)
      ld a1, 8(sp)
      ld ra, 0(sp)
      daddiu sp, sp, 16
    EndASM
  CompilerEndIf
  ASM
    la t0, global_nesstrobe
    ld t1, global_nescontroller-global_nesstrobe(t0)
    ld t2, global_nescontroller2-global_nesstrobe(t0)
    andi a1, a1, 1
    sd a1, 0(t0)
    sd t1, global_neslatch-global_nesstrobe(t0)
    jr ra
    sd t2, global_neslatch2-global_nesstrobe(t0)
nes_mmc3_bus_write_done:
    jr ra
    nop
  EndASM

; ---- mapperwrite, from mmc3_registers.n64 (C4, design note N.46b: moved unchanged, instruction for instruction) ----
; WHAT: the MMC3's CPU write at $6000-$FFFF after u_neswrite has synced the devices: work RAM at $6000-$7FFF (enable
; and protect honoured, the save tracking called when the cart saves), else the register picked by A14-A13 and A0:
; $8000 bank select, $8001 bank data, $A000 mirroring, $A001 RAM protect, $C000 IRQ latch, $C001 IRQ reload,
; $E000 IRQ disable (and acknowledge), $E001 IRQ enable. HOW: index = (addr >> 12) & 6 | addr & 1, a jump through the
; 8-word table; the bank-data path stores the register and hands the bank to MapperChr (registers 0-1 as a 2 KB pair
; of 1 KB slots, 2-5 as one slot each, the slot flipped by $8000 bit 7) or MapperPrg (6 by $8000 bit 6, 7), each a
; tail jump that returns to u_mapperwrite's caller; a write of the value already held does nothing. WHY IN THE UNIT:
; ~81 calls a guest frame (36 register writes, 45 work-RAM writes in SMB3), whose lines missed outside the unit at
; every NMI batch (N.46b: ~3,300 of the 4,767 cycles a frame were misses). The never-run paths (select, mirroring,
; protect: 0 cycles a frame) live in unit/cold.n64, reached through the same table. MapperWrite (outside) is now a
; one-jump stub to this label. In: a0 address, a1 value, a2 stamp (unused here). Clobbers t0-t3, a0, a1 (as before).
; THE PLAIN TWIN:
;   If addr & $8000 = 0                                   ; $6000-$7FFF
;     If MapRamEnable And MapRamProtect = 0 : MapRam(addr & 8191) = value : NesSaveChanged() : EndIf
;   Else
;     Select (addr >> 12 & 6) | (addr & 1)
;       Case 0 : old = MapSelect : MapSelect = value : If (old ! value) & $C0 : MapperUpdate() : EndIf
;       Case 1 : r = MapSelect & 7 : If MapRegs(r) <> value
;                  MapRegs(r) = value
;                  If r < 2 : s = (MapSelect & 128) >> 5 | r * 2 : MapperChr(s, value & 254) : MapperChr(s + 1, value | 1)
;                  ElseIf r < 6 : MapperChr(((MapSelect & 128) >> 5 ! 4) + r - 2, value)
;                  ElseIf r = 6 : MapperPrg((MapSelect & 64) >> 5, value & 63) : Else : MapperPrg(r - 6, value & 63)
;                  EndIf : EndIf
;       Case 2 : If MapFourScreen = 0 : MapperMirror((value & 1) ! 1) : EndIf
;       Case 3 : MapRamEnable = value >> 7 & 1 : MapRamProtect = value >> 6 & 1
;       Case 4 : MapIrqLatch = value
;       Case 5 : MapReload = 1
;       Case 6 : MapIrq = 0 : MapIrqEnable = 0
;       Case 7 : MapIrqEnable = 1
;     EndSelect
;   EndIf
  ASM
u_mapperwrite:
    andi t0, a0, 0x8000
    beqz t0, mmc3_write_ram         ; $6000-$7FFF: work RAM
    andi t0, a0, 1
    srl t1, a0, 12
    andi t1, t1, 6
    or t1, t1, t0                   ; the register: A14-A13 and A0
    la t2, mmc3_write_table
    sll t1, t1, 2
    daddu t2, t2, t1
    lw t2, 0(t2)
    jr t2
    nop
mmc3_write_data:                    ; $8001: the bank register MapSelect & 7 gets the value
    la t0, global_mapselect
    ld t0, 0(t0)
    la t1, global_mapregs
    andi t2, t0, 7
    sll t3, t2, 3
    daddu t1, t1, t3
    ld t3, 0(t1)
    beq t3, a1, mmc3_write_done     ; the value it already holds: nothing changes
    sltiu t3, t2, 2
    sd a1, 0(t1)
    bnez t3, mmc3_write_chr_pair    ; registers 0-1: a 2 KB CHR pair
    andi a0, t0, 128
    sltiu t3, t2, 6
    beqz t3, mmc3_write_prg         ; registers 6-7: PRG
    srl a0, a0, 5                   ; $8000 bit 7 as 4: the CHR half that is flipped
    xori a0, a0, 4
    addu a0, a0, t2
    j mapperchr                     ; registers 2-5: one 1 KB slot, (4 ! flip) + r - 2
    addiu a0, a0, -2
mmc3_write_chr_pair:
    srl a0, a0, 5
    sll t2, t2, 1
    or a0, a0, t2                   ; the pair's first slot: flip | r * 2
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    jal mapperchr                   ; the even 1 KB bank in the first slot ...
    andi a1, a1, 254
    ld a0, 8(sp)
    ld a1, 16(sp)
    ld ra, 0(sp)
    addiu a0, a0, 1
    daddiu sp, sp, 32
    j mapperchr                     ; ... the odd one in the next
    ori a1, a1, 1
mmc3_write_prg:
    addiu a0, t2, -6
    bnez a0, mmc3_write_prg_bank    ; register 7: slot 1
    andi a1, a1, 63
    andi a0, t0, 64
    srl a0, a0, 5                   ; register 6: slot 0, or 2 with $8000 bit 6
mmc3_write_prg_bank:
    j mapperprg
    nop
mmc3_write_latch:                   ; $C000
    la t0, global_mapirqlatch
    jr ra
    sd a1, 0(t0)
mmc3_write_reload:                  ; $C001: the counter reloads at the next counted rise
    la t0, global_mapreload
    addiu t1, zero, 1
    jr ra
    sd t1, 0(t0)
mmc3_write_ack:                     ; $E000: disable and acknowledge
    la t0, global_mapirqenable
    sd zero, global_mapirq-global_mapirqenable(t0)
    jr ra
    sd zero, 0(t0)
mmc3_write_enable:                  ; $E001
    la t0, global_mapirqenable
    addiu t1, zero, 1
    jr ra
    sd t1, 0(t0)
mmc3_write_ram:                     ; $6000-$7FFF, enabled and not protected
    la t0, global_mapramenable
    ld t1, 0(t0)
    beqz t1, mmc3_write_done
    ld t1, global_mapramprotect-global_mapramenable(t0)
    bnez t1, mmc3_write_done
    andi a0, a0, 8191
    la t0, global_mapram
    daddu t0, t0, a0
  EndASM
  CompilerIf #GAME_SAVE_BYTES>0
    ASM
      j nessavechanged              ; the store, then the save tracking
      sb a1, 0(t0)
    EndASM
  CompilerElse
    ASM
      jr ra
      sb a1, 0(t0)
    EndASM
  CompilerEndIf
  ASM
mmc3_write_done:
    jr ra
    nop
  EndASM

; ---- ppuwrite, from mmc3_ppu_bus.n64 (N7: moved unchanged but for the calls) ----
; The PPU bus write at v: the palette (neswritepalette, outside), CHR (mapperchrwrite, outside), or a name
; table: MapperA12 at the address, the CIRAM byte, the old renderer's row serials (NesInvalidateTileRow, only
; where the old renderer's row reuse runs: not in the N5 show, N.40 (2)), the Nt aliases. In: a0 address,
; a1 value. Called from u_ppuregwrite ($2007) and, through the PpuWrite stub, from outside.
  CompilerIf #NES_CONSOLE_RECORD
    ASM
u_ppuwrite:
      la t0, global_nesrect           ; the console record's work split: one PPU bus write (NesRecT(8)); t0 / t1,
      ld t1, 64(t0)                   ; set again below
      daddiu t1, t1, 1
      sd t1, 64(t0)
    EndASM
  CompilerElse
    ASM
u_ppuwrite:
    EndASM
  CompilerEndIf
  ASM
    la t0, global_bgcacheaddr
    la t1, global_rgblastkey
    daddiu t2, zero, -1
    sd t2, 0(t0)
    sd t2, 0(t1)
    andi a0, a0, 0x3FFF
    sltiu t0, a0, 0x3F00
    beqz t0, nes_mmc3_ppu_palette_write
    nop
    daddiu sp, sp, -48
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    la t0, global_mapdots
    jal u_mappera12
    ld a1, 0(t0)
    ld a0, 8(sp)
    ld a1, 16(sp)
    sltiu t0, a0, 0x2000
    beqz t0, nes_mmc3_ppu_ciram_write
    nop
    ld ra, 0(sp)
    daddiu sp, sp, 48
    la t0, global_chrwritable
    ld t0, 0(t0)
    beqz t0, nes_mmc3_ppu_write_done
    nop
    j mapperchrwrite
    nop
nes_mmc3_ppu_ciram_write:
    la t0, global_mapntslots
    srl t1, a0, 10
    andi t1, t1, 3
    sll t1, t1, 3
    daddu t0, t0, t1
    ld t0, 0(t0)
    andi t1, a0, 1023
    sll a0, t0, 10
    addu a0, a0, t1
    la t2, global_mapciram
    daddu t2, t2, a0
    lbu t3, 0(t2)
    beq t3, a1, nes_mmc3_ppu_write_restore
    nop
  EndASM
  CompilerIf #NES_RDP_SHOW=0
    ASM
      sd t0, 24(sp)
      sd t1, 32(sp)
      sd t2, 40(sp)
      jal nesinvalidatetilerow
      nop
      ld a1, 16(sp)
      ld t0, 24(sp)
      ld t1, 32(sp)
      ld t2, 40(sp)
    EndASM
  CompilerEndIf
  ASM
    sb a1, 0(t2)
    la t2, global_mapntslots
    addiu t3, t2, 32
    la a0, global_nt
    daddu a0, a0, t1
nes_mmc3_ppu_ciram_alias:
    ld t1, 0(t2)
    bne t1, t0, nes_mmc3_ppu_ciram_next
    addiu t2, t2, 8
    sb a1, 0(a0)
nes_mmc3_ppu_ciram_next:
    bne t2, t3, nes_mmc3_ppu_ciram_alias
    addiu a0, a0, 1024
nes_mmc3_ppu_write_restore:
    ld ra, 0(sp)
    daddiu sp, sp, 48
nes_mmc3_ppu_write_done:
    jr ra
    nop
nes_mmc3_ppu_palette_write:
    andi t0, a0, 0x13
    addiu t1, zero, 0x10
    bne t0, t1, nes_mmc3_ppu_palette_store
    andi a0, a0, 31
    addiu a0, a0, -16
nes_mmc3_ppu_palette_store:
    j neswritepalette
    andi a1, a1, 63
  EndASM

; ---- mappera12, from mmc3_ticks.n64 (N7: moved unchanged) ----
; MMC3 A12 watch on a PPU bus access: a0 the address, a1 the dot clock. A fall records the dot; a rise after
; at least 10 low dots clocks the IRQ counter (u_mapperclockirq, a tail jump). Clobbers t0, t1, a0.
  ASM
u_mappera12:
    srl a0, a0, 12
    la t0, global_mapa12
    ld t1, 0(t0)
    andi a0, a0, 1
    beq a0, t1, mmc3_a12_done
    nop
    sd a0, 0(t0)
    bnez a0, mmc3_a12_rise
    nop
    jr ra
    sd a1, global_maplowsince-global_mapa12(t0)
mmc3_a12_rise:
    ld t1, global_maplowsince-global_mapa12(t0)
    dsubu t1, a1, t1
    slti t1, t1, 10
    bnez t1, mmc3_a12_done
    nop
    j u_mapperclockirq
    nop
mmc3_a12_done:
    jr ra
    nop
  EndASM

; ---- the device read (N7, design note N.40 (3)): NesRead's device half, NesReadPeripheral and the staged
; NesReadRegister in place ----
; In: a0 the guest address, $2000-$3FFF or $4015-$4017 (the core's c65_rd_dev sends only those); out: a0 the
; byte, also NesOpenBus. The pads ($4016 / $4017) go on to the compiled NesReadPeripheral unchanged. A register:
; CpuNow (the stamp), the trace's read fold (checking build), then exactly the staged NesReadRegister - a $2002
; read with the MMC3 IRQ disabled syncs only past the status horizon (NesSetStatusHorizon, compiled, then sets
; a new one); every other register read syncs (the APU alone for $4015); the register; for $2006 / $2007 the
; A12 notice - then CpuEndWindow (Budget -= Left, Left = 0) and NesOpenBus = the byte. WHY: it replaces five
; compiled procedures and stubs outside the unit (NesRead, NesReadPeripheral, CpuNow, NesReadRegister,
; CpuEndWindow, ~150 cycles a read with their misses, N.40). Clobbers what a compiled call may.
  CompilerIf #NES_CPU_ASM           ; the assembly core's call-out only (the compiled core calls NesRead)
  ASM
u_nesreaddev:
    addiu t0, a0, -0x4016
    sltiu t0, t0, 2
    bnez t0, nes_read_pads
    nop
    la t0, global_cpucycles
    ld t1, global_cpuinwindow-global_cpucycles(t0)
    beqz t1, nes_read_stamp
    ld a2, 0(t0)
    ld t1, global_nesrunstart-global_cpucycles(t0)
    ld t2, global_budget-global_cpucycles(t0)
    ld a2, global_left-global_cpucycles(t0)
    daddu t1, t1, t2
    dsubu a2, t1, a2                ; CpuNow(): CpuCycles = NesRunStart + Budget - Left
    sd a2, 0(t0)
nes_read_stamp:
    ld t1, global_accessphase-global_cpucycles(t0)
    daddiu sp, sp, -32
    sd ra, 0(sp)
    daddu a2, a2, t1                ; the stamp: CpuCycles + AccessPhase
    sd a0, 8(sp)
    sd a2, 16(sp)
  EndASM
  CompilerIf #NES_CPU_TRACE
    ASM
      jal nescputraceread           ; checking build: the read folded into the trace, where NesReadPeripheral did
      nop
      ld a0, 8(sp)
      ld a2, 16(sp)
    EndASM
  CompilerEndIf
  ASM
    sltiu t1, a0, 0x4000
    beqz t1, nes_read_apu
    andi t1, a0, 7
    addiu t2, zero, 2
    bne t1, t2, nes_read_synced
    nop
    la t0, global_mapirqenable
    ld t0, 0(t0)
    la t1, global_nesstatushorizon
    bnez t0, nes_read_synced
    ld t1, 0(t1)
    slt t0, t1, a2                  ; stamp > NesStatusHorizon: the status may have changed
    beqz t0, nes_read_status
    nop
    jal u_workeradvance
    move a0, a2
    jal nessetstatushorizon
    ld a0, 16(sp)
nes_read_status:
    jal u_ppuregread                ; PpuRegRead(2)
    addiu a0, zero, 2
    b nes_read_close
    nop
nes_read_synced:
    jal u_workeradvance
    move a0, a2
    jal u_ppuregread                ; PpuRegRead(addr & 7) (u_ppuregread masks the address)
    ld a0, 8(sp)
    ld t0, 8(sp)
    andi t0, t0, 6
    xori t0, t0, 6                  ; 0: register 6 or 7, MapperRegNotice's A12 at v
    bnez t0, nes_read_close
    sd a0, 24(sp)
    la t0, global_ppuv
    ld a0, 0(t0)
    ld a1, global_mapdots-global_ppuv(t0)
    jal u_mappera12
    andi a0, a0, 0x3FFF
    b nes_read_close
    ld a0, 24(sp)
nes_read_apu:                       ; $4015
    jal u_nesmmc3syncapu
    move a0, a2
    jal apureadstatus
    nop
nes_read_close:                     ; a0 = the value: CpuEndWindow, then NesOpenBus = value & 255
    la t0, global_cpucycles
    ld t1, global_cpuinwindow-global_cpucycles(t0)
    beqz t1, nes_read_left
    ld t2, global_left-global_cpucycles(t0)
    ld t1, global_budget-global_cpucycles(t0)
    dsubu t1, t1, t2
    sd t1, global_budget-global_cpucycles(t0)
nes_read_left:
    sd zero, global_left-global_cpucycles(t0)
    andi a0, a0, 0xFF
    la t1, global_nesopenbus
    sd a0, 0(t1)
    ld ra, 0(sp)
    jr ra
    daddiu sp, sp, 32
nes_read_pads:
    j nesreadperipheral
    nop
  EndASM
  CompilerEndIf
