; unit/cold.n64 - pieces of the hot unit's files that run (almost) never, kept in the unit's COLD part
; Part of the hot unit: included inside cpu6502.n64's procedure after its cold part begins (the shipped build) or
; in the holder procedure in mmc3_run.n64 (the reference build), never on its own.
; N7 (design note N.40): moved out of the hot span by MEASURED heat (measured at 0 cycles a guest frame in
; SMB3, frames 0-3600) to make room for the bus handlers; each block is entered by a branch and leaves by one, so its
; place changes no path, only which I-cache set it occupies.

; C6 (design note N.48): the blocks' ORDER is chosen by measured heat - the ones at 0 cycles a guest frame first,
; then the APU write, the wait cache, the coalescing and the DMC bound, so the warm ones lie over the hot span's
; coldest lines (the opcode slot grid); each block is entered by a branch or jal and leaves by one.

; ---- the $2004 port (OAMDATA), from unit/ppu.n64 (C4, N.46b: 0 cycles a guest frame - SMB3 and MM4 fill OAM by
; the $4014 DMA), reached through u_ppuregwrite's / u_ppuregread's tables unchanged. In: a1 the value (write),
; a2 = @PpuBus. ----
  ASM
nes_ppu_write_oam:                  ; Oam(OamAddr) = value : OamAddr + 1 (mod 256) : the sprite cache is dirty
    addiu t0, zero, 1
    sd t0, global_oamcachedirty-global_ppubus(a2)
    ld t0, global_ppuoamaddr-global_ppubus(a2)
    la t1, global_oam
    daddu t1, t1, t0
    sb a1, 0(t1)
    addiu t0, t0, 1
    andi t0, t0, 255
    jr ra
    sd t0, global_ppuoamaddr-global_ppubus(a2)
nes_ppu_read_oam:                   ; PpuBus = Oam(OamAddr), no increment on a read
    ld t0, global_ppuoamaddr-global_ppubus(a2)
    la t1, global_oam
    daddu t1, t1, t0
    lbu a0, 0(t1)
    jr ra
    sd a0, 0(a2)
  EndASM

; ---- the MMC3 register paths that SMB3 never runs (C4, design note N.46b: 0 cycles a guest frame in the record
; replay's profile), moved with u_mapperwrite's dispatch from mmc3_registers.n64 unchanged; reached through its
; table (unit/write.n64). In: a0 address, a1 value. Each leaves by a tail jump or jr ra to u_mapperwrite's caller. ----
  ASM
mmc3_write_select:                  ; $8000: the bank select; a change of the PRG / CHR mode bits remaps
    la t0, global_mapselect
    ld t1, 0(t0)
    sd a1, 0(t0)
    xor t1, t1, a1
    andi t1, t1, 0xC0
    beqz t1, mmc3_write_done        ; only the register index changed
    nop
    j mapperupdate
    nop
mmc3_write_mirror:                  ; $A000: vertical (0) or horizontal (1), not with four-screen VRAM
    la t0, global_mapfourscreen
    ld t1, 0(t0)
    bnez t1, mmc3_write_done
    andi a0, a1, 1
    j mappermirror
    xori a0, a0, 1
mmc3_write_protect:                 ; $A001: bit 7 enables the work RAM, bit 6 protects it
    la t0, global_mapramenable
    srl t1, a1, 7
    srl t2, a1, 6
    andi t1, t1, 1
    andi t2, t2, 1
    sd t1, 0(t0)
    jr ra
    sd t2, global_mapramprotect-global_mapramenable(t0)
  EndASM

; ---- u_apuwrite: the staged ApuWrite's timing half, in assembly (N7, design note N.40 (4)) ----
; WHAT: an APU register write $4000-$4017 (not $4014 / $4016: u_neswrite routes those elsewhere), after
; u_nesmmc3syncapu brought the APU to the write. In: a0 the address, a1 the value (0-255). Exactly the staged
; ApuWrite's stores that anything reads: ApuReg(r) (the DMC's rate, loop and IRQ bits, its start address and
; length, the lengths' halt bits are read from it), the length loads, the DMC IRQ, $4015, $4017, the log
; append (u_apulogwrite: the synthesis's only input) and WorkerIrq. WHY NOT THE REST: SweepReload, ApuPeriod,
; EnvStart, ApuSeq, ApuLinearReload and DmcLevel are the sound half; since N6 the synthesis keeps its own copy
; (NesSynState, filled once by NesSynInit before the guest runs, then from the log) and nothing else in this
; configuration reads them (searched in the staged text, N.40 (4)). WHY ASSEMBLY: it replaces the compiled
; NesWriteRegister + ApuWrite pair outside the unit (~300 cycles a write with their misses); cold, because it
; runs ~7.5 times a frame. Clobbers what a compiled call may; keeps s0-s7, fp.
; HOW, by register r = address - $4000:
;   r < 12, r & 3 = 3 ($4003 / $4007 / $400B), and r = 15 ($400F, the noise, channel 3): if the channel is
;     enabled (ApuEnable bit ch), ApuLength(ch) = LengthTable(value >> 3)
;   r = 16 ($4010): bit 7 clear turns the DMC IRQ off
;   r = 21 ($4015): ApuEnable = value & 31, DmcIrq = 0, the lengths of the disabled channels 0; bit 4 clear
;     stops the sample (DmcBytes = 0); set with no sample playing starts one (DmcAddress = $C000 + ApuReg(18) x
;     64, DmcBytes = ApuReg(19) x 16 + 1) and fetches its first byte (u_apudmcfetch, unchanged)
;   r = 23 ($4017): ApuFive = bit 7, ApuInhibit = bit 6 (which clears the frame IRQ), the reset delay 3 + the
;     parity of WorkerClock
; CHECKED BY: the oracles' WAV byte for byte (the log is the synthesis's input) and checkpoints, the digests.
  ASM
u_apuwrite:
    addiu a0, a0, -0x4000           ; r
    sltiu t0, a0, 24
    beqz t0, apuw_ret               ; not an APU register (the staged ApuWrite's own guard)
    nop
    daddiu sp, sp, -32
    sd ra, 0(sp)
    sd a0, 8(sp)
    sd a1, 16(sp)
    la t0, global_apureg
    addu t0, t0, a0
    sb a1, 0(t0)                    ; ApuReg(r) = value
    sltiu t0, a0, 12
    beqz t0, apuw_high
    andi t1, a0, 3
    xori t1, t1, 3
    bnez t1, apuw_log               ; $4000-$400B other than the length registers: the sound half only
    srl t1, a0, 2                   ; the channel
    b apuw_length
    nop
apuw_high:
    addiu t1, zero, 15
    bne a0, t1, apuw_not_noise
    addiu t1, zero, 3               ; the noise is channel 3
apuw_length:                        ; t1 = ch
    la t0, global_apuenable
    ld t0, 0(t0)
    srlv t0, t0, t1
    andi t0, t0, 1
    beqz t0, apuw_log               ; channel disabled: the length is not loaded
    srl t2, a1, 3
    la t0, global_lengthtable
    addu t0, t0, t2
    lbu t2, 0(t0)                   ; LengthTable(value >> 3)
    la t0, global_apulength
    sll t1, t1, 3
    daddu t0, t0, t1
    b apuw_log
    sd t2, 0(t0)                    ; ApuLength(ch)
apuw_not_noise:
    addiu t1, zero, 16
    bne a0, t1, apuw_not_4010
    andi t0, a1, 0x80
    bnez t0, apuw_log               ; $4010 with the IRQ enabled: nothing more
    nop
    la t0, global_dmcirq
    b apuw_log
    sd zero, 0(t0)                  ; DmcIrq = 0
apuw_not_4010:
    addiu t1, zero, 21
    bne a0, t1, apuw_not_4015
    nop
    andi t0, a1, 31
    la t2, global_apuenable
    sd t0, 0(t2)                    ; ApuEnable = value & 31
    la t2, global_dmcirq
    sd zero, 0(t2)                  ; DmcIrq = 0
    la t2, global_apulength
    move t1, zero
apuw_clear:                         ; For ch = 0 To 3: a disabled channel's length is 0
    srlv t3, a1, t1
    andi t3, t3, 1
    bnez t3, apuw_kept
    sll t3, t1, 3
    daddu t3, t2, t3
    sd zero, 0(t3)
apuw_kept:
    addiu t1, t1, 1
    sltiu t3, t1, 4
    bnez t3, apuw_clear
    nop
    andi t0, a1, 16
    la t2, global_dmcbytes
    bnez t0, apuw_dmc_on
    ld t1, 0(t2)
    b apuw_log
    sd zero, 0(t2)                  ; bit 4 clear: the sample stops
apuw_dmc_on:
    bnez t1, apuw_log               ; a sample already playing goes on
    nop
    la t0, global_apureg
    lbu t1, 18(t0)
    lbu t3, 19(t0)
    sll t1, t1, 6
    ori t0, zero, 0xC000
    addu t1, t1, t0                 ; DmcAddress = $C000 + ApuReg(18) x 64
    sll t3, t3, 4
    addiu t3, t3, 1                 ; DmcBytes = ApuReg(19) x 16 + 1
    sd t3, 0(t2)
    la t0, global_dmcaddress
    jal u_apudmcfetch               ; ApuDmcFetch(): the first byte
    sd t1, 0(t0)
    b apuw_log
    nop
apuw_not_4015:
    addiu t1, zero, 23
    bne a0, t1, apuw_log
    srl t0, a1, 7
    andi t0, t0, 1
    la t2, global_apufive
    sd t0, 0(t2)                    ; ApuFive = (value >> 7) & 1
    srl t0, a1, 6
    andi t0, t0, 1
    la t2, global_apuinhibit
    beqz t0, apuw_delay
    sd t0, 0(t2)                    ; ApuInhibit = (value >> 6) & 1
    la t2, global_apuframeirq
    sd zero, 0(t2)                  ; the inhibit clears the frame IRQ
apuw_delay:
    la t2, global_workerclock
    ld t0, 0(t2)
    andi t0, t0, 1
    addiu t0, t0, 3
    la t2, global_apuresetdelay
    sd t0, 0(t2)                    ; ApuResetDelay = 3 + (WorkerClock & 1)
apuw_log:
    ld a0, 8(sp)
    jal u_apulogwrite               ; NesApuLogWrite(r, value) (a leaf: t0-t3, a0-a3)
    ld a1, 16(sp)
    la t0, global_apuframeirq
    ld t0, 0(t0)
    la t1, global_dmcirq
    ld t1, 0(t1)
    or t0, t0, t1
    la t1, global_workerirq
    sd t0, 0(t1)                    ; WorkerIrq = ApuFrameIrq | DmcIrq
    ld ra, 0(sp)
    daddiu sp, sp, 32
apuw_ret:
    jr ra
    nop
  EndASM

; ---- the RAM-wait rule's hashed cache (from unit/window.n64, u_nesramwaitrule's leaf): used when the image left
; no room for the immutable index, or for a PC whose bank has more than 254 rules; 0 cycles a guest frame in SMB3
; (the C2 record replay's profile), moved here by C3 (N.46). In: t0 = PC, t1 = its PRG bank; out: a2 = the rule (0: none), by jr ra
; to u_nesramwaitrule's caller. The miss decodes the rule (the compiled NesRamWaitRule) and fills the entry; it
; keeps a0, a1 and a5 (u_nesramcpuwindow's link) as the leaf promises. ----
  ASM
nes_mmc3_wait_cache_lookup:
    sll t2, t1, 16
    or t2, t2, t0
    srl t3, t0, 6
    xor t3, t3, t0
    xor t3, t3, t1
    andi t3, t3, 1023
    sll t3, t3, 3
    la t1, global_nesmmc3waitcache
    addu t3, t3, t1
    lw t1, 0(t3)
    bne t1, t2, nes_mmc3_wait_miss
    lw a2, 4(t3)
    jr ra
    nop
nes_mmc3_wait_miss:
    daddiu sp, sp, -48
    sd ra, 32(sp)
    sd a0, 24(sp)
    sd a1, 16(sp)
    sd t3, 8(sp)
    sd t2, 0(sp)
    sd a5, 40(sp)
    jal nesramwaitrule
    or a0, t0, zero
    or a2, a0, zero
    ld t2, 0(sp)
    ld t3, 8(sp)
    ld a1, 16(sp)
    ld a0, 24(sp)
    ld a5, 40(sp)
    ld ra, 32(sp)
    sw t2, 0(t3)
    sw a2, 4(t3)
    jr ra
    daddiu sp, sp, 48
  EndASM

; ---- mmc3_sign_coalesce: whole periods of like idle windows skipped (C3, design note N.46) ----
; WHAT: u_nesmmc3signwait, about to commit a full (128-cycle) window of an `LDA zp / Bxx` wait, first skips every
; whole period of the window pattern that would follow it unchanged: NesRamWaitPeriods' row for the loop's
; branch cycles and the phase the window starts in (258 cycles / 86 instructions without a page cross) - the
; table and the rule the reference's own coalescing (ramwait.n64, NesRamWaitBatch's `coalesce`) uses.
; WHY EXACT: between two device accesses nothing changes the state these windows read, so each would repeat
; the same steps, and each end would do only what the catch-up's fast path does: CpuCycles, WorkerClock = that
; end, both horizons -1. That holds while (1) both horizons are behind the window's start (so every end calls
; the catch-up), (2) no IRQ is asserted and no sample plays (the budget stays 128, no stall), (3) every end is
; before H = min(the render limit + 1, the APU limit, the A12 fetch limit while the IRQ is enabled) - all three
; known (none -1). The budget is 128 at every skipped start: with the IRQ counting, a fetch limit ahead means 40
; or more rises to go, so (count - 1) x 10 dots >= 384 and the budget is the full window. NMI, IRQ, frame and
; stop tests at those ends see the state unchanged. The window at the run's end is then batched as the caller
; computed it (the phase is the same after whole periods), from the later start.
; THE PLAIN TWIN:
;   If NesStatusHorizon<CpuCycles And NesCpuHorizon<CpuCycles And MapIrq=0 And WorkerIrq=0 And DmcBytes=0 And
;      RenderLimit>=0 And ApuLimit>=0 And (MapIrqEnable=0 Or FetchLimit>=0)
;     h=Min(RenderLimit+1,ApuLimit) : If MapIrqEnable : h=Min(h,FetchLimit) : EndIf
;     row=((branchCycles-3)*2+atBranch)*4 : loops=(h-1-CpuCycles)/PeekU(?NesRamWaitPeriods+row)
;     If loops>0
;       CpuCycles+loops*PeekU(?NesRamWaitPeriods+row) : WorkerClock=CpuCycles
;       NesStatusHorizon=-1 : NesCpuHorizon=-1
;       NesInstructions+loops*PeekU(?NesRamWaitPeriods+row+2) : NesIdleBatched+(the same)
;     EndIf
;   EndIf
; In: a0 = 128, a1 = @PC, a2 = the rule (bit 26: the window starts at the branch), t9 = the branch's cycles.
; Keeps a0, a1, a5, a6, t9 (the caller's window); clobbers t1-t3, t8, a3, a4. Back to mmc3_sign_window.
  ASM
mmc3_sign_coalesce:
    la t8, global_cpucycles
    ld t2, 0(t8)                    ; s, this window's start
    ld t3, global_nesstatushorizon-global_cpucycles(t8)
    slt t3, t3, t2
    beqz t3, mmc3_sign_window       ; a horizon ahead: the ends would not all catch up
    ld t3, global_nescpuhorizon-global_cpucycles(t8)
    slt t3, t3, t2
    beqz t3, mmc3_sign_window
    ld t3, global_mapirq-global_cpucycles(t8)
    ld a3, global_workerirq-global_cpucycles(t8)
    or t3, t3, a3
    ld a3, global_dmcbytes-global_cpucycles(t8)
    or t3, t3, a3
    bnez t3, mmc3_sign_window       ; an IRQ asserted, or a sample playing
    nop
    la t1, global_nesmmc3apuclock
    ld t3, global_nesmmc3renderlimit-global_nesmmc3apuclock(t1)
    bltz t3, mmc3_sign_window       ; not known
    daddiu t3, t3, 1                ; an end may be AT the render limit (the catch-up syncs past it)
    ld a3, global_nesmmc3apulimit-global_nesmmc3apuclock(t1)
    bltz a3, mmc3_sign_window
    slt a4, a3, t3
    beqz a4, mmc3_coalesce_fetch
    nop
    move t3, a3
mmc3_coalesce_fetch:
    ld a3, global_mapirqenable-global_nesmmc3apuclock(t1)
    beqz a3, mmc3_coalesce_count
    ld a3, global_nesmmc3fetchlimit-global_nesmmc3apuclock(t1)
    bltz a3, mmc3_sign_window
    slt a4, a3, t3
    beqz a4, mmc3_coalesce_count
    nop
    move t3, a3
mmc3_coalesce_count:
    dsubu t3, t3, t2
    daddiu t3, t3, -1               ; the cycles the skipped ends may cover: every end < H
    blez t3, mmc3_sign_window
    addiu a3, t9, -3                ; the period's row: the read is 3 cycles (LDA zp)
    sll a3, a3, 1
    srl a4, a2, 26
    andi a4, a4, 1
    addu a3, a3, a4
    sll a3, a3, 2
    la a4, nesramwaitperiods
    addu a3, a3, a4
    lhu a4, 0(a3)                   ; the period's cycles
    lhu a3, 2(a3)                   ; its instructions
    ddivu t3, a4
    mflo t3                         ; whole periods
    nop
    nop
    blez t3, mmc3_sign_window
    nop
    dmultu t3, a4
    mflo a4                         ; the cycles skipped
    nop
    nop
    dmultu t3, a3
    mflo a3                         ; the instructions they retire
    daddu t2, t2, a4
    sd t2, 0(t8)                    ; CpuCycles: the window at the run's end starts here
    la t1, global_workerclock
    sd t2, 0(t1)                    ; the last skipped end's catch-up
    daddiu t3, zero, -1
    sd t3, global_nesstatushorizon-global_cpucycles(t8)
    sd t3, global_nescpuhorizon-global_cpucycles(t8)
    ld t3, global_nesinstructions-global_cpucycles(t8)
    daddu t3, t3, a3
    sd t3, global_nesinstructions-global_cpucycles(t8)
    ld t3, global_nesidlebatched-global_cpucycles(t8)
    daddu t3, t3, a3
    b mmc3_sign_window
    sd t3, global_nesidlebatched-global_cpucycles(t8)
  EndASM

; ---- the PPU register jump table (C6, design note N.48a: out of the hot span; data, never fetched as instructions).
; C7 (design note N.49): it is the SOURCE of the copy in NesUnitData (nes.n64, NesUnitTables, at load), which the
; dispatch reads; this one is read only at load. It stands here, before the DMC bound, so that the bound lies one
; I-cache line further on (its third line was on the BNE slot c65_op_d0: N.48b). The code before ends in b with
; its delay slot; the DMC bound after is entered by a branch from window.n64 only. ----
  ASM
    .align 2
nes_ppu_write_table:
    .word nes_ppu_write_ctrl, nes_ppu_write_mask, nes_ppu_port_done, nes_ppu_write_oamaddr
    .word nes_ppu_write_oam, nes_ppu_write_scroll, nes_ppu_write_addr, nes_ppu_write_data
  EndASM

; ---- mmc3_budget_dmc: the window bounded by the next DMC fetch (C3b, the owner's ruling, design note N.46) ----
; WHAT: u_mappercpubudget's exit with a sample playing: the budget becomes min(budget, F - CpuCycles), F the next
; byte fetch's cycle = NesMmc3ApuClock + DmcTimer + (DmcBits - 1) x period (the APU limit's own formula,
; mmc3_cpu_apu_dmc); an empty buffer with bytes left fetches at once: 1. So the window ends at the first
; instruction boundary at or after F, the catch-up there takes the fetch (an advance to exactly F takes the edge)
; and the stall is applied at that end, 0-6 cycles after F instead of 0-134. Cold: only while a sample plays.
; THE PLAIN TWIN:
;   If DmcEmpty : n=1 : Else : d=DmcTimer+(DmcBits-1)*DmcTable(ApuReg(16)&15)-(CpuCycles-NesMmc3ApuClock)
;     If d<n : n=d : EndIf : If n<1 : n=1 : EndIf : EndIf
; In: a0 = the budget, a1 = @MapIrq. Out: a0. Clobbers t0-t3.
  ASM
mmc3_budget_dmc:
    ld t0, global_dmcempty-global_mapirq(a1)
    bnez t0, mmc3_budget_dmc_one
    nop
    la t2, global_apureg            ; $4010's rate ...
    lbu t2, 16(t2)
    la t3, global_dmctable
    andi t2, t2, 15
    sll t2, t2, 1
    daddu t3, t3, t2
    lhu t3, 0(t3)                   ; ... its period in CPU cycles
    ld t2, global_dmcbits-global_mapirq(a1)
    addiu t2, t2, -1
    multu t2, t3                    ; (bits - 1) x period
    ld t1, global_dmctimer-global_mapirq(a1)
    ld t2, global_cpucycles-global_mapirq(a1)
    ld t3, global_nesmmc3apuclock-global_mapirq(a1)
    dsubu t2, t2, t3                ; the APU's lag behind the window's start
    mflo t0
    daddu t0, t0, t1
    dsubu t0, t0, t2                ; d = F - CpuCycles
    slt t1, t0, a0
    beqz t1, mmc3_budget_dmc_min
    nop
    move a0, t0
mmc3_budget_dmc_min:
    blez a0, mmc3_budget_dmc_one
    nop
    jr ra
    nop
mmc3_budget_dmc_one:
    jr ra
    addiu a0, zero, 1
  EndASM

; ---- moved out of the hot span to shrink it (C6, design note N.48a): the OAM DMA's stall outside a window (0 cycles
; a guest frame in SMB3 and MM4) and the mapper register jump table (data, never fetched as instructions; since C7,
; design note N.49, only the SOURCE of NesUnitData's copy, read at load). The stall is entered by a branch from
; write.n64; the code before it (the DMC bound) ends in jr with its delay slot, so the order changes no path. ----
  ASM
nes_mmc3_bus_write_stall:
    ld t2, global_nesstall-global_cpucycles(t0)
    daddu t1, t1, t2
    b nes_mmc3_bus_write_close_done
    sd t1, global_nesstall-global_cpucycles(t0)
  EndASM

; ---- moved out of the hot span to make room for the mapper slot (mapper-modules design note, section 8), each 0
; cycles a guest frame in the step-1 measuring run (rdp-m1-cart's profile), unchanged but for the one branch noted:
; nes_mmc3_bus_write_ram, the internal-RAM write of u_neswrite (the core stores RAM inline; only outside callers of
; NesWrite reach it), entered by branch from write.n64 and leaving by jr; mmc3_sign_div_seven, the RAM-wait sign's
; divide for a seven-cycle loop (window.n64), entered by branch, which used to fall into mmc3_sign_charge and now
; branches there (+1 instruction and its delay slot, on a path that does not run); mmc3_masked_frame, the masked
; budget's distance past the visible lines (window.n64), the same way (its hot side: bgtz-not-taken became blez-taken,
; one instruction either way). ----
  ASM
nes_mmc3_bus_write_ram:
    la t0, global_m
    andi a0, a0, 0x7FF
    addu t0, t0, a0
    jr ra
    sb a1, 0(t0)
mmc3_sign_div_seven:
    addiu t2, zero, 147
    multu a4, t2
    mflo t2
    b mmc3_sign_charge
    srl t2, t2, 10
mmc3_worker_backwards:              ; u_workeradvance asked to go back in time (advance.n64): the stop, WorkerError 20
    addiu t0, zero, 20              ; (a1 = @NesMmc3ApuClock, as at the branch)
    jr ra
    sd t0, global_workererror-global_nesmmc3apuclock(a1)
mmc3_masked_frame:                  ; the masked budget's distance past line 241 (window.n64): it used to lie between
    la t0, global_ppupreline        ; its two entries, the bltz and the not-taken bgtz (now a taken blez) of
    ld t0, 0(t0)                    ; mmc3_masked_raster, and fall into mmc3_masked_distance; it now branches there
    addiu t0, t0, 1
    subu t0, t0, t1
    mult t0, t3
    mflo t0
    subu t0, t0, t2
    b mmc3_masked_distance
    addiu t0, t0, -1
  EndASM
  ASM
    .align 2
mmc3_write_table:
    .word mmc3_write_select, mmc3_write_data, mmc3_write_mirror, mmc3_write_protect
    .word mmc3_write_latch, mmc3_write_reload, mmc3_write_ack, mmc3_write_enable
  EndASM
