; THE DMC'S TIMING, SHADOWED ON CORE 0. Core 1 plays the DMC (apu.pico: the timer, ApuDmcFetch,
; the output level). Core 0 needs only its effects on the CPU: four stall cycles per sample fetch
; and the IRQ when a non-looping sample runs out. Both follow from the DMC registers - written by
; core 0 - and the timer, so core 0 runs the same timer and fetch counter here, without reading
; the sample bytes, and no longer waits for core 1 at every sync while a sample plays (Mr.
; Gimmick plays DPCM nonstop: core 0 lost ~560 ms a second to those waits).
; It mirrors apu.pico exactly: the timer reload from $4010's rate, a fetch at each byte boundary
; when the buffer was full, the length and loop/IRQ rule of ApuDmcFetch, and $4010/$4015's effect
; on the IRQ. Both start from the power-on values (timer 428, 8 bits, empty) at CPU time 0. The
; once-a-second stats line checks it against core 1 (dmc_drift; 0 when they agree).
Global SdTimer.i=428, SdBits.i=8, SdEmpty.i=1, SdBytes.i, SdIrq.i, SdClock.i, SdFetches.i
Global SdReg16.i, SdReg19.i, SdDrift.i

Procedure SdFetch()
  If SdEmpty<>0 And SdBytes>0
    SdEmpty=0 : SdFetches=SdFetches+1 : SdBytes=SdBytes-1
    If SdBytes=0
      If SdReg16&$40
        SdBytes=SdReg19*16+1
      ElseIf SdReg16&$80
        SdIrq=1
      EndIf
    EndIf
  EndIf
EndProcedure

; The shadow up to CPU time stamp. With the buffer empty no fetch can come before a register write
; (a byte boundary only fetches after emptying a full buffer), so NesSync leaves the shadow alone
; then, and the next advance winds the timer and bit count on in one step.
Procedure SdAdvance(stamp.i)
  Protected dt.i,period.i,ticks.i
  dt=stamp-SdClock
  If dt<=0 : ProcedureReturn : EndIf
  SdClock=stamp : SdTimer=SdTimer-dt
  If SdEmpty<>0 And SdTimer<=0
    period=DmcTable(SdReg16&15) : ticks=NesDiv(-SdTimer,period)+1
    SdTimer=SdTimer+ticks*period : SdBits=((SdBits-1-(ticks&7))&7)+1
  EndIf
  While SdTimer<=0
    SdTimer=SdTimer+DmcTable(SdReg16&15)
    SdBits=SdBits-1
    If SdBits=0
      SdBits=8
      If SdEmpty=0 : SdEmpty=1 : SdFetch() : EndIf
    EndIf
  Wend
EndProcedure

; A write to $4010, $4013 or $4015 at CPU time stamp (core 1 gets the same write at the same time).
Procedure SdWrite(addr.i,value.i,stamp.i)
  SdAdvance(stamp)
  If addr=$4010
    SdReg16=value
    If (value&$80)=0 : SdIrq=0 : EndIf
  ElseIf addr=$4013
    SdReg19=value
  ElseIf addr=$4015
    SdIrq=0
    If (value&16)=0
      SdBytes=0
    ElseIf SdBytes=0
      SdBytes=SdReg19*16+1 : SdFetch()
    EndIf
  EndIf
EndProcedure

; CPU cycles before the shadow's IRQ can rise (256 when no IRQ is coming soon): the fetch that empties
; a non-looping sample with IRQ on comes at the next byte boundary.
Procedure.i SdBudget()
  Protected cycles.i
  If (SdReg16&$C0)<>$80 Or SdBytes<>1 Or SdEmpty<>0 Or SdIrq<>0 Or FI<>0 : ProcedureReturn 256 : EndIf
  cycles=SdTimer+(SdBits-1)*DmcTable(SdReg16&15)-(CpuCycles-SdClock)
  If cycles<1 : cycles=1 : EndIf
  If cycles>256 : cycles=256 : EndIf
  ProcedureReturn cycles
EndProcedure

; ---------------------------------------------------------------- the APU's status, shadowed too
; A $4015 read used to wait for core 1 (NesRpc) to answer it. Sound drivers poll it - Nobunaga's
; Ambition 2 ~20,000 times a second for seconds at a time - and every read cost core 0 a round trip.
; Its answer follows from core 0's own writes and the frame sequencer, so core 0 keeps them here: the
; sequencer (clock, step, $4017's mode, inhibit and reset delay), the four length counters with their
; halt bits, the enables and the frame IRQ - mirroring apu.pico's ApuAdvance (without the sample
; clipping, which changes nothing here), ApuWrite, ApuHalf and ApuReadStatus. The read clears the frame
; IRQ here and is posted to core 1, which clears its own at the same CPU time. NesSync takes the frame
; IRQ from here too. The stats line checks it all against core 1 once a second (apu_drift).
Global SaClock.i, SaEnable.i, SaFive.i, SaInhibit.i, SaFrameIrq.i, SaFrameClock.i, SaFrameStep.i
Global SaResetDelay.i, SaDrift.i
Global Dim SaLength.i(4)
Global Dim SaHalt.i(4)

Procedure SaHalf()
  Protected c.i
  For c=0 To 3
    If SaLength(c)>0 And SaHalt(c)=0 : SaLength(c)=SaLength(c)-1 : EndIf
  Next
EndProcedure

; The shadow up to CPU time stamp.
ProcedureRAM SaAdvance(stamp.i)
  Protected dt.i,stepCycles.i,event.i
  dt=stamp-SaClock
  If dt<=0 : ProcedureReturn : EndIf
  SaClock=stamp
  While dt>0
    stepCycles=dt
    If SaResetDelay>0 And stepCycles>SaResetDelay : stepCycles=SaResetDelay : EndIf
    event=ApuStep1
    If SaFrameStep=1
      event=ApuStep2
    ElseIf SaFrameStep=2
      event=ApuStep3
    ElseIf SaFrameStep=3
      event=ApuStep4 : If SaFive : event=ApuStep5 : EndIf
    EndIf
    If stepCycles>event-SaFrameClock : stepCycles=event-SaFrameClock : EndIf
    SaFrameClock=SaFrameClock+stepCycles
    If SaResetDelay>0
      SaResetDelay=SaResetDelay-stepCycles
      If SaResetDelay=0
        SaFrameClock=0 : SaFrameStep=0
        If SaFive : SaHalf() : EndIf
      EndIf
    EndIf
    If SaFrameClock>=event
      If SaFrameStep=1 Or SaFrameStep=3 : SaHalf() : EndIf
      SaFrameStep=SaFrameStep+1
      If SaFrameStep=4
        If SaFive=0 And SaInhibit=0 : SaFrameIrq=1 : EndIf
        SaFrameClock=SaFrameClock-event-1 : SaFrameStep=0
      EndIf
    EndIf
    dt=dt-stepCycles
  Wend
EndProcedure

; A write to $4000-$4017 at CPU time stamp (core 1 gets the same write at the same time).
Procedure SaWrite(addr.i,value.i,stamp.i)
  Protected r.i,ch.i
  SaAdvance(stamp) : r=addr-$4000
  If r=0 Or r=4 Or r=12
    SaHalt(r>>2)=value&$20
  ElseIf r=8
    SaHalt(2)=value&$80
  ElseIf r=3 Or r=7 Or r=11 Or r=15
    ch=r>>2
    If (SaEnable>>ch)&1 : SaLength(ch)=LengthTable(value>>3) : EndIf
  ElseIf r=21
    SaEnable=value&31
    For ch=0 To 3
      If ((value>>ch)&1)=0 : SaLength(ch)=0 : EndIf
    Next
  ElseIf r=23
    SaFive=(value>>7)&1 : SaInhibit=(value>>6)&1
    If SaInhibit : SaFrameIrq=0 : EndIf
    SaResetDelay=3+(stamp&1)
  EndIf
EndProcedure

; A $4015 read at CPU time stamp: ApuReadStatus's answer, without asking core 1.
Procedure.i SaRead(stamp.i)
  Protected v.i,c.i
  SaAdvance(stamp) : SdAdvance(stamp)
  v=(SaFrameIrq<<6)|(SdIrq<<7)
  For c=0 To 3
    If SaLength(c)>0 : v=v|(1<<c) : EndIf
  Next
  If SdBytes>0 : v=v|16 : EndIf
  SaFrameIrq=0
  ProcedureReturn v
EndProcedure
