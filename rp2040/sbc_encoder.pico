; Fixed-point SBC: 48 kHz, 8 subbands, 16 blocks, loudness, bitpool 28.
; Mono is 64 bytes/frame; duplicated-channel stereo is 68 bytes/frame.
; Analysis and quantizer follow SBC's mathematical filterbank/bitstream format.
; Prototype coefficient values are tabulated by A2DP and cross-checked against
; BlueZ sbc_tables.h (LGPL-2.1-or-later); cosine coefficients are generated.
Global Dim SbcPcm.w(128)
Global Dim SbcHistory.w(80)
Global Dim SbcSub.w(128)
Global Dim SbcY.i(16)
Global Dim SbcScale.a(16)
Global Dim SbcBits.a(16)
Global Dim SbcNeed.i(16)
Global Dim SbcEncoded.a(68)
Global SbcStereo.i
Global SbcAcc.i, SbcShift.i, SbcBitValue.i, SbcBitCount.i, SbcByte.i
ProcedureRAM SbcAllocate()
  Protected k.i, maximum.i, slice.i, count.i, pending.i, v.i, index.i
  maximum= -5
  For k=0 To 7+SbcStereo*8
    If SbcScale(k)=0
      SbcNeed(k)= -5
    Else
      v=SbcScale(k)-PeekB(?SbcOffsets+(k&7))
      If v>0 : v=v>>1 : EndIf
      SbcNeed(k)=v
    EndIf
    If SbcNeed(k)>maximum : maximum=SbcNeed(k) : EndIf
  Next
  slice=maximum+1 : count=0 : pending=0
  Repeat
    slice=slice-1 : count=count+pending : pending=0
    For k=0 To 7+SbcStereo*8
      v=SbcNeed(k)
      If v>slice+1 And v<slice+16
        pending=pending+1
      ElseIf v=slice+1
        pending=pending+2
      EndIf
    Next
  Until count+pending>=28
  If count+pending=28 : count=count+pending : slice=slice-1 : EndIf
  For k=0 To 7+SbcStereo*8
    SbcBits(k)=0
    If SbcNeed(k)>=slice+2
      v=SbcNeed(k)-slice : If v>16 : v=16 : EndIf
      SbcBits(k)=v
    EndIf
  Next
  k=0
  While count<28 And k<8+SbcStereo*8
    index=k
    If SbcStereo : index=(k>>1)|((k&1)<<3) : EndIf
    If SbcBits(index)>=2 And SbcBits(index)<16
      SbcBits(index)=SbcBits(index)+1 : count=count+1
    ElseIf SbcNeed(index)=slice+1 And 28>count+1
      SbcBits(index)=2 : count=count+2
    EndIf
    k=k+1
  Wend
  k=0
  While count<28 And k<8+SbcStereo*8
    index=k
    If SbcStereo : index=(k>>1)|((k&1)<<3) : EndIf
    If SbcBits(index)<16 : SbcBits(index)=SbcBits(index)+1 : count=count+1 : EndIf
    k=k+1
  Wend
EndProcedure
Global SbcProtoPtr.i, SbcCosPtr.i, SbcCosEnd.i, SbcAnalysisBlock.i
; Linear analysis window: samples 0..127 are this frame (newest first), 128..207
; the previous 80. Block b's 80-sample window starts at (15-b)*8, so history is
; copied once per frame instead of shifted for every block. The 16-term
; matrixing uses the table's exact symmetries (cols i/8-i equal, 12 zero,
; i/24-i negated) as 8 terms; integer sums are unchanged.
Global Dim SbcWindow.i(104)
Global Dim SbcZ.i(8)
ProcedureRAM SbcAnalyze()
  SbcProtoPtr=?SbcProto : SbcCosPtr=?SbcCos8 : SbcCosEnd=SbcCosPtr+128
  ASM
    push {r7}
    ldr r0, =global_sbchistory
    ldr r1, =global_sbcwindow
    adds r1, #255
    adds r1, #1
    movs r2, #0
__sbc_history_in:
    ldrh r3, [r0, r2]
    strh r3, [r1, r2]
    adds r2, #2
    cmp r2, #160
    blo __sbc_history_in
    ldr r0, =global_sbcpcm
    ldr r1, =global_sbcwindow
    movs r2, #0
__sbc_reverse:
    movs r3, #254
    subs r3, r3, r2
    ldrh r4, [r0, r3]
    strh r4, [r1, r2]
    adds r2, #2
    cmp r2, #254
    bls __sbc_reverse
    movs r0, #0
    ldr r1, =global_sbcanalysisblock
    str r0, [r1]
__sbc_analysis_block:
    ldr r0, =global_sbcanalysisblock
    ldr r0, [r0]
    movs r4, #15
    subs r4, r4, r0
    lsls r4, r4, #4
    ldr r0, =global_sbcwindow
    adds r4, r4, r0
    ldr r5, =global_sbcy
    movs r6, #0
__sbc_polyphase:
    movs r0, r4
    adds r0, r0, r6
    ldr r1, =global_sbcprotoptr
    ldr r1, [r1]
    adds r1, r1, r6
    movs r2, #0
    movs r3, #0
    ldrsh r3, [r0, r3]
    movs r7, #0
    ldrsh r7, [r1, r7]
    muls r3, r7
    adds r2, r2, r3
    adds r0, #32
    adds r1, #32
    movs r3, #0
    ldrsh r3, [r0, r3]
    movs r7, #0
    ldrsh r7, [r1, r7]
    muls r3, r7
    adds r2, r2, r3
    adds r0, #32
    adds r1, #32
    movs r3, #0
    ldrsh r3, [r0, r3]
    movs r7, #0
    ldrsh r7, [r1, r7]
    muls r3, r7
    adds r2, r2, r3
    adds r0, #32
    adds r1, #32
    movs r3, #0
    ldrsh r3, [r0, r3]
    movs r7, #0
    ldrsh r7, [r1, r7]
    muls r3, r7
    adds r2, r2, r3
    adds r0, #32
    adds r1, #32
    movs r3, #0
    ldrsh r3, [r0, r3]
    movs r7, #0
    ldrsh r7, [r1, r7]
    muls r3, r7
    adds r2, r2, r3
    asrs r2, r2, #16
    str r2, [r5]
    adds r5, #4
    adds r6, #2
    cmp r6, #32
    blo __sbc_polyphase
    ldr r0, =global_sbcy
    ldr r1, =global_sbcz
    ldr r2, [r0, #0]
    ldr r3, [r0, #32]
    adds r2, r2, r3
    str r2, [r1, #0]
    ldr r2, [r0, #4]
    ldr r3, [r0, #28]
    adds r2, r2, r3
    str r2, [r1, #4]
    ldr r2, [r0, #8]
    ldr r3, [r0, #24]
    adds r2, r2, r3
    str r2, [r1, #8]
    ldr r2, [r0, #12]
    ldr r3, [r0, #20]
    adds r2, r2, r3
    str r2, [r1, #12]
    ldr r2, [r0, #16]
    str r2, [r1, #16]
    ldr r2, [r0, #36]
    ldr r3, [r0, #60]
    subs r2, r2, r3
    str r2, [r1, #20]
    ldr r2, [r0, #40]
    ldr r3, [r0, #56]
    subs r2, r2, r3
    str r2, [r1, #24]
    ldr r2, [r0, #44]
    ldr r3, [r0, #52]
    subs r2, r2, r3
    str r2, [r1, #28]
    ldr r6, =global_sbcanalysisblock
    ldr r6, [r6]
    lsls r6, r6, #4
    ldr r0, =global_sbcsub
    adds r6, r6, r0
    ldr r1, =global_sbccosptr
    ldr r1, [r1]
__sbc_dct:
    ldr r4, =global_sbcz
    movs r2, #0
    ldr r3, [r4, #0]
    movs r0, #0
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    ldr r3, [r4, #4]
    movs r0, #2
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    ldr r3, [r4, #8]
    movs r0, #4
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    ldr r3, [r4, #12]
    movs r0, #6
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    ldr r3, [r4, #16]
    movs r0, #8
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    ldr r3, [r4, #20]
    movs r0, #10
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    ldr r3, [r4, #24]
    movs r0, #12
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    ldr r3, [r4, #28]
    movs r0, #14
    ldrsh r7, [r1, r0]
    muls r3, r7
    adds r2, r2, r3
    adds r1, #16
    asrs r2, r2, #12
    ldr r0, =32767
    cmp r2, r0
    ble __sbc_clip_negative
    movs r2, r0
__sbc_clip_negative:
    rsbs r0, r0, #0
    cmp r2, r0
    bge __sbc_store_subband
    movs r2, r0
__sbc_store_subband:
    strh r2, [r6]
    adds r6, #2
    ldr r0, =global_sbccosend
    ldr r0, [r0]
    cmp r1, r0
    blo __sbc_dct
    ldr r0, =global_sbcanalysisblock
    ldr r1, [r0]
    adds r1, #1
    str r1, [r0]
    cmp r1, #16
    bhs __sbc_analysis_done
    b __sbc_analysis_block
__sbc_analysis_done:
    ldr r0, =global_sbcwindow
    ldr r1, =global_sbchistory
    movs r2, #0
__sbc_history_out:
    ldrh r3, [r0, r2]
    strh r3, [r1, r2]
    adds r2, #2
    cmp r2, #160
    blo __sbc_history_out
    pop {r7}
  EndASM
EndProcedure
; Scale factor per subband: smallest s (<=15) with every |sample| < 2^(s+1).
; Channel 1 of duplicated stereo shares channel 0's factors.
ProcedureRAM SbcScaleFactors()
  ASM
    push {r7}
    movs r5, #0
__sf_subband:
    ldr r4, =global_sbcsub
    lsls r0, r5, #1
    adds r4, r4, r0
    movs r6, #0
    movs r7, #16
__sf_block:
    movs r0, #0
    ldrsh r0, [r4, r0]
    asrs r1, r0, #31
    eors r0, r1
    subs r0, r0, r1
    cmp r0, r6
    ble __sf_keep
    movs r6, r0
__sf_keep:
    adds r4, #16
    subs r7, #1
    bne __sf_block
    movs r0, #0
    movs r1, #2
__sf_scale:
    cmp r6, r1
    blt __sf_found
    adds r0, #1
    lsls r1, r1, #1
    cmp r0, #15
    blo __sf_scale
__sf_found:
    ldr r2, =global_sbcscale
    strb r0, [r2, r5]
    adds r2, #8
    strb r0, [r2, r5]
    adds r5, #1
    cmp r5, #8
    blo __sf_subband
    pop {r7}
  EndASM
EndProcedure
; Quantize every allocated sample, (sub*levels >> (scale+1) + levels) >> 1
; clamped to 0..levels, and pack MSB-first from SbcByte.
ProcedureRAM SbcPack()
  ASM
    push {r7}
    movs r0, #0
    movs r1, #0
    ldr r2, =global_sbcbyte
    ldr r2, [r2]
    ldr r3, =global_sbcencoded
    adds r2, r2, r3
    ldr r4, =global_sbcsub
    movs r3, #16
    mov r12, r3
    ldr r3, =global_sbcstereo
    ldr r7, [r3]
    lsls r7, r7, #3
    adds r7, #8
__pk_block:
    movs r5, #0
__pk_subband:
    ldr r3, =global_sbcbits
    ldrb r6, [r3, r5]
    cmp r6, #0
    beq __pk_next
    movs r3, #7
    ands r3, r5
    lsls r3, r3, #1
    ldrsh r3, [r4, r3]
    push {r0, r1}
    movs r0, #1
    lsls r0, r6
    subs r0, #1
    muls r3, r0
    ldr r1, =global_sbcscale
    ldrb r1, [r1, r5]
    adds r1, #1
    asrs r3, r1
    adds r3, r3, r0
    asrs r3, r3, #1
    bpl __pk_not_negative
    movs r3, #0
__pk_not_negative:
    cmp r3, r0
    ble __pk_in_range
    movs r3, r0
__pk_in_range:
    pop {r0, r1}
    lsls r0, r6
    orrs r0, r3
    adds r1, r1, r6
__pk_emit:
    cmp r1, #8
    blo __pk_next
    subs r1, #8
    movs r3, r0
    lsrs r3, r1
    strb r3, [r2]
    adds r2, #1
    b __pk_emit
__pk_next:
    adds r5, #1
    cmp r5, r7
    blo __pk_subband
    adds r4, #16
    mov r3, r12
    subs r3, #1
    mov r12, r3
    bne __pk_block
    ldr r3, =global_sbcencoded
    subs r2, r2, r3
    ldr r3, =global_sbcbyte
    str r2, [r3]
    ldr r3, =global_sbcbitvalue
    str r0, [r3]
    ldr r3, =global_sbcbitcount
    str r1, [r3]
    pop {r7}
  EndASM
EndProcedure
Global Dim SbcCrcTable.a(256)
Global SbcCrcReady.i
ProcedureRAM SbcEncode()
  Protected i.i, k.i, crc.i, bit.i
  SbcAnalyze()
  SbcScaleFactors()
  SbcAllocate()
  SbcEncoded(0)=$9C : SbcEncoded(1)=$F1|(SbcStereo<<3) : SbcEncoded(2)=28 : SbcEncoded(3)=0
  For k=0 To 3+SbcStereo*4 : SbcEncoded(4+k)=(SbcScale(k*2)<<4)|SbcScale(k*2+1) : Next
  If SbcCrcReady=0
    ; CRC-8, polynomial $1D, MSB first: table form of the bitwise update.
    For i=0 To 255
      crc=i
      For bit=0 To 7
        If crc&$80 : crc=((crc<<1)!$1D)&255 : Else : crc=(crc<<1)&255 : EndIf
      Next
      SbcCrcTable(i)=crc
    Next
    SbcCrcReady=1
  EndIf
  crc=15
  For i=1 To 7+SbcStereo*4
    If i<>3 : crc=SbcCrcTable((crc!SbcEncoded(i))&255) : EndIf
  Next
  SbcEncoded(3)=crc : SbcBitValue=0 : SbcBitCount=0 : SbcByte=8+SbcStereo*4
  SbcPack()
EndProcedure
DataSection
SbcOffsets:
  Data.b -4,0,0,0,0,0,1,2
SbcProto:
  Data.w 0,5,11,18,27,37,48,58,66,69,65,53,30,-6,-54,-115
  Data.w 185,263,343,418,480,521,532,502,424,290,96,-161,-480,-856,-1280,-1743
  Data.w 2228,2719,3197,3644,4039,4367,4612,4764,4815,4764,4612,4367,4039,3644,3197,2719
  Data.w -2228,-1743,-1280,-856,-480,-161,96,290,424,502,532,521,480,418,343,263
  Data.w -185,-115,-54,-6,30,53,65,69,66,58,48,37,27,18,11,5
SbcCos:
  Data.w 2896,3406,3784,4017,4096,4017,3784,3406,2896,2276,1567,799,0,-799,-1567,-2276
  Data.w -2896,-799,1567,3406,4096,3406,1567,-799,-2896,-4017,-3784,-2276,0,2276,3784,4017
  Data.w -2896,-4017,-1567,2276,4096,2276,-1567,-4017,-2896,799,3784,3406,0,-3406,-3784,-799
  Data.w 2896,-2276,-3784,799,4096,799,-3784,-2276,2896,3406,-1567,-4017,0,4017,1567,-3406
  Data.w 2896,2276,-3784,-799,4096,-799,-3784,2276,2896,-3406,-1567,4017,0,-4017,1567,3406
  Data.w -2896,4017,-1567,-2276,4096,-2276,-1567,4017,-2896,-799,3784,-3406,0,3406,-3784,799
  Data.w -2896,799,1567,-3406,4096,-3406,1567,799,-2896,4017,-3784,2276,0,-2276,3784,-4017
  Data.w 2896,-3406,3784,-4017,4096,-4017,3784,-3406,2896,-2276,1567,-799,0,799,-1567,2276
SbcCos8:
  Data.w 2896,3406,3784,4017,4096,2276,1567,799
  Data.w -2896,-799,1567,3406,4096,-4017,-3784,-2276
  Data.w -2896,-4017,-1567,2276,4096,799,3784,3406
  Data.w 2896,-2276,-3784,799,4096,3406,-1567,-4017
  Data.w 2896,2276,-3784,-799,4096,-3406,-1567,4017
  Data.w -2896,4017,-1567,-2276,4096,-799,3784,-3406
  Data.w -2896,799,1567,-3406,4096,4017,-3784,2276
  Data.w 2896,-3406,3784,-4017,4096,-2276,1567,-799
EndDataSection
