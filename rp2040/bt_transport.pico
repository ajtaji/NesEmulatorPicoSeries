Global BtAudioRunning.i
Global Dim BtSnapshot.a(320)
Global BtSnapshotState.i, BtSnapshotSize.i, BtWireErrors.i, BtControlRequest.i
; RP2040 port of the HCI transport in PureMetal RP2350/Lib/bluetooth.pico2.
; Only radio backplane addresses are shared; MCU accesses use cyw43.pico.
; This supplies transport/initialization, not pairing, A2DP or an SBC codec.
#BT_FW_MEM_OFFSET  = $19000000
#BT_PWRUP_ADDR     = $00640894
#BT_PWRUP_WAKE     = $03
#BT_CTRL_REG       = $18000C7C
#BT_HOST_CTRL_REG  = $18000D6C
#BT_RAM_BASE_REG   = $18000D68
#BT_FW_RDY         = $01000000
#BT_AWAKE          = $00000100
#BT_SW_RDY         = $01000000
#BT_WAKE_BT        = $00020000
#BT_DATA_VALID     = $00000002
#BT_BUF_SIZE       = $1000
Global bt_hostctrl.l = 0
Global bt_aclmax.i = 27
Global bt_credits.i = 1
Global bt_credit0.i = 1
Global bt_fwbad.i = 0
Global bt_ready.i = 0
Global bt_lost.i = 0
Global bt_verbose.i = 1               ; 0 silences the running commentary
Global Dim bt_addr.a[6]
Global Dim bt_tx.a[320]               ; one outgoing BTSDIO packet
Global Dim bt_ev.a[320]               ; one incoming BTSDIO packet
Global Dim bt_pend.a[320]             ; the single deferred slot
Global g_bt_pendn.i = 0

Procedure.i BtRingIdx(which.i)
  ProcedureReturn NesRadioRead(bt_rambase + $2000 + which * 4)
EndProcedure

Procedure BtRingIdxWrite(which.i, v.l)
  NesRadioWrite(bt_rambase + $2000 + which * 4, v & (#BT_BUF_SIZE - 1))
EndProcedure

Procedure BtHostCtrl(v.l)
  bt_hostctrl = v
  NesRadioWrite(#BT_HOST_CTRL_REG, v)
EndProcedure

Procedure BtDoorBell()
  BtHostCtrl(bt_hostctrl ! #BT_DATA_VALID)
EndProcedure

Procedure.i BtRingSpace()
  Protected used.i
  used = (BtRingIdx(0) - BtRingIdx(1)) & (#BT_BUF_SIZE - 1)
  ProcedureReturn (#BT_BUF_SIZE - 4) - used
EndProcedure

Procedure BtBootWait()
  Protected t.i
  If BtAudioRunning<>0 : ProcedureReturn : EndIf
  t=Micros()
  While Micros()-t<1000 : UsbSerialTask() : SafetyPet() : Wend
EndProcedure
Procedure.i BtWriteBytes(addr.i,src.i,n.i)
  Protected off.i, chunk.i, room.i
  If BtAudioRunning=0 : ProcedureReturn Cyw43BpWriteBytes(addr,src,n) : EndIf
  If (addr&3)<>0 Or (n&3)<>0 : ProcedureReturn -1 : EndIf
  off=0
  While off<n
    chunk=n-off : If chunk>64 : chunk=64 : EndIf
    room=$8000-((addr+off)&$7FFF) : If chunk>room : chunk=room : EndIf
    NesRadioBlock(addr+off,src+off,chunk) : off=off+chunk
  Wend
  ProcedureReturn 0
EndProcedure
Procedure.i BtRingWrite(n.i)
  Protected in.l
  Protected first.i
  Protected waited.i
  waited = 0
  While BtRingSpace() < n
    If BtAudioRunning<>0 : ProcedureReturn 1 : EndIf
    UsbSerialTask()
    SafetyPet()
    BtBootWait()
    waited = waited + 1
    If waited > 200
      If bt_verbose = 1 : PrintN("  bt: H2B ring full 200 ms, fragment dropped") : EndIf
      ProcedureReturn 1
    EndIf
  Wend
  in = BtRingIdx(0)
  first = #BT_BUF_SIZE - in
  If first > n : first = n : EndIf
  BtWriteBytes(bt_rambase + in, @bt_tx[0], first)
  If n > first
    BtWriteBytes(bt_rambase, @bt_tx[first], n - first)
  EndIf
  If BtSnapshotState=1 And BtAudioRunning<>0 And n>128
    For first=0 To n-1 : BtSnapshot(first)=bt_tx(first) : Next
    For first=0 To n-1 Step 4
      If NesRadioRead(bt_rambase+((in+first)&4095))<>PeekL(@bt_tx(0)+first)
        BtWireErrors=BtWireErrors+1
      EndIf
    Next
    BtSnapshotSize=n
    ASM
      dmb
    EndASM
    BtSnapshotState=2
  EndIf
  BtRingIdxWrite(0, in + n)
  BtDoorBell()
  ProcedureReturn 0
EndProcedure

Procedure.i BtB2hAvail()
  ProcedureReturn (BtRingIdx(2) - BtRingIdx(3)) & (#BT_BUF_SIZE - 1)
EndProcedure

Procedure BtEv4(at.i, i.i)
  Protected w.l
  w = NesRadioRead(bt_rambase + $1000 + ((at + i) & (#BT_BUF_SIZE - 1)))
  bt_ev[i]     = w & $FF
  bt_ev[i + 1] = (w >> 8) & $FF
  bt_ev[i + 2] = (w >> 16) & $FF
  bt_ev[i + 3] = (w >> 24) & $FF
EndProcedure

Procedure.i BtRx(budget.i)
  Protected outv.l
  Protected plen.i
  Protected take.i
  Protected i.i
  Protected t.i
  t = 0
  While BtB2hAvail() < 4
    If BtAudioRunning<>0 : ProcedureReturn 0 : EndIf
    UsbSerialTask() : SafetyPet() : BtBootWait()
    t=t+1 : If t>=budget : ProcedureReturn 0 : EndIf
  Wend
  outv = BtRingIdx(3)
  BtEv4(outv, 0)
  plen = bt_ev[0] | (bt_ev[1] << 8) | (bt_ev[2] << 16)
  take = 4 + ((plen + 3) & (~3))
  If take > 320
    If bt_verbose = 1
      Print("  bt: oversize packet ") : PrintDec(plen) : PrintN(" bytes, discarded")
    EndIf
    BtRingIdxWrite(3, outv + 4)
    BtDoorBell()
    ProcedureReturn 0
  EndIf
  t = 0
  While BtB2hAvail() < take
    If BtAudioRunning<>0 : ProcedureReturn 0 : EndIf
    UsbSerialTask()
    SafetyPet()
    BtBootWait()
    t = t + 1
    If t >= 200
      ProcedureReturn 0
    EndIf
  Wend
  i = 4
  While i < take
    BtEv4(outv, i)
    i = i + 4
  Wend
  BtRingIdxWrite(3, outv + take)
  BtDoorBell()
  ProcedureReturn take
EndProcedure

Procedure.i BtCreditEvent()
  Protected nh.i
  Protected i.i
  If bt_ev[3] <> 4 Or bt_ev[4] <> $13
    ProcedureReturn 0
  EndIf
  nh = bt_ev[6]
  i = 0
  While i < nh
    bt_credits = bt_credits + (bt_ev[9 + i * 4] | (bt_ev[10 + i * 4] << 8))
    i = i + 1
  Wend
  If bt_credits > bt_credit0 : bt_credits = bt_credit0 : EndIf
  ProcedureReturn 1
EndProcedure

Procedure BtPark(n.i)
  Protected i.i
  If g_bt_pendn > 0
    bt_lost = bt_lost + 1
    If bt_verbose = 1
      Print("  bt: PACKET LOST, deferred slot full (total ")
      PrintDec(bt_lost) : PrintN(")")
    EndIf
    ProcedureReturn 0
  EndIf
  i = 0
  While i < n
    bt_pend[i] = bt_ev[i]
    i = i + 1
  Wend
  g_bt_pendn = n
EndProcedure

Procedure.i BtHciCmd(opcode.l, plen.i)
  Protected body.i
  Protected total.i
  Protected i.i
  body = 3 + plen
  bt_tx[0] = body & $FF
  bt_tx[1] = (body >> 8) & $FF
  bt_tx[2] = 0
  bt_tx[3] = 1
  bt_tx[4] = opcode & $FF
  bt_tx[5] = (opcode >> 8) & $FF
  bt_tx[6] = plen & $FF
  total = (4 + body + 3) & (~3)
  i = 4 + body
  While i < total
    bt_tx[i] = 0
    i = i + 1
  Wend
  ProcedureReturn BtRingWrite(total)
EndProcedure

Procedure.i BtCmd(opcode.l, plen.i)
  Protected n.i
  Protected tries.i
  BtHciCmd(opcode, plen)
  tries = 0
  While tries < 20
    n = BtRx(200)
    If n > 0
      If bt_ev[3] = 4 And bt_ev[4] = $0E And (bt_ev[7] | (bt_ev[8] << 8)) = opcode
        If bt_ev[9] = 0
          ProcedureReturn 1
        EndIf
        If bt_verbose = 1
          Print("  bt: opcode $") : PrintHex(opcode, 4)
          Print(" status $") : PrintHex(bt_ev[9], 2) : PrintNl()
        EndIf
        ProcedureReturn 0
      EndIf
      If BtCreditEvent() = 0
        BtPark(n)
      EndIf
    EndIf
    tries = tries + 1
  Wend
  If bt_verbose = 1
    Print("  bt: no Command Complete for $") : PrintHex(opcode, 4) : PrintNl()
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i BtRadioUp()
  Protected rc.i
  Cyw43Power()
  rc = Cyw43LinkCheck()
  If rc = 0 : rc = Cyw43BusMode()      : EndIf
  If rc = 0 : rc = Cyw43BusConfig()    : EndIf
  If rc = 0 : rc = Cyw43AlpClock()     : EndIf
  If rc = 0 : rc = Cyw43ChipIdCheck()  : EndIf
  If rc = 0 : rc = Cyw43CoresDown()    : EndIf
  If rc = 0 : rc = Cyw43SramRemap()    : EndIf
  If rc = 0 : rc = Cyw43LoadFirmware() : EndIf
  If rc = 0 : rc = Cyw43LoadNvram()    : EndIf
  If rc = 0 : rc = Cyw43WlanUp()       : EndIf
  If rc = 0 : rc = Cyw43HtReady()      : EndIf
  If rc = 0 : rc = Cyw43F2Ready()      : EndIf
  If rc = 0 : rc = Cyw43BusCleanup()   : EndIf
  ProcedureReturn rc
EndProcedure

Procedure.i BtLoadFirmware()
  Protected runs.i
  Protected i.i
  Protected dest.l
  Protected len.i
  Protected off.i
  Protected wlen.i
  Protected rem.i
  Protected bad.i
  Protected w.l
  Protected lo.i
  Protected hi.i
  Protected tab.i
  Protected dat.i
  NesRadioWrite(#BT_FW_MEM_OFFSET + #BT_PWRUP_ADDR, #BT_PWRUP_WAKE)
  cyw43_verify = 1
  runs = PeekL(?Cyw43BtfwRuns)
  tab = ?Cyw43BtfwRuns + 4
  dat = ?Cyw43BtfwData
  i = 0
  While i < runs
    dest = PeekL(tab + i * 12)
    len  = PeekL(tab + i * 12 + 4)
    off  = PeekL(tab + i * 12 + 8)
    wlen = len & (~3)
    rem  = len - wlen
    If wlen > 0
      bad = Cyw43BpWriteBytes(#BT_FW_MEM_OFFSET + dest, dat + off, wlen)
      If bad > 0 : bt_fwbad = bt_fwbad + bad : EndIf
    EndIf
    If rem > 0
      w = NesRadioRead(#BT_FW_MEM_OFFSET + dest + wlen)
      lo = PeekB(dat + off + wlen) & $FF
      If rem >= 2 : hi = PeekB(dat + off + wlen + 1) & $FF : Else : hi = (w >> 8) & $FF : EndIf
      w = (w & $FFFF0000) | (hi << 8) | lo
      NesRadioWrite(#BT_FW_MEM_OFFSET + dest + wlen, w)
    EndIf
    i = i + 1
  Wend
  ProcedureReturn bt_fwbad
EndProcedure

Procedure.i BtPollBit(mask.l)
  Protected polls.i
  polls = 0
  While polls < 300
    If (NesRadioRead(#BT_CTRL_REG) & mask) <> 0
      ProcedureReturn polls
    EndIf
    BtBootWait()
    polls = polls + 1
  Wend
  ProcedureReturn -1
EndProcedure

Procedure.i BtHandshake()
  Protected i.i
  bt_rambase = NesRadioRead(#BT_RAM_BASE_REG)
  If bt_rambase = 0 Or bt_rambase = -1
    ProcedureReturn 1
  EndIf
  i = 0
  While i < 4
    NesRadioWrite(bt_rambase + $2000 + i * 4, 0)
    i = i + 1
  Wend
  BtHostCtrl(bt_hostctrl | #BT_WAKE_BT)
  If BtPollBit(#BT_AWAKE) < 0
    ProcedureReturn 1
  EndIf
  BtHostCtrl(bt_hostctrl | #BT_SW_RDY)
  ProcedureReturn 0
EndProcedure

Procedure.i BtBufferResult()
  Protected length.i, count.i
  length=bt_ev(10)|(bt_ev(11)<<8) : count=bt_ev(13)|(bt_ev(14)<<8)
  If length<27 Or count<1 : ProcedureReturn 1 : EndIf
  If length>300 : length=300 : EndIf
  bt_aclmax=length : bt_credits=count : bt_credit0=count
  ProcedureReturn 0
EndProcedure
Procedure.i BtReadBuffers()
  If BtCmd($1005,0)<>1 : ProcedureReturn 1 : EndIf
  ProcedureReturn BtBufferResult()
EndProcedure

Procedure.i BtBegin()
  Protected i.i
  If BtRadioUp() <> 0
    PrintN("  bt: radio bring-up FAILED")
    ProcedureReturn 1
  EndIf
  If BtLoadFirmware() <> 0
    PrintN("  bt: BT firmware readback MISMATCH")
    ProcedureReturn 2
  EndIf
  If BtPollBit(#BT_FW_RDY) < 0
    PrintN("  bt: no FW_RDY from the BT core")
    ProcedureReturn 3
  EndIf
  If BtHandshake() <> 0
    PrintN("  bt: shared-memory handshake FAILED")
    ProcedureReturn 4
  EndIf
  If BtCmd($0C03, 0) <> 1
    PrintN("  bt: HCI_Reset FAILED")
    ProcedureReturn 5
  EndIf
  If BtCmd($1009, 0) <> 1
    PrintN("  bt: Read_BD_ADDR FAILED")
    ProcedureReturn 6
  EndIf
  i = 0
  While i < 6
    bt_addr[i] = bt_ev[10 + i]
    i = i + 1
  Wend
  If BtReadBuffers() <> 0
    ProcedureReturn 7
  EndIf
  bt_ready = 1
  ProcedureReturn 0
EndProcedure

Procedure BtPrintAddr()
  Protected i.i
  i = 5
  While i >= 0
    PrintHex(bt_addr[i], 2)
    If i > 0 : Print(":") : EndIf
    i = i - 1
  Wend
EndProcedure
