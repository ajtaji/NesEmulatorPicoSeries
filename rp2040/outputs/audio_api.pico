; PCM producer is the unchanged APU. A consumer runs on core 1 (NES_SPLIT=2).
; Copy into plugin-owned staging buffers; never DMA directly from the APU ring.
Procedure AudioReset()
  AudioReadCursor=ApuSamples
EndProcedure
ProcedureRAM.i AudioRead(destination.i, capacity.i)
  Protected count.i, i.i
  If destination=0 Or capacity<=0 : ProcedureReturn 0 : EndIf
  If capacity>#NES_AUDIO_RING_SAMPLES : capacity=#NES_AUDIO_RING_SAMPLES : EndIf
  count=ApuSamples-AudioReadCursor
  If count>#NES_AUDIO_RING_SAMPLES
    AudioOverruns=AudioOverruns+1 : AudioReadCursor=ApuSamples-#NES_AUDIO_RING_SAMPLES : count=#NES_AUDIO_RING_SAMPLES
  ElseIf count<0
    AudioReadCursor=ApuSamples : ProcedureReturn 0
  EndIf
  If count>capacity : count=capacity : EndIf
  For i=0 To count-1
    PokeW(destination+i*2,Pcm((AudioReadCursor+i)&(#NES_AUDIO_RING_SAMPLES-1)))
  Next
  AudioReadCursor=AudioReadCursor+count
  ProcedureReturn count
EndProcedure
