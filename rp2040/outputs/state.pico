; Compile-time output ABI. Set both backend constants in the entry wrapper:
; Video: 0=headless, 1=LAFVIN, 2=wrapper plugin, 3=Pico Display Pack 2.0.
; Audio: 0=silent, 1=Bluetooth, 2=wrapper plugin.
#NES_OUTPUT_API_VERSION=1
#NES_VIDEO_WIDTH=256
#NES_VIDEO_HEIGHT=240
#NES_VIDEO_HALF_ROWS=120
#NES_AUDIO_RATE=48000
#NES_AUDIO_RING_SAMPLES=4096
CompilerIf #NES_VIDEO_BACKEND=3
  Global VideoFramePresent.i=1
CompilerEndIf
Global AudioRunning.i, AudioLive.i, AudioWorked.i, AudioBusyUs.i
Global AudioPackets.i, AudioUnderruns.i, AudioOverruns.i, AudioWireErrors.i
Global AudioQueueSlack.i, AudioReadCursor.i
