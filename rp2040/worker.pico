Global PpuClock.i, PpuStatusDeferred.i, Core1IdleUs.i, Core0IdleUs.i, Core1ParkRequest.i, Core1Parked.i
ProcedureRAM PpuSync(stamp.i)
  Protected dt.i, timer.i
  PpuStatusDeadline=0
  dt=stamp-PpuClock
  If dt<0
    WorkerError=21
  ElseIf dt>0
    timer=Micros()
    CompilerIf #NES_PICO_MAPPERS=1
      If PicoMapActive : PicoPpuTicks(dt) : EndIf
    CompilerEndIf
    PpuAdvance(dt)
    WorkerPpuUs=WorkerPpuUs+Micros()-timer
    PpuClock=stamp
  EndIf
EndProcedure
; Status reads may share the last synchronized state only before an event
; that can change a status bit. All writes and ordinary synchronization
; invalidate this horizon. Read side effects still execute for every read.
ProcedureRAM.i NesPollStatusDone()
  ProcedureReturn PpuRegRead(2)
EndProcedure
; A $2002 read. Within the horizon a status read can share the last synchronized state; past it the
; PPU catches up and the next horizon is the first dot that can change a status bit: vblank set or
; clear, sprite zero's hit on this line, or - with a clean OAM cache - the first later line that can
; raise sprite overflow or sprite zero. Thumb-1 (both chips); r4 = stamp, r5 = PpuStatus, r6 = PpuLine.
; PpuMask and PpuStatus do not change during the line search, so sprite zero's line is a range test
; and only overflow walks CachedCount. The horizon's /3 is *43691>>17, exact to 98303 (at most 82182).
Global PpuSyncStamp.i
ProcedureRAM PpuSyncStatus(stamp.i)
  PpuSyncStamp=stamp
  ASM
    ldr r0, =global_ppusyncstamp
    ldr r4, [r0]
    ldr r0, =global_ppustatusdeadline
    ldr r0, [r0]
    cmp r4, r0
    bgt __pss_sync
    ldr r0, =global_ppuclock
    ldr r0, [r0]
    cmp r4, r0
    blt __pss_sync
    ldr r0, =global_ppustatusdeferred
    ldr r1, [r0]
    adds r1, #1
    str r1, [r0]
    b __pss_done
__pss_sync:
    movs r0, r4
    bl ppusync
    ldr r0, =global_ppustatus
    ldr r5, [r0]
    ldr r0, =global_ppustatusbits
    str r5, [r0]
    ldr r0, =global_ppuline
    ldr r6, [r0]
    ldr r0, =global_ppudot
    ldr r3, [r0]
    ldr r0, =341
    cmp r6, #241
    beq __pss_vb
    ldr r1, =global_ppupreline
    ldr r1, [r1]
    cmp r6, r1
    bne __pss_notvb
__pss_vb:
    cmp r3, #0
    bne __pss_notvb
    movs r0, #1
    b __pss_have_edge
__pss_notvb:
    cmp r6, #240
    bge __pss_have_edge
    cmp r3, #0
    bne __pss_mid
    movs r0, #0
    b __pss_have_edge
__pss_mid:
    ldr r1, =256
    cmp r3, r1
    bge __pss_have_edge
    movs r1, #64
    tst r5, r1
    bne __pss_have_edge
    ldr r1, =global_ppumask
    ldr r1, [r1]
    movs r2, #24
    ands r1, r2
    cmp r1, #24
    bne __pss_have_edge
    ldr r1, =global_sprcount
    ldr r1, [r1]
    cmp r1, #0
    ble __pss_have_edge
    ldr r1, =global_sprindex
    ldr r1, [r1]
    cmp r1, #0
    bne __pss_have_edge
    adds r0, r3, #7
    lsrs r0, r0, #3
    lsls r0, r0, #3
__pss_have_edge:
    ldr r1, =341
    cmp r0, r1
    bne __pss_final
    cmp r6, #240
    bge __pss_final
    ldr r1, =global_oamcachedirty
    ldr r1, [r1]
    cmp r1, #0
    bne __pss_final
    ldr r3, =global_ppumask
    ldr r3, [r3]
    movs r0, #24
    ands r3, r0
    movs r2, #240
    cmp r3, #24
    bne __pss_scan
    movs r0, #64
    tst r5, r0
    bne __pss_scan
    ldr r0, =global_oam
    ldrb r0, [r0]
    adds r0, #1
    ldr r1, =global_ppuctrl
    ldr r1, [r1]
    movs r2, #32
    tst r1, r2
    beq __pss_h8
    movs r1, r0
    adds r1, #16
    b __pss_hset
__pss_h8:
    movs r1, r0
    adds r1, #8
__pss_hset:
    movs r2, #240
    adds r6, #1
    cmp r0, r6
    bge __pss_bstart
    movs r0, r6
__pss_bstart:
    subs r6, #1
    cmp r0, r1
    bge __pss_scan
    cmp r0, r2
    bge __pss_scan
    movs r2, r0
__pss_scan:
    cmp r3, #0
    beq __pss_scan_end
    movs r0, #32
    tst r5, r0
    bne __pss_scan_end
    adds r1, r6, #1
    ldr r3, =global_cachedcount
__pss_scan_loop:
    cmp r1, r2
    bge __pss_scan_end
    ldrb r0, [r3, r1]
    cmp r0, #8
    bhi __pss_scan_hit
    adds r1, #1
    b __pss_scan_loop
__pss_scan_hit:
    movs r2, r1
__pss_scan_end:
    subs r0, r2, r6
    ldr r1, =341
    muls r0, r1
    cmp r2, #240
    bne __pss_final
    ldr r1, =342
    adds r0, r0, r1
__pss_final:
    ldr r1, =global_ppudot
    ldr r1, [r1]
    cmp r0, r1
    ble __pss_done
    subs r0, r0, r1
    ldr r2, =global_cartpal
    ldr r2, [r2]
    cmp r2, #0
    beq __pss_ntsc
    ; PAL: the most cycles that stay short of d dots is (5d-1-PpuDotFrac)/16.
    lsls r2, r0, #2
    adds r0, r0, r2
    subs r0, #1
    ldr r2, =global_ppudotfrac
    ldr r2, [r2]
    subs r0, r0, r2
    asrs r0, r0, #4
    b __pss_cycles
__pss_ntsc:
    subs r0, #1
    ldr r1, =43691
    muls r0, r1
    lsrs r0, r0, #17
__pss_cycles:
    adds r0, r0, r4
    ldr r1, =global_ppustatusdeadline
    str r0, [r1]
__pss_done:
  EndASM
EndProcedure
Global PpuDmaSource.i
ProcedureRAM.i LocalPpuCommand(command.i, addr.i, value.i, stamp.i)
  Protected i.i
  PpuSync(stamp)
  If command=1
    ProcedureReturn PpuRegRead(addr&7)
  ElseIf command=2
    PpuRegWrite(addr&7,value)
  ElseIf command=3
    OamCacheDirty=1
    If value<$20
      ; A page of internal RAM, the usual source: copied straight from M (mirrored every 2 KiB) into
      ; OAM from PpuOamAddr, wrapping, the bytes NesDmaRead would return. Thumb-1 (both chips).
      PpuDmaSource=@M(0)+((value*256)&$7FF)
      ASM
        ldr r0, =global_ppudmasource
        ldr r0, [r0]
        ldr r1, =global_ppuoamaddr
        ldr r1, [r1]
        ldr r2, =global_oam
        movs r3, #0
__lpc_dma:
        ldrb r4, [r0, r3]
        adds r5, r1, r3
        uxtb r5, r5
        strb r4, [r2, r5]
        adds r3, #1
        cmp r3, #255
        bls __lpc_dma
      EndASM
    Else
      For i=0 To 255
        Oam((PpuOamAddr+i)&255)=NesDmaRead(value*256+i)
      Next
    EndIf
  ElseIf command=4
    BgCacheAddr= -1 : RgbLastKey= -1
    PpuChrBank=value
    Chr=CartChr+value*8192 : Pattern=@Decoded(0)+value*8192
  EndIf
  ProcedureReturn 0
EndProcedure
ProcedureRAM WorkerAdvance(stamp.i)
  Protected dt.i, timer.i
  dt=stamp-WorkerClock
  If dt<0
    WorkerError=20
    ProcedureReturn
  EndIf
  If dt>0
    timer=Micros()
    ApuAdvance(dt)
    WorkerApuUs=WorkerApuUs+Micros()-timer
    CompilerIf #NES_SPLIT<>2
      timer=Micros()
      PpuAdvance(dt)
      WorkerPpuUs=WorkerPpuUs+Micros()-timer
    CompilerEndIf
    WorkerClock=stamp
  EndIf
EndProcedure
ProcedureRAM WorkerCommand(command.i, addr.i, value.i, stamp.i)
  Protected i.i
  WorkerAdvance(stamp)
  QResult=0
  If command=1
    If addr<$4000
      QResult=PpuRegRead(addr&7)
    ElseIf addr=$4015
      QResult=ApuReadStatus()
    EndIf
  ElseIf command=2
    If addr<$4000
      PpuRegWrite(addr&7,value)
    Else
      ApuWrite(addr,value)
    EndIf
  ElseIf command=3
    OamCacheDirty=1
    For i=0 To 255
      Oam((PpuOamAddr+i)&255)=WorkerRead(value*256+i)
    Next
  ElseIf command=4
    BgCacheAddr= -1 : RgbLastKey= -1
    PpuChrBank=value
    Chr=CartChr+value*8192 : Pattern=@Decoded(0)+value*8192
  ElseIf command=5
    WorkerPrgBase=value
  CompilerIf #NES_PICO_MAPPERS=1
  ElseIf command=6
    PicoWorkerPrgSet(addr,value)
  CompilerEndIf
  CompilerIf #PICO_ADVANCED=1
  ElseIf command=7
    ; a cartridge sound chip's register (VRC6), at its CPU time: the APU has just run up to it
    ExpWrite(addr,value)
  CompilerEndIf
  EndIf
EndProcedure
Declare.i QwstPoll()
ProcedureRAM Core1Main()
  Protected slot.i, command.i, addr.i, value.i, start.i, i.i, p.i
  CompilerIf #NES_SPLIT=0
    DisplayMain()
  CompilerEndIf
  WorkerReady=1
  Repeat
    ; Parked in SRAM while core 0 writes flash (the ROM loader).
    If PeekL(@Core1ParkRequest)<>0
      NesFence() : Core1Parked=1
      While PeekL(@Core1ParkRequest)<>0 : Wend
      Core1Parked=0
    EndIf
    p=Micros() : i=0
    CompilerIf #NES_SPLIT=2
      DisplayPoll()
    CompilerEndIf
    If QTail<>PeekL(@QHead)
      i=1
      NesFence()
      start=Micros() : slot=QTail
      command=QCmd(slot) : addr=QAddr(slot) : value=QData(slot)
      WorkerCommand(command,addr,value,QTime(slot))
      WorkerBusyUs=WorkerBusyUs+Micros()-start
      NesFence()
      QTail=(slot+1)&127
      QComplete=QComplete+1
    EndIf
    AudioPoll()
    ; Qw/ST Pad controllers: the I2C reads belong to this core.
    If QwstPoll() : i=1 : EndIf
    ; Idle time: a pass that applied no bus event and did no audio output work.
    If i=0 And AudioWorked=0 : Core1IdleUs=Core1IdleUs+Micros()-p : EndIf
  ForEver
EndProcedure
