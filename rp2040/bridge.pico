; Core 0 produces timestamped bus events. Default: local PPU, core-1 APU.
; Single producer / single consumer; publish payload before queue index.
Global Dim QTime.i(128)
Global Dim QCmd.i(128)
Global Dim QAddr.i(128)
Global Dim QData.i(128)
Global QHead.i, QTail.i, QSent.i, QComplete.i, QResult.i
Global WorkerReady.i, WorkerError.i, WorkerClock.i, WorkerFrames.i
Global WorkerNmi.i, WorkerIrq.i, WorkerDmcCycles.i, WorkerDot.i
Global WorkerPpuUs.i, WorkerApuUs.i
Global WorkerBusyUs.i, WorkerDisplayUs.i, WorkerDisplayed.i
Global WorkerDisplay.i=1, WorkerFrameDivider.i=2, WorkerPaused.i
Global NesBridgeError.i, NesController.i, NesLatch.i, NesStrobe.i
Global NesLatch2.i
Global NesSeenNmi.i, NesSeenDmc.i, NesRpcCalls.i, NesRpcWaitUs.i
Global CartMapper.i, CartPrgBanks.i=1, CartChrBanks.i=1, CartPrg.i, CartChr.i
Global CartPrgSelected.i, CartChrSelected.i
Global CartCount.i=1, CartIndex.i, CartTitle.i, CartChrRam.i, CartConflicts.i=1, CartChrDirty.i
Global CartBankCalls.i, CartBankChanges.i, CartBankUs.i, WorkerPrgBase.i
Declare CartSelect(number.i)
Declare CartPpuWriteNotice(addr.i,value.i)
Declare CartUxBank(value.i)
Declare CartBank(value.i)
Declare WorkerCommand(command.i, addr.i, value.i, stamp.i)
Declare.i LocalPpuCommand(command.i, addr.i, value.i, stamp.i)
Declare PpuSync(stamp.i)
Declare PpuSyncStatus(stamp.i)
Declare.i PpuRegRead(addr.i)
Declare PpuRegWrite(addr.i, value.i)

ProcedureRAM NesFence()
  ASM
    dmb
  EndASM
EndProcedure
ProcedureRAM.i NesPost(command.i, addr.i, value.i, stamp.i)
  Protected nextSlot.i, start.i
  CompilerIf #NES_SPLIT=2
    If command=3 Or command=4 Or (command=2 And addr<$4000)
      LocalPpuCommand(command,addr,value,stamp)
      ProcedureReturn 1
    EndIf
  CompilerEndIf
  CompilerIf #NES_SPLIT=0
    WorkerCommand(command,addr,value,stamp)
    QSent=QSent+1 : QComplete=QSent
    ProcedureReturn QSent
  CompilerEndIf
  nextSlot=(QHead+1)&127 : start=Micros()
  While nextSlot=PeekL(@QTail)
    UsbSerialTask() : SafetyPet()
    If Micros()-start>2000000
      NesBridgeError=1
      ProcedureReturn 0
    EndIf
  Wend
  QTime(QHead)=stamp : QCmd(QHead)=command
  QAddr(QHead)=addr : QData(QHead)=value
  NesFence()
  QHead=nextSlot : QSent=QSent+1
  ProcedureReturn QSent
EndProcedure
ProcedureRAM.i NesRpc(command.i, addr.i, value.i, stamp.i)
  Protected ticket.i, start.i
  CompilerIf #NES_SPLIT=2
    If command=3 Or command=4 Or ((command=1 Or command=2) And addr<$4000)
      ProcedureReturn LocalPpuCommand(command,addr,value,stamp)
    EndIf
  CompilerEndIf
  ticket=NesPost(command,addr,value,stamp) : start=Micros()
  If ticket=0
    ProcedureReturn 0
  EndIf
  While PeekL(@QComplete)<>ticket
    UsbSerialTask() : SafetyPet()
    If Micros()-start>2000000
      NesBridgeError=2
      ProcedureReturn 0
    EndIf
  Wend
  NesFence()
  NesRpcCalls=NesRpcCalls+1 : NesRpcWaitUs=NesRpcWaitUs+Micros()-start
  ProcedureReturn QResult
EndProcedure
Global NesBusAddress.i
Declare.i NesReadSlow(addr.i)
ProcedureRAM.i NesRead(addr.i)
  NesBusAddress=addr
  ASM
    ldr r0, =global_nesbusaddress
    ldr r0, [r0]
    lsls r0, r0, #16
    lsrs r0, r0, #16
    ldr r1, =$8000
    cmp r0, r1
    blo __nes_read_ram
    ldr r1, =global_prgbias
    ldr r1, [r1]
    ldrb r0, [r1, r0]
    b __nes_read_publish
__nes_read_ram:
    ldr r1, =$2000
    cmp r0, r1
    bhs __nes_read_device
    ldr r1, =$07ff
    ands r0, r1
    ldr r1, =global_m
    ldrb r0, [r1, r0]
__nes_read_publish:
    ldr r1, =global_nesopenbus
    str r0, [r1]
    b __ul_nesread_readdone
__nes_read_device:
    b __ul_nesread_readdevice
  EndASM
ReadDevice:
  ProcedureReturn NesReadSlow(NesBusAddress)
ReadDone:
  ProcedureReturn NesOpenBus
EndProcedure
; Inside CpuRun only Left (r11) moves per instruction; bus paths that need
; the cycle timestamp derive it here. Ending a window keeps that derivation
; exact by moving the unspent budget out of Budget before clearing Left.
ProcedureRAM CpuNow()
  If CpuInWindow : CpuCycles=NesRunStart+Budget-Left : EndIf
EndProcedure
ProcedureRAM CpuEndWindow()
  If CpuInWindow : Budget=Budget-Left : EndIf
  Left=0
EndProcedure
ProcedureRAM.i NesReadSlow(addr.i)
  Protected v.i
  addr=addr&$FFFF
  If addr>=$8000
    v=PeekA(PrgBase+addr-$8000)
  ElseIf addr<$2000
    v=M(addr&$7FF)
  ElseIf addr>=$6000
    v=NesOpenBus
  ElseIf addr=$4016
    If NesStrobe
      v=(NesController&1)|$40
    Else
      v=(NesLatch&1)|$40
      NesLatch=(NesLatch>>1)|$80
    EndIf
  ElseIf addr=$4017
    v=$40
    If NesStrobe=0
      v=v|(NesLatch2&1) : NesLatch2=(NesLatch2>>1)|$80
    EndIf
  ElseIf addr<$4000 Or addr=$4015
    CpuNow()
    CompilerIf #NES_SPLIT=2
      If addr<$4000
        If (addr&7)=2
          PpuSyncStatus(CpuCycles+AccessPhase)
        Else
          PpuSync(CpuCycles+AccessPhase)
        EndIf
        v=PpuRegRead(addr&7)
      Else
        v=NesRpc(1,addr,0,CpuCycles+AccessPhase)
      EndIf
    CompilerElse
      v=NesRpc(1,addr,0,CpuCycles+AccessPhase)
    CompilerEndIf
    CompilerIf #NES_SPLIT=2
      If addr=$4015 Or WorkerNmi<>NesSeenNmi
        CpuEndWindow()
      EndIf
    CompilerElse
      CpuEndWindow()
    CompilerEndIf
  Else
    v=NesOpenBus
  EndIf
  NesOpenBus=v&255
  ProcedureReturn NesOpenBus
EndProcedure
ProcedureRAM NesWrite(addr.i, value.i)
  addr=addr&$FFFF : value=value&255 : NesOpenBus=value
  If addr<$2000
    M(addr&$7FF)=value
  ElseIf addr>=$6000
    If addr>=$8000 And (CartMapper=66 Or CartMapper=2)
      CpuNow()
      If CartConflicts : value=value&PeekA(PrgBase+addr-$8000) : EndIf
      CartBank(value)
    EndIf
  ElseIf addr=$4016
    NesStrobe=value&1 : NesLatch=NesController : NesLatch2=0
  ElseIf addr=$4014
    CpuNow()
    NesPost(3,0,value,CpuCycles+AccessPhase)
    If CpuInWindow
      Left=Left-513-((CpuCycles+AccessPhase+1)&1)
    Else
      NesStall=NesStall+513+((CpuCycles+AccessPhase+1)&1)
    EndIf
    CpuEndWindow()
  ElseIf addr<$4000 Or addr<=$4017
    CpuNow()
    CompilerIf #NES_SPLIT=2
      If addr<$4000
        PpuSync(CpuCycles+AccessPhase)
        ; CHR RAM writes invalidate converted cartridge rows before the existing PPU write.
        If CartChrRam<>0 : CartPpuWriteNotice(addr,value) : EndIf
        PpuRegWrite(addr&7,value)
      ElseIf addr=$4015
        ; Synchronous, so core 0 sees a DMC start (DmcBytes) before the next window.
        NesRpc(2,addr,value,CpuCycles+AccessPhase)
      Else
        NesPost(2,addr,value,CpuCycles+AccessPhase)
      EndIf
    CompilerElse
      NesPost(2,addr,value,CpuCycles+AccessPhase)
    CompilerEndIf
    CompilerIf #NES_SPLIT=2
      If WorkerNmi<>NesSeenNmi
        CpuEndWindow()
      EndIf
    CompilerElse
      CpuEndWindow()
    CompilerEndIf
  EndIf
EndProcedure

; A PRG switch is a timestamped bus event: core 1 applies it to its own view
; (WorkerPrgBase) in queue order, so DMC reads before the write still see the
; old bank and core 0 never waits for core 1.
ProcedureRAM CartPrgSwitch(bank.i)
  PrgBase=CartPrg+bank*32768 : PrgBias=PrgBase-$8000
  CartPrgSelected=bank
  NesPost(5,0,PrgBase,CpuCycles+AccessPhase)
EndProcedure
ProcedureRAM CartUxBank(value.i)
  Protected bank.i, started.i
  started=Micros() : CartBankCalls=CartBankCalls+1
  bank=value&(CartPrgBanks-1)
  If bank<>CartPrgSelected
    CartPrgSwitch(bank)
    CartBankChanges=CartBankChanges+1
  EndIf
  CpuEndWindow()
  CartBankUs=CartBankUs+Micros()-started
EndProcedure
ProcedureRAM CartBank(value.i)
  Protected bank.i, i.i, p.i
  If CartMapper=2 : CartUxBank(value) : ProcedureReturn : EndIf
  ; GxROM bus conflicts: the ROM and CPU both drive the data bus.
  bank=((value>>4)&3)&(CartPrgBanks-1)
  If bank<>CartPrgSelected
    CartPrgSwitch(bank)
  EndIf
  bank=(value&3)&(CartChrBanks-1)
  If bank<>CartChrSelected
    NesRpc(4,0,bank,CpuCycles+AccessPhase)
    CartChrSelected=bank
  EndIf
  CpuEndWindow()
EndProcedure

; Bus DMA source read on core 1 (DMC). Never calls the RPC producer or touches
; reserved CPU globals. PRG comes from core 1's own queue-ordered bank view.
ProcedureRAM.i WorkerRead(addr.i)
  addr=addr&$FFFF
  If addr<$2000
    ProcedureReturn M(addr&$7FF)
  EndIf
  If addr>=$6000
    If addr>=$8000
      ProcedureReturn PeekA(WorkerPrgBase+addr-$8000)
    EndIf
    ProcedureReturn 0
  EndIf
  ProcedureReturn 0
EndProcedure
; The same bus read for OAM DMA executed on core 0, with core 0's bank view.
ProcedureRAM.i NesDmaRead(addr.i)
  addr=addr&$FFFF
  If addr<$2000
    ProcedureReturn M(addr&$7FF)
  EndIf
  If addr>=$8000
    ProcedureReturn PeekA(PrgBase+addr-$8000)
  EndIf
  ProcedureReturn 0
EndProcedure

; No-argument ABI helpers: incoming 6502 PC is the reserved r8.
; Ordinary SRAM procedures preserve the compiler ABI; r0-r3 are scratch.
ProcedureRAM.i CpuFetchByte()
  ASM Uses PC
    mov r0, r8
    ldr r1, =$8000
    cmp r0, r1
    blo __cpu_fetch_byte_slow
    ldr r1, =global_prgbias
    ldr r1, [r1]
    ldrb r2, [r1, r0]
    adds r0, #1
    lsls r0, r0, #16
    lsrs r0, r0, #16
    mov r8, r0
    ldr r1, =global_nesopenbus
    str r2, [r1]
    movs r0, r2
    b __ul_cpufetchbyte_fetchdone
__cpu_fetch_byte_slow:
    b __ul_cpufetchbyte_fetchslow
  EndASM
FetchSlow:
  CpuFetchByteSlow()
FetchDone:
  ProcedureReturn NesOpenBus
EndProcedure
ProcedureRAM.i CpuFetchByteSlow()
  Protected value.i
  value=NesRead(PC) : PC=(PC+1)&$FFFF
  ProcedureReturn value
EndProcedure
ProcedureRAM CpuFetchAddress()
  ASM Uses PC
    mov r0, r8
    ldr r1, =$8000
    cmp r0, r1
    blo __cpu_fetch_address_slow
    ldr r1, =$ffff
    cmp r0, r1
    beq __cpu_fetch_address_slow
    ldr r1, =global_prgbias
    ldr r1, [r1]
    ldrb r2, [r1, r0]
    adds r0, #1
    ldrb r3, [r1, r0]
    ldr r1, =global_nesopenbus
    str r3, [r1]
    lsls r3, r3, #8
    orrs r2, r3
    ldr r1, =global_ea
    str r2, [r1]
    adds r0, #1
    lsls r0, r0, #16
    lsrs r0, r0, #16
    mov r8, r0
    b __ul_cpufetchaddress_addressdone
__cpu_fetch_address_slow:
    b __ul_cpufetchaddress_addressslow
  EndASM
AddressSlow:
  CpuFetchAddressSlow()
AddressDone:
EndProcedure
ProcedureRAM CpuFetchAddressSlow()
  Ea=NesRead(PC)|(NesRead((PC+1)&$FFFF)<<8)
  PC=(PC+2)&$FFFF
EndProcedure
