; Native boot UI. The emulated CPU and APU remain stopped until selection.
; Reuses the existing complete RGB framebuffer and baseline LCD DMA.
Procedure MenuPixel(x.i,y.i,colour.i)
  If y<120
    FrameTop(y*256+x)=colour
  Else
    PokeU(FrameBottom+((y-120)*256+x)*2,colour)
  EndIf
EndProcedure
Procedure MenuRect(x.i,y.i,w.i,h.i,colour.i)
  Protected row.i, col.i
  For row=y To y+h-1
    For col=x To x+w-1 : MenuPixel(col,row,colour) : Next
  Next
EndProcedure
; TrueType text, rendered once on the PC (tools/make_menu_font.py writes menu_font.pico) and blitted here:
; each glyph's 4-bit coverage blends the text colour into the known background through MenuRamp. Font 0 is
; Menu Sans at 20 px (the heading), font 1 at 14 px (the list and prompts). Nothing is rasterised on the board.
Global Dim MenuRamp.u(16)
Global MenuRampFg.i=-1, MenuRampBg.i=-1
Procedure MenuSetColours(fg.i,bg.i)
  Protected level.i, r.i, g.i, b.i
  If fg=MenuRampFg And bg=MenuRampBg : ProcedureReturn : EndIf
  For level=0 To 15
    r=((fg>>11)*level+(bg>>11)*(15-level)+7)/15
    g=(((fg>>5)&63)*level+((bg>>5)&63)*(15-level)+7)/15
    b=((fg&31)*level+(bg&31)*(15-level)+7)/15
    MenuRamp(level)=(r<<11)|(g<<5)|b
  Next
  MenuRampFg=fg : MenuRampBg=bg
EndProcedure
Procedure.i MenuMetrics(font.i)
  If font=0 : ProcedureReturn ?MenuSansLargeMetrics : EndIf
  ProcedureReturn ?MenuSansSmallMetrics
EndProcedure
Procedure.i MenuGlyphWidth(font.i,c.i)
  If c<32 Or c>126 : c=63 : EndIf
  ProcedureReturn PeekA(MenuMetrics(font)+(c-32)*5+4)
EndProcedure
Procedure MenuGlyph(x.i,y.i,font.i,c.i)
  Protected m.i, bits.i, w.i, h.i, row.i, col.i, level.i, stride.i, px.i, py.i
  If c<32 Or c>126 : c=63 : EndIf
  m=MenuMetrics(font)+(c-32)*5
  If font=0
    bits=?MenuSansLargeBits+PeekU(?MenuSansLargeOffsets+(c-32)*2)
  Else
    bits=?MenuSansSmallBits+PeekU(?MenuSansSmallOffsets+(c-32)*2)
  EndIf
  w=PeekA(m) : h=PeekA(m+1) : stride=(w+1)>>1
  For row=0 To h-1
    py=y+PeekA(m+3)+row
    If py>=0 And py<240
      For col=0 To w-1
        level=PeekA(bits+row*stride+(col>>1))
        If col&1 : level=level>>4 : Else : level=level&15 : EndIf
        px=x+PeekA(m+2)-64+col
        If level<>0 And px>=0 And px<256 : MenuPixel(px,py,MenuRamp(level)) : EndIf
      Next
    EndIf
  Next
EndProcedure
; text: a zero-terminated ASCII string. A text wider than maxWidth ends in "..." where it still fits.
Procedure MenuText(x.i,y.i,text.i,font.i,fg.i,bg.i,maxWidth.i)
  Protected n.i, c.i, width.i, dots.i, last.i
  MenuSetColours(fg,bg)
  For n=0 To 63
    c=PeekA(text+n)
    If c=0 : Break : EndIf
    width=width+MenuGlyphWidth(font,c)
  Next
  last=n
  If width>maxWidth
    dots=MenuGlyphWidth(font,46)*3 : width=0
    For n=0 To last-1
      If width+MenuGlyphWidth(font,PeekA(text+n))+dots>maxWidth : Break : EndIf
      width=width+MenuGlyphWidth(font,PeekA(text+n))
    Next
    last=n
  EndIf
  For n=0 To last-1
    c=PeekA(text+n) : MenuGlyph(x,y,font,c) : x=x+MenuGlyphWidth(font,c)
  Next
  If PeekA(text+last)<>0
    For n=0 To 2 : MenuGlyph(x,y,font,46) : x=x+MenuGlyphWidth(font,46) : Next
  EndIf
EndProcedure
Procedure MenuDraw(selected.i,first.i)
  Protected index.i, y.i
  MenuRect(0,0,256,240,$0841)
  MenuText(12,8,?MenuHeading,0,$FFFF,$0841,232)
  MenuText(12,36,?MenuChoose,1,$BDF7,$0841,232)
  For index=first To first+4
    If index>=CartCount : Break : EndIf
    CartSelect(index) : y=62+(index-first)*26
    If index=selected
      MenuRect(6,y-3,244,22,$2188) : MenuText(12,y,CartTitle,1,$FFE0,$2188,232)
    Else
      MenuText(12,y,CartTitle,1,$BDF7,$0841,232)
    EndIf
  Next
  CartSelect(selected)
  MenuText(12,198,?MenuPlay,1,$FFFF,$0841,232)
  MenuText(12,216,?MenuStart,1,$BDF7,$0841,232)
EndProcedure
Procedure.i BootMenu()
  Protected selected.i, first.i, dirty.i, previous.i, mask.i, key.i, launch.i
  Protected nextFrame.i, nextRepeat.i, now.i, direction.i, report.i, displayed.i, capture.i
  dirty=1 : nextFrame=Micros() : report=nextFrame : displayed=WorkerDisplayed
  CartSelect(0)
  Say("BOOT_MENU count=") : Num(CartCount) : Eol()
  Repeat
    UsbSerialTask() : SafetyPet() : InputPoll()
    key=UsbSerialRead() : now=Micros() : mask=InputMask
    direction=0
    If mask&16 : direction= -1 : EndIf
    If mask&32 : direction=1 : EndIf
    If direction<>0 And (((mask!previous)&48)<>0 Or now-nextRepeat>=0)
      selected=selected+direction
      If selected<0 : selected=CartCount-1 : EndIf
      If selected>=CartCount : selected=0 : EndIf
      nextRepeat=now+180000 : dirty=1
    EndIf
    ; Release-to-confirm prevents the two-button Start chord launching on A.
    If (previous&3)=1 And (mask&3)=0 : launch=1 : EndIf
    If (mask&8)<>0 Or key=115 Or key=97 : launch=1 : EndIf
    If key>=48 And key<=57 And key-48<CartCount
      selected=key-48 : launch=1
    EndIf
    If now-report>=1000000
      Say("BOOT_FPS us=") : Num(now-report) : Say(" lcd=") : Num(WorkerDisplayed-displayed) : Eol()
      report=now : displayed=WorkerDisplayed
    EndIf
    If key=112 : capture=1 : EndIf
    ; 'L': the ROM loader (tools/rom_loader.py); the list may change after it.
    If key=76
      RomLoader() : selected=0 : first=0 : dirty=1
      Say("BOOT_MENU count=") : Num(CartCount) : Eol()
    EndIf
    If capture<>0 And PeekL(@DisplayDone)=DisplayReady : DumpFrame() : capture=0 : EndIf
    If launch<>0 And PeekL(@DisplayDone)=DisplayReady : Break : EndIf
    If PeekL(@DisplayDone)=DisplayReady
      If dirty
        If selected<first : first=selected : EndIf
        If selected>=first+5 : first=selected-4 : EndIf
        MenuDraw(selected,first) : dirty=0
        Say("BOOT_SELECT index=") : Num(selected) : Say(" mapper=") : Num(CartMapper) : Eol()
      EndIf
      If now-nextFrame>=0
        DisplayFrame()
        CompilerIf #NES_VIDEO_BACKEND=3 Or #NES_VIDEO_BACKEND=4 Or #NES_VIDEO_BACKEND=5
          nextFrame=now+VideoMenuPeriodUs()
        CompilerElse
          nextFrame=now+16639
        CompilerEndIf
      EndIf
    EndIf
    previous=mask
  ForEver
  CartSelect(selected)
  Say("BOOT_PLAY index=") : Num(selected) : Say(" mapper=") : Num(CartMapper) : Eol()
  ProcedureReturn selected
EndProcedure
DataSection
MenuHeading: Data.a 80,117,114,101,77,101,116,97,108,32,78,69,83,0
MenuChoose: Data.a 67,104,111,111,115,101,32,97,32,103,97,109,101,0
MenuPlay: Data.a 65,32,116,111,32,112,108,97,121,0
MenuStart: Data.a 66,111,116,104,32,98,117,116,116,111,110,115,32,97,110,100,32,85,112,32,102,111,114,32,83,116,97,114,116,0
EndDataSection
