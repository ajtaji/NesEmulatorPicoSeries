; Five-channel APU state and 48 kHz PCM producer, owned by core 1.
; Timer/envelope/length/sweep/DMC state is separate from the DAC transport.
; PCM mixing uses lookup tables; no floating point on the RP2040.
Global Dim ApuReg.a(24)
Global Dim ApuLength.i(4)
Global Dim ApuPeriod.i(4)
Global Dim ApuTimer.i(4)
Global Dim ApuSeq.i(4)
Global Dim EnvStart.i(3)
Global Dim EnvDiv.i(3)
Global Dim EnvDecay.i(3)
Global Dim SweepDiv.i(2)
Global Dim SweepReload.i(2)
Global Dim LengthTable.a(32)
Global Dim NoiseTable.u(16)
Global Dim DmcTable.u(16)
Global Dim PulseMix.u(31)
Global Dim TndMix.u(203)
Global Dim Pcm.w(#NES_AUDIO_RING_SAMPLES)
Global ApuEnable.i, ApuFrameClock.i, ApuFrameStep.i, ApuFive.i, ApuInhibit.i
Global ApuFrameIrq.i, ApuResetDelay.i, ApuLinear.i, ApuLinearReload.i
Global NoiseShift.i=1, TriDac.i, ApuSampleLeft.i=37, ApuSampleFrac.i=101
Global ApuSamples.i, ApuCapture.i, ApuMinimum.i, ApuMaximum.i, ApuNonzero.i
Global DmcTimer.i=428, DmcLevel.i, DmcAddress.i, DmcBytes.i, DmcShift.i
Global DmcBits.i=8, DmcBuffer.i, DmcEmpty.i=1, DmcSilent.i=1, DmcIrq.i
Global ApuLastX.i, ApuLastY.i, ApuOutput.i
Global ApuRingMask.i=#NES_AUDIO_RING_SAMPLES-1   ; the PCM ring's index mask, for the assembly
Global ApuTickDt.i                               ; ApuTick's dt, for the assembly

ProcedureRAM.i ApuVolume(ch.i)
  Protected reg.i
  reg=ch*4
  If ch=2
    reg=12
  EndIf
  If ApuReg(reg)&$10
    ProcedureReturn ApuReg(reg)&15
  EndIf
  ProcedureReturn EnvDecay(ch)
EndProcedure
ProcedureRAM.i ApuTarget(ch.i)
  Protected amount.i, target.i
  amount=ApuPeriod(ch)>>(ApuReg(ch*4+1)&7)
  target=ApuPeriod(ch)+amount
  If ApuReg(ch*4+1)&8
    target=ApuPeriod(ch)-amount
    If ch=0
      target=target-1
    EndIf
  EndIf
  ProcedureReturn target
EndProcedure
Procedure ApuQuarter()
  Protected c.i, r.i
  For c=0 To 2
    r=c*4
    If c=2
      r=12
    EndIf
    If EnvStart(c)
      EnvStart(c)=0 : EnvDecay(c)=15 : EnvDiv(c)=ApuReg(r)&15
    ElseIf EnvDiv(c)>0
      EnvDiv(c)=EnvDiv(c)-1
    Else
      EnvDiv(c)=ApuReg(r)&15
      If EnvDecay(c)>0
        EnvDecay(c)=EnvDecay(c)-1
      ElseIf ApuReg(r)&$20
        EnvDecay(c)=15
      EndIf
    EndIf
  Next
  If ApuLinearReload
    ApuLinear=ApuReg(8)&127
  ElseIf ApuLinear>0
    ApuLinear=ApuLinear-1
  EndIf
  If (ApuReg(8)&$80)=0
    ApuLinearReload=0
  EndIf
EndProcedure
Procedure ApuHalf()
  Protected c.i, hold.i, r.i, target.i
  For c=0 To 3
    r=c*4 : hold=ApuReg(r)&$20
    If c=2
      hold=ApuReg(8)&$80
    EndIf
    If ApuLength(c)>0 And hold=0
      ApuLength(c)=ApuLength(c)-1
    EndIf
  Next
  For c=0 To 1
    r=ApuReg(c*4+1) : target=ApuTarget(c)
    If SweepDiv(c)=0 And (r&$80)<>0 And (r&7)<>0 And ApuPeriod(c)>=8 And target<=$7FF
      ApuPeriod(c)=target
    EndIf
    If SweepDiv(c)=0 Or SweepReload(c)<>0
      SweepDiv(c)=(r>>4)&7 : SweepReload(c)=0
    Else
      SweepDiv(c)=SweepDiv(c)-1
    EndIf
  Next
EndProcedure
ProcedureRAM ApuDmcFetch()
  If DmcEmpty<>0 And DmcBytes>0
    DmcBuffer=WorkerRead(DmcAddress) : DmcEmpty=0
    WorkerDmcCycles=WorkerDmcCycles+4
    DmcAddress=DmcAddress+1
    If DmcAddress=$10000
      DmcAddress=$8000
    EndIf
    DmcBytes=DmcBytes-1
    If DmcBytes=0
      If ApuReg(16)&$40
        DmcAddress=$C000+ApuReg(18)*64 : DmcBytes=ApuReg(19)*16+1
      ElseIf ApuReg(16)&$80
        DmcIrq=1
      EndIf
    EndIf
  EndIf
EndProcedure
; The channel timers for dt CPU cycles. Pulse, triangle and noise are Thumb-1 (both chips): a timer
; that runs out is wound forward a period at a time, counting the steps - the same ticks and the same
; remainder as 1+NesDiv(-timer, period), without the divide (dt is at most a sample's 38 cycles, so
; one or two steps). The DMC stays plain: it fetches through the bus. The plain form of all of it is
; ApuTickReference in Diagnostics/asm_reference.picow.
ProcedureRAM ApuTick(dt.i)
  ApuTickDt=dt
  ASM
    ldr r0, =global_aputickdt
    ldr r4, [r0]
    movs r5, #0
__at_pulse:
    lsls r6, r5, #2
    ldr r0, =global_aputimer
    ldr r1, [r0, r6]
    subs r1, r1, r4
    cmp r1, #0
    bgt __at_pulse_store
    ldr r2, =global_apuperiod
    ldr r2, [r2, r6]
    adds r2, #1
    lsls r2, r2, #1
    movs r3, #0
__at_pulse_wind:
    adds r1, r1, r2
    adds r3, #1
    cmp r1, #0
    ble __at_pulse_wind
    ldr r2, =global_apuseq
    ldr r0, [r2, r6]
    adds r0, r0, r3
    movs r3, #7
    ands r0, r3
    str r0, [r2, r6]
    ldr r0, =global_aputimer
__at_pulse_store:
    str r1, [r0, r6]
    adds r5, #1
    cmp r5, #2
    blo __at_pulse
    ldr r0, =global_aputimer
    ldr r1, [r0, #8]
    subs r1, r1, r4
    cmp r1, #0
    bgt __at_tri_store
    ldr r2, =global_apuperiod
    ldr r2, [r2, #8]
    adds r2, #1
    movs r3, #0
__at_tri_wind:
    adds r1, r1, r2
    adds r3, #1
    cmp r1, #0
    ble __at_tri_wind
    str r1, [r0, #8]
    ldr r0, =global_apulength
    ldr r0, [r0, #8]
    cmp r0, #0
    ble __at_noise
    ldr r0, =global_apulinear
    ldr r0, [r0]
    cmp r0, #0
    ble __at_noise
    ldr r2, =global_apuseq
    ldr r0, [r2, #8]
    adds r0, r0, r3
    movs r3, #31
    ands r0, r3
    str r0, [r2, #8]
    cmp r0, #16
    bge __at_tri_up
    movs r1, #15
    subs r1, r1, r0
    b __at_tri_dac
__at_tri_up:
    movs r1, r0
    subs r1, #16
__at_tri_dac:
    ldr r2, =global_tridac
    str r1, [r2]
    b __at_noise
__at_tri_store:
    str r1, [r0, #8]
__at_noise:
    ldr r0, =global_aputimer
    ldr r1, [r0, #12]
    subs r1, r1, r4
    cmp r1, #0
    bgt __at_noise_store
    ldr r2, =global_apureg
    ldrb r5, [r2, #14]
    movs r2, #15
    ands r2, r5
    lsls r2, r2, #1
    ldr r3, =global_noisetable
    ldrh r2, [r3, r2]
    ldr r3, =global_noiseshift
    ldr r6, [r3]
__at_noise_step:
    adds r1, r1, r2
    lsrs r0, r6, #1
    movs r4, #128
    tst r5, r4
    beq __at_noise_short
    lsrs r0, r6, #6
__at_noise_short:
    eors r0, r6
    movs r4, #1
    ands r0, r4
    lsls r0, r0, #14
    lsrs r6, r6, #1
    orrs r6, r0
    cmp r1, #0
    ble __at_noise_step
    str r6, [r3]
    ldr r0, =global_aputimer
__at_noise_store:
    str r1, [r0, #12]
  EndASM
  DmcTimer=DmcTimer-dt
  While DmcTimer<=0
    DmcTimer=DmcTimer+DmcTable(ApuReg(16)&15)
    If DmcSilent=0
      If DmcShift&1
        If DmcLevel<=125
          DmcLevel=DmcLevel+2
        EndIf
      ElseIf DmcLevel>=2
        DmcLevel=DmcLevel-2
      EndIf
    EndIf
    DmcShift=DmcShift>>1 : DmcBits=DmcBits-1
    If DmcBits=0
      DmcBits=8
      If DmcEmpty
        DmcSilent=1
      Else
        DmcSilent=0 : DmcShift=DmcBuffer : DmcEmpty=1
        ApuDmcFetch()
      EndIf
    EndIf
  Wend
EndProcedure
; One 48 kHz output sample: the two pulses (sweep target and duty, ApuTarget and ApuVolume inlined),
; noise, triangle and DMC through the mixing tables, a DC blocker, the clamp, the PCM ring and its
; statistics; ApuSamples moves last, after the sample is in the ring (core 0 and the Bluetooth
; library read it). Thumb-1 (both chips); r4 = pulse sum then the mix, r5 = channel then noise. The
; duty patterns $02/$06/$1E/$F9 are the bytes of $F91E0602. The plain form is ApuMixSampleReference
; in Diagnostics/asm_reference.picow.
ProcedureRAM ApuMixSample()
  ASM
    movs r4, #0
    movs r5, #0
__ams_ch:
    lsls r6, r5, #2
    ldr r0, =global_apulength
    ldr r0, [r0, r6]
    cmp r0, #0
    ble __ams_next
    ldr r0, =global_apuperiod
    ldr r1, [r0, r6]
    cmp r1, #8
    blt __ams_next
    ldr r0, =global_apureg
    adds r0, r0, r6
    ldrb r2, [r0, #1]
    movs r3, #7
    ands r3, r2
    movs r0, r1
    asrs r0, r3
    movs r3, #8
    tst r2, r3
    bne __ams_down
    adds r0, r1, r0
    b __ams_target
__ams_down:
    subs r0, r1, r0
    cmp r5, #0
    bne __ams_target
    subs r0, #1
__ams_target:
    ldr r3, =$7FF
    cmp r0, r3
    bgt __ams_next
    ldr r0, =global_apureg
    ldrb r2, [r0, r6]
    lsrs r1, r2, #6
    lsls r1, r1, #3
    ldr r3, =$F91E0602
    lsrs r3, r1
    movs r1, #255
    ands r3, r1
    ldr r0, =global_apuseq
    ldr r0, [r0, r6]
    lsrs r3, r0
    movs r0, #1
    tst r3, r0
    beq __ams_next
    movs r3, #16
    tst r2, r3
    beq __ams_envelope
    movs r3, #15
    ands r2, r3
    adds r4, r4, r2
    b __ams_next
__ams_envelope:
    ldr r0, =global_envdecay
    ldr r0, [r0, r6]
    adds r4, r4, r0
__ams_next:
    adds r5, #1
    cmp r5, #2
    blo __ams_ch
    movs r5, #0
    ldr r0, =global_apulength
    ldr r0, [r0, #12]
    cmp r0, #0
    ble __ams_mix
    ldr r0, =global_noiseshift
    ldr r0, [r0]
    movs r1, #1
    tst r0, r1
    bne __ams_mix
    ldr r0, =global_apureg
    ldrb r2, [r0, #12]
    movs r3, #16
    tst r2, r3
    beq __ams_noise_envelope
    movs r3, #15
    ands r2, r3
    movs r5, r2
    b __ams_mix
__ams_noise_envelope:
    ldr r0, =global_envdecay
    ldr r5, [r0, #8]
__ams_mix:
    ldr r0, =global_pulsemix
    lsls r1, r4, #1
    ldrh r4, [r0, r1]
    ldr r0, =global_tridac
    ldr r0, [r0]
    lsls r1, r0, #1
    adds r1, r1, r0
    lsls r5, r5, #1
    adds r1, r1, r5
    ldr r0, =global_dmclevel
    ldr r0, [r0]
    adds r1, r1, r0
    lsls r1, r1, #1
    ldr r0, =global_tndmix
    ldrh r0, [r0, r1]
    adds r4, r4, r0
    ldr r0, =global_expsample
    ldr r0, [r0]
    adds r4, r4, r0
    ldr r0, =global_apulasty
    ldr r0, [r0]
    ldr r1, =65400
    muls r0, r1
    cmp r0, #0
    bge __ams_blocked
    ldr r1, =65535
    adds r0, r0, r1
__ams_blocked:
    asrs r0, r0, #16
    ldr r1, =global_apulastx
    ldr r2, [r1]
    str r4, [r1]
    subs r2, r4, r2
    adds r0, r0, r2
    ldr r1, =32767
    cmp r0, r1
    ble __ams_low
    movs r0, r1
    b __ams_clamped
__ams_low:
    ldr r1, =$FFFF8000
    cmp r0, r1
    bge __ams_clamped
    movs r0, r1
__ams_clamped:
    ldr r1, =global_apuoutput
    str r0, [r1]
    ldr r1, =global_apulasty
    str r0, [r1]
    ldr r1, =global_apusamples
    ldr r2, [r1]
    ldr r3, =global_apuringmask
    ldr r3, [r3]
    ands r3, r2
    lsls r3, r3, #1
    ldr r4, =global_pcm
    strh r0, [r4, r3]
    ldr r3, =global_apucapture
    ldr r4, [r3]
    ldr r5, =4096
    cmp r4, r5
    bge __ams_captured
    adds r4, #1
    str r4, [r3]
__ams_captured:
    ldr r3, =global_apuminimum
    ldr r4, [r3]
    cmp r0, r4
    bge __ams_min
    str r0, [r3]
__ams_min:
    ldr r3, =global_apumaximum
    ldr r4, [r3]
    cmp r0, r4
    ble __ams_max
    str r0, [r3]
__ams_max:
    cmp r0, #0
    beq __ams_zero
    ldr r3, =global_apunonzero
    ldr r4, [r3]
    adds r4, #1
    str r4, [r3]
__ams_zero:
    adds r2, #1
    str r2, [r1]
  EndASM
EndProcedure
ProcedureRAM ApuAdvance(dt.i)
  Protected step.i, event.i
  While dt>0
    step=dt
    If step>ApuSampleLeft
      step=ApuSampleLeft
    EndIf
    If ApuResetDelay>0 And step>ApuResetDelay
      step=ApuResetDelay
    EndIf
    event=ApuStep1
    If ApuFrameStep=1
      event=ApuStep2
    ElseIf ApuFrameStep=2
      event=ApuStep3
    ElseIf ApuFrameStep=3
      event=ApuStep4
      If ApuFive
        event=ApuStep5
      EndIf
    EndIf
    If step>event-ApuFrameClock
      step=event-ApuFrameClock
    EndIf
    ApuTick(step)
    CompilerIf #PICO_ADVANCED=1
      If ExpChip : ExpTick(step) : EndIf
    CompilerEndIf
    ApuFrameClock=ApuFrameClock+step
    If ApuResetDelay>0
      ApuResetDelay=ApuResetDelay-step
      If ApuResetDelay=0
        ApuFrameClock=0 : ApuFrameStep=0
        If ApuFive
          ApuQuarter() : ApuHalf()
        EndIf
      EndIf
    EndIf
    If ApuFrameClock>=event
      ApuQuarter()
      If ApuFrameStep=1 Or ApuFrameStep=3
        ApuHalf()
      EndIf
      ApuFrameStep=ApuFrameStep+1
      If ApuFrameStep=4
        If ApuFive=0 And ApuInhibit=0
          ApuFrameIrq=1
        EndIf
        ApuFrameClock=ApuFrameClock-event-1 : ApuFrameStep=0
      EndIf
    EndIf
    ApuSampleLeft=ApuSampleLeft-step : dt=dt-step
    If ApuSampleLeft=0
      CompilerIf #PICO_ADVANCED=1
        If ExpChip : ExpMix() : EndIf
      CompilerEndIf
      ApuMixSample()
      ApuSampleFrac=ApuSampleFrac+ApuFracStep
      ApuSampleLeft=ApuSampleBase
      If ApuSampleFrac>=ApuFracDen
        ApuSampleFrac=ApuSampleFrac-ApuFracDen : ApuSampleLeft=ApuSampleBase+1
      EndIf
    EndIf
  Wend
  WorkerIrq=ApuFrameIrq|DmcIrq
EndProcedure
ProcedureRAM ApuWrite(addr.i, value.i)
  Protected r.i, ch.i
  r=addr-$4000
  If r<0 Or r>23
    ProcedureReturn
  EndIf
  ApuReg(r)=value
  If r<12
    ch=r>>2
    If (r&3)=1 And ch<2
      SweepReload(ch)=1
    ElseIf (r&3)=2
      ApuPeriod(ch)=(ApuPeriod(ch)&$700)|value
    ElseIf (r&3)=3
      ApuPeriod(ch)=(ApuPeriod(ch)&255)|((value&7)<<8)
      If (ApuEnable>>ch)&1
        ApuLength(ch)=LengthTable(value>>3)
      EndIf
      If ch<2
        EnvStart(ch)=1 : ApuSeq(ch)=0
      Else
        ApuLinearReload=1
      EndIf
    EndIf
  ElseIf r=15
    If ApuEnable&8
      ApuLength(3)=LengthTable(value>>3)
    EndIf
    EnvStart(2)=1
  ElseIf r=16
    If (value&$80)=0
      DmcIrq=0
    EndIf
  ElseIf r=17
    DmcLevel=value&127
  ElseIf r=21
    ApuEnable=value&31 : DmcIrq=0
    For ch=0 To 3
      If ((value>>ch)&1)=0
        ApuLength(ch)=0
      EndIf
    Next
    If (value&16)=0
      DmcBytes=0
    ElseIf DmcBytes=0
      DmcAddress=$C000+ApuReg(18)*64 : DmcBytes=ApuReg(19)*16+1
      ApuDmcFetch()
    EndIf
  ElseIf r=23
    ApuFive=(value>>7)&1 : ApuInhibit=(value>>6)&1
    If ApuInhibit
      ApuFrameIrq=0
    EndIf
    ApuResetDelay=3+(WorkerClock&1)
  EndIf
  WorkerIrq=ApuFrameIrq|DmcIrq
EndProcedure
ProcedureRAM.i ApuReadStatus()
  Protected v.i, c.i
  v=(ApuFrameIrq<<6)|(DmcIrq<<7)
  For c=0 To 3
    If ApuLength(c)>0
      v=v|(1<<c)
    EndIf
  Next
  If DmcBytes>0
    v=v|16
  EndIf
  ApuFrameIrq=0 : WorkerIrq=DmcIrq
  ProcedureReturn v
EndProcedure
