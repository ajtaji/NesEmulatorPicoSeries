Global Dim FrameBottomStore.u(30720)
Procedure CartPpuWriteNotice(addr.i,value.i)
  If (addr&7)=7 And (PpuV&$3FFF)<$2000
    CartChrDirty=1
    If PpuMask&8 : RgbPairsDirty=1 : CartChrDirty=0 : EndIf
  ElseIf (addr&7)=1 And (value&8)<>0 And CartChrDirty<>0
    RgbPairsDirty=1 : CartChrDirty=0
  EndIf
EndProcedure

Global LastApuSend.i, CpuRunUs.i, SyncUs.i, Windows.i
ProcedureRAM NesSync()
  Protected stalls.i,delay.i
  CompilerIf #NES_SPLIT=2
    PpuSync(CpuCycles)
    ; Synchronous only while a DMC sample is really fetching (its stalls and
    ; IRQ belong inside this window); a latched $4015 bit 4 alone is not playback.
    If CpuCycles-WorkerClock>512+PeekL(@AudioQueueSlack) Or PeekL(@DmcBytes)>0
      NesRpc(0,0,0,CpuCycles)
      LastApuSend=CpuCycles
    ElseIf CpuCycles-LastApuSend>=256
      NesPost(0,0,0,CpuCycles)
      LastApuSend=CpuCycles
    EndIf
    NesFence()
    stalls=WorkerDmcCycles-NesSeenDmc
    If stalls>0
      CpuCycles=CpuCycles+stalls : NesSeenDmc=NesSeenDmc+stalls
      PpuSync(CpuCycles)
    EndIf
    delay=CpuIrqDelay : CpuIrqDelay=0
    If (WorkerNmi<>NesSeenNmi And NesNmiDelay) Or ((WorkerIrq|PicoIrq)<>0 And FI=0 And delay)
      NesNmiDelay=0 : CpuRun(1) : PpuSync(CpuCycles)
    EndIf
    NesNmiDelay=0
    If WorkerNmi<>NesSeenNmi
      NesSeenNmi=WorkerNmi : CpuInterrupt($FFFA)
    ElseIf (WorkerIrq|PicoIrq)<>0 And FI=0
      CpuInterrupt($FFFE)
    EndIf
    ProcedureReturn
  CompilerEndIf
  NesRpc(0,0,0,CpuCycles)
  stalls=WorkerDmcCycles-NesSeenDmc
  While stalls>0
    CpuCycles=CpuCycles+stalls : NesSeenDmc=WorkerDmcCycles
    NesRpc(0,0,0,CpuCycles)
    stalls=WorkerDmcCycles-NesSeenDmc
  Wend
  CompilerIf #NES_SPLIT=2
    PpuSync(CpuCycles)
  CompilerEndIf
  If WorkerNmi<>NesSeenNmi
    NesSeenNmi=WorkerNmi
    CpuInterrupt($FFFA)
  ElseIf (WorkerIrq|PicoIrq)<>0 And FI=0
    CpuInterrupt($FFFE)
  EndIf
EndProcedure
Procedure PicoProfileReport()
  CompilerIf #PICO_ADVANCED=1
    Say("MAP_PROFILE prg_maps=") : Num(PicoPrgCopies) : Say(" prg_map_us=") : Num(PicoPrgCopyUs)
    Say(" chr_copies=") : Num(PicoChrCopies) : Say(" chr_us=") : Num(PicoChrCopyUs)
    Say(" fence_us=") : Num(PicoFenceUs) : Say(" observer_us=") : Num(PicoObserverUs) : Say(" predictions=") : Num(PicoPredictCalls) : Say(" predict_us=") : Num(PicoPredictUs) : Say(" quick_writes=") : Num(PicoQuickWrites) : Eol()
  CompilerEndIf
EndProcedure
Procedure LoadCartridge()
  Protected i.i, bank.i
  FrameBottom=@FrameBottomStore(0)
  CartSelect(CartIndex) : PicoPrgFlat()
  CartChrDirty=0 : PicoMapActive=0 : PicoIrq=0 : NesNmiDelay=0 : CpuIrqDelay=0
  PrgBase=CartPrg : PrgBias=PrgBase-$8000 : WorkerPrgBase=PrgBase : CartPrgSelected=0 : CartChrSelected=0 : PpuChrBank=0
  If CartMapper<>0 And CartMapper<>2 And CartMapper<>66
    ChrWritable=0
    If CartChrRam
      Chr=(@Decoded(0)+8192) : Pattern=@Decoded(0) : ChrWritable=1
      For i=0 To 16383 : PokeA(@Decoded(0)+i,0) : Next
    EndIf
    PicoMapperInit()
  ElseIf CartChrRam
    Chr=@Decoded(0)+8192 : CartChr=Chr : Pattern=@Decoded(0) : ChrWritable=1
  Else
  ChrWritable=0
  For bank=0 To CartChrBanks-1
    Chr=CartChr+bank*8192 : Pattern=@Decoded(0)+bank*8192
    For i=0 To 8191
      If (i&8)=0
        PpuDecode(i)
      EndIf
    Next
  Next
  Chr=CartChr : Pattern=@Decoded(0)
  EndIf
  For i=0 To 31
    LengthTable(i)=PeekA(?LengthData+i)
  Next
  For i=0 To 15
    NoiseTable(i)=PeekU(?NoiseData+i*2) : DmcTable(i)=PeekU(?DmcData+i*2)
  Next
  For i=0 To 30
    PulseMix(i)=PeekU(?PulseData+i*2)
  Next
  For i=0 To 202
    TndMix(i)=PeekU(?TndData+i*2)
  Next
  For i=0 To 511
    Rgb64(i)=PeekU(?RgbData+i*2)
  Next
  PpuColours()
EndProcedure
Procedure DumpFrame()
  Protected i.i
  NesRpc(0,0,0,CpuCycles)
  Say("RGB_BEGIN") : Eol()
  For i=0 To 61439
    If i<30720
      UsbSerialWrite(FrameTop(i)&255) : UsbSerialWrite(FrameTop(i)>>8)
    Else
      UsbSerialWrite(PeekU(FrameBottom+(i-30720)*2)&255) : UsbSerialWrite(PeekU(FrameBottom+(i-30720)*2)>>8)
    EndIf
  Next
  Eol() : Say("RGB_END") : Eol()
EndProcedure
Procedure DumpReferenceFrame()
  Protected savedLine.i, savedDot.i, savedV.i, savedStatus.i, savedX.i, savedRow.i
  Protected y.i, x.i, span.i
  NesRpc(0,0,0,CpuCycles)
  savedLine=PpuLine : savedDot=PpuDot : savedV=PpuV : savedStatus=PpuStatus
  savedX=PpuFineX : savedRow=FrameRow
  ; Diagnostic zero-scroll image from the raw bitplanes and current NT/OAM.
  PpuV=0 : PpuFineX=0
  For y=0 To 239
    PpuLine=y : PpuDot=0 : PpuBeginLine() : PpuSpritesReference()
    For span=0 To 31
      PpuDot=span*8 : PpuRender8Reference()
    Next
    For x=0 To 255
      PokeU(FrameRow+x*2,RgbPal(LinePixels(x)))
    Next
    PpuIncY() : PpuV=PpuV&$7BE0
    SafetyPet() : UsbSerialTask()
  Next
  PpuLine=savedLine : PpuDot=savedDot : PpuV=savedV : PpuStatus=savedStatus
  PpuFineX=savedX : FrameRow=savedRow : RgbLastKey= -1 : BgCacheAddr= -1
  DumpFrame()
EndProcedure
Procedure DumpPcm()
  Protected i.i, index.i
  NesRpc(0,0,0,CpuCycles)
  Say("PCM_BEGIN") : Eol()
  index=ApuSamples-4096
  For i=0 To 4095
    UsbSerialWrite(Pcm((index+i)&(#NES_AUDIO_RING_SAMPLES-1))&255) : UsbSerialWrite((Pcm((index+i)&(#NES_AUDIO_RING_SAMPLES-1))>>8)&255)
  Next
  Eol() : Say("PCM_END") : Eol()
EndProcedure
XIncludeFile "rom_store.pico"
XIncludeFile "menu.pico"
Procedure Main()
  Protected t.i, tick.i, report.i, start.i, cycles.i, budget.i, target.i, frames.i, samples.i
  Protected lastPpu.i, lastApu.i, lastLcd.i, lastRender.i, lastSprites.i, lastRgb.i, lastWait.i
  Protected display.i, busy.i, dt.i, key.i, release.i, mode.i, distance.i
  Protected lastMisses.i, lastName.i, lastPairs.i, lastDeferred.i, lastBatched.i, lastBt.i
  Protected capturePending.i, captureSeen.i, inputPoll.i, captureByte.i, passStart.i, ran.i, lastIdle0.i, lastIdle1.i, mark.i, mark2.i, lastRun.i, lastSync.i, lastWin.i, lastPpu0.i
  SafetyBoot() : ClockInitKhz(200000) : TimerInit() : UsbSerialInit()
  t=Micros()
  While UsbSerialReady()=0 And Micros()-t<10000000
    UsbSerialTask() : SafetyPet()
  Wend
  WaitUs(200000)
  VideoBegin()
  LoadCartridge()
  InputBegin() : QwstBegin()
  Say("core1 launch=") : Num(multicore_launch()) : Eol()
  While PeekL(@WorkerReady)=0 : SafetyPet() : Wend
  CartIndex=BootMenu() : LoadCartridge()
  AudioBegin()
  Say("NES PureMetal RP2040 mapper=") : Num(CartMapper)
  Say(" clk_khz=") : Num(ClockSysKhz()) : Say(" spi_hz=") : Num(VideoClockHz()) : Eol()
  CpuReset()
  tick=Micros() : report=tick : start=tick : cycles=CpuCycles
  display=WorkerDisplayed : frames=WorkerFrames : samples=ApuSamples
  target=CpuCycles
  Repeat
    passStart=Micros() : ran=0
    key= -1
    If inputPoll=0
      InputPoll()
      UsbSerialTask() : SafetyPet() : key=UsbSerialRead() : inputPoll=3
    Else
      inputPoll=inputPoll-1
    EndIf
    If key=115
      InputHost=8 : release=WorkerFrames+6
    ElseIf key=97
      InputHost=1 : release=WorkerFrames+6
    ElseIf key=98
      InputHost=2 : release=WorkerFrames+6
    ElseIf key=117
      InputHost=$10 : release=WorkerFrames+6
    ElseIf key=110
      InputHost=$20 : release=WorkerFrames+6
    ElseIf key=108
      InputHost=$40 : release=WorkerFrames+6
    ElseIf key=114
      InputHost=$80 : release=WorkerFrames+6
    ElseIf key=82
      InputHost=$80 : release=WorkerFrames+300
    ElseIf key=48
      InputHost=0 : release=0
    ElseIf key=102
      mode=mode!1 : tick=Micros() : target=CpuCycles
    ElseIf key=100
      WorkerDisplay=WorkerDisplay!1
    ElseIf key=112
      capturePending=1 : captureSeen=DisplayReady
    ElseIf key=122
      DumpReferenceFrame()
      tick=Micros() : target=CpuCycles
    ElseIf key=119
      DumpPcm()
      tick=Micros() : target=CpuCycles
    CompilerIf #NES_AUDIO_BACKEND=1
    ElseIf key=113
      BtControlRequest=1
    ElseIf key=107
      BtSnapshotState=1
    CompilerEndIf
    ElseIf key=106
      Say("INPUT x=") : Num(InputX) : Say(" y=") : Num(InputY)
      Say(" buttons=") : Num(InputButtons) : Say(" mask=") : Num(InputMask)
      Say(" polls=") : Num(InputPolls) : Say(" errors=") : Num(InputErrors)
      Say(" busy_us=") : Num(InputBusyUs)
      Say(" starts=") : Num(InputStartCount) : Say(" selects=") : Num(InputSelectCount)
      Say(" pads=") : Num(QwstPads) : Say(" pad1=") : Num(QwstMask(0)) : Say(" pad2=") : Num(QwstMask(1))
      Say(" pad_reads=") : Num(QwstReads) : Say(" pad_errors=") : Num(QwstErrors) : Say(" pad_busy_us=") : Num(QwstBusyUs) : Eol()
    ElseIf key=109
      Say("MAPPER pc=") : Num(PC) : Say(" ctrl=") : Num(PpuCtrl) : Say(" mask=") : Num(PpuMask)
      Say(" m0=") : Num(M(0)) : Say(" m7=") : Num(M(7)) : Say(" irq=") : Num(PicoIrq)
      Say(" mirror=") : Num(PicoMirror) : Say(" selected=") : Num(PicoSelect)
      CompilerIf #PICO_ADVANCED=1
        Say(" clocks=") : Num(PicoIrqClocks) : Say(" count=") : Num(PicoIrqCount)
        Say(" enabled=") : Num(PicoIrqEnable) : Say(" slots=")
        For captureByte=0 To 3 : Num(PicoPrgSlots(captureByte)) : Say(",") : Next
      CompilerEndIf
      Eol()
      PicoProfileReport()
    ElseIf key=105
      Say("APU enable=") : Num(ApuEnable) : Say(" lengths=")
      Num(ApuLength(0)) : Say(",") : Num(ApuLength(1)) : Say(",") : Num(ApuLength(2))
      Say(" nonzero=") : Num(ApuNonzero) : Say(" pause_ram_776=") : Num(M($776)) : Eol()
    EndIf
    CompilerIf #PPU_PROFILE=2
      If key=103
        GuardEnabled=GuardEnabled!1
      EndIf
    CompilerEndIf
    If release<>0 And WorkerFrames-release>=0
      InputHost=0 : release=0
    EndIf
    CompilerIf #NES_AUDIO_BACKEND=1
    If BtSnapshotState=2
      Say("SBC_BEGIN") : Eol()
      For captureByte=0 To BtSnapshotSize-1 : UsbSerialWrite(BtSnapshot(captureByte)) : Next
      Eol() : Say("SBC_END") : Eol() : BtSnapshotState=0
    EndIf
    CompilerEndIf
    dt=Micros()-tick
    If dt>=176
      dt=NesDiv(dt,176) : tick=tick+dt*176 : target=target+dt*315
    EndIf
    budget=target-CpuCycles
    If mode
      budget=256
    EndIf
    ; The pacer adds 315 cycles every 176 us and windows stop at 256, so without
    ; this a ~60-cycle sliver followed every full window and paid the whole
    ; per-window cost. Less than 128 cycles (72 us) due waits for the next tick.
    If budget<128
      budget=0
    EndIf
    If budget>0 And Stopped=0 And NesBridgeError=0 And WorkerError=0
      If budget>256
        budget=256
      EndIf
      distance=241*341+1-WorkerDot
      If distance<0
        distance=distance+89342
      EndIf
      If distance>0 And budget*3>distance+2
        budget=NesDiv(distance+2,3)
      EndIf
      distance=PicoCpuBudget() : If budget>distance : budget=distance : EndIf
      mark=Micros() : CpuRun(budget) : mark2=Micros() : NesSync()
      CpuRunUs=CpuRunUs+mark2-mark : SyncUs=SyncUs+Micros()-mark2 : Windows=Windows+1 : ran=1
    EndIf
    If capturePending<>0 And DisplayReady<>captureSeen
      DumpFrame() : capturePending=0
      tick=Micros() : target=CpuCycles
    EndIf
    t=Micros()
    If t-report>=1000000
      Say("us=") : Num(t-report) : Say(" cycles=") : Num(CpuCycles-cycles)
      Say(" frames=") : Num(WorkerFrames-frames) : Say(" lcd=") : Num(WorkerDisplayed-display)
      Say(" samples=") : Num(ApuSamples-samples) : Say(" worker_us=") : Num(WorkerBusyUs-busy)
      Say(" lcd_us=") : Num(WorkerDisplayUs-lastLcd)
      Say(" render_est_us=") : Num((PpuRenderUs-lastRender)*67)
      Say(" sprites_us=") : Num(PpuSpritesUs-lastSprites)
      Say(" rgb_us=") : Num(PpuRgbUs-lastRgb) : Say(" buffer_wait_us=") : Num(DisplayWaitUs-lastWait)
      Say(" misses=") : Num(RgbMisses-lastMisses)
      Say(" ntbuild_us=") : Num(NameBuildUs-lastName) : Say(" pal_builds=") : Num(PairBuilds-lastPairs)
      Say(" ppu_us=") : Num(WorkerPpuUs-lastPpu) : Say(" apu_us=") : Num(WorkerApuUs-lastApu)
      CompilerIf #PPU_PROFILE=2
        Say(" guard_checks=") : Num(GuardChecks) : Say(" guard_fails=") : Num(GuardFails)
        Say(" guard_line=") : Num(GuardLine) : Say(" guard_dot=") : Num(GuardDot)
        Say(" guard_got=") : Num(GuardGot) : Say(" guard_expected=") : Num(GuardExpected)
      CompilerEndIf
      Say(" audio_us=") : Num(AudioBusyUs-lastBt) : Say(" audio_live=") : Num(AudioLive) : Say(" audio_wire_errors=") : Num(AudioWireErrors) : Say(" audio_overrun=") : Num(AudioOverruns)
      Say(" audio_packets=") : Num(AudioPackets) : Say(" audio_underrun=") : Num(AudioUnderruns)
      CompilerIf #NES_AUDIO_BACKEND=1
      Say(" bt_us=") : Num(AudioBusyUs-lastBt) : Say(" bt_live=") : Num(AudioLive) : Say(" bt_wire_errors=") : Num(AudioWireErrors) : Say(" bt_overrun=") : Num(AudioOverruns)
      Say(" bt_packets=") : Num(AudioPackets) : Say(" bt_underrun=") : Num(AudioUnderruns)
      CompilerEndIf
      Say(" deferred=") : Num(PpuStatusDeferred-lastDeferred) : Say(" batched=") : Num(NesIdleBatched-lastBatched)
      Say(" debt=") : Num(target-CpuCycles) : Say(" pc=") : Num(PC)
      Say(" bank_calls=") : Num(CartBankCalls) : Say(" bank_changes=") : Num(CartBankChanges)
      Say(" bank_us_total=") : Num(CartBankUs) : Say(" bank=") : Num(CartPrgSelected)
      Say(" core0_idle_us=") : Num(Core0IdleUs-lastIdle0) : Say(" core1_idle_us=") : Num(Core1IdleUs-lastIdle1)
      Say(" run_us=") : Num(CpuRunUs-lastRun) : Say(" sync_us=") : Num(SyncUs-lastSync) : Say(" windows=") : Num(Windows-lastWin)
      lastIdle0=Core0IdleUs : lastIdle1=Core1IdleUs : lastRun=CpuRunUs : lastSync=SyncUs : lastWin=Windows
      Say(" rpc_calls=") : Num(NesRpcCalls) : Say(" rpc_wait_us=") : Num(NesRpcWaitUs) : Say(" dmc=") : Num(ApuEnable&16) : Say(",") : Num(DmcBytes)
      Say(" nmi=") : Num(WorkerNmi) : Say(" err=") : Num(WorkerError+NesBridgeError)
      Say(" stop=") : Num(Stopped) : Say(" opcode=") : Num(BadOpcode) : Eol()
      report=t : cycles=CpuCycles : frames=WorkerFrames : samples=ApuSamples
      display=WorkerDisplayed : busy=WorkerBusyUs : lastPpu=WorkerPpuUs : lastApu=WorkerApuUs : lastLcd=WorkerDisplayUs
      lastBt=AudioBusyUs
      lastDeferred=PpuStatusDeferred : lastBatched=NesIdleBatched
      lastMisses=RgbMisses : lastName=NameBuildUs : lastPairs=PairBuilds
      lastRender=PpuRenderUs : lastSprites=PpuSpritesUs : lastRgb=PpuRgbUs : lastWait=DisplayWaitUs
    EndIf
    ; Core 0 idle: a whole pass of the loop that ran no CPU window.
    If ran=0 : Core0IdleUs=Core0IdleUs+Micros()-passStart : EndIf
  ForEver
EndProcedure
