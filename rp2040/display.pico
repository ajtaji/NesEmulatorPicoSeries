; Hardware-independent frame ownership. Publish only completed 256x240 frames.
; A backend owns both 120-row RGB565 buffers until it reports completion.
Global DisplayReady.i, DisplayDone.i, DisplayActive.i, DisplayWaitUs.i
Global DisplayState.i, DisplayStart.i, DisplayTicket.i
Declare DisplayPoll()
ProcedureRAM DisplayWaitLine(line.i)
  Protected start.i
  CompilerIf #NES_SPLIT<>1
    start=Micros()
    While PeekL(@DisplayDone)<>DisplayReady
      If PeekL(@DisplayActive)=DisplayReady
        If VideoCanWriteLine(line)<>0 : Break : EndIf
      EndIf
      If Micros()-start>2000000 : WorkerError=12 : ProcedureReturn : EndIf
    Wend
    DisplayWaitUs=DisplayWaitUs+Micros()-start
  CompilerEndIf
EndProcedure
ProcedureRAM DisplayTransfer()
  Protected ticket.i
  ticket=DisplayReady
  While DisplayDone<>ticket And WorkerError=0 : DisplayPoll() : Wend
EndProcedure
ProcedureRAM DisplayFrame()
  NesFence() : DisplayReady=DisplayReady+1
  CompilerIf #NES_SPLIT=1
    DisplayTransfer()
  CompilerEndIf
EndProcedure
ProcedureRAM DisplayMain()
  WorkerReady=1
  Repeat
    DisplayPoll()
  ForEver
EndProcedure
ProcedureRAM DisplayPoll()
  Protected result.i
  If DisplayState=0
    HudUpdate()
    If PeekL(@DisplayReady)<>DisplayDone
      NesFence() : DisplayTicket=PeekL(@DisplayReady)
      If WorkerDisplay=0 : DisplayDone=DisplayTicket : ProcedureReturn : EndIf
      DisplayStart=Micros()
      If VideoStart(@FrameTop(0),FrameBottom)=0
        VideoAbort() : WorkerError=10 : ProcedureReturn
      EndIf
      NesFence() : DisplayActive=DisplayTicket : DisplayState=1
    EndIf
  Else
    result=VideoPoll()
    If result=1
      WorkerDisplayUs=WorkerDisplayUs+Micros()-DisplayStart
      WorkerDisplayed=WorkerDisplayed+1
      NesFence() : DisplayDone=DisplayTicket : DisplayState=0
    ElseIf result<0 Or Micros()-DisplayStart>2000000
      VideoAbort() : WorkerError=10 : DisplayState=0
    EndIf
  EndIf
EndProcedure
