; Generated by rp2040/generate_ppu.py.
; Cache key: bits0-2 fine Y, 3-10 tile, 11 pattern table, 12-13 CHR bank,
; 14-15 palette, 16-21 the MMC5 ExRAM-attribute 4 KiB bank (descriptor bits 10-15; 0 unless
; PpuExtChr is set), 24-31 the generation. Tag is key+1, so a cleared tag never matches.
Global Dim PpuLineBuf.i(140)
Global RBatch.i, RV0.i, RSpanDot.i, RSpanV.i
ProcedureRAM PpuSpriteSpan()
  ASM
    push {r7}
    movs r4, #0
    ldr r0, =global_ppumask
    ldr r7, [r0]
    movs r0, #8
    tst r7, r0
    beq __ss_bits_done
    ldr r0, =global_rspandot
    ldr r0, [r0]
    cmp r0, #0
    bne __ss_fetch
    movs r0, #2
    tst r7, r0
    beq __ss_bits_done
__ss_fetch:
    ldr r0, =global_rspanv
    ldr r5, [r0]
    ldr r0, =global_ppuctrl
    ldr r0, [r0]
    movs r1, #16
    ands r0, r1
    lsls r0, r0, #8
    lsrs r1, r5, #12
    movs r2, #7
    ands r1, r2
    lsls r1, r1, #1
    adds r0, r0, r1
    ldr r1, =global_pattern
    ldr r1, [r1]
    adds r6, r0, r1
    ldr r0, =$0fff
    ands r0, r5
    lsls r0, r0, #1
    ldr r1, =global_namedesc
    ldrh r0, [r1, r0]
    lsls r0, r0, #24
    lsrs r0, r0, #20
    ldrh r4, [r6, r0]
    ldr r0, =global_ppufinex
    ldr r7, [r0]
    cmp r7, #0
    beq __ss_bits_done
    adds r5, #1
    movs r0, #31
    tst r5, r0
    bne __ss_next_tile
    subs r5, #32
    ldr r0, =$400
    eors r5, r0
__ss_next_tile:
    ldr r0, =$0fff
    ands r0, r5
    lsls r0, r0, #1
    ldr r1, =global_namedesc
    ldrh r0, [r1, r0]
    lsls r0, r0, #24
    lsrs r0, r0, #20
    ldrh r1, [r6, r0]
    lsls r7, r7, #1
    lsrs r4, r7
    movs r0, #16
    subs r0, r0, r7
    lsls r1, r0
    orrs r4, r1
__ss_bits_done:
    ldr r0, =global_rspandot
    ldr r5, [r0]
    ldr r6, =global_spriteline
    adds r6, r6, r5
    ldr r0, =global_framerow
    ldr r7, [r0]
    lsls r0, r5, #1
    adds r7, r7, r0
    movs r5, #0
__ss_px:
    ldrb r0, [r6, r5]
    cmp r0, #0
    beq __ss_next
    movs r1, #3
    ands r1, r4
    lsls r2, r0, #24
    bpl __ss_prio
    cmp r1, #0
    beq __ss_prio
    ldr r2, =global_rspandot
    ldr r2, [r2]
    adds r2, r2, r5
    cmp r2, #255
    beq __ss_prio
    ldr r2, =global_ppustatus
    ldr r3, [r2]
    push {r1}
    movs r1, #64
    orrs r3, r1
    str r3, [r2]
    pop {r1}
__ss_prio:
    lsls r2, r0, #25
    bpl __ss_draw
    cmp r1, #0
    bne __ss_next
__ss_draw:
    movs r1, #31
    ands r1, r0
    lsls r1, r1, #1
    ldr r2, =global_rgbpal
    ldrh r1, [r2, r1]
    lsls r2, r5, #1
    strh r1, [r7, r2]
__ss_next:
    lsrs r4, r4, #2
    adds r5, #1
    cmp r5, #8
    blo __ss_px
    pop {r7}
  EndASM
EndProcedure
ProcedureRAM PpuRenderRaw()
  CompilerIf #PPU_PROFILE=2
    Protected guardV.i, guardStatus.i, guardDo.i, guardPixelStart.i, guardJ.i, guardValue.i
    If GuardEnabled<>0
      PpuProfileCountdown=PpuProfileCountdown-1
      If PpuProfileCountdown=0
        PpuProfileCountdown=67
      guardDo=1 : guardPixelStart=PpuDot : guardV=PpuV : guardStatus=PpuStatus
      PpuRender8Reference()
      For guardJ=0 To 7
        GuardPixels(guardJ)=RgbPal(LinePixels(PpuDot+guardJ))
      Next
      PpuV=guardV : PpuStatus=guardStatus
      EndIf
    EndIf
  CompilerEndIf
  CompilerIf #PPU_PROFILE=1
    Protected timer.i
    PpuProfileCountdown=PpuProfileCountdown-1
    If PpuProfileCountdown=0
      timer=Micros()
    EndIf
  CompilerEndIf
  ASM
    push {lr}
    push {r7}
    ldr r0, =global_rgbpairsdirty
    ldr r0, [r0]
    cmp r0, #0
    beq __r_pairs_ready
    bl ppubuildrgbpairs
__r_pairs_ready:
    ldr r0, =global_namedescdirty
    ldr r0, [r0]
    cmp r0, #0
    beq __r_names_ready
    bl ppubuildnamecache
__r_names_ready:
    ldr r0, =global_ppubatchleft
    ldr r7, [r0]
    cmp r7, #0
    bne __r_count_ready
    movs r7, #1
__r_count_ready:
    ldr r0, =global_rbatch
    str r7, [r0]
    ldr r0, =global_ppuv
    ldr r4, [r0]
    ldr r0, =global_rv0
    str r4, [r0]
    ldr r0, =global_ppumask
    ldr r0, [r0]
    movs r1, #8
    tst r0, r1
    bne __r_background
    b __r_backdrop
__r_background:
    lsrs r6, r4, #12
    movs r1, #7
    ands r6, r1
    ldr r0, =global_ppuctrl
    ldr r0, [r0]
    movs r1, #16
    ands r0, r1
    lsls r0, r0, #7
    orrs r6, r0
    ldr r0, =global_ppuchrbank
    ldr r0, [r0]
    lsls r0, r0, #12
    orrs r6, r0
    ldr r0, =global_rgbtaggen
    ldr r0, [r0]
    adds r6, r6, r0
    mov r12, r6
    ldr r0, =global_ppufinex
    ldr r0, [r0]
    cmp r0, #0
    beq __r_tiles_counted
    adds r7, #1
__r_tiles_counted:
    ldr r5, =global_ppulinebuf
    ; Cortex-M33 form from tools/m33/ppu_render_tile.s (the RP2040 source holds the Thumb-1 form)
    ; PpuRenderRaw's tile loop for the RP2350's Cortex-M33 (spliced in by tools/port_rp2350.py in place
    ; of the Thumb-1 loop in rp2040/ppu_render.pico). Same contract: r4 = V, r5 = line buffer, r7 = tiles
    ; left, r12 = pattern base; leaves through __r_place. Thumb-2 does the masks with UBFX, the tag fetch
    ; and store as scaled loads ([Rn, Rm, lsl #2]), and keeps the tag base in r6, so a hit takes two literal loads, not
    ; six. A miss converts the pattern row exactly as the Thumb-1 miss does. The key carries the
    ; cache generation (RgbTagGen) in bits 24-31 and the MMC5 ExRAM bank in 16-21, so the palette comes
    ; from bits 14-15 only; with PpuExtChr set the row comes from that 4 KiB bank of the decoded CHR.
    ldr r6, =global_rgbtags
__r_tile:
    ubfx r0, r4, #0, #12
    lsls r0, r0, #1
    ldr r1, =global_namedesc
    ldrh r0, [r1, r0]
    lsrs r1, r0, #8
    lsls r0, r0, #24
    lsrs r0, r0, #21
    orr r0, r0, r1, lsl #14
    add r0, r12
    eor r1, r0, r0, lsr #10
    ubfx r1, r1, #0, #11   ; 2048 tags on the RP2350 (port_rp2350.py sizes the arrays)
    ldr r2, [r6, r1, lsl #2]
    adds r0, #1
    cmp r2, r0
    bne __r_miss
    ldr r2, =global_rgbcache
    add.w r1, r2, r1, lsl #4
__r_copy_tile:
    ldmia r1, {r0, r1, r2, r3}
    stmia r5!, {r0, r1, r2, r3}
    adds r4, #1
    movs r0, #31
    tst r4, r0
    bne __r_tile_next
    subs r4, #32
    ldr r0, =$400
    eors r4, r0
__r_tile_next:
    subs r7, #1
    bne __r_tile
    b __r_place
__r_miss:
    str r0, [r6, r1, lsl #2]
    subs r0, #1
    ldr r2, =global_rgbcache
    add.w r1, r2, r1, lsl #4
    ldr r2, =global_rgbmisses
    ldr r3, [r2]
    adds r3, #1
    str r3, [r2]
    push {r1, r4, r5}
    lsls r4, r0, #16
    lsrs r4, r4, #30
    lsls r4, r4, #6
    ldr r2, =global_rgbpairs
    adds r4, r4, r2
    ldr r2, =global_ppuextchr
    ldr r2, [r2]
    cmp r2, #0
    bne __r_ext_row
    ubfx r0, r0, #0, #12
    lsls r0, r0, #1
    ldr r2, =global_pattern
    ldr r2, [r2]
    ldrh r5, [r2, r0]
    b __r_have_row
__r_ext_row:
    ; MMC5 ExRAM attributes: key bits 16-21 pick a 4 KiB bank of the whole decoded CHR at PpuExtChr
    ubfx r3, r0, #16, #6
    add.w r2, r2, r3, lsl #12
    ubfx r0, r0, #0, #11
    lsls r0, r0, #1
    ldrh r5, [r2, r0]
__r_have_row:
    movs r0, #15
    ands r0, r5
    lsls r0, r0, #2
    ldr r2, [r4, r0]
    str r2, [r1, #0]
    lsrs r5, r5, #4
    movs r0, #15
    ands r0, r5
    lsls r0, r0, #2
    ldr r2, [r4, r0]
    str r2, [r1, #4]
    lsrs r5, r5, #4
    movs r0, #15
    ands r0, r5
    lsls r0, r0, #2
    ldr r2, [r4, r0]
    str r2, [r1, #8]
    lsrs r5, r5, #4
    lsls r0, r5, #2
    ldr r2, [r4, r0]
    str r2, [r1, #12]
    pop {r1, r4, r5}
    b __r_copy_tile
__r_place:
    ldr r0, =global_ppufinex
    ldr r0, [r0]
    ldr r1, =global_ppulinebuf
    lsrs r3, r0, #1
    lsls r3, r3, #2
    adds r1, r1, r3
    ldr r2, =global_framerow
    ldr r2, [r2]
    ldr r3, =global_ppudot
    ldr r3, [r3]
    lsls r3, r3, #1
    adds r2, r2, r3
    ldr r3, =global_rbatch
    ldr r7, [r3]
    lsrs r0, r0, #1
    bcs __r_place_odd
__r_place_even:
    ldmia r1!, {r0, r3, r4, r5}
    stmia r2!, {r0, r3, r4, r5}
    subs r7, #1
    bne __r_place_even
    b __r_clip
__r_place_odd:
    ldmia r1!, {r3}
__r_place_odd_span:
    ldmia r1!, {r4, r5}
    lsrs r3, r3, #16
    lsls r0, r4, #16
    orrs r3, r0
    str r3, [r2, #0]
    lsrs r4, r4, #16
    lsls r0, r5, #16
    orrs r4, r0
    str r4, [r2, #4]
    ldmia r1!, {r3, r4}
    lsrs r5, r5, #16
    lsls r0, r3, #16
    orrs r5, r0
    str r5, [r2, #8]
    lsrs r3, r3, #16
    lsls r0, r4, #16
    orrs r3, r0
    str r3, [r2, #12]
    movs r3, r4
    adds r2, #16
    subs r7, #1
    bne __r_place_odd_span
    b __r_clip
__r_backdrop:
    ldr r0, =global_rgbpal
    ldrh r3, [r0]
    lsls r0, r3, #16
    orrs r3, r0
    movs r4, r3
    movs r5, r3
    movs r6, r3
    ldr r2, =global_framerow
    ldr r2, [r2]
    ldr r1, =global_ppudot
    ldr r1, [r1]
    lsls r1, r1, #1
    adds r2, r2, r1
__r_backdrop_span:
    stmia r2!, {r3, r4, r5, r6}
    subs r7, #1
    bne __r_backdrop_span
__r_clip:
    ldr r0, =global_ppudot
    ldr r0, [r0]
    cmp r0, #0
    bne __r_sprites
    ldr r1, =global_ppumask
    ldr r1, [r1]
    movs r2, #2
    tst r1, r2
    bne __r_sprites
    ldr r0, =global_rgbpal
    ldrh r3, [r0]
    lsls r0, r3, #16
    orrs r3, r0
    movs r4, r3
    movs r5, r3
    movs r6, r3
    ldr r2, =global_framerow
    ldr r2, [r2]
    stmia r2!, {r3, r4, r5, r6}
__r_sprites:
    ldr r0, =global_sprcount
    ldr r0, [r0]
    cmp r0, #0
    beq __r_advance_v
    ldr r0, =global_rv0
    ldr r4, [r0]
    ldr r0, =global_ppudot
    ldr r5, [r0]
    ldr r0, =global_rbatch
    ldr r7, [r0]
__r_sprite_span:
    lsrs r0, r5, #3
    ldr r1, =global_spritespan
    ldrb r0, [r1, r0]
    cmp r0, #0
    beq __r_sprite_skip
    ldr r0, =global_rspandot
    str r5, [r0]
    ldr r0, =global_rspanv
    str r4, [r0]
    bl ppuspritespan
__r_sprite_skip:
    adds r4, #1
    movs r0, #31
    tst r4, r0
    bne __r_sprite_v
    subs r4, #32
    ldr r0, =$400
    eors r4, r0
__r_sprite_v:
    adds r5, #8
    subs r7, #1
    bne __r_sprite_span
__r_advance_v:
    ldr r0, =global_ppumask
    ldr r0, [r0]
    movs r1, #24
    tst r0, r1
    beq __r_finish
    ldr r0, =global_rv0
    ldr r4, [r0]
    ldr r0, =global_rbatch
    ldr r7, [r0]
__r_advance_loop:
    adds r4, #1
    movs r0, #31
    tst r4, r0
    bne __r_advance_next
    subs r4, #32
    ldr r0, =$400
    eors r4, r0
__r_advance_next:
    subs r7, #1
    bne __r_advance_loop
    ldr r0, =global_ppuv
    str r4, [r0]
__r_finish:
    ldr r0, =global_rbatch
    ldr r1, [r0]
    subs r1, #1
    lsls r1, r1, #3
    ldr r0, =global_ppudot
    ldr r2, [r0]
    adds r2, r2, r1
    str r2, [r0]
    ldr r0, =global_woff
    str r2, [r0]
    ldr r0, =global_ppubatchleft
    movs r1, #0
    str r1, [r0]
    pop {r7}
    pop {r0}
    mov lr, r0
  EndASM
  CompilerIf #PPU_PROFILE=2
    If guardDo
      For guardJ=0 To 7
        guardValue=PeekU(FrameRow+(guardPixelStart+guardJ)*2)
        GuardChecks=GuardChecks+1
        If guardValue<>GuardPixels(guardJ)
          If GuardFails=0
            GuardLine=PpuLine : GuardDot=guardPixelStart+guardJ
            GuardGot=guardValue : GuardExpected=GuardPixels(guardJ)
          EndIf
          GuardFails=GuardFails+1
        EndIf
      Next
    EndIf
  CompilerEndIf
  CompilerIf #PPU_PROFILE=1
    If PpuProfileCountdown=0
      PpuRenderUs=PpuRenderUs+Micros()-timer : PpuProfileCountdown=67
    EndIf
  CompilerEndIf
EndProcedure
