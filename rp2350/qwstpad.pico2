; Pimoroni Qw/ST Pads as NES controllers. The pad itself - its four addresses, up to four on a bus,
; its ten buttons and four LEDs, how it is set up and read - is PureMetal Forge's shared library
; Shared/Qwst/qwstpad.pmi (runtime.pico includes it after the I2C library); see its header for what
; the pad can and cannot be set up as. This file is only what the NES adds:
;   * players: the pads in address order are players 1-4. Players 1 and 2 are $4016 and $4017; a
;     third pad switches on the NES Four Score, and players 3 and 4 follow in the same reads after
;     the Four Score's signature (bridge.pico).
;   * the NES byte: U D L R, A, B, + Start, - Select; X is turbo A and Y turbo B, pressed and released
;     QwstTurboHz times a second (0 makes them plain A and B).
;   * debounce: a button change counts once two reads 4 ms apart agree.
;   * core 1 polls, every 4 ms, so core 0 (the CPU) spends no time on I2C. A pad that stops answering
;     reads as no buttons; the bus is searched again once a second while fewer than four pads answer,
;     so pads can be plugged in or out, at any address, while a game runs.
;
; Wiring: Qw/ST SDA -> GP8, SCL -> GP9 (I2C0), 3V3, GND by default. A board whose Qw/ST socket is
; elsewhere (the Pimoroni Pico Plus 2 W: GP4/GP5) sets QwstSda/QwstScl/QwstUnit before Main();
; QwstEnabled=0 leaves the pins alone.
#QWST_POLL_US = 4000
Global QwstEnabled.i=1, QwstUnit.i=0, QwstSda.i=8, QwstScl.i=9, QwstTurboHz.i=15
Global QwstPads.i, QwstReads.i, QwstErrors.i, QwstBusyUs.i, QwstLast.i, QwstScanLast.i, QwstReady.i
Global Dim QwstMask.i(#QWSTPAD_MAX)
Global Dim QwstRaw.i(#QWSTPAD_MAX)
Global Dim QwstCandidate.i(#QWSTPAD_MAX)

; The library's buttons to the NES byte: A B Select Start Up Down Left Right.
; turbo: 1 while a turbo button counts as pressed.
Procedure.i QwstNesButtons(b.i, turbo.i)
  Protected nes.i
  If b&#QWSTPAD_A : nes=nes|1 : EndIf
  If b&#QWSTPAD_B : nes=nes|2 : EndIf
  If b&#QWSTPAD_MINUS : nes=nes|4 : EndIf
  If b&#QWSTPAD_PLUS : nes=nes|8 : EndIf
  If b&#QWSTPAD_UP : nes=nes|$10 : EndIf
  If b&#QWSTPAD_DOWN : nes=nes|$20 : EndIf
  If b&#QWSTPAD_LEFT : nes=nes|$40 : EndIf
  If b&#QWSTPAD_RIGHT : nes=nes|$80 : EndIf
  If turbo
    If b&#QWSTPAD_X : nes=nes|1 : EndIf
    If b&#QWSTPAD_Y : nes=nes|2 : EndIf
  EndIf
  ProcedureReturn nes
EndProcedure
; Find the pads; a pad found again in the same place keeps its debounced state.
Procedure QwstScan()
  Protected n.i
  QwstPadFind()
  For n=0 To #QWSTPAD_MAX-1
    If n>=QwstPadCount()
      QwstMask(n)=0 : QwstRaw(n)=0 : QwstCandidate(n)= -1
    ElseIf n>=QwstPads
      QwstRaw(n)=0 : QwstCandidate(n)= -1
    EndIf
  Next
  QwstPads=QwstPadCount()
EndProcedure
Procedure QwstBegin()
  Protected n.i
  If QwstEnabled=0 : ProcedureReturn : EndIf
  If I2cBegin(QwstUnit,QwstSda,QwstScl,400)=0
    Say("QWSTPAD refused: I2C") : Num(QwstUnit) : Say(" on GP") : Num(QwstSda) : Say("/GP") : Num(QwstScl)
    Say(" did not start; the pad stays off") : Eol()
    QwstEnabled=0 : ProcedureReturn
  EndIf
  QwstScan() : QwstScanLast=Micros() : QwstReady=1
  Say("QWSTPAD pads=") : Num(QwstPads)
  For n=0 To QwstPads-1
    Say(" player") : Num(n+1) : Say("_address=") : Num(QwstPadAddress(n))
  Next
  Say(" sda=GP") : Num(QwstSda) : Say(" scl=GP") : Num(QwstScl) : Say(" turbo_hz=") : Num(QwstTurboHz)
  If QwstPads>2 : Say(" four_score=1") : EndIf
  Eol()
EndProcedure
; Core 1. Returns 1 when it used the bus.
Procedure.i QwstPoll()
  Protected now.i, n.i, b.i, turbo.i
  If QwstReady=0 : ProcedureReturn 0 : EndIf
  now=Micros()
  If now-QwstLast<#QWST_POLL_US : ProcedureReturn 0 : EndIf
  QwstLast=now
  If QwstPads<#QWSTPAD_MAX And now-QwstScanLast>=1000000
    QwstScanLast=now : QwstScan()
  EndIf
  ; Turbo: pressed for the first half of each 1/QwstTurboHz s period.
  If QwstTurboHz>0
    turbo=Bool((now % (1000000/QwstTurboHz))<(500000/QwstTurboHz))
  Else
    turbo=1
  EndIf
  For n=0 To QwstPads-1
    If QwstPadRead(n)<0
      ; Gone: release its buttons (and those after it) and look again on the next search.
      QwstErrors=QwstErrors+1 : QwstPads=n
      Break
    EndIf
    QwstReads=QwstReads+1
    b=QwstPadButtons(n)
    If b=QwstCandidate(n) : QwstRaw(n)=b : EndIf
    QwstCandidate(n)=b
    QwstMask(n)=QwstNesButtons(QwstRaw(n),turbo)
  Next
  For n=QwstPads To #QWSTPAD_MAX-1 : QwstMask(n)=0 : Next
  NesFence()
  QwstBusyUs=QwstBusyUs+Micros()-now
  ProcedureReturn 1
EndProcedure
