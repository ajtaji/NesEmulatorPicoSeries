    If Lo < 0
      Lo = ((Lo - 6) & 15) - 16
    EndIf
    Hi = Hi + Lo
    If Hi < 0
      Hi = Hi - $60
    EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  NextOp(2)
OpEA: ; $EA NOP imp
  NextOp(2)
OpEC: ; $EC CPX abs
  Ea = M(PC) | (M((PC + 1) & $FFFF) << 8)
  PC = (PC + 2) & $FFFF
  Res = X - M(Ea)
  NZ(Res)
  FC = ~Res
  NextOp(4)
OpED: ; $ED SBC abs
  Ea = M(PC) | (M((PC + 1) & $FFFF) << 8)
  PC = (PC + 2) & $FFFF
  Value = M(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  NZ(Res)
  If FD
    Lo = (A & 15) - (Value & 15) - Tmp
    Hi = (A & $F0) - (Value & $F0)
    If Lo < 0
      Lo = ((Lo - 6) & 15) - 16
    EndIf
    Hi = Hi + Lo
    If Hi < 0
      Hi = Hi - $60
    EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  NextOp(4)
OpEE: ; $EE INC abs
  Ea = M(PC) | (M((PC + 1) & $FFFF) << 8)
  PC = (PC + 2) & $FFFF
  Value = M(Ea)
  Res = Value + 1
  Res = Res & 255
  NZ(Res)
  M(Ea) = Res
  NextOp(6)
OpF0: ; $F0 BEQ rel
  If (FZ & 255) = 0
    CompilerIf #CPU_TIMING = 1
      Base = (PC + 1) & $FFFF
    CompilerEndIf
    Res = (M(PC) ! 128) - 128
    PC = (PC + 1 + Res) & $FFFF
    CompilerIf #CPU_TIMING = 1
      Ea = PC
      CrossPage()
    CompilerEndIf
    Charge(1)
  Else
    PC = (PC + 1) & $FFFF
  EndIf
  NextOp(2)
OpF1: ; $F1 SBC iny
  Fetch(Tmp)
  Ea = M(Tmp) | (M((Tmp + 1) & 255) << 8)
  Base = Ea
  Ea = (Ea + Y) & $FFFF
  CrossPage()
  Value = M(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  NZ(Res)
  If FD
    Lo = (A & 15) - (Value & 15) - Tmp
    Hi = (A & $F0) - (Value & $F0)
    If Lo < 0
      Lo = ((Lo - 6) & 15) - 16
    EndIf
    Hi = Hi + Lo
    If Hi < 0
      Hi = Hi - $60
    EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  NextOp(5)
OpF5: ; $F5 SBC zpx
  Fetch(Ea)
  Ea = (Ea + X) & 255
  Value = M(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  NZ(Res)
  If FD
    Lo = (A & 15) - (Value & 15) - Tmp
    Hi = (A & $F0) - (Value & $F0)
    If Lo < 0
      Lo = ((Lo - 6) & 15) - 16
    EndIf
    Hi = Hi + Lo
    If Hi < 0
      Hi = Hi - $60
    EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  NextOp(4)
OpF6: ; $F6 INC zpx
  Fetch(Ea)
  Ea = (Ea + X) & 255
  Value = M(Ea)
  Res = Value + 1
  Res = Res & 255
  NZ(Res)
  M(Ea) = Res
  NextOp(6)
OpF8: ; $F8 SED imp
  FD = 1
  NextOp(2)
OpF9: ; $F9 SBC aby
  Ea = M(PC) | (M((PC + 1) & $FFFF) << 8)
  PC = (PC + 2) & $FFFF
  Base = Ea
  Ea = (Ea + Y) & $FFFF
  CrossPage()
  Value = M(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  NZ(Res)
  If FD
    Lo = (A & 15) - (Value & 15) - Tmp
    Hi = (A & $F0) - (Value & $F0)
    If Lo < 0
      Lo = ((Lo - 6) & 15) - 16
    EndIf
    Hi = Hi + Lo
    If Hi < 0
      Hi = Hi - $60
    EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  NextOp(4)
OpFD: ; $FD SBC abx
  Ea = M(PC) | (M((PC + 1) & $FFFF) << 8)
  PC = (PC + 2) & $FFFF
  Base = Ea
  Ea = (Ea + X) & $FFFF
  CrossPage()
  Value = M(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  NZ(Res)
  If FD
    Lo = (A & 15) - (Value & 15) - Tmp
    Hi = (A & $F0) - (Value & $F0)
    If Lo < 0
      Lo = ((Lo - 6) & 15) - 16
    EndIf
    Hi = Hi + Lo
    If Hi < 0
      Hi = Hi - $60
    EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  NextOp(4)
OpFE: ; $FE INC abx
  Ea = M(PC) | (M((PC + 1) & $FFFF) << 8)
  PC = (PC + 2) & $FFFF
  Ea = (Ea + X) & $FFFF
  Value = M(Ea)
  Res = Value + 1
  Res = Res & 255
  NZ(Res)
  M(Ea) = Res
  NextOp(7)
Done:
  ProcedureReturn Budget - Left
EndProcedure
