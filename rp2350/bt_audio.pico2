; NES Bluetooth speaker output: PureMetal's Shared/Bluetooth/bt_audio.pmi (A2DP + SBC), fed from the APU's PCM ring.
; Core 0 connects (AudioBegin, from Main); core 1 streams (AudioPoll, from Core1Main). The library paces the
; stream by the clock at exactly 48 kHz and reads the APU's PCM ring directly (BtAudioSource).
; Until 2026-10-18 this file and bt_transport / bt_radio / bt_firmware / sbc_encoder were the NES's own Bluetooth
; stack; they became the compiler's libraries (the board's Lib/bluetooth library, Shared/Bluetooth/sbc.pmi
; and bt_audio.pmi), and what is left here is the NES's side of it.
Global Dim NesBtPeer.a(6)
Global NesBtPeerSet.i, NesBtLastPackets.i, NesBtLastPoll.i, NesBtLastRead.i, NesBtGap.i=700
; USB key 'k': a copy of the next media packet as it went to the radio (ACL header, L2CAP, RTP, SBC), printed by
; runtime.pico between SBC_BEGIN and SBC_END. USB key 'q': AVDTP Suspend / Start.
Global Dim BtSnapshot.a(232)               ; the largest media packet: (13 + 3 * 68 + 15) & ~3
Global BtSnapshotState.i, BtSnapshotSize.i, BtControlRequest.i

; The speaker, from the private wrapper's DataSection: 6 bytes in HCI order (least significant first), as the
; NES has always stored it. The library takes the address the way a phone shows it, so it is reversed here.
Procedure NesBluetoothSetPeer(src.i)
  Protected i.i
  For i=0 To 5 : NesBtPeer(i)=PeekA(src+5-i) : Next
  ; This speaker plays stereo correctly; mono playback left a persistent buzz.
  BtAudioStereo(1) : NesBtPeerSet=1
EndProcedure

Procedure AudioBegin()
  Protected rc.i
  AudioRunning=0 : AudioLive=0
  If NesBtPeerSet=0 : ProcedureReturn : EndIf
  PrintN("NES Bluetooth: initializing speaker")
  rc=BtAudioBegin(@NesBtPeer(0))
  Print("BT AUDIO rc=") : PrintDecN(rc)
  If rc<>0
    Print("NES Bluetooth unavailable (HCI status ") : PrintDec(BtAudioStatus()) : PrintN("); continuing without audio")
    ProcedureReturn
  EndIf
  NesBtLastPackets=0
  ; The library reads the APU's ring itself: no copy, and all 4096 samples (85 ms) are the cushion
  ; for a frame the emulator finishes late.
  BtAudioSource(@Pcm(0),4096,@ApuSamples)
  ; From here core 1 drives the radio: no USB pumping and no printing from the library.
  BtAudioPumps(0)
  AudioQueueSlack=1536 : AudioLive=1 : AudioRunning=1
EndProcedure

ProcedureRAM AudioPoll()
  Protected start.i, i.i, packets.i, sent.i
  If AudioRunning=0 : AudioWorked=0 : ProcedureReturn : EndIf
  start=Micros()
  ; Core1Main calls this once per pass, and a pass is one bus event from core 0 - tens of thousands a
  ; second. The library wants a call about every 0.15 ms while a frame is part-way encoded (three short
  ; steps) and otherwise every 0.7 ms is plenty; the passes in between return here at once, so core 0's
  ; requests are not kept waiting behind empty polls.
  If start-NesBtLastPoll<NesBtGap And BtControlRequest=0
    AudioWorked=0 : ProcedureReturn
  EndIf
  NesBtLastPoll=start
  If BtControlRequest<>0
    If BtAudioLive() : BtAudioPause(1) : Else : BtAudioPause(0) : EndIf
    BtControlRequest=0
  EndIf
  BtAudioPoll()
  If BtAudioBusy() : NesBtGap=150 : Else : NesBtGap=700 : EndIf
  packets=BtAudioPackets()
  sent=Bool(packets<>NesBtLastPackets)
  If sent Or start-NesBtLastRead>100000
    ; The counters change at most once a packet (125 a second): read them then, and every 0.1 s so a
    ; dropped link still shows.
    AudioLive=BtAudioLive()
    AudioUnderruns=BtAudioUnderruns()
    AudioOverruns=BtAudioOverruns()
    NesBtLastRead=start
  EndIf
  If sent
    If BtSnapshotState=1
      ; bt_tx still holds the media packet just sent.
      BtSnapshotSize=(13+SbcFrameBytes()*3+15)&(~3)
      For i=0 To BtSnapshotSize-1 : BtSnapshot(i)=bt_tx[i] : Next
      BtSnapshotState=2
    EndIf
    NesBtLastPackets=packets
  EndIf
  AudioPackets=packets
  AudioWorked=1 : AudioBusyUs=AudioBusyUs+Micros()-start
EndProcedure
