#CLOCK_KHZ=150000
#NES_VIDEO_BACKEND=4
#NES_AUDIO_BACKEND=0
#PPU_PROFILE=0
#CPU_TIMING=1
#CPU_ASM_TAIL=1
#NES_SPLIT=2
#CART_MAPPER=0
#CART_PRG_BANKS=1
#CART_CHR_BANKS=2
#CART_MIRROR=1
EnableExplicit
XIncludeFile "runtime.pico2"
XIncludeFile "cartridge.pico2"
; Bare-board profile: USB controls, independent of the display plugin.
InputPhysicalEnabled=0
Main()
