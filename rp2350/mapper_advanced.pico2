; RP2350 cartridge windows. The original CPU fetch and pixel engines remain.
ProcedureRAM.i PicoAdvancedSupported(mapper.i)
  ProcedureReturn mapper=1 Or mapper=4 Or mapper=13 Or mapper=47 Or mapper=118 Or mapper=119 Or mapper=206
EndProcedure
ProcedureRAM.i PicoMmc3(mapper.i)
  ProcedureReturn mapper=4 Or mapper=47 Or mapper=118 Or mapper=119
EndProcedure
ProcedureRAM PicoPrgMap(slot.i,bank.i)
  Protected bias.i,started.i
  If CartMapper=47 : bank=(bank&15)|(PicoOuter<<4) : EndIf
  bank=bank&((PicoPrgBytes/8192)-1)
  If PicoPrgSlots(slot)<>bank
    started=Micros() : bias=CartPrg+bank*8192-$8000-slot*8192
    PicoPrgBiases(slot)=bias : PicoPrgSlots(slot)=bank : PicoPrgChanged=1
    If PicoPrgFenceNeeded
      ; Immutable bank views: earlier DMC work reads the old worker mapping;
      ; this timestamped event changes only the worker's subsequent reads.
      NesPost(6,slot,bias,PicoBankStamp)
    Else
      PicoWorkerBiases(slot)=bias
    EndIf
    PicoPrgCopyUs=PicoPrgCopyUs+Micros()-started : PicoPrgCopies=PicoPrgCopies+1
  EndIf
EndProcedure
ProcedureRAM PicoChrMap(slot.i,bank.i)
  Protected tag.i,raw.i,bits.i,started.i
  If CartMapper=47 : bank=(bank&127)|(PicoOuter<<7) : EndIf
  If CartChrRam Or (CartMapper=119 And (bank&64)<>0)
    bank=bank&((PicoChrRamBytes/1024)-1) : tag=256+bank
    raw=@PicoChrRam(bank*1024) : bits=@PicoChrRamDecoded(bank*1024)
  Else
    bank=bank&((PicoChrBytes/1024)-1) : tag=bank
    raw=CartChr+bank*1024 : bits=PicoChrDecoded+bank*1024
  EndIf
  If PicoChrSlots(slot)<>tag
    started=Micros()
    PicoCopy((@Decoded(0)+8192)+slot*1024,raw,1024)
    PicoCopy(@Decoded(0)+slot*1024,bits,1024)
    PicoChrSlots(slot)=tag : PicoInvalidateChr()
    PicoChrCopyUs=PicoChrCopyUs+Micros()-started : PicoChrCopies=PicoChrCopies+1
  EndIf
EndProcedure
ProcedureRAM PicoTxMirror()
  Protected table.i,page.i,i.i
  For table=0 To 3
    If PicoSelect&128 : page=(PicoRegs(table+2)>>7)&1
    Else : page=(PicoRegs(table/2)>>7)&1 : EndIf
    If PicoNtSlots(table)<>page
      PicoNtSlots(table)=page
      PicoCopy(@Nt(0)+table*1024,@PicoCiram(0)+page*1024,1024)
      PicoCopy(@NameDesc(0)+table*2048,@PicoNtDesc(0)+page*2048,2048)
      BgCacheAddr=-1 : RgbLastKey=-1
    EndIf
  Next
EndProcedure
ProcedureRAM PicoMmc3PrgUpdate()
  Protected bank.i
    bank=PicoRegs(6)&63
    If (PicoSelect&64)<>0 And CartMapper<>206
      PicoPrgMap(0,PicoPrgBytes/8192-2) : PicoPrgMap(2,bank)
    Else
      PicoPrgMap(0,bank) : PicoPrgMap(2,PicoPrgBytes/8192-2)
    EndIf
    PicoPrgMap(1,PicoRegs(7)&63) : PicoPrgMap(3,PicoPrgBytes/8192-1)
EndProcedure
ProcedureRAM PicoMmc3ChrUpdate()
  Protected base.i,i.i
    base=0 : If (PicoSelect&128)<>0 And CartMapper<>206 : base=4 : EndIf
    PicoChrMap(base,PicoRegs(0)&254) : PicoChrMap(base+1,PicoRegs(0)|1)
    PicoChrMap(base+2,PicoRegs(1)&254) : PicoChrMap(base+3,PicoRegs(1)|1)
    base=base!4
    For i=0 To 3 : PicoChrMap(base+i,PicoRegs(i+2)) : Next
    If CartMapper=118 : PicoTxMirror() : EndIf
EndProcedure
ProcedureRAM PicoAdvancedUpdate()
  Protected i.i,bank.i,mode.i,mirror.i
  If CartMapper=1
    mode=(PicoControl>>2)&3 : bank=PicoPrgReg&15
    If mode<2
      For i=0 To 3 : PicoPrgMap(i,(bank&14)*2+i) : Next
    ElseIf mode=2
      PicoPrgMap(0,0) : PicoPrgMap(1,1) : PicoPrgMap(2,bank*2) : PicoPrgMap(3,bank*2+1)
    Else
      PicoPrgMap(0,bank*2) : PicoPrgMap(1,bank*2+1)
      PicoPrgMap(2,PicoPrgBytes/8192-2) : PicoPrgMap(3,PicoPrgBytes/8192-1)
    EndIf
    For i=0 To 7
      bank=(PicoChrLow&30)*4+i
      If PicoControl&16
        If i<4 : bank=PicoChrLow*4+i : Else : bank=PicoChrHigh*4+i-4 : EndIf
      EndIf
      PicoChrMap(i,bank)
    Next
    mirror=PicoControl&3
    If mirror<2 : mirror=mirror+2 : Else : mirror=(mirror&1)!1 : EndIf
    PicoMirrorSet(mirror) : PicoRamEnable=(PicoPrgReg&16)=0
  ElseIf CartMapper=13
    For i=0 To 3
      PicoPrgMap(i,i) : PicoChrMap(i,i) : PicoChrMap(i+4,(PicoChrLow&3)*4+i)
    Next
  Else
    PicoMmc3PrgUpdate() : PicoMmc3ChrUpdate()
  EndIf
  PrgBase=CartPrg : PrgBias=PrgBase-$8000 : WorkerPrgBase=PrgBase
  ; Pattern-table writes reach the mapper only on a board with CHR RAM (TQROM's is half of it).
  Chr=(@Decoded(0)+8192) : Pattern=@Decoded(0) : ChrWritable=Bool(CartChrRam<>0 Or CartMapper=119)
EndProcedure
Procedure PicoAdvancedInit()
  Protected i.i
  PicoPrgPaged=1 : PicoPrgFenceNeeded=0 : PicoPrgChanged=0
  PicoControl=12 : PicoShift=16 : PicoChrLow=0 : PicoChrHigh=0 : PicoPrgReg=0 : PicoLastWrite=-10
  PicoSelect=0 : PicoIrq=0 : PicoIrqEnable=0 : PicoIrqLatch=0 : PicoIrqCount=0 : PicoIrqReload=0
  PicoDots=0 : PicoA12High=0 : PicoLowSince=0 : PicoSpriteBits=255
  PicoIrqClocks=0 : PicoIrqAssertions=0 : PicoIrqDot=0 : PicoChrRamBytes=8192
  If CartMapper=13 : PicoChrRamBytes=16384 : PicoMirrorSet(1) : EndIf
  For i=0 To 7 : PicoRegs(i)=0 : PicoChrSlots(i)=-1 : Next
  PicoRegs(1)=2 : PicoRegs(2)=4 : PicoRegs(3)=5 : PicoRegs(4)=6 : PicoRegs(5)=7 : PicoRegs(7)=1
  For i=0 To 3 : PicoPrgSlots(i)=-1 : Next
  For i=0 To 8191 : PicoPrgRam(i)=0 : Next
  For i=0 To 16383 : PicoChrRam(i)=0 : PicoChrRamDecoded(i)=0 : Next
  PicoRamEnable=1 : If CartMapper=13 Or CartMapper=206 : PicoRamEnable=0 : EndIf
  PicoAdvancedUpdate()
EndProcedure
ProcedureRAM PicoAdvancedWrite(addr.i,value.i,stamp.i)
  Protected commit.i,syncPpu.i
  ; RAM writes do not alter PPU mapping or the DMC's $8000-$FFFF bus.
  If addr<$8000 And CartMapper<>47
    If addr>=$6000 And PicoRamEnable And PicoRamPresent And PicoRamProtect=0
      PicoPrgRam(addr&8191)=value
    EndIf
    ProcedureReturn
  EndIf
  syncPpu=1
  If PicoMmc3(CartMapper) Or CartMapper=206
    If addr>=$8000 And addr<$A000
      If addr&1
        commit=PicoSelect&7
        If commit>=6 Or PicoRegs(commit)=value : syncPpu=0 : EndIf
      Else
        If CartMapper=206 Or ((PicoSelect!value)&128)=0 : syncPpu=0 : EndIf
      EndIf
    ElseIf (addr&$E001)=$A001 : syncPpu=0
    EndIf
  EndIf
  If syncPpu : PpuSync(stamp) : EndIf
  ; PRG switches publish timestamped worker page events, with no mutable copy.
  PicoBankStamp=stamp : PicoPrgFenceNeeded=1 : PicoPrgChanged=0
  If CartMapper=13
    If addr>=$8000 : PicoChrLow=value&3 : PicoAdvancedUpdate() : EndIf
  ElseIf CartMapper=206
    If addr>=$8000
      If addr&1
        commit=PicoSelect&7 : value=value&63
        If PicoRegs(commit)<>value
          PicoRegs(commit)=value
          If commit<6 : PicoMmc3ChrUpdate() : Else : PicoMmc3PrgUpdate() : EndIf
        EndIf
      Else : PicoSelect=value&7 : EndIf
    EndIf
  ElseIf addr<$8000
    If addr>=$6000
      If CartMapper=47
        If PicoRamEnable And PicoRamProtect=0 : PicoOuter=value&1 : PicoAdvancedUpdate() : EndIf
      ElseIf PicoRamEnable And PicoRamPresent And PicoRamProtect=0
        PicoPrgRam(addr&8191)=value
      EndIf
    EndIf
  ElseIf CartMapper=1
    commit=stamp-PicoLastWrite : PicoLastWrite=stamp
    If commit=1 And (value&128)=0 : PicoPrgFenceNeeded=0 : CpuEndWindow() : ProcedureReturn : EndIf
    If value&128 : PicoShift=16 : PicoControl=PicoControl|12 : PicoAdvancedUpdate()
    Else
      commit=PicoShift&1 : PicoShift=(PicoShift>>1)|((value&1)<<4)
      If commit
        If addr<$A000 : PicoControl=PicoShift
        ElseIf addr<$C000 : PicoChrLow=PicoShift
        ElseIf addr<$E000 : PicoChrHigh=PicoShift
        Else : PicoPrgReg=PicoShift : EndIf
        PicoShift=16 : PicoAdvancedUpdate()
      EndIf
    EndIf
  Else
    Select addr&$E001
      Case $8000
        commit=PicoSelect!value : PicoSelect=value
        If commit&64 : PicoMmc3PrgUpdate() : EndIf
        If commit&128 : PicoMmc3ChrUpdate() : EndIf
      Case $8001
        commit=PicoSelect&7
        If PicoRegs(commit)<>value
          PicoRegs(commit)=value
          If commit<6 : PicoMmc3ChrUpdate() : Else : PicoMmc3PrgUpdate() : EndIf
        EndIf
      Case $A000 : If CartMapper<>118 : PicoMirrorSet((value&1)!1) : EndIf
      Case $A001 : PicoRamEnable=(value&128)<>0 : PicoRamProtect=(value&64)<>0
      Case $C000 : PicoIrqLatch=value
      Case $C001 : PicoIrqReload=1
      Case $E000 : PicoIrqEnable=0 : PicoIrq=0
      Case $E001 : PicoIrqEnable=1
    EndSelect
  EndIf
  PicoPrgFenceNeeded=0
  If WorkerNmi<>NesSeenNmi Or (PicoIsMmc3<>0 And addr>=$C000)
    CpuEndWindow()
  EndIf
EndProcedure
; $2007 into the pattern tables on a PicoAdvancedChrWrite board (TQROM, the CHR-RAM MMC3 boards): NesWrite's
; PPU-register branch with PpuRegWrite, PpuWrite and PicoChrWrite, step for step and in their order, without
; the dispatch between them. Pinbot clears 4 KiB of CHR RAM with the background on: ~43,000 writes a second,
; ~14 us each the long way. The PPU is brought to the write first (rendering moves V); a V outside the
; pattern tables returns 0 and the ordinary path finishes the write (its PpuSync is then a no-op).
ProcedureRAM.i PicoChrWriteFast(value.i)
  Protected addr.i
  If ChrWritable=0 Or CartMapper=5 : ProcedureReturn 0 : EndIf
  CpuNow() : PpuSync(CpuCycles+AccessPhase)
  If (PpuV&$3FFF)>=$2000 : ProcedureReturn 0 : EndIf
  If CartChrRam<>0 : CartPpuWriteNotice(7,value) : EndIf
  PpuBus=value : BgCacheAddr= -1 : RgbLastKey= -1
  addr=PpuV&$3FFF
  PicoPpuNotice(addr)
  PicoAdvancedChrWrite(addr,value)
  If PpuCtrl&4
    PpuV=(PpuV+32)&$7FFF
  Else
    PpuV=(PpuV+1)&$7FFF
  EndIf
  NesNmiDelay=0
  PicoPpuNotice(PpuV&$3FFF) : PicoCpuPpuChanged()
  ProcedureReturn 1
EndProcedure
ProcedureRAM PicoAdvancedChrWrite(addr.i,value.i)
  Protected tag.i,offset.i,row.i,bits.i,slot.i
  tag=PicoChrSlots(addr>>10)
  If tag<256 : ProcedureReturn : EndIf
  offset=(tag-256)*1024+(addr&1023)
  PicoChrRam(offset)=value : PokeA(Chr+addr,value) : PpuDecode(addr)
  row=(addr&$1FF0)+(addr&7)*2 : bits=PeekU(Pattern+row)
  PokeU(@PicoChrRamDecoded((tag-256)*1024)+(row&1023),bits)
  For slot=0 To 7
    If PicoChrSlots(slot)=tag
      PokeA(Chr+slot*1024+(addr&1023),value)
      PokeU(Pattern+slot*1024+(row&1023),bits)
      ; TQROM: the RAM bank's row at each PPU address it shows at, in the tile cache
      If CartChrRam=0 And PpuChrBank=0 : PpuForgetChrRow(slot*1024+(addr&1023)) : EndIf
    EndIf
  Next
  ; A CHR-RAM board's tile cache is flushed by CartPpuWriteNotice, deferred while the background is
  ; off: invalidating here too, per byte, ran the cache generation round every 256 bytes, and each
  ; wrap rebuilt the palette pairs and wiped the tags (Mega Man 4's intro uploads ~8000 bytes a
  ; second: 31 rebuilds, ~200 ms hitches). TQROM's RAM half (CartChrRam=0) forgets just the rows
  ; written (PpuForgetChrRow above, exact): the whole-cache generation per byte rebuilt the palette pairs
  ; every 256 bytes - Pinbot clearing 4 KiB of CHR RAM with the background on fell to 30-40 FPS each time.
  If CartChrRam=0 And PpuChrBank<>0 : PicoInvalidateChr() : EndIf
  BgCacheAddr=-1
EndProcedure
ProcedureRAM PicoA12(addr.i,dot.i)
  Protected high.i
  high=(addr&$1000)<>0
  If high<>PicoA12High
    If high=0 : PicoLowSince=dot
    ElseIf dot-PicoLowSince>=10
      PicoIrqClocks=PicoIrqClocks+1
      If PicoIrqCount=0 Or PicoIrqReload : PicoIrqCount=PicoIrqLatch
      Else : PicoIrqCount=PicoIrqCount-1 : EndIf
      PicoIrqReload=0
      If PicoIrqCount=0 And PicoIrqEnable
        If PicoIrq=0 : PicoIrqAssertions=PicoIrqAssertions+1 : PicoIrqDot=dot : EndIf
        PicoIrq=1
      EndIf
    EndIf
    PicoA12High=high
  EndIf
EndProcedure
ProcedureRAM PicoSpriteFetch(line.i)
  Protected i.i,n.i,nextLine.i,first.i,sprite.i
  PicoSpriteBits=0
  If (PpuCtrl&32)=0
    If PpuCtrl&8 : PicoSpriteBits=255 : EndIf
    ProcedureReturn
  EndIf
  PicoSpriteBits=255 : nextLine=line+1 : If line=PpuPreLine : nextLine=0 : EndIf
  If nextLine<240
    ; Reuse the renderer's physical OAM evaluation. A second 64-sprite scan
    ; on every line dominated the mapper observer in 8x16-sprite games.
    If OamCacheDirty : PpuBuildSpriteCache() : EndIf
    n=CachedCount(nextLine) : If n>8 : n=8 : EndIf
    For i=0 To n-1
      sprite=CachedSprite(nextLine*8+i)
      If (Oam(sprite*4+1)&1)=0 : PicoSpriteBits=PicoSpriteBits&($FF!(1<<i)) : EndIf
    Next
    ProcedureReturn
  EndIf
  ; Native visible-row cache stops at 239; fetches on line 239 evaluate 240.
  For i=0 To 63
    first=Oam(i*4)+1
    If nextLine>=first And nextLine<first+16
      If (Oam(i*4+1)&1)=0 : PicoSpriteBits=PicoSpriteBits&($FF!(1<<n)) : EndIf
      n=n+1 : If n=8 : Break : EndIf
    EndIf
  Next
EndProcedure
; The A12 observer: the PPU's pattern fetches over the next cycles CPU cycles, each A12 edge into the
; MMC3 counter. Thumb-1 (both chips): r4 dots left, r5 line, r6 dot, r7 PicoDots; the A12 edge rule
; (PicoA12) is the local __m3_a12 (r0 level 0/1, r1 dot). Three paths, as in the Basic form it
; replaced: a whole rendered line with 8x8 sprites is its fixed few edges; a constant-high pattern
; region keeps only its first qualifying rise and the final level and last fall; otherwise it steps
; fetch edge to fetch edge. Diagnostics/asm_reference ObserverTests hold it to the per-dot
; PicoMmc3TicksReference (Diagnostics/mapper_reference.pico).
Global Mmc3Left.i, Mmc3Odd.i, Mmc3Width.i, Mmc3End.i, Mmc3FirstHigh.i
ProcedureRAM PicoMmc3Ticks(cycles.i)
  Mmc3Left=cycles*3 : If CartPal : Mmc3Left=PpuDotsFor(cycles) : EndIf
  Mmc3Odd=PpuOdd
  ASM
    push {lr}
    push {r7}
    ldr r0, =global_mmc3left
    ldr r4, [r0]
    ldr r0, =global_ppuline
    ldr r5, [r0]
    ldr r0, =global_ppudot
    ldr r6, [r0]
    ldr r0, =global_picodots
    ldr r7, [r0]
__m3_loop:
    cmp r4, #0
    bgt __m3_go
    b __m3_done
__m3_go:
    ; width: 340 on an odd frame's rendered pre-render line, else 341
    ldr r0, =341
    ldr r1, =global_ppupreline
    ldr r1, [r1]
    cmp r5, r1
    bne __m3_wset
    ldr r1, =global_mmc3odd
    ldr r1, [r1]
    cmp r1, #0
    beq __m3_wset
    ldr r1, =global_ppumask
    ldr r1, [r1]
    movs r2, #24
    tst r1, r2
    beq __m3_wset
    subs r0, #1
__m3_wset:
    ldr r1, =global_mmc3width
    str r0, [r1]
    ; r12: 1 when this line fetches (rendering on, a visible or the pre-render line)
    movs r3, #0
    ldr r1, =global_ppumask
    ldr r1, [r1]
    movs r2, #24
    tst r1, r2
    beq __m3_rset
    cmp r5, #240
    blt __m3_ron
    ldr r1, =global_ppupreline
    ldr r1, [r1]
    cmp r5, r1
    bne __m3_rset
__m3_ron:
    movs r3, #1
__m3_rset:
    mov r12, r3
    ; a whole rendered line, 8x8 sprites
    cmp r6, #0
    bne __m3_regions
    cmp r4, r0
    blt __m3_regions
    cmp r3, #0
    beq __m3_regions
    ldr r2, =global_ppuctrl
    ldr r2, [r2]
    movs r1, #32
    tst r2, r1
    bne __m3_regions
    movs r0, #0
    adds r1, r7, #1
    bl __m3_a12
    ldr r2, =global_ppuctrl
    ldr r2, [r2]
    movs r1, #16
    tst r2, r1
    beq __m3_fl_bg0
    movs r0, #1
    adds r1, r7, #5
    bl __m3_a12
    ldr r2, =global_ppuctrl
    ldr r2, [r2]
    movs r1, #8
    tst r2, r1
    bne __m3_fl_337
    movs r0, #0
    ldr r1, =257
    adds r1, r1, r7
    bl __m3_a12
    movs r0, #1
    ldr r1, =325
    adds r1, r1, r7
    bl __m3_a12
__m3_fl_337:
    movs r0, #0
    ldr r1, =337
    adds r1, r1, r7
    bl __m3_a12
    b __m3_fl_end
__m3_fl_bg0:
    movs r1, #8
    tst r2, r1
    beq __m3_fl_end
    movs r0, #1
    ldr r1, =261
    adds r1, r1, r7
    bl __m3_a12
    movs r0, #0
    ldr r1, =321
    adds r1, r1, r7
    bl __m3_a12
__m3_fl_end:
    ldr r2, =global_ppuctrl
    ldr r2, [r2]
    movs r0, #0
    movs r1, #8
    tst r2, r1
    beq __m3_fl_bits
    movs r0, #255
__m3_fl_bits:
    ldr r1, =global_picospritebits
    str r0, [r1]
    ldr r0, =global_mmc3width
    ldr r0, [r0]
    adds r7, r7, r0
    subs r4, r4, r0
    bl __m3_nextline
    b __m3_loop
__m3_regions:
    ; a constant-high pattern region: r0 its last dot, or 0 when none
    movs r0, #0
    cmp r3, #0
    beq __m3_edge
    ldr r1, =257
    cmp r6, r1
    bge __m3_reg2
    ldr r2, =global_ppuctrl
    ldr r2, [r2]
    movs r1, #16
    tst r2, r1
    beq __m3_edge
    ldr r0, =256
    b __m3_high
__m3_reg2:
    ldr r1, =321
    cmp r6, r1
    bge __m3_reg3
    ldr r2, =global_picospritebits
    ldr r2, [r2]
    cmp r2, #255
    bne __m3_edge
    ldr r0, =320
    b __m3_high
__m3_reg3:
    ldr r1, =337
    cmp r6, r1
    bge __m3_edge
    ldr r2, =global_ppuctrl
    ldr r2, [r2]
    movs r1, #16
    tst r2, r1
    beq __m3_edge
    ldr r0, =336
__m3_high:
    subs r1, r0, r6
    cmp r1, r4
    ble __m3_hstep
    movs r1, r4
__m3_hstep:
    cmp r1, #0
    ble __m3_edge
    ; endDot, the first fall and the first rise at or after dot
    adds r0, r6, r1
    ldr r1, =global_mmc3end
    str r0, [r1]
    adds r2, r6, #7
    lsrs r2, r2, #3
    lsls r2, r2, #3
    adds r2, #1
    adds r3, r6, #3
    lsrs r3, r3, #3
    lsls r3, r3, #3
    adds r3, #5
    ldr r1, =global_mmc3firsthigh
    str r3, [r1]
    cmp r2, r3
    bge __m3_h_nolow
    cmp r2, r0
    bgt __m3_h_nolow
    subs r1, r2, r6
    adds r1, r1, r7
    movs r0, #0
    bl __m3_a12
__m3_h_nolow:
    ldr r0, =global_mmc3end
    ldr r0, [r0]
    ldr r3, =global_mmc3firsthigh
    ldr r3, [r3]
    cmp r3, r0
    bgt __m3_h_nohigh
    subs r1, r3, r6
    adds r1, r1, r7
    movs r0, #1
    bl __m3_a12
__m3_h_nohigh:
    ; the last fall: PicoLowSince when it follows the first rise
    ldr r0, =global_mmc3end
    ldr r0, [r0]
    subs r2, r0, #1
    lsrs r2, r2, #3
    lsls r2, r2, #3
    adds r2, #1
    ldr r3, =global_mmc3firsthigh
    ldr r3, [r3]
    cmp r2, r3
    ble __m3_h_nolast
    cmp r2, r0
    bgt __m3_h_nolast
    subs r1, r2, r6
    adds r1, r1, r7
    ldr r3, =global_picolowsince
    str r1, [r3]
__m3_h_nolast:
    ; the final level: the last edge passed (every 4 dots from 1) is a rise when it is dot 5 mod 8
    subs r2, r0, #1
    lsrs r2, r2, #2
    lsls r2, r2, #2
    adds r2, #1
    cmp r2, r6
    ble __m3_h_move
    movs r1, #7
    ands r2, r1
    movs r1, #0
    cmp r2, #5
    bne __m3_h_level
    movs r1, #1
__m3_h_level:
    ldr r2, =global_picoa12high
    str r1, [r2]
__m3_h_move:
    subs r1, r0, r6
    subs r4, r4, r1
    adds r7, r7, r1
    movs r6, r0
    b __m3_loop
__m3_edge:
    ; the next fetch edge: r0
    ldr r0, =global_mmc3width
    ldr r0, [r0]
    mov r3, r12
    cmp r3, #0
    beq __m3_estep
    ldr r1, =337
    cmp r6, r1
    bge __m3_estep
    movs r0, #1
    cmp r6, #0
    beq __m3_e_low
    subs r0, r6, #1
    lsrs r0, r0, #2
    lsls r0, r0, #2
    adds r0, #5
__m3_e_low:
    ldr r2, =global_picoa12high
    ldr r2, [r2]
    cmp r2, #0
    bne __m3_estep
    ldr r3, =global_ppuctrl
    ldr r3, [r3]
    movs r1, #16
    tst r3, r1
    bne __m3_e_sprites
    ldr r1, =257
    cmp r6, r1
    bge __m3_e_late
    movs r0, r1
    b __m3_estep
__m3_e_late:
    ldr r1, =321
    cmp r6, r1
    blt __m3_e_sprites
    ldr r0, =337
    b __m3_estep
__m3_e_sprites:
    ; a whole sprite interval on pattern table zero
    ldr r1, =257
    cmp r6, r1
    blt __m3_estep
    ldr r1, =321
    cmp r6, r1
    bge __m3_estep
    ldr r2, =global_picospritebits
    ldr r2, [r2]
    cmp r2, #0
    bne __m3_estep
    movs r0, r1
__m3_estep:
    subs r1, r0, r6
    cmp r1, r4
    ble __m3_etake
    movs r1, r4
__m3_etake:
    adds r6, r6, r1
    subs r4, r4, r1
    adds r7, r7, r1
    cmp r6, r0
    beq __m3_at_edge
    b __m3_loop
__m3_at_edge:
