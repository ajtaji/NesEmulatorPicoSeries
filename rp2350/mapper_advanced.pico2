    b __m3_loop
__m3_fetch:
    ldr r1, =257
    cmp r6, r1
    bne __m3_f_level
    movs r0, r5
    bl picospritefetch
__m3_f_level:
    ; r0: the fetch's A12 (1 = pattern table $1000)
    movs r0, #0
    movs r1, #7
    ands r1, r6
    cmp r1, #5
