    ldr r1, =257
    cmp r6, r1
    blt __m3_f_bg
    ldr r1, =321
    cmp r6, r1
    bge __m3_f_bg
    ldr r1, =261
    subs r1, r6, r1
    lsrs r1, r1, #3
    ldr r2, =global_picospritebits
    ldr r2, [r2]
    lsrs r2, r2, r1
    movs r1, #1
    ands r2, r1
    movs r0, r2
    b __m3_f_edge
__m3_f_bg:
    ldr r2, =global_ppuctrl
    ldr r2, [r2]
    lsrs r2, r2, #4
    movs r1, #1
    ands r2, r1
    movs r0, r2
__m3_f_edge:
    movs r1, r7
    bl __m3_a12
    b __m3_loop
; the next line (dot is already 0): r5 wraps at the frame, flipping the odd frame when NTSC
__m3_nextline:
    adds r5, #1
    ldr r1, =global_ppulinecount
    ldr r1, [r1]
    cmp r5, r1
    bne __m3_nl_done
    movs r5, #0
    ldr r1, =global_mmc3odd
    ldr r2, [r1]
    ldr r3, =global_ppuoddtoggle
    ldr r3, [r3]
    eors r2, r3
    str r2, [r1]
__m3_nl_done:
    bx lr
; PicoA12: r0 the level (0/1), r1 the absolute dot. A rise 10 or more dots after the last fall clocks
; the counter (reload at 0 or on request, else count down); reaching 0 with IRQs on raises it.
__m3_a12:
    ldr r2, =global_picoa12high
    ldr r3, [r2]
    cmp r0, r3
    beq __m3_a12_ret
    str r0, [r2]
    cmp r0, #0
    bne __m3_a12_rise
    ldr r2, =global_picolowsince
    str r1, [r2]
    bx lr
__m3_a12_rise:
    ldr r2, =global_picolowsince
    ldr r2, [r2]
    subs r2, r1, r2
    cmp r2, #10
    blt __m3_a12_ret
    ldr r2, =global_picoirqclocks
    ldr r3, [r2]
    adds r3, #1
    str r3, [r2]
    ldr r2, =global_picoirqcount
    ldr r3, [r2]
    cmp r3, #0
    beq __m3_a12_reload
    ldr r0, =global_picoirqreload
    ldr r0, [r0]
    cmp r0, #0
    bne __m3_a12_reload
    subs r3, #1
    b __m3_a12_count
__m3_a12_reload:
    ldr r3, =global_picoirqlatch
    ldr r3, [r3]
__m3_a12_count:
    str r3, [r2]
    ldr r0, =global_picoirqreload
    movs r2, #0
    str r2, [r0]
    cmp r3, #0
    bne __m3_a12_ret
    ldr r0, =global_picoirqenable
    ldr r0, [r0]
    cmp r0, #0
    beq __m3_a12_ret
    ldr r0, =global_picoirq
    ldr r2, [r0]
    cmp r2, #0
    bne __m3_a12_ret
    movs r2, #1
    str r2, [r0]
    ldr r0, =global_picoirqassertions
    ldr r2, [r0]
    adds r2, #1
    str r2, [r0]
    ldr r0, =global_picoirqdot
    str r1, [r0]
__m3_a12_ret:
    bx lr
__m3_done:
    ldr r0, =global_picodots
    str r7, [r0]
    pop {r7}
    pop {r0}
    mov lr, r0
  EndASM
EndProcedure
