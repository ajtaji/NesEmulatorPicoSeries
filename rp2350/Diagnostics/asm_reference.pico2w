#CLOCK_KHZ=150000
; The NES's hand-written assembly held to the plain PureBasic it replaced. Each Compare* runs the
; reference (the routine as it was before it became assembly) and the assembly from the same state and
; checks they leave the same state behind. Kept apart from verify.picow so that image stays below the
; ROM store at $50000 (tools/build.ps1 refuses one that reaches it). Build and run it through
; tools/build.ps1 -VerifyNes, like verify: it ends with "NES board checks=... PASS".
#NES_VIDEO_BACKEND=1
#NES_AUDIO_BACKEND=1
#PPU_PROFILE=0
#CPU_TIMING=1
#CPU_ASM_TAIL=1
#NES_SPLIT=2
#CART_MAPPER=0
#CART_PRG_BANKS=1
#CART_CHR_BANKS=1
#CART_MIRROR=1
EnableExplicit
XIncludeFile "../runtime.pico2"
XIncludeFile "../cartridge.pico2"
XIncludeFile "Shared/Bluetooth/Diagnostics/sbc_vectors.pmi"
Global Checks.i, Failures.i
Procedure Check(actual.i, expected.i)
  Checks=Checks+1
  If actual<>expected
    Failures=Failures+1
    If Failures<=16
      Say("FAIL check=") : Num(Checks) : Say(" actual=") : Num(actual)
      Say(" expected=") : Num(expected) : Eol()
    EndIf
  EndIf
EndProcedure
Global VerifySeed.i=12345
Procedure.i VerifyRand(range.i)
  VerifySeed=(VerifySeed*1103515245+12345)&$7FFFFFFF
  ProcedureReturn (VerifySeed>>8)%range
EndProcedure

; worker.pico's PpuSyncStatus in its plain form, before it became assembly.
Procedure PpuSyncStatusReference(stamp.i)
  Protected edge.i, line.i, spriteY.i, height.i
  If stamp<=PpuStatusDeadline And stamp>=PpuClock
    PpuStatusDeferred=PpuStatusDeferred+1
    ProcedureReturn
  EndIf
  PpuSync(stamp)
  PpuStatusBits=PpuStatus
  edge=341
  If (PpuLine=241 Or PpuLine=261) And PpuDot=0
    edge=1
  ElseIf PpuLine<240
    If PpuDot=0
      edge=0
    ElseIf PpuDot<256 And (PpuStatus&$40)=0 And (PpuMask&$18)=$18 And SprCount>0 And SprIndex(0)=0
      edge=((PpuDot+7)>>3)<<3
    EndIf
  EndIf
  If edge=341 And PpuLine<240 And OamCacheDirty=0
    line=PpuLine+1 : spriteY=Oam(0)+1 : height=8
    If PpuCtrl&$20
      height=16
    EndIf
    While line<240
      If (PpuMask&$18)<>0 And (PpuStatus&$20)=0 And CachedCount(line)>8
        Break
      EndIf
      If (PpuMask&$18)=$18 And (PpuStatus&$40)=0 And line>=spriteY And line<spriteY+height
        Break
      EndIf
      line=line+1
    Wend
    edge=(line-PpuLine)*341
    If line=240
      edge=edge+342
    EndIf
  EndIf
  If edge>PpuDot
    PpuStatusDeadline=stamp+NesDiv(edge-PpuDot-1,3)
  EndIf
EndProcedure
Global Dim SavedCachedCount.a(256)
; Random PPU states, each run through the reference and the assembly from the same start: the
; deferral, the status bits and the next horizon must agree. stamp=PpuClock, so PpuSync moves nothing.
Procedure ComparePpuSyncStatus()
  Protected i.i, j.i, line.i, dot.i, status.i, mask.i, ctrl.i, oam0.i, count.i, index0.i, dirty.i
  Protected clock.i, deadline.i, expDeadline.i, expBits.i, expDeferred.i, sOam0.i, sIndex0.i, sCount.i, sDirty.i
  For j=0 To 255 : SavedCachedCount(j)=CachedCount(j) : Next
  sOam0=Oam(0) : sIndex0=SprIndex(0) : sCount=SprCount : sDirty=OamCacheDirty
  For i=0 To 19999
    If (i&63)=0
      For j=0 To 255
        CachedCount(j)=VerifyRand(9)
        If VerifyRand(40)=0 : CachedCount(j)=9+VerifyRand(4) : EndIf
      Next
    EndIf
    line=VerifyRand(262) : dot=VerifyRand(341)
    If VerifyRand(4)=0 : dot=0 : EndIf
    If VerifyRand(8)=0 : line=241+VerifyRand(2)*20 : EndIf
    status=(VerifyRand(4)<<5)|(VerifyRand(2)<<7) : mask=VerifyRand(4)<<3 : ctrl=VerifyRand(2)<<5
    oam0=VerifyRand(256) : count=VerifyRand(3) : index0=VerifyRand(2) : dirty=0
    If VerifyRand(4)=0 : dirty=1 : EndIf
    clock=1000+VerifyRand(100000) : deadline=clock-2+VerifyRand(5)
    Oam(0)=oam0 : SprCount=count : SprIndex(0)=index0 : OamCacheDirty=dirty
    PpuLine=line : PpuDot=dot : PpuStatus=status : PpuMask=mask : PpuCtrl=ctrl
    PpuClock=clock : PpuStatusDeadline=deadline : PpuStatusBits=-1 : PpuStatusDeferred=0
    PpuSyncStatusReference(clock)
    expDeadline=PpuStatusDeadline : expBits=PpuStatusBits : expDeferred=PpuStatusDeferred
    PpuLine=line : PpuDot=dot : PpuStatus=status : PpuMask=mask : PpuCtrl=ctrl
    PpuClock=clock : PpuStatusDeadline=deadline : PpuStatusBits=-1 : PpuStatusDeferred=0
    PpuSyncStatus(clock)
    Check(PpuStatusDeadline,expDeadline) : Check(PpuStatusBits,expBits) : Check(PpuStatusDeferred,expDeferred)
    If (i&1023)=0 : SafetyPet() : UsbSerialTask() : EndIf
  Next
  For j=0 To 255 : CachedCount(j)=SavedCachedCount(j) : Next
  Oam(0)=sOam0 : SprIndex(0)=sIndex0 : SprCount=sCount : OamCacheDirty=sDirty
  PpuClock=0 : PpuStatusDeadline=0 : PpuStatusDeferred=0 : PpuLine=0 : PpuDot=0 : PpuStatus=0
EndProcedure

; ppu.pico's PpuIncY in its plain form.
Procedure PpuIncYReference()
  Protected y.i
  If (PpuV&$7000)<>$7000
    PpuV=PpuV+$1000
  Else
    PpuV=PpuV&$FFF : y=(PpuV>>5)&31
    If y=29
      y=0 : PpuV=PpuV!$800
    ElseIf y=31
      y=0
    Else
      y=y+1
    EndIf
    PpuV=(PpuV&$7C1F)|(y<<5)
  EndIf
EndProcedure
; Every 15-bit VRAM address.
Procedure ComparePpuIncY()
  Protected v.i, expected.i
  For v=0 To $7FFF
    PpuV=v : PpuIncYReference() : expected=PpuV
    PpuV=v : PpuIncY()
    Check(PpuV,expected)
    If (v&4095)=0 : SafetyPet() : UsbSerialTask() : EndIf
  Next
  PpuV=0
EndProcedure

; ppu.pico's PpuBuildSpriteCache in its plain form.
Procedure PpuBuildSpriteCacheReference()
  Protected i.i, row.i, first.i, finish.i, height.i, count.i
  For i=0 To 63
    PokeL(@CachedCount(0)+i*4,0)
  Next
  height=8
  If PpuCtrl&$20
    height=16
  EndIf
  For i=0 To 63
    first=Oam(i*4)+1 : finish=first+height-1
    If finish>239
      finish=239
    EndIf
    For row=first To finish
      count=CachedCount(row)
      If count<8
        CachedSprite(row*8+count)=i
        CachedCount(row)=count+1
      Else
        CachedCount(row)=9
      EndIf
    Next
  Next
  OamCacheDirty=0
EndProcedure
Global Dim ExpectedCount.a(256)
Global Dim ExpectedSprite.a(2048)
; Random OAM (Y bunched so lines overflow), both sprite heights: every count and every slot.
Procedure ComparePpuBuildSpriteCache()
  Protected pass.i, i.i, base.i
  For pass=0 To 299
    base=VerifyRand(240) : PpuCtrl=VerifyRand(2)<<5
    For i=0 To 63
      Oam(i*4)=(base+VerifyRand(24))&255
      If VerifyRand(6)=0 : Oam(i*4)=VerifyRand(256) : EndIf
    Next
    For i=0 To 2047 : CachedSprite(i)=255 : Next
    OamCacheDirty=1 : PpuBuildSpriteCacheReference() : Check(OamCacheDirty,0)
    For i=0 To 255 : ExpectedCount(i)=CachedCount(i) : Next
    For i=0 To 2047 : ExpectedSprite(i)=CachedSprite(i) : CachedSprite(i)=255 : Next
    For i=0 To 255 : CachedCount(i)=77 : Next
    OamCacheDirty=1 : PpuBuildSpriteCache() : Check(OamCacheDirty,0)
    For i=0 To 255 : Check(CachedCount(i),ExpectedCount(i)) : Next
    For i=0 To 2047 : Check(CachedSprite(i),ExpectedSprite(i)) : Next
    If (pass&15)=0 : SafetyPet() : UsbSerialTask() : EndIf
  Next
  For i=0 To 255 : Oam(i)=0 : Next
  PpuCtrl=0 : OamCacheDirty=1
EndProcedure

Global Dim ExpectedOam.a(256)
; worker.pico's OAM DMA ($4014): the RAM-page copy against the NesDmaRead loop it replaced, every
; RAM page (and its mirrors) from random OAM start addresses.
Procedure CompareOamDma()
  Protected value.i, i.i, pass.i, start.i
  For i=0 To 2047 : M(i)=VerifyRand(256) : Next
  For pass=0 To 3
    For value=0 To $1F
      start=VerifyRand(256)
      For i=0 To 255 : Oam(i)=VerifyRand(256) : ExpectedOam(i)=Oam(i) : Next
      For i=0 To 255 : ExpectedOam((start+i)&255)=NesDmaRead(value*256+i) : Next
      PpuOamAddr=start : PpuClock=0 : OamCacheDirty=0
      LocalPpuCommand(3,$4014,value,0)
      Check(OamCacheDirty,1)
      For i=0 To 255 : Check(Oam(i),ExpectedOam(i)) : Next
    Next
    SafetyPet() : UsbSerialTask()
  Next
  For i=0 To 2047 : M(i)=0 : Next
  For i=0 To 255 : Oam(i)=0 : Next
  PpuOamAddr=0
EndProcedure

; apu.pico's ApuTick in its plain form.
Procedure ApuTickReference(dt.i)
  Protected c.i, feedback.i, period.i, ticks.i
  For c=0 To 1
    ApuTimer(c)=ApuTimer(c)-dt
    If ApuTimer(c)<=0
      period=2*(ApuPeriod(c)+1) : ticks=1+NesDiv(0-ApuTimer(c),period)
      ApuTimer(c)=ApuTimer(c)+ticks*period
      ApuSeq(c)=(ApuSeq(c)+ticks)&7
    EndIf
  Next
  ApuTimer(2)=ApuTimer(2)-dt
  If ApuTimer(2)<=0
    period=ApuPeriod(2)+1 : ticks=1+NesDiv(0-ApuTimer(2),period)
    ApuTimer(2)=ApuTimer(2)+ticks*period
    If ApuLength(2)>0 And ApuLinear>0
      ApuSeq(2)=(ApuSeq(2)+ticks)&31
      If ApuSeq(2)<16
        TriDac=15-ApuSeq(2)
      Else
        TriDac=ApuSeq(2)-16
      EndIf
    EndIf
  EndIf
  ApuTimer(3)=ApuTimer(3)-dt
  While ApuTimer(3)<=0
    ApuTimer(3)=ApuTimer(3)+NoiseTable(ApuReg(14)&15)
    If ApuReg(14)&$80
      feedback=(NoiseShift!(NoiseShift>>6))&1
    Else
      feedback=(NoiseShift!(NoiseShift>>1))&1
    EndIf
    NoiseShift=(NoiseShift>>1)|(feedback<<14)
  Wend
  DmcTimer=DmcTimer-dt
EndProcedure
; apu.pico's ApuMixSample in its plain form.
Procedure ApuMixSampleReference()
  Protected c.i, duty.i, pulse.i, noise.i, target.i, x.i
  pulse=0 : noise=0
  For c=0 To 1
    If ApuLength(c)>0 And ApuPeriod(c)>=8
      target=ApuTarget(c)
      If target<=$7FF
        duty=(ApuReg(c*4)>>6)&3
        If duty=0
          duty=$02
        ElseIf duty=1
          duty=$06
        ElseIf duty=2
          duty=$1E
        Else
          duty=$F9
        EndIf
        If (duty>>ApuSeq(c))&1
          pulse=pulse+ApuVolume(c)
        EndIf
      EndIf
    EndIf
  Next
  If ApuLength(3)>0 And (NoiseShift&1)=0
    noise=ApuVolume(2)
  EndIf
  x=PulseMix(pulse)+TndMix(TriDac*3+noise*2+DmcLevel)
  ApuOutput=ApuLastY*65400
  If ApuOutput<0
    ApuOutput=ApuOutput+65535
  EndIf
  ApuOutput=x-ApuLastX+(ApuOutput>>16)
  ApuLastX=x
  If ApuOutput>32767
    ApuOutput=32767
  ElseIf ApuOutput< -32768
    ApuOutput= -32768
  EndIf
  ApuLastY=ApuOutput
  Pcm(ApuSamples&(#NES_AUDIO_RING_SAMPLES-1))=ApuOutput
  If ApuCapture<4096
    ApuCapture=ApuCapture+1
  EndIf
  If ApuOutput<ApuMinimum
    ApuMinimum=ApuOutput
  EndIf
  If ApuOutput>ApuMaximum
    ApuMaximum=ApuOutput
  EndIf
  If ApuOutput<>0
    ApuNonzero=ApuNonzero+1
  EndIf
  ApuSamples=ApuSamples+1
EndProcedure
Global Dim ApuState.i(40)
Global Dim ApuWant.i(40)
Global Dim ApuRegState.a(24)
; Every value ApuTick or ApuMixSample reads or writes, saved and put back, so both forms start alike.
Procedure ApuSave()
  Protected i.i
  For i=0 To 3 : ApuState(i)=ApuTimer(i) : ApuState(4+i)=ApuSeq(i) : ApuState(8+i)=ApuLength(i) : ApuState(12+i)=ApuPeriod(i) : Next
  For i=0 To 2 : ApuState(16+i)=EnvDecay(i) : Next
  ApuState(20)=TriDac : ApuState(21)=NoiseShift : ApuState(22)=DmcTimer : ApuState(23)=ApuLinear : ApuState(24)=DmcLevel
  ApuState(25)=ApuLastX : ApuState(26)=ApuLastY : ApuState(27)=ApuOutput : ApuState(28)=ApuSamples : ApuState(29)=ApuCapture
  ApuState(30)=ApuMinimum : ApuState(31)=ApuMaximum : ApuState(32)=ApuNonzero
  For i=0 To 23 : ApuRegState(i)=ApuReg(i) : Next
EndProcedure
Procedure ApuRestore()
  Protected i.i
  For i=0 To 3 : ApuTimer(i)=ApuState(i) : ApuSeq(i)=ApuState(4+i) : ApuLength(i)=ApuState(8+i) : ApuPeriod(i)=ApuState(12+i) : Next
  For i=0 To 2 : EnvDecay(i)=ApuState(16+i) : Next
  TriDac=ApuState(20) : NoiseShift=ApuState(21) : DmcTimer=ApuState(22) : ApuLinear=ApuState(23) : DmcLevel=ApuState(24)
  ApuLastX=ApuState(25) : ApuLastY=ApuState(26) : ApuOutput=ApuState(27) : ApuSamples=ApuState(28) : ApuCapture=ApuState(29)
  ApuMinimum=ApuState(30) : ApuMaximum=ApuState(31) : ApuNonzero=ApuState(32)
  For i=0 To 23 : ApuReg(i)=ApuRegState(i) : Next
EndProcedure
Procedure ApuRandom()
  Protected i.i
  For i=0 To 3
    ApuTimer(i)=VerifyRand(300)-20 : ApuSeq(i)=VerifyRand(32) : ApuLength(i)=VerifyRand(3)
    ApuPeriod(i)=VerifyRand(2048)
    If VerifyRand(4)=0 : ApuPeriod(i)=VerifyRand(12) : EndIf
  Next
  For i=0 To 1 : ApuSeq(i)=ApuSeq(i)&7 : Next
  For i=0 To 2 : EnvDecay(i)=VerifyRand(16) : Next
  For i=0 To 23 : ApuReg(i)=VerifyRand(256) : Next
  TriDac=VerifyRand(16) : NoiseShift=1+VerifyRand(32767) : DmcTimer=100000 : ApuLinear=VerifyRand(3) : DmcLevel=VerifyRand(128)
  ApuLastX=VerifyRand(1200) : ApuLastY=VerifyRand(65536)-32768 : ApuSamples=VerifyRand(100000)
  ApuCapture=4090+VerifyRand(10) : ApuMinimum=VerifyRand(40000)-30000 : ApuMaximum=VerifyRand(40000)-10000 : ApuNonzero=VerifyRand(1000)
EndProcedure
; Random APU states through the plain and the assembly forms of each routine: every value either writes.
Procedure CompareApu()
  Protected pass.i, i.i, dt.i, pcmAt.i, pcmWant.i

  For pass=0 To 19999
    ApuRandom() : ApuSave()
    dt=1+VerifyRand(38)
    ApuTickReference(dt)
    For i=0 To 3 : ApuWant(i)=ApuTimer(i) : ApuWant(4+i)=ApuSeq(i) : Next
    ApuWant(8)=TriDac : ApuWant(9)=NoiseShift : ApuWant(10)=DmcTimer
    ApuRestore() : ApuTick(dt)
    For i=0 To 3 : Check(ApuTimer(i),ApuWant(i)) : Check(ApuSeq(i),ApuWant(4+i)) : Next
    Check(TriDac,ApuWant(8)) : Check(NoiseShift,ApuWant(9)) : Check(DmcTimer,ApuWant(10))
    ApuRestore()
    pcmAt=ApuSamples&(#NES_AUDIO_RING_SAMPLES-1)
    ApuMixSampleReference()
    pcmWant=Pcm(pcmAt)
    ApuWant(0)=ApuOutput : ApuWant(1)=ApuLastX : ApuWant(2)=ApuLastY : ApuWant(3)=ApuSamples : ApuWant(4)=ApuCapture
    ApuWant(5)=ApuMinimum : ApuWant(6)=ApuMaximum : ApuWant(7)=ApuNonzero
    ApuRestore() : Pcm(pcmAt)=12345 : ApuMixSample()
    Check(ApuOutput,ApuWant(0)) : Check(ApuLastX,ApuWant(1)) : Check(ApuLastY,ApuWant(2)) : Check(ApuSamples,ApuWant(3))
    Check(ApuCapture,ApuWant(4)) : Check(ApuMinimum,ApuWant(5)) : Check(ApuMaximum,ApuWant(6)) : Check(ApuNonzero,ApuWant(7))
    Check(Pcm(pcmAt),pcmWant)
    If (pass&1023)=0 : SafetyPet() : UsbSerialTask() : EndIf
  Next
EndProcedure

; CHR RAM written while the background is on (Pinbot's case): after each burst of pattern writes
; through PpuWrite and the $2007 notice, the assembly renderer's line must match the plain reference
; renderer drawn from the new patterns - the tile cache may not hand back a stale tile. The built-in
; cartridge's background pattern table ($1000-$1FFF, PPUCTRL bit 4 set) is copied into RAM for the
; test and put back afterwards - 4 KB, not the whole 8, so the RP2040 build still fits its SRAM.
Global Dim TestChr.a(4096)
Global Dim RefLine.u(256)
Procedure RenderLineBoth(startV.i, startFx.i)
  Protected x.i, span.i
  PpuStatus=0 : PpuV=startV : PpuFineX=startFx
  For span=0 To 31 : PpuDot=span*8 : PpuRender8Reference() : Next
  For x=0 To 255 : RefLine(x)=RgbPal(LinePixels(x)) : Next
  PpuStatus=0 : PpuV=startV : PpuFineX=startFx
  FrameRow=@FrameTop(0)
  For x=0 To 255 : FrameTop(x)=$1234 : Next
  PpuDot=0 : PpuBatchLeft=32 : PpuRenderRaw()
  For x=0 To 255 : Check(FrameTop(x),RefLine(x)) : Next
EndProcedure
Procedure CompareChrRam()
  Protected i.i, round.i, k.i, savedChr.i, savedWritable.i, savedGen.i, startV.i, startFx.i, addr.i
  savedChr=Chr : savedWritable=ChrWritable : savedGen=RgbTagGen
  For i=0 To 4095 : TestChr(i)=PeekA(Chr+$1000+i) : Next
  Chr=@TestChr(0)-$1000 : ChrWritable=1
  For i=0 To 4095 : Nt(i)=VerifyRand(256) : Next
  For i=0 To 31 : Pal(i)=VerifyRand(64) : Next
  For i=0 To 31 : SpriteSpan(i)=0 : Next
  ; Generations near the wrap are covered too: the last rounds cross it.
  RgbTagGen=$F0000000
  For round=0 To 63
    PpuCtrl=$10 : PpuMask=$0A : PpuColours()
    If round=0 : RgbPairsDirty=1 : NameDescDirty=1 : EndIf
    PpuLine=VerifyRand(240) : startV=VerifyRand($8000) : startFx=VerifyRand(8)
    RenderLineBoth(startV,startFx)
    ; A burst of pattern bytes, as a $2007 loop with the background on writes them.
    For k=0 To 255
      addr=$1000+VerifyRand($1000)
      PpuWrite(addr,VerifyRand(256))
      PpuV=addr : CartPpuWriteNotice($2007,0)
    Next
    RenderLineBoth(startV,startFx)
    If (round&7)=0 : SafetyPet() : UsbSerialTask() : EndIf
  Next
  Check(RgbTagGen,$F0000000)   ; 16,384 steps: 64 times round, back where it began
  For i=$1000 To $1FFF : PpuWrite(i,PeekA(savedChr+i)) : Next
  Chr=savedChr : ChrWritable=savedWritable : RgbTagGen=savedGen : RgbPairsDirty=1
  PpuMask=$1E : PpuCtrl=0 : PpuFineX=0 : PpuV=0
EndProcedure

CompilerIf #PICO_ADVANCED=1
; MMC5's scanline IRQ: mapper5.pico's event model (one event at dot 3 of each rendered visible line)
; against Anvil's fetch-by-fetch replay (anvil/mapper5_video.pi4 M5PpuRead/M5PpuTicks), ported here
; with its own state. Same PPU positions, same tick chunks, several frames with rendering on: the
; scanline and the pending IRQ must agree after every chunk, and in-frame on the visible lines.
Global R5Dots.i, R5LastRead.i, R5LastAddr.i, R5Matches.i, R5InFrame.i, R5Scanline.i, R5Pending.i
Procedure R5PpuRead(addr.i,dot.i)
  If dot-R5LastRead>=9
    R5InFrame=0 : R5Matches=0 : R5LastAddr=-1
  EndIf
  If R5Matches>=2
    R5Matches=0
    If R5InFrame=0
      R5InFrame=1 : R5Scanline=0 : R5Pending=0
    Else
      R5Scanline=(R5Scanline+1)&255
      If R5Scanline=M5IrqTarget And M5IrqTarget<>0 : R5Pending=1 : EndIf
      If R5Scanline=240 : R5InFrame=0 : R5Scanline=0 : R5Pending=0 : R5Matches=0 : R5LastAddr=-1 : EndIf
    EndIf
  ElseIf addr>=$2000 And addr<$3000 And addr=R5LastAddr
    R5Matches=R5Matches+1
  Else
    R5Matches=0
  EndIf
  R5LastRead=dot : R5LastAddr=addr
EndProcedure
Procedure R5PpuTicks(cycles.i)
  Protected rest.i,line.i,dot.i,odd.i,width.i,edge.i,stepDots.i,addr.i,fast.i,last.i
  rest=cycles*3 : line=PpuLine : dot=PpuDot : odd=PpuOdd
  While rest>0
    width=341 : If line=261 And odd<>0 And (PpuMask&24)<>0 : width=340 : EndIf
    edge=width : fast=0
    If (PpuMask&24)<>0 And (line<240 Or line=261)
      If dot>=5 And dot<337 And R5Matches=0 And R5LastAddr=0
        edge=337 : fast=1
      ElseIf dot<339
        If dot=0 : edge=1 : Else : edge=((dot-1)/2+1)*2+1 : EndIf
      EndIf
    EndIf
    stepDots=edge-dot : If stepDots>rest : stepDots=rest : EndIf
    dot=dot+stepDots : rest=rest-stepDots : R5Dots=R5Dots+stepDots
    If fast
      If R5Dots-stepDots-R5LastRead>=9 : R5InFrame=0 : EndIf
      last=dot : If (last&1)=0 : last=last-1 : EndIf
      If last>335 : last=335 : EndIf
      R5LastRead=R5Dots-(dot-last) : R5Matches=0 : R5LastAddr=0
      If last<257 Or last>=321
        If (last&7)=1 : R5LastAddr=$2000 : ElseIf (last&7)=3 : R5LastAddr=$23C0 : EndIf
      EndIf
    EndIf
    If dot=edge
      If dot=width
        dot=0 : line=line+1 : If line=262 : line=0 : odd=odd!1 : EndIf
      Else
        addr=0
        If dot>=337 : addr=$2000
        ElseIf dot<257 Or dot>=321
          If (dot&7)=1 : addr=$2000 : ElseIf (dot&7)=3 : addr=$23C0 : EndIf
        EndIf
        R5PpuRead(addr,R5Dots)
      EndIf
    EndIf
  Wend
  If R5Dots-R5LastRead>=9 : R5InFrame=0 : R5Matches=0 : R5LastAddr=-1 : EndIf
EndProcedure
; Moves the PPU position on by dots (no rendering: only the counters the two models read).
Procedure R5Advance(dots.i)
  Protected width.i
  While dots>0
    width=341 : If PpuLine=261 And PpuOdd<>0 And (PpuMask&24)<>0 : width=340 : EndIf
    If PpuDot+dots<width : PpuDot=PpuDot+dots : ProcedureReturn : EndIf
    dots=dots-(width-PpuDot) : PpuDot=0 : PpuLine=PpuLine+1
    If PpuLine=262 : PpuLine=0 : PpuOdd=PpuOdd!1 : EndIf
  Wend
EndProcedure
Procedure CompareMmc5Irq()
  Protected run.i, chunk.i, cycles.i, savedMask.i
  savedMask=PpuMask
  For run=0 To 199
    PpuMask=$1E : PpuOdd=VerifyRand(2)
    ; Start in vertical blank, so both models begin outside a frame.
    PpuLine=241+VerifyRand(19) : PpuDot=VerifyRand(341)
    M5IrqTarget=1+VerifyRand(239) : M5IrqEnable=1
    M5InFrame=0 : M5Scanline=0 : M5Pending=0
    R5InFrame=0 : R5Scanline=0 : R5Pending=0 : R5Matches=0 : R5LastAddr=-1 : R5Dots=100000 : R5LastRead=0
    For chunk=0 To 1499
      cycles=1+VerifyRand(120)
      R5PpuTicks(cycles) : M5Ticks(cycles) : R5Advance(cycles*3)
      Check(M5Pending,R5Pending) : Check(M5Scanline,R5Scanline)
      If PpuLine>=1 And PpuLine<240 : Check(M5InFrame,R5InFrame) : EndIf
      If M5Pending And R5Pending And VerifyRand(3)=0 : M5Pending=0 : R5Pending=0 : EndIf
    Next
    If (run&15)=0 : SafetyPet() : UsbSerialTask() : EndIf
  Next
  PpuMask=savedMask : M5IrqEnable=0 : M5Pending=0 : PicoIrq=0 : PpuLine=0 : PpuDot=0
EndProcedure
CompilerEndIf

; The SBC encoder (the library's assembly on Arm) against the codec's test vectors, mono and stereo:
; moved here from verify.picow on 2026-10-18 so that image stays below the ROM store.
Procedure CodecVectorTests()
  Protected block.i, i.i, mode.i, expected.i
  For mode=0 To 1
  SbcSetStereo(mode) : expected=?CodecVectorExpected
  If mode : expected=?CodecVectorStereo : EndIf
  SbcReset()
  For block=0 To 63
    For i=0 To 127 : sbc_pcm[i]=PeekW(?CodecVectorPcm+(block*128+i)*2) : Next
    SbcEncode()
    For i=0 To 63+mode*4 : Check(sbc_out[i],PeekA(expected+block*(64+mode*4)+i)) : Next
    SafetyPet() : UsbSerialTask()
  Next
  Next
  SbcSetStereo(0)
  ; Timing of one stereo frame (analysis alone, then the whole encode).
  SbcSetStereo(1) : block=Micros()
  For i=0 To 99 : SbcAnalyze() : Next
  mode=Micros()-block : block=Micros()
  For i=0 To 99 : SbcEncode() : Next
  expected=Micros()-block
  Say("SBC TIMING analyze_us_x100=") : Num(mode) : Say(" encode_us_x100=") : Num(expected) : Eol()
  SbcSetStereo(0)
EndProcedure

Procedure TestMain()
  Protected start.i
  SafetyBoot() : ClockInitKhz(150000) : TimerInit() : UsbSerialInit()
  start=Micros()
  While UsbSerialReady()=0 And Micros()-start<10000000
    UsbSerialTask() : SafetyPet()
  Wend
  WaitUs(200000) : LoadCartridge() : WorkerDisplay=0
  Check(NesLaunchCore1(),1)
  Say("STEP ComparePpuSyncStatus checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
  ComparePpuSyncStatus()
  Say("STEP ComparePpuIncY checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
  ComparePpuIncY()
  Say("STEP ComparePpuBuildSpriteCache checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
  ComparePpuBuildSpriteCache()
  Say("STEP CompareOamDma checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
  CompareOamDma()
  Say("STEP CompareApu checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
  CompareApu()
  Say("STEP CompareChrRam checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
  CompareChrRam()
  CompilerIf #PICO_ADVANCED=1
    Say("STEP CompareMmc5Irq checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
    CompareMmc5Irq()
  CompilerEndIf
  Say("STEP CodecVectorTests checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Say(" error=") : Num(WorkerError) : Eol() : UsbSerialTask()
  CodecVectorTests()
  Check(WorkerError,0) : Check(NesBridgeError,0)
  Say("NES board checks=") : Num(Checks) : Say(" failures=") : Num(Failures)
  If Failures=0
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
  Repeat
    UsbSerialTask() : SafetyPet()
  ForEver
EndProcedure
; The checks run on the built-in cartridge, whatever the ROM store holds.
RomStoreEnabled=0
TestMain()
