#CLOCK_KHZ=150000
#NES_VIDEO_BACKEND=0
#NES_AUDIO_BACKEND=0
#PPU_PROFILE=0
#CPU_TIMING=1
#CPU_ASM_TAIL=1
#NES_SPLIT=2
#CART_MAPPER=0
#CART_PRG_BANKS=1
#CART_CHR_BANKS=2
#CART_MIRROR=1
EnableExplicit
XIncludeFile "../runtime.pico2"
XIncludeFile "../cartridge.pico2"
XIncludeFile "mapper_vectors.pico2"
Global Checks.i,Failures.i,Stamp.i=10000
Procedure Check(actual.i,expected.i)
  Checks=Checks+1
  If actual<>expected
    Failures=Failures+1
    Say("FAIL check=") : Num(Checks) : Say(" actual=") : Num(actual) : Say(" expected=") : Num(expected) : Eol()
  EndIf
EndProcedure

Procedure InitMapper(kind.i,ram.i)
  NesRpc(0,0,0,Stamp)
  PpuMask=0 : CartMapper=kind : CartChrRam=ram : CartConflicts=0 : PicoSubmapper=0 : PicoRamPresent=1
  CartPrg=?MapperPrg : CartPrgBanks=2 : PicoPrgBytes=65536
  CartChr=?MapperChr : CartChrBanks=4 : PicoChrBytes=32768 : PicoChrDecoded=?MapperDecoded
  CartPrgSelected=0 : PrgBase=CartPrg : PrgBias=PrgBase-$8000 : WorkerPrgBase=PrgBase
  CartChrSelected=-1 : PicoMapperInit()
EndProcedure
Procedure WriteMapper(addr.i,value.i)
  Stamp=Stamp+20 : CpuCycles=Stamp : AccessPhase=0 : PicoMapperWrite(addr,value,Stamp)
  Check(A,90) : Check(X,34) : Check(Y,56) : Check(S,201) : Check(PC,$8888)
  Check(Res,12345) : Check(FN,128) : Check(FZ,1) : Check(FC,256) : Check(FV,128)
  Check(FD,0) : Check(FI,1)
EndProcedure
Procedure SerialRegister(addr.i,value.i)
  Protected i.i
  For i=0 To 4 : WriteMapper(addr,(value>>i)&1) : Next
EndProcedure

CompilerIf #PICO_ADVANCED=1
Procedure QuickWriteTests()
  Protected clock.i,sent.i
  InitMapper(4,0) : clock=PpuClock : sent=QSent
  Stamp=Stamp+20 : CpuCycles=Stamp : AccessPhase=0
  NesWrite($8000,6) : Check(PicoSelect,6) : Check(QSent,sent) : Check(PpuClock,clock)
  NesWrite($8001,0) : Check(PicoPrgSlots(0),0) : Check(QSent,sent) : Check(PpuClock,clock)
  NesWrite($8000,70) : Check(PicoSelect,70) : Check(PicoPrgSlots(0),6) : Check(QSent,sent+2)
  Check(A,90) : Check(PC,$8888) : Check(Res,12345) : Check(FI,1)
  NesRpc(0,0,0,Stamp)
EndProcedure
Procedure NametablePageTests()
  Protected phase.i,i.i,table.i,index.i,actual.i
  InitMapper(118,0)
  WriteMapper($8000,1) : WriteMapper($8001,128)
  For i=0 To 1023
    PicoNtWrite($2000+i,(i*13+7)&255)
    PicoNtWrite($2800+i,(i*37+91)&255)
  Next
  For phase=0 To 3
    If phase<2
      WriteMapper($8000,0) : WriteMapper($8001,(phase&1)*128)
      WriteMapper($8000,1) : WriteMapper($8001,((phase&1)!1)*128)
    Else
      For i=0 To 3
        WriteMapper($8000,128+i+2) : WriteMapper($8001,((i+phase)&1)*128)
      Next
    EndIf
    For table=0 To 3
      For i=0 To 1023
        index=table*1024+i : actual=NameDesc(index)
        Check(Nt(index),PicoCiram(PicoNtSlots(table)*1024+i))
        PpuUpdateDescriptor(index) : Check(NameDesc(index),actual)
      Next
    Next
    Check(NameDescDirty,0) : UsbSerialTask() : SafetyPet()
  Next
EndProcedure
CompilerEndIf

Procedure MapperTests()
  Protected kind.i,i.i,bank.i,expected.i,start.i,byteValue.i,gen.i
  SafetyBoot() : ClockInitKhz(150000) : TimerInit() : UsbSerialInit()
  start=Micros()
  While UsbSerialReady()=0 And Micros()-start<10000000 : UsbSerialTask() : SafetyPet() : Wend
  WaitUs(200000) : RomStoreEnabled=0 : LoadCartridge() : WorkerDisplay=0
  Check(NesLaunchCore1(),1)
  A=90 : X=34 : Y=56 : S=201 : PC=$8888 : Res=12345
  FN=128 : FZ=1 : FC=256 : FV=128 : FD=0 : FI=1
  Say("MAPPER tests begin") : Eol()
  For kind=0 To 255
    If PicoSupported(kind) : Check(kind<>255,1) : EndIf
  Next
  InitMapper(3,0)
  ; A CHR switch retires the converted tiles (a new RgbTagGen generation); the palette pairs stay.
  For bank=0 To 15
    gen=RgbTagGen : WriteMapper($8000,bank)
    Check(CartChrSelected,bank&3) : Check(PeekA(Chr),(bank&3)*8)
    expected=0 : byteValue=(bank&3)*8
    For i=0 To 7 : expected=expected|((((byteValue>>(7-i))&1)*3)<<(i*2)) : Next
    Check(PeekU(Pattern),expected)
    If bank>0 : Check(RgbTagGen<>gen,1) : EndIf : Check(PpuChrBank,0)
  Next
  InitMapper(7,1)
  WriteMapper($8000,17) : Check(CartPrgSelected,1) : Check(PicoMirror,3)
  PicoNtWrite($2000,91) : Check(PicoNtRead($2C00),91) : Check(Nt($C00),91)
  WriteMapper($8000,0) : Check(PicoNtRead($2000),0)
  PicoNtWrite($2400,33) : WriteMapper($8000,16) : Check(PicoNtRead($2000),91)
  WriteMapper($8000,0) : Check(PicoNtRead($2800),33)
  InitMapper(11,0) : WriteMapper($8000,33) : Check(CartPrgSelected,1) : Check(PeekA(Chr),16)
  InitMapper(34,1) : WriteMapper($8000,1) : Check(CartPrgSelected,1)
  InitMapper(41,0) : WriteMapper($6025,0) : Check(CartPrgSelected,1) : Check(PicoMirror,0)
  WriteMapper($8000,2) : Check(CartChrSelected,2)
  InitMapper(71,1) : WriteMapper($C000,1) : Check(CartPrgSelected,1)
  WriteMapper($9000,0) : Check(PicoMirror,3) : WriteMapper($9000,16) : Check(PicoMirror,2)
  InitMapper(79,0) : WriteMapper($4100,10) : Check(CartPrgSelected,1) : Check(CartChrSelected,2)
  WriteMapper($4000,0) : Check(CartPrgSelected,1)
  InitMapper(148,0) : WriteMapper($8000,11) : Check(CartPrgSelected,1) : Check(CartChrSelected,3)
  InitMapper(144,0) : WriteMapper($8000,33) : Check(CartPrgSelected,1) : Check(CartChrSelected,2)
  InitMapper(144,0) : CartConflicts=1 : WriteMapper($A000,0) : Check(CartPrgSelected,1)
  InitMapper(148,0) : CartConflicts=1 : WriteMapper($A000,255)
  Check(CartPrgSelected,0) : Check(CartChrSelected,1)
  InitMapper(232,1) : WriteMapper($8000,24) : Check(PicoOuter,3)
  WriteMapper($C000,1) : Check(PicoValue,1) : Check(CartPrgSelected,1)
  CompilerIf #PICO_ADVANCED=1
    InitMapper(34,0) : WriteMapper($7FFE,3) : Check(PeekA(Chr),12)
    WriteMapper($7FFF,5) : Check(PeekA(Chr+4096),20) : Check(PicoRamRead($7FFF),5)
    InitMapper(1,0) : Check(NesRead($C000),6) : Check(NesRead($E000),7)
    SerialRegister($E000,1) : Check(NesRead($8000),2) : Check(NesRead($A000),3)
    SerialRegister($8000,28) : SerialRegister($A000,3) : SerialRegister($C000,5)
    Check(PeekA(Chr),12) : Check(PeekA(Chr+4096),20)
    WriteMapper($6123,81) : Check(PicoRamRead($6123),81)
    PicoRamPresent=0 : NesOpenBus=55 : WriteMapper($6123,22)
    Check(PicoRamRead($6123),55) : Check(PicoPrgRam($123),81) : PicoRamPresent=1
    SerialRegister($E000,17) : Check(PicoRamEnable,0)
    InitMapper(4,0) : WriteMapper($8000,6) : WriteMapper($8001,3)
    Check(NesRead($8000),3) : Check(NesRead($C000),6)
    WriteMapper($8000,70) : Check(NesRead($8000),6) : Check(NesRead($C000),3)
    ; A queued DMC fetch must finish before the shared PRG bank is changed.
    DmcEmpty=1 : DmcBytes=0 : DmcBits=8 : DmcTimer=428
    NesPost(0,0,0,Stamp+10000)
    NesPost(2,$4010,0,Stamp+10001) : NesPost(2,$4012,0,Stamp+10002)
    NesPost(2,$4013,0,Stamp+10003) : NesPost(2,$4015,16,Stamp+10004)
    Stamp=Stamp+10000 : WriteMapper($8001,5)
    NesRpc(0,0,0,Stamp)
    Check(DmcBuffer,3) : Check(WorkerRead($C000),5)
    NesRpc(2,$4015,0,Stamp)
    WriteMapper($8000,2) : WriteMapper($8001,17) : Check(PeekA(Chr+4096),17)
    WriteMapper($A001,128) : WriteMapper($6000,99) : Check(PicoRamRead($6000),99)
    WriteMapper($A001,192) : WriteMapper($6000,22) : Check(PicoRamRead($6000),99)
    WriteMapper($C000,2) : WriteMapper($C001,0) : WriteMapper($E001,0)
    PicoA12(0,100) : PicoA12($1000,120) : Check(PicoIrqCount,2)
    PicoA12(0,121) : PicoA12($1000,125) : Check(PicoIrqCount,2)
    PicoA12(0,126) : PicoA12($1000,140) : Check(PicoIrqCount,1)
    PicoA12(0,141) : PicoA12($1000,160) : Check(PicoIrq,1)
    WriteMapper($E000,0) : Check(PicoIrq,0)
    PicoIrqClocks=0 : PicoIrqReload=1 : PicoIrqLatch=3 : PicoIrqEnable=1 : PicoIrq=0
    PicoDots=0 : PicoA12High=0 : PicoLowSince=0
    PpuLine=0 : PpuDot=0 : PpuOdd=0 : PpuMask=24 : PpuCtrl=8
    PpuClock=Stamp : FI=0 : Check(PicoCpuBudget(),256) : FI=1
    Stamp=Stamp+455 : PpuSync(Stamp)
    Check(PicoIrqClocks,4) : Check(PicoIrq,1) : FI=0 : Check(PicoCpuBudget(),1) : FI=1
    Check(PicoCpuBudget(),256)
    PpuMask=0
    InitMapper(13,1) : PicoChrWrite($1000,85) : WriteMapper($8000,1)
    Check(PeekA(Chr+$1000),0) : PicoChrWrite($1000,33)
    WriteMapper($8000,0) : Check(PeekA(Chr+$1000),85)
    WriteMapper($8000,1) : Check(PeekA(Chr+$1000),33)
    InitMapper(119,0) : WriteMapper($8000,2) : WriteMapper($8001,64)
    gen=RgbTagGen : PicoChrWrite($1000,77) : Check(PeekA(Chr+$1000),77) : Check(RgbTagGen<>gen,1)
    WriteMapper($8001,5) : Check(PeekA(Chr+$1000),5)
    WriteMapper($8001,64) : Check(PeekA(Chr+$1000),77)
    WriteMapper($8000,3) : WriteMapper($8001,64)
    PicoChrWrite($1000,123) : Check(PeekA(Chr+$1400),123)
    Check(PeekU(Pattern+$1400),PeekU(Pattern+$1000))
    InitMapper(118,0) : WriteMapper($8000,0) : WriteMapper($8001,128)
    Check(PicoNtSlots(0),1) : Check(PicoNtSlots(1),1) : Check(PicoNtSlots(2),0)
    InitMapper(206,0) : WriteMapper($8000,70) : WriteMapper($8001,5)
    Check(NesRead($8000),5) : Check(NesRead($C000),6)
    InitMapper(47,0) : WriteMapper($6000,1) : Check(PicoOuter,1)
  CompilerEndIf
  CompilerIf #PICO_ADVANCED=1
    QuickWriteTests() : NametablePageTests()
  CompilerEndIf
  Check(WorkerError,0) : Check(NesBridgeError,0)
  Say("MAPPER checks=") : Num(Checks) : Say(" failures=") : Num(Failures) : Eol()
  PicoMapActive=0 : PpuMask=0
  Repeat : UsbSerialTask() : SafetyPet() : ForEver
EndProcedure
MapperTests()
