Procedure.i PpuNtAddr(addr.i)
  Protected table.i
  table=(addr>>10)&3
  If MapManaged
    ProcedureReturn MapNtSlots(table)*1024+(addr&1023)
  EndIf
  If PpuMirroring=1
    table=table&1
  Else
    table=table&2
  EndIf
  ProcedureReturn (table<<10)|(addr&1023)
EndProcedure
Procedure.i PpuPalAddr(addr.i)
  addr=addr&31
  If (addr&$13)=$10
    addr=addr-16
  EndIf
  ProcedureReturn addr
EndProcedure
Procedure.i PpuRead(addr.i)
  Protected value.i
  addr=addr&$3FFF
  If CartMapper=5
    If addr<$3F00 : M5PpuRead(addr,M5Dots) : EndIf
    If addr>=$2000 And addr<$3F00 : ProcedureReturn M5NtRead(addr) : EndIf
  EndIf
  If ExtraA12(CartMapper) And addr<$3F00 : MapperA12(addr,MapDots) : EndIf
  If addr<$2000
    value=PeekA(Chr+addr)
    If CartMapper=9 : ExtraLatchRead(addr) : EndIf
    ProcedureReturn value
  ElseIf addr<$3F00
    If CartMapper=68 And ExtraFlags : ProcedureReturn ExtraNtRead(addr) : EndIf
    If MapManaged : ProcedureReturn MapCiram(PpuNtAddr(addr)) : EndIf
    ProcedureReturn Nt(PpuNtAddr(addr))
  EndIf
  ProcedureReturn Pal(PpuPalAddr(addr))
EndProcedure
