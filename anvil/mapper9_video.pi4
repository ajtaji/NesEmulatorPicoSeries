; Generated cartridge CHR-read adapter; renderer algorithm retained.
Procedure ExtraLatchSprites()
  Protected i.i, row.i, height.i, tile.i, ppuAddress.i, bank.i, j.i, sx.i, pixel.i, flags.i
  SprCount=0 : height=8
  If PpuCtrl&$20
    height=16
  EndIf
  If OamCacheDirty
    PpuBuildSpriteCache()
  EndIf
  SprCount=CachedCount(PpuLine)
  If SprCount>8
    SprCount=8
    If PpuMask&$18
      PpuStatus=PpuStatus|$20
    EndIf
  EndIf
  For i=0 To SprCount-1
    j=CachedSprite(PpuLine*8+i)
    row=PpuLine-Oam(j*4)-1
    ppuAddress=Oam(j*4+2) : tile=Oam(j*4+1)
    If ppuAddress&$80
      row=height-1-row
    EndIf
    bank=(PpuCtrl&8)<<9
    If height=16
      bank=(tile&1)<<12 : tile=(tile&$FE)+(row>>3) : row=row&7
    EndIf
    SprIndex(i)=j : SprX(i)=Oam(j*4+3) : SprAttr(i)=ppuAddress
    SprRow(i)=bank+tile*16+row*2
    ExtraSpriteBits(i)=PeekU(Pattern+SprRow(i))
    ExtraLatchRead(bank+tile*16+row+8)
  Next
  PpuClearSprites()
  If PpuMask&$10
    For i=SprCount-1 To 0 Step -1
      flags=16+((SprAttr(i)&3)*4)+((SprAttr(i)&$20)*2)
      If SprIndex(i)=0
        flags=flags|$80
      EndIf
      For j=0 To 7
        sx=SprX(i)+j
        If sx<256
          If sx>=8 Or (PpuMask&4)<>0
            row=j
            If SprAttr(i)&$40
              row=7-j
            EndIf
            pixel=(ExtraSpriteBits(i)>>(row*2))&3
            If pixel
              SpriteLine(sx)=flags|pixel : SpriteSpan(sx>>3)=SpriteSpan(sx>>3)|1
              If i=0 And SprIndex(i)=0
                SpriteSpan(sx>>3)=SpriteSpan(sx>>3)|2
              EndIf
            EndIf
          EndIf
        EndIf
      Next
    Next
  EndIf
EndProcedure
Procedure ExtraLatchTile()
  Protected tile.i,addr.i
  tile=Nt(WAddr&$FFF)
  addr=((PpuCtrl&16)<<8)+tile*16+((WAddr>>12)&7)+8
  ExtraLatchRead(addr)
EndProcedure
