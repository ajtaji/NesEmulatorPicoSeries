; Scheduler: guest computation on core 1, hardware and Anvil calls on core 0.
Global *svc_parallel,*svc_cores
Global Dim JobArgs.i(2)
Declare AudioConfigure()
Declare AudioStop()
Declare AudioDiagnostics(address.i)
Declare VideoDiagnostics(address.i)
CompilerIf #NES_VERIFY_CODEC=1
Declare.i AudioCodecTests()
CompilerEndIf
CompilerIf #NES_VERIFY_CORE=1
Declare.i CoreTests()
CompilerEndIf
CompilerIf #NES_VERIFY_ROM=1
Declare.i RomLoaderTests()
CompilerEndIf
CompilerIf #NES_VERIFY_MAPPERS=1
Declare.i MapperTests()
CompilerEndIf
Global EmulateUs.i, EmulateCalls.i

; Descriptor caches are used only by the Thumb renderer, not this backend.
Procedure PpuUpdateDescriptor(addr.i)
EndProcedure
Procedure PpuUpdateAttribute(addr.i)
EndProcedure
Procedure CartPpuWriteNotice(addr.i,value.i)
EndProcedure
Procedure CartSelect(number.i)
  If RomLoaded=0 : CartSelectBuiltin(number) : EndIf
EndProcedure
Procedure NesSync()
  Protected stalls.i
  NesRpc(0,0,0,CpuCycles)
  stalls=WorkerDmcCycles-NesSeenDmc
  While stalls>0
    CpuCycles=CpuCycles+stalls : NesSeenDmc=WorkerDmcCycles
    NesRpc(0,0,0,CpuCycles) : stalls=WorkerDmcCycles-NesSeenDmc
  Wend
  If WorkerNmi<>NesSeenNmi
    NesSeenNmi=WorkerNmi : CpuInterrupt($FFFA)
  ElseIf (WorkerIrq|MapIrq)<>0 And FI=0
    CpuInterrupt($FFFE)
  EndIf
EndProcedure
Procedure LoadCartridge()
  Protected i.i,bank.i
  CartSelect(0)
  For i=0 To 255
    PixelSpread(i)=(i&3)|(((i>>2)&3)<<8)|(((i>>4)&3)<<16)|(((i>>6)&3)<<24)
  Next
  RenderTop=@FrameTop(0) : FrameBottom=@FrameBottomStore(0)
  PrgBase=CartPrg : PrgBias=PrgBase-$8000 : WorkerPrgBase=PrgBase
  ChrWritable=CartChrRam
  If CartMapper=1 Or CartMapper=3 Or CartMapper=4 Or CartMapper=5 Or CartMapper=7 Or CartMapper=11 Or ExtraManaged(CartMapper)
    For bank=0 To MapChrBytes/8192-1
      Chr=CartChr+bank*8192 : Pattern=@Decoded(bank*8192)
      For i=0 To 8191 : If (i&8)=0 : PpuDecode(i) : EndIf : Next
    Next
    MapperInit()
  ElseIf CartChrRam
    Chr=@Decoded(0)+8192 : CartChr=Chr : Pattern=@Decoded(0)
  Else
    For bank=0 To CartChrBanks-1
      Chr=CartChr+bank*8192 : Pattern=@Decoded(0)+bank*8192
      For i=0 To 8191 : If (i&8)=0 : PpuDecode(i) : EndIf : Next
    Next
    Chr=CartChr : Pattern=@Decoded(0)
  EndIf
  For i=0 To 31 : LengthTable(i)=PeekA(?LengthData+i) : Next
  For i=0 To 15 : NoiseTable(i)=PeekU(?NoiseData+i*2) : DmcTable(i)=PeekU(?DmcData+i*2) : Next
  For i=0 To 30 : PulseMix(i)=PeekU(?PulseData+i*2) : Next
  For i=0 To 202 : TndMix(i)=PeekU(?TndData+i*2) : Next
  For i=0 To 511 : Rgb64(i)=PeekU(?RgbData+i*2) : Next
  PpuColours()
EndProcedure
Procedure RecordGame()
  Protected at.i
  ; Fixed diagnostic block inside the declared payload RAM window.
  PokeI(#NES_MAP_RECORD,$4E455350) : PokeI(#NES_MAP_RECORD+$008,NesHostUs()-StartUs)
  PokeI(#NES_MAP_RECORD+$010,CpuCycles) : PokeI(#NES_MAP_RECORD+$018,WorkerFrames)
  PokeI(#NES_MAP_RECORD+$020,VideoFrames) : PokeI(#NES_MAP_RECORD+$028,ApuSamples)
  PokeI(#NES_MAP_RECORD+$030,EmulateUs) : PokeI(#NES_MAP_RECORD+$038,VideoUs)
  PokeI(#NES_MAP_RECORD+$040,Stopped) : PokeI(#NES_MAP_RECORD+$048,BadOpcode)
  PokeI(#NES_MAP_RECORD+$050,WorkerError) : PokeI(#NES_MAP_RECORD+$058,ExitRequested)
  PokeI(#NES_MAP_RECORD+$060,TouchEvents) : PokeI(#NES_MAP_RECORD+$068,VideoError)
  VideoDiagnostics(#NES_MAP_RECORD+$070)
  VideoMemoryDiagnostics(#NES_MAP_RECORD+$1E0)
  PokeI(#NES_MAP_RECORD+$090,AudioLive) : PokeI(#NES_MAP_RECORD+$098,AudioPackets)
  PokeI(#NES_MAP_RECORD+$0A0,AudioUnderruns) : PokeI(#NES_MAP_RECORD+$0A8,AudioOverruns)
  PokeI(#NES_MAP_RECORD+$0B0,AudioWireErrors) : PokeI(#NES_MAP_RECORD+$0B8,ParallelError)
  AudioDiagnostics(#NES_MAP_RECORD+$0C0)
  PokeI(#NES_MAP_RECORD+$1A0,InputSeen)
  PokeI(#NES_MAP_RECORD+$300,GameSessions) : PokeI(#NES_MAP_RECORD+$308,CartMapper)
  PokeI(#NES_MAP_RECORD+$310,MapIrqClocks) : PokeI(#NES_MAP_RECORD+$318,MapIrqAssertions)
  PokeI(#NES_MAP_RECORD+$320,MenuRequested)
  If GameSessions<=16
    at=#NES_MAP_RECORD+$1000+(GameSessions-1)*128
    PokeI(at,CartMapper) : PokeI(at+8,NesHostUs()-StartUs)
    PokeI(at+16,WorkerFrames) : PokeI(at+24,VideoFrames) : PokeI(at+32,CpuCycles)
    PokeI(at+40,ApuSamples) : PokeI(at+48,Stopped+WorkerError+VideoError+ParallelError)
    PokeI(at+56,AudioLive) : PokeI(at+64,AudioWireErrors)
    PokeI(at+72,RomChosen) : PokeI(at+80,MapIrqClocks) : PokeI(at+88,MapIrqAssertions)
    PokeI(at+96,MenuRequested) : PokeI(at+104,ExitRequested)
    PokeI(at+112,M($F8)) : PokeI(at+120,PC)
  EndIf
EndProcedure
Procedure.i Main()
  Protected t.i,target.i,elapsed.i,nextInput.i,status.i
  CaptureServices()
  If ServicesBegin()=0 : ProcedureReturn 100 : EndIf
  *svc_parallel=ServiceSlot(185)
  *svc_cores=ServiceSlot(184)
  If svc_cap(13)=0 Or svc_cap(7)=0 : ProcedureReturn 101 : EndIf
  If PlatformBegin()=0 : ProcedureReturn 103 : EndIf
  GuestClear(#NES_MAP_RECORD,8192)
  CompilerIf #NES_VERIFY_CODEC=1
    t=AudioCodecTests() : PlatformEnd() : ProcedureReturn t
  CompilerEndIf
  CompilerIf #NES_VERIFY_CORE=1
    LoadCartridge() : t=CoreTests() : PlatformEnd() : ProcedureReturn t
  CompilerEndIf
  CompilerIf #NES_VERIFY_ROM=1
    t=RomLoaderTests() : PlatformEnd() : ProcedureReturn t
  CompilerEndIf
  CompilerIf #NES_VERIFY_MAPPERS=1
    t=MapperTests() : PlatformEnd() : ProcedureReturn t
  CompilerEndIf
  If svc_cores()<2 : PlatformEnd() : ProcedureReturn 104 : EndIf
  VideoBegin()
  If VideoError : VideoAbort() : PlatformEnd() : ProcedureReturn VideoError : EndIf
  AudioConfigure()
  Repeat
    GuestReset()
  CompilerIf #NES_ROM_SELECTOR=1
    If RomSelector()=0
      Break
    EndIf
    HudAt=0 : HudPut("VIDEO -- FPS   EMU -- FPS") : HudDirty=1
  CompilerEndIf
  LoadCartridge() : CpuReset()
  If VideoStart(@FrameTop(0),FrameBottom)=0 : VideoError=214 : EndIf
  t=NesHostUs() : status=VideoPoll()
  While status=0 And VideoError=0
    SafetyPet()
    If NesHostUs()-t>2000000 : VideoError=215 : Break : EndIf
    status=VideoPoll()
  Wend
  If status<0 : VideoError=216 : EndIf
  If VideoError : Break : EndIf
  AudioSessionBegin()
  StartUs=NesHostUs()
  HudSince=StartUs : HudFrames=VideoFrames : HudEmu=WorkerFrames
  JobArgs(0)=0 : JobArgs(1)=1
  While ExitRequested=0 And MenuRequested=0 And Stopped=0 And WorkerError=0 And VideoError=0
    ComputeDone=0 : SliceEnd=NesHostUs()+2000000
    If svc_parallel(@ApplicationJob,@JobArgs(0),8,2)<>0 : ParallelError=1 : Break : EndIf
    If #TEST_SECONDS>0 And NesHostUs()-StartUs>=#TEST_SECONDS*1000000 : Break : EndIf
  Wend
    GameSessions=GameSessions+1 : RecordGame()
    If MenuRequested=0 Or ExitRequested<>0 Or Stopped<>0 Or WorkerError<>0 Or VideoError<>0 Or ParallelError<>0 : Break : EndIf
    AudioSessionPause()
  ForEver
  AudioStop() : VideoAbort() : svc_flush() : svc_capture() : PlatformEnd()
  ProcedureReturn Stopped+WorkerError+VideoError+ParallelError
EndProcedure
