; Independent MMC5 expansion sound. Existing 2A03 channels, filter and
; SBC/transport are retained. Only mapper 5 mixes this cartridge signal.
Procedure M5AudioInit()
  Protected c.i
  M5AudioEnable=0 : M5AudioClock=7457 : M5AudioLastX=0 : M5AudioLastY=0
  M5SampleCycles=0 : M5PcmArea=0
  M5PcmMode=0 : M5PcmEnable=0 : M5PcmPending=0 : M5PcmValue=0
  For c=0 To 7 : M5SoundReg(c)=0 : Next
  For c=0 To 1
    M5PulseArea(c)=0 : M5PulseCarry(c)=0 : M5Length(c)=0 : M5Period(c)=0 : M5PulseTimer(c)=2 : M5Seq(c)=0
    M5EnvStart(c)=0 : M5EnvDiv(c)=0 : M5EnvDecay(c)=0
  Next
EndProcedure
Procedure M5SoundWrite(addr.i,value.i)
  Protected c.i,r.i
  If addr<$5008
    r=addr-$5000 : c=r>>2 : M5SoundReg(r)=value
    If (r&3)=2 : M5Period(c)=(M5Period(c)&$700)|value
    ElseIf (r&3)=3
      M5Period(c)=(M5Period(c)&255)|((value&7)<<8)
      If M5AudioEnable&(1<<c) : M5Length(c)=LengthTable(value>>3) : EndIf
      M5Seq(c)=0 : M5EnvStart(c)=1
    EndIf
  ElseIf addr=$5010
    M5PcmMode=value&1 : M5PcmEnable=(value&128)<>0
    If M5PcmEnable=0 : M5PcmPending=0 : EndIf
    M5IrqUpdate()
  ElseIf addr=$5011
    If M5PcmMode=0 And value<>0 : M5PcmValue=value : EndIf
  ElseIf addr=$5015
    M5AudioEnable=value&3
    For c=0 To 1 : If (value&(1<<c))=0 : M5Length(c)=0 : EndIf : Next
  EndIf
EndProcedure
Procedure M5PcmRead(value.i)
  If value=0 : M5PcmPending=1 : M5IrqUpdate() : Else : M5PcmValue=value : EndIf
EndProcedure
Procedure M5AudioAdvance(dt.i)
  Protected step.i,c.i,period.i,ticks.i,r.i,left.i,chunk.i,duty.i,volume.i
  While dt>0
    step=dt : If step>M5AudioClock : step=M5AudioClock : EndIf
    For c=0 To 1
      period=2*(M5Period(c)+1)
      If M5Length(c)=0 Or M5Period(c)<4
        If M5Length(c)>0
          r=M5SoundReg(c*4) : volume=M5EnvDecay(c) : If r&16 : volume=r&15 : EndIf
          duty=r>>6
          If duty=0 : duty=1 : ElseIf duty=1 : duty=2 : ElseIf duty=2 : duty=4 : Else : duty=6 : EndIf
          ; Above Nyquist only the DAC mean survives reconstruction. Retain
          ; that DC and timer phase without folding ultrasound into a buzz.
          ticks=M5PulseCarry(c)+volume*duty*step
          M5PulseArea(c)=M5PulseArea(c)+(ticks>>3) : M5PulseCarry(c)=ticks&7
        EndIf
        M5PulseTimer(c)=M5PulseTimer(c)-step
        If M5PulseTimer(c)<=0
          ticks=1+(-M5PulseTimer(c))/period
          M5PulseTimer(c)=M5PulseTimer(c)+ticks*period : M5Seq(c)=(M5Seq(c)-ticks)&7
        EndIf
      Else
        r=M5SoundReg(c*4) : volume=M5EnvDecay(c) : If r&16 : volume=r&15 : EndIf
        duty=r>>6
        If duty=0 : duty=2 : ElseIf duty=1 : duty=6 : ElseIf duty=2 : duty=30 : Else : duty=249 : EndIf
        ; Integrate timer segments into the sample, including ultrasonic
        ; periods. Point sampling those periods creates an audible alias.
        left=step
        While left>0
          chunk=left : If chunk>M5PulseTimer(c) : chunk=M5PulseTimer(c) : EndIf
          If (duty>>M5Seq(c))&1 : M5PulseArea(c)=M5PulseArea(c)+volume*chunk : EndIf
          M5PulseTimer(c)=M5PulseTimer(c)-chunk : left=left-chunk
          If M5PulseTimer(c)=0 : M5Seq(c)=(M5Seq(c)-1)&7 : M5PulseTimer(c)=period : EndIf
        Wend
      EndIf
    Next
    M5SampleCycles=M5SampleCycles+step : M5PcmArea=M5PcmArea+M5PcmValue*step
    M5AudioClock=M5AudioClock-step : dt=dt-step
    If M5AudioClock=0
      M5AudioClock=7457
      For c=0 To 1
        r=M5SoundReg(c*4)
        If M5Length(c)>0 And (r&32)=0 : M5Length(c)=M5Length(c)-1 : EndIf
        If M5EnvStart(c)
          M5EnvStart(c)=0 : M5EnvDecay(c)=15 : M5EnvDiv(c)=r&15
        ElseIf M5EnvDiv(c)>0
          M5EnvDiv(c)=M5EnvDiv(c)-1
        Else
          M5EnvDiv(c)=r&15
          If M5EnvDecay(c)>0 : M5EnvDecay(c)=M5EnvDecay(c)-1
          ElseIf r&32 : M5EnvDecay(c)=15 : EndIf
        EndIf
      Next
    EndIf
  Wend
EndProcedure
Procedure M5AudioMix()
  Protected c.i,duty.i,volume.i,pulse.i,x.i,y.i,value.i
  x=0
  If M5SampleCycles>0
    x=-((M5PulseArea(0)+M5PulseArea(1))*380+M5PcmArea*64)/M5SampleCycles
  EndIf
  M5PulseArea(0)=0 : M5PulseArea(1)=0 : M5PcmArea=0 : M5SampleCycles=0
  ; Separate cartridge DC blocker; the base APU filter is untouched.
  y=M5AudioLastY*65400 : If y<0 : y=y+65535 : EndIf
  y=x-M5AudioLastX+(y>>16) : M5AudioLastX=x : M5AudioLastY=y
  value=Pcm((ApuProduced-1)&4095)+y
  If value>32767 : value=32767 : ElseIf value< -32768 : value=-32768 : EndIf
  Pcm((ApuProduced-1)&4095)=value
EndProcedure
