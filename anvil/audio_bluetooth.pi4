; NES Classic A2DP source - on ANVIL'S Bluetooth stack (2026-10-16, Ron: "have
; nes on anvil use anvils bluetooth instead of its own"). The H4 adapter, HCI,
; L2CAP, AVDTP and SBC this plugin used to carry now live in Anvil and are
; included from it: RaspberryPi4/Lib/bt_uart.pi4, RaspberryPi4/Board/
; hw_bt_payload.pi4, Anvil/Net/hci.pbi, Anvil/Audio/sbc.pbi, Anvil/Net/l2cap.pbi,
; Anvil/Net/a2dp.pbi (tools/build_anvil.py). What stays here is the NES's part:
; feeding the APU's samples to the encoder and the stream, on core 1.
Declare InputPoll()
Global Dim BtPeer.a(6)                  ; the peer, wire order (LSB first), as the wrapper gives it
Global Dim BtPeerMsb.a(6)               ; the same, most significant first, for Anvil
Global Dim BtBond.a(32)                 ; an optional kept bond: Anvil's 22 bytes
Global Dim BtOwnAddr.a(6)               ; an optional address for this board's controller
Global BtPeerConfigured.i, BtHaveBond.i, BtHaveOwnAddr.i
Global BtInitError.i, BtControlRequest.i
Global BtAudioRead.i, BtAudioFrames.i, BtAudioLastPoll.i, BtAudioLastEncode.i
Global Dim BtAudioPayload.a(204)

; While Anvil's HCI waits (the bring-up, the patch): the watchdog and input
; stay alive, and leaving abandons the wait.
Procedure NesBtIdle()
  SafetyPet() : InputPoll()
  If ExitRequested<>0 : HciAbort(1) : EndIf
EndProcedure

Procedure NesBluetoothSetPeer(src.i)
  Protected i.i
  For i=0 To 5 : BtPeer(i)=PeekA(src+i) : BtPeerMsb(5-i)=BtPeer(i) : Next
  ; This speaker plays stereo correctly; mono playback left a persistent buzz.
  SbcStereo=1 : BtPeerConfigured=1
EndProcedure

; A bond Anvil kept from an earlier pairing (HciLinkKeyGet's 22 bytes), so a
; headset that has paired once is not refused; and optionally the address the
; controller had when it paired (HciWriteBdAddr). Both private, like the peer.
Procedure NesBluetoothSetBond(bond.i, ownAddr.i)
  Protected i.i
  If bond<>0
    For i=0 To 21 : BtBond(i)=PeekA(bond+i) : Next
    BtHaveBond=1
  EndIf
  If ownAddr<>0
    For i=0 To 5 : BtOwnAddr(i)=PeekA(ownAddr+i) : Next
    BtHaveOwnAddr=1
  EndIf
EndProcedure

Procedure AudioBegin()
  If BtPeerConfigured=0 : ProcedureReturn : EndIf
  AudioRunning=0
  *hci_idle=@NesBtIdle : HciAbort(0)
  If HciOpen()=0 : BtInitError=2 : ProcedureReturn : EndIf
  If HciLoadPatch(?BtPatch,#BT_PATCH_BYTES)=0 : BtInitError=3 : ProcedureReturn : EndIf
  If HciSetBaud(3000000)=0 : BtInitError=8 : ProcedureReturn : EndIf
  If HciReadBufferSize()=0 : BtInitError=9 : ProcedureReturn : EndIf
  If BtHaveOwnAddr<>0
    If HciWriteBdAddr(@BtOwnAddr(0))=0 : BtInitError=12 : ProcedureReturn : EndIf
  EndIf
  If HciLinkSetup()=0 : BtInitError=10 : ProcedureReturn : EndIf
  If BtHaveBond<>0 : HciLinkKeySet(@BtBond(0)) : EndIf
  If A2dpBegin(@BtPeerMsb(0),SbcStereo)=0 : BtInitError=11 : ProcedureReturn : EndIf
  AudioRunning=1
  BtAudioRead=ApuSamples : BtAudioLastEncode=NesHostUs()
EndProcedure

Procedure AudioPoll()
  Protected t.i, start.i, n.i, i.i, index.i, work.i, state.i
  If AudioRunning=0 : ProcedureReturn : EndIf
  start=NesHostUs() : t=start
  If BtControlRequest<>0
    work=1
    If A2dpStreaming()<>0 : A2dpPause() : Else : A2dpResume() : EndIf
    BtControlRequest=0
  EndIf
  If t-BtAudioLastPoll>=1000 Or HciAclCredits()<1
    BtAudioLastPoll=t : work=1
    state=A2dpPoll()
    AudioLive=Bool(state=#A2DP_STREAMING)
    AudioWireErrors=HciRxErrors()
  EndIf
  If AudioLive<>0
    n=ApuSamples-BtAudioRead
    FrameFence()
    If n>4096
      AudioOverruns=AudioOverruns+1 : BtAudioRead=ApuSamples-128 : n=128
    EndIf
    If BtAudioFrames<3 And (n>=128 Or t-BtAudioLastEncode>8000)
      work=1
      If n>=128
        index=BtAudioRead&4095
        For i=0 To 127 : SbcPcm(i)=Pcm((index+i)&4095) : Next
        BtAudioRead=BtAudioRead+128
      Else
        For i=0 To 127 : SbcPcm(i)=0 : Next
        AudioUnderruns=AudioUnderruns+1
      EndIf
      SbcEncode()
      index=BtAudioFrames*(64+SbcStereo*4)
      For i=0 To 63+SbcStereo*4 : BtAudioPayload(index+i)=SbcEncoded(i) : Next
      BtAudioFrames=BtAudioFrames+1 : BtAudioLastEncode=t
    EndIf
    If BtAudioFrames=3 And HciAclCredits()>0
      work=1
      If A2dpSend(@BtAudioPayload(0),3)<>0
        AudioPackets=AudioPackets+1 : BtAudioFrames=0
      EndIf
    EndIf
  EndIf
  ; Only polls that did work count, so this is Bluetooth load, not idle spin.
  If work : AudioBusyUs=AudioBusyUs+NesHostUs()-start : EndIf
  AudioWorked=work
EndProcedure

Procedure AudioStop()
  Protected t.i
  A2dpEnd()
  t=NesHostUs()                         ; let the suspend and the disconnect leave the UART
  While NesHostUs()-t<50000 : HciPoll() : Wend
  AudioRunning=0 : AudioLive=0
  HciClose()                            ; gives the PL011 and BT_ON back (bt_uart.pi4)
EndProcedure

Procedure AudioDiagnostics(address.i)
  Protected i.i,p.i,c.i
  PokeI(address,BtInitError) : PokeI(address+8,HciLinkHandle())
  PokeI(address+16,A2dpState()) : PokeI(address+24,A2dpFailCode())
  If A2dpState()=#A2DP_FAILED : p=A2dpWhy() : Else : p=HciWhy() : EndIf
  For i=0 To 127
    c=PeekA(p+i) : PokeA(address+32+i,c)
    If c=0 : Break : EndIf
  Next
  PokeI(address+160,btu_powerBefore) : PokeI(address+168,BtuPowerState())
  PokeI(address+176,btu_powerErr) : PokeI(address+184,HciPairings())
EndProcedure
