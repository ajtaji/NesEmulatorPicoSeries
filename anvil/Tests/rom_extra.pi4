; All CRC-identified files needing these new mappers must load as that hardware.
Procedure RomExtraGame(*name,mapper.i)
  Protected i.i,k.i,index.i,match.i
  index=-1
  For i=0 To RomCount-1
    k=0 : match=1
    Repeat
      If PeekA(*name+k)<>RomNames(i*256+k) : match=0 : Break : EndIf
      If PeekA(*name+k)=0 : Break : EndIf
      k=k+1
    Until k=255
    If match : index=i : Break : EndIf
  Next
  RomCheck(index>=0,1)
  If index<0 : ProcedureReturn : EndIf
  RomCheck(RomLoad(index),1)
  If RomLoaded : RomCheck(CartMapper,mapper) : EndIf
EndProcedure
