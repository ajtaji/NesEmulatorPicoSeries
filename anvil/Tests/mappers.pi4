XIncludeFile "mapper5_bus_reference.pi4"
; Hardware-facing register tests on the board. Synthetic PRG/CHR banks.
Global Dim M5TestBefore.i(14)
Global Dim M5TestAfter.i(14)
Global MapperChecks.i,MapperFailures.i,MapperFirstFail.i,MapperGot.i,MapperExpected.i
Procedure MapCheck(got.i,expected.i)
  MapperChecks=MapperChecks+1
  If got<>expected
    MapperFailures=MapperFailures+1
    If MapperFirstFail=0 : MapperFirstFail=MapperChecks : MapperGot=got : MapperExpected=expected : EndIf
  EndIf
EndProcedure
Procedure MapSerial(addr.i,value.i,stamp.i)
  Protected i.i
  For i=0 To 4 : MapperWrite(addr,(value>>i)&1,stamp+i*3) : Next
EndProcedure
Procedure MapFixture(mapper.i)
  Protected i.i
  CartMapper=mapper : CartPrg=$03200000 : CartChr=$03300000
  MapPrgBytes=262144 : MapChrBytes=32768 : MapChrRam=0 : MapFourScreen=0
  For i=0 To 262143 : PokeA(CartPrg+i,i/8192) : Next
  For i=0 To 32767 : PokeA(CartChr+i,i/1024) : PokeA(@Decoded(i),i/1024) : Next
  PpuMirroring=1 : MapperInit()
EndProcedure
Procedure M5TestSave(p.i)
  PokeI(p+0,M5LastAddr)
  PokeI(p+8,M5Matches)
  PokeI(p+16,M5LastRead)
  PokeI(p+24,M5Dots)
  PokeI(p+32,M5InFrame)
  PokeI(p+40,M5Scanline)
  PokeI(p+48,M5Pending)
  PokeI(p+56,MapIrq)
  PokeI(p+64,MapIrqClocks)
  PokeI(p+72,MapIrqAssertions)
  PokeI(p+80,M5Timer)
  PokeI(p+88,M5TimerFlag)
  PokeI(p+96,M5TimerRun)
  PokeI(p+104,M5IrqEnable)
EndProcedure
Procedure M5TestRestore(p.i)
  M5LastAddr=PeekI(p+0)
  M5Matches=PeekI(p+8)
  M5LastRead=PeekI(p+16)
  M5Dots=PeekI(p+24)
  M5InFrame=PeekI(p+32)
  M5Scanline=PeekI(p+40)
  M5Pending=PeekI(p+48)
  MapIrq=PeekI(p+56)
  MapIrqClocks=PeekI(p+64)
  MapIrqAssertions=PeekI(p+72)
  M5Timer=PeekI(p+80)
  M5TimerFlag=PeekI(p+88)
  M5TimerRun=PeekI(p+96)
  M5IrqEnable=PeekI(p+104)
EndProcedure
XIncludeFile "mapper_extra.pi4"
Procedure.i MapperTests()
  Protected i.i,t.i,session.i,k.i,seed.i,cycles.i,dots.i,width.i,step.i
  t=NesHostUs() : GuestReset()
  MapFixture(1)
  MapCheck(NesRead($8000),0) : MapCheck(NesRead($A000),1)
  MapCheck(NesRead($C000),30) : MapCheck(NesRead($E000),31)
  MapSerial($E000,3,20) : MapCheck(NesRead($8000),6) : MapCheck(NesRead($C000),30)
  MapSerial($8000,8,50) : MapCheck(NesRead($8000),0) : MapCheck(NesRead($C000),6)
  MapSerial($8000,0,80) : MapCheck(NesRead($8000),4) : MapCheck(NesRead($E000),7)
  MapSerial($8000,28,110) : MapSerial($A000,3,140) : MapSerial($C000,6,170)
  MapCheck(PeekA(Chr),12) : MapCheck(PeekA(Chr+4096),24)
  MapSerial($8000,12,200) : MapCheck(PeekA(Chr),8) : MapCheck(PeekA(Chr+4096),12)
  MapShift=$10 : MapperWrite($8000,1,300) : MapperWrite($8000,0,301)
  MapCheck(MapShift,$18) : MapperWrite($8000,128,304) : MapCheck(MapShift,$10)
  MapperWrite($8000,1,307) : MapperWrite($8000,128,308) : MapCheck(MapShift,$10)
  MapCheck(MapControl&12,12)
  MapperMirror(1) : PpuWrite($2000,$11) : PpuWrite($2400,$22)
  MapCheck(PpuRead($2800),$11) : MapCheck(PpuRead($2C00),$22)
  MapperMirror(2) : MapCheck(PpuRead($2C00),$11)
  MapperMirror(3) : MapCheck(PpuRead($2000),$22) : PpuWrite($2800,$33)
  MapperMirror(0) : MapCheck(PpuRead($2400),$11) : MapCheck(PpuRead($2800),$33)
  MapCheck(Nt(1024),$11) : MapCheck(Nt(3072),$33)
  MapperWrite($6000,$72,400) : MapCheck(NesRead($6000),$72) : MapCheck(NesDmaRead($6000),$72)
  MapSerial($E000,16,410) : NesOpenBus=$51 : MapCheck(NesRead($6000),$51)
  MapSerial($E000,0,440) : MapCheck(NesRead($6000),$72)
  ; CHR RAM aliasing and decoded row coherence across 4 KiB switches.
  MapChrRam=1 : MapChrBytes=8192
  GuestClear(CartChr,8192) : GuestClear(@Decoded(0),8192)
  MapperInit() : MapControl=28 : MapperUpdate()
  PpuWrite(0,$80) : MapCheck(PeekA(Chr+4096),$80)
  MapCheck(PeekU(Pattern),1) : MapCheck(PeekU(Pattern+4096),1)
  MapChr0=1 : MapperUpdate() : PpuWrite(0,$40)
  MapCheck(PeekA(CartChr+4096),$40) : MapCheck(PeekU(Pattern),4)
  MapCheck(PeekU(Pattern+4096),1)
  MapFixture(4)
  MapCheck(NesRead($8000),0) : MapCheck(NesRead($A000),1)
  MapCheck(NesRead($C000),30) : MapCheck(NesRead($E000),31)
  MapperWrite($8000,6,0) : MapperWrite($8001,9,0)
  MapCheck(NesRead($8000),9)
  MapperWrite($8000,70,0) : MapCheck(NesRead($8000),30) : MapCheck(NesRead($C000),9)
  MapperWrite($8000,0,0) : MapperWrite($8001,7,0)
  MapCheck(PeekA(Chr),6) : MapCheck(PeekA(Chr+1024),7)
  MapperWrite($8000,128,0)
  MapCheck(PeekA(Chr+4096),6) : MapCheck(PeekA(Chr),4)
  MapCheck(PeekA(Pattern+4096),6)
  MapperWrite($A001,128,0) : MapperWrite($6001,$61,0) : MapCheck(NesRead($6001),$61)
  MapperWrite($A001,192,0) : MapperWrite($6001,$22,0) : MapCheck(NesRead($6001),$61)
  MapperWrite($A001,0,0) : NesOpenBus=$77 : MapCheck(NesRead($6001),$77)
  MapperWrite($C000,3,0) : MapperWrite($C001,0,0) : MapperWrite($E001,0,0)
  MapA12=0 : MapLowSince=0 : MapperA12($1000,9) : MapCheck(MapIrqClocks,0)
  MapperA12(0,10) : MapperA12($1000,20) : MapCheck(MapIrqCount,3)
  For i=0 To 2 : MapperA12(0,30+i*20) : MapperA12($1000,40+i*20) : Next
  MapCheck(MapIrqCount,0) : MapCheck(MapIrq,1)
  MapperWrite($E000,0,0) : MapCheck(MapIrq,0)
  MapperClockIrq() : MapCheck(MapIrqCount,3) : MapCheck(MapIrq,0)
  MapperWrite($C000,0,0) : MapperWrite($C001,0,0) : MapperWrite($E001,0,0)
  MapCheck(MapIrq,0) : MapperClockIrq() : MapCheck(MapIrq,1)
  ; Actual fetch schedules, including pre-render, enable mask and A12 filter.
  MapperInit() : PpuLine=0 : PpuDot=0 : PpuOdd=0 : PpuMask=24 : PpuCtrl=8
  MapperPpuTicks(29780) : MapCheck(MapIrqClocks,241)
  ; Reverse pattern tables add the first pre-render rise after vblank's
  ; long low interval, in addition to each line's dot-325 rise.
  MapperInit() : PpuCtrl=16 : MapperPpuTicks(29780) : MapCheck(MapIrqClocks,242)
  MapperInit() : PpuMask=0 : MapperPpuTicks(29780) : MapCheck(MapIrqClocks,0)
  MapIrq=0 : MapIrqEnable=0 : MapCheck(MapperCpuBudget(),128)
  MapIrqEnable=1 : PpuMask=24 : PpuCtrl=8 : PpuLine=0 : PpuDot=0
  MapCheck(MapperCpuBudget(),85)
  PpuDot=256 : MapCheck(MapperCpuBudget(),1)
  PpuLine=240 : PpuDot=0 : MapCheck(MapperCpuBudget(),128)
  MapIrq=1 : MapCheck(MapperCpuBudget(),1)
  ; CNROM, AxROM and Color Dreams use the same active-bank bus adapter.
  MapFixture(3) : CartConflicts=0
  MapperWrite($8000,3,0) : MapCheck(PeekA(Chr),24) : MapCheck(NesRead($E000),3)
  CartConflicts=1 : MapperWrite($A000,3,0) : MapCheck(PeekA(Chr),8)
  MapFixture(7) : CartConflicts=0
  MapperWrite($8000,$12,0) : MapCheck(NesRead($8000),8) : MapCheck(NesRead($E000),11)
  MapCheck(MapMirrorMode,3) : PpuWrite($2000,$91) : MapCheck(PpuRead($2C00),$91)
  MapperWrite($8000,1,0) : MapCheck(MapMirrorMode,2) : MapCheck(NesRead($8000),4)
  MapFixture(11) : CartConflicts=0
  MapperWrite($8000,$32,0) : MapCheck(NesRead($8000),8) : MapCheck(PeekA(Chr),24)
  ; MMC5 PRG modes, RAM permissions, aliases and bank-chip decoding.
  MapRamBytes=65536 : MapFixture(5)
  MapCheck(NesRead($E000),31)
  M5Write($5114,$85) : MapCheck(NesRead($8000),5)
  M5Write($5100,2) : M5Write($5115,$87)
  MapCheck(NesRead($8000),6) : MapCheck(NesRead($A000),7)
  M5Write($5100,1) : M5Write($5117,$8B)
  MapCheck(NesRead($C000),10) : MapCheck(NesRead($E000),11)
  M5Write($5100,0) : M5Write($5117,$8B)
  MapCheck(NesRead($8000),8) : MapCheck(NesRead($E000),11)
  M5Write($5100,3) : M5Write($5114,2) : M5Write($5113,2)
  M5PrgWrite($8000,$62) : MapCheck(M5PrgRead($6000),0)
  M5Write($5102,2) : M5Write($5103,1) : M5PrgWrite($8000,$62)
  MapCheck(M5PrgRead($6000),$62) : MapCheck(M5PrgRead($8000),$62)
  MapCheck(PeekA(#MAP_PRG),$62)
  M5Write($5115,2) : M5PrgWrite($6001,$73) : MapCheck(M5PrgRead($A001),$73)
  M5Write($5103,0) : M5PrgWrite($A001,$11) : MapCheck(M5PrgRead($6001),$73)
  MapRamBytes=8192 : MapCheck(M5RamOffset(3),0) : MapCheck(M5RamOffset(4),-1)
  MapRamBytes=16384 : MapCheck(M5RamOffset(4),8192)
  MapRamBytes=32768 : MapCheck(M5RamOffset(3),24576) : MapCheck(M5RamOffset(4),-1)
  ; MMC5 independent sprite, background and CPU $2007 CHR views.
  M5Write($5101,1) : M5Write($5123,2) : M5Write($5127,5)
  MapCheck(M5ChrBank(0,0),8) : MapCheck(M5ChrBank(7,0),23)
  PpuCtrl=32 : PpuMask=24 : M5PpuNotice($2000,32) : M5PpuNotice($2001,24)
  M5Write($512B,3) : MapCheck(M5ChrBank(0,1),12) : MapCheck(M5ChrBank(7,1),15)
  MapCheck(PpuRead(0),12) : MapCheck(PeekA(#M5_SPRITE_PATTERN),8)
  M5Write($5123,2) : MapCheck(PpuRead(0),8)
  M5Write($5101,3) : M5Write($5130,1) : M5Write($5120,5)
  MapCheck(M5Chr(0),261) : M5Write($5130,0) : MapCheck(M5Chr(0),261)
  ; CIRAM, ExRAM, fill sources and CPU access modes.
  M5Write($5104,0) : M5Write($5105,$E4)
  PpuWrite($2000,$11) : PpuWrite($2400,$22) : PpuWrite($2800,$33)
  M5Write($5106,$44) : M5Write($5107,2)
  MapCheck(PpuRead($2000),$11) : MapCheck(PpuRead($2400),$22)
  MapCheck(PpuRead($2800),$33) : MapCheck(PpuRead($2C00),$44) : MapCheck(PpuRead($2FC0),$AA)
  M5Write($5104,2) : M5Write($5C12,$67) : MapCheck(M5Read($5C12),$67)
  M5Write($5104,3) : M5Write($5C12,$23) : MapCheck(M5Read($5C12),$67)
  MapCheck(PpuRead($2812),0)
  M5Write($5104,0) : M5InFrame=0 : M5Write($5C12,$23) : MapCheck(M5Ex(18),0)
  M5InFrame=1 : M5Write($5C12,$23) : MapCheck(M5Ex(18),$23)
  ; Extended attributes select tile bank and palette independently.
  M5Write($5104,1) : M5Write($5105,0) : M5Ex(0)=$C1
  For i=0 To 255
    PixelSpread(i)=(i&3)|(((i>>2)&3)<<8)|(((i>>4)&3)<<16)|(((i>>6)&3)<<24)
  Next
  Nt(0)=0 : WAddr=0 : PpuDot=0 : WI=0 : M5Split=0
  M5FetchTile() : MapCheck(WLo,$0C0C0D0C) : MapCheck(WHi,$0C0C0D0C)
  ; Vertical split is positioned by fetch column and uses ExRAM tiles/attrs.
  M5Write($5104,0) : MapCiram(0)=0 : MapCiram(960)=0 : M5NtRefresh()
  M5Ex(0)=0 : M5Ex(960)=$55 : M5SplitBank=2 : M5Split=$81
  PpuLine=0 : PpuDot=0 : WAddr=0 : WI=0 : M5FetchTile()
  MapCheck(WLo,$04040604)
  PpuDot=8 : M5FetchTile() : MapCheck(WLo,0)
  M5Split=$C1 : PpuDot=0 : M5FetchTile() : MapCheck(WLo,0)
  PpuDot=8 : M5FetchTile() : MapCheck(WLo,$04040604)
  M5Split=$81 : M5SplitScroll=8 : M5Ex(32)=1
  PokeU(@Decoded(8192)+16,3) : PpuDot=0 : M5FetchTile() : MapCheck(WLo,$04040407)
  M5Split=0 : M5SplitScroll=0
  ; 8 KiB / 2 KiB CHR modes and 8x8 sprite mode's ignored B bank set.
  M5Write($5101,0) : M5Write($5127,2) : M5Write($512B,3)
  MapCheck(M5ChrBank(7,0),23) : MapCheck(M5ChrBank(7,1),31)
  M5PpuNotice($2000,0) : MapCheck(PpuRead(0),16)
  M5Write($5101,2) : M5Write($5121,3) : M5Write($5129,7)
  MapCheck(M5ChrBank(0,0),6) : MapCheck(M5ChrBank(1,0),7) : MapCheck(M5ChrBank(4,1),14)
  ; Hardware multiplier covers every input pair.
  For i=0 To 65535
    M5MulA=i&255 : M5MulB=i>>8
    MapCheck(M5Read($5205)|(M5Read($5206)<<8),M5MulA*M5MulB)
    If (i&255)=0 : SafetyPet() : EndIf
  Next
  ; Three matching NT reads, following attribute fetch, sticky pending IRQ.
  M5ScanReset() : M5LastRead=-100 : M5Write($5203,1) : M5Write($5204,128)
  M5PpuRead($2000,0) : M5PpuRead($2000,2) : M5PpuRead($2000,4)
  MapCheck(M5InFrame,0) : M5PpuRead($23C0,6) : MapCheck(M5InFrame,1) : MapCheck(M5Scanline,0)
  M5PpuRead($2000,8) : M5PpuRead($2000,10) : M5PpuRead($2000,12) : M5PpuRead($23C0,14)
  MapCheck(M5Scanline,1) : MapCheck(MapIrq,1)
  M5Write($5204,0) : MapCheck(MapIrq,0) : MapCheck(M5Pending,1)
  M5Write($5204,128) : MapCheck(MapIrq,1) : MapCheck(M5Read($5204),$C0) : MapCheck(MapIrq,0)
  ; Cartridge pulse status, timer period, length shutoff and PCM IRQ.
  LengthTable(0)=10 : M5SoundWrite($5015,1) : M5SoundWrite($5000,$3F)
  M5SoundWrite($5002,10) : M5SoundWrite($5003,0)
  MapCheck(M5Read($5015),1) : MapCheck(M5Period(0),10)
  M5AudioAdvance(44) : MapCheck(M5Seq(0),6)
  M5SoundWrite($5015,0) : MapCheck(M5Read($5015),0)
  M5SoundWrite($5010,$81) : M5PcmRead($54) : MapCheck(M5PcmValue,$54)
  M5PcmRead(0) : MapCheck(MapIrq,1) : MapCheck(M5Read($5010),128) : MapCheck(MapIrq,0)
  M5Write($520A,1) : PpuMask=0 : M5PpuTicks(300) : MapCheck(M5Timer,256)
  M5Write($5209,0) : M5PpuTicks(256)
  MapCheck(M5Read($5209),128) : MapCheck(MapIrq,0)
  ; Fixed waveform-area oracles and ultrasonic reconstruction (not muting).
  M5AudioInit() : M5SoundWrite($5015,1) : M5SoundWrite($5000,$BF)
  M5SoundWrite($5002,10) : M5SoundWrite($5003,0)
  M5Seq(0)=3 : M5PulseTimer(0)=22 : M5AudioAdvance(22)
  ApuProduced=1 : Pcm(0)=0 : M5AudioMix() : MapCheck(Pcm(0),-5700)
  M5AudioInit() : M5SoundWrite($5015,1) : M5SoundWrite($5000,$BF)
  M5SoundWrite($5002,0) : M5SoundWrite($5003,0) : M5AudioAdvance(32)
  MapCheck(M5PulseArea(0),240) : MapCheck(M5Seq(0),0)
  ApuProduced=1 : Pcm(0)=0 : M5AudioMix() : MapCheck(Pcm(0),-2850)
  ; Differential proof that bus batching preserves every observer state.
  M5ScanReset() : M5Dots=0 : M5LastRead=-100 : PpuLine=261 : PpuDot=0 : PpuOdd=0
  M5IrqTarget=10 : M5IrqEnable=1 : M5Timer=0 : M5TimerFlag=0 : M5TimerRun=0
  seed=1234
  For i=0 To 9999
    seed=(seed*1664525+1013904223)&$FFFFFFFF : cycles=(seed>>16)&127 : cycles=cycles+1
    PpuMask=24 : If (seed&31)=0 : PpuMask=0 : EndIf
    M5TestSave(@M5TestBefore(0)) : M5PpuTicks(cycles) : M5TestSave(@M5TestAfter(0))
    M5TestRestore(@M5TestBefore(0)) : M5PpuTicksReference(cycles)
    M5TestSave(@M5TestBefore(0))
    For k=0 To 13 : MapCheck(M5TestBefore(k),M5TestAfter(k)) : Next
    If (i&7)=0 : M5PpuRead((seed&1)*$2000,M5Dots) : EndIf
    If (i&31)=0 : M5Read($5204) : EndIf
    dots=cycles*3
    While dots>0
      width=341 : If PpuLine=261 And PpuOdd<>0 And (PpuMask&24)<>0 : width=340 : EndIf
      step=width-PpuDot : If step>dots : step=dots : EndIf
      PpuDot=PpuDot+step : dots=dots-step
      If PpuDot=width
        PpuDot=0 : PpuLine=PpuLine+1
        If PpuLine=262 : PpuLine=0 : PpuOdd=PpuOdd!1 : EndIf
      EndIf
    Wend
    If (i&255)=0 : SafetyPet() : EndIf
  Next
  ; NINA register decoding, Codemasters fixed bank, Namco fixed wiring.
  MapFixture(79)
  MapperWrite($4100,$0B,0) : MapCheck(NesRead($8000),4) : MapCheck(PeekA(Chr),24)
  MapperWrite($4200,0,0) : MapCheck(PeekA(Chr),24)
  MapperWrite($5100,2,0) : MapCheck(NesRead($8000),0) : MapCheck(PeekA(Chr),16)
  MapFixture(71)
  MapperWrite($C000,3,0) : MapCheck(NesRead($8000),6) : MapCheck(NesRead($E000),31)
  MapperWrite($9000,16,0) : MapCheck(MapMirrorMode,2)
  MapperWrite($9000,0,0) : MapCheck(MapMirrorMode,3)
  MapFixture(206)
  MapperWrite($A000,$C6,0) : MapperWrite($A001,3,0)
  MapCheck(NesRead($8000),3) : MapCheck(NesRead($C000),30)
  MapperWrite($C000,0,0) : MapperWrite($C001,7,0)
  MapCheck(PeekA(Chr),6) : MapCheck(PeekA(Chr+1024),7)
  MapperWrite($E000,1,0) : MapperWrite($E001,9,0)
  MapCheck(PeekA(Chr+2048),8) : MapCheck(MapIrqEnable,0)
  ExtraMapperTests()
  ; Reset restores guest defaults while preserving host/session ownership.
  session=AudioSessionStarted : AudioSessionStarted=123
  M(12)=99 : ApuLength(0)=88 : PpuMask=31 : MapIrq=1
  GuestReset() : MapCheck(M(12),0) : MapCheck(ApuLength(0),0)
  MapCheck(PpuMask,0) : MapCheck(DmcEmpty,1) : MapCheck(ApuSampleLeft,37)
  MapCheck(PpuWarmup,29658) : MapCheck(MapIrq,0) : MapCheck(AudioSessionStarted,123)
  AudioSessionStarted=session
  PokeI($02F00400,MapperChecks) : PokeI($02F00408,MapperFailures)
  PokeI($02F00410,MapperFirstFail) : PokeI($02F00418,MapperGot) : PokeI($02F00420,MapperExpected)
  PokeI($02F00428,NesHostUs()-t)
  ProcedureReturn MapperFailures
EndProcedure
