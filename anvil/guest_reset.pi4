; Generated from the guest state declarations. Host devices and selector
; state are deliberately outside this reset. Worker is joined before entry.
Procedure GuestClear(p.i,n.i)
  Protected i.i
  For i=0 To n-1 : PokeA(p+i,0) : Next
EndProcedure
