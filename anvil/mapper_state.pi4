Global M5PrgMode.i=3,M5ChrMode.i,M5Protect1.i=1,M5Protect2.i=2
Global M5ExMode.i=3,M5NtConfig.i,M5FillTile.i,M5FillAttr.i,M5ChrHigh.i,M5LastSet.i
