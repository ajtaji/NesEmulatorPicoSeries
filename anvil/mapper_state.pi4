Global MapDots.i,MapLowSince.i,MapA12.i,MapSpriteBits.i
Global MapIrqClocks.i,MapIrqAssertions.i
Global Dim MapRegs.i(8)
Global Dim MapPrgSlots.i(4)
Global Dim MapChrSlots.i(8)
Global Dim MapRam.a(8192)
Global Dim MapCiram.a(4096)
Global Dim MapNtSlots.i(4)
Global MapMirrorMode.i=-1
Declare PpuDecode(row.i)
Declare MapperMirror(mode.i)


Global MapManaged.i,MapRamBytes.i=8192
Declare M5Init()
