; MMC1B and standard MMC3B/C cartridge hardware. Guest interpreter and
; tile/sprite renderer retain their flat windows. All calls run on core 1,
; except cartridge initialization before the worker starts.
#MAP_PRG=$03500000
#MAP_CHR=$03508000
#MAP_PATTERN=$0350A000
Global MapPrgBytes.i,MapChrBytes.i,MapChrRam.i,MapBattery.i,MapFourScreen.i
Global MapIrq.i,MapSelect.i,MapRamEnable.i,MapRamProtect.i
