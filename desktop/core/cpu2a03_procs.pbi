  CpuNZ(Res)
    A = Res & 255
  CpuProcNext(4)
EndProcedure
Procedure CpuProcF6() ; ; $F6 INC zpx
  CpuFetch(Ea)
  Ea = (Ea + X) & 255
  NesOpenBus = M(Ea)
  Value = NesOpenBus
  Res = Value + 1
  Res = Res & 255
  CpuNZ(Res)
  M(Ea) = Value : NesOpenBus = Value
  M(Ea) = Res : NesOpenBus = Res
  CpuProcNext(6)
EndProcedure
Procedure CpuProcF8() ; ; $F8 SED imp
  FD = 1
  CpuProcNext(2)
EndProcedure
Procedure CpuProcF9() ; ; $F9 SBC aby
  AccessPhase = 3
  CpuFetchAddress()
  Base = Ea
  Ea = (Ea + Y) & $FFFF
  CpuCrossPage()
  Value = NesRead(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuProcNext(4)
EndProcedure
Procedure CpuProcFD() ; ; $FD SBC abx
  AccessPhase = 3
  CpuFetchAddress()
  Base = Ea
  Ea = (Ea + X) & $FFFF
  CpuCrossPage()
  Value = NesRead(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuProcNext(4)
EndProcedure
Procedure CpuProcFE() ; ; $FE INC abx
  AccessPhase = 6
  CpuFetchAddress()
  Ea = (Ea + X) & $FFFF
  AccessPhase = AccessPhase - 2
  Value = NesRead(Ea)
  AccessPhase = AccessPhase + 2
  Res = Value + 1
  Res = Res & 255
  CpuNZ(Res)
  AccessPhase = AccessPhase - 1
  NesWrite(Ea, Value)
  AccessPhase = AccessPhase + 1
  NesWrite(Ea, Res)
  CpuProcNext(7)
EndProcedure

Procedure.i CpuRunProc(n.i)
  Protected op.CpuProcOp, i.i
  If n <= 0 Or Stopped : ProcedureReturn 0 : EndIf
  If CpuProcReady = 0
    For i = 0 To 255 : CpuProcTable(i) = @CpuProcIllegal() : Next
    CpuProcTable($00) = @CpuProc00()
    CpuProcTable($01) = @CpuProc01()
    CpuProcTable($05) = @CpuProc05()
    CpuProcTable($06) = @CpuProc06()
