  AccessPhase = 4
  CpuFetch(Tmp)
  Lo = M(Tmp) : Hi = M((Tmp + 1) & 255) : NesOpenBus = Hi
  Ea = Lo | (Hi << 8)
  Base = Ea
  Ea = (Ea + Y) & $FFFF
  CpuCrossPage()
  Value = NesRead(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
