Procedure CpuProcF0() ; ; $F0 BEQ rel
  If (FZ & 255) = 0
    CompilerIf #CPU_TIMING = 1
      Base = (PC + 1) & $FFFF
    CompilerEndIf
    Res = (CpuFetchByte() ! 128) - 128
    PC = (PC + Res) & $FFFF
    CompilerIf #CPU_TIMING = 1
      Ea = PC
      CpuCrossPage()
    CompilerEndIf
    CpuTick(1)
  Else
    PC = (PC + 1) & $FFFF
  EndIf
  If Res=-7
  If NesIdleEnabled<>0 And A=0 And (FZ&255)=0 And (PpuStatusBits&$40)=0 And Left>12 And PpuStatusDeadline>NesRunStart+Budget-Left And PC>=$8000 And PC<=$FFF9
    NesPollPtr=PrgBias+PC
    If PeekA(NesPollPtr)=$AD And PeekA(NesPollPtr+1)=2 And PeekA(NesPollPtr+2)=$20 And PeekA(NesPollPtr+3)=$29 And PeekA(NesPollPtr+4)=$40 And PeekA(NesPollPtr+5)=$F0 And PeekA(NesPollPtr+6)=$F9
      NesPollCycles=9
      If (Base&$FF00)<>(PC&$FF00)
        NesPollCycles=10
      EndIf
      NesPollCount=NesDiv(Left-3,NesPollCycles)
      Tmp=NesDiv(PpuStatusDeadline-(NesRunStart+Budget-Left)+4,NesPollCycles)
      If NesPollCount>Tmp
        NesPollCount=Tmp
      EndIf
      If NesPollCount>0
        CpuTick(NesPollCount*NesPollCycles)
        NesInstructions=NesInstructions+NesPollCount*3
        NesIdleBatched=NesIdleBatched+NesPollCount*3
        NesPollStatusDone()
        FN=0 : FZ=0 : NesOpenBus=$F9
      EndIf
    EndIf
  EndIf
  EndIf
  If Res=-4
  If NesIdleEnabled<>0 And A=0 And (FZ&255)=0 And Left>9 And PC>=$8000 And PC<=$FFFC
    NesPollPtr=PrgBias+PC
    If PeekA(NesPollPtr)=$A5 And PeekA(NesPollPtr+2)=$F0 And PeekA(NesPollPtr+3)=$FC And M(PeekA(NesPollPtr+1))=0
      NesPollCycles=6
      If (Base&$FF00)<>(PC&$FF00)
        NesPollCycles=7
      EndIf
      NesPollCount=NesDiv(Left-3,NesPollCycles)
      CpuTick(NesPollCount*NesPollCycles)
      NesInstructions=NesInstructions+NesPollCount*2
      NesIdleBatched=NesIdleBatched+NesPollCount*2
      FN=0 : FZ=0 : NesOpenBus=$FC
    EndIf
  EndIf
  EndIf
  CpuProcNext(2)
EndProcedure
