    CpuProcTable($D5) = @CpuProcD5()
    CpuProcTable($D6) = @CpuProcD6()
    CpuProcTable($D8) = @CpuProcD8()
    CpuProcTable($D9) = @CpuProcD9()
    CpuProcTable($DD) = @CpuProcDD()
    CpuProcTable($DE) = @CpuProcDE()
    CpuProcTable($E0) = @CpuProcE0()
    CpuProcTable($E1) = @CpuProcE1()
    CpuProcTable($E4) = @CpuProcE4()
    CpuProcTable($E5) = @CpuProcE5()
    CpuProcTable($E6) = @CpuProcE6()
    CpuProcTable($E8) = @CpuProcE8()
    CpuProcTable($E9) = @CpuProcE9()
    CpuProcTable($EA) = @CpuProcEA()
    CpuProcTable($EC) = @CpuProcEC()
    CpuProcTable($ED) = @CpuProcED()
    CpuProcTable($EE) = @CpuProcEE()
    CpuProcTable($F0) = @CpuProcF0()
    CpuProcTable($F1) = @CpuProcF1()
    CpuProcTable($F5) = @CpuProcF5()
    CpuProcTable($F6) = @CpuProcF6()
    CpuProcTable($F8) = @CpuProcF8()
    CpuProcTable($F9) = @CpuProcF9()
    CpuProcTable($FD) = @CpuProcFD()
    CpuProcTable($FE) = @CpuProcFE()
    CpuProcReady = 1
  EndIf
  If NesStall
    CpuCycles = CpuCycles + NesStall
    NesStall = 0
  EndIf
  NesRunStart = CpuCycles
  CpuInWindow = 1
  Budget = n
  Left = n
  Repeat
    Tmp = NesRead(PC)
    PC = (PC + 1) & $FFFF
    op = CpuProcTable(Tmp)
    op()
  Until Left <= 0 Or Stopped
  CpuCycles = NesRunStart + Budget - Left
  CpuInWindow = 0
  ProcedureReturn CpuCycles - NesRunStart
EndProcedure
