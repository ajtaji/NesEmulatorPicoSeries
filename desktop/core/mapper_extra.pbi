; Generated by tools/port_desktop.py from anvil/mapper_extra.pi4 - do not edit; regenerate.
; Register decoders and bank wiring live here; CPU/PPU/APU use flat windows.
Procedure.i ExtraManaged(mapper.i)
  If KonamiNamcoMapper(mapper) : ProcedureReturn 1 : EndIf
  If mapper=6 : ProcedureReturn 1 : EndIf
  If mapper=9 : ProcedureReturn 1 : EndIf
  If mapper=13 : ProcedureReturn 1 : EndIf
  If mapper=34 : ProcedureReturn 1 : EndIf
  If mapper=41 : ProcedureReturn 1 : EndIf
  If mapper=47 : ProcedureReturn 1 : EndIf
  If mapper=64 : ProcedureReturn 1 : EndIf
  If mapper=68 : ProcedureReturn 1 : EndIf
  If mapper=69 : ProcedureReturn 1 : EndIf
  If mapper=71 : ProcedureReturn 1 : EndIf
  If mapper=79 : ProcedureReturn 1 : EndIf
  If mapper=105 : ProcedureReturn 1 : EndIf
  If mapper=118 : ProcedureReturn 1 : EndIf
  If mapper=119 : ProcedureReturn 1 : EndIf
  If mapper=144 : ProcedureReturn 1 : EndIf
  If mapper=148 : ProcedureReturn 1 : EndIf
  If mapper=158 : ProcedureReturn 1 : EndIf
  If mapper=206 : ProcedureReturn 1 : EndIf
  If mapper=228 : ProcedureReturn 1 : EndIf
  If mapper=232 : ProcedureReturn 1 : EndIf
  If mapper=234 : ProcedureReturn 1 : EndIf
  ProcedureReturn 0
EndProcedure
Procedure ExtraMapperInit()
  Protected i.i
  ExtraMode=0 : ExtraOuter=0 : ExtraChr=0 : ExtraFlags=0
  ExtraIrqCount=0 : ExtraIrqRun=0 : ExtraIrqDivider=0 : ExtraIrqMode=0
  ExtraLatch0=1 : ExtraLatch1=1 : ExtraPending=0
  For i=0 To 15 : ExtraRegs(i)=0 : Next
  ExtraSoundInit()
  For i=0 To 32767 : ExtraRam(i)=0 : Next
  GuestClear((AnvilWindow+$10000),8192) : GuestClear((AnvilWindow+$12000),8192)
  If CartMapper=6
    ExtraMode=CartSubmapper : If ExtraMode=0 : ExtraMode=1 : EndIf
    ExtraFlags=1
  EndIf
  If CartMapper=105 : MapChr0=16 : EndIf
  If CartMapper=9 : ExtraLatch0=1 : ExtraLatch1=1 : EndIf
  If CartMapper=71 And CartSubmapper=1 : ExtraMode=1 : EndIf
  If ExtraManaged(CartMapper) : MapRamEnable=0 : EndIf
  If CartMapper=6 Or CartMapper=9 Or CartMapper=34 Or CartMapper=47 Or CartMapper=105 Or CartMapper=118 Or CartMapper=119 : MapRamEnable=1 : EndIf
  If CartMapper=34 And MapChrRam : MapRamEnable=0 : EndIf
  If CartMapper=13 : MapperMirror(1) : EndIf
  If CartMapper=41 Or CartMapper=228 Or CartMapper=234 : MapperMirror(1) : EndIf
  ExpChip=0 : ExpSample=0
  If CartMapper=19 Or CartMapper=24 Or CartMapper=26 : KonamiNamcoInit() : EndIf
EndProcedure
Procedure.i ExtraMapperUpdate()
  Protected i.i,bank.i
  Select CartMapper
    Case 19, 24, 26
      KonamiNamcoUpdate()
    Case 79
      For i=0 To 3 : MapperPrg(i,((MapPrgReg>>3)&1)*4+i) : Next
      For i=0 To 7 : MapperChr(i,(MapPrgReg&7)*8+i) : Next
    Case 71
      For i=0 To 1
        MapperPrg(i,MapPrgReg*2+i) : MapperPrg(i+2,MapPrgBytes/8192-2+i)
      Next
      For i=0 To 7 : MapperChr(i,i) : Next
    Case 206
      MapperPrg(0,MapRegs(6)&15) : MapperPrg(1,MapRegs(7)&15)
      MapperPrg(2,MapPrgBytes/8192-2) : MapperPrg(3,MapPrgBytes/8192-1)
      MapperChr(0,MapRegs(0)&62) : MapperChr(1,(MapRegs(0)&62)|1)
      MapperChr(2,MapRegs(1)&62) : MapperChr(3,(MapRegs(1)&62)|1)
      For i=0 To 3 : MapperChr(i+4,MapRegs(i+2)&63) : Next
    Case 6
      bank=ExtraRegs(0)
      If ExtraMode=0 Or ExtraMode=1 Or ExtraMode=2
        MapPrgReg=bank&7 : ExtraChr=0
        If ExtraMode=1 : MapPrgReg=(bank>>2)&15 : ExtraChr=bank&3 : EndIf
        If ExtraMode=2 : MapPrgReg=bank&15 : EndIf
        For i=0 To 1
          MapperPrg(i,MapPrgReg*2+i)
          If ExtraMode=2 : MapperPrg(i+2,30+i) : Else : MapperPrg(i+2,14+i) : EndIf
        Next
      ElseIf ExtraMode=3
        ExtraChr=(bank>>4)&3
        For i=0 To 1 : MapperPrg(i,30+i) : MapperPrg(i+2,(bank&15)*2+i) : Next
      Else
        ExtraChr=bank&3 : MapPrgReg=3
        If ExtraMode=4 : MapPrgReg=(bank>>4)&3 : EndIf
        If ExtraMode=6 : ExtraChr=bank&1 : EndIf
        If ExtraMode=7 : ExtraChr=0 : EndIf
        For i=0 To 3 : MapperPrg(i,MapPrgReg*4+i) : Next
      EndIf
      For i=0 To 7 : MapperChr(i,ExtraChr*8+i) : Next
    Case 9
      MapperPrg(0,MapPrgReg&15)
      For i=1 To 3 : MapperPrg(i,MapPrgBytes/8192-4+i) : Next
      For i=0 To 3
        MapperChr(i,ExtraRegs(ExtraLatch0)*4+i)
        MapperChr(i+4,ExtraRegs(2+ExtraLatch1)*4+i)
      Next
    Case 13
      For i=0 To 3 : MapperPrg(i,i) : MapperChr(i,i) : MapperChr(i+4,(ExtraChr&3)*4+i) : Next
    Case 34
      For i=0 To 3 : MapperPrg(i,MapPrgReg*4+i) : Next
      For i=0 To 3 : MapperChr(i,MapChr0*4+i) : MapperChr(i+4,MapChr1*4+i) : Next
    Case 41
      For i=0 To 3 : MapperPrg(i,MapPrgReg*4+i) : Next
      For i=0 To 7 : MapperChr(i,ExtraChr*8+i) : Next
    Case 64
      ExtraRamboUpdate()
    Case 158
      ExtraRamboUpdate()
    Case 68
      For i=0 To 1 : MapperPrg(i,(MapPrgReg&7)*2+i) : MapperPrg(i+2,14+i) : Next
      For i=0 To 3 : MapperChr(i*2,ExtraRegs(i)*2) : MapperChr(i*2+1,ExtraRegs(i)*2+1) : Next
      ExtraNtRefresh()
    Case 69
      For i=0 To 2 : MapperPrg(i,ExtraRegs(9+i)&63) : Next
      MapperPrg(3,MapPrgBytes/8192-1)
      For i=0 To 7 : MapperChr(i,ExtraRegs(i)) : Next
    Case 105
      ExtraNwcUpdate()
    Case 144
      For i=0 To 3 : MapperPrg(i,(MapPrgReg&15)*4+i) : Next
      For i=0 To 7 : MapperChr(i,((MapPrgReg>>4)&15)*8+i) : Next
    Case 148
      For i=0 To 3 : MapperPrg(i,((MapPrgReg>>3)&1)*4+i) : Next
      For i=0 To 7 : MapperChr(i,(MapPrgReg&7)*8+i) : Next
    Case 228
      bank=(ExtraOuter>>11)&3 : If bank=3 : bank=2 : EndIf
      bank=((ExtraOuter>>6)&31)+bank*32
      For i=0 To 3
        If ExtraOuter&32 : MapperPrg(i,bank*2+(i&1))
        Else : MapperPrg(i,(bank&254)*2+i) : EndIf
      Next
      For i=0 To 7 : MapperChr(i,(((ExtraOuter&15)<<2)|(ExtraChr&3))*8+i) : Next
      MapperMirror(((ExtraOuter>>13)&1)!1)
    Case 232
      For i=0 To 1
        MapperPrg(i,(ExtraOuter*4+(MapPrgReg&3))*2+i)
        MapperPrg(i+2,(ExtraOuter*4+3)*2+i)
      Next
      For i=0 To 7 : MapperChr(i,i) : Next
    Case 234
      bank=ExtraRegs(0)&15 : ExtraChr=((ExtraRegs(0)<<2)&60)|((ExtraRegs(1)>>4)&3)
      If ExtraRegs(0)&64
        bank=(ExtraRegs(0)&14)|(ExtraRegs(1)&1)
        ExtraChr=((ExtraRegs(0)<<2)&56)|((ExtraRegs(1)>>4)&7)
      EndIf
      For i=0 To 3 : MapperPrg(i,bank*4+i) : Next
      For i=0 To 7 : MapperChr(i,ExtraChr*8+i) : Next
      MapperMirror(((ExtraRegs(0)>>7)&1)!1)
    Default : ProcedureReturn 0
  EndSelect
  ProcedureReturn 1
EndProcedure
Procedure.i ExtraMapperWrite(addr.i,value.i,stamp.i)
  Protected reg.i,old.i,commit.i
  Select CartMapper
    Case 19, 24, 26
      KonamiNamcoWrite(addr,value)
    Case 6
      If addr>=$42FC And addr<=$42FF
        ExtraMode=(value>>5)&7 : ExtraFlags=Bool((addr&2)<>0)
        reg=(addr&1)*2+((value>>4)&1)
        If reg<2 : reg=reg+2 : Else : reg=(reg&1)!1 : EndIf
        MapperMirror(reg) : MapperUpdate()
      ElseIf addr=$4501 : ExtraIrqRun=0 : MapIrq=0
      ElseIf addr=$4502 : ExtraIrqCount=(ExtraIrqCount&$FF00)|value : MapIrq=0
      ElseIf addr=$4503 : ExtraIrqCount=(ExtraIrqCount&255)|(value<<8) : ExtraIrqRun=1 : MapIrq=0
      ElseIf addr>=$8000
        If ExtraFlags : ExtraRegs(0)=value : MapperUpdate() : EndIf
      ElseIf addr>=$6000 : MapRam(addr&8191)=value
      ElseIf addr>=$5000 And addr<$6000 : ExtraRam(addr&4095)=value
      EndIf
    Case 9
      If addr>=$A000
        reg=addr>>12
        If reg=10 : MapPrgReg=value&15
        ElseIf reg<15 : ExtraRegs(reg-11)=value&31
        Else : MapperMirror((value&1)!1) : EndIf
        MapperUpdate()
      ElseIf addr>=$6000 And addr<$8000 : MapRam(addr&8191)=value : EndIf
    Case 13
      If addr>=$8000 : ExtraChr=value&3 : MapperUpdate() : EndIf
    Case 34
      If MapChrRam
        If addr>=$8000
          If CartConflicts : value=value&PeekA(PrgBase+addr-$8000) : EndIf
          MapPrgReg=value : MapperUpdate()
        EndIf
      ElseIf addr>=$6000 And addr<$8000
        MapRam(addr&8191)=value
        If addr=$7FFD : MapPrgReg=value&1 : EndIf
        If addr=$7FFE : MapChr0=value&15 : EndIf
        If addr=$7FFF : MapChr1=value&15 : EndIf
        MapperUpdate()
      EndIf
    Case 41
      If addr>=$6000 And addr<$6800
        MapPrgReg=addr&7 : ExtraChr=(ExtraChr&3)|((addr>>1)&12)
        MapperMirror(((addr>>5)&1)!1) : MapperUpdate()
      ElseIf addr>=$8000 And MapPrgReg>=4
        ExtraChr=(ExtraChr&12)|(value&3) : MapperUpdate()
      EndIf
    Case 47
      If addr>=$6000 And addr<$8000
        If MapRamEnable And MapRamProtect=0 : ExtraOuter=value&1 : MapperUpdate() : EndIf
        ProcedureReturn 1
      EndIf
      ProcedureReturn 0
    Case 64
      ExtraRamboWrite(addr,value)
    Case 158
      ExtraRamboWrite(addr,value)
    Case 68
      If addr>=$8000
        reg=addr>>12
        If reg<12 : ExtraRegs(reg-8)=value
        ElseIf reg=12 : ExtraRegs(4)=value|128
        ElseIf reg=13 : ExtraRegs(5)=value|128
        ElseIf reg=14
          ExtraFlags=value&16 : reg=value&3
          If reg<2 : reg=reg!1 : EndIf
          MapperMirror(reg)
        Else
          MapPrgReg=value : MapRamEnable=Bool((value&16)<>0)
        EndIf
        MapperUpdate()
      ElseIf addr>=$6000 And MapRamEnable : MapRam(addr&8191)=value : EndIf
    Case 69
      If addr>=$8000 And addr<$A000 : MapSelect=value&15
      ElseIf addr>=$A000 And addr<$C000
        reg=MapSelect&15 : ExtraRegs(reg)=value
        If reg=12
          old=value&3 : If old<2 : old=old!1 : EndIf
          MapperMirror(old)
        ElseIf reg=13 : ExtraIrqRun=(value>>7)&1 : MapIrqEnable=value&1 : MapIrq=0
        ElseIf reg=14 : ExtraIrqCount=(ExtraIrqCount&$FF00)|value
        ElseIf reg=15 : ExtraIrqCount=(ExtraIrqCount&255)|(value<<8) : EndIf
        MapperUpdate()
      ElseIf addr>=$C000 : ExtraSoundWrite(addr,value)
      ElseIf addr>=$6000 And (ExtraRegs(8)&$C0)=$C0
        ExtraRam(((ExtraRegs(8)&3)*8192)+(addr&8191))=value
      EndIf
    Case 105
      If addr>=$8000
        commit=stamp-MapLastWrite : MapLastWrite=stamp
        If commit=1 And (value&128)=0 : ProcedureReturn 1 : EndIf
        If value&128 : MapShift=16 : MapControl=MapControl|12
        Else
          commit=MapShift&1 : MapShift=(MapShift>>1)|((value&1)<<4)
          If commit
            reg=addr>>13
            If reg=4 : MapControl=MapShift : EndIf
            If reg=5 : MapChr0=MapShift : EndIf
            If reg=6 : MapChr1=MapShift : EndIf
            If reg=7 : MapPrgReg=MapShift : EndIf
            MapShift=16
          EndIf
        EndIf
        MapperUpdate()
      ElseIf addr>=$6000 And MapRamEnable : MapRam(addr&8191)=value : EndIf
    Case 118
      If (addr&$E001)=$A000 : ProcedureReturn 1 : EndIf
      ProcedureReturn 0
    Case 144
      If addr>=$8000
        old=PeekA(PrgBase+addr-$8000)
        MapPrgReg=(value&old)|(old&1) : MapperUpdate()
      EndIf
    Case 148
      If addr>=$8000 : MapPrgReg=value&PeekA(PrgBase+addr-$8000) : MapperUpdate() : EndIf
    Case 228
      If addr>=$8000 : ExtraOuter=addr : ExtraChr=value : MapperUpdate()
      ElseIf addr>=$4020 And addr<$6000 : ExtraRegs(addr&3)=value&15 : EndIf
    Case 232
      If addr>=$C000 : MapPrgReg=value&3
      ElseIf addr>=$8000
        ExtraOuter=(value>>3)&3
        If CartSubmapper=1 : ExtraOuter=((value>>4)&1)|((value>>2)&2) : EndIf
      EndIf
      MapperUpdate()
    Case 234
      If (addr>=$FF80 And addr<=$FF9F) Or (addr>=$FFE8 And addr<=$FFF8)
        value=value&PeekA(PrgBase+addr-$8000) : ExtraReadNotice(addr,value)
      EndIf
    Case 79
      If (addr&$E100)=$4100 : MapPrgReg=value : MapperUpdate() : EndIf
    Case 71
      If addr=$9000 : ExtraMode=1 : EndIf
      If addr>=$8000
        If addr>=$C000 Or ExtraMode=0
          MapPrgReg=value : MapperUpdate()
        Else
          MapperMirror(3-((value>>4)&1))
        EndIf
      EndIf
    Case 206
      If addr>=$8000
        If addr&1 : MapRegs(MapSelect&7)=value : Else : MapSelect=value&7 : EndIf
        MapperUpdate()
      EndIf
    Default : ProcedureReturn 0
  EndSelect
  ProcedureReturn 1
EndProcedure
