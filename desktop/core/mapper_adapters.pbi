; Generated by tools/port_desktop.py from anvil/mapper_adapters.pi4 - do not edit; regenerate.
; Entry adapters retain the original algorithms for all other cartridges.
Procedure PpuFetchTile()
  If CartMapper=5
    M5FetchTile()
  Else
    PpuFetchTileBase()
    If CartMapper=9 : ExtraLatchTile() : EndIf
  EndIf
EndProcedure
Procedure PpuSpritesRaw()
  Protected saved.i
  saved=Pattern
  If CartMapper=5 And (M5PpuMask&24)<>0 : Pattern=(AnvilWindow+$0C000) : EndIf
  If CartMapper=9 : ExtraLatchSprites() : Else : PpuSpritesBase() : EndIf
  Pattern=saved
EndProcedure
Procedure ApuMixSample()
  If ExpChip : ExpMix() : EndIf
  ApuMixSampleBase()
  If CartMapper=5 : M5AudioMix() : EndIf
  If CartMapper=69 : ExtraSoundMix() : EndIf
EndProcedure
