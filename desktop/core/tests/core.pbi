Global Checks.i,Failures.i,FirstCheck.i,FirstGot.i,FirstExpected.i
Procedure Check(actual.i,expected.i)
  Checks=Checks+1
  If actual<>expected
    Failures=Failures+1
    If Failures=1 : FirstCheck=Checks : FirstGot=actual : FirstExpected=expected : EndIf
  EndIf
EndProcedure
XIncludeFile "zp.pbi"
Procedure.i CoreTests()
  Protected i.i,ctrl.i,lo.i,hi.i,start.i
