; Generated by tools/port_desktop.py from anvil/selector.pi4 (its ROM checks) - do not edit; regenerate.
Global RomLoaded.i,RomChosen.i=-1
Global Dim RomHeader.a(16)
Global Dim RomCrcTable.i(256)
Global RomMapper.i,RomPrgBytes.i,RomChrBytes.i,RomSubmapper.i,RomMetadataCorrections.i
Global RomStatus$, RomRawPrg.i, RomRawChr.i, RomHeaderPal.i
Procedure.i RomCrc(p.i,n.i,crc.i)
  Protected i.i
  For i=0 To n-1
    crc=(crc>>8)!RomCrcTable((crc!PeekA(p+i))&255)
    If (i&16383)=0 : SafetyPet() : EndIf
  Next
  ProcedureReturn crc&$FFFFFFFF
EndProcedure
Procedure RomResolveMetadata()
  Protected i.i,b.i,crc.i,mapper.i,dirty.i
  If (RomHeader(7)&12)=8 : ProcedureReturn : EndIf
  For i=0 To 255
    crc=i
    For b=0 To 7
      If crc&1 : crc=(crc>>1)!$EDB88320 : Else : crc=crc>>1 : EndIf
    Next
    RomCrcTable(i)=crc
  Next
  crc=RomCrc(RomRawPrg,RomPrgBytes,$FFFFFFFF)
  crc=RomCrc(RomRawChr,RomChrBytes,crc)!$FFFFFFFF
  mapper=RomDatabaseMapper(crc)
  For i=12 To 15 : dirty=dirty|RomHeader(i) : Next
  If mapper>=0
    If mapper<>((RomHeader(6)>>4)|(RomHeader(7)&240)) : RomMetadataCorrections=RomMetadataCorrections+1 : EndIf
    RomHeader(6)=(RomHeader(6)&15)|((mapper&15)<<4)
    RomHeader(7)=(mapper&240)|(RomHeader(7)&3)
  ElseIf dirty
    ; Legacy dumper signatures occupy the upper mapper nibble.
    RomHeader(7)=RomHeader(7)&3
  EndIf
  If dirty
    For i=8 To 15 : RomHeader(i)=0 : Next
  EndIf
EndProcedure
Procedure.i RomValidateHeader(fileBytes.i)
  Protected flags.i,nes2.i,banks.i,ram.i,lo.i,hi.i
  RomStatus$=""
  If fileBytes<16 Or RomHeader(0)<>78 Or RomHeader(1)<>69 Or RomHeader(2)<>83 Or RomHeader(3)<>26
    RomStatus$="Invalid iNES header" : ProcedureReturn 0
  EndIf
  flags=RomHeader(6) : nes2=Bool((RomHeader(7)&12)=8)
  RomMapper=(flags>>4)|(RomHeader(7)&240) : RomSubmapper=0
  If nes2 : RomMapper=RomMapper|((RomHeader(8)&15)<<8) : RomSubmapper=RomHeader(8)>>4 : EndIf
  If RomMapper<>0 And RomMapper<>1 And RomMapper<>2 And RomMapper<>4 And RomMapper<>5 And RomMapper<>3 And RomMapper<>7 And RomMapper<>11 And RomMapper<>66 And ExtraManaged(RomMapper)=0
    RomStatus$="Unsupported cartridge mapper" : ProcedureReturn 0
  EndIf
  If (flags&4)<>0 Or ((flags&8)<>0 And RomMapper<>4 And RomMapper<>206) : RomStatus$="Trainer / four-screen cartridges are unsupported" : ProcedureReturn 0 : EndIf
  RomHeaderPal=0
  If nes2 : RomHeaderPal=Bool((RomHeader(12)&3)=1) : EndIf
  If nes2=0 And RomHeader(12)=0 And RomHeader(13)=0 And RomHeader(14)=0 And RomHeader(15)=0 : RomHeaderPal=RomHeader(9)&1 : EndIf
  If (RomHeader(7)&3)<>0 : RomStatus$="VS / PlayChoice systems are unsupported" : ProcedureReturn 0 : EndIf
  If nes2
    lo=RomHeader(10)&15 : hi=RomHeader(10)>>4 : ram=0
    If lo>0 : ram=64<<lo : EndIf
    If hi>0 : ram=ram+(64<<hi) : EndIf
    If (ram>8192 And RomMapper<>5 And RomMapper<>69) Or (ram>131072) Or (RomMapper=69 And ram>32768) Or (ram>0 And RomMapper<>1 And RomMapper<>4 And RomMapper<>5 And ExtraManaged(RomMapper)=0) : RomStatus$="PRG RAM exceeds 8 KiB" : ProcedureReturn 0 : EndIf
    If RomHeader(9)<>0 : RomStatus$="Extended ROM sizes are unsupported" : ProcedureReturn 0 : EndIf
    If ((RomMapper<>5 And RomMapper<>69) And ((RomHeader(10)&15)>7 Or (RomHeader(10)>>4)>7)) Or ((RomHeader(11)&15)>7 And RomMapper<>6 And RomMapper<>13) Or (RomHeader(11)>>4)>0
      RomStatus$="Cartridge RAM size is unsupported" : ProcedureReturn 0
    EndIf
  EndIf
  If nes2=0 And (RomMapper=1 Or RomMapper=4) And RomHeader(8)>1
    RomStatus$="PRG RAM exceeds 8 KiB" : ProcedureReturn 0
  EndIf
  If nes2 And ((RomMapper=6 And (RomHeader(11)&15)>9) Or (RomMapper=13 And (RomHeader(11)&15)>8))
    RomStatus$="CHR RAM exceeds cartridge bank wiring" : ProcedureReturn 0
  EndIf
  If RomMapper=5
    If nes2=0 : ram=RomHeader(8)*8192 : EndIf
    If ram>131072 Or (ram>0 And (ram<8192 Or (ram&(ram-1))<>0))
      RomStatus$="Unsupported MMC5 RAM geometry" : ProcedureReturn 0
    EndIf
  EndIf
  RomPrgBytes=RomHeader(4)*16384 : RomChrBytes=RomHeader(5)*8192
  If RomPrgBytes=0 Or (RomPrgBytes>524288 And RomMapper<>5 And RomMapper<>228) Or RomPrgBytes>4194304 Or (RomChrBytes>262144 And RomMapper<>5 And RomMapper<>228 And RomMapper<>234) Or RomChrBytes>1048576
    RomStatus$="ROM exceeds supported PRG / CHR sizes" : ProcedureReturn 0
  EndIf
  banks=RomHeader(4)
  If ((banks&(banks-1))<>0 And RomMapper<>228) Or (RomHeader(5)&(RomHeader(5)-1))<>0
    RomStatus$="Bank counts must be powers of two" : ProcedureReturn 0
  EndIf
  If (RomMapper=1 And (RomPrgBytes>262144 Or RomChrBytes>131072)) Or ((RomMapper=0 Or RomMapper=2 Or RomMapper=66) And RomChrBytes>16384)
    RomStatus$="Unsupported cartridge board size" : ProcedureReturn 0
  EndIf
  If (RomMapper=1 Or RomMapper=4 Or RomMapper=5) And RomSubmapper<>0
    RomStatus$="Unsupported MMC board submapper" : ProcedureReturn 0
  EndIf
  If (RomMapper=3 And (RomPrgBytes>32768 Or RomChrBytes=0 Or RomChrBytes>32768)) Or (RomMapper=7 And (RomPrgBytes>262144 Or RomChrBytes<>0)) Or (RomMapper=11 And (RomPrgBytes>131072 Or RomChrBytes=0 Or RomChrBytes>131072))
    RomStatus$="Unsupported discrete mapper geometry" : ProcedureReturn 0
  EndIf
  If (RomMapper=3 Or RomMapper=7 Or RomMapper=11) And RomSubmapper>2
    RomStatus$="Unsupported bus conflict submapper" : ProcedureReturn 0
  EndIf
  If RomMapper=5 And RomPrgBytes>1048576 : RomStatus$="MMC5 PRG exceeds 1 MiB" : ProcedureReturn 0 : EndIf
  If RomMapper=5 And nes2<>0 And RomHeader(11)<>0 : RomStatus$="MMC5 CHR RAM boards are unsupported" : ProcedureReturn 0 : EndIf
  If RomMapper=5 And RomChrBytes=0 : RomStatus$="MMC5 CHR RAM boards are unsupported" : ProcedureReturn 0 : EndIf
  If RomMapper=0 And (RomPrgBytes>32768 Or RomChrBytes>8192)
    RomStatus$="Unsupported NROM geometry" : ProcedureReturn 0
  EndIf
  If RomMapper=2 And RomChrBytes<>0
    RomStatus$="UxROM requires CHR RAM" : ProcedureReturn 0
  EndIf
  If RomMapper=66 And ((RomPrgBytes&32767)<>0 Or RomPrgBytes>131072 Or RomChrBytes=0)
    RomStatus$="Unsupported GxROM geometry" : ProcedureReturn 0
  EndIf
  If ExtraManaged(RomMapper)
    If RomSubmapper<>0 And (RomMapper<>71 Or RomSubmapper<>1) And (RomMapper<>232 Or RomSubmapper<>1) And (RomMapper<>34 Or RomSubmapper>2) And (RomMapper<>6 Or RomSubmapper>7)
      RomStatus$="Unsupported cartridge submapper" : ProcedureReturn 0
    EndIf
    If (RomMapper=13 And (RomPrgBytes>32768 Or RomChrBytes<>0)) Or (RomMapper=71 And RomChrBytes<>0) Or (RomMapper=232 And RomChrBytes<>0) Or (RomMapper=105 And RomChrBytes<>0)
      RomStatus$="Unsupported cartridge CHR geometry" : ProcedureReturn 0
    EndIf
    If RomMapper=34 And ((RomSubmapper=1 And RomChrBytes=0) Or (RomSubmapper=2 And RomChrBytes<>0))
      RomStatus$="NINA / BNROM submapper mismatch" : ProcedureReturn 0
    EndIf
    If ((RomMapper=9) And (RomPrgBytes>131072 Or RomChrBytes>131072)) Or ((RomMapper=79 Or RomMapper=148) And (RomPrgBytes>65536 Or RomChrBytes>65536)) Or (RomMapper=206 And (RomPrgBytes>131072 Or RomChrBytes>65536))
      RomStatus$="Cartridge exceeds physical bank lines" : ProcedureReturn 0
    EndIf
    If (RomMapper=68 And RomPrgBytes>131072) Or ((RomMapper=118 Or RomMapper=158) And RomChrBytes>131072) Or (RomMapper=119 And RomChrBytes>65536)
      RomStatus$="Unsupported cartridge board variant" : ProcedureReturn 0
    EndIf
    If RomMapper<>228 And RomPrgBytes>524288 : RomStatus$="Cartridge PRG exceeds bank wiring" : ProcedureReturn 0 : EndIf
  EndIf
  If fileBytes<16+RomPrgBytes+RomChrBytes
    RomStatus$="Truncated cartridge data" : ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure