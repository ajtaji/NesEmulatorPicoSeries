    PC = (PC + Res) & $FFFF
    CompilerIf #CPU_TIMING = 1
      Ea = PC
      CpuCrossPage()
    CompilerEndIf
    CpuTick(1)
  Else
    PC = (PC + 1) & $FFFF
  EndIf
  If Res=-6
  If NesIdleEnabled<>0 And (FZ&255)<>0 And X>0 And Left>12 And PpuStatusDeadline>NesRunStart+Budget-Left And PC>=$8000 And PC<=$FFFA
    NesPollPtr=PrgBias+PC
    If PeekA(NesPollPtr)=$AD And PeekA(NesPollPtr+1)=2 And PeekA(NesPollPtr+2)=$20 And PeekA(NesPollPtr+3)=$E8 And PeekA(NesPollPtr+4)=$D0 And PeekA(NesPollPtr+5)=$FA
      NesPollCycles=9
      If (Base&$FF00)<>(PC&$FF00)
        NesPollCycles=10
      EndIf
      NesPollCount=NesDiv(Left-3,NesPollCycles)
      Tmp=NesDiv(PpuStatusDeadline-(NesRunStart+Budget-Left)+4,NesPollCycles)
      If NesPollCount>Tmp
        NesPollCount=Tmp
      EndIf
      If NesPollCount>255-X
        NesPollCount=255-X
      EndIf
      If NesPollCount>0
        CpuTick(NesPollCount*NesPollCycles)
