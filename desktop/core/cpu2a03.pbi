    A = Res & 255
  CpuNextOp(3)
OpE6: ; $E6 INC zpg
  CpuFetch(Ea)
  NesOpenBus = M(Ea)
  Value = NesOpenBus
  Res = Value + 1
  Res = Res & 255
  CpuNZ(Res)
  M(Ea) = Value : NesOpenBus = Value
  M(Ea) = Res : NesOpenBus = Res
  CpuNextOp(5)
OpE8: ; $E8 INX imp
  X = (X + 1) & 255
  CpuNZ(X)
  CpuNextOp(2)
OpE9: ; $E9 SBC imm
  CpuFetch(Value)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuNextOp(2)
OpEA: ; $EA NOP imp
  CpuNextOp(2)
OpEC: ; $EC CPX abs
  AccessPhase = 3
  CpuFetchAddress()
  Res = X - NesRead(Ea)
  CpuNZ(Res)
  FC = ~Res
  CpuNextOp(4)
OpED: ; $ED SBC abs
  AccessPhase = 3
  CpuFetchAddress()
  Value = NesRead(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuNextOp(4)
OpEE: ; $EE INC abs
  AccessPhase = 5
  CpuFetchAddress()
  AccessPhase = AccessPhase - 2
  Value = NesRead(Ea)
  AccessPhase = AccessPhase + 2
  Res = Value + 1
  Res = Res & 255
  CpuNZ(Res)
  AccessPhase = AccessPhase - 1
  NesWrite(Ea, Value)
  AccessPhase = AccessPhase + 1
  NesWrite(Ea, Res)
  CpuNextOp(6)
OpF0: ; $F0 BEQ rel
  If (FZ & 255) = 0
    CompilerIf #CPU_TIMING = 1
      Base = (PC + 1) & $FFFF
    CompilerEndIf
    Res = (CpuFetchByte() ! 128) - 128
    PC = (PC + Res) & $FFFF
    CompilerIf #CPU_TIMING = 1
      Ea = PC
      CpuCrossPage()
    CompilerEndIf
    CpuTick(1)
  Else
    PC = (PC + 1) & $FFFF
  EndIf
  If Res=-7
  If NesIdleEnabled<>0 And A=0 And (FZ&255)=0 And (PpuStatusBits&$40)=0 And Left>12 And PpuStatusDeadline>NesRunStart+Budget-Left And PC>=$8000 And PC<=$FFF9
    NesPollPtr=PrgBias+PC
    If PeekA(NesPollPtr)=$AD And PeekA(NesPollPtr+1)=2 And PeekA(NesPollPtr+2)=$20 And PeekA(NesPollPtr+3)=$29 And PeekA(NesPollPtr+4)=$40 And PeekA(NesPollPtr+5)=$F0 And PeekA(NesPollPtr+6)=$F9
      NesPollCycles=9
      If (Base&$FF00)<>(PC&$FF00)
        NesPollCycles=10
      EndIf
      NesPollCount=NesDiv(Left-3,NesPollCycles)
      Tmp=NesDiv(PpuStatusDeadline-(NesRunStart+Budget-Left)+4,NesPollCycles)
      If NesPollCount>Tmp
        NesPollCount=Tmp
      EndIf
      If NesPollCount>0
        CpuTick(NesPollCount*NesPollCycles)
        NesInstructions=NesInstructions+NesPollCount*3
        NesIdleBatched=NesIdleBatched+NesPollCount*3
        NesPollStatusDone()
        FN=0 : FZ=0 : NesOpenBus=$F9
      EndIf
    EndIf
  EndIf
  EndIf
  If Res=-4
  If NesIdleEnabled<>0 And A=0 And (FZ&255)=0 And Left>9 And PC>=$8000 And PC<=$FFFC
    NesPollPtr=PrgBias+PC
    If PeekA(NesPollPtr)=$A5 And PeekA(NesPollPtr+2)=$F0 And PeekA(NesPollPtr+3)=$FC And M(PeekA(NesPollPtr+1))=0
      NesPollCycles=6
      If (Base&$FF00)<>(PC&$FF00)
        NesPollCycles=7
      EndIf
      NesPollCount=NesDiv(Left-3,NesPollCycles)
      CpuTick(NesPollCount*NesPollCycles)
      NesInstructions=NesInstructions+NesPollCount*2
      NesIdleBatched=NesIdleBatched+NesPollCount*2
      FN=0 : FZ=0 : NesOpenBus=$FC
    EndIf
  EndIf
  EndIf
  CpuNextOp(2)
OpF1: ; $F1 SBC iny
  AccessPhase = 4
  CpuFetch(Tmp)
  Lo = M(Tmp) : Hi = M((Tmp + 1) & 255) : NesOpenBus = Hi
  Ea = Lo | (Hi << 8)
  Base = Ea
  Ea = (Ea + Y) & $FFFF
  CpuCrossPage()
  Value = NesRead(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuNextOp(5)
OpF5: ; $F5 SBC zpx
  CpuFetch(Ea)
  Ea = (Ea + X) & 255
  NesOpenBus = M(Ea)
  Value = NesOpenBus
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuNextOp(4)
OpF6: ; $F6 INC zpx
  CpuFetch(Ea)
  Ea = (Ea + X) & 255
  NesOpenBus = M(Ea)
  Value = NesOpenBus
  Res = Value + 1
  Res = Res & 255
  CpuNZ(Res)
  M(Ea) = Value : NesOpenBus = Value
  M(Ea) = Res : NesOpenBus = Res
  CpuNextOp(6)
OpF8: ; $F8 SED imp
  FD = 1
  CpuNextOp(2)
OpF9: ; $F9 SBC aby
  AccessPhase = 3
  CpuFetchAddress()
  Base = Ea
  Ea = (Ea + Y) & $FFFF
  CpuCrossPage()
  Value = NesRead(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuNextOp(4)
OpFD: ; $FD SBC abx
  AccessPhase = 3
  CpuFetchAddress()
  Base = Ea
  Ea = (Ea + X) & $FFFF
  CpuCrossPage()
  Value = NesRead(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  CpuNZ(Res)
    A = Res & 255
  CpuNextOp(4)
OpFE: ; $FE INC abx
  AccessPhase = 6
  CpuFetchAddress()
  Ea = (Ea + X) & $FFFF
  AccessPhase = AccessPhase - 2
  Value = NesRead(Ea)
  AccessPhase = AccessPhase + 2
  Res = Value + 1
  Res = Res & 255
  CpuNZ(Res)
  AccessPhase = AccessPhase - 1
  NesWrite(Ea, Value)
  AccessPhase = AccessPhase + 1
  NesWrite(Ea, Res)
  CpuNextOp(7)
Done:
  CpuCycles = NesRunStart + Budget - Left
  CpuInWindow = 0
  ProcedureReturn CpuCycles - NesRunStart
EndProcedure
