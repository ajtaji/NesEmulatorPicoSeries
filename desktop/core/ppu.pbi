XIncludeFile "ppu_bus_read.pbi"
Procedure PpuColours()
  Protected i.i, c.i, e.i, changed.i, color.i
  e=(PpuMask>>5)*64
  For i=0 To 31
    c=Pal(i)&63
    If (i&3)=0
      c=Pal(0)&63
    EndIf
    If PpuMask&1
      c=c&$30
    EndIf
    color=Rgb64(e+c)
    If RgbPal(i)<>color
      changed=1
    EndIf
    RgbPal(i)=color
  Next
  If changed
    RgbPairsDirty=1
  EndIf
EndProcedure
Procedure PpuDecode(row.i)
  Protected low.i, high.i, dest.i, i.i, bits.i
  row=row&$1FF7
  low=PeekA(Chr+row) : high=PeekA(Chr+row+8)
  dest=(row&$1FF0)+(row&7)*2 : bits=0
  For i=0 To 7
    bits=bits|((((low>>(7-i))&1)|(((high>>(7-i))&1)<<1))<<(i*2))
  Next
  PokeU(Pattern+dest,bits)
EndProcedure
Procedure PpuBuildRgbPairs()
  Protected palette.i, low.i, high.i, i.i
  PairBuilds=PairBuilds+1 : RgbLastKey= -1
  For palette=0 To 3
    For high=0 To 3
      For low=0 To 3
        RgbPairs(palette*16+low+high*4)=RgbPal(palette*4+low)|(RgbPal(palette*4+high)<<16)
      Next
    Next
  Next
  For i=0 To 1023
    PokeL(@RgbTags(0)+i*4,0)
  Next
  RgbPairsDirty=0
EndProcedure
