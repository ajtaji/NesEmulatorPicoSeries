XIncludeFile "ppu_bus_write.pbi"
; Packed tile fetch, using duplicated nametable mirrors and predecoded CHR.
; r4-r7 are saved locally; reserved CPU registers r8-r11 are untouched.
Global Dim PixelSpread.l(256)
Procedure PpuFetchTileBase()
  Protected tile.i,attr.i,palette.i,row.i,bits.i,packed.i
  tile=Nt(WAddr&$FFF)
  attr=Nt($3C0|(WAddr&$C00)|((WAddr>>4)&$38)|((WAddr>>2)&7))
  palette=((attr>>(((WAddr>>4)&4)|(WAddr&2)))&3)*4
  row=((PpuCtrl&16)<<8)+tile*16+((WAddr>>12)&7)*2
  bits=PeekU(Pattern+row)
  packed=palette*$01010101
  WLo=PixelSpread(bits&255)|packed : WHi=PixelSpread(bits>>8)|packed
EndProcedure
Procedure PpuFetchTileReference()
  Protected tile.i, attr.i, palette.i, row.i, low.i, high.i, i.i, pixel.i
  tile=Nt(WAddr&$FFF)
  attr=Nt($3C0|(WAddr&$C00)|((WAddr>>4)&$38)|((WAddr>>2)&7))
  palette=((attr>>(((WAddr>>4)&4)|(WAddr&2)))&3)*4
  row=((PpuCtrl&16)<<8)+tile*16+((WAddr>>12)&7)
  low=PeekA(Chr+row) : high=PeekA(Chr+row+8) : WLo=0 : WHi=0
  For i=0 To 7
    pixel=palette|((low>>(7-i))&1)|(((high>>(7-i))&1)<<1)
    If i<4
      WLo=WLo|(pixel<<(i*8))
    Else
      WHi=WHi|(pixel<<((i-4)*8))
    EndIf
  Next
EndProcedure
Procedure.i PpuRegRead(addr.i)
  Protected v.i, ppuAddress.i
  addr=addr&7 : v=PpuBus
  If addr=2
    v=(PpuStatus&$E0)|(PpuBus&31)
    PpuStatus=PpuStatus&$7F : PpuW=0
  ElseIf addr=4
    v=Oam(PpuOamAddr)
  ElseIf addr=7
    ppuAddress=PpuV&$3FFF
    If ppuAddress>=$3F00
      v=PpuRead(ppuAddress)|(PpuBus&$C0)
      If PpuMask&1
        v=v&$F0
      EndIf
      PpuBuffer=PpuRead(ppuAddress-$1000)
    Else
      v=PpuBuffer : PpuBuffer=PpuRead(ppuAddress)
    EndIf
    If PpuCtrl&4
      PpuV=(PpuV+32)&$7FFF
    Else
      PpuV=(PpuV+1)&$7FFF
    EndIf
  EndIf
  PpuBus=v
  ProcedureReturn v
EndProcedure
Procedure PpuRegWrite(addr.i, value.i)
  Protected previous.i
  addr=addr&7 : PpuBus=value : BgCacheAddr= -1 : RgbLastKey= -1
  If PpuWarmup>0
    If addr=0 Or addr=1 Or addr=5 Or addr=6
      ProcedureReturn
    EndIf
  EndIf
  If addr=0
    previous=PpuCtrl
    If ((PpuCtrl!value)&$20)<>0
      OamCacheDirty=1
    EndIf
    PpuCtrl=value : PpuT=(PpuT&$73FF)|((value&3)<<10)
    If (previous&$80)=0 And (value&$80)<>0 And (PpuStatus&$80)<>0
      WorkerNmi=WorkerNmi+1
    EndIf
  ElseIf addr=1
    PpuMask=value : PpuColours()
  ElseIf addr=3
    PpuOamAddr=value
  ElseIf addr=4
    OamCacheDirty=1
    Oam(PpuOamAddr)=value : PpuOamAddr=(PpuOamAddr+1)&255
  ElseIf addr=5
    If PpuW=0
      PpuT=(PpuT&$7FE0)|(value>>3) : PpuFineX=value&7
    Else
      PpuT=(PpuT&$C1F)|((value&7)<<12)|((value&$F8)<<2)
    EndIf
    PpuW=PpuW!1
  ElseIf addr=6
    If PpuW=0
      PpuT=(PpuT&255)|((value&$3F)<<8)
    Else
      PpuT=(PpuT&$7F00)|value : PpuV=PpuT
    EndIf
    PpuW=PpuW!1
  ElseIf addr=7
    PpuWrite(PpuV,value)
    If PpuCtrl&4
      PpuV=(PpuV+32)&$7FFF
    Else
      PpuV=(PpuV+1)&$7FFF
    EndIf
  EndIf
EndProcedure
Procedure PpuBuildSpriteCache()
  Protected i.i, row.i, first.i, finish.i, height.i, count.i
  For i=0 To 63
    PokeL(@CachedCount(0)+i*4,0)
  Next
  height=8
  If PpuCtrl&$20
    height=16
  EndIf
  For i=0 To 63
    first=Oam(i*4)+1 : finish=first+height-1
    If finish>239
      finish=239
    EndIf
    For row=first To finish
      count=CachedCount(row)
      If count<8
        CachedSprite(row*8+count)=i
        CachedCount(row)=count+1
      Else
        CachedCount(row)=9
      EndIf
    Next
  Next
  OamCacheDirty=0
EndProcedure
Procedure PpuClearSprites()
  Protected i.i
  For i=0 To 255 : SpriteLine(i)=0 : Next
  For i=0 To 31 : SpriteSpan(i)=0 : Next
EndProcedure
; Reference sprite evaluation; the board checks compare PpuSpritesRaw to it.
Procedure PpuSpritesReference()
  Protected i.i, row.i, height.i, tile.i, ppuAddress.i, bank.i, j.i, sx.i, pixel.i, flags.i
  SprCount=0 : height=8
  If PpuCtrl&$20
    height=16
  EndIf
  If OamCacheDirty
    PpuBuildSpriteCache()
  EndIf
  SprCount=CachedCount(PpuLine)
  If SprCount>8
    SprCount=8
    If PpuMask&$18
      PpuStatus=PpuStatus|$20
    EndIf
  EndIf
  For i=0 To SprCount-1
    j=CachedSprite(PpuLine*8+i)
    row=PpuLine-Oam(j*4)-1
    ppuAddress=Oam(j*4+2) : tile=Oam(j*4+1)
    If ppuAddress&$80
      row=height-1-row
    EndIf
    bank=(PpuCtrl&8)<<9
    If height=16
      bank=(tile&1)<<12 : tile=(tile&$FE)+(row>>3) : row=row&7
    EndIf
    SprIndex(i)=j : SprX(i)=Oam(j*4+3) : SprAttr(i)=ppuAddress
    SprRow(i)=bank+tile*16+row*2
  Next
  PpuClearSprites()
  If PpuMask&$10
    For i=SprCount-1 To 0 Step -1
      flags=16+((SprAttr(i)&3)*4)+((SprAttr(i)&$20)*2)
      If SprIndex(i)=0
        flags=flags|$80
      EndIf
      For j=0 To 7
        sx=SprX(i)+j
        If sx<256
          If sx>=8 Or (PpuMask&4)<>0
            row=j
            If SprAttr(i)&$40
              row=7-j
            EndIf
            pixel=(PeekU(Pattern+SprRow(i))>>(row*2))&3
            If pixel
              SpriteLine(sx)=flags|pixel : SpriteSpan(sx>>3)=SpriteSpan(sx>>3)|1
              If i=0 And SprIndex(i)=0
                SpriteSpan(sx>>3)=SpriteSpan(sx>>3)|2
              EndIf
            EndIf
          EndIf
        EndIf
      Next
    Next
  EndIf
EndProcedure
; Per-line sprite evaluation, same results as PpuSpritesReference: up to eight
; cached sprites, overflow, then SpriteLine/SpriteSpan in reverse OAM order so
; the lowest OAM index owns each pixel. Horizontal flip reverses the 2-bit row.
Procedure PpuSpritesBase()
  PpuSpritesReference()
EndProcedure
CompilerIf #PPU_PROFILE=1
Procedure PpuSprites()
  Protected timer.i
  timer=NesHostUs() : PpuSpritesRaw() : PpuSpritesUs=PpuSpritesUs+NesHostUs()-timer
EndProcedure
CompilerElse
Procedure PpuSprites()
  PpuSpritesRaw()
EndProcedure
CompilerEndIf
Procedure.i PpuIncX(v.i)
  If (v&31)=31
    ProcedureReturn (v&$7FE0)!$400
  EndIf
  ProcedureReturn v+1
EndProcedure
Procedure PpuIncY()
  Protected y.i
  If (PpuV&$7000)<>$7000
    PpuV=PpuV+$1000
  Else
    PpuV=PpuV&$FFF : y=(PpuV>>5)&31
    If y=29
      y=0 : PpuV=PpuV!$800
    ElseIf y=31
      y=0
    Else
      y=y+1
    EndIf
    PpuV=(PpuV&$7C1F)|(y<<5)
  EndIf
EndProcedure
; Composite only spans containing sprites. Cached OAM priority is per scanline.
Procedure PpuOverlay8()
  Protected i.i, sp.i, bg.i
  For i=0 To 7
    sp=SpriteLine(PpuDot+i) : bg=LinePixels(WOff+i)&3
    If sp<>0
      If (sp&$80)<>0 And bg<>0 And PpuDot+i<>255 : PpuStatus=PpuStatus|$40 : EndIf
      If (sp&$40)=0 Or bg=0 : LinePixels(WOff+i)=sp&31 : EndIf
    EndIf
  Next
EndProcedure
; Build one eight-pixel background span with two packed word stores.
Procedure PpuRender8Reference()
  WOff=PpuDot
  If PpuMask&8
    WAddr=PpuV : WI=0
    Repeat
      PpuFetchTile()
      If WI=0
        W0=WLo : W1=WHi
        If PpuFineX=0
          Break
        EndIf
      Else
        W2=WLo : W3=WHi : Break
      EndIf
      WI=1 : WAddr=PpuIncX(WAddr)
    ForEver
    WF=PpuFineX*8
    If WF>0 And WF<32
      W0=((W0&$FFFFFFFF)>>WF)|(W1<<(32-WF)) : W1=((W1&$FFFFFFFF)>>WF)|(W2<<(32-WF))
    ElseIf WF=32
      W0=W1 : W1=W2
    ElseIf WF>32
      WF=WF-32
      W0=((W1&$FFFFFFFF)>>WF)|(W2<<(32-WF)) : W1=((W2&$FFFFFFFF)>>WF)|(W3<<(32-WF))
    EndIf
  Else
    W0=0 : W1=0
  EndIf
  If PpuDot=0 And (PpuMask&2)=0
    W0=0 : W1=0
  EndIf
  PokeL(@LinePixels(0)+WOff,W0) : PokeL(@LinePixels(0)+WOff+4,W1)
  If SpriteSpan(PpuDot>>3)
    PpuOverlay8()
  EndIf
  PpuPixels=PpuPixels+8
  If PpuMask&$18
    PpuV=PpuIncX(PpuV)
  EndIf
EndProcedure
Procedure PpuRgbLineRaw()
  Protected x.i
  For x=0 To 255
    PokeU(FrameRow+x*2,RgbPal(PeekA(@LinePixels(0)+x)))
  Next
EndProcedure
CompilerIf #PPU_PROFILE=1
Procedure PpuRgbLine()
  Protected timer.i
  timer=NesHostUs() : PpuRgbLineRaw() : PpuRgbUs=PpuRgbUs+NesHostUs()-timer
EndProcedure
CompilerElse
Procedure PpuRgbLine()
  PpuRgbLineRaw()
EndProcedure
CompilerEndIf
Declare DisplayWaitLine(line.i)
Declare DisplayFrame()
Procedure PpuBeginLine()
  DisplayWaitLine(PpuLine)
  If PpuLine<120
    FrameRow=RenderTop+PpuLine*512
  Else
    FrameRow=FrameBottom+(PpuLine-120)*512
  EndIf
EndProcedure
Procedure PpuSendLine()
  If PpuLine=239
    DisplayFrame()
  EndIf
EndProcedure
; CPU cycles to PPU dots (rp2040/ppu.pico): 3 each (NTSC), or 16 per 5 (PAL) with the remainder carried
; in PpuDotFrac. PpuTakeDots spends the cycles; PpuDotsFor only looks ahead (the mapper observers, run
; before PpuAdvance on the same cycles, see the same dots). PpuCyclesWithin(d) is the most cycles that
; keep the PPU no more than d dots ahead (NTSC d/3) - the budgets and the status deadline.
Procedure.i PpuTakeDots(cycles.i)
  Protected total.i,dots.i
  If CartPal=0 : ProcedureReturn cycles*3 : EndIf
  total=cycles*16+PpuDotFrac : dots=NesDiv(total,5) : PpuDotFrac=total-dots*5
  ProcedureReturn dots
EndProcedure
Procedure.i PpuDotsFor(cycles.i)
  If CartPal=0 : ProcedureReturn cycles*3 : EndIf
  ProcedureReturn NesDiv(cycles*16+PpuDotFrac,5)
EndProcedure
Procedure.i PpuCyclesWithin(dots.i)
  If dots<0 : ProcedureReturn 0 : EndIf
  If CartPal=0 : ProcedureReturn NesDiv(dots,3) : EndIf
  ProcedureReturn (dots*5+4-PpuDotFrac)>>4
EndProcedure
Procedure PpuAdvanceReference(cycles.i)
  Protected dots.i, edge.i, stepN.i, width.i, sample.i
  If PpuWarmup>0
    PpuWarmup=PpuWarmup-cycles
    If PpuWarmup<0
      PpuWarmup=0
    EndIf
  EndIf
  dots=PpuTakeDots(cycles)
  While dots>0
    edge=341
    If PpuLine<240
      If PpuDot<256
        If (PpuDot&7)=0
          If PpuDot=0
            PpuBeginLine()
            sample=NesHostUs()
            PpuSprites()
            PpuSpritesUs=PpuSpritesUs+NesHostUs()-sample
          EndIf
          PpuRenderCalls=PpuRenderCalls+1
          If (PpuRenderCalls&63)=0
            sample=NesHostUs()
            PpuRender8Reference()
            PpuRenderUs=PpuRenderUs+NesHostUs()-sample
          Else
            PpuRender8Reference()
          EndIf
        EndIf
        edge=((PpuDot>>3)+1)*8
      ElseIf PpuDot<257
        edge=257
      EndIf
    ElseIf PpuLine=241 Or PpuLine=PpuPreLine
      If PpuDot=0
        edge=1
      ElseIf PpuLine=PpuPreLine
        If PpuDot<257
          edge=257
        ElseIf PpuDot<280
          edge=280
        EndIf
      EndIf
    EndIf
    width=341
    If PpuLine=PpuPreLine And PpuOdd<>0 And (PpuMask&$18)<>0
      width=340
      If edge>width
        edge=width
      EndIf
    EndIf
    stepN=edge-PpuDot
    If stepN>dots
      stepN=dots
    EndIf
    PpuDot=PpuDot+stepN : dots=dots-stepN
    If PpuDot=edge
      If PpuLine=241 And edge=1
        PpuStatus=PpuStatus|$80
        If PpuCtrl&$80
          WorkerNmi=WorkerNmi+1
        EndIf
      ElseIf PpuLine=PpuPreLine And edge=1
        PpuStatus=PpuStatus&31
      ElseIf PpuLine<240 And edge=256
        If PpuMask&$18
          PpuIncY()
        EndIf
        PpuRgbLineRaw()
        PpuSendLine()
      ElseIf edge=257 And (PpuMask&$18)<>0
        PpuV=(PpuV&$7BE0)|(PpuT&$41F)
      ElseIf PpuLine=PpuPreLine And edge=280 And (PpuMask&$18)<>0
        PpuV=(PpuV&$41F)|(PpuT&$7BE0)
      EndIf
      If PpuDot=width
        PpuDot=0 : PpuLine=PpuLine+1
        If PpuLine=PpuLineCount
          PpuLine=0 : PpuOdd=PpuOdd!PpuOddToggle : WorkerFrames=WorkerFrames+1
        EndIf
      EndIf
    EndIf
  Wend
  WorkerDot=PpuLine*341+PpuDot
EndProcedure


Procedure PpuAdvance(cycles.i)
  If ExtraA12(CartMapper) : MapperPpuTicks(cycles) : EndIf
  If CartMapper=5 : M5PpuTicks(cycles) : EndIf
  PpuAdvanceReference(cycles)
EndProcedure
